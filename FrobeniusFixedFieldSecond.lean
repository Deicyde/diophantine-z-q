import Mathlib

/-!
# The finite fixed field of a positive Frobenius power

The fixed field is the genuine intermediate field fixed by the cyclic
subgroup generated by the given field automorphism power. Its elements
are roots of the actual nonzero polynomial X^(q^r)-X. No fixed-field
finiteness or finite geometric-point bound is assumed.
-/

noncomputable section
set_option autoImplicit false

namespace SemistableGeometry.FrobeniusFixed

variable {k L : Type} [Field k] [Field L] [Algebra k L]

/-- The actual intermediate field fixed by the indicated power. -/
def field (σ : L ≃ₐ[k] L) (r : ℕ) : IntermediateField k L :=
  IntermediateField.fixedField (Subgroup.zpowers (σ ^ r))

/-- An element is fixed by the power exactly when it lies in the genuine fixed field. -/
theorem mem_field_iff (σ : L ≃ₐ[k] L) (r : ℕ) (x : L) :
    x ∈ field σ r ↔ (σ ^ r) x = x := by
  rw [field, IntermediateField.mem_fixedField_iff]
  constructor
  · intro h
    exact h (σ ^ r) (Subgroup.mem_zpowers _)
  · intro h
    have hz : Subgroup.zpowers (σ ^ r) ≤ MulAction.stabilizer (L ≃ₐ[k] L) x := by
      apply Subgroup.zpowers_le.mpr
      exact h
    intro τ hτ
    exact hz hτ

/-- The actual power action follows from the given Frobenius action on the field. -/
theorem power_apply (σ : L ≃ₐ[k] L) (q : ℕ) (hσ : ∀ x : L, σ x = x ^ q)
    (r : ℕ) (x : L) : (σ ^ r) x = x ^ (q ^ r) := by
  induction r with
  | zero => simp
  | succ r ih =>
    rw [pow_succ', AlgEquiv.mul_apply, ih, hσ, ← pow_mul, pow_succ, mul_comm]

/-- A positive power of an actual q-Frobenius field automorphism has a finite fixed intermediate field. -/
theorem finite_field (σ : L ≃ₐ[k] L) (q : ℕ) (hq : 2 ≤ q)
    (hσ : ∀ x : L, σ x = x ^ q) (r : ℕ) (hr : 0 < r) : Finite (field σ r) := by
  classical
  let P : Polynomial L := Polynomial.X ^ (q ^ r) - Polynomial.X
  have hqr : 1 < q ^ r := Nat.one_lt_pow hr.ne' hq
  have hP : P ≠ 0 := FiniteField.X_pow_card_sub_X_ne_zero L hqr
  let f : field σ r → ↥P.roots.toFinset := fun x ↦
    ⟨(x : L), by
      rw [Multiset.mem_toFinset, Polynomial.mem_roots hP, Polynomial.IsRoot.def]
      simp only [P, Polynomial.eval_sub, Polynomial.eval_pow, Polynomial.eval_X]
      apply sub_eq_zero.mpr
      exact (power_apply σ q hσ r x).symm.trans ((mem_field_iff σ r x).mp x.2)⟩
  apply Finite.of_injective f
  intro x y h
  apply Subtype.ext
  exact congrArg (fun z : ↥P.roots.toFinset ↦ (z : L)) h

end SemistableGeometry.FrobeniusFixed
