          "snippet": {
            "text": "def polePoly (B : ℚ) (b : Fin 6 → ℚ) (e z r₁ r₂ w : ℚ) : ℚ :=\n  let m := (1 - 2 * b 0) * (1 + b 1) * (1 + 2 * b 2) * (1 + 4 * b 3) * (1 + 6 * b 4) *\n    (1 + 12 * b 5)\n  let A := m * B\n  let H := A * (A - B ^ 2)\n  let T₁ := A * (A - e) * (A + 3 * e)\n  let T₂ := A * (A * z ^ 2 - e * H) * (A * z ^ 2 + 3 * e * H)\n  B * ((∑ i, (b i ^ 2 - b i) ^ 2) + (e * H * z * w - 1) ^ 2 + (r₁ ^ 2 - T₁) ^ 2 +\n    (r₂ ^ 2 - T₂) ^ 2)",
            "line": 23,
            "truncated": false
          },
