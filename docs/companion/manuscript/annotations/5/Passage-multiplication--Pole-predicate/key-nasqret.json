          "snippet": {
            "text": "def pole (B : ℚ) : Prop := ∃ b : Fin 6 → ℚ, ∃ e z r₁ r₂ w : ℚ,\n  let m := (1-2*b 0)*(1+b 1)*(1+2*b 2)*(1+4*b 3)*(1+6*b 4)*(1+12*b 5)\n  let a := m*B\n  let h := a*(a-B^2)\n  B * ((∑ i, (b i^2-b i)^2) + (e*h*z*w-1)^2 + (r₁^2-a*(a-e)*(a+3*e))^2 +\n    (r₂^2-a*(a*z^2-e*h)*(a*z^2+3*e*h))^2) = 0",
            "line": 145,
            "truncated": false
