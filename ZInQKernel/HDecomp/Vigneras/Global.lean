/-!
# glue-vigneras, global part: the normalizer of N5's order `𝒪` in `B^×`, `B = (2,-3)` over `ℚ`

Main theorem `nrd_dvd_six`: if `x = comb n ∈ 𝒪` is primitive (`∑ sₖ nₖ = 1`) and normalizes `𝒪`,
then `nrd x ∣ 6`. So every element of `N_B(𝒪)` is `r·x₀` with `r ∈ ℚ^×`, `x₀ ∈ 𝒪` and
`nrd x₀ ∈ {±1, ±2, ±3, ±6}`; this is the finite computation behind `[N_B(𝒪) : ℚ^×𝒪^×] ≤ 4`.
`B`, `comb`, `𝒪` are copied from `scratch/glue-repo/A1Quaternion.lean` (scratch files cannot import
each other). The certificate section is generated by `gen_global.py`.
-/

open Quaternion

attribute [local simp] QuaternionAlgebra.re_ofNat QuaternionAlgebra.imI_ofNat
    QuaternionAlgebra.imJ_ofNat QuaternionAlgebra.imK_ofNat

namespace GlueVigneras.Global

abbrev B := ℍ[ℚ, 2, 0, -3]

def comb (n : Fin 4 → ℤ) : B :=
  ⟨n 0 + n 2 / 2, n 1 + n 3 / 2, n 2 / 2, n 3 / 2⟩

/-- `𝒪 = ℤ⟨1, i, (1+j)/2, (i+ij)/2⟩` (as a set; glue-repo proves it is a subring). -/
def O : Set B := Set.range comb

/-- Coordinates in N5's basis. -/
def coordQ (x : B) : Fin 4 → ℚ := ![x.re - x.imJ, x.imI - x.imK, 2 * x.imJ, 2 * x.imK]

theorem coordQ_comb (n : Fin 4 → ℤ) (l : Fin 4) : coordQ (comb n) l = n l := by
  fin_cases l <;> simp [coordQ, comb] <;> ring

def nrd (x : B) : ℚ := (x * star x).re

theorem mul_star_eq (x : B) : x * star x = algebraMap ℚ B (nrd x) := by
  ext <;> simp [nrd] <;> ring

/-- `nrd (comb n)` as an integer form: `N(n₀,n₂) − 2N(n₁,n₃)`, `N = x² + xy + y²`. -/
def nrdInt (n : Fin 4 → ℤ) : ℤ := (n 0 ^ 2 + n 0 * n 2 + n 2 ^ 2) - 2 * (n 1 ^ 2 + n 1 * n 3 + n 3 ^
    2)

theorem nrd_comb (n : Fin 4 → ℤ) : nrd (comb n) = nrdInt n := by
  simp [nrd, comb, nrdInt]; ring

/-- N5's basis. -/
def eQ (k : Fin 4) : B := comb (fun l => if l = k then 1 else 0)

/-- `Eint n k l`: coordinate `l` (N5's basis) of `x eₖ x̄` for `x = comb n` (generated by
  `gen_global.py`). -/

def Eint (n : Fin 4 → ℤ) : Fin 4 → Fin 4 → ℤ := ![

  ![(-2)*n 3^2 + (1)*n 2^2 + (-2)*n 1*n 3 + (-2)*n 1^2 + (1)*n 0*n 2 + (1)*n 0^2, 0, 0, 0],
  ![(2)*n 2*n 3 + (2)*n 1*n 2 + (2)*n 0*n 3, (2)*n 3^2 + (-2)*n 1^2 + (2)*n 0*n 2 + (1)*n 0^2,
      (-4)*n 2*n 3 + (-4)*n 1*n 2 + (-4)*n 0*n 3, (-2)*n 3^2 + (-1)*n 2^2 + (-4)*n 1*n 3 + (-2)*n
      0*n 2],
  ![(-2)*n 3^2 + (-2)*n 1*n 3 + (-2)*n 1^2, (-1)*n 2*n 3 + (1)*n 1*n 2 + (-2)*n 0*n 3 + (-1)*n 0*n
      1, (2)*n 3^2 + (1)*n 2^2 + (2)*n 1*n 3 + (2)*n 1^2 + (1)*n 0*n 2 + (1)*n 0^2, (2)*n 2*n 3 +
      (1)*n 1*n 2 + (1)*n 0*n 3 + (2)*n 0*n 1],
  ![(2)*n 2*n 3 + (-2)*n 0*n 1, (1)*n 2^2 + (-4)*n 1*n 3 + (-2)*n 1^2 + (2)*n 0*n 2, (-4)*n 2*n 3 +
      (4)*n 0*n 1, (-2)*n 3^2 + (-1)*n 2^2 + (2)*n 1^2 + (1)*n 0^2]]

theorem cert_00 (n : Fin 4 → ℤ) : 6 * (n 0 * n 0) = (4) * Eint n 0 0 + (2) * Eint n 1 1 + (2) * Eint
    n 1 3 + (-4) * Eint n 2 0 + (-2) * Eint n 3 1 := by
  simp [Eint]; ring

theorem cert_01 (n : Fin 4 → ℤ) : 6 * (n 0 * n 1) = (-1) * Eint n 1 0 + (2) * Eint n 2 3 + (-1) *
    Eint n 3 0 := by
  simp [Eint]; ring

theorem cert_02 (n : Fin 4 → ℤ) : 6 * (n 0 * n 2) = (-2) * Eint n 0 0 + (-2) * Eint n 1 3 + (2) *
    Eint n 2 0 + (2) * Eint n 3 1 + (2) * Eint n 3 3 := by
  simp [Eint]; ring

theorem cert_03 (n : Fin 4 → ℤ) : 6 * (n 0 * n 3) = (2) * Eint n 1 0 + (-2) * Eint n 2 1 + (-2) *
    Eint n 2 3 + (-1) * Eint n 3 0 := by
  simp [Eint]; ring

theorem cert_11 (n : Fin 4 → ℤ) : 6 * (n 1 * n 1) = (-1) * Eint n 1 1 + (-2) * Eint n 2 0 + (1) *
    Eint n 3 1 + (1) * Eint n 3 3 := by
  simp [Eint]; ring

theorem cert_12 (n : Fin 4 → ℤ) : 6 * (n 1 * n 2) = (2) * Eint n 1 0 + (2) * Eint n 2 1 + (-1) *
    Eint n 3 0 := by
  simp [Eint]; ring

theorem cert_13 (n : Fin 4 → ℤ) : 6 * (n 1 * n 3) = (-1) * Eint n 1 3 + (1) * Eint n 2 0 + (-1) *
    Eint n 3 1 := by
  simp [Eint]; ring

theorem cert_22 (n : Fin 4 → ℤ) : 6 * (n 2 * n 2) = (4) * Eint n 0 0 + (-2) * Eint n 1 1 + (-4) *
    Eint n 2 0 + (-2) * Eint n 3 3 := by
  simp [Eint]; ring

theorem cert_23 (n : Fin 4 → ℤ) : 6 * (n 2 * n 3) = (-1) * Eint n 1 0 + (2) * Eint n 2 3 + (2) *
    Eint n 3 0 := by
  simp [Eint]; ring

theorem cert_33 (n : Fin 4 → ℤ) : 6 * (n 3 * n 3) = (1) * Eint n 1 1 + (1) * Eint n 1 3 + (-2) *
    Eint n 2 0 + (-1) * Eint n 3 3 := by
  simp [Eint]; ring

theorem Eint_eq (n : Fin 4 → ℤ) (k l : Fin 4) :
    coordQ (comb n * eQ k * star (comb n)) l = Eint n k l := by
  fin_cases k <;> fin_cases l <;> simp [coordQ, comb, eQ, Eint] <;> ring

/-- If `x = comb n` normalizes `𝒪`, then `nrd x` divides every `E_kl`. -/
theorem nrd_dvd_Eint (x : Bˣ) (n : Fin 4 → ℤ) (hxn : (x : B) = comb n)
    (hx : ∀ y ∈ O, (x : B) * y * ((x⁻¹ : Bˣ) : B) ∈ O) (k l : Fin 4) : nrdInt n ∣ Eint n k l := by
  obtain ⟨m, hm⟩ := hx (eQ k) ⟨_, rfl⟩
  have hstar : star (x : B) = nrd (x : B) • ((x⁻¹ : Bˣ) : B) := by
    have : ((x⁻¹ : Bˣ) : B) * ((x : B) * star (x : B)) = star (x : B) := by
      rw [← mul_assoc, Units.inv_mul, one_mul]
    rw [← this, mul_star_eq, Algebra.smul_def, ← Algebra.commutes]
  have e : (Eint n k l : ℚ) = nrdInt n * m l := by
    rw [← Eint_eq, ← hxn, hstar, mul_smul_comm, ← hm]
    have : ∀ (c : ℚ) (y : B), coordQ (c • y) l = c * coordQ y l := by
      intro c y; fin_cases l <;> simp [coordQ] <;> ring
    rw [this, coordQ_comb, hxn, nrd_comb]
  exact ⟨m l, by exact_mod_cast e⟩

/-- **Global finite computation.** A primitive element of `𝒪` normalizing `𝒪` has `nrd ∣ 6`. -/
theorem nrd_dvd_six (x : Bˣ) (n : Fin 4 → ℤ) (hxn : (x : B) = comb n)
    (hprim : ∃ s : Fin 4 → ℤ, s 0 * n 0 + s 1 * n 1 + s 2 * n 2 + s 3 * n 3 = 1)
    (hx : ∀ y ∈ O, (x : B) * y * ((x⁻¹ : Bˣ) : B) ∈ O) : nrdInt n ∣ 6 := by
  obtain ⟨s, hs⟩ := hprim
  have d := nrd_dvd_Eint x n hxn hx
  have h00 : nrdInt n ∣ 6 * (n 0 * n 0) := by
    rw [cert_00]; repeat' apply dvd_add
    all_goals exact dvd_mul_of_dvd_right (d _ _) _
  have h01 : nrdInt n ∣ 6 * (n 0 * n 1) := by
    rw [cert_01]; repeat' apply dvd_add
    all_goals exact dvd_mul_of_dvd_right (d _ _) _
  have h02 : nrdInt n ∣ 6 * (n 0 * n 2) := by
    rw [cert_02]; repeat' apply dvd_add
    all_goals exact dvd_mul_of_dvd_right (d _ _) _
  have h03 : nrdInt n ∣ 6 * (n 0 * n 3) := by
    rw [cert_03]; repeat' apply dvd_add
    all_goals exact dvd_mul_of_dvd_right (d _ _) _
  have h11 : nrdInt n ∣ 6 * (n 1 * n 1) := by
    rw [cert_11]; repeat' apply dvd_add
    all_goals exact dvd_mul_of_dvd_right (d _ _) _
  have h12 : nrdInt n ∣ 6 * (n 1 * n 2) := by
    rw [cert_12]; repeat' apply dvd_add
    all_goals exact dvd_mul_of_dvd_right (d _ _) _
  have h13 : nrdInt n ∣ 6 * (n 1 * n 3) := by
    rw [cert_13]; repeat' apply dvd_add
    all_goals exact dvd_mul_of_dvd_right (d _ _) _
  have h22 : nrdInt n ∣ 6 * (n 2 * n 2) := by
    rw [cert_22]; repeat' apply dvd_add
    all_goals exact dvd_mul_of_dvd_right (d _ _) _
  have h23 : nrdInt n ∣ 6 * (n 2 * n 3) := by
    rw [cert_23]; repeat' apply dvd_add
    all_goals exact dvd_mul_of_dvd_right (d _ _) _
  have h33 : nrdInt n ∣ 6 * (n 3 * n 3) := by
    rw [cert_33]; repeat' apply dvd_add
    all_goals exact dvd_mul_of_dvd_right (d _ _) _
  have e : (6 : ℤ) = s 0 ^ 2 * (6 * (n 0 * n 0)) + 2 * s 0 * s 1 * (6 * (n 0 * n 1))
      + 2 * s 0 * s 2 * (6 * (n 0 * n 2)) + 2 * s 0 * s 3 * (6 * (n 0 * n 3))
      + s 1 ^ 2 * (6 * (n 1 * n 1)) + 2 * s 1 * s 2 * (6 * (n 1 * n 2)) + 2 * s 1 * s 3 * (6 * (n 1
          * n 3))
      + s 2 ^ 2 * (6 * (n 2 * n 2)) + 2 * s 2 * s 3 * (6 * (n 2 * n 3)) + s 3 ^ 2 * (6 * (n 3 * n
          3)) := by
    linear_combination (-6) * (s 0 * n 0 + s 1 * n 1 + s 2 * n 2 + s 3 * n 3 + 1) * hs
  rw [e]
  repeat' apply dvd_add
  all_goals first
    | exact dvd_mul_of_dvd_right h00 _
    | exact dvd_mul_of_dvd_right h01 _
    | exact dvd_mul_of_dvd_right h02 _
    | exact dvd_mul_of_dvd_right h03 _
    | exact dvd_mul_of_dvd_right h11 _
    | exact dvd_mul_of_dvd_right h12 _
    | exact dvd_mul_of_dvd_right h13 _
    | exact dvd_mul_of_dvd_right h22 _
    | exact dvd_mul_of_dvd_right h23 _
    | exact dvd_mul_of_dvd_right h33 _

/-! ## The global index `[N_B(𝒪) : ℚ^×𝒪^×] = 4` -/

/-- Structure constants of `𝒪` (copied from glue-repo). -/
def combMul (n m : Fin 4 → ℤ) : Fin 4 → ℤ :=
  ![m 0 * n 0 + 2 * m 1 * n 1 + 2 * m 1 * n 3 - m 2 * n 2 + 2 * m 3 * n 3,
    m 0 * n 1 + m 1 * n 0 + m 1 * n 2 - m 2 * n 3 + m 3 * n 2,
    m 0 * n 2 - 2 * m 1 * n 3 + m 2 * n 0 + m 2 * n 2 + 2 * m 3 * n 1,
    m 0 * n 3 - m 1 * n 2 + m 2 * n 1 + m 2 * n 3 + m 3 * n 0]

theorem comb_mul (n m : Fin 4 → ℤ) : comb n * comb m = comb (combMul n m) := by
  ext <;> simp [comb, combMul] <;> push_cast <;> ring

theorem O_mul {x y : B} (hx : x ∈ O) (hy : y ∈ O) : x * y ∈ O := by
  obtain ⟨n, rfl⟩ := hx; obtain ⟨m, rfl⟩ := hy; exact ⟨_, (comb_mul n m).symm⟩

theorem star_comb (n : Fin 4 → ℤ) : star (comb n) = comb ![n 0 + n 2, -n 1, -n 2, -n 3] := by
  ext <;> simp [comb] <;> ring

theorem O_star {x : B} (hx : x ∈ O) : star x ∈ O := by
  obtain ⟨n, rfl⟩ := hx; exact ⟨_, (star_comb n).symm⟩

theorem O_smul_int {x : B} (hx : x ∈ O) (c : ℤ) : (c : ℚ) • x ∈ O := by
  obtain ⟨n, rfl⟩ := hx; exact ⟨c • n, by ext <;> simp [comb] <;> ring⟩

theorem nrd_mul (x y : B) : nrd (x * y) = nrd x * nrd y := by
  simp [nrd]; ring

theorem nrd_one : nrd 1 = 1 := by simp [nrd]

theorem nrd_smul (c : ℚ) (x : B) : nrd (c • x) = c ^ 2 * nrd x := by
  simp [nrd]; ring

/-- `nrd` as a monoid hom. -/
def nrdHom : B →* ℚ where
  toFun := nrd
  map_one' := nrd_one
  map_mul' := nrd_mul

/-- The normalizer `N_B(𝒪) = {x ∈ B^× : x 𝒪 x⁻¹ = 𝒪}`. -/
def N : Subgroup Bˣ where
  carrier := {x | ∀ y : B, y ∈ O ↔ (x : B) * y * ((x⁻¹ : Bˣ) : B) ∈ O}
  one_mem' := by intro y; simp
  mul_mem' := by
    intro a b ha hb y
    rw [hb y, ha]
    simp only [Units.val_mul, mul_inv_rev, mul_assoc]
  inv_mem' := by
    intro a ha y
    rw [ha ((((a⁻¹ : Bˣ) : B) * y * (((a⁻¹)⁻¹ : Bˣ) : B)))]
    simp only [inv_inv, mul_assoc, Units.mul_inv_cancel_left]
    simp [mul_assoc]

/-- `𝒪^×`. -/
def OUnits : Set Bˣ := {u | (u : B) ∈ O ∧ ((u⁻¹ : Bˣ) : B) ∈ O}

/-- `ℚ^× 𝒪^×`. -/
def S : Set Bˣ := {x | ∃ c : ℚˣ, ∃ u ∈ OUnits, (x : B) = (c : ℚ) • (u : B)}

def iU : Bˣ := ⟨⟨0, 1, 0, 0⟩, ⟨0, 1/2, 0, 0⟩, by
    ext <;> simp <;> norm_num, by ext <;> simp <;> norm_num⟩
def jU : Bˣ := ⟨⟨0, 0, 1, 0⟩, ⟨0, 0, -1/3, 0⟩, by
    ext <;> simp <;> norm_num, by ext <;> simp <;> norm_num⟩

theorem conj_mem_N (x : Bˣ) (L : (Fin 4 → ℤ) → (Fin 4 → ℤ))
    (h1 : ∀ n, (x : B) * comb n * ((x⁻¹ : Bˣ) : B) = comb (L n))
    (h2 : ∀ n, ((x⁻¹ : Bˣ) : B) * comb n * (x : B) = comb (L n)) : x ∈ N := by
  intro y
  constructor
  · rintro ⟨n, rfl⟩; exact ⟨_, (h1 n).symm⟩
  · rintro ⟨m, hm⟩
    have : y = ((x⁻¹ : Bˣ) : B) * ((x : B) * y * ((x⁻¹ : Bˣ) : B)) * (x : B) := by
      simp [mul_assoc]
    rw [this, ← hm, h2]; exact ⟨_, rfl⟩

theorem iU_mem : iU ∈ N := by
  apply conj_mem_N iU (fun n => ![n 0 + n 2, n 1 + n 3, -n 2, -n 3])
  · intro n; ext <;> simp [iU, comb] <;> ring
  · intro n; ext <;> simp [iU, comb] <;> ring

theorem jU_mem : jU ∈ N := by
  apply conj_mem_N jU (fun n => ![n 0, -n 1, n 2, -n 3])
  · intro n; ext <;> simp [jU, comb] <;> ring
  · intro n; ext <;> simp [jU, comb] <;> ring

theorem nrd_iU : nrd (iU : B) = -2 := by simp [nrd, iU]
theorem nrd_jU : nrd (jU : B) = 3 := by simp [nrd, jU]


theorem eq_of_coordQ {x y : B} (h : ∀ k, coordQ x k = coordQ y k) : x = y := by
  have h0 := h 0; have h1 := h 1; have h2 := h 2; have h3 := h 3
  simp [coordQ] at h0 h1 h2 h3
  ext <;> linarith

theorem coordQ_smul (c : ℚ) (x : B) (k : Fin 4) : coordQ (c • x) k = c * coordQ x k := by
  fin_cases k <;> simp [coordQ] <;> ring

/-- **Primitive scaling.** Every nonzero `x ∈ B` is `c · comb a` with `c ∈ ℚ^×` and `a` primitive.
  -/
theorem primitive_scaling (x : B) (hx : x ≠ 0) : ∃ c : ℚ, c ≠ 0 ∧ ∃ a : Fin 4 → ℤ,
    (∃ s0 s1 s2 s3 : ℤ, s0 * a 0 + s1 * a 1 + s2 * a 2 + s3 * a 3 = 1) ∧ x = c • comb a := by
  set q := coordQ x
  set D : ℤ := (q 0).den * (q 1).den * (q 2).den * (q 3).den with hD
  have hDpos : (D : ℚ) ≠ 0 := by
    simp only [hD]; push_cast; positivity
  let m : Fin 4 → ℤ := ![(q 0).num * ((q 1).den * (q 2).den * (q 3).den),
    (q 1).num * ((q 0).den * (q 2).den * (q 3).den), (q 2).num * ((q 0).den * (q 1).den * (q
        3).den),
    (q 3).num * ((q 0).den * (q 1).den * (q 2).den)]
  have hm0 : (D : ℚ) * q 0 = m 0 := by
    show (D : ℚ) * q 0 = (((q 0).num * ((q 1).den * (q 2).den * (q 3).den) : ℤ) : ℚ)
    rw [hD]; push_cast; rw [← Rat.mul_den_eq_num (q 0)]; ring
  have hm1 : (D : ℚ) * q 1 = m 1 := by
    show (D : ℚ) * q 1 = (((q 1).num * ((q 0).den * (q 2).den * (q 3).den) : ℤ) : ℚ)
    rw [hD]; push_cast; rw [← Rat.mul_den_eq_num (q 1)]; ring
  have hm2 : (D : ℚ) * q 2 = m 2 := by
    show (D : ℚ) * q 2 = (((q 2).num * ((q 0).den * (q 1).den * (q 3).den) : ℤ) : ℚ)
    rw [hD]; push_cast; rw [← Rat.mul_den_eq_num (q 2)]; ring
  have hm3 : (D : ℚ) * q 3 = m 3 := by
    show (D : ℚ) * q 3 = (((q 3).num * ((q 0).den * (q 1).den * (q 2).den) : ℤ) : ℚ)
    rw [hD]; push_cast; rw [← Rat.mul_den_eq_num (q 3)]; ring
  have hm : ∀ k, (D : ℚ) * q k = m k := by
    intro k; fin_cases k
    · exact hm0
    · exact hm1
    · exact hm2
    · exact hm3
  set g1 := Int.gcd (m 0) (m 1)
  set g2 := Int.gcd (m 2) (m 3)
  set g := Int.gcd g1 g2
  have hg0 : (g : ℤ) ≠ 0 := by
    intro h0
    have : g = 0 := by exact_mod_cast h0
    simp only [g, g1, g2, Int.gcd_eq_zero_iff, Int.natCast_eq_zero] at this
    obtain ⟨⟨a0, a1⟩, a2, a3⟩ := this
    apply hx
    have hq : ∀ k, q k = 0 := by
      intro k
      have := hm k
      have hmk : m k = 0 := by fin_cases k <;> assumption
      rw [hmk, Int.cast_zero] at this
      exact (mul_eq_zero.mp this).resolve_left hDpos
    apply eq_of_coordQ; intro k; show q k = coordQ 0 k; rw [hq k]; fin_cases k <;> simp [coordQ]
  have hdvd : ∀ k, (g : ℤ) ∣ m k := by
    intro k
    have d1 : (g : ℤ) ∣ g1 := Int.gcd_dvd_left _ _
    have d2 : (g : ℤ) ∣ g2 := Int.gcd_dvd_right _ _
    fin_cases k
    · exact d1.trans (Int.gcd_dvd_left _ _)
    · exact d1.trans (Int.gcd_dvd_right _ _)
    · exact d2.trans (Int.gcd_dvd_left _ _)
    · exact d2.trans (Int.gcd_dvd_right _ _)
  let a : Fin 4 → ℤ := fun k => m k / g
  have ha : ∀ k, m k = g * a k := fun k => (Int.mul_ediv_cancel' (hdvd k)).symm
  refine ⟨(g : ℚ) / D, div_ne_zero (by exact_mod_cast hg0) hDpos, a, ?_, ?_⟩
  · have b : (g : ℤ) = (g1 : ℤ) * Int.gcdA g1 g2 + (g2 : ℤ) * Int.gcdB g1 g2 :=
      Int.gcd_eq_gcd_ab _ _
    have b1 : (g1 : ℤ) = m 0 * Int.gcdA (m 0) (m 1) + m 1 * Int.gcdB (m 0) (m 1) :=
      Int.gcd_eq_gcd_ab _ _
    have b2 : (g2 : ℤ) = m 2 * Int.gcdA (m 2) (m 3) + m 3 * Int.gcdB (m 2) (m 3) :=
      Int.gcd_eq_gcd_ab _ _
    refine ⟨Int.gcdA (m 0) (m 1) * Int.gcdA g1 g2, Int.gcdB (m 0) (m 1) * Int.gcdA g1 g2,
      Int.gcdA (m 2) (m 3) * Int.gcdB g1 g2, Int.gcdB (m 2) (m 3) * Int.gcdB g1 g2, ?_⟩
    apply mul_left_cancel₀ hg0
    linear_combination (-(Int.gcdA (m 0) (m 1) * Int.gcdA g1 g2)) * ha 0
      - (Int.gcdB (m 0) (m 1) * Int.gcdA g1 g2) * ha 1
      - (Int.gcdA (m 2) (m 3) * Int.gcdB g1 g2) * ha 2
      - (Int.gcdB (m 2) (m 3) * Int.gcdB g1 g2) * ha 3
      - Int.gcdA g1 g2 * b1 - Int.gcdB g1 g2 * b2 - b
  · apply eq_of_coordQ; intro k
    rw [coordQ_smul, coordQ_comb]
    have e1 := hm k
    rw [ha k] at e1
    push_cast at e1
    field_simp
    linarith


/-- `x ↦ v_p(x) mod 2` on `ℚ^×`. -/
noncomputable def vhom (p : ℕ) [Fact p.Prime] : ℚˣ →* Multiplicative (ZMod 2) where
  toFun c := Multiplicative.ofAdd ((padicValRat p (c : ℚ) : ℤ) : ZMod 2)
  map_one' := by simp
  map_mul' a b := by
    simp only [Units.val_mul, padicValRat.mul a.ne_zero b.ne_zero, Int.cast_add, ofAdd_add]

theorem vhom_apply (p : ℕ) [Fact p.Prime] (c : ℚˣ) :
    vhom p c = Multiplicative.ofAdd ((padicValRat p (c : ℚ) : ℤ) : ZMod 2) := rfl

/-- `nrd : B^× → ℚ^×`. -/
def nrdU : Bˣ →* ℚˣ := Units.map nrdHom

theorem nrdU_val (x : Bˣ) : ((nrdU x : ℚˣ) : ℚ) = nrd (x : B) := rfl

/-- `φ : N_B(𝒪) → (ℤ/2)²`, `x ↦ (v₂(nrd x), v₃(nrd x)) mod 2`. -/
noncomputable def φ : N →* Multiplicative (ZMod 2) × Multiplicative (ZMod 2) :=
  MonoidHom.prod ((vhom 2).comp (nrdU.comp N.subtype)) ((vhom 3).comp (nrdU.comp N.subtype))

theorem ofAdd_eq_one (z : ZMod 2) : Multiplicative.ofAdd z = 1 ↔ z = 0 := Iff.rfl

theorem cast_two_mul (k : ℤ) : ((2 * k : ℤ) : ZMod 2) = 0 := by
  push_cast; rw [show (2 : ZMod 2) = 0 from rfl, zero_mul]

theorem v_sq_mul (p : ℕ) [Fact p.Prime] (c d : ℚ) (hc : c ≠ 0) (hd : d ≠ 0) :
    ((padicValRat p (c ^ 2 * d) : ℤ) : ZMod 2) = ((padicValRat p d : ℤ) : ZMod 2) := by
  rw [padicValRat.mul (pow_ne_zero 2 hc) hd, padicValRat.pow c, Int.cast_add]
  push_cast
  rw [show (2 : ZMod 2) = 0 from rfl, zero_mul, zero_add]

/-- Scaling by a nonzero rational keeps a unit in the normalizer. -/
theorem scale_unit (x : Bˣ) (c : ℚ) (hc : c ≠ 0) : ∃ x₀ : Bˣ, (x₀ : B) = c • (x : B) ∧
    ((x₀⁻¹ : Bˣ) : B) = c⁻¹ • ((x⁻¹ : Bˣ) : B) := by
  let cu : ℚˣ := Units.mk0 c hc
  have hv : ((Units.map (algebraMap ℚ B).toMonoidHom cu * x : Bˣ) : B) = c • (x : B) := by
    simp [cu, Algebra.smul_def]
  refine ⟨Units.map (algebraMap ℚ B).toMonoidHom cu * x, hv, ?_⟩
  apply Units.inv_eq_of_mul_eq_one_right
  rw [hv, smul_mul_smul_comm, mul_inv_cancel₀ hc, Units.mul_inv, one_smul]

theorem nrd_O_int {u : B} (hu : u ∈ O) : ∃ k : ℤ, nrd u = k := by
  obtain ⟨n, rfl⟩ := hu; exact ⟨nrdInt n, nrd_comb n⟩

theorem nrd_OUnits (u : Bˣ) (hu : u ∈ OUnits) : nrd (u : B) = 1 ∨ nrd (u : B) = -1 := by
  obtain ⟨k, hk⟩ := nrd_O_int hu.1
  obtain ⟨l, hl⟩ := nrd_O_int hu.2
  have h : nrd (u : B) * nrd ((u⁻¹ : Bˣ) : B) = 1 := by rw [← nrd_mul, Units.mul_inv, nrd_one]
  rw [hk, hl] at h
  have h' : k * l = 1 := by exact_mod_cast h
  rcases Int.eq_one_or_neg_one_of_mul_eq_one h' with h1 | h1 <;> [left; right] <;> rw [hk, h1] <;>
      simp

theorem divisors_six {d : ℤ} (hd : d ∣ 6) : d = 1 ∨ d = -1 ∨ d = 2 ∨ d = -2 ∨ d = 3 ∨ d = -3 ∨ d = 6
    ∨ d = -6 := by
  have h1 : d.natAbs ∣ 6 := by
    have := Int.natAbs_dvd_natAbs.mpr hd; simpa using this
  have h2 : d.natAbs ∈ Nat.divisors 6 := Nat.mem_divisors.mpr ⟨h1, by norm_num⟩
  have h3 : Nat.divisors 6 = {1, 2, 3, 6} := by decide
  rw [h3] at h2
  simp only [Finset.mem_insert, Finset.mem_singleton] at h2
  rcases h2 with h | h | h | h <;> rcases Int.natAbs_eq d with e | e <;> rw [h] at e <;> simp [e]

theorem v2_two : padicValRat 2 (2 : ℚ) = 1 := by
  have := padicValRat.self (p := 2) (by norm_num); simpa using this
theorem v3_three : padicValRat 3 (3 : ℚ) = 1 := by
  have := padicValRat.self (p := 3) (by norm_num); simpa using this
theorem v2_three : padicValRat 2 (3 : ℚ) = 0 := by
  have := padicValRat.of_nat (p := 2) (n := 3)
  rw [padicValNat_primes (p := 2) (q := 3) (by norm_num)] at this
  simpa using this
theorem v3_two : padicValRat 3 (2 : ℚ) = 0 := by
  have := padicValRat.of_nat (p := 3) (n := 2)
  rw [padicValNat_primes (p := 3) (q := 2) (by norm_num)] at this
  simpa using this
theorem v2_six : padicValRat 2 (6 : ℚ) = 1 := by
  rw [show (6 : ℚ) = 2 * 3 by
      norm_num, padicValRat.mul (by norm_num) (by norm_num), v2_two, v2_three]; rfl
theorem v3_six : padicValRat 3 (6 : ℚ) = 1 := by
  rw [show (6 : ℚ) = 2 * 3 by
      norm_num, padicValRat.mul (by norm_num) (by norm_num), v3_two, v3_three]; rfl


theorem star_eq_nrd_smul_inv (x : Bˣ) : star (x : B) = nrd (x : B) • ((x⁻¹ : Bˣ) : B) := by
  have : ((x⁻¹ : Bˣ) : B) * ((x : B) * star (x : B)) = star (x : B) := by
    rw [← mul_assoc, Units.inv_mul, one_mul]
  rw [← this, mul_star_eq, Algebra.smul_def, ← Algebra.commutes]

theorem phi_eq_one_iff' (x : N) : φ x = 1 ↔
    ((padicValRat 2 (nrd ((x : Bˣ) : B)) : ℤ) : ZMod 2) = 0 ∧ ((padicValRat 3 (nrd ((x : Bˣ) : B)) :
        ℤ) : ZMod 2) = 0 := by
  simp only [φ, MonoidHom.prod_apply, MonoidHom.comp_apply, Subgroup.coe_subtype, vhom_apply,
      nrdU_val,
    Prod.mk_eq_one, ofAdd_eq_one]

/-- **The kernel of `φ` is `ℚ^× 𝒪^×`.** -/
theorem phi_eq_one_iff (x : N) : φ x = 1 ↔ (x : Bˣ) ∈ S := by
  rw [phi_eq_one_iff']
  constructor
  · rintro ⟨h2, h3⟩
    have hx0 : ((x : Bˣ) : B) ≠ 0 := (x : Bˣ).ne_zero
    obtain ⟨c, hc, a, ⟨s0, s1, s2, s3, hs⟩, hxa⟩ := primitive_scaling _ hx0
    obtain ⟨x₀, hx₀, hx₀inv⟩ := scale_unit (x : Bˣ) c⁻¹ (inv_ne_zero hc)
    have hx₀a : (x₀ : B) = comb a := by rw [hx₀, hxa, smul_smul, inv_mul_cancel₀ hc, one_smul]
    have hN : ∀ y ∈ O, (x₀ : B) * y * ((x₀⁻¹ : Bˣ) : B) ∈ O := by
      intro y hy
      have e : (x₀ : B) * y * ((x₀⁻¹ : Bˣ) : B) = ((x : Bˣ) : B) * y * (((x : Bˣ)⁻¹ : Bˣ) : B) := by
        rw [hx₀, hx₀inv, smul_mul_assoc, smul_mul_assoc, mul_smul_comm, smul_smul, inv_inv,
          inv_mul_cancel₀ hc, one_smul]
      rw [e]; exact (x.2 y).mp hy
    have hd := nrd_dvd_six x₀ a hx₀a ⟨![s0, s1, s2, s3], by simpa using hs⟩ hN
    have hnx : nrd ((x : Bˣ) : B) = c ^ 2 * (nrdInt a : ℚ) := by rw [hxa, nrd_smul, nrd_comb]
    have hna : (nrdInt a : ℚ) ≠ 0 := by
      intro h0; have : nrdInt a = 0 := by exact_mod_cast h0
      rw [this] at hd; norm_num at hd
    rw [hnx, v_sq_mul 2 c _ hc hna] at h2
    rw [hnx, v_sq_mul 3 c _ hc hna] at h3
    have h1 : nrdInt a = 1 ∨ nrdInt a = -1 := by
      rcases divisors_six hd with e | e | e | e | e | e | e | e <;> rw [e] at h2 h3 ⊢ <;>
        push_cast at h2 h3 <;>
        (try simp only [padicValRat.neg, v2_two, v2_six, v3_three, v3_six] at h2 h3) <;>
        first
          | (left; rfl) | (right; rfl) | (exfalso; revert h2; decide)
          | (exfalso; revert h3; decide)
    have hx₀O : (x₀ : B) ∈ O := by rw [hx₀a]; exact ⟨a, rfl⟩
    refine ⟨Units.mk0 c hc, x₀, ⟨hx₀O, ?_⟩, ?_⟩
    · have hn : nrd (x₀ : B) = nrdInt a := by rw [hx₀a, nrd_comb]
      have e : ((x₀⁻¹ : Bˣ) : B) = ((nrdInt a : ℤ) : ℚ) • star (x₀ : B) := by
        rw [star_eq_nrd_smul_inv, smul_smul, hn]
        rcases h1 with h | h <;> rw [h] <;> norm_num
      rw [e]; exact O_smul_int (O_star hx₀O) _
    · simp only [Units.val_mk0]; rw [hx₀, smul_smul, mul_inv_cancel₀ hc, one_smul]
  · rintro ⟨c, u, hu, hxu⟩
    have hnx : nrd ((x : Bˣ) : B) = (c : ℚ) ^ 2 * nrd (u : B) := by rw [hxu, nrd_smul]
    have hu0 : nrd (u : B) ≠ 0 := by rcases nrd_OUnits u hu with h | h <;> rw [h] <;> norm_num
    rw [hnx, v_sq_mul 2 _ _ c.ne_zero hu0, v_sq_mul 3 _ _ c.ne_zero hu0]
    rcases nrd_OUnits u hu with h | h <;> rw [h] <;> simp [padicValRat.neg]

theorem phi_i : φ ⟨iU, iU_mem⟩ = (Multiplicative.ofAdd 1, 1) := by
  simp only [φ, MonoidHom.prod_apply, MonoidHom.comp_apply, Subgroup.coe_subtype, vhom_apply,
      nrdU_val]
  rw [nrd_iU, padicValRat.neg, padicValRat.neg, v2_two, v3_two]; rfl

theorem phi_j : φ ⟨jU, jU_mem⟩ = (1, Multiplicative.ofAdd 1) := by
  simp only [φ, MonoidHom.prod_apply, MonoidHom.comp_apply, Subgroup.coe_subtype, vhom_apply,
      nrdU_val]
  rw [nrd_jU, v2_three, v3_three]; rfl

theorem phi_surjective : Function.Surjective φ := by
  have two : ∀ z : Multiplicative (ZMod 2), z = 1 ∨ z = Multiplicative.ofAdd 1 := by decide
  rintro ⟨g1, g2⟩
  rcases two g1 with rfl | rfl <;> rcases two g2 with rfl | rfl
  · exact ⟨1, map_one φ⟩
  · exact ⟨⟨jU, jU_mem⟩, phi_j⟩
  · exact ⟨⟨iU, iU_mem⟩, phi_i⟩
  · exact ⟨⟨iU, iU_mem⟩ * ⟨jU, jU_mem⟩, by rw [map_mul, phi_i, phi_j]; rfl⟩

/-- **Global index.** `ℚ^×𝒪^×` is the kernel of the surjection `φ : N_B(𝒪) → (ℤ/2)²`; hence
`[N_B(𝒪) : ℚ^×𝒪^×] = 4`, with coset representatives `1, i, j, ij`. -/
theorem global_index :
    (∀ x : N, x ∈ φ.ker ↔ (x : Bˣ) ∈ S) ∧ φ.ker.index = 4 := by
  refine ⟨fun x => phi_eq_one_iff x, ?_⟩
  rw [Subgroup.index_ker, MonoidHom.range_eq_top_of_surjective φ phi_surjective, Subgroup.card_top,
    Nat.card_eq_fintype_card]
  rfl


/-- `ℚ^×𝒪^× ⊆ N_B(𝒪)`. -/
theorem S_subset_N (x : Bˣ) (hx : x ∈ S) : x ∈ N := by
  obtain ⟨c, u, ⟨hu, hu'⟩, hxu⟩ := hx
  have hinv : ((x⁻¹ : Bˣ) : B) = ((c⁻¹ : ℚˣ) : ℚ) • ((u⁻¹ : Bˣ) : B) := by
    apply Units.inv_eq_of_mul_eq_one_right
    rw [hxu, smul_mul_smul_comm, Units.mul_inv, Units.mul_inv, one_smul]
  intro y
  have e : (x : B) * y * ((x⁻¹ : Bˣ) : B) = (u : B) * y * ((u⁻¹ : Bˣ) : B) := by
    rw [hinv, hxu, smul_mul_assoc, mul_smul_comm, smul_mul_assoc, smul_smul, Units.inv_mul,
        one_smul]
  rw [e]
  constructor
  · intro hy; exact O_mul (O_mul hu hy) hu'
  · intro h
    have : y = ((u⁻¹ : Bˣ) : B) * ((u : B) * y * ((u⁻¹ : Bˣ) : B)) * (u : B) := by simp [mul_assoc]
    rw [this]; exact O_mul (O_mul hu' h) hu

/-- **`[N_B(𝒪) : ℚ^×𝒪^×] = 4`**, stated with `ℚ^×𝒪^×` as a subgroup of `N_B(𝒪)`: the set `S` lies in
`N`, equals the kernel of `φ` there, and that kernel has index 4. -/
theorem normalizer_index_four :
    (∀ x : Bˣ, x ∈ S → x ∈ N) ∧ (∀ x : N, x ∈ φ.ker ↔ (x : Bˣ) ∈ S) ∧ φ.ker.index = 4 :=
  ⟨S_subset_N, global_index⟩

end GlueVigneras.Global
