/-- The cover predicate: `γ = q·ι(rep i)·ι(u)`, `q ∈ ℚ^×`, `u ∈ 𝒪¹`. -/
def Pm (γ : GL (Fin 2) ℝ) : Prop :=
  ∃ i : Fin 4, ∃ q : ℚ, q ≠ 0 ∧ ∃ u : PkgI1.B, PkgI1.InO u ∧ nrd u = 1 ∧
    (γ : Matrix (Fin 2) (Fin 2) ℝ) = PkgI1.iota ((q : PkgI1.B) * rep i * u)

theorem Pm_one : Pm 1 :=
  ⟨0, 1, one_ne_zero, 1, (inO_iff _).2 ⟨1, 0, 0, 0, by ext <;> norm_num⟩, by norm_num [nrd],
    by simp [rep, iota_one]⟩

theorem Pm_step {g : PkgI1.B}
    (htab : ∀ i : Fin 4, ∃ (k : Fin 4) (r : ℚ) (u : PkgI1.B), r ≠ 0 ∧ PkgI1.InO u ∧ nrd u = 1 ∧
      g * rep i = ((r : ℚ) : PkgI1.B) * rep k * u)
    {x γ : GL (Fin 2) ℝ} (hx : (x : Matrix (Fin 2) (Fin 2) ℝ) = PkgI1.iota g) (hγ : Pm γ) :
    Pm (x * γ) := by
  obtain ⟨i, q, hq, u, hu, hnu, hγm⟩ := hγ
  obtain ⟨k, r, u', hr, hu', hnu', he⟩ := htab i
  refine ⟨k, q * r, mul_ne_zero hq hr, u' * u, inO_mul hu' hu, by rw [nrd_mul, hnu', hnu, one_mul], ?_⟩
  rw [Units.val_mul, hx, hγm, ← iota_mul]
  congr 1
  calc g * ((q : PkgI1.B) * rep i * u) = (g * (q : PkgI1.B)) * rep i * u := by simp only [mul_assoc]
    _ = (q : PkgI1.B) * (g * rep i) * u := by rw [← QuaternionAlgebra.coe_commutes]; simp only [mul_assoc]
    _ = ((q * r : ℚ) : PkgI1.B) * rep k * (u' * u) := by
      rw [he, QuaternionAlgebra.coe_mul]; simp only [mul_assoc]

theorem Pm_scal {q' : ℚ} (hq' : q' ≠ 0) {x γ : GL (Fin 2) ℝ}
    (hx : (x : Matrix (Fin 2) (Fin 2) ℝ) = PkgI1.iota (q' : PkgI1.B)) (hγ : Pm γ) : Pm (x * γ) := by
  obtain ⟨i, q, hq, u, hu, hnu, hγm⟩ := hγ
  refine ⟨i, q' * q, mul_ne_zero hq' hq, u, hu, hnu, ?_⟩
  rw [Units.val_mul, hx, hγm, ← iota_mul, QuaternionAlgebra.coe_mul]; simp only [mul_assoc]

/-- **Cover**: every `γ ∈ Γ*` is `q·ι(rep i)·ι(u)` with `q ∈ ℚ^×`, `u ∈ 𝒪¹`. -/
theorem cover {γ : GL (Fin 2) ℝ} (hγ : γ ∈ Γs) : Pm γ := by
  have hcl := gammaStarGen_proof γ hγ
  clear hγ
  induction hcl using Subgroup.closure_induction_left with
  | one => exact Pm_one
  | mul_left x hx y _ ih =>
    rcases hx with (hx | hx) | ⟨q', hq', hx⟩
    · exact Pm_step tab_x4 hx ih
    · exact Pm_step tab_x6 hx ih
    · exact Pm_scal hq' (by rw [hx, iota_ratCast]) ih
  | inv_mul_cancel x hx y _ ih =>
    rcases hx with (hx | hx) | ⟨q', hq', hx⟩
    · exact Pm_step tab_x4i (inv_coe hx x4_x4i) ih
    · exact Pm_step tab_x6i (inv_coe hx x6_x6i) ih
    · refine Pm_scal (inv_ne_zero hq') (inv_coe (b := ((q'⁻¹ : ℚ) : PkgI1.B))
        (by rw [hx, iota_ratCast]) ?_) ih
      rw [← QuaternionAlgebra.coe_mul, mul_inv_cancel₀ hq']; rfl

/-! ### Möbius maps -/

open UpperHalfPlane (denom denom_ne_zero)

-- From qm-split `Haupt.lean` l.3380-3421 (verbatim).
/-- A matrix of positive determinant acting trivially on `ℍ` is scalar. -/
theorem scalar_of_trivial {γ : GL (Fin 2) ℝ} (hd : 0 < (γ : Matrix (Fin 2) (Fin 2) ℝ).det)
    (h : ∀ z : UpperHalfPlane, γ • z = z) :
    (γ : Matrix (Fin 2) (Fin 2) ℝ) 1 0 = 0 ∧ (γ : Matrix (Fin 2) (Fin 2) ℝ) 0 1 = 0 ∧
      (γ : Matrix (Fin 2) (Fin 2) ℝ) 0 0 = (γ : Matrix (Fin 2) (Fin 2) ℝ) 1 1 := by
  have hd' : 0 < γ.det.val := by rwa [Matrix.GeneralLinearGroup.val_det_apply]
  have key : ∀ z : UpperHalfPlane,
      ((γ : Matrix (Fin 2) (Fin 2) ℝ) 0 0 : ℂ) * z + ((γ : Matrix (Fin 2) (Fin 2) ℝ) 0 1 : ℂ) =
        (z : ℂ) * (((γ : Matrix (Fin 2) (Fin 2) ℝ) 1 0 : ℂ) * z + ((γ : Matrix (Fin 2) (Fin 2) ℝ) 1 1 : ℂ)) := by
    intro z
    have e : ((γ • z : UpperHalfPlane) : ℂ) = (z : ℂ) := congrArg (fun w : UpperHalfPlane => (w : ℂ)) (h z)
    rw [UpperHalfPlane.coe_smul_of_det_pos hd', div_eq_iff (denom_ne_zero γ z)] at e
    simpa [UpperHalfPlane.num, UpperHalfPlane.denom, mul_comm] using e
  have k1 := key UpperHalfPlane.I
  have k2 := key ⟨2 * Complex.I, by simp⟩
  simp only [UpperHalfPlane.coe_I] at k1
  simp only [UpperHalfPlane.coe_mk] at k2
  have r1 := congrArg Complex.re k1; have i1 := congrArg Complex.im k1
  have r2 := congrArg Complex.re k2
  simp at r1 i1 r2
  refine ⟨by linarith, by linarith, by linarith⟩

theorem rat_of_scalar {u : PkgI1.B} (h10 : PkgI1.iota u 1 0 = 0) (h01 : PkgI1.iota u 0 1 = 0)
    (h00 : PkgI1.iota u 0 0 = PkgI1.iota u 1 1) : u.imI = 0 ∧ u.imJ = 0 ∧ u.imK = 0 := by
  rw [iota_apply] at h10 h01 h00
  simp at h10 h01 h00
  have hs : (0 : ℝ) < √2 := Real.sqrt_pos.2 (by norm_num)
  have hK : (u.imK : ℝ) = 0 := by
    have : (u.imK : ℝ) * √2 = 0 := by linarith
    exact (mul_eq_zero.1 this).resolve_right hs.ne'
  have hJ : (u.imJ : ℝ) = 0 := by rw [hK] at h10; linarith
  have hI : (u.imI : ℝ) = 0 := by
    have : (u.imI : ℝ) * √2 = 0 := by linarith
    exact (mul_eq_zero.1 this).resolve_right hs.ne'
  exact ⟨by exact_mod_cast hI, by exact_mod_cast hJ, by exact_mod_cast hK⟩

theorem not_sq_q (q : ℚ) (c : ℤ) (hc : ¬ IsSquare c) (h : q * q = c) : False := by
  have h1 : IsSquare (c : ℚ) := ⟨q, by rw [← h]⟩
  rw [Rat.isSquare_iff] at h1
  simp at h1
  exact hc h1


theorem inO_star {x : PkgI1.B} (hx : PkgI1.InO x) : PkgI1.InO (star x) := by
  obtain ⟨n0, n1, n2, n3, rfl⟩ := (inO_iff x).1 hx
  exact (inO_iff _).2 ⟨n0 + n2, -n1, -n2, -n3, by ext <;> simp <;> push_cast <;> ring⟩

theorem mul_star_eq (x : PkgI1.B) : x * star x = ((nrd x : ℚ) : PkgI1.B) := by
  rw [QuaternionAlgebra.mul_star_eq_coe]; congr 1; simp [nrd]; ring

theorem star_mul_eq (x : PkgI1.B) : star x * x = ((nrd x : ℚ) : PkgI1.B) := by
  rw [QuaternionAlgebra.star_mul_eq_coe]; congr 1; simp [nrd]; ring

theorem nrd_star (x : PkgI1.B) : nrd (star x) = nrd x := by simp [nrd]

theorem nrd_ratCast' (q : ℚ) : nrd (q : PkgI1.B) = q ^ 2 := by simp [nrd]

theorem nrd_one : nrd (1 : PkgI1.B) = 1 := by simp [nrd]

/-- The element of `Γ*` for a representative. -/
def g4 (i : Fin 4) : GL (Fin 2) ℝ := glOf (rep i) (nrd_rep_pos i).ne'

theorem g4_coe (i : Fin 4) : (g4 i : Matrix (Fin 2) (Fin 2) ℝ) = PkgI1.iota (rep i) := rfl

theorem g4_mem (i : Fin 4) : g4 i ∈ Γs :=
  ⟨rep i, ⟨repi i, rep_repi i, repi_rep i, rep_conj i⟩, rfl, by
    rw [g4_coe, det_iota_eq]; exact_mod_cast nrd_rep_pos i⟩

theorem gamma1_iff {h : GL (Fin 2) ℝ} : h ∈ Gamma1 ↔ ∃ u : PkgI1.B, PkgI1.InO u ∧
    (h : Matrix (Fin 2) (Fin 2) ℝ) = PkgI1.iota u ∧ nrd u = 1 := by
  constructor
  · rintro ⟨u, hu, hhu, hd⟩
    refine ⟨u, hu, hhu, ?_⟩
    rw [hhu, det_iota_eq] at hd; exact_mod_cast hd
  · rintro ⟨u, hu, hhu, hn⟩
    exact ⟨u, hu, hhu, by rw [hhu, det_iota_eq, hn]; norm_num⟩

theorem one_mem_gamma1 : (1 : GL (Fin 2) ℝ) ∈ Gamma1 :=
  gamma1_iff.2 ⟨1, (inO_iff _).2 ⟨1, 0, 0, 0, by ext <;> norm_num⟩, by simp [iota_one], nrd_one⟩

theorem mul_mem_gamma1 {a b : GL (Fin 2) ℝ} (ha : a ∈ Gamma1) (hb : b ∈ Gamma1) : a * b ∈ Gamma1 := by
  obtain ⟨x, hx, hax, hnx⟩ := gamma1_iff.1 ha
  obtain ⟨y, hy, hby, hny⟩ := gamma1_iff.1 hb
  exact gamma1_iff.2 ⟨x * y, inO_mul hx hy, by rw [Units.val_mul, hax, hby, iota_mul],
    by rw [nrd_mul, hnx, hny, one_mul]⟩

theorem inv_mem_gamma1 {a : GL (Fin 2) ℝ} (ha : a ∈ Gamma1) : a⁻¹ ∈ Gamma1 := by
  obtain ⟨x, hx, hax, hnx⟩ := gamma1_iff.1 ha
  exact gamma1_iff.2 ⟨star x, inO_star hx, inv_coe hax (by rw [mul_star_eq, hnx]; rfl),
    by rw [nrd_star, hnx]⟩

theorem gamma1_sub {h : GL (Fin 2) ℝ} (hh : h ∈ Gamma1) : h ∈ Γs := by
  obtain ⟨x, hx, hhx, hnx⟩ := gamma1_iff.1 hh
  refine ⟨x, ⟨star x, by rw [mul_star_eq, hnx]; rfl, by rw [star_mul_eq, hnx]; rfl,
    fun w hw => ⟨inO_mul (inO_mul hx hw) (inO_star hx), inO_mul (inO_mul (inO_star hx) hw) hx⟩⟩,
    hhx, by rw [hhx, det_iota_eq, hnx]; norm_num⟩

theorem det_pos_of_mem {γ : GL (Fin 2) ℝ} (hγ : γ ∈ Γs) : 0 < (γ : Matrix (Fin 2) (Fin 2) ℝ).det := by
  obtain ⟨_, _, _, hd⟩ := hγ; exact hd

theorem conj_g4 (i : Fin 4) {h : GL (Fin 2) ℝ} (hh : h ∈ Gamma1) : g4 i * h * (g4 i)⁻¹ ∈ Gamma1 := by
  obtain ⟨u, hu, hhu, hnu⟩ := gamma1_iff.1 hh
  refine gamma1_iff.2 ⟨rep i * u * repi i, (rep_conj i u hu).1, ?_, ?_⟩
  · rw [Units.val_mul, Units.val_mul, g4_coe, hhu, inv_coe (g4_coe i) (rep_repi i), iota_mul, iota_mul]
  · have h1 : nrd (rep i) * nrd (repi i) = 1 := by rw [← nrd_mul, rep_repi, nrd_one]
    rw [nrd_mul, nrd_mul, hnu, mul_one, h1]

/-- Scalars act trivially. -/
theorem scal_smul {q : ℚ} (hq : q ≠ 0) (z : UpperHalfPlane) :
    Matrix.GeneralLinearGroup.scalar (Fin 2) (Units.mk0 (q : ℝ) (by exact_mod_cast hq)) • z = z :=
  UpperHalfPlane.glScalar_smul _ z

/-- **Cover, Möbius form**: `γ z = rᵢ (h z)` with `h ∈ Γ¹`. -/
theorem cover_mob {γ : GL (Fin 2) ℝ} (hγ : γ ∈ Γs) :
    ∃ i : Fin 4, ∃ h ∈ Gamma1, ∀ z : UpperHalfPlane, γ • z = g4 i • (h • z) := by
  obtain ⟨i, q, hq, u, hu, hnu, hγm⟩ := cover hγ
  have hu0 : nrd u ≠ 0 := by rw [hnu]; norm_num
  refine ⟨i, glOf u hu0, gamma1_iff.2 ⟨u, hu, rfl, hnu⟩, fun z => ?_⟩
  have e : γ = Matrix.GeneralLinearGroup.scalar (Fin 2) (Units.mk0 (q : ℝ) (by exact_mod_cast hq)) *
      (g4 i * glOf u hu0) := by
    ext1
    rw [hγm, Units.val_mul, Units.val_mul, Matrix.GeneralLinearGroup.coe_scalar, g4_coe, coe_glOf,
      iota_mul, iota_mul, iota_ratCast]
    simp [Matrix.scalar_apply, Matrix.smul_eq_diagonal_mul, mul_assoc]
  rw [e, mul_smul, scal_smul hq, mul_smul]

/-! ### `Γ*` is a group -/

theorem gs_one : (1 : GL (Fin 2) ℝ) ∈ Γs :=
  ⟨1, ⟨1, one_mul 1, one_mul 1, fun w hw => by simpa using hw⟩, by simp [iota_one], by simp⟩

theorem gs_mul {a b : GL (Fin 2) ℝ} (ha : a ∈ Γs) (hb : b ∈ Γs) : a * b ∈ Γs := by
  obtain ⟨x, ⟨y, hxy, hyx, hN⟩, hax, hda⟩ := ha
  obtain ⟨x', ⟨y', hxy', hyx', hN'⟩, hbx, hdb⟩ := hb
  refine ⟨x * x', ⟨y' * y, ?_, ?_, fun w hw => ⟨?_, ?_⟩⟩, by rw [Units.val_mul, hax, hbx, iota_mul], ?_⟩
  · calc x * x' * (y' * y) = x * (x' * y') * y := by simp only [mul_assoc]
      _ = 1 := by rw [hxy', mul_one, hxy]
  · calc y' * y * (x * x') = y' * (y * x) * x' := by simp only [mul_assoc]
      _ = 1 := by rw [hyx, mul_one, hyx']
  · have := (hN _ (hN' w hw).1).1
    have e : x * x' * w * (y' * y) = x * (x' * w * y') * y := by simp only [mul_assoc]
    rw [e]; exact this
  · have := (hN' _ (hN w hw).2).2
    have e : y' * y * w * (x * x') = y' * (y * w * x) * x' := by simp only [mul_assoc]
    rw [e]; exact this
  · rw [Units.val_mul, Matrix.det_mul]; exact mul_pos hda hdb

theorem gs_inv {a : GL (Fin 2) ℝ} (ha : a ∈ Γs) : a⁻¹ ∈ Γs := by
  obtain ⟨x, ⟨y, hxy, hyx, hN⟩, hax, hda⟩ := ha
  have hinv := inv_coe hax hxy
  refine ⟨y, ⟨x, hyx, hxy, fun w hw => ⟨(hN w hw).2, (hN w hw).1⟩⟩, hinv, ?_⟩
  have h1 : (a : Matrix (Fin 2) (Fin 2) ℝ) * ((a⁻¹ : GL (Fin 2) ℝ) : Matrix (Fin 2) (Fin 2) ℝ) = 1 := by
    rw [← Units.val_mul, mul_inv_cancel, Units.val_one]
  have h2 := congrArg Matrix.det h1
  rw [Matrix.det_mul, Matrix.det_one] at h2
  rcases lt_or_ge 0 ((a⁻¹ : GL (Fin 2) ℝ) : Matrix (Fin 2) (Fin 2) ℝ).det with h | h
  · exact h
  · nlinarith

/-! ### The four cosets are distinct -/

theorem nrd_repi_mul (i : Fin 4) : nrd (repi i) * nrd (rep i) = 1 := by
  rw [← nrd_mul, repi_rep, nrd_one]

/-- **Distinct cosets**: if `r_j z = r_i (h z)` for all `z` with `h ∈ Γ¹`, then `i = j`
(reduced norms `1, 2, 3, 6` are distinct modulo squares). -/
theorem coset_eq {i j : Fin 4} {h : GL (Fin 2) ℝ} (hh : h ∈ Gamma1)
    (hz : ∀ z : UpperHalfPlane, g4 j • z = g4 i • (h • z)) : i = j := by
  by_contra hij
  obtain ⟨u, hu, hhu, hnu⟩ := gamma1_iff.1 hh
  set γ := (g4 i * h)⁻¹ * g4 j with hγ
  have htriv : ∀ z : UpperHalfPlane, γ • z = z := fun z => by
    rw [hγ, mul_smul, hz, ← mul_smul (g4 i) h z, inv_smul_smul]
  have hab : rep i * u * (star u * repi i) = 1 := by
    calc rep i * u * (star u * repi i) = rep i * (u * star u) * repi i := by simp only [mul_assoc]
      _ = 1 := by rw [mul_star_eq, hnu]; simp [rep_repi]
  set w := star u * repi i * rep j with hw
  have hγw : (γ : Matrix (Fin 2) (Fin 2) ℝ) = PkgI1.iota w := by
    rw [hγ, Units.val_mul, inv_coe (a := rep i * u) (by rw [Units.val_mul, g4_coe, hhu, iota_mul]) hab,
      g4_coe, hw]
    simp only [iota_mul]
  have hnw : nrd w = nrd (repi i) * nrd (rep j) := by
    rw [hw, nrd_mul, nrd_mul, nrd_star, hnu, one_mul]
  have hpos : 0 < nrd (repi i) := by
    have := nrd_repi_mul i; have := nrd_rep_pos i
    by_contra hneg; push Not at hneg; nlinarith
  have hdγ : 0 < (γ : Matrix (Fin 2) (Fin 2) ℝ).det := by
    rw [hγw, det_iota_eq, hnw]; exact_mod_cast mul_pos hpos (nrd_rep_pos j)
  obtain ⟨s10, s01, s00⟩ := scalar_of_trivial hdγ htriv
  rw [hγw] at s10 s01 s00
  obtain ⟨hI, hJ, hK⟩ := rat_of_scalar s10 s01 s00
  have hnu' : nrd w = w.re * w.re := by simp [nrd, hI, hJ, hK]; ring
  have hprod : nrd (rep i) * nrd (rep j) = (w.re * nrd (rep i)) * (w.re * nrd (rep i)) := by
    have e : nrd (rep j) = nrd (rep i) * (nrd (repi i) * nrd (rep j)) := by
      rw [← mul_assoc, mul_comm (nrd (rep i)), nrd_repi_mul, one_mul]
    rw [e, ← hnw, hnu']; ring
  rw [nrd_rep i, nrd_rep j] at hprod
  have hsq : ∀ a b : Fin 4, a ≠ b →
      ¬ IsSquare ((![1, 2, 3, 6] : Fin 4 → ℤ) a * (![1, 2, 3, 6] : Fin 4 → ℤ) b) := by decide +kernel
  exact not_sq_q (w.re * ((![1, 2, 3, 6] : Fin 4 → ℤ) i : ℚ)) _ (hsq i j hij)
    (by push_cast; linarith)

/-! ## §2 `Γ*` is a cocompact Fuchsian group -/

theorem gs_fuchsian (hS : IsCocompactFuchsian Gamma1) : IsCocompactFuchsian Γs where
  one_mem := gs_one
  mul_mem := fun a ha b hb => gs_mul ha hb
  inv_mem := fun a ha => gs_inv ha
  det_pos := fun a ha => det_pos_of_mem ha
  properlyDiscontinuous := by
    intro K hK
    let K' : Fin 4 → Set UpperHalfPlane := fun i => K ∪ (fun z => (g4 i)⁻¹ • z) '' K
    have hK' : ∀ i, IsCompact (K' i) := fun i => hK.union (hK.image (continuous_const_smul _))
    have hfin : ∀ i, {f : UpperHalfPlane → UpperHalfPlane | ∃ γ ∈ Gamma1, f = (fun z => γ • z) ∧
        (f '' K' i ∩ K' i).Nonempty}.Finite := fun i => hS.properlyDiscontinuous _ (hK' i)
    refine (Set.finite_iUnion fun i => (hfin i).image (fun f => (fun z => g4 i • z) ∘ f)).subset ?_
    rintro f ⟨γ, hγ, rfl, ⟨_, ⟨k, hk, rfl⟩, hk'⟩⟩
    obtain ⟨i, h, hh, hz⟩ := cover_mob hγ
    refine Set.mem_iUnion.2 ⟨i, (fun z => h • z), ⟨h, hh, rfl, ⟨h • k, ⟨k, Or.inl hk, rfl⟩,
      Or.inr ⟨γ • k, hk', ?_⟩⟩⟩, ?_⟩
    · show (g4 i)⁻¹ • (γ • k) = h • k
      rw [hz, inv_smul_smul]
    · funext z; simp [hz]
  cocompact := by
    obtain ⟨C, hC, hcov⟩ := hS.cocompact
    exact ⟨C, hC, fun z => by obtain ⟨γ, hγ, h⟩ := hcov z; exact ⟨γ, gamma1_sub hγ, h⟩⟩

/-! ## §3 A fundamental domain for `Γ*` -/

open MeasureTheory

instance : Countable PkgI1.B := by
  have : Function.Injective (fun x : PkgI1.B => (x.re, x.imI, x.imJ, x.imK)) := by
    intro x y h
    simp only [Prod.mk.injEq] at h
    obtain ⟨h1, h2, h3, h4⟩ := h
    ext <;> assumption
  exact this.countable

theorem gs_countable : (Γs : Set (GL (Fin 2) ℝ)).Countable := by
  classical
  have : Γs ⊆ Set.range (fun x : PkgI1.B => if h : nrd x ≠ 0 then glOf x h else 1) := by
    rintro γ ⟨x, -, hγx, hd⟩
    have hx : nrd x ≠ 0 := by
      rw [hγx, det_iota_eq] at hd; exact_mod_cast hd.ne'
    exact ⟨x, by show (if h : nrd x ≠ 0 then glOf x h else 1) = γ; rw [dif_pos hx]; ext1; rw [coe_glOf, hγx]⟩
  exact (Set.countable_range _).mono this

theorem g1_countable : (Gamma1).Countable := gs_countable.mono (fun h hh => gamma1_sub hh)

/-- The lexicographic order on `ℍ` (by real, then imaginary part). -/
def lexle (z w : UpperHalfPlane) : Prop := z.re < w.re ∨ (z.re = w.re ∧ z.im ≤ w.im)

theorem lexle_iff (z w : UpperHalfPlane) : lexle z w ↔ toLex (z.re, z.im) ≤ toLex (w.re, w.im) := by
  rw [Prod.Lex.toLex_le_toLex]; rfl

theorem lexle_antisymm {z w : UpperHalfPlane} (h1 : lexle z w) (h2 : lexle w z) : z = w := by
  have hre : z.re = w.re := by
    rcases h1 with h1 | ⟨h1, -⟩ <;> rcases h2 with h2 | ⟨h2, -⟩ <;> linarith
  have him : z.im = w.im := by
    rcases h1 with h1 | ⟨-, h1⟩ <;> rcases h2 with h2 | ⟨-, h2⟩ <;> linarith
  exact UpperHalfPlane.ext (Complex.ext hre him)

theorem measurableSet_lexle (γ : GL (Fin 2) ℝ) :
    MeasurableSet {z : UpperHalfPlane | lexle z (γ • z)} := by
  have hr : Measurable fun z : UpperHalfPlane => z.re := UpperHalfPlane.continuous_re.measurable
  have hi : Measurable fun z : UpperHalfPlane => z.im := UpperHalfPlane.continuous_im.measurable
  have hg : Measurable fun z : UpperHalfPlane => γ • z := (continuous_const_smul γ).measurable
  have e : {z : UpperHalfPlane | lexle z (γ • z)} =
      {z | z.re < (γ • z).re} ∪ ({z | z.re = (γ • z).re} ∩ {z | z.im ≤ (γ • z).im}) := rfl
  rw [e]
  exact (measurableSet_lt hr (hr.comp hg)).union
    ((measurableSet_eq_fun hr (hr.comp hg)).inter (measurableSet_le hi (hi.comp hg)))

/-- Points have measure zero in `ℍ`. -/
instance : NullSingletonClass (volume : Measure UpperHalfPlane) :=
  ⟨fun z => by
    rw [UpperHalfPlane.volume_eq_lintegral, Set.image_singleton]
    exact setLIntegral_measure_zero _ _ (measure_singleton _)⟩

/-- A Möbius map of positive determinant other than the identity has finitely many fixed points. -/
theorem fix_finite {γ : GL (Fin 2) ℝ} (hd : 0 < (γ : Matrix (Fin 2) (Fin 2) ℝ).det)
    (hne : (fun z : UpperHalfPlane => γ • z) ≠ id) : {z : UpperHalfPlane | γ • z = z}.Finite := by
  have hd' : 0 < γ.det.val := by rwa [Matrix.GeneralLinearGroup.val_det_apply]
  set a := (γ : Matrix (Fin 2) (Fin 2) ℝ) 0 0
  set b := (γ : Matrix (Fin 2) (Fin 2) ℝ) 0 1
  set c := (γ : Matrix (Fin 2) (Fin 2) ℝ) 1 0
  set d := (γ : Matrix (Fin 2) (Fin 2) ℝ) 1 1
  have key : ∀ z : UpperHalfPlane, γ • z = z ↔
      (c : ℂ) * (z : ℂ) ^ 2 + ((d - a : ℝ) : ℂ) * z - (b : ℂ) = 0 := by
    intro z
    rw [UpperHalfPlane.ext_iff, UpperHalfPlane.coe_smul_of_det_pos hd',
      div_eq_iff (denom_ne_zero γ z)]
    simp only [UpperHalfPlane.num, UpperHalfPlane.denom]
    constructor
    · intro h; push_cast; linear_combination -h
    · intro h; push_cast at h; linear_combination -h
  let p : Polynomial ℂ := Polynomial.C (c : ℂ) * Polynomial.X ^ 2 +
    Polynomial.C ((d - a : ℝ) : ℂ) * Polynomial.X - Polynomial.C (b : ℂ)
  have hp : p ≠ 0 := by
    intro hp0
    have h2 : p.coeff 2 = 0 := by rw [hp0]; simp
    have h1 : p.coeff 1 = 0 := by rw [hp0]; simp
    have h0 : p.coeff 0 = 0 := by rw [hp0]; simp
    simp [p, Polynomial.coeff_X, Polynomial.coeff_C] at h2 h1 h0
    apply hne
    funext z
    have : (c : ℂ) * (z : ℂ) ^ 2 + ((d - a : ℝ) : ℂ) * z - (b : ℂ) = 0 := by
      have hc : (c : ℂ) = 0 := by exact_mod_cast h2
      have hb : (b : ℂ) = 0 := by exact_mod_cast h0
      have hda : ((d - a : ℝ) : ℂ) = 0 := by push_cast; exact h1
      rw [hc, hb, hda]; ring
    exact (key z).2 this
  refine ((Polynomial.finite_setOfPred_isRoot hp).preimage
    (UpperHalfPlane.coe_injective.injOn)).subset ?_
  intro z hz
  simp only [Set.mem_preimage, Set.mem_setOf_eq, Polynomial.IsRoot, p, Polynomial.eval_sub,
    Polynomial.eval_add, Polynomial.eval_mul, Polynomial.eval_C, Polynomial.eval_pow, Polynomial.eval_X]
  exact (key z).1 hz

theorem fix_null {γ : GL (Fin 2) ℝ} (hd : 0 < (γ : Matrix (Fin 2) (Fin 2) ℝ).det)
    (hne : (fun z : UpperHalfPlane => γ • z) ≠ id) : volume {z : UpperHalfPlane | γ • z = z} = 0 :=
  (fix_finite hd hne).measure_zero _

section Domain

variable (s : Set UpperHalfPlane)

/-- `t₀`: the points of `s` that are lexicographically minimal among their `Γ*`-translates in `s`. -/
def t0 : Set UpperHalfPlane := s ∩ ⋂ γ ∈ Γs, {z | γ • z ∈ s → lexle z (γ • z)}

/-- `N`: the points whose `Γ*`-orbit misses `t₀` (a null set). -/
def Nset : Set UpperHalfPlane := ⋂ γ ∈ Γs, {z | γ • z ∉ t0 s}

/-- The fundamental domain of `Γ*`. -/
def tdom : Set UpperHalfPlane := t0 s ∪ Nset s

/-- Points with two distinct `Γ¹`-equivalent translates in `s` (a null set). -/
def Bad : Set UpperHalfPlane :=
  ⋃ γ ∈ Γs, ⋃ h ∈ {h : GL (Fin 2) ℝ | h ∈ Gamma1 ∧ (fun z : UpperHalfPlane => h • z) ≠ id},
    (fun z : UpperHalfPlane => γ • z) ⁻¹' (s ∩ (fun z : UpperHalfPlane => h • z) ⁻¹' s)

variable {s}

theorem t0_measurable (hs : MeasurableSet s) : MeasurableSet (t0 s) := by
  refine hs.inter (MeasurableSet.biInter gs_countable fun γ _ => ?_)
  have e : {z : UpperHalfPlane | γ • z ∈ s → lexle z (γ • z)} =
      ((fun z : UpperHalfPlane => γ • z) ⁻¹' s)ᶜ ∪ {z | lexle z (γ • z)} := by
    ext z; simp only [Set.mem_setOf_eq, Set.mem_union, Set.mem_compl_iff, Set.mem_preimage]; tauto
  rw [e]
  exact (((continuous_const_smul γ).measurable hs).compl).union (measurableSet_lexle γ)

theorem Nset_measurable (hs : MeasurableSet s) : MeasurableSet (Nset s) :=
  MeasurableSet.biInter gs_countable fun γ _ =>
    ((continuous_const_smul γ).measurable (t0_measurable hs)).compl

theorem bad_null (hsd : ∀ γ ∈ Gamma1, (fun z : UpperHalfPlane => γ • z) ≠ id →
    volume (s ∩ (fun z : UpperHalfPlane => γ • z) ⁻¹' s) = 0) : volume (Bad s) = 0 := by
  refine (measure_biUnion_null_iff gs_countable).2 fun γ _ => ?_
  refine (measure_biUnion_null_iff (g1_countable.mono fun h hh => hh.1)).2 fun h hh => ?_
  rw [measure_preimage_smul]
  exact hsd h hh.1 hh.2

/-- `N ⊆ Bad`: if no point of the orbit of `z` lies in `Bad`, then the orbit meets `s` in at most four
points (one per coset), and its lexicographic minimum lies in `t₀`. -/
theorem Nset_sub_bad (hcov : ∀ z, ∃ γ ∈ Gamma1, γ • z ∈ s) : Nset s ⊆ Bad s := by
  intro z hzN
  by_contra hzB
  set S := {w : UpperHalfPlane | w ∈ s ∧ ∃ γ ∈ Γs, w = γ • z} with hS
  have hsub : S ⊆ ⋃ i : Fin 4, {w : UpperHalfPlane | w ∈ s ∧ ∃ h ∈ Gamma1, w = h • (g4 i • z)} := by
    rintro w ⟨hw, γ, hγ, rfl⟩
    obtain ⟨i, h, hh, hz⟩ := cover_mob hγ
    refine Set.mem_iUnion.2 ⟨i, hw, g4 i * h * (g4 i)⁻¹, conj_g4 i hh, ?_⟩
    rw [hz, mul_smul, mul_smul, inv_smul_smul]
  have hsing : ∀ i : Fin 4,
      {w : UpperHalfPlane | w ∈ s ∧ ∃ h ∈ Gamma1, w = h • (g4 i • z)}.Subsingleton := by
    rintro i w1 ⟨hw1, h1, hh1, rfl⟩ w2 ⟨hw2, h2, hh2, rfl⟩
    by_contra hne
    apply hzB
    refine Set.mem_iUnion₂.2 ⟨h1 * g4 i, gs_mul (gamma1_sub hh1) (g4_mem i),
      Set.mem_iUnion₂.2 ⟨h2 * h1⁻¹, ⟨mul_mem_gamma1 hh2 (inv_mem_gamma1 hh1), ?_⟩, ?_⟩⟩
    · intro hid
      apply hne
      have := congrFun hid (h1 • g4 i • z)
      simp only [id, mul_smul, inv_smul_smul] at this
      exact this.symm
    · show (h1 * g4 i) • z ∈ s ∧ (h2 * h1⁻¹) • ((h1 * g4 i) • z) ∈ s
      simp only [mul_smul, inv_smul_smul]
      exact ⟨hw1, hw2⟩
  have hfin : S.Finite := (Set.finite_iUnion fun i => (hsing i).finite).subset hsub
  have hSne : S.Nonempty := by
    obtain ⟨h, hh, hhz⟩ := hcov z
    exact ⟨h • z, hhz, h, gamma1_sub hh, rfl⟩
  obtain ⟨w, ⟨hw, γ0, hγ0, rfl⟩, hmin⟩ :=
    Set.exists_min_image S (fun w : UpperHalfPlane => toLex (w.re, w.im)) hfin hSne
  have hmem : γ0 • z ∈ t0 s := by
    refine ⟨hw, Set.mem_iInter₂.2 fun γ hγ => ?_⟩
    intro hγs
    rw [lexle_iff]
    exact hmin _ ⟨hγs, γ * γ0, gs_mul hγ hγ0, by rw [mul_smul]⟩
  exact (Set.mem_iInter₂.1 hzN γ0 hγ0) hmem

/-- **`tdom s` is a fundamental domain of `Γ*`.** -/
theorem tdom_fund (hS : IsFundDomain Gamma1 s) : IsFundDomain Γs (tdom s) := by
  obtain ⟨hsm, hcov, hsd⟩ := hS
  have hN0 : volume (Nset s) = 0 := measure_mono_null (Nset_sub_bad hcov) (bad_null hsd)
  refine ⟨(t0_measurable hsm).union (Nset_measurable hsm), fun z => ?_, fun γ hγ hne => ?_⟩
  · by_cases hz : z ∈ Nset s
    · exact ⟨1, gs_one, by rw [one_smul]; exact Or.inr hz⟩
    · simp only [Nset, Set.mem_iInter₂, Set.mem_setOf_eq, not_forall, not_not] at hz
      obtain ⟨γ, hγ, h⟩ := hz
      exact ⟨γ, hγ, Or.inl h⟩
  · refine measure_mono_null (t := ({z | γ • z = z} ∪ Nset s) ∪
      (fun z : UpperHalfPlane => γ • z) ⁻¹' Nset s) ?_ ?_
    · rintro z ⟨hz1 | hz1, hz2 | hz2⟩
      · left; left
        have h1 : lexle z (γ • z) := Set.mem_iInter₂.1 hz1.2 γ hγ hz2.1
        have h2 : lexle (γ • z) z := by
          have := Set.mem_iInter₂.1 hz2.2 γ⁻¹ (gs_inv hγ)
          simp only [Set.mem_setOf_eq, inv_smul_smul] at this
          exact this hz1.1
        exact (lexle_antisymm h1 h2).symm
      · right; exact hz2
      · left; right; exact hz1
      · left; right; exact hz1
    · exact measure_union_null (measure_union_null (fix_null (det_pos_of_mem hγ) hne) hN0)
        (by rw [measure_preimage_smul]; exact hN0)

theorem tdom_ae (hS : IsFundDomain Gamma1 s) : volume (tdom s) = volume (t0 s) := by
  obtain ⟨hsm, hcov, hsd⟩ := hS
  have hN0 : volume (Nset s) = 0 := measure_mono_null (Nset_sub_bad hcov) (bad_null hsd)
  exact le_antisymm ((measure_union_le _ _).trans (by rw [hN0, add_zero]))
    (measure_mono Set.subset_union_left)

end Domain

/-! ## §4 The area: `vol s = 4 vol t` -/

open scoped Pointwise

/-- `Γ¹` as a subgroup of `GL₂(ℝ)`. -/
def G1sub : Subgroup (GL (Fin 2) ℝ) where
  carrier := Gamma1
  one_mem' := one_mem_gamma1
  mul_mem' := mul_mem_gamma1
  inv_mem' := inv_mem_gamma1

/-- The Möbius action as permutations. -/
abbrev mob : GL (Fin 2) ℝ →* Equiv.Perm UpperHalfPlane := MulAction.toPermHom _ _

/-- The Möbius group of `Γ¹`. -/
def Mone : Subgroup (Equiv.Perm UpperHalfPlane) := G1sub.map mob

theorem Mone_smul (σ : Mone) : ∃ h ∈ Gamma1, ∀ z : UpperHalfPlane, σ • z = h • z := by
  obtain ⟨h, hh, hσ⟩ := σ.2
  exact ⟨h, hh, fun z => by show (σ : Equiv.Perm UpperHalfPlane) z = h • z; rw [← hσ]; rfl⟩

instance : MeasurableConstSMul Mone UpperHalfPlane :=
  ⟨fun σ => by
    obtain ⟨h, -, hσ⟩ := Mone_smul σ
    have : (fun z : UpperHalfPlane => σ • z) = fun z => h • z := funext hσ
    rw [this]; exact (continuous_const_smul h).measurable⟩

instance : SMulInvariantMeasure Mone UpperHalfPlane volume :=
  ⟨fun σ A _ => by
    obtain ⟨h, -, hσ⟩ := Mone_smul σ
    have : (fun z : UpperHalfPlane => σ • z) = fun z => h • z := funext hσ
    rw [this]; exact measure_preimage_smul volume h A⟩

instance : Countable Mone := by
  have : (Mone : Set (Equiv.Perm UpperHalfPlane)).Countable := by
    have e : (Mone : Set (Equiv.Perm UpperHalfPlane)) = mob '' Gamma1 := rfl
    rw [e]; exact g1_countable.image _
  exact this.to_subtype

/-- A project fundamental domain of `Γ¹` is a Mathlib fundamental domain of its Möbius group. -/
theorem isFundamentalDomain_of {F : Set UpperHalfPlane} (hm : NullMeasurableSet F volume)
    (hcov : ∀ z, ∃ h ∈ Gamma1, h • z ∈ F)
    (hd : ∀ h ∈ Gamma1, (fun z : UpperHalfPlane => h • z) ≠ id →
      volume (F ∩ (fun z : UpperHalfPlane => h • z) ⁻¹' F) = 0) :
    IsFundamentalDomain Mone F volume := by
  refine IsFundamentalDomain.mk'' hm (Filter.Eventually.of_forall fun z => ?_) (fun σ hσ => ?_)
    (fun σ => (measurePreserving_smul σ volume).quasiMeasurePreserving)
  · obtain ⟨h, hh, hz⟩ := hcov z
    exact ⟨⟨mob h, h, hh, rfl⟩, hz⟩
  · obtain ⟨h, hh, hσh⟩ := Mone_smul σ
    have hne : (fun z : UpperHalfPlane => h⁻¹ • z) ≠ id := by
      intro hid; apply hσ
      apply Subtype.ext; apply Equiv.ext; intro z
      have := congrFun hid (h • z)
      simp only [id, inv_smul_smul] at this
      show σ • z = z
      rw [hσh]; exact this.symm
    have e : σ • F = (fun z : UpperHalfPlane => h⁻¹ • z) ⁻¹' F := by
      rw [← Set.preimage_smul_inv]
      ext z
      simp only [Set.mem_preimage]
      have : σ⁻¹ • z = h⁻¹ • z := by
        have e1 : σ • (σ⁻¹ • z) = z := smul_inv_smul σ z
        rw [hσh] at e1
        calc σ⁻¹ • z = h⁻¹ • (h • (σ⁻¹ • z)) := (inv_smul_smul h _).symm
          _ = h⁻¹ • z := by rw [e1]
      rw [this]
    show volume (σ • F ∩ F) = 0
    rw [e, Set.inter_comm]
    exact hd h⁻¹ (inv_mem_gamma1 hh) hne

/-- Disjointness of the translates of a `Γ*`-domain by a nontrivial Möbius map of `Γ*`, pulled back. -/
theorem piece_null {t : Set UpperHalfPlane} (ht : IsFundDomain Γs t) {γ : GL (Fin 2) ℝ} (hγ : γ ∈ Γs)
    (hne : (fun z : UpperHalfPlane => γ • z) ≠ id) (g : GL (Fin 2) ℝ) :
    volume ((fun z : UpperHalfPlane => g • z) ⁻¹' (t ∩ (fun z : UpperHalfPlane => γ • z) ⁻¹' t)) = 0 := by
  rw [measure_preimage_smul]; exact ht.2.2 γ hγ hne

/-- `rᵢ⁻¹ t`, `i = 0, …, 3`: a fundamental domain of `Γ¹`. -/
def Fdom (t : Set UpperHalfPlane) : Set UpperHalfPlane :=
  ⋃ i : Fin 4, (fun z : UpperHalfPlane => g4 i • z) ⁻¹' t

theorem g4_ne {i j : Fin 4} (hij : i ≠ j) :
    (fun z : UpperHalfPlane => (g4 j * (g4 i)⁻¹) • z) ≠ id := by
  intro hid
  apply hij
  refine coset_eq one_mem_gamma1 fun z => ?_
  have := congrFun hid (g4 i • z)
  simp only [id, mul_smul, inv_smul_smul] at this
  rw [one_smul]; exact this

theorem Fdom_fund {t : Set UpperHalfPlane} (ht : IsFundDomain Γs t) :
    IsFundamentalDomain Mone (Fdom t) volume := by
  obtain ⟨htm, htc, htd⟩ := ht
  refine isFundamentalDomain_of
    (MeasurableSet.iUnion fun i => (continuous_const_smul (g4 i)).measurable htm).nullMeasurableSet
    (fun z => ?_) (fun h hh hne => ?_)
  · obtain ⟨γ, hγ, hz⟩ := htc z
    obtain ⟨i, h, hh, hγz⟩ := cover_mob hγ
    exact ⟨h, hh, Set.mem_iUnion.2 ⟨i, by show g4 i • h • z ∈ t; rw [← hγz]; exact hz⟩⟩
  · -- `z ∈ Fdom ∩ h⁻¹ Fdom`: `rⱼ z ∈ t` and `rᵢ h z ∈ t`
    have hsub : Fdom t ∩ (fun z : UpperHalfPlane => h • z) ⁻¹' Fdom t ⊆
        ⋃ i : Fin 4, ⋃ j : Fin 4, (fun z : UpperHalfPlane => g4 j • z) ⁻¹'
          (t ∩ (fun z : UpperHalfPlane => (g4 i * h * (g4 j)⁻¹) • z) ⁻¹' t) := by
      rintro z ⟨hz1, hz2⟩
      obtain ⟨j, hj⟩ := Set.mem_iUnion.1 hz1
      obtain ⟨i, hi⟩ := Set.mem_iUnion.1 hz2
      refine Set.mem_iUnion₂.2 ⟨i, j, hj, ?_⟩
      show (g4 i * h * (g4 j)⁻¹) • g4 j • z ∈ t
      rw [mul_smul, inv_smul_smul, mul_smul]; exact hi
    refine measure_mono_null hsub (measure_iUnion_null fun i => measure_iUnion_null fun j => ?_)
    by_cases hij : (fun z : UpperHalfPlane => (g4 i * h * (g4 j)⁻¹) • z) = id
    · exfalso
      have hji : i = j := by
        refine coset_eq hh fun z => ?_
        have := congrFun hij (g4 j • z)
        simp only [id, mul_smul, inv_smul_smul] at this
        exact this.symm
      subst hji
      apply hne
      funext z
      have := congrFun hij (g4 i • z)
      simp only [id, mul_smul, inv_smul_smul] at this
      exact (smul_left_cancel_iff (g4 i)).1 this
    · exact piece_null ⟨htm, htc, htd⟩
        (gs_mul (gs_mul (g4_mem i) (gamma1_sub hh)) (gs_inv (g4_mem j))) hij _

theorem Fdom_volume {t : Set UpperHalfPlane} (ht : IsFundDomain Γs t) :
    volume (Fdom t) = 4 * volume t := by
  have hm : ∀ i : Fin 4, MeasurableSet ((fun z : UpperHalfPlane => g4 i • z) ⁻¹' t) :=
    fun i => (continuous_const_smul (g4 i)).measurable ht.1
  rw [Fdom, measure_iUnion₀ ?_ (fun i => (hm i).nullMeasurableSet), tsum_fintype]
  · simp only [measure_preimage_smul, Finset.sum_const, Finset.card_univ, Fintype.card_fin,
      nsmul_eq_mul]
    norm_num
  · intro i j hij
    show volume ((fun z : UpperHalfPlane => g4 i • z) ⁻¹' t ∩
      (fun z : UpperHalfPlane => g4 j • z) ⁻¹' t) = 0
    have e : (fun z : UpperHalfPlane => g4 i • z) ⁻¹' t ∩ (fun z : UpperHalfPlane => g4 j • z) ⁻¹' t =
        (fun z : UpperHalfPlane => g4 i • z) ⁻¹'
          (t ∩ (fun z : UpperHalfPlane => (g4 j * (g4 i)⁻¹) • z) ⁻¹' t) := by
      ext z; simp only [Set.mem_inter_iff, Set.mem_preimage, mul_smul, inv_smul_smul]
    rw [e]
    exact piece_null ht (gs_mul (g4_mem j) (gs_inv (g4_mem i))) (g4_ne hij) _

/-! ## §5 The glue -/

theorem ennreal_arith {x : ENNReal} (h : ENNReal.ofReal (2 * Real.pi / 3) = 4 * x) :
    x = ENNReal.ofReal (Real.pi / 6) := by
  have e : ENNReal.ofReal (2 * Real.pi / 3) = 4 * ENNReal.ofReal (Real.pi / 6) := by
    rw [show 2 * Real.pi / 3 = 4 * (Real.pi / 6) by ring, ENNReal.ofReal_mul (by norm_num)]
    norm_num
  rw [e] at h
  exact ((ENNReal.mul_right_inj (by norm_num) (by norm_num)).1 h).symm

/-- **`GammaStarFromO1` (qm-split's project glue) is a theorem.** -/
theorem gammaStarFromO1_proof : GammaStarFromO1 := by
  rintro ⟨hF, s, hs, hvol⟩
  refine ⟨gs_fuchsian hF, tdom s, tdom_fund hs, ?_⟩
  have h1 : volume s = volume (Fdom (tdom s)) :=
    (isFundamentalDomain_of hs.1.nullMeasurableSet hs.2.1 hs.2.2).measure_eq (Fdom_fund (tdom_fund hs))
  rw [Fdom_volume (tdom_fund hs), hvol] at h1
  exact ennreal_arith h1

end HDec.LeafQCheck.QMglue




/-! ## Proofs -/

namespace HDec.LeafQCheck.HM.QMSplit.Value24

open PkgI1 UpperHalfPlane

theorem iota_mu : PkgI1.iota mu = !![0, -6 - 3 * √2; 2 - √2, 0] := by
  ext i j; fin_cases i <;> fin_cases j <;>
    simp [PkgI1.iota, mu, PkgI1.Mi, PkgI1.Mj, Matrix.mul_apply, Fin.sum_univ_two] <;> ring

theorem sqrt2_sq : (√2 : ℝ) ^ 2 = 2 := Real.sq_sqrt (by norm_num)
theorem sqrt3_sq : (√3 : ℝ) ^ 2 = 3 := Real.sq_sqrt (by norm_num)
theorem sqrt6_eq : (√6 : ℝ) = √2 * √3 := by rw [← Real.sqrt_mul (by norm_num)]; norm_num
theorem sqrt2_lt : (√2 : ℝ) < 2 := by
  rw [show (2 : ℝ) = √4 by rw [show (4 : ℝ) = 2 ^ 2 by norm_num, Real.sqrt_sq (by norm_num)]]
  exact Real.sqrt_lt_sqrt (by norm_num) (by norm_num)

/-- `s₂₄ = √6 + √3`, so `τ₂₄ = i s₂₄` and `s₂₄² = 9 + 6√2`. -/
def s24 : ℝ := √6 + √3

theorem s24_pos : 0 < s24 := by unfold s24; positivity

theorem s24_sq : s24 ^ 2 = 9 + 6 * √2 := by
  unfold s24; rw [sqrt6_eq]
  have h2 := sqrt2_sq; have h3 := sqrt3_sq
  linear_combination (√3 ^ 2) * h2 + (3 + 2 * √2) * h3

/-- From qm-split `Haupt.lean` l.652 (`fixed_data`, verbatim): the fixed-point equations. -/
theorem fixed_data {γ : GL (Fin 2) ℝ} (hd : 0 < (γ : Matrix (Fin 2) (Fin 2) ℝ).det)
    {P : UpperHalfPlane} (hP : γ • P = P) :
    (γ : Matrix (Fin 2) (Fin 2) ℝ) 0 0 =
        2 * (γ : Matrix (Fin 2) (Fin 2) ℝ) 1 0 * P.re + (γ : Matrix (Fin 2) (Fin 2) ℝ) 1 1 ∧
      (γ : Matrix (Fin 2) (Fin 2) ℝ) 0 1 =
        -(γ : Matrix (Fin 2) (Fin 2) ℝ) 1 0 * (P.re ^ 2 + P.im ^ 2) := by
  have hd' : 0 < γ.det.val := by rwa [Matrix.GeneralLinearGroup.val_det_apply]
  have h := congrArg (fun w : UpperHalfPlane => (w : ℂ)) hP
  rw [UpperHalfPlane.coe_smul_of_det_pos hd', div_eq_iff (denom_ne_zero γ P)] at h
  have hre := congrArg Complex.re h
  have him := congrArg Complex.im h
  simp [UpperHalfPlane.num, UpperHalfPlane.denom] at hre him
  have hq := P.im_pos
  have ha : ((γ : Matrix (Fin 2) (Fin 2) ℝ) 0 0 - 2 * (γ : Matrix (Fin 2) (Fin 2) ℝ) 1 0 * P.re -
      (γ : Matrix (Fin 2) (Fin 2) ℝ) 1 1) * P.im = 0 := by linear_combination him
  have ha' := (mul_eq_zero.1 ha).resolve_right hq.ne'
  refine ⟨by linarith, ?_⟩
  have : (γ : Matrix (Fin 2) (Fin 2) ℝ) 0 0 =
      2 * (γ : Matrix (Fin 2) (Fin 2) ℝ) 1 0 * P.re + (γ : Matrix (Fin 2) (Fin 2) ℝ) 1 1 := by
    linarith
  rw [this] at hre
  linear_combination hre

/-- **The CM point.** The only point fixed by a `γ` with matrix `ι(μ)` is `τ₂₄ = i(√6 + √3)`. -/
theorem fixedPoint_eq (γ : GL (Fin 2) ℝ) (hγ : (γ : Matrix (Fin 2) (Fin 2) ℝ) = PkgI1.iota mu)
    (τ : UpperHalfPlane) (h : γ • τ = τ) : (τ : ℂ) = Complex.I * (s24 : ℂ) := by
  have h2 := sqrt2_lt
  have hd : 0 < (γ : Matrix (Fin 2) (Fin 2) ℝ).det := by
    rw [hγ, iota_mu, Matrix.det_fin_two_of]; nlinarith [sqrt2_sq]
  obtain ⟨e1, e2⟩ := fixed_data hd h
  rw [hγ, iota_mu] at e1 e2
  simp at e1 e2
  have hc : (2 - √2 : ℝ) ≠ 0 := by linarith
  have hre : τ.re = 0 := e1.resolve_left hc
  rw [hre] at e2
  have him2 : τ.im ^ 2 = s24 ^ 2 := by
    rw [s24_sq]
    have : (2 - √2) * (τ.im ^ 2 - (9 + 6 * √2)) = 0 := by
      linear_combination e2 + 6 * sqrt2_sq
    rcases mul_eq_zero.1 this with h | h
    · exact absurd h hc
    · linarith
  have him : τ.im = s24 := by
    have := τ.im_pos; have := s24_pos
    nlinarith [sq_nonneg (τ.im - s24), sq_nonneg (τ.im + s24)]
  apply Complex.ext <;> simp [hre, him]

/-- The explicit period matrix at `τ₂₄` (entries in `ℚ(√−6)`). -/
def Om24 : Matrix (Fin 2) (Fin 2) ℂ :=
  !![(-4 + 3 * Complex.I * ((√6 : ℝ) : ℂ)) / 14, (-1 - Complex.I * ((√6 : ℝ) : ℂ)) / 7;
     (-1 - Complex.I * ((√6 : ℝ) : ℂ)) / 7, (-4 + 3 * Complex.I * ((√6 : ℝ) : ℂ)) / 7]

theorem Emat_eq (τ : ℂ) : PkgI1.Emat τ = !![τ, (√2 : ℂ) * τ; 1, -(√2 : ℂ)] := by
  ext i j; fin_cases i <;> fin_cases j <;>
    simp [PkgI1.Emat, PkgI1.latVec, PkgI1.iota, PkgI1.oBasis, PkgI1.Mi, PkgI1.Mj, Matrix.mulVec,
      dotProduct, Fin.sum_univ_two, Matrix.mul_apply]

theorem F0mat_eq (τ : ℂ) : PkgI1.F0mat τ =
    !![(τ - 3) / 2, (√2 : ℂ) * (τ - 3) / 2; (τ + 1) / 2, -(√2 : ℂ) * (τ + 1) / 2] := by
  ext i j; fin_cases i <;> fin_cases j <;>
    simp [PkgI1.F0mat, PkgI1.latVec, PkgI1.iota, PkgI1.oBasis, PkgI1.Mi, PkgI1.Mj, Matrix.mulVec,
      dotProduct, Fin.sum_univ_two, Matrix.mul_apply] <;> ring

theorem c2 : ((√2 : ℝ) : ℂ) ^ 2 = 2 := by exact_mod_cast sqrt2_sq
theorem c3 : ((√3 : ℝ) : ℂ) ^ 2 = 3 := by exact_mod_cast sqrt3_sq

/-- **The period matrix at `τ₂₄`**: `Ω(τ₂₄) = Ω₂₄`. -/
theorem omega_tau24 : PkgI1.Omega (Complex.I * (s24 : ℂ)) = Om24 := by
  set τ : ℂ := Complex.I * (s24 : ℂ) with hτ
  have ha := c2; have hb := c3
  have ha3 : ((√2 : ℝ) : ℂ) ^ 3 = 2 * ((√2 : ℝ) : ℂ) := by rw [pow_succ, ha]
  have hb3 : ((√3 : ℝ) : ℂ) ^ 3 = 3 * ((√3 : ℝ) : ℂ) := by rw [pow_succ, hb]
  have hA : (PkgI1.F0mat τ * PkgI1.Pinv) * Om24 = PkgI1.Emat τ := by
    rw [F0mat_eq, Emat_eq]
    ext i j; fin_cases i <;> fin_cases j <;>
      simp [Om24, PkgI1.Pinv, Matrix.mul_apply, Fin.sum_univ_two, hτ, s24, sqrt6_eq] <;>
      ring_nf <;> simp only [ha, hb, ha3, hb3, Complex.I_sq] <;> ring_nf
  have him : τ.im ≠ 0 := by simp [hτ]; exact s24_pos.ne'
  have h1 : τ - 3 ≠ 0 := fun h => him (by simpa using congrArg Complex.im h)
  have h2 : τ + 1 ≠ 0 := fun h => him (by simpa using congrArg Complex.im h)
  have hdet : IsUnit (PkgI1.F0mat τ * PkgI1.Pinv).det := by
    rw [Matrix.det_mul, F0mat_eq, Matrix.det_fin_two_of]
    have hP : PkgI1.Pinv.det = 1 := by simp [PkgI1.Pinv, Matrix.det_fin_two_of]; norm_num
    rw [hP, mul_one, isUnit_iff_ne_zero]
    have : (τ - 3) / 2 * (-((√2 : ℝ) : ℂ) * (τ + 1) / 2) - ((√2 : ℝ) : ℂ) * (τ - 3) / 2 * ((τ + 1) / 2)
        = -(((√2 : ℝ) : ℂ) * (τ - 3) * (τ + 1)) / 2 := by ring
    rw [this]
    have : ((√2 : ℝ) : ℂ) ≠ 0 := by exact_mod_cast (Real.sqrt_pos.2 (by norm_num : (0:ℝ) < 2)).ne'
    simp [h1, h2, this]
  unfold PkgI1.Omega
  rw [← hA, ← Matrix.mul_assoc, Matrix.nonsing_inv_mul _ hdet, Matrix.one_mul]

/-! ## The glue as a closed numeric statement -/

/-- **The glue at the explicit period matrix**: the ten even theta constants at `Ω₂₄` satisfy
`(Σθ⁸)⁵ ≠ 0` and `3779136(∏θ²)²/(Σθ⁸)⁵ = −16/27`. -/
def ThetaValueAtOmega24 : Prop :=
  PkgI1.jDen Om24 ≠ 0 ∧ PkgI1.jNum Om24 / PkgI1.jDen Om24 = -16 / 27

theorem det_iota_mu : (PkgI1.iota mu).det = 6 := by
  rw [iota_mu, Matrix.det_fin_two_of]; linear_combination (-3 : ℝ) * sqrt2_sq

/-- `γ_μ ∈ GL₂(ℝ)` with matrix `ι(μ)`. -/
def gammaMu : GL (Fin 2) ℝ :=
  Matrix.GeneralLinearGroup.mkOfDetNeZero (PkgI1.iota mu) (by rw [det_iota_mu]; norm_num)

/-- `τ₂₄ ∈ ℍ`. -/
def tau24 : UpperHalfPlane := ⟨Complex.I * (s24 : ℂ), by simpa using s24_pos⟩

theorem gammaMu_fix : gammaMu • tau24 = tau24 := by
  have hd : 0 < gammaMu.det.val := by
    rw [Matrix.GeneralLinearGroup.val_det_apply]
    show 0 < (PkgI1.iota mu).det
    rw [det_iota_mu]; norm_num
  have hc : ((2 : ℂ) - ((√2 : ℝ) : ℂ)) ≠ 0 := by
    intro h
    have : (√2 : ℝ) = 2 := by exact_mod_cast (sub_eq_zero.1 h).symm
    linarith [sqrt2_lt]
  have hs : ((s24 : ℝ) : ℂ) ≠ 0 := by exact_mod_cast s24_pos.ne'
  have hs2 : ((s24 : ℝ) : ℂ) ^ 2 = 9 + 6 * ((√2 : ℝ) : ℂ) := by exact_mod_cast s24_sq
  apply UpperHalfPlane.ext
  rw [UpperHalfPlane.coe_smul_of_det_pos hd, div_eq_iff (UpperHalfPlane.denom_ne_zero _ _)]
  have hval : (gammaMu : Matrix (Fin 2) (Fin 2) ℝ) = PkgI1.iota mu := rfl
  simp only [UpperHalfPlane.num, UpperHalfPlane.denom, hval, iota_mu, tau24, UpperHalfPlane.coe_mk]
  simp
  linear_combination (-(2 - ((√2 : ℝ) : ℂ)) * ((s24 : ℝ) : ℂ) ^ 2) * Complex.I_sq +
    (2 - ((√2 : ℝ) : ℂ)) * hs2 + (-6 : ℂ) * c2

/-- **(a), exact part.** The glue `ThetaQuotientValue24` is equivalent to the closed statement
`ThetaValueAtOmega24` about the theta constants at the explicit matrix `Ω₂₄`. -/
theorem thetaQuotientValue24_iff : ThetaQuotientValue24 ↔ ThetaValueAtOmega24 := by
  constructor
  · intro h
    have := h gammaMu rfl tau24 gammaMu_fix
    have e : ((tau24 : UpperHalfPlane) : ℂ) = Complex.I * (s24 : ℂ) := rfl
    rw [e, omega_tau24] at this
    exact this
  · intro h γ hγ τ hτ
    rw [fixedPoint_eq γ hγ τ hτ, omega_tau24]
    exact h

/-! ## Reduction to the published value -/

/-- Verbatim from `ZInQKernel/OneProof/H/LPrefix.lean` §7 (`HDec.PkgI1.f1_algebra`). -/
theorem f1_algebra {K : Type*} [Field K] [CharZero K] (j lam J2 J4 J10 Sig Pi : K)
    (hJ2 : J2 = 12 * (j + 1) * lam) (hJ4 : J4 = 6 * (j ^ 2 + j + 1) * lam ^ 2)
    (hJ10 : J10 = j ^ 3 * lam ^ 5)
    (hpsi : J2 ^ 2 - 24 * J4 = Sig / 4) (hchi : -J10 / 4 = -Pi / 2 ^ 14) :
    j * Sig ^ 5 = 3779136 * Pi ^ 2 := by
  have hS : Sig = 576 * j * lam ^ 2 := by
    rw [hJ2, hJ4] at hpsi; linear_combination (-4 : K) * hpsi
  have hP : Pi = 4096 * j ^ 3 * lam ^ 5 := by
    rw [hJ10] at hchi; linear_combination (16384 : K) * hchi
  rw [hS, hP]; ring

/-- **LEAF (published value: the Igusa invariants at the CM point of discriminant `−24`).** At the fixed
point `τ` of `ι(μ)` (the CM point of discriminant `−24` of `X₆/W` in the modular embedding of `PkgI1` §4,
whose Riemann form is Lin–Yang's convention, eq. (3) and Lemma 3), Igusa's invariants of the principally
polarized surface with period matrix `Ω(τ)` are, in a weighted representative, Lin–Yang's vector
`J₂ = 12(j+1)λ`, `J₄ = 6(j²+j+1)λ²`, `J₁₀ = j³λ⁵` at `j = −16/27`, with Igusa's
`ψ₄ = J₂² − 24J₄`, `χ₁₀ = −J₁₀/4` and LNY's theta conventions `ψ₄ = Σθ_m⁸/4`, `χ₁₀ = −∏θ_m²/2¹⁴`.

Published form: Lin–Yang, *Quaternionic loci in Siegel's modular threefold* (Math. Z., 2020; arXiv v1),
eqs. (2) and (14), pp. 3 and 17 (the Igusa vector of the QM curve of discriminant 6 as a function of the
Hauptmodul `j` of `X₆/W`), with the CM value `j = −16/27` at discriminant `−24` (Baba–Granath, Canad. J. Math.
60 (2008), Thm 2.1 and the CM table; Elkies, ANTS-III (1998), the CM points of `X*(6)`); Lauter–Naehrig–Yang
(2015) §2.2, p. 4 for the theta conventions; Igusa, Amer. J. Math. 89 (1967). This is the citation of the
manuscript, l.908-923 (`diophantine_zq.tex`). Locators UNVERIFIED (no network); the manuscript cites
exactly these equations and pages.

Content: by `igusa_of_thetaQuotientValue24` this leaf is *equivalent* to the glue `ThetaQuotientValue24`
(it restates it in Igusa's normalization; it is not stronger). The published content that it uses is one
number: the value of Lin–Yang's normalized Hauptmodul at the discriminant `−24` point. -/
def IgusaCMValue24 : Prop :=
  ∀ γ : GL (Fin 2) ℝ, (γ : Matrix (Fin 2) (Fin 2) ℝ) = PkgI1.iota mu → ∀ τ : UpperHalfPlane, γ • τ = τ →
    ∃ lam J2 J4 J10 : ℂ, lam ≠ 0 ∧
      J2 = 12 * ((-16 / 27 : ℂ) + 1) * lam ∧
      J4 = 6 * ((-16 / 27 : ℂ) ^ 2 + (-16 / 27 : ℂ) + 1) * lam ^ 2 ∧
      J10 = (-16 / 27 : ℂ) ^ 3 * lam ^ 5 ∧
      J2 ^ 2 - 24 * J4 = PkgI1.thetaSum8 (PkgI1.Omega τ) / 4 ∧
      -J10 / 4 = -PkgI1.thetaProd2 (PkgI1.Omega τ) / 2 ^ 14

/-- **(a): the glue from the published value.** -/
theorem thetaQuotientValue24_of_igusa (h : IgusaCMValue24) : ThetaQuotientValue24 := by
  intro γ hγ τ hτ
  obtain ⟨lam, J2, J4, J10, hlam, h2, h4, h10, hpsi, hchi⟩ := h γ hγ τ hτ
  have key := f1_algebra (-16 / 27 : ℂ) lam J2 J4 J10 _ _ h2 h4 h10 hpsi hchi
  have hS : PkgI1.thetaSum8 (PkgI1.Omega τ) = 576 * (-16 / 27) * lam ^ 2 := by
    rw [h2, h4] at hpsi; linear_combination (-4 : ℂ) * hpsi
  have hS0 : PkgI1.thetaSum8 (PkgI1.Omega τ) ≠ 0 := by
    rw [hS]; exact mul_ne_zero (by norm_num) (pow_ne_zero _ hlam)
  have hD : PkgI1.jDen (PkgI1.Omega τ) ≠ 0 := pow_ne_zero _ hS0
  refine ⟨hD, ?_⟩
  rw [div_eq_iff hD]
  simp only [PkgI1.jNum, PkgI1.jDen]
  linear_combination -key

/-- **The converse: the leaf is not stronger than the glue.** -/
theorem igusa_of_thetaQuotientValue24 (h : ThetaQuotientValue24) : IgusaCMValue24 := by
  intro γ hγ τ hτ
  obtain ⟨hD, hv⟩ := h γ hγ τ hτ
  set Sig := PkgI1.thetaSum8 (PkgI1.Omega τ)
  set Pi := PkgI1.thetaProd2 (PkgI1.Omega τ)
  have hS0 : Sig ≠ 0 := fun h0 => hD (by simp [PkgI1.jDen, Sig, h0])
  have key : 3779136 * Pi ^ 2 = (-16 / 27) * Sig ^ 5 := by
    rw [div_eq_iff hD] at hv; simpa [PkgI1.jNum, PkgI1.jDen] using hv
  obtain ⟨l0, hl0⟩ := IsAlgClosed.exists_pow_nat_eq (Sig / (576 * (-16 / 27))) (n := 2) (by norm_num)
  have hl0' : Sig = 576 * (-16 / 27) * l0 ^ 2 := by rw [hl0]; field_simp
  have hl00 : l0 ≠ 0 := by rintro rfl; simp at hl0'; exact hS0 hl0'
  -- `Pi² = (4096 j³ l0⁵)²`, so `Pi = ± 4096 j³ l0⁵`
  have hsq : (Pi - 4096 * (-16 / 27) ^ 3 * l0 ^ 5) * (Pi + 4096 * (-16 / 27) ^ 3 * l0 ^ 5) = 0 := by
    rw [hl0'] at key; linear_combination key / 3779136
  have hsign : ∃ lam : ℂ, lam ≠ 0 ∧ Sig = 576 * (-16 / 27) * lam ^ 2 ∧
      Pi = 4096 * (-16 / 27) ^ 3 * lam ^ 5 := by
    rcases mul_eq_zero.1 hsq with e | e
    · exact ⟨l0, hl00, hl0', by linear_combination e⟩
    · exact ⟨-l0, neg_ne_zero.2 hl00, by rw [hl0']; ring, by linear_combination e⟩
  obtain ⟨lam, hlam, hS, hP⟩ := hsign
  refine ⟨lam, _, _, _, hlam, rfl, rfl, rfl, ?_, ?_⟩
  · rw [hS]; ring
  · rw [hP]; ring

end HDec.LeafQCheck.HM.QMSplit.Value24


