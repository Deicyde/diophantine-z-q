  have hq3 : q ^ 3 ≤ 0.2532 ^ 3 := pow_le_pow_left₀ h0 hq2 3
  have hd : 0 < 1 - q ^ 2 := by nlinarith
  constructor
  · rw [div_le_iff₀ hd]; nlinarith
  · rw [div_le_iff₀ hd]; nlinarith

