  · have h0 := hre.le_tsum 0 (fun j _ => by rw [hre']; exact (Real.exp_pos _).le)
    rw [hre'] at h0
    simpa using h0
  · rw [Complex.ofReal_tsum]
    unfold th1
    exact tsum_congr fun n => by rw [hre', hterm]

