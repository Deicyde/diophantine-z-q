def G8AutoSubgroup : Subgroup (GL (Fin 2) ℝ) where
  carrier := {γ | G8Auto γ}
  one_mem' := g8Auto_one
  mul_mem' := g8Auto_mul
  inv_mem' := g8Auto_inv

