theorem I1_g4 (z : ℂ) :
    dFh ((√2 : ℂ) * z + z - 3) (-(√2 : ℂ) + z + 1) • (A4 * Nf z + dF z • B4) =
      Nfh ((√2 : ℂ) * z + z - 3) (-(√2 : ℂ) + z + 1) * (C4 * Nf z + dF z • D4) := by
  ext i j
