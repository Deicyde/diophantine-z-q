theorem I1_g6 (z : ℂ) :
    dFh (-3 * z / 2 - 3 / 2) (z / 2 - 3 / 2) • (A6 * Nf z + dF z • B6) =
      Nfh (-3 * z / 2 - 3 / 2) (z / 2 - 3 / 2) * (C6 * Nf z + dF z • D6) := by
  ext i j
  fin_cases i <;> fin_cases j <;>
