  · linear_combination (-3*z^4/4 - 9*z^2/2 - 27/4) * sqrt2_sq
  · linear_combination (3*z^4/4 + 9*z^2/2 + 27/4) * sqrt2_sq
  · ring

theorem I2_g6 (z : ℂ) :
    (C6 * Nf z + dF z • D6).det * 3 * ((z - 3) * (z + 1)) =
