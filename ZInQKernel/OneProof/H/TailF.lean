def A6 : Matrix (Fin 2) (Fin 2) ℂ := !![0, 0; 0, 0]
def B6 : Matrix (Fin 2) (Fin 2) ℂ := !![0, -1; 1, 0]
def C6 : Matrix (Fin 2) (Fin 2) ℂ := !![0, 1; -1, 0]
