  obtain ⟨ξ', hξ'1, -⟩ := Scheme.Pullback.exists_preimage_pullback (f := 𝒴.hom) (g := ι) ξ
    (IsLocalRing.closedPoint K) (by rw [hfξ, hι (IsLocalRing.closedPoint K)])
