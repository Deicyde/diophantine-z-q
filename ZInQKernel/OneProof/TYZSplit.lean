/-! ## §1. TYZ's objects (TYZ §3.1, L1171–1311) -/

/-- **TYZ's `Cl_n = Gal(H_n/K_n)`** (L1263), `H_n` the Hilbert class field of `K_n = ℚ(√−n)`
(Tau Ceti's ring class field of the maximal order, `hilbertField n`). -/
abbrev ClG (n : ℕ) [NeZero n] : Type := (hilbertField n) ≃ₐ[QNeg n] (hilbertField n)

/-- The Artin isomorphism `Cl(K_n) = Pic(𝒪_{K_n}) ≃* Cl_n` (Tau Ceti). -/
abbrev art (n : ℕ) [NeZero n] : Pic (OK n) ≃* ClG n := ringClassArtinEquiv (OK n)

instance instFiniteClG (n : ℕ) [NeZero n] : Finite (ClG n) := Finite.of_equiv _ (art n).toEquiv

noncomputable instance instFintypeClG (n : ℕ) [NeZero n] : Fintype (ClG n) := Fintype.ofFinite _

/-- `ρ ∈ Gal(ℚ̄/ℚ)` restricts to `t ∈ Cl_n` on `H_n ⊂ ℚ̄` (embedded by ring-class's `embed n`). -/
def Restricts (n : ℕ) [NeZero n] (ρ : GalQ) (t : ClG n) : Prop :=
  ∀ x : hilbertField n, ρ (embed n (x : SeparableClosure (QNeg n))) =
    embed n ((t x : hilbertField n) : SeparableClosure (QNeg n))

/-- **TYZ's set `Φ ⊂ Cl'_n` of representatives of `Cl'_n/⟨σ⟩ ≅ Cl_n`** (L1279), encoded by lifts:
`φ t ∈ Gal(ℚ̄/ℚ)` restricts to `t` on `H_n`. TYZ's `Φ` is `{φ(t)|_{H'_n}}`: since
`Cl'_n = Gal(H'_n/K_n)` (`K'_n = K_n` for `n ≡ 5, 7`, L1263) and `⟨σ⟩ = Gal(H'_n/H_n)` is the kernel of
`Cl'_n → Cl_n` (Prop. 3.2 = `CM point1`, L1253–1261), the sets of representatives are exactly
the sets `{φ(t)|_{H'_n}}`, and `z_n^t` only depends on `t|_{H'_n}`. Modulo torsion `P_χ` does not
even depend on `φ`: `2z_n ∈ A(H_n)` (Prop. 3.2(4), L1261). Identifying `t` through `embed n` rather than
a conjugate embedding would replace `t` by `t⁻¹`, which is irrelevant for quadratic `χ`. -/
def IsPhi (n : ℕ) [NeZero n] (φ : ClG n → GalQ) : Prop := ∀ t, Restricts n (φ t) t

/-- **TYZ's quadratic point `P_χ = Σ_{t∈Φ} f_n(P_n)^t χ(t)`** (L1283), `z_n = f_n(P_n)` the kernel's
pinned CM point (`TYZ35.basePt`). -/
def PchiG (n : ℕ) [NeZero n] (φ : ClG n → GalQ) (χ : ClG n →* ℤˣ) : PtA :=
  ∑ t : ClG n, ((χ t : ℤˣ) : ℤ) • galPt (φ t) (basePt n)

/-- **`χ` is the character of `Cl_n` associated to the extension `K_n(√e)`**: every lift of
`t ∈ Cl_n` multiplies the square roots of `e` by `χ(t)`. (If `√e ∉ H_n` no `χ` satisfies this.) -/
def IsExtChar (n : ℕ) [NeZero n] (e : ℤ) (χ : ClG n →* ℤˣ) : Prop :=
  ∀ r : Qbar, r ^ 2 = (e : Qbar) → ∀ (t : ClG n) (ρ : GalQ), Restricts n ρ t →
    ρ r = (((χ t : ℤˣ) : ℤ) : Qbar) * r

/-- TYZ's radicand for `χ_{d₀,d₁}`: `d₁` for `n ≡ 5, 6 (mod 8)`, `d₁* = (−1)^{(d₁−1)/2} d₁` for
`n ≡ 7 (mod 8)` (L1304–1305). -/
def radTYZ (n d₁ : ℕ) : ℤ :=
  if n % 8 = 7 then (if d₁ % 4 = 1 then (d₁ : ℤ) else -(d₁ : ℤ)) else (d₁ : ℤ)

/-- **`χ = χ_{d₀,d₁}`**, "the unique Hecke character over `K_n` associated to the extension
`K_n(√d₁)` for `n ≡ 5, 6 (mod 8)` or `K_n(√d₁*)` for `n ≡ 7 (mod 8)`" (L1304–1305), as a character
of `Cl_n = Gal(H_n/K_n)`. -/
def IsChiPair (n : ℕ) [NeZero n] (d₁ : ℕ) (χ : ClG n →* ℤˣ) : Prop := IsExtChar n (radTYZ n d₁) χ

/-- The subgroup `2G` generated by the squares. -/
def sqSub (G : Type*) [Group G] : Subgroup G := Subgroup.closure (Set.range fun g : G => g ^ 2)

/-- **TYZ's `h₂(n) = dim_{𝔽₂} Cl_n/2Cl_n`** (L992, L2354), as `log₂ [Cl_n : 2Cl_n]`. -/
def h2G (n : ℕ) [NeZero n] : ℕ := Nat.log 2 (sqSub (ClG n)).index

/-- **The classes of `ε`** (L1308–1309): for `0 < d₀ ≡ 5, 6, 7` and `0 < d₁ ≡ 1, 2, 3 (mod 8)`,
`ε(d₀, d₁) = ±i` if `(d₀, d₁) ≡ (5, 3) (mod 8)` and `±1` otherwise. -/
def EpsTYZ (ε : ℕ → ℕ → GaussianInt) : Prop :=
  ∀ d₀ d₁ : ℕ, (d₀ % 8 = 5 ∨ d₀ % 8 = 6 ∨ d₀ % 8 = 7) → (d₁ % 8 = 1 ∨ d₁ % 8 = 2 ∨ d₁ % 8 = 3) →
    (d₀ % 8 = 5 ∧ d₁ % 8 = 3 → ε d₀ d₁ = gi ∨ ε d₀ d₁ = -gi) ∧
    (¬ (d₀ % 8 = 5 ∧ d₁ % 8 = 3) → ε d₀ d₁ = 1 ∨ ε d₀ d₁ = -1)

/-- `K_d = ℚ(√−d) ⊂ ℚ̄`. -/
def Kd (d : ℕ) : IntermediateField ℚ Qbar :=
  IntermediateField.adjoin ℚ {x : Qbar | x ^ 2 = -(d : Qbar)}

/-- `P ∈ A(K_d)^- = {α ∈ A(K_d) : ᾱ = −α}` (L1292–1293). -/
def InMinus (d : ℕ) (P : PtA) : Prop :=
  P ∈ ptsOver (Kd d) ∧ ∀ γ : GalQ, IsComplexConj γ → galPt γ P = -P

/-! ## §2. The leaf -/

/-- **Leaf TYZ-3.3: TYZ Theorem 3.3 ("Gross–Zagier formula"), printed form, for `n ≡ 5, 7 (mod 8)`.**

Source: Tian–Yuan–Zhang, *Genus periods, genus points and congruent number problem*,
arXiv:1411.4728v1 (Asian J. Math. 21 (2017) 721–774), Theorem 3.3 (`\label{GZ}`, Period7.tex
L1299–1311), with the definitions of §3.1: `Cl_n = Gal(H_n/K_n)`, `Cl'_n`, `σ` (L1263–1265), `Φ` and
`P_χ` (L1279–1284), `𝒫(n) = 2^{−1−ρ(n)} 𝓛(n) α_n ∈ A(K_n)^- ⊗ ℚ` (L1288–1295), `h₂` (L992). The
statement, for every positive squarefree `n ≡ 5, 7 (mod 8)`, every `Φ` and every character
`χ : Cl_n → {±1}`:

* `P_χ` is non-torsion only if `χ = χ_{d₀,d₁}` with `n = d₀d₁`, `0 < d₀ ≡ 5, 6, 7`,
  `0 < d₁ ≡ 1, 2, 3 (mod 8)` (the character of `K_n(√d₁)`, resp. `K_n(√d₁*)` for `n ≡ 7`);
* in that case `P_χ = ε(d₀,d₁) 2^{h₂(n)} 𝓛(d₁) 𝒫(d₀)` in `A(H'_n(i)) ⊗ ℚ`, `ε(d₀,d₁) = ±i` on
  `(5,3)`, `±1` otherwise.

Encoding (a reading of the same display, never stronger):
 * Model: the leaf is stated over the kernel's `basePt`, i.e. Heegner points on the eta-quotient model
  `X0.phiC`, whereas TYZ build `z_n` from an arbitrary identification `i_0`. Passing from the print to the
  leaf uses that the eta-model coordinates are rational functions on `X₀(32)` (q-expansion principle;
  `IsRatModFn 32` in Bridge.lean), so `phiC = [M]∘i_0` with `M ∈ End_ℚ(A) = ℤ`, which the existential
  `𝒫` absorbs. So the leaf is TYZ Theorem 3.3 carried along the eta model, not its literal display
  (statement review v2, M1).
* `A(H'_n(i)) ⊗ ℚ ⊂ A(ℚ̄) ⊗ ℚ`; a vector of `A(ℚ̄) ⊗ ℚ` is `Q/m`; equality is "the difference of the
  cleared multiples is torsion". `A` is the kernel's `y² = x³ + 4x ≅ X₀(32)`, `ℚ`-isomorphic to TYZ's
  `2y² = x³ + x` by `(x, y) ↦ (2x, 4y)`, compatibly with `[i]`; `z_n = f_n(P_n)` is the kernel's
  pinned point `TYZ35.basePt n` (cm-numeric/cm-bridge; `(1 − [i]) f₀(P_n)` for `n ≡ 5`). TYZ print
  `f_n = f₀ − f₀∘[i]` (L1196) with `[i]` an automorphism of `X_U ≅ X₀(32)_{ℚ(i)}`; reading it as
  `(1 − [i])∘f₀` with this sign of `i` is fixed by the paper: in the proof of the Hecke-action
  proposition for `n ≡ 5` the cusps `[∞,1]`, `[0]` lie on the component of `P_n` and `α = −i`
  (about L1238, L1519, L1551, L1564-1566), so TYZ's `[i]` acts as `+i` there; with this sign
  `f_n = f₀∘[1 − i]` (about L1584) is `ϖ`-invariant up to 2-torsion (about L1586-1589), as Prop. 3.1
  and the proof of Thm 3.3 (about L1909-1912) need. It agrees with cm-numeric's numerics. With the
  other sign the lifts do not commute with `[i]`, the contributing and excluded characters swap,
  and the leaf would be false, not weaker (statement review of tyz-split, 2026-11-14).
* Non-vacuity: the hypothesis on `ℓ` is satisfiable only if every `𝓛(m)²` (`m ≡ 1, 3`) is an integer
  square, i.e. together with `TYZThm11Integral` (TYZ Thm 1.1); otherwise the leaf (and the row,
  through `IsTYZLcal`) is vacuously true.
* `h₂` is defined in TYZ §2 (L992) and reused in §3 (L2354).
* `𝒫(d)` enters only through `Q d / m d` with `Q d ∈ A(K_d)^-` and `Q d` torsion when
  `ord_{s=1} L(E_d, s) > 1` (then `𝓛(d) = 0` by its definition, L338–345, so `𝒫(d) = 0`, L1295).
  This forgets the value `2^{−1−ρ(d)}𝓛(d)` of the coefficient (it needs Néron–Tate regulators,
  not in Mathlib): the leaf is weaker than the printed theorem, not stronger.
* `𝓛(d₁)` (`d₁ ≡ 1, 3`, `n` odd) is defined up to sign (L364); `ℓ` is any integer choice with
  `ℓ(d₁)² = 𝓛(d₁)²` (`lcalSq`), the sign absorbed in `ε` (`ε` is chosen after `ℓ`).
* Only `n ≡ 5, 7` (TYZ: `n ≡ 5, 6, 7`); then `d₀, d₁` are odd, so the classes `6, 2` do not occur
  (they are kept in the statement as printed).
* `Φ` is encoded by lifts (`IsPhi`), `χ` is a character of `Cl_n = Gal(H_n/K_n)` itself. -/
def TYZThm33 : Prop :=
  ∀ ℓ : ℕ → ℤ, (∀ m : ℕ, Squarefree m → (m % 8 = 1 ∨ m % 8 = 3) → ((ℓ m : ℂ)) ^ 2 = lcalSq m) →
  ∃ (Q : ℕ → PtA) (m : ℕ → ℕ) (ε : ℕ → ℕ → GaussianInt),
    (∀ d, 0 < m d) ∧ (∀ d, InMinus d (Q d)) ∧ EpsTYZ ε ∧
    (∀ d : ℕ, Squarefree d → (d % 8 = 5 ∨ d % 8 = 6 ∨ d % 8 = 7) →
      (¬ ∃ F : ℂ → ℂ, IsLContinuation (curveC d) F ∧ analyticOrderAt F 1 ≤ 1) →
        IsOfFinAddOrder (Q d)) ∧
    ∀ n : ℕ, ∀ _ : NeZero n, Squarefree n → (n % 8 = 5 ∨ n % 8 = 7) →
      ∀ φ : ClG n → GalQ, IsPhi n φ → ∀ χ : ClG n →* ℤˣ,
        (¬ IsOfFinAddOrder (PchiG n φ χ) →
          ∃ d₀ d₁ : ℕ, d₀ * d₁ = n ∧ (d₀ % 8 = 5 ∨ d₀ % 8 = 6 ∨ d₀ % 8 = 7) ∧
            (d₁ % 8 = 1 ∨ d₁ % 8 = 2 ∨ d₁ % 8 = 3) ∧ IsChiPair n d₁ χ) ∧
        ∀ d₀ d₁ : ℕ, d₀ * d₁ = n → (d₀ % 8 = 5 ∨ d₀ % 8 = 6 ∨ d₀ % 8 = 7) →
          (d₁ % 8 = 1 ∨ d₁ % 8 = 2 ∨ d₁ % 8 = 3) → IsChiPair n d₁ χ →
          IsOfFinAddOrder ((m d₀ : GaussianInt) • PchiG n φ χ -
            (ε d₀ d₁ * 2 ^ h2G n * (ℓ d₁ : GaussianInt)) • Q d₀)

/-! ## §3. Glue (proved) -/

section Glue

attribute [local instance] Classical.propDecidable

variable {n : ℕ} [NeZero n]

/-! ### 3.1 Genus characters as homomorphisms -/

/-- `±1` from a bit, as a hom to `ℤˣ`. -/
def sgnU : Multiplicative (ZMod 2) →* ℤˣ where
  toFun x := if x = 1 then 1 else -1
  map_one' := by simp
  map_mul' := by decide

theorem coe_sgnU (x : Multiplicative (ZMod 2)) : ((sgnU x : ℤˣ) : ℤ) = sgn2 x := by
  simp only [sgnU, MonoidHom.coe_mk, OneHom.coe_mk, sgn2]
  split_ifs <;> simp

variable (n) in
/-- `χ_T` on `Cl(K_n)` as a hom to `ℤˣ`. -/
def gcharHom (T : Finset n.primeFactors) : Pic (OK n) →* ℤˣ :=
  ∏ q ∈ T, sgnU.comp (chi n q)

theorem coe_gcharHom (T : Finset n.primeFactors) (c : Pic (OK n)) :
    ((gcharHom n T c : ℤˣ) : ℤ) = gchar n T c := by
  rw [gcharHom, MonoidHom.finsetProd_apply, Units.coe_prod, gchar]
  exact Finset.prod_congr rfl fun q _ => coe_sgnU _

variable (n) in
/-- `χ_T` as a character of `Cl_n = Gal(H_n/K_n)`. -/
def chiT (T : Finset n.primeFactors) : ClG n →* ℤˣ :=
  (gcharHom n T).comp (art n).symm.toMonoidHom

theorem coe_chiT (T : Finset n.primeFactors) (t : ClG n) :
    ((chiT n T t : ℤˣ) : ℤ) = gchar n T ((art n).symm t) := by
  rw [chiT, MonoidHom.comp_apply, ← coe_gcharHom]; rfl

/-! ### 3.2 Lift families -/

theorem restricts_of_acts {ρ : GalQ} {c : Pic (OK n)} (h : ActsAsArtinO n (OK n) ρ c) :
    Restricts n ρ (art n c) := fun x => h x

theorem acts_of_restricts {ρ : GalQ} {t : ClG n} (h : Restricts n ρ t) :
    ActsAsArtinO n (OK n) ρ ((art n).symm t) := by
  intro x
  rw [h x]
  show _ = embed n (((art n) ((art n).symm t) x : hilbertField n) : SeparableClosure (QNeg n))
  rw [MulEquiv.apply_symm_apply]

theorem exists_restricts (t : ClG n) : ∃ ρ : GalQ, Restricts n ρ t := by
  obtain ⟨ρ, hρ⟩ := exists_actsAsArtinO n (OK n) ((art n).symm t)
  refine ⟨ρ, ?_⟩
  have := restricts_of_acts hρ
  rwa [MulEquiv.apply_symm_apply] at this

theorem isPhi_of_liftFamily {f : Pic (OK n) → GalQ} (hf : IsLiftFamily n f) :
    IsPhi n (fun t => f ((art n).symm t)) := by
  intro t
  have := restricts_of_acts (hf ((art n).symm t)).1
  rwa [MulEquiv.apply_symm_apply] at this

theorem pchiG_chiT (f : Pic (OK n) → GalQ) (T : Finset n.primeFactors) :
    PchiG n (fun t => f ((art n).symm t)) (chiT n T) = Pchi n f T := by
  simp only [PchiG, Pchi, coe_chiT]
  exact Equiv.sum_comp (art n).symm.toEquiv (fun c => gchar n T c • galPt (f c) (basePt n))

/-! ### 3.3 Genus characters as Artin characters of `K_n(√e)` -/

/-- `√q* ∈ H_n` for odd squarefree `n` and `q ∣ n`. -/
theorem sqrt_pstar_mem' (hodd : Odd n) (hsq : Squarefree n) (q : n.primeFactors) :
    sqrtK (QNeg n) (pstar q) ∈ hilbertField n := by
  have h4 : n % 4 = 1 ∨ n % 4 = 3 := by have := Nat.odd_iff.1 hodd; omega
  rcases h4 with h | h
  · exact T321.sqrt_pstar_mem h hsq q
  · exact sqrtPstarInHilbert n inferInstance h hsq q q.2
      (IntermediateField.mem_adjoin_simple_self _ _)

/-- `ρ` restricting to `t` multiplies `√q*` by `χ_q(t)`. -/
theorem restricts_sqrt_pstar (hodd : Odd n) (hsq : Squarefree n) {ρ : GalQ} {t : ClG n}
    (hρ : Restricts n ρ t) (q : n.primeFactors) :
    ρ (embed n (sqrtK (QNeg n) (pstar q))) =
      ((sgn2 (chi n q ((art n).symm t)) : ℤ) : Qbar) * embed n (sqrtK (QNeg n) (pstar q)) := by
  have hs := sqrt_pstar_mem' hodd hsq q
  have h1 := acts_of_restricts hρ ⟨_, hs⟩
  rw [h1, T321.artinPstarChi_odd hodd hsq q _ hs, map_mul]
  simp only [sgn2]
  split_ifs <;> simp

/-! ### 3.4 Products of square roots -/

variable (n) in
/-- `S_T = Π_{q ∈ T} √q*`. -/
def sqProd (T : Finset n.primeFactors) : Qbar := ∏ q ∈ T, embed n (sqrtK (QNeg n) (pstar q))

theorem restricts_sqProd (hodd : Odd n) (hsq : Squarefree n) {ρ : GalQ} {t : ClG n}
    (hρ : Restricts n ρ t) (T : Finset n.primeFactors) :
    ρ (sqProd n T) = ((gchar n T ((art n).symm t) : ℤ) : Qbar) * sqProd n T := by
  rw [sqProd, map_prod, Finset.prod_congr rfl (fun q _ => restricts_sqrt_pstar hodd hsq hρ q),
    Finset.prod_mul_distrib, gchar, Int.cast_prod]

theorem sqProd_sq (T : Finset n.primeFactors) :
    sqProd n T ^ 2 = ((∏ q ∈ T, pstar q : ℤ) : Qbar) := by
  rw [sqProd, ← Finset.prod_pow, Int.cast_prod]
  refine Finset.prod_congr rfl fun q _ => ?_
  rw [← map_pow, sqrtK_sq, map_intCast]

theorem pstar_ne_zero (q : n.primeFactors) : pstar q ≠ 0 := by
  have := (Nat.prime_of_mem_primeFactors q.2).pos
  unfold pstar; split_ifs <;> omega

theorem prod_pstar_ne_zero (T : Finset n.primeFactors) : (∏ q ∈ T, pstar q) ≠ 0 :=
  Finset.prod_ne_zero_iff.2 fun q _ => pstar_ne_zero q

theorem sqProd_ne_zero (T : Finset n.primeFactors) : sqProd n T ≠ 0 := by
  intro h
  have h2 := sqProd_sq (n := n) T
  rw [h, zero_pow two_ne_zero] at h2
  exact prod_pstar_ne_zero T (by exact_mod_cast h2.symm)

theorem gchar_sq (T : Finset n.primeFactors) (c : Pic (OK n)) : gchar n T c * gchar n T c = 1 := by
  rw [← coe_gcharHom, ← Units.val_mul]
  rcases Int.units_eq_one_or (gcharHom n T c) with h | h <;> rw [h] <;> rfl

/-- Every square root of `−n` lies in `K_n` and is fixed by the lifts of `Cl_n`. -/
theorem restricts_fix_sqrt_negn {ρ : GalQ} {t : ClG n} (hρ : Restricts n ρ t) {r : Qbar}
    (hr : r ^ 2 = -(n : Qbar)) : ρ r = r := by
  set w : Qbar := embed n (algebraMap (QNeg n) (SeparableClosure (QNeg n)) QuadraticAlgebra.omega)
    with hwdef
  have hw : w ^ 2 = -(n : Qbar) := by
    rw [hwdef, ← map_pow, ← map_pow, Shimura.omega_sq', map_neg, map_neg, map_natCast, map_natCast]
  have hρw : ρ w = w := by
    have := hρ (algebraMap (QNeg n) (hilbertField n) QuadraticAlgebra.omega)
    rw [AlgEquiv.commutes] at this
    exact this
  rcases sq_eq_sq_iff_eq_or_eq_neg.1 (hr.trans hw.symm) with h | h
  · rw [h, hρw]
  · rw [h, map_neg, hρw]

/-- **`χ_T` is the character of `K_n(√e)`** when `e = Π_{q∈T} q*` or `e · Π_{q∈T} q* = −n`. -/
theorem isExtChar_chiT (hodd : Odd n) (hsq : Squarefree n) (T : Finset n.primeFactors) (e : ℤ)
    (he : e = ∏ q ∈ T, pstar q ∨ e * ∏ q ∈ T, pstar q = -(n : ℤ)) : IsExtChar n e (chiT n T) := by
  intro r hr t ρ hρ
  have hS := restricts_sqProd hodd hsq hρ T
  have hS2 := sqProd_sq (n := n) T
  have hS0 := sqProd_ne_zero (n := n) T
  rw [coe_chiT]
  set g := gchar n T ((art n).symm t) with hgdef
  have hg2 : ((g : ℤ) : Qbar) * (g : Qbar) = 1 := by
    rw [← Int.cast_mul, hgdef, gchar_sq, Int.cast_one]
  rcases he with he | he
  · have : r ^ 2 = sqProd n T ^ 2 := by rw [hr, hS2, he]
    rcases sq_eq_sq_iff_eq_or_eq_neg.1 this with h | h
    · rw [h, hS]
    · rw [h, map_neg, hS]; ring
  · have hrS : (r * sqProd n T) ^ 2 = -(n : Qbar) := by
      rw [mul_pow, hr, hS2, ← Int.cast_mul, he]; push_cast; ring
    have hfix := restricts_fix_sqrt_negn hρ hrS
    rw [map_mul, hS] at hfix
    have h1 : ρ r * (g : Qbar) = r := by
      apply mul_right_cancel₀ hS0
      rw [← hfix]; ring
    linear_combination (-(ρ r)) * hg2 + ((g : ℤ) : Qbar) * h1

/-! ### 3.5 The divisor sets -/

theorem map_divSet (hX : X ∣ n) :
    (divSet n X).map (Function.Embedding.subtype _) = X.primeFactors := by
  ext p
  simp only [divSet, Finset.mem_map, Finset.mem_filter, Finset.mem_univ, true_and,
    Function.Embedding.coe_subtype, Nat.mem_primeFactors]
  constructor
  · rintro ⟨q, hq, rfl⟩
    exact ⟨Nat.prime_of_mem_primeFactors q.2, hq, fun h0 => NeZero.ne n (Nat.eq_zero_of_zero_dvd (h0 ▸ hX))⟩
  · rintro ⟨hp, hpX, -⟩
    exact ⟨⟨p, Nat.mem_primeFactors.2 ⟨hp, hpX.trans hX, NeZero.ne n⟩⟩, hpX, rfl⟩

theorem prod_pstar_primeFactors {X : ℕ} (hX : Squarefree X) (hXodd : X % 2 = 1) :
    ∏ q ∈ X.primeFactors, pstar q = if X % 4 = 1 then (X : ℤ) else -(X : ℤ) := by
  have hodd : Odd X := Nat.odd_iff.mpr hXodd
  have h1 : ∀ q ∈ X.primeFactors, pstar q = ZMod.χ₄ (q : ZMod 4) * (q : ℤ) := by
    intro q hq
    have hq2 := T321.odd_of_mem_primeFactors hodd hq
    rw [ZMod.χ₄_nat_eq_if_mod_four, if_neg (show ¬ (q % 2 = 0) by omega)]
    unfold pstar
    split_ifs <;> ring
  rw [Finset.prod_congr rfl h1, Finset.prod_mul_distrib, ← map_prod, ← Nat.cast_prod, ← Nat.cast_prod,
    Nat.prod_primeFactors_of_squarefree hX, ZMod.χ₄_nat_eq_if_mod_four,
    if_neg (show ¬ (X % 2 = 0) by omega)]
  split_ifs <;> simp

theorem prod_pstar_divSet (hsq : Squarefree n) {X : ℕ} (hX : X ∣ n) (hXodd : X % 2 = 1) :
    ∏ q ∈ divSet n X, pstar q = if X % 4 = 1 then (X : ℤ) else -(X : ℤ) := by
  rw [← prod_pstar_primeFactors (hsq.squarefree_of_dvd hX) hXodd, ← map_divSet hX, Finset.prod_map]
  rfl

theorem mod8_of_mul {d₀ d₁ n : ℕ} (hd : d₀ * d₁ = n) (hn : n % 8 = 5 ∨ n % 8 = 7)
    (hd₁ : d₁ % 8 = 1 ∨ d₁ % 8 = 3 ∨ d₁ % 8 = 5 ∨ d₁ % 8 = 7) :
    (n % 8 = 5 → d₁ % 8 = 1 → d₀ % 8 = 5) ∧ (n % 8 = 5 → d₁ % 8 = 3 → d₀ % 8 = 7) ∧
    (n % 8 = 7 → d₁ % 8 = 1 → d₀ % 8 = 7) ∧ (n % 8 = 7 → d₁ % 8 = 3 → d₀ % 8 = 5) ∧
    (n % 8 = 5 → d₁ % 8 = 5 → d₀ % 8 = 1) ∧ (n % 8 = 5 → d₁ % 8 = 7 → d₀ % 8 = 3) := by
  have h := Nat.mul_mod d₀ d₁ 8
  rw [hd] at h
  have h8 : d₀ % 8 < 8 := Nat.mod_lt _ (by norm_num)
  rcases hd₁ with h1 | h1 | h1 | h1 <;> rw [h1] at h <;> omega

/-- **`χ_{pairSet n d₀ d₁}` is TYZ's `χ_{d₀,d₁}`** for the contributing pairs. -/
theorem isChiPair_pairSet (hsq : Squarefree n) (hn : n % 8 = 5 ∨ n % 8 = 7) {d₀ d₁ : ℕ}
    (hd : d₀ * d₁ = n) (hd₁ : d₁ % 8 = 1 ∨ d₁ % 8 = 3) :
    IsChiPair n d₁ (chiT n (pairSet n d₀ d₁)) := by
  have hodd : Odd n := Nat.odd_iff.2 (by omega)
  have hm := mod8_of_mul hd hn (by omega)
  have hd0 : d₀ ∣ n := ⟨d₁, hd.symm⟩
  have hd1 : d₁ ∣ n := ⟨d₀, by rw [← hd, mul_comm]⟩
  apply isExtChar_chiT hodd hsq
  rcases hd₁ with h1 | h3
  · have hp : pairSet n d₀ d₁ = divSet n d₁ := by
      simp only [pairSet, divSet, show d₁ % 4 = 1 by omega, if_true]
    left
    rw [hp, prod_pstar_divSet hsq hd1 (by omega), if_pos (by omega), radTYZ]
    split_ifs <;> first | rfl | omega
  · have hp : pairSet n d₀ d₁ = divSet n d₀ := by
      simp only [pairSet, divSet, show ¬ d₁ % 4 = 1 by omega, if_false]
    right
    rw [hp, prod_pstar_divSet hsq hd0 (by omega), radTYZ]
    rcases hn with h5 | h7
    · rw [if_neg (show ¬ n % 8 = 7 by omega),
        if_neg (show ¬ d₀ % 4 = 1 by have := hm.2.1 h5 h3; omega), ← hd]
      push_cast; ring
    · rw [if_pos h7, if_neg (show ¬ d₁ % 4 = 1 by omega),
        if_pos (show d₀ % 4 = 1 by have := hm.2.2.2.1 h7 h3; omega), ← hd]
      push_cast; ring

/-! ### 3.6 Uniqueness and independence -/

theorem isExtChar_unique {e : ℤ} (he : e ≠ 0) {χ χ' : ClG n →* ℤˣ} (h : IsExtChar n e χ)
    (h' : IsExtChar n e χ') : χ = χ' := by
  obtain ⟨r, hr⟩ := IsAlgClosed.exists_pow_nat_eq (e : Qbar) two_pos
  have hr0 : r ≠ 0 := by
    rintro rfl; rw [zero_pow two_ne_zero] at hr; exact he (by exact_mod_cast hr.symm)
  ext t
  obtain ⟨ρ, hρ⟩ := exists_restricts t
  have e1 := h r hr t ρ hρ
  have e2 := h' r hr t ρ hρ
  rw [e1] at e2
  have := mul_right_cancel₀ hr0 e2
  exact_mod_cast this

theorem gchar_single (q₀ : n.primeFactors) {c : Pic (OK n)}
    (hc : ∀ q, chi n q c = Multiplicative.ofAdd (if q = q₀ then (1 : ZMod 2) else 0))
    (S : Finset n.primeFactors) : gchar n S c = if q₀ ∈ S then -1 else 1 := by
  rw [gchar]
  have : ∀ q ∈ S, sgn2 (chi n q c) = if q = q₀ then -1 else 1 := by
    intro q _
    rw [hc q]
    split_ifs <;> decide
  rw [Finset.prod_congr rfl this, Finset.prod_ite_eq']

/-- **The `2^k` genus characters `χ_T` are distinct for `n ≡ 1 (mod 4)`** (onto by `exists_chi_eq`). -/
theorem gchar_inj (h4 : n % 4 = 1) (hsq : Squarefree n) {T T' : Finset n.primeFactors}
    (h : ∀ c, gchar n T c = gchar n T' c) : T = T' := by
  by_contra hne
  obtain ⟨q₀, hq₀⟩ : ∃ q₀, ¬ (q₀ ∈ T ↔ q₀ ∈ T') := by
    by_contra hall; push_neg at hall; exact hne (Finset.ext hall)
  obtain ⟨c, hc⟩ := exists_chi_eq n (Nat.odd_iff.2 (by omega)) hsq
    (fun q => if q = q₀ then 1 else 0) (by omega)
  have h1 := h c
  rw [gchar_single q₀ hc, gchar_single q₀ hc] at h1
  apply hq₀
  constructor <;> intro hm <;> by_contra hn' <;> simp [hm, hn'] at h1

theorem divSet_inj (hsq : Squarefree n) {X Y : ℕ} (hX : X ∣ n) (hY : Y ∣ n)
    (h : divSet n X = divSet n Y) : X = Y := by
  rw [← prod_divSet hsq hX, ← prod_divSet hsq hY, h]

/-- **The excluded characters** (`n ≡ 5`, `d₁ ≡ 5, 7`) are none of the `χ_{d₀',d₁'}`. -/
theorem not_isChiPair_excluded (hsq : Squarefree n) (h5 : n % 8 = 5) {d₀ d₁ d₀' d₁' : ℕ}
    (hd : d₀ * d₁ = n) (hd₁ : d₁ % 8 = 5 ∨ d₁ % 8 = 7) (hd' : d₀' * d₁' = n)
    (hd₁' : d₁' % 8 = 1 ∨ d₁' % 8 = 2 ∨ d₁' % 8 = 3)
    (hpair : IsChiPair n d₁' (chiT n (pairSet n d₀ d₁))) : False := by
  have hodd : n % 2 = 1 := by omega
  have hd₁'' : d₁' % 8 = 1 ∨ d₁' % 8 = 3 := by
    have := Nat.mul_mod d₀' d₁' 8; rw [hd'] at this
    have h8 : d₀' % 8 < 8 := Nat.mod_lt _ (by norm_num)
    rcases hd₁' with h | h | h
    · omega
    · rw [h] at this; omega
    · omega
  have hrad : radTYZ n d₁' ≠ 0 := by
    have : 0 < d₁' := Nat.pos_of_ne_zero (by rintro rfl; omega)
    unfold radTYZ; split_ifs <;> omega
  have heq := isExtChar_unique hrad hpair (isChiPair_pairSet hsq (Or.inl h5) hd' hd₁'')
  have hT : pairSet n d₀ d₁ = pairSet n d₀' d₁' := by
    apply gchar_inj (by omega) hsq
    intro c
    have := congrArg (fun χ : ClG n →* ℤˣ => ((χ (art n c) : ℤˣ) : ℤ)) heq
    simp only [coe_chiT, MulEquiv.symm_apply_apply] at this
    exact this
  have hm := mod8_of_mul hd (Or.inl h5) (by omega)
  have hm' := mod8_of_mul hd' (Or.inl h5) (by omega)
  have hd0 : d₀ ∣ n := ⟨d₁, hd.symm⟩
  have hd1 : d₁ ∣ n := ⟨d₀, by rw [← hd, mul_comm]⟩
  have hd0' : d₀' ∣ n := ⟨d₁', hd'.symm⟩
  have hd1' : d₁' ∣ n := ⟨d₀', by rw [← hd', mul_comm]⟩
  have e1 : pairSet n d₀ d₁ = divSet n (if d₁ % 4 = 1 then d₁ else d₀) := rfl
  have e2 : pairSet n d₀' d₁' = divSet n (if d₁' % 4 = 1 then d₁' else d₀') := rfl
  rw [e1, e2] at hT
  have hXY := divSet_inj hsq (by split_ifs <;> assumption) (by split_ifs <;> assumption) hT
  rcases hd₁ with h | h <;> rcases hd₁'' with h' | h'
  · rw [if_pos (by omega), if_pos (by omega)] at hXY; omega
  · rw [if_pos (by omega), if_neg (by omega)] at hXY; have := hm'.2.1 h5 h'; omega
  · rw [if_neg (by omega), if_pos (by omega)] at hXY; have := hm.2.2.2.2.2 h5 h; omega
  · rw [if_neg (by omega), if_neg (by omega)] at hXY
    have := hm.2.2.2.2.2 h5 h; have := hm'.2.1 h5 h'; omega

/-! ### 3.7 `h₂` -/

theorem sqSub_comm (G : Type*) [CommGroup G] : sqSub G = (powMonoidHom 2 : G →* G).range := by
  apply le_antisymm
  · rw [sqSub, Subgroup.closure_le]; rintro _ ⟨g, rfl⟩; exact ⟨g, rfl⟩
  · rintro _ ⟨g, rfl⟩; exact Subgroup.subset_closure ⟨g, rfl⟩

theorem sqSub_map {G G' : Type*} [Group G] [Group G'] (e : G ≃* G') :
    (sqSub G).map (e : G →* G') = sqSub G' := by
  rw [sqSub, sqSub, MonoidHom.map_closure]
  congr 1
  ext x
  constructor
  · rintro ⟨_, ⟨g, rfl⟩, rfl⟩; exact ⟨e g, by simp⟩
  · rintro ⟨g, rfl⟩; exact ⟨e.symm g ^ 2, ⟨_, rfl⟩, by simp⟩

/-- **`h₂(n) = #ramSet(n) − 1`** (Gauss's genus theory, L993; the kernel's `card_ker_sq_eq`). -/
theorem h2G_eq (hodd : Odd n) (hsq : Squarefree n) (h1 : 1 < n) : h2G n = h2 n := by
  have hidx : (sqSub (ClG n)).index = 2 ^ ((ramSet n).card - 1) := by
    rw [← sqSub_map (art n), Subgroup.index_map_equiv, sqSub_comm, Subgroup.index_range]
    exact card_ker_sq_eq n hodd hsq h1
  rw [h2G, hidx, Nat.log_pow (by norm_num), h2]

end Glue

/-! ## §4. The row T-11 from the leaf -/

/-- **Row T-11 proved from the printed leaf**: `TYZ35.TYZThm33Pinned ℓ` (tyz-35's pinned form, kernel
`ZInQKernel/Contrib/TYZChain/Thm35.lean`) for every sign choice `ℓ` of `𝓛`, from TYZ Theorem 3.3
in its printed form (`TYZThm33`). -/
theorem tyzThm33Pinned_of_tyzThm33 (h : TYZThm33) (ℓ : ℕ → ℤ) (hℓ : IsTYZLcal ℓ) :
    TYZThm33Pinned ℓ := by
  obtain ⟨Q, m, ε, hm, -, hε, hQ, hmain⟩ := h ℓ hℓ.2.1
  refine ⟨Q, m, ε, hm, ?_, ?_, ?_, ?_⟩
  · intro d₀ d₁ h0 h1
    exact (hε d₀ d₁ (by omega) (by omega)).1 ⟨h0, h1⟩
  · intro d₀ d₁ hc
    exact (hε d₀ d₁ (by omega) (by omega)).2 (by omega)
  · intro n hsq hn hℓn
    exact hQ n hsq (by omega) ((hℓ.2.2 n hsq hn).1 hℓn)
  · intro n hn0 hsq hn f hf
    have hφ := isPhi_of_liftFamily hf
    have hodd : Odd n := Nat.odd_iff.2 (by omega)
    have h1 : 1 < n := by
      rcases Nat.lt_or_ge 1 n with h | h
      · exact h
      · interval_cases n <;> omega
    have hh2 : h2G n = h2 n := h2G_eq hodd hsq h1
    refine ⟨fun d₀ d₁ hd hd₁ => ?_, fun h5 d₀ d₁ hd hd₁ => ?_⟩
    · have hm8 := mod8_of_mul hd hn (by omega)
      have := (hmain n hn0 hsq hn _ hφ (chiT n (pairSet n d₀ d₁))).2 d₀ d₁ hd
        (by rcases hn with h | h <;> rcases hd₁ with h' | h' <;> simp_all) (by omega)
        (isChiPair_pairSet hsq hn hd hd₁)
      rwa [pchiG_chiT, hh2] at this
    · by_contra hnt
      rw [← pchiG_chiT] at hnt
      obtain ⟨d₀', d₁', hd', -, hd₁', hpair⟩ := (hmain n hn0 hsq hn _ hφ _).1 hnt
      exact not_isChiPair_excluded hsq h5 hd hd₁ hd' hd₁' hpair

/-- The kernel's `TYZChain` hypothesis `∀ ℓ, IsTYZLcal ℓ → TYZThm33Pinned ℓ` from the printed leaf. -/
theorem thm33Pinned_of_tyzThm33 (h : TYZThm33) :
    ∀ ℓ : ℕ → ℤ, IsTYZLcal ℓ → TYZThm33Pinned ℓ :=
  tyzThm33Pinned_of_tyzThm33 h

/-- **TYZ reading A (`ZInQ.Literature.TYZThm35ReadingA`) with T-11 replaced by the printed TYZ
Theorem 3.3** (the kernel's `TYZChain.tyzThm35ReadingA_of_leaves`). -/
theorem tyzThm35ReadingA_of_printedThm33
    (h11 : TYZThm11Integral) (h29 : TYZLemma29Mod2)
    (hS : Shimura.ShimuraReciprocityModFn) (h33 : TYZThm33) :
    ZInQ.Literature.TYZThm35ReadingA :=
  ZInQ.Contrib.TYZChain.tyzThm35ReadingA_of_leaves h11 h29 hS (thm33Pinned_of_tyzThm33 h33)

end ZInQ.Contrib.TYZGenus.TYZSplit
