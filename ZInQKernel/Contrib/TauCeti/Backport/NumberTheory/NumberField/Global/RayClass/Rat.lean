variable (n hn)
variable {n hn}

/-- **A modulus of `ℚ` divides `(n)·∞` exactly when the absolute norm of its finite part divides
`n`**: the finite part is generated by its absolute norm, and the real place is the only infinite
place of `ℚ`. -/
theorem dvd_ratModulus_iff {𝔪 : Modulus ℚ} :
    𝔪 ∣ ratModulus n hn ↔ Ideal.absNorm 𝔪.finitePart ∣ n := by
  have hinf : 𝔪.infinitePart ⊆ (ratModulus n hn).infinitePart := fun _ _ ↦ by
    -- The oct16 module does not expose the body of `ratModulus`; use `ratModulus_infinitePart`.
    rw [ratModulus_infinitePart]
    exact Finset.mem_singleton.mpr (Subtype.ext (Subsingleton.elim _ _))
  rw [Modulus.dvd_iff, and_iff_left hinf, ratModulus_finitePart]
  conv_lhs => rw [← Rat.RingOfIntegers.ideal_span_absNorm_eq_self 𝔪.finitePart]
  rw [Ideal.span_singleton_dvd_span_singleton_iff_dvd,
    NumberField.RingOfIntegers.natCast_dvd_natCast]

end TauCeti.GlobalNumberFields

open IsDedekindDomain NumberField
