import ZInQKernel.Contrib.T31.Cyclic
import ZInQKernel.Contrib.T31.Local
import ZInQKernel.Contrib.TauCeti.NumberTheory.LocalField.ResidueCorrespondence
import ZInQKernel.Contrib.TauCeti.NumberTheory.LocalField.Unramified.Existence
import ZInQKernel.Contrib.TauCeti.NumberTheory.LocalField.Padic

/-!
# T31: `GlueDescent.B2Q.LeafUnramified`

**Theorem** (`T31.leafUnramified : GlueDescent.B2Q.LeafUnramified`). Let `L/ℚ` be a finite Galois
extension inside `ℚ̄`, unramified at the prime `p`, and `ε` a sign `2`-cocycle of `G_ℚ` inflated
from `Gal(L/ℚ)`. Then the restriction of `ε` to `G_{ℚ_p}` (along `resp p`) is the coboundary of
a locally constant sign cochain.

Proof. Let `ι₀ : ℚ̄ → ℚ̄_p` be the embedding underlying `resp p`. By `T31.exists_unramifiedExtension`
(the local part, through Tau Ceti's theory of unramified extensions) `ι₀(L)` lies in the
unramified extension `K_f` of `K = ℚ_p` of some degree `f ≥ 1`. Let `M = K_{2f}`; its Galois
group is cyclic of order `2f` (Tau Ceti `isCyclic_algEquiv`, `finrank_unramifiedExtension`). The
pulled back cocycle depends only on the restrictions to `M` of its arguments modulo the subgroup
generated by `φ^f` (`φ` a generator), which fixes `K_f ⊇ ι₀(L)`. Conclude by the abstract lemma
`T31.signCob_of_cyclic_even` (`H²(ℤ/f, ±1) → H²(ℤ/2f, ±1)` is zero).
-/

namespace T31

open GlueDescent.B2 GlueDescent.B2Q NumberField TauCeti ValuativeRel

local instance (p : Nat.Primes) : Fact (p : ℕ).Prime := ⟨p.2⟩

/-- An element of `G_{ℚ_p}` as an automorphism of `ℚ̄_p`. -/
def actp {p : Nat.Primes} (σ : GQp p) :
    AlgebraicClosure ℚ_[p] ≃ₐ[ℚ_[p]] AlgebraicClosure ℚ_[p] := σ

/-- The embedding `ℚ̄ → ℚ̄_p` underlying `resp p`. -/
theorem exists_iota (p : Nat.Primes) :
    ∃ ι₀ : AlgebraicClosure ℚ →+* AlgebraicClosure ℚ_[p],
      ∀ (σ : GQp p) (x : AlgebraicClosure ℚ), ι₀ (act (resp p σ) x) = actp σ (ι₀ x) := by
  let : Algebra ℚ ℚ_[p] := (algebraMap ℚ ℚ_[p]).toAlgebra
  let g : AlgebraicClosure ℚ →ₐ[ℚ] AlgebraicClosure ℚ_[p] := IsAlgClosed.lift
  let : Algebra (AlgebraicClosure ℚ) (AlgebraicClosure ℚ_[p]) := g.toAlgebra
  refine ⟨algebraMap _ _, fun σ x => ?_⟩
  exact AlgEquiv.restrictNormal_commutes (σ.restrictScalars ℚ) (AlgebraicClosure ℚ) x

theorem padic_val_lt_one (p : Nat.Primes) : valuation ℚ_[p] ((p : ℕ) : ℚ_[p]) < 1 := by
  have hirr := TauCeti.Padic.irreducible_natCast_self (p := (p : ℕ))
  have hle : valuation ℚ_[p] (algebraMap 𝒪[ℚ_[p]] ℚ_[p] ((p : ℕ) : 𝒪[ℚ_[p]])) ≤ 1 :=
    (Valuation.integer.integers (valuation ℚ_[p])).map_le_one _
  have hne : valuation ℚ_[p] (algebraMap 𝒪[ℚ_[p]] ℚ_[p] ((p : ℕ) : 𝒪[ℚ_[p]])) ≠ 1 := fun h =>
    hirr.not_isUnit ((Valuation.integer.integers (valuation ℚ_[p])).isUnit_iff_valuation_eq_one.2 h)
  have := lt_of_le_of_ne hle hne
  have e : algebraMap 𝒪[ℚ_[p]] ℚ_[p] ((p : ℕ) : 𝒪[ℚ_[p]]) = ((p : ℕ) : ℚ_[p]) :=
    map_natCast _ _
  rw [e] at this
  exact this

theorem restrictNormalHom_coe {K Ω : Type*} [Field K] [Field Ω] [Algebra K Ω]
    (E : IntermediateField K Ω) [Normal K E] (σ : Ω ≃ₐ[K] Ω) (y : E) :
    ((AlgEquiv.restrictNormalHom E σ y : E) : Ω) = σ y :=
  AlgEquiv.restrictNormal_commutes σ E y

/-- **T31.** -/
theorem leafUnramified : LeafUnramified := by
  intro L _ _ ε hε hinf p hunr
  obtain ⟨ι₀, hι₀⟩ := exists_iota p
  let K := ℚ_[p]
  let Ω := AlgebraicClosure ℚ_[p]
  let _ : ValuativeRel Ω := algebraicExtensionValuativeRel ℚ_[p] Ω
  have : ValuativeExtension ℚ_[p] Ω := algebraicExtension_valuativeExtension ℚ_[p] Ω
  have : NumberField L := { to_charZero := inferInstance, to_finiteDimensional := inferInstance }
  have hunr' : ∀ P : Ideal (𝓞 L), P.IsPrime → ((p : ℕ) : 𝓞 L) ∈ P → P.ramificationIdx ℤ = 1 :=
    fun P hP hpP => hunr P hP (by simpa using hpP)
  obtain ⟨f, hf0, hf⟩ := exists_unramifiedExtension ℚ_[p] (Ω := Ω) (ι₀.comp L.val.toRingHom)
    (padic_val_lt_one p) p.2.ne_zero hunr'
  -- The unramified extension `M = K_{2f}` and its cyclic Galois group.
  have h2f : 2 * f ≠ 0 := by omega
  let M := unramifiedExtension ℚ_[p] Ω (2 * f)
  let Kf := unramifiedExtension ℚ_[p] Ω f
  let _ := finiteIntermediateFieldValuativeRel ℚ_[p] Ω M
  let _ := finiteIntermediateFieldTopology ℚ_[p] Ω M
  have := finiteIntermediateField_isNonarchimedeanLocalField ℚ_[p] Ω M
  have := finiteIntermediateField_valuativeExtension ℚ_[p] Ω M
  have : IsUnramified ℚ_[p] M := isUnramified_unramifiedExtension h2f
  have hcyc : IsCyclic (M ≃ₐ[ℚ_[p]] M) := inferInstance
  obtain ⟨φ, hφ⟩ := hcyc.exists_generator
  have hcardM : Nat.card (M ≃ₐ[ℚ_[p]] M) = 2 * f := by
    rw [IsGalois.card_aut_eq_finrank, finrank_unramifiedExtension h2f]
  have hcardKf : Nat.card (Kf ≃ₐ[ℚ_[p]] Kf) = f := by
    rw [IsGalois.card_aut_eq_finrank, finrank_unramifiedExtension hf0]
  have hord : orderOf φ = 2 * f := by
    rw [orderOf_eq_card_of_forall_mem_zpowers hφ, hcardM]
  have hKfM : Kf ≤ M := unramifiedExtension_le_of_dvd h2f (Dvd.intro_left 2 rfl)
  let ψ : GQp p →* (M ≃ₐ[ℚ_[p]] M) := AlgEquiv.restrictNormalHom M
  let ψf : GQp p →* (Kf ≃ₐ[ℚ_[p]] Kf) := AlgEquiv.restrictNormalHom Kf
  have hker : IsOpen (ψ.ker : Set (GQp p)) := by
    have : ψ.ker = M.fixingSubgroup := IntermediateField.restrictNormalHom_ker M
    rw [this]
    exact IntermediateField.fixingSubgroup_isOpen M
  have hpow : ∀ h : M ≃ₐ[ℚ_[p]] M, ∃ k : ℕ, φ ^ k = h := fun h =>
    (mem_powers_iff_mem_zpowers.2 (hφ h))
  obtain ⟨g₁, hg₁⟩ : ∃ g : GQp p, ψ g = φ :=
    AlgEquiv.restrictNormalHom_surjective (F := ℚ_[p]) (K₁ := M) (E := Ω) φ
  -- Elements with `ψ ρ ∈ ⟨φ^f⟩` fix `K_f`.
  have hfix : ∀ ρ : GQp p, (∃ i : ℕ, ψ ρ = (φ ^ f) ^ i) → ∀ y ∈ Kf, actp ρ y = y := by
    rintro ρ ⟨i, hi⟩ y hy
    have h1 : ψ ρ = ψ (g₁ ^ (f * i)) := by rw [hi, map_pow, hg₁, pow_mul]
    have h2 : actp ρ y = actp (g₁ ^ (f * i)) y := by
      have e1 := restrictNormalHom_coe M ρ ⟨y, hKfM hy⟩
      have e2 := restrictNormalHom_coe M (g₁ ^ (f * i)) ⟨y, hKfM hy⟩
      exact e1.symm.trans
        ((congrArg (fun χ : M ≃ₐ[ℚ_[p]] M => ((χ ⟨y, hKfM hy⟩ : M) : Ω)) h1).trans e2)
    have h3 : ψf (g₁ ^ (f * i)) = 1 := by
      rw [map_pow, pow_mul, ← hcardKf, pow_card_eq_one', one_pow]
    have e3 := restrictNormalHom_coe Kf (g₁ ^ (f * i)) ⟨y, hy⟩
    change ((ψf (g₁ ^ (f * i)) ⟨y, hy⟩ : Kf) : Ω) = _ at e3
    rw [h3] at e3
    exact h2.trans e3.symm
  have hagree : ∀ σ σ' : GQp p, (∃ i : ℕ, ψ σ' = ψ σ * (φ ^ f) ^ i) →
      ∀ x ∈ L, act (resp p σ) x = act (resp p σ') x := by
    rintro σ σ' ⟨i, hi⟩ x hx
    apply ι₀.injective
    rw [hι₀, hι₀]
    have hρ : ∃ i : ℕ, ψ (σ⁻¹ * σ') = (φ ^ f) ^ i := ⟨i, by rw [map_mul, hi, map_inv, inv_mul_cancel_left]⟩
    have hy : ι₀ x ∈ Kf := hf ⟨x, hx⟩
    have := hfix _ hρ _ hy
    calc actp σ (ι₀ x) = actp σ (actp (σ⁻¹ * σ') (ι₀ x)) := by rw [this]
      _ = actp σ' (ι₀ x) := by
          simp only [actp]
          exact AlgEquiv.apply_symm_apply _ _
  refine signCob_of_cyclic_even ψ hker φ hpow g₁ hg₁ f hord (pull (resp p) ε)
    (isSignCocycle_pull (resp p) (resp_continuous p) hε) ?_
  rintro σ σ' τ τ' hσ hτ
  exact hinf _ _ _ _ (hagree σ σ' hσ) (hagree τ τ' hτ)

end T31
