import ZInQKernel.Contrib.OneProof.RC.Wiring.ConstituentModelRel

/-!
# An obstruction: additive value functions give the zero reading

Finding, `PROVED`. In RC0's corrected trace model `TraceModelRel` with even `a_p`, suppose every
value function `f_U(g) = read_U(t(g)F_U)` is additive in `g` (a homomorphism `G → 𝔽₂`). Then
`f_U ≡ 0` for every set `U` of good primes with `|U| + 2 ≤ B`, so the reading vanishes on every
set of good primes of size at most `B − 1` (`reading_eq_zero_of_additive`). A family of models at
every budget, which is what `coefficientRules_of_modelRel` takes, then has the zero reading.

Proof:
* an additive `f_U` kills the squares, and kills `N_U` (`level`), hence by `kummer` every element
  of trivial type and trivial `U`-characters (`valFn_eq_zero_of_chars`); so `f_U` factors through
  the characters at `U` (`valFn_congr`);
* for a fresh good `p`, (O.12) at `U ∪ {p}` with RC12's `cp_sum_odd` gives
  `f_U(g) + f_U(φ) = f_{U∪p}(τ)`, where the characters of `φ` and `τ` do not depend on `g`. So
  `f_U` is constant, and `f_U(1) = 0`.

The same holds for `ConstituentModelRel` through `toTraceModelRel`
(`constituent_reading_eq_zero_of_additive`).

Consequence for witnesses. The simplest explicit constituent models have additive reduced traces:
abelian image, `2`-dimensional representations by `μ₄`-valued characters over `ℤ[i]`, and
`𝔪 = (2)`, with all traces in `(1 + i)` as `two_fresh` requires. There `tr ρ(g) ≡ (1 + i)·ℓ(g)`
for an `𝔽₂`-linear `ℓ` (remark, not formalized here), so these models can only have the zero
reading.
A constituent model with a nonzero reading needs reduced traces that are nonlinear in `g`
(nonabelian images, or deeper ramification of `𝒪` at two), as the genuine `GL₂` images provide.
The abstract `TraceModelRel` admits nonlinear value functions, and `RedeiTraceModel.lean` gives one
with a nonzero reading.
-/

noncomputable section

namespace ZInQ.Contrib.CloudB3RC53.TraceWitness

open ZInQ.Manuscript.RC.Symbols ZInQ.Manuscript.RC.Odd ZInQ.Manuscript.RC.Wiring
  ZInQ.Contrib.CloudB3RC53.CoefficientDictionary Finset

variable {L : Type*} [AddCommGroup L] {ε : L →+ ZMod 2} {T : TypeData L ε}
  {R : Finset ℕ → ZMod 2} {ap : ℕ → ℤ} {B : ℕ}

theorem zmod2_sub (a b : ZMod 2) : a - b = a + b := by revert a b; decide

/-- The value function `g ↦ read_U(t(g)F_U)` of a trace model. -/
def valFn (X : TraceModelRel T R ap B) (U : Finset ℕ) (g : X.G) : ZMod 2 :=
  X.read U (X.t g (X.F U))

/-- An additive value function factors through the characters at `U`: it vanishes on every
element of trivial type and trivial `U`-characters (`PROVED`: such an element lies in the subgroup
generated by the squares and `N_U` by `kummer`, and both lie in the kernel). -/
theorem valFn_eq_zero_of_chars (X : TraceModelRel T R ap B) (U : Finset ℕ)
    (hadd : ∀ g h, valFn X U (g * h) = valFn X U g + valFn X U h) {n : X.G}
    (h1 : X.chiType n = 1) (h2 : ∀ s ∈ U, X.chiBit s n = 1) : valFn X U n = 0 := by
  let φ : X.G →* Multiplicative (ZMod 2) :=
    { toFun := fun g => Multiplicative.ofAdd (valFn X U g)
      map_one' := by
        have h := hadd 1 1
        rw [mul_one] at h
        have : valFn X U 1 = 0 := by
          generalize valFn X U 1 = a at h
          revert a; decide
        rw [this]; rfl
      map_mul' := fun g h => by rw [hadd]; rfl }
  have hsq : Subgroup.closure (sqSet X.G) ≤ φ.ker := by
    rw [Subgroup.closure_le]
    rintro x ⟨h, rfl⟩
    show Multiplicative.ofAdd (valFn X U (h ^ 2)) = 1
    rw [pow_two, hadd]
    generalize valFn X U h = a
    revert a; decide
  have hN : X.N U ≤ φ.ker := by
    intro n hn
    show Multiplicative.ofAdd (valFn X U n) = 1
    have h := X.level U 1 n hn
    rw [one_mul] at h
    have h1' : valFn X U n = valFn X U 1 := by unfold valFn; rw [h]
    rw [h1', ← MonoidHom.map_one φ]; rfl
  have hk := sup_le hsq hN (X.kummer U n h1 h2)
  exact Multiplicative.ofAdd.injective hk

/-- Elements with the same type and `U`-characters have the same additive value. -/
theorem valFn_congr (X : TraceModelRel T R ap B) (U : Finset ℕ)
    (hadd : ∀ g h, valFn X U (g * h) = valFn X U g + valFn X U h) {g g' : X.G}
    (h1 : X.chiType g = X.chiType g') (h2 : ∀ s ∈ U, X.chiBit s g = X.chiBit s g') :
    valFn X U g = valFn X U g' := by
  have hg' : g' = g * (g⁻¹ * g') := by group
  rw [hg', hadd, valFn_eq_zero_of_chars X U hadd (n := g⁻¹ * g') (by
    rw [map_mul, map_inv, h1, inv_mul_cancel]) (fun s hs => by
    rw [map_mul, map_inv, h2 s hs, inv_mul_cancel]), add_zero]

/-- **Additive value functions read zero** (`PROVED`): in a corrected trace model with even `a_p`,
if every value function `g ↦ read_U(t(g)F_U)` is additive, then `read_U(t(g)F_U) = 0` for every
set `U` of good primes with `|U| + 2 ≤ B`. -/
theorem valFn_eq_zero_of_additive (X : TraceModelRel T R ap B) (hap : ApEven T ap)
    (hadd : ∀ U g h, valFn X U (g * h) = valFn X U g + valFn X U h) {U : Finset ℕ}
    (hU : ∀ s ∈ U, T.Good s) (hB : U.card + 2 ≤ B) (g : X.G) : valFn X U g = 0 := by
  classical
  -- a fresh good prime `p`
  obtain ⟨x, -, hx, -, -⟩ := realizeNat T U ∅ hU (fun _ => 0) (fun _ _ => 0) (fun _ _ => 0) 1
  obtain ⟨hp, hpU, -, -⟩ := hx 0 (by norm_num)
  set p := x 0
  set Up := insert p U with hUp
  have hUpgood : ∀ s ∈ Up, T.Good s := fun s hs => by
    rcases Finset.mem_insert.1 hs with rfl | hs
    · exact hp
    · exact hU s hs
  have hcard : Up.card + 1 ≤ B := by rw [Finset.card_insert_of_notMem hpU]; omega
  have herase : Up.erase p = U := Finset.erase_insert hpU
  -- the value at `gφ` is the value of `Up` at `τ`
  have key : ∀ g : X.G, ∃ τ φ : X.G, X.chiType τ = 1 ∧ (∀ s ∈ U, X.chiBit s τ = 1) ∧
      X.chiBit p τ = Multiplicative.ofAdd 1 ∧ X.chiType φ = Multiplicative.ofAdd (T.typ p) ∧
      (∀ s ∈ U, X.chiBit s φ = Multiplicative.ofAdd (legBit p s)) ∧
      valFn X U g + valFn X U φ = valFn X Up τ := by
    intro g
    obtain ⟨τ, φ, κ0, hκ, hτt, hτb, hτp, hφt, hφb, hid⟩ :=
      X.o12 Up p (Finset.mem_insert_self _ _) hUpgood hcard g
    have hτb' : ∀ s ∈ U, X.chiBit s τ = 1 := fun s hs =>
      hτb s (Finset.mem_insert_of_mem hs) (fun h => hpU (h ▸ hs))
    have hφb' : ∀ s ∈ U, X.chiBit s φ = Multiplicative.ofAdd (legBit p s) := fun s hs =>
      hφb s (Finset.mem_insert_of_mem hs) (fun h => hpU (h ▸ hs))
    refine ⟨τ, φ, hτt, hτb', hτp, hφt, hφb', ?_⟩
    rw [herase] at hid
    have hτ0 : valFn X U τ = 0 := valFn_eq_zero_of_chars X U (hadd U) hτt hτb'
    have e1 : X.read U (X.t (g * τ * φ) (X.F U)) = valFn X U g + valFn X U φ := by
      show valFn X U (g * τ * φ) = _
      rw [hadd, hadd, hτ0, add_zero]
    have e2 : X.read U (X.t (g * φ) (X.F U)) = valFn X U g + valFn X U φ := by
      show valFn X U (g * φ) = _
      rw [hadd]
    have e3 : X.read Up (X.t (g * τ) (X.F Up)) - X.read Up (X.t g (X.F Up)) = valFn X Up τ := by
      show valFn X Up (g * τ) - valFn X Up g = _
      rw [hadd, zmod2_sub]
      generalize valFn X Up g = a
      generalize valFn X Up τ = b
      revert a b; decide
    rw [e1, e2, e3] at hid
    obtain ⟨-, k, hk⟩ := cp_sum_odd (hap p hp) hκ
    have hc : ((Cp (ap p) (-κ0) : ℤ) : ZMod 2) = ((Cp (ap p) κ0 : ℤ) : ZMod 2) + 1 := by
      have : (Cp (ap p) (-κ0) : ℤ) = 2 * k + 1 - Cp (ap p) κ0 := by linarith
      rw [this]; push_cast
      rw [show (2 : ZMod 2) = 0 from rfl, zero_mul, zero_add]
      generalize ((Cp (ap p) κ0 : ℤ) : ZMod 2) = c
      revert c; decide
    rw [hc] at hid
    rw [← hid]
    generalize ((Cp (ap p) κ0 : ℤ) : ZMod 2) = c
    generalize valFn X U g + valFn X U φ = a
    revert a c; decide
  obtain ⟨τ, φ, hτt, hτb, hτp, hφt, hφb, hg⟩ := key g
  obtain ⟨τ₁, φ₁, hτt₁, hτb₁, hτp₁, hφt₁, hφb₁, h1⟩ := key 1
  have hφ : valFn X U φ = valFn X U φ₁ :=
    valFn_congr X U (hadd U) (by rw [hφt, hφt₁]) fun s hs => by rw [hφb s hs, hφb₁ s hs]
  have hτ : valFn X Up τ = valFn X Up τ₁ :=
    valFn_congr X Up (hadd Up) (by rw [hτt, hτt₁]) fun s hs => by
      rcases Finset.mem_insert.1 hs with rfl | hs
      · rw [hτp, hτp₁]
      · rw [hτb s hs, hτb₁ s hs]
  have hv1 : valFn X U 1 = 0 := by
    have h := hadd U 1 1
    rw [mul_one] at h
    generalize valFn X U 1 = a at h
    revert a; decide
  rw [hv1, zero_add] at h1
  rw [hφ, hτ, ← h1] at hg
  generalize valFn X U g = a at hg
  generalize valFn X U φ₁ = b at hg
  revert a b; decide

/-- **Corollary: additive value functions give the zero reading below the budget** (`PROVED`). -/
theorem reading_eq_zero_of_additive (X : TraceModelRel T R ap B) (hap : ApEven T ap)
    (hadd : ∀ U g h, valFn X U (g * h) = valFn X U g + valFn X U h) {U : Finset ℕ} {q : ℕ}
    (hU : ∀ s ∈ U, T.Good s) (hq : T.Good q) (hqU : q ∉ U) (hB : U.card + 2 ≤ B) :
    R (insert q U) = 0 := by
  rw [X.reading U q hU hq hqU (by rw [Finset.card_insert_of_notMem hqU]; omega)]
  exact valFn_eq_zero_of_additive X hap hadd hU hB _

/-- **The same obstruction for corrected constituent models** (`PROVED`, through RC0's
`toTraceModelRel`): if the reduced value functions `g ↦ read_U(t(g)F_U)` of a constituent model are
additive, its reading vanishes on every set of good primes of size at most `B − 1`. -/
theorem constituent_reading_eq_zero_of_additive (X : ConstituentModelRel T R ap B)
    (hI : X.Inputs) (hap : ApEven T ap)
    (hadd : ∀ U (g h : X.G), X.readM U (X.tM (g * h) (X.FM U)) =
      X.readM U (X.tM g (X.FM U)) + X.readM U (X.tM h (X.FM U)))
    {U : Finset ℕ} {q : ℕ} (hU : ∀ s ∈ U, T.Good s) (hq : T.Good q) (hqU : q ∉ U)
    (hB : U.card + 2 ≤ B) : R (insert q U) = 0 :=
  reading_eq_zero_of_additive (X.toTraceModelRel hI) hap hadd hU hq hqU hB

end ZInQ.Contrib.CloudB3RC53.TraceWitness
