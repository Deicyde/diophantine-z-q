import ZInQKernel.Contrib.CloudB3RC53.UnramifiedComplex.Places
import ZInQKernel.Contrib.TauCeti.RepresentationTheory.Homological.ContCohomology.DimensionShifting.Basic

/-!
# UnramifiedComplex: cohomological dimension one — `Hⁿ(ℤ̂, W) = 0` for all `n ≥ 2`

Manuscript `diophantine_zq.tex`, tex 3478–3481 (the unramified complex `[Φ−1]` lives in degrees
zero and one) and 4551–4573. Completes `H2.lean` (`H² = 0` for finite `W`) to every degree, so the
two-term complex `U^ur = [W --(Φ−1)--> W]` computes the continuous cohomology of
`Gal(K_w^ur/K_w) ≃ ℤ̂` in **all** degrees.

For `G ≃ₜ* ℤ̂` (compact, totally disconnected, locally compact):

* `mem_B2_of_periodic`: the argument of `H2.lean` for a bare discrete module on which a power
  `Frob^N` acts trivially and which is killed by an integer `E` (no finiteness);
* `mem_B2_of_torsion`, `subsingleton_H2_of_torsion`: `H²(G, M) = 0` for every discrete **torsion**
  module `M`: a continuous 2-cocycle has finite image, and the subgroup generated by the
  (finite) orbits of its values is `G`-stable, fixed by a power of the Frobenius
  (`exists_pow_smul_eq`) and killed by the product of the orders of the generators;
* `isAddTorsion_coindQuotient`: `Coind_1^G M ⧸ M` is torsion when `M` is;
* `subsingleton_continuousCohomology_of_torsion`: `Hⁿ(G, M) = 0` for all `n ≥ 2` and discrete
  torsion `M`, by induction with Tau Ceti's dimension shift
  `dimensionShiftIso : Hⁿ⁺¹(G, M) ≅ Hⁿ(G, Coind_1^G M ⧸ M)` (`n ≥ 1`);
* `subsingleton_continuousCohomology_ge_two`: the same for a finite discrete representation
  `X : TopRep k G` (through `ofDiscreteModuleRestrictScalarsIntEquiv`);
* at a finite place: `ur_subsingleton_continuousCohomology_ge_two`, and the nodes
  `ZHatCohomologicalDimOne` and `UnramifiedComplexComputesCohomology`.

Kinds: everything PROVED.
-/

open CategoryTheory TauCeti.ContCohomology
noncomputable section
namespace ZInQ.Contrib.CloudB3RC53.UnramifiedComplex

variable {G : Type} [Group G] [TopologicalSpace G] [IsTopologicalGroup G]
  (e : G ≃ₜ* TauCeti.zHat.{0})
  {M : Type} [AddCommGroup M] [TopologicalSpace M] [DiscreteTopology M] [DistribMulAction G M]
  [ContinuousSMul G M]

section Recursion

variable (c : G × G → M)

/-- The primitive on powers of the Frobenius: `Ψ(0) = c(1,1)`,
`Ψ(n+1) = Ψ(n) + Frob^n • c(1,1) − c(Frob^n, Frob)`. -/
def primB : ℕ → M
  | 0 => c (1, 1)
  | n + 1 => primB n + frobElt e ^ n • c (1, 1) - c (frobElt e ^ n, frobElt e)

/-- `dΨ = c` on pairs of powers of the Frobenius. -/
theorem primB_spec (hc : groupCohomology.IsCocycle₂ c) (a b : ℕ) :
    frobElt e ^ a • primB e c b - primB e c (a + b) + primB e c a =
      c (frobElt e ^ a, frobElt e ^ b) := by
  induction b with
  | zero =>
    simp only [primB, pow_zero, add_zero, sub_add_cancel]
    exact (groupCohomology.map_one_snd_of_isCocycle₂ hc _).symm
  | succ b ih =>
    have hcoc := hc (frobElt e ^ a) (frobElt e ^ b) (frobElt e)
    rw [← pow_add, ← pow_succ] at hcoc
    rw [← add_assoc, primB, primB]
    have h2 : c (frobElt e ^ a, frobElt e ^ (b + 1)) = c (frobElt e ^ (a + b), frobElt e) +
        c (frobElt e ^ a, frobElt e ^ b) - frobElt e ^ a • c (frobElt e ^ b, frobElt e) := by
      rw [hcoc]; abel
    rw [h2, ← ih, smul_sub, smul_add, ← mul_smul, ← pow_add]
    abel

/-- One step of the period. -/
theorem primB_add (hc : groupCohomology.IsCocycle₂ c) (m R : ℕ) :
    primB e c (m + R) = primB e c m + (frobElt e ^ m • primB e c R -
      c (frobElt e ^ m, frobElt e ^ R)) := by
  have := primB_spec e c hc m R
  rw [← this]; abel

/-- Powers `Frob^{Rt}` act trivially when `Frob^R` does. -/
theorem smul_pow_mul_eqB {R : ℕ} (hR : ∀ x : M, frobElt e ^ R • x = x) (n t : ℕ) (x : M) :
    frobElt e ^ (n + R * t) • x = frobElt e ^ n • x := by
  rw [pow_add, mul_smul, pow_mul]
  congr 1
  exact MulAction.mem_stabilizer_iff.mp
    (Subgroup.pow_mem _ (MulAction.mem_stabilizer_iff.mpr (hR x)) t)

/-- `Ψ(n + Rt) = Ψ(n) + t • D(n)` with `D` the `R`-periodic increment. -/
theorem primB_add_mul (hc : groupCohomology.IsCocycle₂ c) {R : ℕ}
    (hR : ∀ x : M, frobElt e ^ R • x = x)
    (hRc : ∀ a b : ℕ, c (frobElt e ^ (a + R), frobElt e ^ b) = c (frobElt e ^ a, frobElt e ^ b))
    (n t : ℕ) :
    primB e c (n + R * t) = primB e c n + t • (frobElt e ^ n • primB e c R -
      c (frobElt e ^ n, frobElt e ^ R)) := by
  have hc' : ∀ t b : ℕ, c (frobElt e ^ (n + R * t), frobElt e ^ b) =
      c (frobElt e ^ n, frobElt e ^ b) := by
    intro t b
    induction t with
    | zero => simp
    | succ t ih => rw [Nat.mul_succ, ← add_assoc, hRc, ih]
  induction t with
  | zero => simp
  | succ t ih =>
    rw [Nat.mul_succ, ← add_assoc, primB_add e c hc, ih, smul_pow_mul_eqB e hR, hc', succ_nsmul]
    abel

/-- `Ψ` is periodic with period `R E` when `E` kills `M`. -/
theorem primB_add_period {E : ℕ} (hE : ∀ x : M, E • x = 0) (hc : groupCohomology.IsCocycle₂ c) {R : ℕ}
    (hR : ∀ x : M, frobElt e ^ R • x = x)
    (hRc : ∀ a b : ℕ, c (frobElt e ^ (a + R), frobElt e ^ b) = c (frobElt e ^ a, frobElt e ^ b))
    (n q : ℕ) : primB e c (n + R * E * q) = primB e c n := by
  have h1 : ∀ m, primB e c (m + R * E) = primB e c m := fun m => by
    rw [primB_add_mul e c hc hR hRc, hE, add_zero]
  induction q with
  | zero => simp
  | succ q ih => rw [Nat.mul_succ, ← add_assoc, h1, ih]

end Recursion

/-- `Frob^n` acts as `Frob^{n mod P}` when `Frob^P` acts trivially. -/
theorem zpow_smul_eq_valB {P : ℕ} [NeZero P] (hP : ∀ x : M, frobElt e ^ P • x = x)
    (n : ℤ) (x : M) : frobElt e ^ n • x = frobElt e ^ ((n : ZMod P).val) • x := by
  have h1 : (((n : ZMod P).val : ℕ) : ℤ) = n % (P : ℤ) := ZMod.val_intCast n
  have hq : ∀ q : ℤ, frobElt e ^ ((P : ℤ) * q) • x = x := fun q => by
    rw [zpow_mul, zpow_natCast]
    exact MulAction.mem_stabilizer_iff.mp
      (Subgroup.zpow_mem _ (MulAction.mem_stabilizer_iff.mpr (hP x)) q)
  conv_lhs => rw [← Int.emod_add_mul_ediv n P]
  rw [zpow_add, mul_smul, hq, ← h1, zpow_natCast]

include e in
/-- **A continuous `2`-cocycle of `G ≃ ℤ̂` with values in a discrete module on which `Frob^N` acts
trivially and which is killed by `E` is a continuous coboundary.** PROVED. -/
theorem mem_B2_of_periodic [CompactSpace G] [TotallyDisconnectedSpace G] {N E : ℕ} (hN0 : 0 < N)
    (hN : ∀ x : M, frobElt e ^ N • x = x) (hE0 : 0 < E) (hE : ∀ x : M, E • x = 0) (c : Z2 G M) :
    (c : G × G → M) ∈ B2 G M := by
  obtain ⟨hcont, hcoc⟩ := mem_Z2_iff.1 c.2
  obtain ⟨U, cbar, hcbar⟩ := exists_openNormalSubgroup_descendZ2 c
  have hfin : Finite (G ⧸ U.toSubgroup) := Subgroup.quotient_finite_of_isOpen _ U.isOpen'
  set Q := orderOf ((frobElt e : G) : G ⧸ U.toSubgroup) with hQdef
  have hQ0 : 0 < Q := (isOfFinOrder_of_finite _).orderOf_pos
  have hσQ : frobElt e ^ Q ∈ U.toSubgroup := by
    rw [← QuotientGroup.eq_one_iff, QuotientGroup.mk_pow, hQdef, pow_orderOf_eq_one]
  set R := Q * N with hRdef
  have hRU : ∀ t : ℕ, frobElt e ^ (R * t) ∈ U.toSubgroup := fun t => by
    rw [hRdef, mul_assoc, pow_mul]; exact Subgroup.pow_mem _ hσQ _
  have hR : ∀ x : M, frobElt e ^ R • x = x := fun x => by
    rw [hRdef, mul_comm, pow_mul]
    exact MulAction.mem_stabilizer_iff.mp
      (Subgroup.pow_mem _ (MulAction.mem_stabilizer_iff.mpr (hN x)) Q)
  have hcoset : ∀ g g' h h' : G, (g : G ⧸ U.toSubgroup) = g' → (h : G ⧸ U.toSubgroup) = h' →
      (c : G × G → M) (g, h) = (c : G × G → M) (g', h') := by
    intro g g' h h' hg hh
    rw [← hcbar, ← hcbar, hg, hh]
  have hRc : ∀ a b : ℕ, (c : G × G → M) (frobElt e ^ (a + R), frobElt e ^ b) =
      (c : G × G → M) (frobElt e ^ a, frobElt e ^ b) := fun a b => by
    refine hcoset _ _ _ _ ?_ rfl
    rw [pow_add, QuotientGroup.mk_mul_of_mem]
    simpa using hRU 1
  set P := R * E with hPdef
  have hP0 : 0 < P := Nat.mul_pos (Nat.mul_pos hQ0 hN0) hE0
  have : NeZero P := ⟨hP0.ne'⟩
  have hPU : frobElt e ^ P ∈ U.toSubgroup := by rw [hPdef]; exact hRU _
  have hPact : ∀ x : M, frobElt e ^ P • x = x := fun x => by
    rw [hPdef, pow_mul]
    exact MulAction.mem_stabilizer_iff.mp
      (Subgroup.pow_mem _ (MulAction.mem_stabilizer_iff.mpr (hR x)) _)
  have hprim_mod : ∀ m : ℕ, primB e (c : G × G → M) (m % P) = primB e (c : G × G → M) m := fun m => by
    conv_rhs => rw [← Nat.mod_add_div m P]
    rw [hPdef, primB_add_period e (c : G × G → M) hE hcoc hR hRc]
  set φ : G → M := fun g => primB e (c : G × G → M) ((chi e P g).toAdd.val) with hφdef
  have hφ : Continuous φ := (continuous_of_discreteTopology (f := fun a : Multiplicative (ZMod P) =>
    primB e (c : G × G → M) a.toAdd.val)).comp (map_continuous (chi e P))
  rw [mem_B2_iff]
  refine ⟨φ, hφ, ?_⟩
  refine ((denseRange_zpow e).prodMap (denseRange_zpow e)).equalizer (continuous_d1_apply hφ)
    hcont (funext fun p => ?_)
  obtain ⟨a, b⟩ := p
  simp only [Function.comp_apply, Prod.map_apply, d1_apply, hφdef, ← zpow_add, chi_zpow,
    toAdd_ofAdd, Int.cast_add, ZMod.val_add, hprim_mod]
  rw [zpow_smul_eq_valB e hPact a,
    hcoset (frobElt e ^ a) (frobElt e ^ ((a : ZMod P).val)) (frobElt e ^ b)
      (frobElt e ^ ((b : ZMod P).val)) (coset_zpow_eq_val e hPU a) (coset_zpow_eq_val e hPU b)]
  exact primB_spec e (c : G × G → M) hcoc _ _


section Torsion

variable [CompactSpace G]

omit [IsTopologicalGroup G] in
/-- In a compact group acting continuously on a discrete module, every orbit is finite. -/
theorem orbit_finite (m : M) : (Set.range fun g : G => g • m).Finite :=
  (isCompact_range (continuous_id.smul continuous_const)).finite_of_discrete

/-- `Frob^Q` fixes `m` for some `Q > 0` (the orbit of `m` is finite). -/
theorem exists_pow_smul_eq (m : M) : ∃ Q : ℕ, 0 < Q ∧ frobElt e ^ Q • m = m := by
  have hfin : Finite (Set.range fun g : G => g • m) := (orbit_finite m).to_subtype
  obtain ⟨a, b, hab, h⟩ := Finite.exists_ne_map_eq_of_infinite
    (fun n : ℕ => (⟨frobElt e ^ n • m, frobElt e ^ n, rfl⟩ : Set.range fun g : G => g • m))
  have h' : frobElt e ^ a • m = frobElt e ^ b • m := congrArg Subtype.val h
  have key : ∀ a b : ℕ, a < b → frobElt e ^ a • m = frobElt e ^ b • m →
      ∃ Q : ℕ, 0 < Q ∧ frobElt e ^ Q • m = m := by
    intro a b hlt hh
    refine ⟨b - a, Nat.sub_pos_of_lt hlt, ?_⟩
    have hb : b = a + (b - a) := (Nat.add_sub_cancel' hlt.le).symm
    rw [hb, pow_add, mul_smul] at hh
    exact ((smul_left_cancel_iff _).mp hh).symm
  rcases Nat.lt_or_gt_of_ne hab with hlt | hlt
  · exact key a b hlt h'
  · exact key b a hlt h'.symm

include e in
/-- **Every continuous `2`-cocycle of `G ≃ ℤ̂` with values in a discrete torsion module is a
continuous coboundary.** The cocycle has finite image; the subgroup generated by the orbits of its
values is a `G`-stable subgroup on which a power of the Frobenius acts trivially and which is
killed by an integer (`mem_B2_of_periodic`). PROVED. -/
theorem mem_B2_of_torsion [TotallyDisconnectedSpace G] (hT : IsAddTorsion M)
    (c : Z2 G M) : (c : G × G → M) ∈ B2 G M := by
  classical
  obtain ⟨hcont, hcoc⟩ := mem_Z2_iff.1 c.2
  have hRf : (Set.range (c : G × G → M)).Finite := (isCompact_range hcont).finite_of_discrete
  set S : Set M := ⋃ m ∈ Set.range (c : G × G → M), Set.range fun g : G => g • m with hS
  have hSf : S.Finite := hRf.biUnion fun m _ => orbit_finite m
  have hSG : ∀ g : G, ∀ s ∈ S, g • s ∈ S := by
    intro g s hs
    simp only [hS, Set.mem_iUnion, Set.mem_range] at hs ⊢
    obtain ⟨m, ⟨p, rfl⟩, h, rfl⟩ := hs
    exact ⟨_, ⟨p, rfl⟩, g * h, mul_smul _ _ _⟩
  set M₀ := AddSubgroup.closure S with hM₀
  have hstab : ∀ g : G, ∀ x ∈ M₀, g • x ∈ M₀ := by
    intro g x hx
    induction hx using AddSubgroup.closure_induction with
    | mem x hx => exact AddSubgroup.subset_closure (hSG g x hx)
    | zero => rw [smul_zero]; exact M₀.zero_mem
    | add x y _ _ hx hy => rw [smul_add]; exact M₀.add_mem hx hy
    | neg x _ hx => rw [smul_neg]; exact M₀.neg_mem hx
  choose Q hQ0 hQs using fun s : M => exists_pow_smul_eq e s
  set N := ∏ s ∈ hSf.toFinset, Q s with hNdef
  have hN0 : 0 < N := Finset.prod_pos fun s _ => hQ0 s
  have hNS : ∀ s ∈ S, frobElt e ^ N • s = s := by
    intro s hs
    obtain ⟨k, hk⟩ := Finset.dvd_prod_of_mem Q (hSf.mem_toFinset.mpr hs)
    rw [hNdef, hk, pow_mul]
    exact MulAction.mem_stabilizer_iff.mp
      (Subgroup.pow_mem _ (MulAction.mem_stabilizer_iff.mpr (hQs s)) k)
  have hNM : ∀ x ∈ M₀, frobElt e ^ N • x = x := by
    intro x hx
    induction hx using AddSubgroup.closure_induction with
    | mem x hx => exact hNS x hx
    | zero => exact smul_zero _
    | add x y _ _ hx hy => rw [smul_add, hx, hy]
    | neg x _ hx => rw [smul_neg, hx]
  set E := ∏ s ∈ hSf.toFinset, addOrderOf s with hEdef
  have hE0 : 0 < E := Finset.prod_pos fun s _ => (hT s).addOrderOf_pos
  have hES : ∀ s ∈ S, E • s = 0 := fun s hs =>
    addOrderOf_dvd_iff_nsmul_eq_zero.mp (Finset.dvd_prod_of_mem _ (hSf.mem_toFinset.mpr hs))
  have hEM : ∀ x ∈ M₀, E • x = 0 := by
    intro x hx
    induction hx using AddSubgroup.closure_induction with
    | mem x hx => exact hES x hx
    | zero => exact nsmul_zero _
    | add x y _ _ hx hy => rw [nsmul_add, hx, hy, add_zero]
    | neg x _ hx => rw [smul_neg, hx, neg_zero]
  let _ : DistribMulAction G M₀ :=
    { smul := fun g x => ⟨g • (x : M), hstab g x x.2⟩
      one_smul := fun x => Subtype.ext (one_smul G (x : M))
      mul_smul := fun g h x => Subtype.ext (mul_smul g h (x : M))
      smul_zero := fun g => Subtype.ext (smul_zero g)
      smul_add := fun g x y => Subtype.ext (smul_add g (x : M) y) }
  have : ContinuousSMul G M₀ := ⟨continuous_induced_rng.2
    ((continuous_smul (M := G) (X := M)).comp
      (continuous_fst.prodMk (continuous_subtype_val.comp continuous_snd)))⟩
  have hcM : ∀ p, (c : G × G → M) p ∈ M₀ := fun p => AddSubgroup.subset_closure (by
    simp only [hS, Set.mem_iUnion, Set.mem_range]
    exact ⟨_, ⟨p, rfl⟩, 1, one_smul _ _⟩)
  let c₀ : G × G → M₀ := fun p => ⟨(c : G × G → M) p, hcM p⟩
  have hc₀ : c₀ ∈ Z2 G M₀ := by
    rw [mem_Z2_iff]
    exact ⟨continuous_induced_rng.2 hcont, fun g h j => Subtype.ext (hcoc g h j)⟩
  obtain ⟨φ₀, hφ₀, hd⟩ := mem_B2_iff.1 (mem_B2_of_periodic e hN0
    (fun x => Subtype.ext (hNM x x.2)) hE0 (fun x => Subtype.ext (hEM x x.2)) ⟨c₀, hc₀⟩)
  rw [mem_B2_iff]
  refine ⟨fun g => (φ₀ g : M), continuous_subtype_val.comp hφ₀, funext fun p => ?_⟩
  exact congrArg Subtype.val (congrFun hd p)

end Torsion

section Higher

variable [CompactSpace G] [TotallyDisconnectedSpace G]

/-- `Coind_1^G M ⧸ M` is torsion when `M` is: a locally constant map on the compact group `G` has
finite image, so it is killed by the product of the orders of its values. -/
theorem isAddTorsion_coindQuotient (hT : IsAddTorsion M) :
    IsAddTorsion (CoindQuotient G ⊥ M) := by
  classical
  intro x
  induction x using CoindQuotient.induction_on with
  | h f =>
    have hfin : (Set.range ⇑f).Finite := f.isLocallyConstant.range_finite
    set E := ∏ m ∈ hfin.toFinset, addOrderOf m with hEdef
    have hE0 : 0 < E := Finset.prod_pos fun m _ => (hT m).addOrderOf_pos
    have hEf : E • f = 0 := by
      refine TauCeti.DiscreteCoind.ext fun g => ?_
      have hm : f g ∈ hfin.toFinset := hfin.mem_toFinset.mpr ⟨g, rfl⟩
      have := addOrderOf_dvd_iff_nsmul_eq_zero.mp (Finset.dvd_prod_of_mem addOrderOf hm)
      simpa [hEdef] using this
    refine isOfFinAddOrder_iff_nsmul_eq_zero.mpr ⟨E, hE0, ?_⟩
    rw [← map_nsmul, hEf, map_zero]

variable [LocallyCompactSpace G]

include e in
/-- **`H²(G, M) = 0` for discrete torsion `M`**, on Mathlib's canonical continuous cohomology. -/
theorem subsingleton_H2_of_torsion (hT : IsAddTorsion M) :
    Subsingleton (continuousCohomology 2 (TauCeti.ofDiscreteModule ℤ G M)) := by
  refine ⟨fun a b => ?_⟩
  obtain ⟨x, rfl⟩ := (explicitH2AddEquivContinuousCohomology G M).surjective a
  obtain ⟨y, rfl⟩ := (explicitH2AddEquivContinuousCohomology G M).surjective b
  have h0 : ∀ z : H2 G M, z = 0 := fun z => by
    induction z using QuotientAddGroup.induction_on with
    | H c =>
      rw [QuotientAddGroup.eq_zero_iff, AddSubgroup.mem_addSubgroupOf]
      exact mem_B2_of_torsion e hT c
  rw [h0 x, h0 y]

include e in
/-- **Cohomological dimension one of `ℤ̂` on discrete torsion modules: `Hⁿ(G, M) = 0` for all
`n ≥ 2`.** Induction by dimension shifting (Tau Ceti's `dimensionShiftIso`,
`Hⁿ⁺¹(G, M) ≅ Hⁿ(G, Coind_1^G M ⧸ M)`), the class of torsion modules being stable under
`M ↦ Coind_1^G M ⧸ M`. PROVED. -/
theorem subsingleton_continuousCohomology_of_torsion (n : ℕ) (hn : 2 ≤ n) :
    ∀ (M : Type) [AddCommGroup M] [TopologicalSpace M] [DiscreteTopology M]
      [DistribMulAction G M] [ContinuousSMul G M], IsAddTorsion M →
        Subsingleton (continuousCohomology n (TauCeti.ofDiscreteModule ℤ G M)) := by
  induction n, hn using Nat.le_induction with
  | base => intro M _ _ _ _ _ hT; exact subsingleton_H2_of_torsion e hT
  | succ n hn ih =>
    intro M _ _ _ _ _ hT
    have := ih (CoindQuotient G ⊥ M) (isAddTorsion_coindQuotient hT)
    exact (dimensionShiftIso G M n (by omega)).toContinuousLinearEquiv.injective.subsingleton

end Higher

section Rep

variable [CompactSpace G] [TotallyDisconnectedSpace G] [LocallyCompactSpace G]
  {k : Type} [Ring k] [TopologicalSpace k] (X : TopRep.{0} k G)

attribute [local instance] TopRep.distribMulAction

include e in
/-- **`Hⁿ(G, W) = 0` for all `n ≥ 2`**, `G ≃ₜ* ℤ̂` and `W` a finite discrete continuous
representation (cohomological dimension one), on Mathlib's `continuousCohomology n X`. PROVED. -/
theorem subsingleton_continuousCohomology_ge_two [DiscreteTopology X.V] [ContinuousSMul G X.V]
    [Finite X.V] (n : ℕ) (hn : 2 ≤ n) : Subsingleton (continuousCohomology n X) :=
  have := subsingleton_continuousCohomology_of_torsion e n hn X.V
    (fun x => isOfFinAddOrder_of_finite x)
  (ofDiscreteModuleRestrictScalarsIntEquiv X n).symm.injective.subsingleton

end Rep

section Places

open NumberField IsDedekindDomain ZInQ.Contrib.CloudB3RC53.RankCounts

variable (K : Type) [Field K] [NumberField K] (w : HeightOneSpectrum (𝓞 K))

attribute [local instance] TopRep.distribMulAction

/-- **`Hⁿ(Gal(K_w^ur/K_w), W) = 0` for all `n ≥ 2`** and finite discrete `W`. PROVED. -/
theorem ur_subsingleton_continuousCohomology_ge_two {k : Type} [Ring k] [TopologicalSpace k]
    (X : TopRep.{0} k (GUr K w)) [ContinuousSMul (GUr K w) X.V] [DiscreteTopology X.V]
    [Finite X.V] (n : ℕ) (hn : 2 ≤ n) : Subsingleton (continuousCohomology n X) :=
  have := locallyCompactSpace_GUr K w
  subsingleton_continuousCohomology_ge_two (eUr K w) X n hn

end Places

/-- **(PROVED) Cohomological dimension one of `ℤ̂`**: for `G ≃ₜ* ℤ̂` and every finite discrete
continuous representation `W`, `Hⁿ(G, W) = 0` for all `n ≥ 2` (Mathlib's
`continuousCohomology`). -/
def ZHatCohomologicalDimOne : Prop :=
  ∀ (G : Type) [Group G] [TopologicalSpace G] [IsTopologicalGroup G] [CompactSpace G]
    [TotallyDisconnectedSpace G] [LocallyCompactSpace G] (_ : G ≃ₜ* TauCeti.zHat.{0})
    (k : Type) [Ring k] [TopologicalSpace k] (X : TopRep.{0} k G),
    letI := TopRep.distribMulAction X
    ∀ [ContinuousSMul G X.V] [DiscreteTopology X.V] [Finite X.V] (n : ℕ), 2 ≤ n →
      Subsingleton (continuousCohomology n X)

theorem zHatCohomologicalDimOne_proof : ZHatCohomologicalDimOne :=
  fun _ _ _ _ _ _ _ e _ _ _ X _ _ _ n hn => subsingleton_continuousCohomology_ge_two e X n hn

open NumberField IsDedekindDomain ZInQ.Contrib.CloudB3RC53.RankCounts in
/-- **Tex 3478–3481 (PROVED): `U_w^ur = [W --(Φ_w−1)--> W]` computes the continuous cohomology of
`Gal(K_w^ur/K_w)` in every degree** for a finite discrete unramified module `W`: `H⁰` and `H¹`
are identified (`urH0Equiv`, `urH1Equiv`), and in every degree `n ≥ 2` both vanish. -/
def UnramifiedComplexComputesCohomology : Prop :=
  ∀ (K : Type) [Field K] [NumberField K] (w : HeightOneSpectrum (𝓞 K)) (k : Type) [Ring k]
    [TopologicalSpace k] (X : TopRep.{0} k (GUr K w)),
    letI := TopRep.distribMulAction X
    ∀ [ContinuousSMul (GUr K w) X.V] [DiscreteTopology X.V] [Finite X.V] (n : ℕ), 2 ≤ n →
      CategoryTheory.Limits.IsZero ((urCx K w X).homology (n : ℤ)) ∧
        Subsingleton (continuousCohomology n X)

theorem unramifiedComplexComputesCohomology_proof : UnramifiedComplexComputesCohomology :=
  fun K _ _ w _ _ _ X _ _ _ n hn =>
    ⟨isZero_homology _ (n : ℤ) (by omega) (by omega),
      ur_subsingleton_continuousCohomology_ge_two K w X n hn⟩

end ZInQ.Contrib.CloudB3RC53.UnramifiedComplex
