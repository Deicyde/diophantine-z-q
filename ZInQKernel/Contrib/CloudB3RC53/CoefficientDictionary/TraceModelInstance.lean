import ZInQKernel.Contrib.CloudB3RC53.CoefficientDictionary.RC12Bridge

/-!
# The coefficient dictionary, part 4: a `TraceModel` from the constituent representations

**DEPRECATED.** `ConstituentModel` is uninhabitable (`constituentModel_false`,
`RC/Wiring/TraceModelRel.lean`; same `chebotarev` defect as `TraceModel`), so `toTraceModel` and
`coefficientRules_of_constituents` are vacuous. RC0's corrected `ConstituentModelRel`
(`RC/Wiring/ConstituentModelRel.lean`) is built on the operators `tV`, `dV` of this file (still
valid; `tV_mul`, `tV_one`, `tV_conj` are used there), with `toTraceModelRel`,
`coefficientRules_of_constituentsRel` and the consistency witness `ConstituentModelRel.zero`
(`constituentModelRel_zero_exists`). Use those.

Manuscript `diophantine_zq.tex`, App F, proof of Proposition `ex:app-coefficient-rules`, the
integral trace module (tex L9641–9670, L9711–9771).

The actual trace operators of the manuscript are defined on constituents (tex L9762–9771): "On a
constituent and all its degeneracies, define `t(g)` and `d(g)` to be the scalar trace and
determinant of its two-dimensional Galois representation, acting as the identity on its
multiplicity space … they give well-defined operators on their sum.  No decomposition modulo two
… enters this construction."  They act on the finite-dimensional characteristic-zero space; the
finite integral module generated by the translates of the forms is preserved by them (tex
L9663–9669: they are Chebotarev limits of good Hecke and diamond operations), and the reduced trace
module is its reduction modulo the maximal ideal of the coefficient ring.

This file builds exactly these objects:

* the characteristic-zero space `V = I → K` (`I` the constituents with multiplicity, `K` the
  coefficient field), with the representations `ρ i : G →* GL₂(K)` of a finite joint Galois
  quotient `G`;
* `tV g`, `dV g`: the scalar trace and determinant of `ρ i g` on the `i`-th coordinate;
* the integral module `Λ ⊆ V` over the coefficient ring `O` with maximal ideal `m ∋ 2`, stable under
  all `tV g`, `dV g` (`GLUE`: Chebotarev limits of Hecke/diamond operations, tex L9663–9669);
* the reduced trace module `M = Λ / m Λ` (an `𝔽₂`-vector space since `2 ∈ m`), with the induced
  operators `t g`, `d g`.

`ConstituentModel` records these data with the remaining inputs, and `ConstituentModel.toTraceModel`
produces lane RC12-bridge's `TraceModel` (`RC12Bridge.lean`).  Fields of `TraceModel`:

* `PROVED` from the construction: `trace_mul` (RC12's `trace_mul_trace_units` on each constituent,
  then reduction), `trace_one` (`tr 1 = 2`), `t_class` (trace is a class function: RC12's GLUE field
  becomes a theorem), `level` (from the unramifiedness of the constituents of `F_U` on `N_U`).
* hypotheses of `ConstituentModel`, stated for the genuine operators:
  - `det_orbit` (`GLUE`, tex L9711–9729: the diamond formula `d(Fr_r) = r⟨r⟩` with `rψ_U(r) − 1 ∈ m`
    and the fresh-trace vanishing of the corrections): `(d(u) − 1) t(v) F_U ∈ m Λ`;
  - `two_fresh` (`INPUT`, the squarefree weight count of (O.9), tex L9741–9745):
    `t(g) t(h) F_U ∈ m Λ`;
  - `unram` (`GLUE`, the level, tex L9524–9548): every constituent in the support of `F_U` is
    trivial on `N_U`;
  - `stable_t`, `stable_d` (`GLUE`, integrality of the trace module, tex L9663–9669);
  - the Galois-theoretic `GLUE` fields `kummer`, `chi_surj`, `chebotarev`, `typ_frob`, `bit_frob`
    on `G` (as in `TraceModel`), and the `INPUT`s `reading`, `o12` (as in `TraceModel`, for the
    genuine operators).
-/

namespace ZInQ.Contrib.CloudB3RC53.CoefficientDictionary

open ZInQ.Manuscript.RC.Symbols ZInQ.Manuscript.RC.Odd Finset Matrix

/-! ## The constituent operators -/

section Operators

variable {G : Type} [Group G] {I : Type} {K : Type} [Field K]

/-- The scalar operator `v ↦ (i ↦ c i · v i)` on `V = I → K`. -/
def scalarOp (c : I → K) : (I → K) →ₗ[K] (I → K) where
  toFun v i := c i * v i
  map_add' v w := by funext i; simp [mul_add]
  map_smul' a v := by funext i; simp [mul_left_comm]

@[simp] theorem scalarOp_apply (c : I → K) (v : I → K) (i : I) : scalarOp c v i = c i * v i := rfl

/-- `t(g)`: the trace of `ρ i g` on the `i`-th constituent (tex L9762–9767). -/
def tV (ρ : I → G →* GL (Fin 2) K) (g : G) : (I → K) →ₗ[K] (I → K) :=
  scalarOp fun i => ((ρ i g : GL (Fin 2) K) : Matrix (Fin 2) (Fin 2) K).trace

/-- `d(g)`: the determinant of `ρ i g` on the `i`-th constituent. -/
def dV (ρ : I → G →* GL (Fin 2) K) (g : G) : (I → K) →ₗ[K] (I → K) :=
  scalarOp fun i => ((ρ i g : GL (Fin 2) K) : Matrix (Fin 2) (Fin 2) K).det

/-- **The trace identity on the characteristic-zero space** (tex L9734–9737), `PROVED` from RC12's
`trace_mul_trace_units`: `t(g)t(h) = t(gh) + d(h) t(gh⁻¹)`. -/
theorem tV_mul (ρ : I → G →* GL (Fin 2) K) (g h : G) (v : I → K) :
    tV ρ g (tV ρ h v) = tV ρ (g * h) v + dV ρ h (tV ρ (g * h⁻¹) v) := by
  funext i
  simp only [tV, dV, scalarOp_apply, Pi.add_apply, map_mul, map_inv, Units.val_mul]
  have := trace_mul_trace_units ((ρ i g : GL (Fin 2) K) : Matrix (Fin 2) (Fin 2) K) (ρ i h)
  rw [← mul_assoc, this]
  ring

/-- `t(1) = 2` (tex L9739). -/
theorem tV_one (ρ : I → G →* GL (Fin 2) K) (v : I → K) : tV ρ 1 v = (2 : K) • v := by
  funext i
  simp [tV]

/-- `t` is a class function. -/
theorem tV_conj (ρ : I → G →* GL (Fin 2) K) (g h : G) : tV ρ (h * g * h⁻¹) = tV ρ g := by
  apply LinearMap.ext; intro v; funext i
  simp only [tV, scalarOp_apply, map_mul, map_inv, Units.val_mul]
  rw [trace_units_conj (ρ i h)]

end Operators

/-! ## The constituent model and its `TraceModel` -/

/-- **The constituent model of the integral trace module** (tex L9641–9771; see the module
docstring for the classification of the fields). **DEPRECATED (uninhabitable; see `TraceModelRel`/`ConstituentModelRel` in `RC/Wiring/`; the theorems over it are vacuous).** -/
structure ConstituentModel {L : Type*} [AddCommGroup L] {ε : L →+ ZMod 2} (T : TypeData L ε)
    (R : Finset ℕ → ZMod 2) (ap : ℕ → ℤ) (B : ℕ) where
  /-- the finite joint Galois quotient -/
  G : Type
  [instG : Group G]
  /-- the constituents (with multiplicities and degeneracies) -/
  I : Type
  /-- the characteristic-zero coefficient field -/
  K : Type
  [instK : Field K]
  /-- the coefficient ring (valuation ring) and its maximal ideal -/
  O : Type
  [instO : CommRing O]
  [instAlg : Algebra O K]
  m : Ideal O
  two_mem : (2 : O) ∈ m
  /-- the Galois representations of the constituents -/
  ρ : I → G →* GL (Fin 2) K
  /-- the integral module generated by the translates -/
  Λ : Submodule O (I → K)
  /-- GLUE (tex L9663–9669): `Λ` is preserved by the trace operators -/
  stable_t : ∀ g, ∀ v ∈ Λ, tV ρ g v ∈ Λ
  /-- GLUE (tex L9663–9669): `Λ` is preserved by the determinant operators -/
  stable_d : ∀ g, ∀ v ∈ Λ, dV ρ g v ∈ Λ
  /-- the integral forms `F_U = θ H_U` -/
  F : Finset ℕ → Λ
  /-- the coefficient-one functionals on the reduced module -/
  read : Finset ℕ → (Λ ⧸ (m • ⊤ : Submodule O Λ)) →+ ZMod 2
  /-- Frobenius elements -/
  frob : ℕ → G
  /-- the subgroup acting trivially on the `U`-extension -/
  N : Finset ℕ → Subgroup G
  /-- the type characters -/
  chiType : G →* Multiplicative L
  /-- the character of `ℚ(√s*)` -/
  chiBit : ℕ → G →* Multiplicative (ZMod 2)
  /-- GLUE (tex L9711–9729, the diamond formula and the fresh-trace vanishing of the corrections):
  `(d(u) − 1) t(v) F_U ∈ m Λ` -/
  det_orbit : ∀ U u v, dV ρ u (tV ρ v (F U : I → K)) - tV ρ v (F U : I → K) ∈
    (m • ⊤ : Submodule O Λ).map Λ.subtype
  /-- INPUT (the squarefree weight count of (O.9), tex L9741–9745): `t(g) t(h) F_U ∈ m Λ` -/
  two_fresh : ∀ U g h, tV ρ g (tV ρ h (F U : I → K)) ∈ (m • ⊤ : Submodule O Λ).map Λ.subtype
  /-- GLUE (level, tex L9524–9548): the constituents in the support of `F_U` are trivial on `N_U` -/
  unram : ∀ U i, (F U : I → K) i ≠ 0 → ∀ n ∈ N U, ρ i n = 1
  /-- GLUE (Kummer detection of the elementary quotient) -/
  kummer : ∀ U g, chiType g = 1 → (∀ s ∈ U, chiBit s g = 1) →
    g ∈ Subgroup.closure (sqSet G) ⊔ N U
  /-- GLUE (independence of the quadratic characters) -/
  chi_surj : ∀ (U : Finset ℕ) (ℓ : L) (b : ℕ → ZMod 2), ∃ g,
    chiType g = Multiplicative.ofAdd ℓ ∧ ∀ s ∈ U, chiBit s g = Multiplicative.ofAdd (b s)
  /-- GLUE (Chebotarev) -/
  chebotarev : ∀ (g : G) (avoid : Finset ℕ), ∃ q h, T.Good q ∧ q ∉ avoid ∧ frob q = h * g * h⁻¹
  /-- GLUE (Frobenius dictionary): the type of `q` is `χ_type(Fr_q)` -/
  typ_frob : ∀ q, T.Good q → chiType (frob q) = Multiplicative.ofAdd (T.typ q)
  /-- GLUE (Frobenius dictionary): `(q/s) = χ_s(Fr_q)` -/
  bit_frob : ∀ q s, T.Good q → T.Good s → q ≠ s →
    chiBit s (frob q) = Multiplicative.ofAdd (legBit q s)

namespace ConstituentModel

variable {L : Type*} [AddCommGroup L] {ε : L →+ ZMod 2} {T : TypeData L ε}
  {R : Finset ℕ → ZMod 2} {ap : ℕ → ℤ} {B : ℕ} (X : ConstituentModel T R ap B)

attribute [instance] ConstituentModel.instG ConstituentModel.instK ConstituentModel.instO
  ConstituentModel.instAlg

/-- The reduced trace module `M = Λ / m Λ`. -/
abbrev Mred : Type := X.Λ ⧸ (X.m • ⊤ : Submodule X.O X.Λ)

theorem two_nsmul_Mred (x : X.Mred) : 2 • x = 0 := by
  induction x using Submodule.Quotient.induction_on with
  | H v =>
    show 2 • (X.m • ⊤ : Submodule X.O X.Λ).mkQ v = 0
    rw [← map_nsmul, Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero,
      ← Nat.cast_smul_eq_nsmul X.O]
    exact Submodule.smul_mem_smul (by exact_mod_cast X.two_mem) trivial

/-- The `𝔽₂`-structure of the reduced module (`2 ∈ m`). -/
abbrev modMred : Module (ZMod 2) X.Mred := AddCommGroup.zmodModule X.two_nsmul_Mred

/-- `t(g)` on `Λ`. -/
def tΛ (g : X.G) : X.Λ →ₗ[X.O] X.Λ :=
  ((tV X.ρ g).restrictScalars X.O).restrict (X.stable_t g)

/-- `d(g)` on `Λ`. -/
def dΛ (g : X.G) : X.Λ →ₗ[X.O] X.Λ :=
  ((dV X.ρ g).restrictScalars X.O).restrict (X.stable_d g)

theorem le_comap (f : X.Λ →ₗ[X.O] X.Λ) :
    (X.m • ⊤ : Submodule X.O X.Λ) ≤ (X.m • ⊤ : Submodule X.O X.Λ).comap f := by
  rw [← Submodule.map_le_iff_le_comap, Submodule.map_smul'']
  exact smul_mono_right _ le_top

/-- The reduction of an `O`-linear endomorphism of `Λ`, as an additive map of `M`. -/
def redOp (f : X.Λ →ₗ[X.O] X.Λ) : X.Mred →+ X.Mred :=
  ((X.m • ⊤ : Submodule X.O X.Λ).mapQ _ f (X.le_comap f)).toAddMonoidHom

attribute [local instance] ConstituentModel.modMred

/-- `t(g)` on the reduced trace module. -/
def tM (g : X.G) : X.Mred →ₗ[ZMod 2] X.Mred := (X.redOp (X.tΛ g)).toZModLinearMap 2

/-- `d(g)` on the reduced trace module. -/
def dM (g : X.G) : X.Mred →ₗ[ZMod 2] X.Mred := (X.redOp (X.dΛ g)).toZModLinearMap 2

/-- The reduced forms `F_U`. -/
def FM (U : Finset ℕ) : X.Mred := Submodule.Quotient.mk (X.F U)

/-- The coefficient-one functionals. -/
def readM (U : Finset ℕ) : X.Mred →ₗ[ZMod 2] ZMod 2 := (X.read U).toZModLinearMap 2

theorem tM_mk (g : X.G) (v : X.Λ) :
    X.tM g (Submodule.Quotient.mk v) = Submodule.Quotient.mk (X.tΛ g v) := rfl

theorem dM_mk (g : X.G) (v : X.Λ) :
    X.dM g (Submodule.Quotient.mk v) = Submodule.Quotient.mk (X.dΛ g v) := rfl

theorem mk_eq_zero_of_mem {w : X.Λ} (hw : (w : X.I → X.K) ∈ (X.m • ⊤ : Submodule X.O X.Λ).map X.Λ.subtype) :
    (Submodule.Quotient.mk w : X.Mred) = 0 := by
  obtain ⟨y, hy, hyw⟩ := hw
  rw [Submodule.Quotient.mk_eq_zero]
  have e : w = y := Subtype.ext hyw.symm
  rw [e]
  exact hy

/-- **`trace_mul` on the reduced module**, `PROVED` (RC12's matrix identity on each constituent). -/
theorem trace_mul (g h : X.G) (x : X.Mred) :
    X.tM g (X.tM h x) = X.tM (g * h) x + X.dM h (X.tM (g * h⁻¹) x) := by
  induction x using Submodule.Quotient.induction_on with
  | H v =>
    rw [tM_mk, tM_mk, tM_mk, tM_mk, dM_mk, ← Submodule.Quotient.mk_add]
    congr 1
    apply Subtype.ext
    exact tV_mul X.ρ g h (v : X.I → X.K)

/-- **`det_orbit` on the reduced module**, from the GLUE field `det_orbit`. -/
theorem det_orbit' (U : Finset ℕ) (u v : X.G) : X.dM u (X.tM v (X.FM U)) = X.tM v (X.FM U) := by
  rw [FM, tM_mk, dM_mk, ← sub_eq_zero, ← Submodule.Quotient.mk_sub]
  exact X.mk_eq_zero_of_mem (X.det_orbit U u v)

/-- **`two_fresh` on the reduced module**, from the INPUT field `two_fresh`. -/
theorem two_fresh' (U : Finset ℕ) (g h : X.G) : X.tM g (X.tM h (X.FM U)) = 0 := by
  rw [FM, tM_mk, tM_mk]
  exact X.mk_eq_zero_of_mem (X.two_fresh U g h)

/-- **`trace_one`**, `PROVED` (`tr 1 = 2`, `2 ∈ m`). -/
theorem trace_one (x : X.Mred) : X.tM 1 x = (2 : ZMod 2) • x := by
  rw [show (2 : ZMod 2) = 0 from rfl, zero_smul]
  induction x using Submodule.Quotient.induction_on with
  | H v =>
    rw [tM_mk]
    have e : X.tΛ 1 v = (2 : ℕ) • v := by
      apply Subtype.ext
      show tV X.ρ 1 (v : X.I → X.K) = (((2 : ℕ) • v : X.Λ) : X.I → X.K)
      rw [tV_one, two_smul]
      simp [two_nsmul]
    rw [e, ← Submodule.mkQ_apply, map_nsmul, Submodule.mkQ_apply]
    exact X.two_nsmul_Mred _

/-- **`level`**, `PROVED` from the GLUE field `unram`. -/
theorem level (U : Finset ℕ) (g n : X.G) (hn : n ∈ X.N U) :
    X.tM (g * n) (X.FM U) = X.tM g (X.FM U) := by
  rw [FM, tM_mk, tM_mk]
  congr 1
  apply Subtype.ext
  funext i
  show (tV X.ρ (g * n) (X.F U : X.I → X.K)) i = (tV X.ρ g (X.F U : X.I → X.K)) i
  by_cases h : (X.F U : X.I → X.K) i = 0
  · simp [tV, h]
  · simp [tV, map_mul, X.unram U i h n hn]

/-- **`t` is a class function**, `PROVED`. -/
theorem t_class (g h : X.G) : X.tM (h * g * h⁻¹) = X.tM g := by
  apply LinearMap.ext
  intro x
  induction x using Submodule.Quotient.induction_on with
  | H v =>
    rw [tM_mk, tM_mk]
    congr 1
    apply Subtype.ext
    show tV X.ρ (h * g * h⁻¹) (v : X.I → X.K) = tV X.ρ g v
    rw [tV_conj]

/-- **The `TraceModel` of the constituent model** (tex L9641–9771), with the two INPUTs `reading`
and `o12` of `TraceModel`, stated for the genuine reduced operators. **DEPRECATED (vacuous:
`ConstituentModel` is uninhabitable, `constituentModel_false`; use
`ConstituentModelRel.toTraceModelRel`).** -/
def toTraceModel
    (reading : ∀ (U : Finset ℕ) (q : ℕ), (∀ s ∈ U, T.Good s) → T.Good q → q ∉ U →
      (insert q U).card ≤ B → R (insert q U) = X.readM U (X.tM (X.frob q) (X.FM U)))
    (o12 : ∀ (U : Finset ℕ) (p : ℕ), p ∈ U → (∀ s ∈ U, T.Good s) → U.card + 1 ≤ B → ∀ g : X.G,
      ∃ (τ φ : X.G) (κ0 : ℤ), (κ0 = 1 ∨ κ0 = -1) ∧
        X.chiType τ = 1 ∧ (∀ s ∈ U, s ≠ p → X.chiBit s τ = 1) ∧
        X.chiBit p τ = Multiplicative.ofAdd 1 ∧
        X.chiType φ = Multiplicative.ofAdd (T.typ p) ∧
        (∀ s ∈ U, s ≠ p → X.chiBit s φ = Multiplicative.ofAdd (legBit p s)) ∧
        ((Cp (ap p) (-κ0) : ℤ) : ZMod 2) *
            X.readM (U.erase p) (X.tM (g * τ * φ) (X.FM (U.erase p))) -
          ((Cp (ap p) κ0 : ℤ) : ZMod 2) * X.readM (U.erase p) (X.tM (g * φ) (X.FM (U.erase p))) =
        X.readM U (X.tM (g * τ) (X.FM U)) - X.readM U (X.tM g (X.FM U))) :
    TraceModel T R ap B where
  G := X.G
  M := X.Mred
  instMod := X.modMred
  t := X.tM
  d := X.dM
  F := X.FM
  read := X.readM
  frob := X.frob
  N := X.N
  chiType := X.chiType
  chiBit := X.chiBit
  trace_mul := X.trace_mul
  det_orbit := X.det_orbit'
  two_fresh := X.two_fresh'
  trace_one := X.trace_one
  level := X.level
  kummer := X.kummer
  chi_surj := X.chi_surj
  chebotarev := X.chebotarev
  t_class := X.t_class
  typ_frob := X.typ_frob
  bit_frob := X.bit_frob
  reading := reading
  o12 := o12

end ConstituentModel

/-- **RC2's coefficient rules from constituent models** (the even source: a model at every budget,
with its `reading` and `o12` inputs). **DEPRECATED (vacuous: `ConstituentModel` is
uninhabitable; use `coefficientRules_of_constituentsRel`).** -/
theorem coefficientRules_of_constituents {L : Type*} [AddCommGroup L] {ε : L →+ ZMod 2}
    {T : TypeData L ε} {R : Finset ℕ → ZMod 2} {ap : ℕ → ℤ}
    (X : ∀ B, ConstituentModel T R ap B)
    (reading : ∀ B (U : Finset ℕ) (q : ℕ), (∀ s ∈ U, T.Good s) → T.Good q → q ∉ U →
      (insert q U).card ≤ B →
        R (insert q U) = (X B).readM U ((X B).tM ((X B).frob q) ((X B).FM U)))
    (o12 : ∀ B (U : Finset ℕ) (p : ℕ), p ∈ U → (∀ s ∈ U, T.Good s) → U.card + 1 ≤ B →
      ∀ g : (X B).G,
      ∃ (τ φ : (X B).G) (κ0 : ℤ), (κ0 = 1 ∨ κ0 = -1) ∧
        (X B).chiType τ = 1 ∧ (∀ s ∈ U, s ≠ p → (X B).chiBit s τ = 1) ∧
        (X B).chiBit p τ = Multiplicative.ofAdd 1 ∧
        (X B).chiType φ = Multiplicative.ofAdd (T.typ p) ∧
        (∀ s ∈ U, s ≠ p → (X B).chiBit s φ = Multiplicative.ofAdd (legBit p s)) ∧
        ((Cp (ap p) (-κ0) : ℤ) : ZMod 2) *
            (X B).readM (U.erase p) ((X B).tM (g * τ * φ) ((X B).FM (U.erase p))) -
          ((Cp (ap p) κ0 : ℤ) : ZMod 2) *
            (X B).readM (U.erase p) ((X B).tM (g * φ) ((X B).FM (U.erase p))) =
        (X B).readM U ((X B).tM (g * τ) ((X B).FM U)) - (X B).readM U ((X B).tM g ((X B).FM U)))
    (hap : ApEven T ap) : CoefficientRules ε (symb T R) :=
  coefficientRules_of_model (fun B => (X B).toTraceModel (reading B) (o12 B)) hap

end ZInQ.Contrib.CloudB3RC53.CoefficientDictionary
