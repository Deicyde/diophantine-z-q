import ZInQKernel.Contrib.CloudB3RC53.SwitchInputs.DerivativeAssembly
import ZInQKernel.Contrib.CloudB3RC53.TameQuotient.QuadraticCoordinates
import ZInQKernel.Contrib.CloudB3RC53.GenuineInst.UrFactorization

/-!
# RC53 SwitchInputs: the tame coordinates with trivial coefficients, and the finite side as the
unramified condition

Manuscript `diophantine_zq.tex`, tex L5027–5037 (the finite and singular planes at an inert
derivative prime) and tex L3478–3487 (the unramified complex `[Φ − 1]`).

**(a) Tame coordinates.** `DerivativeAssembly.lean`'s GLUE `TameCoordinates I φ σ` only asks that
`φ` and `σ` act trivially on `M`; with a nontrivial (wild) action of the rest of `G` the coordinate
map `[z] ↦ (z(φ), z(σ))` need not be bijective. Here:

* `TameCharacterCoordinates G I φ σ` — **the tame-quotient statement at level two**: `σ ∈ I`, the
  continuous characters `χ : G → 𝔽₂` are classified by `(χ(φ), χ(σ)) ∈ 𝔽₂²`, and `χ(σ) = 0` forces
  `χ|_I = 0`. For a local Galois group with residue characteristic `p ≠ 2` this is the statement
  that `Hom_cont(G, 𝔽₂) = Hom(G/P G², 𝔽₂)` for the tame quotient `G/P = ⟨φ, σ | φσφ⁻¹ = σ^q⟩` (`P`
  wild inertia, pro-`p`, so invisible to `𝔽₂`; `I/P` procyclic generated by `σ`): the abelianization
  mod `2` of the tame quotient is `𝔽₂²` with basis dual to `(φ, σ)` (`q` odd). It is exactly the
  form in which the tame-model work (`TameModelQIso`, the tame model of the local complex) can
  discharge it in general; at present it is discharged from the clearing author's
  `TameQuotient.exists_tame_coordinates`.
* `TameCoordinatesTrivial I φ σ r` — **the strengthened GLUE**: `G` acts trivially on `M`,
  `M ≅ 𝔽₂^r`, and `TameCharacterCoordinates`.
* `tameCoordinates_of_trivial` (PROVED): it implies the old `TameCoordinates` (coordinatewise: for
  the trivial action a `1`-cocycle is a continuous character in each coordinate).
* `tameCoordinatesTrivial_galois` (PROVED): **discharged** for `G = G_K` of a nonarchimedean local
  field with `p ≠ 2`, `I = I_K`, `M = 𝔽₂^r` with the trivial action, a Frobenius lift `φ` and a tame
  generator `σ`.
* `galois_planes` (PROVED): in this genuine setting (`r = 2`) the coordinates
  `H¹(W_rel) ≃ k² × k²` send the finite side to `finPlane` and the singular side to `singPlane`.

**(b) The finite side is the unramified condition.** For a continuous surjective open
`π : G → H` with kernel `I` and `H ≃ ℤ̂` (`G = G_{K_w}`, `H = Gal(K_w^ur/K_w)`), trivial actions and
`f : W ≃ M`:

* `finiteSide_BF_iff_ur` (PROVED): a `1`-cocycle lies in the finite side `B_F` (vanishes on `I`) iff
  it is the inflation `g ↦ f (c_x (π g))` of the unramified cocycle `c_x` of some `x ∈ W` — i.e. iff
  it is the degree-one value `urLin₁ e π X f x` of the other team's unramified condition
  `urToLocal` (`finiteSide_BF_iff_urLin₁`). By `GenuineInst.urToLocal_eq_urSelf_comp`
  (UrFactorization) `urToLocal = urSelf ≫ infl` with `urSelf` the quasi-isomorphism
  `[W --(Φ−1)--> W] ≃_qis C^•_cont(H, W)` (`urSelf_galois_quasiIso`), so **the finite side's
  cocycles are exactly the inflations of the images of the quasi-isomorphism `urSelf`** (identified
  as subspaces of `Z¹(G, M)`).

**Caveat (residue field `𝔽₂`).** The genuine instances in this file are specialised to the residue
field `𝔽₂`. They are not applicable at the height-one primes `𝔭 ≠ (2)` of `Λ` where the switching
runs (tex L4976: `R = Λ_𝔭`, residue field of characteristic `0`): there is no ring map
`Λ_𝔭 → ZMod 2` (`isEmpty_ringHom_zmod_two_heightOne`). See `GaloisWiringQuad.lean` for the
field-generic version.
-/

noncomputable section

namespace ZInQ.Contrib.CloudB3RC53.SwitchInputs

open CategoryTheory ZInQ.Contrib.CloudB3RC53.GenuineInst ZInQ.Manuscript.RC.SelmerComplex
  ZInQ.Manuscript.RC.Uniform ZInQ.Contrib.CloudB3RC53.UnramifiedComplex ValuativeRel

/-! ### (a) Tame coordinates with trivial coefficients -/

section Tame

/-- **The tame-quotient statement at level two** (tex L5027–5037): `σ ∈ I`; the continuous
characters `G → 𝔽₂` are classified by their values at `φ` and `σ`; and a character vanishing at `σ`
vanishes on `I`. (For a local Galois group, `p ≠ 2`: the mod-`2` abelianization of the tame quotient
`⟨φ, σ | φσφ⁻¹ = σ^q⟩` is `𝔽₂²`, wild inertia being pro-`p`.) -/
def TameCharacterCoordinates (G : Type) [Group G] [TopologicalSpace G] (I : Subgroup G)
    (φ σ : G) : Prop :=
  σ ∈ I ∧
    Function.Bijective (fun z : {z : G → ZMod 2 // Continuous z ∧ ∀ g h, z (g * h) = z g + z h} =>
      (z.1 φ, z.1 σ)) ∧
    ∀ z : G → ZMod 2, Continuous z → (∀ g h, z (g * h) = z g + z h) → z σ = 0 →
      ∀ g ∈ I, z g = 0

variable {G : Type} [Group G] [TopologicalSpace G] [IsTopologicalGroup G]
  {M : Type} [AddCommGroup M] [Module (ZMod 2) M] [DistribMulAction G M]
  [SMulCommClass G (ZMod 2) M] [TopologicalSpace M] [DiscreteTopology M] [ContinuousSMul G M]

/-- **GLUE (strengthened): tame coordinates with trivial coefficients** (tex L5027–5037): `G` acts
trivially on `M ≅ 𝔽₂^r`, and the tame-quotient statement `TameCharacterCoordinates` holds.
Classification: GLUE (discharged at local Galois groups, `tameCoordinatesTrivial_galois`). -/
structure TameCoordinatesTrivial (I : Subgroup G) (φ σ : G) (r : ℕ) : Prop where
  htriv : ∀ (g : G) (m : M), g • m = m
  hM : Nonempty (M ≃ₗ[ZMod 2] (Fin r → ZMod 2))
  hchar : TameCharacterCoordinates G I φ σ

/-- A `1`-cochain is continuous as a function on `G`. -/
theorem continuous_ev1 (z : (contCochains (ZMod 2) G M).X 1) : Continuous (ev1 z) :=
  (mem_contCochain.mp ((contSubCx (ZMod 2) G M).el z).2).comp
    (continuous_pi fun _ => continuous_id)

/-- With the trivial action, `z(1) = 0`. -/
theorem ev1_one_of_trivial (htriv : ∀ (g : G) (m : M), g • m = m) (z : Z1 G M) :
    ev1 (z : (contCochains (ZMod 2) G M).X 1) 1 = 0 := by
  have := ev1_mul_of_trivial htriv z 1 1
  rw [one_mul] at this
  have h' : ev1 (z : (contCochains (ZMod 2) G M).X 1) 1 + ev1 (z : (contCochains (ZMod 2) G M).X 1) 1 =
      ev1 (z : (contCochains (ZMod 2) G M).X 1) 1 + 0 := by rw [add_zero]; exact this.symm
  exact add_left_cancel h'

/-- The `i`-th coordinate character of a cocycle (trivial action). -/
def coordChar {r : ℕ} (htriv : ∀ (g : G) (m : M), g • m = m) (eM : M ≃ₗ[ZMod 2] (Fin r → ZMod 2))
    (z : Z1 G M) (i : Fin r) :
    {χ : G → ZMod 2 // Continuous χ ∧ ∀ g h, χ (g * h) = χ g + χ h} :=
  ⟨fun g => eM (ev1 (z : (contCochains (ZMod 2) G M).X 1) g) i,
    (continuous_apply i).comp ((continuous_of_discreteTopology (f := eM)).comp (continuous_ev1 _)),
    fun g h => by
      simp only
      rw [ev1_mul_of_trivial htriv z g h, map_add, Pi.add_apply]⟩

/-- **The strengthened tame coordinates imply the old ones** (tex L5027–5037). PROVED. -/
theorem tameCoordinates_of_trivial {I : Subgroup G} {φ σ : G} {r : ℕ}
    (T : TameCoordinatesTrivial (M := M) I φ σ r) : TameCoordinates (M := M) I φ σ := by
  obtain ⟨eM⟩ := T.hM
  obtain ⟨hσI, hbij, hI⟩ := T.hchar
  have hvan : ∀ z : Z1 G M, (∀ g, ev1 (z : (contCochains (ZMod 2) G M).X 1) g = 0) → z = 0 := by
    intro z hz
    apply Subtype.ext
    apply Subtype.ext
    funext x
    have hx : x = fun _ => x 0 := by funext i; fin_cases i; rfl
    rw [hx]
    exact hz (x 0)
  refine ⟨T.htriv φ, T.htriv σ, hσI, ⟨?_, ?_⟩, ?_⟩
  · rw [← LinearMap.ker_eq_bot, eq_bot_iff]
    intro y hy
    induction y using Submodule.Quotient.induction_on with
    | H z =>
      rw [LinearMap.mem_ker, coordQ_mk, Prod.mk_eq_zero] at hy
      have hz : z = 0 := by
        apply hvan
        intro g
        apply eM.injective
        rw [map_zero]
        funext i
        let z0 : {χ : G → ZMod 2 // Continuous χ ∧ ∀ g h, χ (g * h) = χ g + χ h} :=
          ⟨fun _ => 0, continuous_const, fun _ _ => by simp⟩
        have hc : coordChar T.htriv eM z i = z0 := hbij.1 (by
          simp only [coordChar, z0, hy.1, hy.2, map_zero, Pi.zero_apply])
        exact congrFun (congrArg Subtype.val hc) g
      rw [hz, Submodule.mem_bot, Submodule.Quotient.mk_zero]
  · rintro ⟨m₁, m₂⟩
    choose c hc using fun i : Fin r => hbij.2 (eM m₁ i, eM m₂ i)
    let F : G → M := fun g => eM.symm (fun i => (c i).1 g)
    have hFc : Continuous F :=
      (continuous_of_discreteTopology (f := eM.symm)).comp (continuous_pi fun i => (c i).2.1)
    let cF : (contCochains (ZMod 2) G M).X 1 :=
      ⟨(fun x => F (x 0) : (groupCohomology.inhomogeneousCochains (rep (ZMod 2) G M)).X 1),
        mem_contCochain.mpr (hFc.comp (continuous_apply 0))⟩
    have hev : ∀ g, ev1 cF g = F g := fun g => rfl
    have hZ : cF ∈ Z1 G M := mem_Z1_of_additive T.htriv cF (fun g h => by
      rw [hev, hev, hev]
      simp only [F]
      rw [← map_add]
      congr 1
      funext i
      exact (c i).2.2 g h)
    refine ⟨Submodule.Quotient.mk ⟨cF, hZ⟩, ?_⟩
    rw [coordQ_mk]
    simp only [hev, F]
    refine Prod.ext ?_ ?_
    · show eM.symm (fun i => (c i).1 φ) = m₁
      rw [eM.symm_apply_eq]
      funext i
      exact congrArg Prod.fst (hc i)
    · show eM.symm (fun i => (c i).1 σ) = m₂
      rw [eM.symm_apply_eq]
      funext i
      exact congrArg Prod.snd (hc i)
  · intro z hz h hh
    apply eM.injective
    rw [map_zero]
    funext i
    exact hI (coordChar T.htriv eM z i).1 (coordChar T.htriv eM z i).2.1
      (coordChar T.htriv eM z i).2.2 (by simp only [coordChar, hz, map_zero, Pi.zero_apply]) h hh

end Tame

/-! ### Discharge at a local Galois group (`p ≠ 2`) -/

section Galois

/-- `𝔽₂^r` with the trivial action of `G_K`. -/
abbrev GalM (K : Type) [Field K] (r : ℕ) : Type :=
  TrivMod (Field.absoluteGaloisGroup K) (Fin r → ZMod 2)

/-- The identification `TrivMod G V ≃ V`. -/
def trivModEquiv (G V : Type) [Group G] [AddCommGroup V] [Module (ZMod 2) V] :
    TrivMod G V ≃ₗ[ZMod 2] V where
  toFun m := m
  invFun m := m
  map_add' _ _ := rfl
  map_smul' _ _ := rfl
  left_inv _ := rfl
  right_inv _ := rfl

variable (K : Type) [Field K] [ValuativeRel K] [TopologicalSpace K] [IsNonarchimedeanLocalField K]

/-- **The strengthened tame coordinates hold at a local Galois group** (tex L5027–5037): for a
nonarchimedean local field `K` with residue characteristic `p ≠ 2` there are a Frobenius lift `φ`
and a tame generator `σ ∈ I_K` such that `TameCoordinatesTrivial I_K φ σ r` holds for `𝔽₂^r` with
the trivial action, every `r`. PROVED (from `TameQuotient.exists_tame_coordinates`). Residual-field
(`𝔽₂`) instance only; not applicable at height-one primes `≠ (2)`, see
`isEmpty_ringHom_zmod_two_heightOne`; the characteristic-zero version is the field-generic chain. -/
theorem tameCoordinatesTrivial_galois (hp : ringChar 𝓀[K] ≠ 2) (r : ℕ) :
    ∃ φ σ : Field.absoluteGaloisGroup K, TauCeti.IsArithFrobeniusLift K φ ∧
      σ ∈ TauCeti.inertiaSubgroup K ∧
      TameCoordinatesTrivial (G := Field.absoluteGaloisGroup K) (M := GalM K r)
        (TauCeti.inertiaSubgroup K) φ σ r := by
  obtain ⟨φ, σ, hφ, hσ, hbij, hI⟩ := TameQuotient.exists_tame_coordinates (K := K) hp
  exact ⟨φ, σ, hφ, hσ, ⟨fun _ _ => rfl, ⟨trivModEquiv _ _⟩, hσ, hbij, hI⟩⟩

/-- **The genuine planes** (tex L5027–5037, L5060–5082): at a local Galois group with `p ≠ 2` and
`M = 𝔽₂²` (trivial action), the tame coordinates `H¹(W_rel) ≃ k² × k²` send the finite side
(cocycles vanishing on `I_K`) to `finPlane` and the singular side (`z(φ) = 0`) to `singPlane`, and
both sides have the quasi-side homology. PROVED. Residual-field (`𝔽₂`) instance only; not applicable
at height-one primes `≠ (2)`, see `isEmpty_ringHom_zmod_two_heightOne`; the characteristic-zero
version is the field-generic chain. -/
theorem galois_planes (hp : ringChar 𝓀[K] ≠ 2) :
    ∃ φ σ : Field.absoluteGaloisGroup K, TauCeti.IsArithFrobeniusLift K φ ∧
      σ ∈ TauCeti.inertiaSubgroup K ∧
      ∃ T : TameCoordinates (M := GalM K 2) (TauCeti.inertiaSubgroup K) φ σ,
        (LinearMap.range (finiteSide (M := GalM K 2) (TauCeti.inertiaSubgroup K)).H1i).map
            (coordEquiv T (trivModEquiv _ _)).toLinearMap =
          finPlane (ZMod 2) (Fin 2 → ZMod 2) (Fin 2 → ZMod 2) ∧
        (LinearMap.range (singularSide (M := GalM K 2) φ).H1i).map
            (coordEquiv T (trivModEquiv _ _)).toLinearMap =
          singPlane (ZMod 2) (Fin 2 → ZMod 2) (Fin 2 → ZMod 2) ∧
        SideQuotientsGenuine (finiteSide (M := GalM K 2) (TauCeti.inertiaSubgroup K)) ∧
        SideQuotientsGenuine (singularSide (M := GalM K 2) φ) := by
  obtain ⟨φ, σ, hφ, hσ, T⟩ := tameCoordinatesTrivial_galois K hp 2
  have T' := tameCoordinates_of_trivial T
  exact ⟨φ, σ, hφ, hσ, T', finite_plane T' _, singular_plane T' _,
    (derivativeSides_quotients (M := GalM K 2) (TauCeti.inertiaSubgroup K) φ).1,
    (derivativeSides_quotients (M := GalM K 2) (TauCeti.inertiaSubgroup K) φ).2⟩

end Galois

/-! ### (b) The finite side is the unramified condition -/

section Unramified

attribute [local instance] TopRep.distribMulAction TopRep.smulCommClass

variable {G : Type} [Group G] [TopologicalSpace G] [IsTopologicalGroup G]
  {M : Type} [AddCommGroup M] [Module (ZMod 2) M] [DistribMulAction G M]
  [SMulCommClass G (ZMod 2) M] [TopologicalSpace M] [DiscreteTopology M] [ContinuousSMul G M]
  {H : Type} [Group H] [TopologicalSpace H] [IsTopologicalGroup H]
  (e : H ≃ₜ* TauCeti.zHat.{0}) (π : G →ₜ* H) (X : TopRep.{0} (ZMod 2) H)
  [ContinuousSMul H X.V] [DiscreteTopology X.V] [Finite X.V]

theorem urCocycle_one (x : X.V) : urCocycle e X x 1 = 0 := by
  have h := urCocycle_cocycle e X x 1 1
  rw [one_mul, one_smul] at h
  have h' : urCocycle e X x 1 + urCocycle e X x 1 = urCocycle e X x 1 + 0 := by
    rw [add_zero]; exact h.symm
  exact add_left_cancel h'

theorem urCocycle_mul_of_trivial (hX : ∀ (h : H) (x : X.V), h • x = x) (x : X.V) (a b : H) :
    urCocycle e X x (a * b) = urCocycle e X x a + urCocycle e X x b := by
  rw [urCocycle_cocycle, hX, add_comm]

/-- **The finite side is the unramified condition** (tex L3478–3487, L5057–5058). Let
`π : G → H` be a continuous surjective open homomorphism with kernel `I`, `H ≃ ℤ̂`, the actions on
`M` and on `W = X.V` trivial, and `f : W ≃ M`. Then a `1`-cocycle `z` lies in the finite side
(vanishes on `I`) iff it is the inflation `g ↦ f (c_x (π g))` of the unramified cocycle `c_x` of
some `x ∈ W`. PROVED. -/
theorem finiteSide_BF_iff_ur (I : Subgroup G) (hπs : Function.Surjective π) (hπo : IsOpenMap π)
    (hker : ∀ g, π g = 1 ↔ g ∈ I) (hX : ∀ (h : H) (x : X.V), h • x = x)
    (htriv : ∀ (g : G) (m : M), g • m = m) (f : X.V ≃ₗ[ZMod 2] M) (z : Z1 G M) :
    z ∈ (finiteSide (M := M) I).BF ↔
      ∃ x : X.V, ∀ g, ev1 (z : (contCochains (ZMod 2) G M).X 1) g = f (urCocycle e X x (π g)) := by
  rw [finiteSide, mem_sideOfSet_BF]
  constructor
  · intro hz
    obtain ⟨φ₀, hφ₀⟩ := hπs (frobElt e)
    set x : X.V := f.symm (ev1 (z : (contCochains (ZMod 2) G M).X 1) φ₀) with hxdef
    set D : G → M := fun g =>
      ev1 (z : (contCochains (ZMod 2) G M).X 1) g - f (urCocycle e X x (π g)) with hD
    have hadd : ∀ a b, D (a * b) = D a + D b := by
      intro a b
      simp only [hD, ev1_mul_of_trivial htriv z a b, map_mul, urCocycle_mul_of_trivial e X hX,
        map_add]
      abel
    have h1 : D 1 = 0 := by
      simp only [hD, ev1_one_of_trivial htriv z, map_one, urCocycle_one, map_zero, sub_zero]
    let N : Subgroup G :=
      { carrier := {g | D g = 0}
        one_mem' := h1
        mul_mem' := fun {a b} (ha : D a = 0) (hb : D b = 0) =>
          show D (a * b) = 0 by rw [hadd, ha, hb, add_zero]
        inv_mem' := fun {a} (ha : D a = 0) => by
          show D a⁻¹ = 0
          have := hadd a⁻¹ a
          rw [inv_mul_cancel, h1, ha, add_zero] at this
          exact this.symm }
    have hDc : Continuous D :=
      (continuous_ev1 _).sub ((continuous_of_discreteTopology (f := f)).comp
        ((urCocycle_continuous e X x).comp (map_continuous π)))
    have hNc : IsClosed (N : Set G) := isClosed_eq hDc continuous_const
    have hIN : I ≤ N := by
      intro g hg
      show D g = 0
      simp only [hD, hz g hg, (hker g).mpr hg, urCocycle_one, map_zero, sub_zero]
    have hφN : φ₀ ∈ N := by
      show D φ₀ = 0
      simp only [hD, hφ₀, urCocycle_frob, hxdef, LinearEquiv.apply_symm_apply, sub_self]
    have hsub : π ⁻¹' (Subgroup.closure {frobElt e} : Set H) ⊆ N := by
      intro g hg
      rw [Set.mem_preimage, SetLike.mem_coe, ← Subgroup.zpowers_eq_closure] at hg
      obtain ⟨n, hn⟩ := Subgroup.mem_zpowers_iff.mp hg
      have hi : φ₀ ^ (-n) * g ∈ I := by
        rw [← hker, map_mul, map_zpow, hφ₀, ← hn, ← zpow_add, neg_add_cancel, zpow_zero]
      have : g = φ₀ ^ n * (φ₀ ^ (-n) * g) := by
        rw [← mul_assoc, ← zpow_add, add_neg_cancel, zpow_zero, one_mul]
      rw [this]
      exact N.mul_mem (N.zpow_mem hφN n) (hIN hi)
    have hdense : Dense (Subgroup.closure {frobElt e} : Set H) := by
      rw [dense_iff_closure_eq, ← Subgroup.topologicalClosure_coe, closure_frob_eq_top e,
        Subgroup.coe_top]
    have hall : ∀ g, g ∈ N := by
      intro g
      have hcl := (hdense.preimage hπo).closure_eq
      have : g ∈ closure (π ⁻¹' (Subgroup.closure {frobElt e} : Set H)) := by
        rw [hcl]; exact Set.mem_univ g
      exact closure_minimal hsub hNc this
    exact ⟨x, fun g => sub_eq_zero.mp (hall g)⟩
  · rintro ⟨x, hx⟩ h hh
    rw [hx, (hker h).mpr hh, urCocycle_one, map_zero]

/-- **The finite side is the image of the unramified condition in degree one**: a cocycle lies in
the finite side iff its underlying continuous cochain is `urLin₁ e π X f x` (the degree-one
component of the other team's `urToLocal e π X f`, which factors as `urSelf ≫ infl` by
`GenuineInst.urToLocal_eq_urSelf_comp`, with `urSelf` the quasi-isomorphism of
`urSelf_galois_quasiIso`). PROVED. -/
theorem finiteSide_BF_iff_urLin₁ (I : Subgroup G) (hπs : Function.Surjective π)
    (hπo : IsOpenMap π) (hker : ∀ g, π g = 1 ↔ g ∈ I) (hX : ∀ (h : H) (x : X.V), h • x = x)
    (htriv : ∀ (g : G) (m : M), g • m = m) (f : X.V ≃ₗ[ZMod 2] M) (z : Z1 G M) :
    z ∈ (finiteSide (M := M) I).BF ↔
      ∃ x : X.V, ∀ g : Fin 1 → G,
        asFun (ZMod 2) G M (((contSubCx (ZMod 2) G M).el (z : (contCochains (ZMod 2) G M).X 1) :
            contCochain (ZMod 2) G M 1) :
          (groupCohomology.inhomogeneousCochains (rep (ZMod 2) G M)).X 1) g =
        asFun (ZMod 2) G M ((urLin₁ e π X f.toLinearMap x : contCochain (ZMod 2) G M 1) :
          (groupCohomology.inhomogeneousCochains (rep (ZMod 2) G M)).X 1) g := by
  rw [finiteSide_BF_iff_ur e π X I hπs hπo hker hX htriv f z]
  constructor
  · rintro ⟨x, hx⟩
    refine ⟨x, fun g => ?_⟩
    have hg : g = fun _ => g 0 := by funext i; fin_cases i; rfl
    rw [hg]
    exact hx (g 0)
  · rintro ⟨x, hx⟩
    exact ⟨x, fun g => hx (fun _ => g)⟩

end Unramified

/-! ### Non-vacuity of (b): `G = H = ℤ̂`, `π = id`, `I = 1`, trivial `𝔽₂` -/

section ExampleUr

attribute [local instance] TopRep.distribMulAction TopRep.smulCommClass

/-- `ℤ̂` as a type. -/
abbrev ZHat : Type := TauCeti.zHat.{0}

/-- The trivial representation of `ℤ̂` on `𝔽₂`. -/
abbrev exXur : TopRep (ZMod 2) ZHat := TopRep.of (ContRepresentation.trivial (ZMod 2) ZHat (ZMod 2))

instance exXurAction : DistribMulAction ZHat exXur.V := TopRep.distribMulAction exXur
instance exXurComm : SMulCommClass ZHat (ZMod 2) exXur.V := TopRep.smulCommClass exXur
instance : DiscreteTopology exXur.V := inferInstanceAs (DiscreteTopology (ZMod 2))
instance : Finite exXur.V := inferInstanceAs (Finite (ZMod 2))
instance : ContinuousSMul ZHat exXur.V := ⟨continuous_snd⟩

/-- `W = 𝔽₂ ≃ M = 𝔽₂` (trivial `ℤ̂`-module). -/
def exFur : exXur.V ≃ₗ[ZMod 2] TrivMod ZHat (ZMod 2) := (trivModEquiv ZHat (ZMod 2)).symm

/-- **Non-vacuity of `finiteSide_BF_iff_ur`**: for `G = H = ℤ̂`, `π = id`, `I = 1` and trivial
`𝔽₂` coefficients, all hypotheses hold, so every cocycle is the inflation of an unramified cocycle.
PROVED. -/
theorem exFiniteSide_ur (z : Z1 ZHat (TrivMod ZHat (ZMod 2))) :
    z ∈ (finiteSide (M := TrivMod ZHat (ZMod 2)) ⊥).BF ↔
      ∃ x : exXur.V, ∀ g, ev1 (z : (contCochains (ZMod 2) ZHat (TrivMod ZHat (ZMod 2))).X 1) g =
        exFur (urCocycle (ContinuousMulEquiv.refl ZHat) exXur x (ContinuousMonoidHom.id ZHat g)) :=
  finiteSide_BF_iff_ur (ContinuousMulEquiv.refl ZHat) (ContinuousMonoidHom.id ZHat) exXur ⊥
    (fun g => ⟨g, rfl⟩) IsOpenMap.id (fun g => by simp [Subgroup.mem_bot]) (fun _ _ => rfl)
    (fun _ _ => rfl) exFur z

end ExampleUr

