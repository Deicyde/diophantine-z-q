import ZInQKernel.Contrib.CloudB3RC53.SwitchInputs.DerivativeSides

/-!
# RC53 SwitchInputs: the finite and singular derivative sides on the genuine cochains; coordinates

Manuscript `diophantine_zq.tex`, tex L5027–5037 and L5060–5082: at a new inert derivative prime the
local conditions are `D⁰ ⊂ D⁰ ⊕ F[−1], D⁰ ⊕ S[−1] ⊂ D⁰ ⊕ (F ⊕ S)[−1]`, with `F` the finite
(unramified) plane and `S` the singular plane. `DerivativeSides.lean` proved the local homology
facts of the quotient complexes for an abstract side condition `SideCond` (`A_F`, `B_F`, `hcob`).

This file instantiates the sides on the genuine continuous cochains `C^•_cont(G, M)` of the other
team's lane:

* `ev0`, `ev1`: reading a `0`-cochain as an element of `M` and a `1`-cochain at `g ∈ G`;
  `relaxedD_ev`: `(d⁰a)(g) = g • a − a` (PROVED).
* `sideOfSet T` (PROVED): for a set `T ⊆ G`, the side condition `A = M^T` (invariants of `T`),
  `B = {z ∈ Z¹ | z(h) = 0 for h ∈ T}`; `hcob` holds because `(d⁰a)(h) = h • a − a`.
  - `finiteSide I = sideOfSet I` for the inertia subgroup `I`: cocycles vanishing on inertia (the
    unramified cocycles), `A_F = M^I` — **the finite side, with `hcob` proved**: an unramified
    coboundary `d⁰ a` comes from an inertia invariant `a`.
  - `singularSide φ = sideOfSet {φ}` for a Frobenius lift `φ`: cocycles with `z(φ) = 0`
    (LocalJ's singular coordinate `c(σ)` with `c(φ) = 0`), `A_S = M^φ`.
  - `derivativeSides_quotients` (PROVED): both sides satisfy `SideQuotientsGenuine` (`h0`, `hi`,
    `hpi` on the explicit `H¹` models).
* **Coordinates** (tex L5027–5037). `TameCoordinates I φ σ` (GLUE, the tame structure of an inert
  local Galois group with trivial `M`): `φ`, `σ` act trivially on `M`, `σ ∈ I`, the coordinate map
  `[z] ↦ (z(φ), z(σ))` is a bijection `H¹ ≅ M × M`, and a cocycle with `z(σ) = 0` vanishes on `I`
  (`Hom(I, M)` factors through the tame quotient generated by `σ`, wild inertia being pro-odd).
  Under it, `coordEquiv : H¹(W_rel) ≃ k² × k²` (with `M ≃ k²`) and `finite_plane`, `singular_plane`
  (PROVED): the image of `H¹` of the finite side is `finPlane`, that of the singular side is
  `singPlane`.

Remaining (not done here): the naturality transport of the explicit `H¹` models to `H¹` of the
induced chain maps of `dblCx` complexes, and the single-place assembly of `QuasiSwitchSide` inside
`galoisSelData` (see the lane notes).

**Caveat (residue field `𝔽₂`).** The genuine instances in this file are specialised to the residue
field `𝔽₂`. They are not applicable at the height-one primes `𝔭 ≠ (2)` of `Λ` where the switching
runs (tex L4976: `R = Λ_𝔭`, residue field of characteristic `0`): there is no ring map
`Λ_𝔭 → ZMod 2` (`isEmpty_ringHom_zmod_two_heightOne`). See `GaloisWiringQuad.lean` for the
field-generic version.
-/

noncomputable section

namespace ZInQ.Contrib.CloudB3RC53.SwitchInputs

open CategoryTheory ZInQ.Contrib.CloudB3RC53.GenuineInst ZInQ.Manuscript.RC.SelmerComplex
  ZInQ.Manuscript.RC.Uniform

section Sides

variable {G : Type} [Group G] [TopologicalSpace G] [IsTopologicalGroup G]
  {M : Type} [AddCommGroup M] [Module (ZMod 2) M] [DistribMulAction G M]
  [SMulCommClass G (ZMod 2) M] [TopologicalSpace M] [DiscreteTopology M] [ContinuousSMul G M]

/-- A `0`-cochain read as an element of `M`. -/
def ev0 (a : (contCochains (ZMod 2) G M).X 0) : M :=
  asFun (ZMod 2) G M (((contSubCx (ZMod 2) G M).el a : contCochain (ZMod 2) G M 0) :
    (groupCohomology.inhomogeneousCochains (rep (ZMod 2) G M)).X 0) Fin.elim0

/-- A `1`-cochain evaluated at `g`. -/
def ev1 (z : (contCochains (ZMod 2) G M).X 1) (g : G) : M :=
  asFun (ZMod 2) G M (((contSubCx (ZMod 2) G M).el z : contCochain (ZMod 2) G M 1) :
    (groupCohomology.inhomogeneousCochains (rep (ZMod 2) G M)).X 1) (fun _ => g)

/-- `ev0` as a linear map. -/
def ev0L : (contCochains (ZMod 2) G M).X 0 →ₗ[ZMod 2] M where
  toFun := ev0
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

/-- `ev1 · g` as a linear map. -/
def ev1L (g : G) : (contCochains (ZMod 2) G M).X 1 →ₗ[ZMod 2] M where
  toFun z := ev1 z g
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

/-- **`(d⁰a)(g) = g • a − a`**. PROVED. -/
theorem relaxedD_ev (a : (contCochains (ZMod 2) G M).X 0) (g : G) :
    ev1 ((relaxedD G M a : Z1 G M) : (contCochains (ZMod 2) G M).X 1) g = g • ev0 a - ev0 a := by
  have h := contCochains_d_apply (k := ZMod 2) (G := G) (M := M) 0 a (fun _ => g)
  have e1 : (fun i : Fin 0 => (fun _ : Fin (0 + 1) => g) i.succ) = Fin.elim0 :=
    Subsingleton.elim _ _
  have e2 : ∀ j : Fin (0 + 1), Fin.contractNth j (· * ·) (fun _ : Fin (0 + 1) => g) = Fin.elim0 :=
    fun _ => Subsingleton.elim _ _
  rw [Fin.sum_univ_succ, Fin.sum_univ_zero, add_zero] at h
  simp only [e1, e2, Fin.val_zero, zero_add, pow_one, neg_smul, one_smul] at h
  rw [sub_eq_add_neg]
  exact h

/-- **The side condition of a set `T ⊆ G`**: `A = M^T`, `B = {z ∈ Z¹ | z(h) = 0, h ∈ T}`
(tex L5060–5082). `hcob` holds since `(d⁰a)(h) = h • a − a`. PROVED. -/
def sideOfSet (T : Set G) : SideCond G M where
  AF := ⨅ h : T, LinearMap.ker ((DistribSMul.toLinearMap (ZMod 2) M (h : G) - LinearMap.id) ∘ₗ ev0L)
  BF := ⨅ h : T, LinearMap.ker (ev1L (h : G) ∘ₗ (Z1 G M).subtype)
  hZ0 := by
    intro a ha
    simp only [Submodule.mem_iInf, LinearMap.mem_ker, LinearMap.comp_apply, LinearMap.sub_apply,
      DistribSMul.toLinearMap_apply, LinearMap.id_apply]
    intro h
    have h0 : relaxedD G M a = 0 := Subtype.ext ha
    have := relaxedD_ev a (h : G)
    rw [h0, Submodule.coe_zero] at this
    exact this.symm.trans (map_zero (ev1L (M := M) (h : G)))
  hd := by
    intro a ha
    simp only [Submodule.mem_iInf, LinearMap.mem_ker, LinearMap.comp_apply, LinearMap.sub_apply,
      DistribSMul.toLinearMap_apply, LinearMap.id_apply, Submodule.mem_comap,
      Submodule.coe_subtype] at ha ⊢
    intro h
    exact (relaxedD_ev a (h : G)).trans (ha h)
  hcob := by
    intro a ha
    simp only [Submodule.mem_iInf, LinearMap.mem_ker, LinearMap.comp_apply, LinearMap.sub_apply,
      DistribSMul.toLinearMap_apply, LinearMap.id_apply, Submodule.coe_subtype] at ha ⊢
    intro h
    exact (relaxedD_ev a (h : G)).symm.trans (ha h)

theorem mem_sideOfSet_BF (T : Set G) (z : Z1 G M) :
    z ∈ (sideOfSet (M := M) T).BF ↔ ∀ h ∈ T, ev1 (z : (contCochains (ZMod 2) G M).X 1) h = 0 := by
  simp only [sideOfSet, Submodule.mem_iInf, LinearMap.mem_ker, LinearMap.comp_apply,
    Submodule.coe_subtype, Subtype.forall]
  rfl

/-- **The finite side**: cocycles vanishing on the inertia subgroup `I` (the unramified cocycles),
`A_F = M^I` (tex L5027–5037, L5060–5061). Its `hcob` is the inertia statement "an unramified
coboundary comes from an inertia invariant". PROVED. -/
def finiteSide (I : Subgroup G) : SideCond G M := sideOfSet (I : Set G)

/-- **The singular side** for a Frobenius lift `φ`: cocycles with `z(φ) = 0`, `A_S = M^φ`. -/
def singularSide (φ : G) : SideCond G M := sideOfSet ({φ} : Set G)

/-- **Both derivative sides have the quasi-side homology** (tex L5072–5083): `h0`, `hi`, `hpi` on
the explicit `H¹` models. PROVED. -/
theorem derivativeSides_quotients (I : Subgroup G) (φ : G) :
    SideQuotientsGenuine (finiteSide (M := M) I) ∧ SideQuotientsGenuine (singularSide (M := M) φ) :=
  ⟨sideQuotientsGenuine_proof _, sideQuotientsGenuine_proof _⟩

/-- With the trivial action, a `1`-cocycle is additive: `z(gh) = z(g) + z(h)`. PROVED. -/
theorem ev1_mul_of_trivial (htriv : ∀ (g : G) (m : M), g • m = m) (z : Z1 G M) (g h : G) :
    ev1 (z : (contCochains (ZMod 2) G M).X 1) (g * h) =
      ev1 (z : (contCochains (ZMod 2) G M).X 1) g + ev1 (z : (contCochains (ZMod 2) G M).X 1) h := by
  have hd := contCochains_d_apply (k := ZMod 2) (G := G) (M := M) 1 (z : (contCochains (ZMod 2) G M).X 1) ![g, h]
  have hz : ((contCochains (ZMod 2) G M).d 1 (1 + 1)).hom (z : (contCochains (ZMod 2) G M).X 1) = 0 := z.2
  rw [hz] at hd
  have e0 : (fun i : Fin 1 => (![g, h] : Fin 2 → G) i.succ) = fun _ => h := by
    funext i; fin_cases i; rfl
  have e1 : Fin.contractNth (0 : Fin 2) (· * ·) (![g, h] : Fin 2 → G) = fun _ => g * h := by
    funext i; fin_cases i; simp [Fin.contractNth]
  have e2 : Fin.contractNth (1 : Fin 2) (· * ·) (![g, h] : Fin 2 → G) = fun _ => g := by
    funext i; fin_cases i; simp [Fin.contractNth]
  rw [Fin.sum_univ_two, e0, e1, e2, htriv] at hd
  simp only [Fin.val_zero, Fin.val_one, zero_add, pow_one, neg_smul, one_smul] at hd
  change (0 : M) = ev1 (z : (contCochains (ZMod 2) G M).X 1) h + (-ev1 (z : (contCochains (ZMod 2) G M).X 1) (g * h) +
    (-1 : ZMod 2) ^ (1 + 1) • ev1 (z : (contCochains (ZMod 2) G M).X 1) g) at hd
  rw [show ((-1 : ZMod 2) ^ (1 + 1)) = 1 by decide, one_smul] at hd
  rw [← sub_eq_zero]
  rw [eq_comm, ← sub_eq_zero] at hd
  rw [← neg_eq_zero, ← hd]
  abel

/-- With the trivial action, an additive `1`-cochain is a cocycle. PROVED. -/
theorem mem_Z1_of_additive (htriv : ∀ (g : G) (m : M), g • m = m)
    (c : (contCochains (ZMod 2) G M).X 1) (hc : ∀ g h : G, ev1 c (g * h) = ev1 c g + ev1 c h) :
    c ∈ Z1 G M := by
  rw [LinearMap.mem_ker]
  apply Subtype.ext
  funext g
  have hd := contCochains_d_apply (k := ZMod 2) (G := G) (M := M) 1 c g
  refine hd.trans ?_
  have e0 : (fun i : Fin 1 => g i.succ) = fun _ => g 1 := by
    funext i; fin_cases i; rfl
  have e1 : Fin.contractNth (0 : Fin 2) (· * ·) g = fun _ => g 0 * g 1 := by
    funext i; fin_cases i; simp [Fin.contractNth]
  have e2 : Fin.contractNth (1 : Fin 2) (· * ·) g = fun _ => g 0 := by
    funext i; fin_cases i; simp [Fin.contractNth]
  rw [Fin.sum_univ_two, e0, e1, e2, htriv]
  change ev1 c (g 1) + ((-1 : ZMod 2) ^ ((0 : ℕ) + 1) • ev1 c (g 0 * g 1) +
    (-1 : ZMod 2) ^ ((1 : ℕ) + 1) • ev1 c (g 0)) = (0 : M)
  rw [hc, show ((-1 : ZMod 2) ^ ((0 : ℕ) + 1)) = -1 by decide,
    show ((-1 : ZMod 2) ^ ((1 : ℕ) + 1)) = 1 by decide, neg_smul, one_smul, one_smul]
  abel

/-! ### Coordinates `H¹(W_rel) ≃ k² × k²` (tex L5027–5037) -/

/-- The coordinate map `z ↦ (z(φ), z(σ))` on `1`-cocycles. -/
def coordL (φ σ : G) : Z1 G M →ₗ[ZMod 2] M × M :=
  (ev1L φ ∘ₗ (Z1 G M).subtype).prod (ev1L σ ∘ₗ (Z1 G M).subtype)

theorem coordL_relaxedD (φ σ : G) (hφ : ∀ m : M, φ • m = m) (hσ : ∀ m : M, σ • m = m)
    (a : (contCochains (ZMod 2) G M).X 0) : coordL φ σ (relaxedD G M a) = 0 := by
  ext
  · exact (relaxedD_ev a φ).trans (by rw [hφ, sub_self]; rfl)
  · exact (relaxedD_ev a σ).trans (by rw [hσ, sub_self]; rfl)

/-- The coordinate map on `H¹(W_rel) = Z¹ ⧸ d⁰C⁰` (`φ`, `σ` acting trivially). -/
def coordQ (φ σ : G) (hφ : ∀ m : M, φ • m = m) (hσ : ∀ m : M, σ • m = m) :
    (H1Wrel (G := G) (M := M)) →ₗ[ZMod 2] M × M :=
  (LinearMap.range (relaxedD G M)).liftQ (coordL φ σ) (by
    rintro _ ⟨a, rfl⟩
    exact LinearMap.mem_ker.mpr (coordL_relaxedD φ σ hφ hσ a))

theorem coordQ_mk (φ σ : G) (hφ : ∀ m : M, φ • m = m) (hσ : ∀ m : M, σ • m = m) (z : Z1 G M) :
    coordQ φ σ hφ hσ (Submodule.Quotient.mk z) =
      (ev1 (z : (contCochains (ZMod 2) G M).X 1) φ, ev1 (z : (contCochains (ZMod 2) G M).X 1) σ) :=
  rfl

/-- **GLUE: the tame coordinates of an inert local Galois group with trivial coefficients** (tex
L5027–5037). `φ` (a Frobenius lift) and `σ` (a tame inertia generator) act trivially on `M`,
`σ ∈ I`, the coordinate map `[z] ↦ (z(φ), z(σ))` is a bijection `H¹ ≅ M × M`, and a cocycle with
`z(σ) = 0` vanishes on `I` (`Hom(I, M)` factors through the tame quotient generated by `σ`, wild
inertia being pro-odd). Classification: GLUE (local class field theory / tame structure). -/
structure TameCoordinates (I : Subgroup G) (φ σ : G) : Prop where
  hφ : ∀ m : M, φ • m = m
  hσ : ∀ m : M, σ • m = m
  hσI : σ ∈ I
  hbij : Function.Bijective (coordQ φ σ hφ hσ)
  hI : ∀ z : Z1 G M, ev1 (z : (contCochains (ZMod 2) G M).X 1) σ = 0 →
    ∀ h ∈ I, ev1 (z : (contCochains (ZMod 2) G M).X 1) h = 0

/-- **The coordinates** `H¹(W_rel) ≃ k² × k²`, from the tame coordinates and `M ≃ k²`. -/
def coordEquiv {I : Subgroup G} {φ σ : G} (T : TameCoordinates (M := M) I φ σ)
    (eM : M ≃ₗ[ZMod 2] (Fin 2 → ZMod 2)) :
    (H1Wrel (G := G) (M := M)) ≃ₗ[ZMod 2] (Fin 2 → ZMod 2) × (Fin 2 → ZMod 2) :=
  (LinearEquiv.ofBijective _ T.hbij).trans (LinearEquiv.prodCongr eM eM)

theorem coordEquiv_mk {I : Subgroup G} {φ σ : G} (T : TameCoordinates (M := M) I φ σ)
    (eM : M ≃ₗ[ZMod 2] (Fin 2 → ZMod 2)) (z : Z1 G M) :
    coordEquiv T eM (Submodule.Quotient.mk z) =
      (eM (ev1 (z : (contCochains (ZMod 2) G M).X 1) φ),
        eM (ev1 (z : (contCochains (ZMod 2) G M).X 1) σ)) :=
  rfl

theorem H1i_mk (c : SideCond G M) (b : c.BF) :
    c.H1i (Submodule.Quotient.mk b) = Submodule.Quotient.mk (b : Z1 G M) := rfl

/-- **The finite side is the finite plane** (tex L5027–5037): the image of `H¹` of the finite side
in the coordinates is `finPlane`. PROVED (from the tame coordinates). -/
theorem finite_plane {I : Subgroup G} {φ σ : G} (T : TameCoordinates (M := M) I φ σ)
    (eM : M ≃ₗ[ZMod 2] (Fin 2 → ZMod 2)) :
    (LinearMap.range (finiteSide (M := M) I).H1i).map (coordEquiv T eM).toLinearMap =
      finPlane (ZMod 2) (Fin 2 → ZMod 2) (Fin 2 → ZMod 2) := by
  ext x
  rw [mem_finPlane, Submodule.mem_map]
  constructor
  · rintro ⟨y, ⟨w, rfl⟩, rfl⟩
    induction w using Submodule.Quotient.induction_on with
    | H b =>
      have hb := (mem_sideOfSet_BF (M := M) (I : Set G) b).mp b.2 σ T.hσI
      rw [LinearEquiv.coe_coe, H1i_mk, coordEquiv_mk]
      simp only
      rw [hb, map_zero]
  · intro hx
    obtain ⟨y, rfl⟩ := (coordEquiv T eM).surjective x
    induction y using Submodule.Quotient.induction_on with
    | H z =>
      rw [coordEquiv_mk] at hx
      have hz : ev1 (z : (contCochains (ZMod 2) G M).X 1) σ = 0 := eM.injective (by rw [map_zero]; exact hx)
      have hmem : z ∈ (finiteSide (M := M) I).BF :=
        (mem_sideOfSet_BF (M := M) (I : Set G) z).mpr (T.hI z hz)
      exact ⟨_, ⟨Submodule.Quotient.mk ⟨z, hmem⟩, rfl⟩, rfl⟩

/-- **The singular side is the singular plane** (tex L5027–5037). PROVED (from the tame
coordinates). -/
theorem singular_plane {I : Subgroup G} {φ σ : G} (T : TameCoordinates (M := M) I φ σ)
    (eM : M ≃ₗ[ZMod 2] (Fin 2 → ZMod 2)) :
    (LinearMap.range (singularSide (M := M) φ).H1i).map (coordEquiv T eM).toLinearMap =
      singPlane (ZMod 2) (Fin 2 → ZMod 2) (Fin 2 → ZMod 2) := by
  ext x
  rw [mem_singPlane, Submodule.mem_map]
  constructor
  · rintro ⟨y, ⟨w, rfl⟩, rfl⟩
    induction w using Submodule.Quotient.induction_on with
    | H b =>
      have hb := (mem_sideOfSet_BF (M := M) ({φ} : Set G) b).mp b.2 φ rfl
      rw [LinearEquiv.coe_coe, H1i_mk, coordEquiv_mk]
      simp only
      rw [hb, map_zero]
  · intro hx
    obtain ⟨y, rfl⟩ := (coordEquiv T eM).surjective x
    induction y using Submodule.Quotient.induction_on with
    | H z =>
      rw [coordEquiv_mk] at hx
      have hz : ev1 (z : (contCochains (ZMod 2) G M).X 1) φ = 0 := eM.injective (by rw [map_zero]; exact hx)
      have hmem : z ∈ (singularSide (M := M) φ).BF :=
        (mem_sideOfSet_BF (M := M) ({φ} : Set G) z).mpr (fun h hh => by
          rw [Set.mem_singleton_iff] at hh; subst hh; exact hz)
      exact ⟨_, ⟨Submodule.Quotient.mk ⟨z, hmem⟩, rfl⟩, rfl⟩

end Sides

/-! ### Non-vacuity: the tame coordinates on `(ℤ/2)²` with `M = 𝔽₂²` -/

section Example

/-- The group `(ℤ/2)²` (discrete), a finite model of the tame quotient `⟨φ, σ⟩`. -/
abbrev ExG : Type := Multiplicative (ZMod 2 × ZMod 2)

/-- `𝔽₂²` with the trivial action. -/
abbrev ExM : Type := TrivMod ExG (Fin 2 → ZMod 2)

/-- The Frobenius lift `φ = (1, 0)`. -/
def exφ : ExG := Multiplicative.ofAdd (1, 0)

/-- The tame inertia generator `σ = (0, 1)`. -/
def exσ : ExG := Multiplicative.ofAdd (0, 1)

theorem exTriv (g : ExG) (m : ExM) : g • m = m := rfl

/-- The cocycle `g ↦ a • m₁ + b • m₂` for `g = (a, b)`. -/
def exCocFun (m₁ m₂ : ExM) : (groupCohomology.inhomogeneousCochains (rep (ZMod 2) ExG ExM)).X 1 :=
  fun x => (Multiplicative.toAdd (x 0)).1 • m₁ + (Multiplicative.toAdd (x 0)).2 • m₂

/-- The cocycle as a genuine continuous cochain. -/
def exCoc1 (m₁ m₂ : ExM) : (contCochains (ZMod 2) ExG ExM).X 1 :=
  ⟨exCocFun m₁ m₂, mem_contCochain.mpr continuous_of_discreteTopology⟩

theorem exCoc1_ev (m₁ m₂ : ExM) (g : ExG) :
    ev1 (exCoc1 m₁ m₂) g = (Multiplicative.toAdd g).1 • m₁ + (Multiplicative.toAdd g).2 • m₂ := rfl

/-- The cocycle in `Z¹`. -/
def exCocDA (m₁ m₂ : ExM) : Z1 ExG ExM :=
  ⟨exCoc1 m₁ m₂, mem_Z1_of_additive exTriv _ (fun g h => by
    rw [exCoc1_ev, exCoc1_ev, exCoc1_ev, toAdd_mul, Prod.fst_add, Prod.snd_add, add_smul, add_smul]
    abel)⟩

theorem exCocDA_ev (m₁ m₂ : ExM) (g : ExG) :
    ev1 ((exCocDA m₁ m₂ : Z1 ExG ExM) : (contCochains (ZMod 2) ExG ExM).X 1) g =
      (Multiplicative.toAdd g).1 • m₁ + (Multiplicative.toAdd g).2 • m₂ := rfl

/-- A cocycle vanishing at `φ` and `σ` vanishes everywhere. -/
theorem exCocDA_zero_of (z : Z1 ExG ExM)
    (hφ : ev1 (z : (contCochains (ZMod 2) ExG ExM).X 1) exφ = 0)
    (hσ : ev1 (z : (contCochains (ZMod 2) ExG ExM).X 1) exσ = 0) (g : ExG) :
    ev1 (z : (contCochains (ZMod 2) ExG ExM).X 1) g = 0 := by
  have hadd := ev1_mul_of_trivial (M := ExM) exTriv z
  have h1 : ev1 (z : (contCochains (ZMod 2) ExG ExM).X 1) 1 = 0 := by
    have := hadd 1 1
    rw [one_mul] at this
    have h' : ev1 (z : (contCochains (ZMod 2) ExG ExM).X 1) 1 + ev1 (z : (contCochains (ZMod 2) ExG ExM).X 1) 1 =
        ev1 (z : (contCochains (ZMod 2) ExG ExM).X 1) 1 + 0 := by rw [add_zero]; exact this.symm
    exact add_left_cancel h'
  have two : ∀ a : ZMod 2, a = 0 ∨ a = 1 := by decide
  obtain ⟨⟨a, b⟩, rfl⟩ : ∃ p : ZMod 2 × ZMod 2, Multiplicative.ofAdd p = g := ⟨Multiplicative.toAdd g, rfl⟩
  rcases two a with rfl | rfl <;> rcases two b with rfl | rfl
  · rw [show (Multiplicative.ofAdd ((0 : ZMod 2), (0 : ZMod 2)) : ExG) = 1 by decide]; exact h1
  · exact hσ
  · exact hφ
  · rw [show (Multiplicative.ofAdd ((1 : ZMod 2), (1 : ZMod 2)) : ExG) = exφ * exσ by decide, hadd, hφ, hσ,
      add_zero]

/-- **Non-vacuity of `TameCoordinates`** (non-vacuity): on `G = (ℤ/2)²` with `M = 𝔽₂²` (trivial
action), `I = ⟨σ⟩`, the coordinate map `[z] ↦ (z(φ), z(σ))` is bijective and cocycles with
`z(σ) = 0` vanish on `I`. PROVED. -/
theorem exTameCoordinates : TameCoordinates (M := ExM) (Subgroup.zpowers exσ) exφ exσ where
  hφ := exTriv exφ
  hσ := exTriv exσ
  hσI := Subgroup.mem_zpowers _
  hbij := by
    constructor
    · rw [← LinearMap.ker_eq_bot, eq_bot_iff]
      intro y hy
      induction y using Submodule.Quotient.induction_on with
      | H z =>
        rw [LinearMap.mem_ker, coordQ_mk, Prod.mk_eq_zero] at hy
        have hz : z = 0 := by
          apply Subtype.ext
          apply Subtype.ext
          funext x
          have hx : x = fun _ => x 0 := by funext i; fin_cases i; rfl
          rw [hx]
          exact exCocDA_zero_of z hy.1 hy.2 (x 0)
        rw [hz, Submodule.mem_bot, Submodule.Quotient.mk_zero]
    · rintro ⟨m₁, m₂⟩
      refine ⟨Submodule.Quotient.mk (exCocDA m₁ m₂), ?_⟩
      rw [coordQ_mk, exCocDA_ev, exCocDA_ev]
      simp [exφ, exσ]
  hI := by
    intro z hz h hh
    obtain ⟨n, rfl⟩ := Subgroup.mem_zpowers_iff.mp hh
    have hadd := ev1_mul_of_trivial (M := ExM) exTriv z
    have hinv : exσ⁻¹ = exσ := rfl
    induction n using Int.induction_on with
    | zero =>
      have := hadd 1 1
      rw [one_mul] at this
      rw [zpow_zero]
      have h' : ev1 (z : (contCochains (ZMod 2) ExG ExM).X 1) 1 + ev1 (z : (contCochains (ZMod 2) ExG ExM).X 1) 1 =
          ev1 (z : (contCochains (ZMod 2) ExG ExM).X 1) 1 + 0 := by rw [add_zero]; exact this.symm
      exact add_left_cancel h'
    | succ n ih => rw [zpow_add_one, hadd, ih (Subgroup.zpow_mem _ (Subgroup.mem_zpowers _) _), hz, add_zero]
    | pred n ih =>
      rw [zpow_sub_one, hinv, hadd, ih (Subgroup.zpow_mem _ (Subgroup.mem_zpowers _) _), hz, add_zero]

/-- `𝔽₂²` as itself. -/
def exEM : ExM ≃ₗ[ZMod 2] (Fin 2 → ZMod 2) where
  toFun m := m
  invFun m := m
  map_add' _ _ := rfl
  map_smul' _ _ := rfl
  left_inv _ := rfl
  right_inv _ := rfl

/-- **The genuine planes on the example**: with the tame coordinates of `(ℤ/2)²`, the finite side
(cocycles vanishing on `⟨σ⟩`) gives `finPlane`, the singular side (`z(φ) = 0`) gives `singPlane`,
and both sides have the quasi-side homology. PROVED. -/
theorem ex_planes :
    (LinearMap.range (finiteSide (M := ExM) (Subgroup.zpowers exσ)).H1i).map
        (coordEquiv exTameCoordinates exEM).toLinearMap =
      finPlane (ZMod 2) (Fin 2 → ZMod 2) (Fin 2 → ZMod 2) ∧
    (LinearMap.range (singularSide (M := ExM) exφ).H1i).map
        (coordEquiv exTameCoordinates exEM).toLinearMap =
      singPlane (ZMod 2) (Fin 2 → ZMod 2) (Fin 2 → ZMod 2) ∧
    SideQuotientsGenuine (finiteSide (M := ExM) (Subgroup.zpowers exσ)) ∧
    SideQuotientsGenuine (singularSide (M := ExM) exφ) :=
  ⟨finite_plane exTameCoordinates exEM, singular_plane exTameCoordinates exEM,
    (derivativeSides_quotients (M := ExM) (Subgroup.zpowers exσ) exφ).1,
    (derivativeSides_quotients (M := ExM) (Subgroup.zpowers exσ) exφ).2⟩

end Example

