/-- A Frobenius lift fixing `√ϖ` and a tame generator moving it. -/
theorem exists_phi_sigma (hp : ringChar 𝓀[K] ≠ 2) :
    ∃ φ σ : Gal(AlgebraicClosure K/K), IsArithFrobeniusLift K φ ∧ φ (sqrtUnif K) = sqrtUnif K ∧
      σ ∈ inertiaSubgroup K ∧ σ (sqrtUnif K) = -sqrtUnif K := by
  have hpr : (ringChar 𝓀[K]).Prime := CharP.prime_ringChar 𝓀[K]
  have h2c : (2 : ℕ).Coprime (ringChar 𝓀[K]) :=
    (Nat.coprime_primes Nat.prime_two hpr).2 (Ne.symm hp)
  have hv : (normalizedValuation K (Units.mk0 ((unif K : Kˣ) : K) (unif K).ne_zero)).toAdd = 1 := by
    rw [Units.mk0_val, unif_spec, toAdd_ofAdd]
  obtain ⟨φ, hφ, hφα⟩ := exists_frobeniusLift_fix h2c (sqrtUnif_sq K) (sqrtUnif_ne_zero K)
    (unif K).ne_zero hv
  obtain ⟨σ, hσI, hσprim⟩ := exists_tame_generator h2c (sqrtUnif_sq K) (sqrtUnif_ne_zero K)
    (unif K).ne_zero hv
  refine ⟨φ, σ, hφ, hφα, hσI, ?_⟩
  rw [apply_eq_kummerVal_mul (sqrtUnif_ne_zero K), hσprim.eq_neg_one_of_two_right, neg_one_mul]

omit [ValuativeRel K] [TopologicalSpace K] [IsNonarchimedeanLocalField K] in
/-- The character of a continuous `1`-cocycle with trivial `𝔽₂` coefficients. -/
theorem cocycle_additive (y : (contCochains (ZMod 2) (Gal(AlgebraicClosure K/K)) (ZMod 2)).X 1) (hy : ((contCochains (ZMod 2) (Gal(AlgebraicClosure K/K)) (ZMod 2)).d 1 2).hom y = 0)
    (g h : Gal(AlgebraicClosure K/K)) :
    contFun (k := ZMod 2) y (fun _ => g * h) =
      contFun (k := ZMod 2) y (fun _ => g) + contFun (k := ZMod 2) y (fun _ => h) := by
  have := congrArg (fun c => contFun (k := ZMod 2) (G := Gal(AlgebraicClosure K/K)) (M := ZMod 2) c
    ![g, h]) hy
  beta_reduce at this
  rw [contFun_d12, smul_zmod_two, contFun_zero_apply] at this
  linear_combination -this

theorem tL_toCC_d (q : ℕ) (i j : ℤ) (h : i + 1 = j)
    (x : (tL (ZMod 2) (LinearMap.id : ZMod 2 →ₗ[ZMod 2] ZMod 2) q).X i) :
    (((tL (ZMod 2) (LinearMap.id : ZMod 2 →ₗ[ZMod 2] ZMod 2) q).toCC).d i j).hom x =
      (tL (ZMod 2) (LinearMap.id : ZMod 2 →ₗ[ZMod 2] ZMod 2) q).d i j h x :=
  PairedFunctional.GCx.toCC_d_hom _ i j h x

omit [ValuativeRel K] [TopologicalSpace K] [IsNonarchimedeanLocalField K] in
theorem natCx_toCC_d {G : Type} [Group G] [TopologicalSpace G] [IsTopologicalGroup G]
    [DistribMulAction G (ZMod 2)] [SMulCommClass G (ZMod 2) (ZMod 2)] [ContinuousSMul G (ZMod 2)]
    (n : ℕ) (x : (contCochains (ZMod 2) G (ZMod 2)).X n) :
    (((natCx (contCochains (ZMod 2) G (ZMod 2))).toCC).d (n : ℤ) ((n + 1 : ℕ) : ℤ)).hom x =
      ((contCochains (ZMod 2) G (ZMod 2)).d n (n + 1)).hom x :=
  PairedFunctional.GCx.toCC_d_hom (natCx (contCochains (ZMod 2) G (ZMod 2))) (n : ℤ)
    ((n + 1 : ℕ) : ℤ) (by push_cast; rfl) x


/-- **The print in the elementwise form used below** (on lane RC26's genuine cochains): every
continuous `2`-cocycle is `m·(χ_ur ∪ χ_ϖ)` up to a coboundary, `χ_ur ∪ χ_ϖ` is not a coboundary,
and `contCohomology` vanishes in degrees `≥ 3`. PROVED from `LocalCohomologyF2`. -/
theorem localCohomologyF2_elem (hL : LocalCohomologyF2 K) (hp : ringChar 𝓀[K] ≠ 2) :
    (∀ y : (contCochains (ZMod 2) (Gal(AlgebraicClosure K/K)) (ZMod 2)).X 2, ((contCochains (ZMod 2) (Gal(AlgebraicClosure K/K)) (ZMod 2)).d 2 3).hom y = 0 →
        ∃ (m : ZMod 2) (z : (contCochains (ZMod 2) (Gal(AlgebraicClosure K/K)) (ZMod 2)).X 1), lin2 hp m = y + ((contCochains (ZMod 2) (Gal(AlgebraicClosure K/K)) (ZMod 2)).d 1 2).hom z) ∧
      (∀ z : (contCochains (ZMod 2) (Gal(AlgebraicClosure K/K)) (ZMod 2)).X 1, lin2 hp 1 ≠ ((contCochains (ZMod 2) (Gal(AlgebraicClosure K/K)) (ZMod 2)).d 1 2).hom z) ∧
      ∀ n : ℕ, 3 ≤ n →
        Subsingleton (contCohomology (ZMod 2) (Gal(AlgebraicClosure K/K)) (ZMod 2) n) := by
  obtain ⟨h2, hge⟩ := hL hp
  obtain ⟨hnot, hall⟩ := h2 (unif K) (unif_spec K) (sqrtUnif K) (sqrtUnif_sq K)
  have hcup : ∀ m : ZMod 2, (c2 (K := K) m) = m • cupF2 K (sqrtUnif K) := fun m => by
    funext p
    simp [c2, cupF2, ramF2, smul_eq_mul]
  refine ⟨fun y hy => ?_, fun z hz => ?_, hge⟩
  · have hZ := mem_Z2_of_d_eq_zero (k := ZMod 2) y hy
    obtain ⟨m, hm⟩ := hall _ hZ
    obtain ⟨c, hc, hdc⟩ := ContCohomology.mem_B2_iff.1 hm
    refine ⟨m, mkCochain1 (k := ZMod 2) (fun g => -c g) hc.neg, ?_⟩
    refine contCochains_ext fun v => ?_
    rw [fin2_eq' v]
    change c2 m (v 0, v 1) = contFun (k := ZMod 2) y ![v 0, v 1] +
      contFun (k := ZMod 2) (((contCochains (ZMod 2) (Gal(AlgebraicClosure K/K)) (ZMod 2)).d 1 2).hom (mkCochain1 (k := ZMod 2) (fun g => -c g) hc.neg))
        ![v 0, v 1]
    rw [contFun_d12, smul_zmod_two]
    change c2 m (v 0, v 1) = contFun (k := ZMod 2) y ![v 0, v 1] +
      (-c (v 1) - -c (v 0 * v 1) + -c (v 0))
    have := congrFun hdc (v 0, v 1)
    rw [ContCohomology.d1_apply, smul_zmod_two] at this
    rw [hcup]
    change (m • cupF2 K (sqrtUnif K)) (v 0, v 1) = _
    have hy' : (fun p : Gal(AlgebraicClosure K/K) × Gal(AlgebraicClosure K/K) =>
        contFun (k := ZMod 2) y ![p.1, p.2]) (v 0, v 1) = contFun (k := ZMod 2) y ![v 0, v 1] := rfl
    rw [Pi.sub_apply] at this
    rw [← hy']
    linear_combination this
  · apply hnot
    refine ContCohomology.mem_B2_iff.2 ⟨fun g => contFun (k := ZMod 2) z (fun _ => g), continuous_contFun_one z, ?_⟩
    funext p
    obtain ⟨g, h⟩ := p
    have := congrArg (fun c => contFun (k := ZMod 2) (G := Gal(AlgebraicClosure K/K)) (M := ZMod 2) c
      ![g, h]) hz
    beta_reduce at this
    rw [contFun_d12, smul_zmod_two] at this
    rw [ContCohomology.d1_apply, smul_zmod_two]
    change contFun (k := ZMod 2) z (fun _ => h) - contFun (k := ZMod 2) z (fun _ => g * h) +
      contFun (k := ZMod 2) z (fun _ => g) = cupF2 K (sqrtUnif K) (g, h)
    rw [← this]
    change c2 1 (g, h) = _
    rw [hcup, one_smul]

theorem tL_eq_zero (q : ℕ) (n : ℤ) (h0 : n ≠ 0) (h1 : n ≠ 1) (h2 : n ≠ 2) (x : (tL (ZMod 2) (LinearMap.id : ZMod 2 →ₗ[ZMod 2] ZMod 2) q).X n) : x = 0 :=
  @Subsingleton.elim _ (ZInQ.Contrib.CloudB3RC53.ClearingComplex.tLX_subsingleton
    (S := ZMod 2) (M := ZMod 2) n h0 h1 h2) x 0

variable {q : ℕ}

/-- **Degree `0`**: both sides are `𝔽₂`. -/
theorem tameF2L_quasiIsoAt_zero (hp : ringChar 𝓀[K] ≠ 2) (hq : Odd q) :
    QuasiIsoAt (SelmerDuality.GHom.toCC (tameF2L (K := K) hp hq)) 0 := by
  refine quasiIsoAt_of_elem _ (-1) 0 1 (by simp) (by simp) ?_ ?_
  · intro (y : (contCochains (ZMod 2) (Gal(AlgebraicClosure K/K)) (ZMod 2)).X 0) hy
    have hy' : ((contCochains (ZMod 2) (Gal(AlgebraicClosure K/K)) (ZMod 2)).d 0 1).hom y = 0 := (natCx_toCC_d 0 y).symm.trans hy
    refine ⟨(contFun (k := ZMod 2) y Fin.elim0 : ZMod 2), ?_, 0, ?_⟩
    · refine (tL_toCC_d q 0 1 rfl _).trans ?_
      change ((contFun (k := ZMod 2) y Fin.elim0 - contFun (k := ZMod 2) y Fin.elim0, 0) :
        ZMod 2 × ZMod 2) = 0
      simp
    · have key : lin0 (K := K) (contFun (k := ZMod 2) y Fin.elim0) = y := by
        refine contCochains_ext fun v => ?_
        rw [Subsingleton.elim v Fin.elim0]
        rfl
      rw [map_zero]
      exact key.trans (add_zero y).symm
  · intro x _ z hxz
    have hz0 : z = 0 := rfl
    rw [hz0, map_zero] at hxz
    have hval := congrArg (fun c : (contCochains (ZMod 2) (Gal(AlgebraicClosure K/K)) (ZMod 2)).X 0 => contFun (k := ZMod 2) c Fin.elim0) hxz
    change (x : ZMod 2) = 0 at hval
    refine ⟨0, ?_⟩
    rw [map_zero]
    exact hval.symm

/-- **Degree `1`**: `H¹(G_K, 𝔽₂) ≅ 𝔽₂²` through the tame coordinates. -/
theorem tameF2L_quasiIsoAt_one (hp : ringChar 𝓀[K] ≠ 2) (hq : Odd q) :
    QuasiIsoAt (SelmerDuality.GHom.toCC (tameF2L (K := K) hp hq)) 1 := by
  obtain ⟨φ, σ, hφ, hφα, hσI, hσα⟩ := exists_phi_sigma hp
  have hne : -sqrtUnif K ≠ sqrtUnif K := by
    intro h
    exact mul_ne_zero (two_ne_zero_algClosure hp) (sqrtUnif_ne_zero K) (by linear_combination -h)
  have hσne : ¬ σ (sqrtUnif K) = sqrtUnif K := fun h => hne (hσα.symm.trans h)
  have hbij := coord_bijective hp (unif_spec K) (sqrtUnif_sq K) hφ hφα hσI hσα
  have hc1φ : ∀ a b : ZMod 2, c1 (K := K) a b φ = a := fun a b => by
    simp [c1, urChar_frobenius hφ, ramChar, hφα]
  have hc1σ : ∀ a b : ZMod 2, c1 (K := K) a b σ = b := fun a b => by
    simp [c1, urChar_inertia hσI, ramChar, hσne]
  have hq2 : ((q : ℕ) : ZMod 2) = 1 := by
    rw [ZMod.natCast_eq_iff]
    obtain ⟨r, hr⟩ := hq
    exact ⟨r, by simp [hr, ZMod.val_one]; ring⟩
  refine quasiIsoAt_of_elem _ 0 1 2 (by simp) (by simp) ?_ ?_
  · intro (y : (contCochains (ZMod 2) (Gal(AlgebraicClosure K/K)) (ZMod 2)).X 1) hy
    have hy' : ((contCochains (ZMod 2) (Gal(AlgebraicClosure K/K)) (ZMod 2)).d 1 2).hom y = 0 := (natCx_toCC_d 1 y).symm.trans hy
    set zf : Gal(AlgebraicClosure K/K) → ZMod 2 := fun g => contFun (k := ZMod 2) y (fun _ => g)
    have hZ : Continuous zf ∧ ∀ g h, zf (g * h) = zf g + zf h :=
      ⟨continuous_contFun_one y, cocycle_additive y hy'⟩
    have hW : Continuous (c1 (K := K) (zf φ) (zf σ)) ∧
        ∀ g h, c1 (K := K) (zf φ) (zf σ) (g * h) =
          c1 (K := K) (zf φ) (zf σ) g + c1 (K := K) (zf φ) (zf σ) h :=
      ⟨continuous_c1 hp _ _, c1_mul hp _ _⟩
    have heq : c1 (K := K) (zf φ) (zf σ) = zf := by
      have := hbij.1 (a₁ := ⟨_, hW⟩) (a₂ := ⟨zf, hZ⟩) (by
        simp only [Prod.mk.injEq]
        exact ⟨hc1φ _ _, hc1σ _ _⟩)
      exact congrArg Subtype.val this
    refine ⟨((zf φ, zf σ) : ZMod 2 × ZMod 2), ?_, 0, ?_⟩
    · refine (tL_toCC_d q 1 2 rfl _).trans ?_
      change (zf σ - ((q : ℕ) : ZMod 2) • zf σ : ZMod 2) = 0
      rw [hq2, one_smul, sub_self]
    · have key : lin1 (K := K) hp (zf φ, zf σ) = y := by
        refine contCochains_ext fun v => ?_
        rw [fin1_eq'' v]
        change c1 (zf φ) (zf σ) (v 0) = zf (v 0)
        rw [heq]
      rw [map_zero]
      exact key.trans (add_zero y).symm
  · intro x _ (z : (contCochains (ZMod 2) (Gal(AlgebraicClosure K/K)) (ZMod 2)).X 0) hxz
    have hxz' := hxz.trans (natCx_toCC_d 0 z)
    have hdz : ((contCochains (ZMod 2) (Gal(AlgebraicClosure K/K)) (ZMod 2)).d 0 1).hom z = 0 := by
      refine contCochains_ext fun v => ?_
      rw [fin1_eq'' v, contFun_d01, smul_zmod_two, sub_self]
      rfl
    rw [hdz] at hxz'
    have hfun : ∀ g, c1 (K := K) (show ZMod 2 × ZMod 2 from x).1
        (show ZMod 2 × ZMod 2 from x).2 g = 0 := fun g =>
      congrArg (fun c : (contCochains (ZMod 2) (Gal(AlgebraicClosure K/K)) (ZMod 2)).X 1 => contFun (k := ZMod 2) c (fun _ => g)) hxz'
    have ha := hfun φ
    have hb := hfun σ
    rw [hc1φ] at ha
    rw [hc1σ] at hb
    refine ⟨0, ?_⟩
    rw [map_zero]
    exact (Prod.ext ha hb).symm

/-- **Degree `2`** (from the print). -/
theorem tameF2L_quasiIsoAt_two (hp : ringChar 𝓀[K] ≠ 2) (hq : Odd q) (hL : LocalCohomologyF2 K) :
    QuasiIsoAt (SelmerDuality.GHom.toCC (tameF2L (K := K) hp hq)) 2 := by
  obtain ⟨hsurj, hnz, -⟩ := localCohomologyF2_elem hL hp
  refine quasiIsoAt_of_elem _ 1 2 3 (by simp) (by simp) ?_ ?_
  · intro (y : (contCochains (ZMod 2) (Gal(AlgebraicClosure K/K)) (ZMod 2)).X 2) hy
    have hy' : ((contCochains (ZMod 2) (Gal(AlgebraicClosure K/K)) (ZMod 2)).d 2 3).hom y = 0 := (natCx_toCC_d 2 y).symm.trans hy
    obtain ⟨m, z, hmz⟩ := hsurj y hy'
    refine ⟨(m : ZMod 2), rfl, z, ?_⟩
    exact hmz.trans (congrArg (fun t => y + t) (natCx_toCC_d 1 z).symm)
  · intro x _ (z : (contCochains (ZMod 2) (Gal(AlgebraicClosure K/K)) (ZMod 2)).X 1) hxz
    have hxz' := hxz.trans (natCx_toCC_d 1 z)
    have hx0 : (show ZMod 2 from x) = 0 := by
      have h01 : ∀ t : ZMod 2, t = 0 ∨ t = 1 := by decide
      rcases h01 (show ZMod 2 from x) with h | h
      · exact h
      · exact absurd (h ▸ hxz') (hnz z)
    refine ⟨0, ?_⟩
    rw [map_zero]
    exact hx0.symm

/-- **Degrees `≥ 3`** (from the print). -/
theorem tameF2L_quasiIsoAt_ge_three (hp : ringChar 𝓀[K] ≠ 2) (hq : Odd q)
    (hL : LocalCohomologyF2 K) (m : ℕ) :
    QuasiIsoAt (SelmerDuality.GHom.toCC (tameF2L (K := K) hp hq)) ((m + 3 : ℕ) : ℤ) := by
  obtain ⟨-, -, hge⟩ := localCohomologyF2_elem hL hp
  refine quasiIsoAt_of_elem _ ((m + 2 : ℕ) : ℤ) ((m + 3 : ℕ) : ℤ) ((m + 3 + 1 : ℕ) : ℤ)
    (by simp; omega) (by simp) ?_ ?_
  · intro (y : (contCochains (ZMod 2) (Gal(AlgebraicClosure K/K)) (ZMod 2)).X (m + 3)) hy
    have hy' : ((contCochains (ZMod 2) (Gal(AlgebraicClosure K/K)) (ZMod 2)).d (m + 3) (m + 3 + 1)).hom y = 0 := (natCx_toCC_d (m + 3) y).symm.trans hy
    have hsub := hge (m + 3) (by omega)
    have hex : (contCochains (ZMod 2) (Gal(AlgebraicClosure K/K)) (ZMod 2)).ExactAt (m + 3) :=
      (HomologicalComplex.exactAt_iff_isZero_homology _ _).2 (ModuleCat.isZero_of_subsingleton _)
    rw [HomologicalComplex.exactAt_iff' _ (m + 2) (m + 3) (m + 3 + 1) (by simp) (by simp),
      ShortComplex.moduleCat_exact_iff] at hex
    obtain ⟨z, hz⟩ := hex y hy'
    have h2 : (((natCx (contCochains (ZMod 2) (Gal(AlgebraicClosure K/K)) (ZMod 2))).toCC).d ((m + 2 : ℕ) : ℤ) ((m + 3 : ℕ) : ℤ)).hom (-z) = -y :=
      (natCx_toCC_d (m + 2) (-z)).trans ((map_neg _ z).trans (congrArg Neg.neg hz))
    refine ⟨0, map_zero _, -z, ?_⟩
    refine (map_zero _).trans ?_
    rw [h2]
    exact (add_neg_cancel y).symm
  · intro x _ _ _
    refine ⟨0, ?_⟩
    exact (map_zero _).trans (tL_eq_zero q _ (by omega) (by omega) (by omega) x).symm

/-- **Negative degrees**: both complexes vanish. -/
theorem tameF2L_quasiIsoAt_neg (hp : ringChar 𝓀[K] ≠ 2) (hq : Odd q) (m : ℕ) :
    QuasiIsoAt (SelmerDuality.GHom.toCC (tameF2L (K := K) hp hq)) (Int.negSucc m) := by
  refine quasiIsoAt_of_elem _ (Int.negSucc m - 1) (Int.negSucc m) (Int.negSucc m + 1)
    (by simp) (by simp) ?_ ?_
  · intro y _
    refine ⟨0, map_zero _, 0, ?_⟩
    have hy : y = 0 := rfl
    rw [hy, map_zero, map_zero, add_zero]
  · intro x _ _ _
    refine ⟨0, ?_⟩
    exact (map_zero _).trans (tL_eq_zero q _ (by omega) (by omega) (by omega) x).symm

/-- **The tame model computes the local cohomology of `𝔽₂` in degrees `≤ 1`** (PROVED). -/
theorem tameF2L_quasiIsoAt_le_one (hp : ringChar 𝓀[K] ≠ 2) (hq : Odd q) (n : ℤ) (hn : n ≤ 1) :
    QuasiIsoAt (SelmerDuality.GHom.toCC (tameF2L (K := K) hp hq)) n := by
  rcases n with (_ | _ | m) | m
  · exact tameF2L_quasiIsoAt_zero hp hq
  · exact tameF2L_quasiIsoAt_one hp hq
  · exfalso
    have : ((m + 2 : ℕ) : ℤ) ≤ 1 := hn
    omega
  · exact tameF2L_quasiIsoAt_neg hp hq m

/-- **The tame model is a quasi-isomorphic model of the local cochains of `𝔽₂`** (from the
print). -/
theorem tameF2L_quasiIso (hp : ringChar 𝓀[K] ≠ 2) (hq : Odd q) (hL : LocalCohomologyF2 K) :
    QuasiIso (SelmerDuality.GHom.toCC (tameF2L (K := K) hp hq)) := by
  refine ⟨fun n => ?_⟩
  rcases n with (_ | _ | _ | m) | m
  · exact tameF2L_quasiIsoAt_zero hp hq
  · exact tameF2L_quasiIsoAt_one hp hq
  · exact tameF2L_quasiIsoAt_two hp hq hL
  · exact tameF2L_quasiIsoAt_ge_three hp hq hL m
  · exact tameF2L_quasiIsoAt_neg hp hq m

end Full

section Unr

variable [DistribMulAction (Gal(maximalUnramifiedExtension K (AlgebraicClosure K)/K)) (ZMod 2)] [SMulCommClass (Gal(maximalUnramifiedExtension K (AlgebraicClosure K)/K)) (ZMod 2) (ZMod 2)]
  [ContinuousSMul (Gal(maximalUnramifiedExtension K (AlgebraicClosure K)/K)) (ZMod 2)]

omit [DistribMulAction (Gal(maximalUnramifiedExtension K (AlgebraicClosure K)/K)) (ZMod 2)] [SMulCommClass (Gal(maximalUnramifiedExtension K (AlgebraicClosure K)/K)) (ZMod 2) (ZMod 2)]
  [ContinuousSMul (Gal(maximalUnramifiedExtension K (AlgebraicClosure K)/K)) (ZMod 2)] in
theorem locallyCompactSpace_unr : LocallyCompactSpace (Gal(maximalUnramifiedExtension K (AlgebraicClosure K)/K)) :=
  have : T2Space (Gal(maximalUnramifiedExtension K (AlgebraicClosure K)/K)) := krullTopology_t2
  have : R1Space (Gal(maximalUnramifiedExtension K (AlgebraicClosure K)/K)) := T2Space.r1Space
  have : WeaklyLocallyCompactSpace (Gal(maximalUnramifiedExtension K (AlgebraicClosure K)/K)) := ⟨fun _ => ⟨Set.univ, isCompact_univ, Filter.univ_mem⟩⟩
  WeaklyLocallyCompactSpace.locallyCompactSpace

omit [DistribMulAction (Gal(maximalUnramifiedExtension K (AlgebraicClosure K)/K)) (ZMod 2)] [SMulCommClass (Gal(maximalUnramifiedExtension K (AlgebraicClosure K)/K)) (ZMod 2) (ZMod 2)]
  [ContinuousSMul (Gal(maximalUnramifiedExtension K (AlgebraicClosure K)/K)) (ZMod 2)] in
theorem urBar_frob :
    urBar K (frobElt (maximalUnramifiedGaloisGroupEquivZHat K (AlgebraicClosure K))) = 1 := by
  unfold urBar frobElt
  rw [ContinuousMulEquiv.apply_symm_apply, zHat.lift_gen, toAdd_ofAdd]

theorem tU_eq_zero (n : ℤ) (h0 : n ≠ 0) (h1 : n ≠ 1) (x : (tU (ZMod 2) (LinearMap.id : ZMod 2 →ₗ[ZMod 2] ZMod 2)).X n) : x = 0 :=
  @Subsingleton.elim _ (ZInQ.Contrib.CloudB3RC53.ClearingComplex.tUX_subsingleton
    (S := ZMod 2) (M := ZMod 2) n h0 h1) x 0

theorem tU_toCC_d (i j : ℤ) (h : i + 1 = j) (x : (tU (ZMod 2) (LinearMap.id : ZMod 2 →ₗ[ZMod 2] ZMod 2)).X i) :
    (((tU (ZMod 2) (LinearMap.id : ZMod 2 →ₗ[ZMod 2] ZMod 2)).toCC).d i j).hom x = (tU (ZMod 2) (LinearMap.id : ZMod 2 →ₗ[ZMod 2] ZMod 2)).d i j h x :=
  PairedFunctional.GCx.toCC_d_hom _ i j h x

/-- **The unramified comparison is a quasi-isomorphism** (`Gal(K^{ur}/K) ≃ ℤ̂`). PROVED. -/
theorem tameF2U_quasiIso : QuasiIso (SelmerDuality.GHom.toCC (tameF2U (K := K))) := by
  have := locallyCompactSpace_unr (K := K)
  set E := maximalUnramifiedGaloisGroupEquivZHat K (AlgebraicClosure K)
  refine ⟨fun n => ?_⟩
  rcases n with (_ | _ | m) | m
  · -- degree 0
    refine quasiIsoAt_of_elem _ (-1) 0 1 (by simp) (by simp) ?_ ?_
    · intro (y : (contCochains (ZMod 2) Gal(maximalUnramifiedExtension K (AlgebraicClosure K)/K) (ZMod 2)).X 0) hy
      refine ⟨(contFun (k := ZMod 2) y Fin.elim0 : ZMod 2), ?_, 0, ?_⟩
      · refine (tU_toCC_d 0 1 rfl _).trans ?_
        change (contFun (k := ZMod 2) y Fin.elim0 - contFun (k := ZMod 2) y Fin.elim0 : ZMod 2) = 0
        exact sub_self _
      · have key : lin0U (K := K) (contFun (k := ZMod 2) y Fin.elim0) = y := by
          refine contCochains_ext fun v => ?_
          rw [Subsingleton.elim v Fin.elim0]
          rfl
        rw [map_zero]
        exact key.trans (add_zero y).symm
    · intro x _ z hxz
      have hz0 : z = 0 := rfl
      rw [hz0, map_zero] at hxz
      have hval := congrArg (fun c : (contCochains (ZMod 2) Gal(maximalUnramifiedExtension K (AlgebraicClosure K)/K) (ZMod 2)).X 0 => contFun (k := ZMod 2) c Fin.elim0) hxz
      change (x : ZMod 2) = 0 at hval
      refine ⟨0, ?_⟩
      rw [map_zero]
      exact hval.symm
  · -- degree 1
    refine quasiIsoAt_of_elem _ 0 1 2 (by simp) (by simp) ?_ ?_
    · intro (y : (contCochains (ZMod 2) Gal(maximalUnramifiedExtension K (AlgebraicClosure K)/K) (ZMod 2)).X 1) hy
      have hy' : ((contCochains (ZMod 2) Gal(maximalUnramifiedExtension K (AlgebraicClosure K)/K) (ZMod 2)).d 1 2).hom y = 0 := (natCx_toCC_d 1 y).symm.trans hy
      set zf : (Gal(maximalUnramifiedExtension K (AlgebraicClosure K)/K)) → ZMod 2 := fun g => contFun (k := ZMod 2) y (fun _ => g)
      have hadd : ∀ g h, zf (g * h) = zf g + zf h := fun g h => by
        have := congrArg (fun c => contFun (k := ZMod 2) (G := Gal(maximalUnramifiedExtension K (AlgebraicClosure K)/K)) (M := ZMod 2) c ![g, h]) hy'
        beta_reduce at this
        rw [contFun_d12, smul_zmod_two, contFun_zero_apply] at this
        linear_combination -this
      have hZ : zf ∈ ContCohomology.Z1 (Gal(maximalUnramifiedExtension K (AlgebraicClosure K)/K)) (ZMod 2) :=
        ContCohomology.mem_Z1_iff.2 ⟨continuous_contFun_one y, fun g h => by
          rw [hadd, smul_zmod_two, add_comm]⟩
      set a := zf (frobElt E)
      have hW : (fun g => a * urBar K g) ∈ ContCohomology.Z1 (Gal(maximalUnramifiedExtension K (AlgebraicClosure K)/K)) (ZMod 2) :=
        ContCohomology.mem_Z1_iff.2 ⟨(continuous_of_discreteTopology
          (f := fun x : ZMod 2 => a * x)).comp continuous_urBar, fun g h => by
            simp only [urBar_mul, smul_zmod_two]; ring⟩
      have heq : (fun g => a * urBar K g) = zf :=
        ContCohomology.eq_of_mem_Z1_of_eqOn_of_topologicalClosure_closure_eq_top hW hZ
          (closure_frob_eq_top E) (fun g hg => by
            rw [Set.mem_singleton_iff] at hg
            subst hg
            change a * urBar K (frobElt E) = a
            rw [urBar_frob, mul_one])
      refine ⟨(a : ZMod 2), ?_, 0, ?_⟩
      · exact (tU_toCC_d 1 2 rfl _).trans rfl
      · have key : lin1U (K := K) a = y := by
          refine contCochains_ext fun v => ?_
          rw [fin1_eq'' v]
          change a * urBar K (v 0) = zf (v 0)
          exact congrFun heq (v 0)
        rw [map_zero]
        exact key.trans (add_zero y).symm
    · intro x _ (z : (contCochains (ZMod 2) Gal(maximalUnramifiedExtension K (AlgebraicClosure K)/K) (ZMod 2)).X 0) hxz
      have hxz' := hxz.trans (natCx_toCC_d 0 z)
      have hdz : ((contCochains (ZMod 2) Gal(maximalUnramifiedExtension K (AlgebraicClosure K)/K) (ZMod 2)).d 0 1).hom z = 0 := by
        refine contCochains_ext fun v => ?_
        rw [fin1_eq'' v, contFun_d01, smul_zmod_two, sub_self]
        rfl
      rw [hdz] at hxz'
      have hval := congrArg (fun c : (contCochains (ZMod 2) Gal(maximalUnramifiedExtension K (AlgebraicClosure K)/K) (ZMod 2)).X 1 => contFun (k := ZMod 2) c
        (fun _ => frobElt E)) hxz'
      change (show ZMod 2 from x) * urBar K (frobElt E) = 0 at hval
      rw [urBar_frob, mul_one] at hval
      refine ⟨0, ?_⟩
      rw [map_zero]
      exact hval.symm
  · -- degrees ≥ 2
    refine quasiIsoAt_of_elem _ ((m + 1 : ℕ) : ℤ) ((m + 2 : ℕ) : ℤ) ((m + 2 + 1 : ℕ) : ℤ)
      (by simp; omega) (by simp) ?_ ?_
    · intro (y : (contCochains (ZMod 2) Gal(maximalUnramifiedExtension K (AlgebraicClosure K)/K) (ZMod 2)).X (m + 2)) hy
      have hy' : ((contCochains (ZMod 2) Gal(maximalUnramifiedExtension K (AlgebraicClosure K)/K) (ZMod 2)).d (m + 2) (m + 2 + 1)).hom y = 0 := (natCx_toCC_d (m + 2) y).symm.trans hy
      have hsub := subsingleton_contCohomology_ge_two E (ZMod 2) (ZMod 2) (m + 2) (by omega)
      have hex : (contCochains (ZMod 2) Gal(maximalUnramifiedExtension K (AlgebraicClosure K)/K) (ZMod 2)).ExactAt (m + 2) :=
        (HomologicalComplex.exactAt_iff_isZero_homology _ _).2 (ModuleCat.isZero_of_subsingleton _)
      rw [HomologicalComplex.exactAt_iff' _ (m + 1) (m + 2) (m + 2 + 1) (by simp) (by simp),
        ShortComplex.moduleCat_exact_iff] at hex
      obtain ⟨z, hz⟩ := hex y hy'
      have h2 : (((natCx (contCochains (ZMod 2) Gal(maximalUnramifiedExtension K (AlgebraicClosure K)/K) (ZMod 2))).toCC).d ((m + 1 : ℕ) : ℤ) ((m + 2 : ℕ) : ℤ)).hom (-z) = -y :=
        (natCx_toCC_d (m + 1) (-z)).trans ((map_neg _ z).trans (congrArg Neg.neg hz))
      refine ⟨0, map_zero _, -z, ?_⟩
      refine (map_zero _).trans ?_
      rw [h2]
      exact (add_neg_cancel y).symm
    · intro x _ _ _
      refine ⟨0, ?_⟩
      exact (map_zero _).trans (tU_eq_zero _ (by omega) (by omega) x).symm
  · -- negative degrees
    refine quasiIsoAt_of_elem _ (Int.negSucc m - 1) (Int.negSucc m) (Int.negSucc m + 1)
      (by simp) (by simp) ?_ ?_
    · intro y _
      refine ⟨0, map_zero _, 0, ?_⟩
      have hy : y = 0 := rfl
      rw [hy, map_zero, map_zero, add_zero]
    · intro x _ _ _
      refine ⟨0, ?_⟩
      exact (map_zero _).trans (tU_eq_zero _ (by omega) (by omega) x).symm

end Unr

section Assembly

variable [DistribMulAction (Gal(AlgebraicClosure K/K)) (ZMod 2)] [SMulCommClass (Gal(AlgebraicClosure K/K)) (ZMod 2) (ZMod 2)]
  [ContinuousSMul (Gal(AlgebraicClosure K/K)) (ZMod 2)]
  [DistribMulAction (Gal(maximalUnramifiedExtension K (AlgebraicClosure K)/K)) (ZMod 2)] [SMulCommClass (Gal(maximalUnramifiedExtension K (AlgebraicClosure K)/K)) (ZMod 2) (ZMod 2)]
  [ContinuousSMul (Gal(maximalUnramifiedExtension K (AlgebraicClosure K)/K)) (ZMod 2)]

/-- **`TameModelQIso` for trivial `𝔽₂` coefficients** (`M = 𝔽₂`, `Φ = 1`, `q` odd, `p` odd): the
tame model and the unramified model are quasi-isomorphic models of the genuine local cochains of
`G_K` and of `Gal(K^{ur}/K)`, compatibly with inflation along a restriction `π`. PROVED from the
print `LocalCohomologyF2` (used only for the degrees `≥ 2` of the full local complex). -/
def tameModelQIsoF2 (hp : ringChar 𝓀[K] ≠ 2) {q : ℕ} (hq : Odd q)
    (π : Gal(AlgebraicClosure K/K) →ₜ* Gal(maximalUnramifiedExtension K (AlgebraicClosure K)/K)) (hπ : ∀ g, π g = restrictMaximalUnramifiedHom K g)
    (hL : LocalCohomologyF2 K) :
    TameModelQIso (ZMod 2) (LinearMap.id : ZMod 2 →ₗ[ZMod 2] ZMod 2) q
      (natCx (contCochains (ZMod 2) (Gal(AlgebraicClosure K/K)) (ZMod 2)))
      (natCx (contCochains (ZMod 2) (Gal(maximalUnramifiedExtension K (AlgebraicClosure K)/K)) (ZMod 2))) (natHom (inflF2 π)) where
  fL := SelmerDuality.GHom.toCC (tameF2L hp hq)
  fU := SelmerDuality.GHom.toCC (tameF2U (K := K))
  qisL := tameF2L_quasiIso hp hq hL
  qisU := tameF2U_quasiIso
  comm := tameF2_comm hp hq π hπ

end Assembly

