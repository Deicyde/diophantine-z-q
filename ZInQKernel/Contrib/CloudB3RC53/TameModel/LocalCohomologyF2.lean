import ZInQKernel.Contrib.CloudB3RC53.TameQuotient.QuadraticCoordinates
import ZInQKernel.Contrib.OneProof.RC.SelmerComplex.TauCetiComparison

/-!
# PRINT: the local cohomology of `𝔽₂` in degrees `≥ 2`

Standalone statement of the named input used by the trivial-`𝔽₂` tame model
(`TrivialF2QIso.lean`).

Let `K` be a nonarchimedean local field of odd residue characteristic, `G_K = Gal(K^{alg}/K)`, and
`𝔽₂ = ZMod 2` with its (necessarily trivial) continuous `G_K`-action. For a uniformizer `ϖ` and a
square root `α ∈ K^{alg}` of `ϖ`, let `χ_ur = urChar K` be the unramified quadratic character (the
parity of the `ℤ̂`-coordinate of the restriction to `K^{ur}`) and `χ_ϖ = ramChar α` the ramified
quadratic character `g ↦ [g α ≠ α]` (both from `TameQuotient/QuadraticCoordinates.lean`), and
`χ_ur ∪ χ_ϖ` their cup product, the continuous `2`-cocycle `(g, h) ↦ χ_ur(g) χ_ϖ(h)` (`cupF2`).

`LocalCohomologyF2 K` (**PRINT, UNVERIFIED**; Serre, *Galois Cohomology*, II §5.2–5.3;
Neukirch–Schmidt–Wingberg, *Cohomology of Number Fields*, 7.1.8 and §7.2) asserts:

* `H²(G_K, 𝔽₂) ≅ 𝔽₂`, generated by `[χ_ur ∪ χ_ϖ]`: `χ_ur ∪ χ_ϖ` is not a continuous coboundary, and
  every continuous `2`-cocycle `y` is `m · (χ_ur ∪ χ_ϖ)` up to a continuous coboundary for some
  `m ∈ 𝔽₂` (Tau Ceti's explicit continuous cochains `Z2`, `B2`); mathematically, `H²(G_K, μ₂)` is
  `Br K[2] ≅ ½ℤ/ℤ` and the cup class is the quaternion (Hilbert-symbol) class `(u, ϖ)`, `u` a
  non-square unit;
* `Hⁿ(G_K, 𝔽₂) = 0` for `n ≥ 3` (`cd₂ G_K = 2`), on lane RC26's genuine cochains
  (`contCohomology`).
-/

noncomputable section

namespace ZInQ.Contrib.CloudB3RC53.TameModel

open TauCeti ValuativeRel ContCohomology
open ZInQ.Contrib.CloudB3RC53.TameQuotient
open ZInQ.Manuscript.RC.SelmerComplex (contCohomology)

variable (K : Type) [Field K] [ValuativeRel K] [TopologicalSpace K] [IsNonarchimedeanLocalField K]

/-- The cup product `χ_ur ∪ χ_ϖ`, `(g, h) ↦ χ_ur(g) · χ_ϖ(h)`, of the unramified character and the
ramified character of a square root `α`. -/
def cupF2 (α : AlgebraicClosure K)
    (p : Gal(AlgebraicClosure K/K) × Gal(AlgebraicClosure K/K)) : ZMod 2 :=
  urChar K p.1 * ramChar α p.2

variable [DistribMulAction (Gal(AlgebraicClosure K/K)) (ZMod 2)]
  [SMulCommClass (Gal(AlgebraicClosure K/K)) (ZMod 2) (ZMod 2)]
  [ContinuousSMul (Gal(AlgebraicClosure K/K)) (ZMod 2)]

/-- **PRINT (UNVERIFIED)**: `H²(G_K, 𝔽₂) ≅ 𝔽₂` generated by `[χ_ur ∪ χ_ϖ]`, and `Hⁿ(G_K, 𝔽₂) = 0`
for `n ≥ 3`, for a nonarchimedean local field of odd residue characteristic (Serre, *Galois
Cohomology*, II §5.2–5.3; NSW 7.1.8, §7.2). -/
def LocalCohomologyF2 : Prop :=
  ringChar 𝓀[K] ≠ 2 →
    (∀ (ϖ : Kˣ), normalizedValuation K ϖ = .ofAdd 1 →
      ∀ α : AlgebraicClosure K, α ^ 2 = algebraMap K (AlgebraicClosure K) ϖ →
        cupF2 K α ∉ B2 (Gal(AlgebraicClosure K/K)) (ZMod 2) ∧
        ∀ y ∈ Z2 (Gal(AlgebraicClosure K/K)) (ZMod 2),
          ∃ m : ZMod 2, y - m • cupF2 K α ∈ B2 (Gal(AlgebraicClosure K/K)) (ZMod 2)) ∧
    ∀ n : ℕ, 3 ≤ n →
      Subsingleton (contCohomology (ZMod 2) (Gal(AlgebraicClosure K/K)) (ZMod 2) n)

end ZInQ.Contrib.CloudB3RC53.TameModel
