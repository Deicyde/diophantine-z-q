import ZInQKernel.Contrib.OneProof.ShimuraPointDictField

/-! ON THE SPOT (provenance (c)): a marked pair that satisfies the function
field relations defines the generic branch into its field of definition. -/

noncomputable section

namespace BShTraces

/-- A matched marked pair gives an embedding from the field generated by
the original pair. The equivalence of relations supplies both factorization
of polynomial evaluation and invertibility of the nonzero denominators. -/
theorem exists_ringHom_of_pair_relations {K L : Type*} [Field K] [Field L]
    {a b : K} {c d : L} (hK : Subfield.closure {a, b} = ⊤)
    (hrel : ∀ P, AfTateOr.ev2 P a b = 0 ↔ AfTateOr.ev2 P c d = 0) :
    ∃ f : K →+* L, f a = c ∧ f b = d := by
  let e := AfTateOr.evHom a b
  let e' := AfTateOr.evHom c d
  have h (P : Polynomial (Polynomial ℤ)) : e P = 0 ↔ e' P = 0 := by
    simpa only [e, e', AfTateOr.evHom_apply] using hrel P
  have hker : RingHom.ker e.rangeRestrict ≤ RingHom.ker e' := by
    intro P hP
    exact RingHom.mem_ker.mpr ((h P).mp (congrArg Subtype.val (RingHom.mem_ker.mp hP)))
  let s : e.range →+* L :=
    e.rangeRestrict.liftOfSurjective e.rangeRestrict_surjective ⟨e', hker⟩
  have hs (P : Polynomial (Polynomial ℤ)) : s (e.rangeRestrict P) = e' P :=
    RingHom.liftOfRightInverse_comp_apply _ _ _ _ P
  letI := AfTateOr.isFractionRing_range a b hK
  have hsU (m : nonZeroDivisors e.range) : IsUnit (s m) := by
    apply isUnit_iff_ne_zero.mpr
    intro hm
    obtain ⟨P, hP⟩ := e.rangeRestrict_surjective m.val
    have he : e' P = 0 := by rw [← hs P, hP]; exact hm
    exact (mem_nonZeroDivisors_iff_ne_zero.mp m.property)
      (hP ▸ (Subtype.ext ((h P).mpr he) : e.rangeRestrict P = 0))
  let f : K →+* L := IsLocalization.lift hsU
  have hgen (P : Polynomial (Polynomial ℤ)) : f (e P) = e' P := by
    change f (algebraMap e.range _ (e.rangeRestrict P)) = _
    exact (IsLocalization.lift_eq _ _).trans (hs P)
  refine ⟨f, ?_, ?_⟩
  · simpa [e, e', AfTateOr.evHom] using hgen (Polynomial.C Polynomial.X)
  · simpa [e, e', AfTateOr.evHom] using hgen Polynomial.X

#print axioms exists_ringHom_of_pair_relations

end BShTraces
