theorem gonzalezRotgerX6Ab_of_coarseNoGR_no5 (hY : RayClassCFT.ShimuraMainThmIDeligneY3AbU)
    (hX : X6CoarseModuli) : HDec.QMSplit.Moduli.GonzalezRotgerX6Ab_no5 := by
