theorem r1r2fpRep_ofW_no5 (hE : CanonicalModelY3) (hH : HeckeOfFine) (hX : CoarseX6OfFineW)
    (hP : HauptmodulOfX6) (hR : ReciprocityOfFine) (h5_no5 : ResidueOfX6_no5) : LeafAdopt.R1R2fpRepW_no5 := by
