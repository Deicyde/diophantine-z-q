-- ==== from ZInQKernel.Contrib.OneProof.GRDict ====
set_option linter.style.longLine false
noncomputable section
namespace GRDict
open CategoryTheory AlgebraicGeometry Limits
open LeafQM LeafQM.AV
section Dict
variable (hU : BPAnalytic.Uniformization.UniformizationLeafAll) (hG : ZInQ.HomLattice.GAGAMorphism)
  (hM : AvSplit.MumfordTorsionAlgClosed)
end Dict
/-- The clause `R5ptProps_no5` on any witness, from Thm 5.12 over González–Rotger's CM points and the dictionary. -/
theorem r5ptProps_of_thm512_no5 (h : GonzalezRotgerThm512X6) (hU : BPAnalytic.Uniformization.UniformizationLeafAll)
    (hG : ZInQ.HomLattice.GAGAMorphism) (hM : AvSplit.MumfordTorsionAlgClosed)
    {Y : Over (Spec (CommRingCat.of ℚ))} {Φ : PtEquiv Y} {X : Over (Spec (CommRingCat.of ℚ))}
    {Ψ : (fieldPt Qbar ⟶ X) ≃ Quotient (pairSetoid Qbar)} {fY : Y ⟶ X}
    (h1 : LeafQM.AV.R1UnivRigid.R1fpPropsAb Y Φ) (h6 : X6Props Y Φ X Ψ fY) : R5ptProps_no5 X Ψ := by
  intro k _ _ _ hk R hR hc x P hP ⟨θ⟩
  exact h Y Φ X Ψ fY h1 h6 k hk R hR hc x (isGRCMPoint_of_com hU hG hM hk hR hc Ψ x P hP θ)

/-- **`gonzalezRotgerX6Ab` from the witness and Thm 5.12 over González–Rotger's CM points.** -/
theorem gonzalezRotgerX6Ab_of_witness_no5 (h : GonzalezRotgerThm512X6) (hW : X6ModuliWitness)
    (hU : BPAnalytic.Uniformization.UniformizationLeafAll) (hG : ZInQ.HomLattice.GAGAMorphism)
    (hM : AvSplit.MumfordTorsionAlgClosed) : HDec.QMSplit.Moduli.GonzalezRotgerX6Ab_no5 := by
  obtain ⟨Y, Φ, X, Ψ, fY, h1, h6⟩ := hW
  exact ⟨Y, Φ, X, Ψ, fY, h1, h6, r5ptProps_of_thm512_no5 h hU hG hM h1 h6⟩

end GRDict
end
-- ==== end ZInQKernel.Contrib.OneProof.GRDict ====

-- ==== from ZInQKernel.Contrib.OneProof.GRX6AbPrint ====
set_option linter.style.longLine false
noncomputable section
namespace GRX6AbPrint
open CategoryTheory AlgebraicGeometry Limits
open LeafQM LeafQM.AV
/-- **The field `gonzalezRotgerX6Ab`** from González–Rotger Thm 5.12 over their CM points (`GRDict`, printed leaf),
the coarse leaf `X6CoarseModuli`, the existing research field `shimuraMainThmIDeligneY3AbU` and the textbook fields
`uniformizationLeafAll`, `gagaMorphism`, `mumfordTorsionAlgClosed`. -/
theorem gonzalezRotgerX6Ab_of_coarse_no5 (h : GRDict.GonzalezRotgerThm512X6)
    (hY : RayClassCFT.ShimuraMainThmIDeligneY3AbU) (hX : X6CoarseModuli)
    (hU : BPAnalytic.Uniformization.UniformizationLeafAll) (hG : ZInQ.HomLattice.GAGAMorphism)
    (hM : AvSplit.MumfordTorsionAlgClosed) : HDec.QMSplit.Moduli.GonzalezRotgerX6Ab_no5 :=
  GRDict.gonzalezRotgerX6Ab_of_witness_no5 h (x6ModuliWitness_of_coarse hY hX) hU hG hM

/-- **The final form**: `gonzalezRotgerX6Ab` from the two printed leaves (`GonzalezRotgerThm512X6`,
`X6CoarseModuli`), the existing research field `shimuraMainThmIDeligneY3AbU` and the textbook fields `gagaMorphism`,
`mumfordTorsionAlgClosed` (`uniformizationLeafAll` is the proved `uniformizationLeafAll_proof`). -/
theorem gonzalezRotgerX6Ab_of_print_no5 (h : GRDict.GonzalezRotgerThm512X6)
    (hY : RayClassCFT.ShimuraMainThmIDeligneY3AbU) (hX : X6CoarseModuli)
    (hG : ZInQ.HomLattice.GAGAMorphism) (hM : AvSplit.MumfordTorsionAlgClosed) :
    HDec.QMSplit.Moduli.GonzalezRotgerX6Ab_no5 :=
  gonzalezRotgerX6Ab_of_coarse_no5 h hY hX uniformizationLeafAll_proof hG hM

end GRX6AbPrint
