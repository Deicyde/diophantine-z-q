open LeafQM LeafQM.AV
variable {X : Over (Spec (CommRingCat.of ℚ))} {Ψ : (fieldPt Qbar ⟶ X) ≃ Quotient (pairSetoid Qbar)}
  {π₆ : ToP1 X.left}
/-- **`R1R2fpRep` without its last clause `R1pi0Props X`** (pi0-fold, from pi0-prune). On the single proof the clause
(`X₆` geometrically connected) was produced from the two added leaves `deligneComponentsX6PrintedAb` and
`geomConnOfAlgClosure` and read by no consumer; the chain carries this weak row instead (`R1R2fpRepW_of_rep`). -/
def R1R2fpRepW_no5 : Prop :=
  ∃ (Y : Over (Spec (CommRingCat.of ℚ))) (Φ : PtEquiv Y)
    (X : Over (Spec (CommRingCat.of ℚ))) (Ψ : (fieldPt Qbar ⟶ X) ≃ Quotient (pairSetoid Qbar))
    (fY : Y ⟶ X) (π₆ : ToP1 X.left),
    R1fpProps Y Φ ∧ R1heckeProps Y Φ ∧ X6Props Y Φ X Ψ fY ∧ R2X6PropsIff X Ψ π₆ ∧
      R1recProps Y Φ ∧ X6Surj Y X fY π₆ ∧ R5ptProps_no5 X Ψ

/-- **Glue (proved)**: the repaired bundle implies leaf-qm-fp's `R1R2fp_no5`, so every glue theorem
of leaf-qm-fp (`conj_iso_of_rational`, `cm_of_val`, `residue_unramified_over_branch_no5`,
`exists_fibre_object_no5`, `leaves_on_one_witness`, ...) applies to it. pi0-fold: stated on the weak row `R1R2fpRepW_no5`
(the clause `R1pi0Props` was never used here). -/
theorem R1R2fp_of_rep_no5 (h : R1R2fpRepW_no5) : R1R2fp_no5 := by
  obtain ⟨Y, Φ, X, Ψ, fY, π₆, h1, hh, h6, h2, hr, hs, h5_no5⟩ := h
  exact ⟨Y, Φ, X, Ψ, fY, π₆, h1, hh, h6, r2X6Props_of_iff h2, cmExists_of_iff h2 hs.1, hr, hs, h5_no5⟩

end LeafAdopt
