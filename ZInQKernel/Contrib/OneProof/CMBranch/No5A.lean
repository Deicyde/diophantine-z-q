theorem coverModelOfHecke_of_tsHecke_no5 (hconn : Y3Connected) (hRR : R1R2fp_no5)
    (hT : ObjBridge.TorsionStructure) (hCG : CurveGaloisChart) (hCI : CurveChartInf)
