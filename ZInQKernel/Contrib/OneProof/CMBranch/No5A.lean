open Complex
/-- The leaf's own `Y₃`: the triple that `Classical.choice` extracts from the bundle `R1R2fp_no5`
(through `R1R2fp_Y_no5`). -/
def ownY_no5 (h : R1R2fp_no5) : Over (Spec (CommRingCat.of ℚ)) := (R1R2fp_Y_no5 h).choose

/-- The leaf's own moduli bijections. -/
def ownΦ_no5 (h : R1R2fp_no5) : PtEquiv (ownY_no5 h) := (R1R2fp_Y_no5 h).choose_spec.choose

/-- The leaf's own `π : Y₃ → P¹`. -/
def ownπ_no5 (h : R1R2fp_no5) : ToP1 (ownY_no5 h).left := (R1R2fp_Y_no5 h).choose_spec.choose_spec.choose

theorem own_spec_no5 (h : R1R2fp_no5) : R1fpProps (ownY_no5 h) (ownΦ_no5 h) ∧ R1heckeProps (ownY_no5 h) (ownΦ_no5 h) ∧
    R2fpProps (ownY_no5 h) (ownΦ_no5 h) (ownπ_no5 h) :=
  (R1R2fp_Y_no5 h).choose_spec.choose_spec.choose_spec

/-- **`FibreQMPeriod` restated for the leaf's own triple** (qm-pin's option 3 form; with
`Pin.MobiusGlue` it is equivalent to `FibreQMPeriod`: `fibreQMPeriod_of_own_no5` and
`own_of_fibreQMPeriod`). -/
def FibreQMPeriodOwn_no5 (h : R1R2fp_no5) : Prop := FibreQMPeriodAt (ownY_no5 h) (ownΦ_no5 h) (ownπ_no5 h)

/-- **qm-pin's reduction (proved).** The own-triple statement implies `FibreQMPeriod` for every
triple satisfying the repaired clause list, given `Pin.MobiusGlue` (mobius-glue proves it from
`CurveRatFactor`, `CurveSurj` and T5) and the CM objects of the bundle. -/
theorem fibreQMPeriod_of_own_no5 (h : R1R2fp_no5) (hM : Pin.MobiusGlue) (hOwn : FibreQMPeriodOwn_no5 h) :
    ThetaPt.FibreQMPeriod := by
  obtain ⟨h1, -, h2⟩ := own_spec_no5 h
  intro Y Φ π h1' h2' u hu K A hFib
  obtain ⟨emb, y, P, hP, hy, hiso⟩ := hFib
  exact Pin.pointwise_of_witness_mor hM (Pin.cm_objects_of_R1R2fp_no5 h) h1 h2
    (fun t P => ∀ u : ℚ, u ∉ contactSet → t = OnePoint.some (algebraMap ℚ Qbar (Jmap u)) →
      ∀ (K : GlueAssembly.NF) (A : ZInQ.DefFaltings.AbVar K.K) (emb : K.K →+* Qbar),
        (letI : Algebra K.K Qbar := emb.toAlgebra; Nonempty ((A.baseChange Qbar).X ≅ P.A.X)) →
        QMConcl u K A)
    (fun t y P hP ht u hu hJ K A emb hiso => hOwn u hu K A ⟨emb, y, P, hP, ht.trans hJ, hiso⟩)
    Y Φ π h1' h2' _ y P hP rfl u hu hy K A emb hiso

/-- **`FibreQMPeriod` for the leaf's own triple from the named Props (proved).** -/
theorem fibreQMPeriodOwn_of_no5 (h : R1R2fp_no5) (hH : PkgI1.QMHauptmodul) (hU : QMComplexUnif)
    (hV : QMPeriodValue (ownY_no5 h) (ownΦ_no5 h) (ownπ_no5 h)) (hD : QMDenZeroCM3) (hT : UnifTransport) :
    FibreQMPeriodOwn_no5 h :=
  fibreQMPeriodAt_of _ _ _ (own_spec_no5 h).1 hH hU hV hD hT

/-- **Main result: `FibreQMPeriod` from named Props (proved).** The Hauptmodul comparison is
needed only for the leaf's own triple; `Pin.MobiusGlue` carries it to every triple. -/
theorem fibreQMPeriod_of_named_no5 (h : R1R2fp_no5) (hM : Pin.MobiusGlue) (hH : PkgI1.QMHauptmodul)
    (hU : QMComplexUnif) (hV : QMPeriodValue (ownY_no5 h) (ownΦ_no5 h) (ownπ_no5 h)) (hD : QMDenZeroCM3)
    (hT : UnifTransport) : ThetaPt.FibreQMPeriod :=
  fibreQMPeriod_of_own_no5 h hM (fibreQMPeriodOwn_of_no5 h hH hU hV hD hT)

/-- **Main result, finest form (proved):** `FibreQMPeriod` from `MobiusGlue` (proved by mobius-glue
from two curve facts and T5), the existing leaf `QMHauptmodul`, the leaf candidates
`QMComplexUnif` and `QMDenZeroCM3`, and the glue `QMPeriodMap` (own triple), `HauptmodulUnique`,
`UnifTransport`. -/
theorem fibreQMPeriod_of_parts_no5 (h : R1R2fp_no5) (hM : Pin.MobiusGlue) (hH : PkgI1.QMHauptmodul)
    (hU : QMComplexUnif) (hPM : QMPeriodMap (ownY_no5 h) (ownΦ_no5 h) (ownπ_no5 h))
    (hHU : HauptmodulUnique) (hD : QMDenZeroCM3) (hT : UnifTransport) :
    ThetaPt.FibreQMPeriod :=
  fibreQMPeriod_of_named_no5 h hM hH hU (qmPeriodValue_of _ _ _ hPM hHU) hD hT

/-- **Main result, final form (proved):** `FibreQMPeriod` from
* leaves: `PkgI1.QMHauptmodul` (existing composite leaf), the textbook leaves T35
  (`UniformizationExistsT35`) and T11a (`T11aRiemannEnd`), both already in leaf-adopt3's
  `TextbookLeaves`, and R1(b) in family form at the leaf's own triple (`R1bFamily`);
* glue: `Pin.MobiusGlue` (proved by mobius-glue), `QMLatticeAlgebra`, `PeriodMapGlue` (own triple),
  `HauptmodulUnique`, `QMDenZeroCM3`, `UnifTransport`. -/
theorem fibreQMPeriod_of_textbook_no5 (h : R1R2fp_no5) (hM : Pin.MobiusGlue)
    (hH : PkgI1.QMHauptmodul) (hE : UniformizationExistsT35) (hR11 : T11aRiemannEnd)
    (hR : R1bFamily (ownY_no5 h) (ownΦ_no5 h) (ownπ_no5 h))
    (hL : QMLatticeAlgebra) (hG : PeriodMapGlue (ownY_no5 h) (ownΦ_no5 h) (ownπ_no5 h))
    (hHU : HauptmodulUnique) (hD : QMDenZeroCM3) (hT : UnifTransport) :
    ThetaPt.FibreQMPeriod :=
  fibreQMPeriod_of_parts_no5 h hM hH (qmComplexUnif_of_textbook hE hR11 hL)
    (qmPeriodMap_of _ _ _ hR hG) hHU hD hT

/-- **Main result, final form (proved):** as `fibreQMPeriod_of_textbook_no5`, with
`QMLatticeAlgebra` replaced by its algebraic core `QMLatticeFree` (Skolem–Noether and class number
one). -/
theorem fibreQMPeriod_final_no5 (h : R1R2fp_no5) (hM : Pin.MobiusGlue)
    (hH : PkgI1.QMHauptmodul) (hE : UniformizationExistsT35) (hR11 : T11aRiemannEnd)
    (hR : R1bFamily (ownY_no5 h) (ownΦ_no5 h) (ownπ_no5 h))
    (hF : QMLatticeFree) (hG : PeriodMapGlue (ownY_no5 h) (ownΦ_no5 h) (ownπ_no5 h))
    (hHU : HauptmodulUnique) (hD : QMDenZeroCM3) (hT : UnifTransport) :
    ThetaPt.FibreQMPeriod :=
  fibreQMPeriod_of_textbook_no5 h hM hH hE hR11 hR (qmLatticeAlgebra_of_free hF) hG hHU hD hT

/-- **Main result, final form with the lattice algebra split (proved).** Hypotheses:
* leaves: `PkgI1.QMHauptmodul` (existing composite leaf), T35 `UniformizationExistsT35`, T11a
  `T11aRiemannEnd` (both already in leaf-adopt3's `TextbookLeaves`), `QMSkolemNoetherC`,
  `QMClassNumberOne` (textbook), `R1bFamily` at the leaf's own triple (R1(b), concrete);
* glue: `Pin.MobiusGlue` (proved by mobius-glue from two curve facts and T5), `PeriodMapGlue` (own
  triple), `HauptmodulUnique`, `QMDenZeroCM3`, `UnifTransport`. -/
theorem fibreQMPeriod_final'_no5 (h : R1R2fp_no5) (hM : Pin.MobiusGlue)
    (hH : PkgI1.QMHauptmodul) (hE : UniformizationExistsT35) (hR11 : T11aRiemannEnd)
    (hSN : QMSkolemNoetherC) (hCN : QMClassNumberOne)
    (hR : R1bFamily (ownY_no5 h) (ownΦ_no5 h) (ownπ_no5 h)) (hG : PeriodMapGlue (ownY_no5 h) (ownΦ_no5 h) (ownπ_no5 h))
    (hHU : HauptmodulUnique) (hD : QMDenZeroCM3) (hT : UnifTransport) :
    ThetaPt.FibreQMPeriod :=
  fibreQMPeriod_final_no5 h hM hH hE hR11 hR (qmLatticeFree_of hSN hCN) hG hHU hD hT

/-- **Main result, final form (proved).** As `fibreQMPeriod_final'_no5`, with `UnifTransport` replaced
by `CPtsTransport` (complex points of the base change, as a group isomorphism compatible with
regular functions). -/
theorem fibreQMPeriod_final''_no5 (h : R1R2fp_no5) (hM : Pin.MobiusGlue)
    (hH : PkgI1.QMHauptmodul) (hE : UniformizationExistsT35) (hR11 : T11aRiemannEnd)
    (hSN : QMSkolemNoetherC) (hCN : QMClassNumberOne)
    (hR : R1bFamily (ownY_no5 h) (ownΦ_no5 h) (ownπ_no5 h)) (hG : PeriodMapGlue (ownY_no5 h) (ownΦ_no5 h) (ownπ_no5 h))
    (hHU : HauptmodulUnique) (hD : QMDenZeroCM3) (hCP : CPtsTransport) :
    ThetaPt.FibreQMPeriod :=
  fibreQMPeriod_final'_no5 h hM hH hE hR11 hSN hCN hR hG hHU hD (unifTransport_of hCP)

/-- **Main result (proved).** `FibreQMPeriod` from
* leaves: `PkgI1.QMHauptmodul` (existing composite leaf), T35 `UniformizationExistsT35` and T11a
  `T11aRiemannEnd` (verbatim copies of the kernel's textbook leaves, in leaf-adopt3's
  `TextbookLeaves`), `QMClassNumberOne` (textbook: Eichler's class number one, lattice form),
  `R1bFamily` at the leaf's own triple (R1(b), concrete);
* glue: `Pin.MobiusGlue` (proved by mobius-glue from two curve facts and T5), `PeriodMapGlue` (own
  triple), `HauptmodulUnique`, `QMDenZeroCM3`, `CPtsTransport`.
(`QMSkolemNoetherC` is proved here, `qmSkolemNoetherC_proof`.) -/
theorem fibreQMPeriod_main_no5 (h : R1R2fp_no5) (hM : Pin.MobiusGlue)
    (hH : PkgI1.QMHauptmodul) (hE : UniformizationExistsT35) (hR11 : T11aRiemannEnd)
    (hCN : QMClassNumberOne)
    (hR : R1bFamily (ownY_no5 h) (ownΦ_no5 h) (ownπ_no5 h)) (hG : PeriodMapGlue (ownY_no5 h) (ownΦ_no5 h) (ownπ_no5 h))
    (hHU : HauptmodulUnique) (hD : QMDenZeroCM3) (hCP : CPtsTransport) :
    ThetaPt.FibreQMPeriod :=
  fibreQMPeriod_final''_no5 h hM hH hE hR11 qmSkolemNoetherC_proof hCN hR hG hHU hD hCP

/-- **Main result from the decomposition's bundle form of the leaf (`LeafAdopt.R1R2fpRep`,
proved).** -/
theorem fibreQMPeriod_main_rep_no5 (h : LeafAdopt.R1R2fpRepW_no5) (hM : Pin.MobiusGlue)
    (hH : PkgI1.QMHauptmodul) (hE : UniformizationExistsT35) (hR11 : T11aRiemannEnd)
    (hCN : QMClassNumberOne)
    (hR : R1bFamily (ownY_no5 (LeafAdopt.R1R2fp_of_rep_no5 h)) (ownΦ_no5 (LeafAdopt.R1R2fp_of_rep_no5 h))
      (ownπ_no5 (LeafAdopt.R1R2fp_of_rep_no5 h)))
    (hG : PeriodMapGlue (ownY_no5 (LeafAdopt.R1R2fp_of_rep_no5 h)) (ownΦ_no5 (LeafAdopt.R1R2fp_of_rep_no5 h))
      (ownπ_no5 (LeafAdopt.R1R2fp_of_rep_no5 h)))
    (hHU : HauptmodulUnique) (hD : QMDenZeroCM3) (hCP : CPtsTransport) :
    ThetaPt.FibreQMPeriod :=
  fibreQMPeriod_main_no5 _ hM hH hE hR11 hCN hR hG hHU hD hCP

