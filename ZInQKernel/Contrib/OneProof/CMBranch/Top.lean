import ZInQKernel.OneProof.H.TailZ74
import ZInQKernel.Contrib.OneProof.CMBranch.Open4

/-! # cm-branch: the fold dry run — the top theorem with the manuscript's CM branch

`sixContactMin_of_open67_cm` is the chain's top theorem `HDec.HSyn.sixContactMin_of_open67` (TailZ74)
with one extra hypothesis `c : CMBranch.CMInputs` (the CM-branch leaves and glue), and with the base of
the chain, `sixContactMin_of_open4_hf_pz_eb` (which builds FS5 from González–Rotger, the `X₆` Kummer
fibre and `cmOptimalEmbedding`), replaced by `sixContactMin_of_open4_cm`. Every intermediate theorem
`sixContactMin_of_openN…` is copied verbatim (generated by `scratch/cm-branch/gen/mk_top.py`) with `c`
threaded. The bundles are unchanged, so the fields `r5count`, `cmOptimalEmbedding`, `x6ConicModel`
are still carried (now unread: a PruneScan target); `R5ptProps` stays a conjunct of the row `r1r2`.
-/

namespace HDec
set_option maxHeartbeats 1000000
noncomputable section

namespace CMBranch
/-- **The CM-branch inputs** (docs/research/cm-branch.md §4): the leaves `FowlerProp27`, `CMHeight62`,
`CMjDegree`, `CMPotentialGood` and the glue `CMHomFieldSplit` (matrix units on A8's model; A8 itself is proved, `CMBranch/A8.lean`), `ReducedCMPeriod`,
`HeightAdditivityUpper`. -/
structure CMInputs : Prop where
  cmHomFieldSplit : CMHomFieldSplit
  fowlerProp27 : FowlerProp27
  cmjDegree : CMjDegree
  cmPotentialGood : CMPotentialGood
  cmHeight62 : CMHeight62
  reducedCMPeriod : ReducedCMPeriod
  heightAdditivityUpper : HeightAdditivityUpper
end CMBranch

namespace HSyn
open CategoryTheory AlgebraicGeometry G0Split

