    · exact ⟨2, hθ, fun h => n3 ((hAL P₀.A P₀.surface P₀.q).2.1 h)⟩
    · exact ⟨3, hθ, fun h => n24 ((hAL P₀.A P₀.surface P₀.q).2.2 h)⟩
  obtain ⟨k, ⟨θ⟩, hk⟩ := key
