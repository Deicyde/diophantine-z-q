    have := h4.1 h; rw [hx] at this; exact one_ne_zero (OnePoint.coe_injective this)
  have n3 : ¬ HasCM3 P₀.q := fun h => by
    have := h3.1 h; rw [hx] at this; exact OnePoint.coe_ne_infty _ this
