theorem tab1_complete : ∀ r0 r1 r2 r3 : ZMod 8, r3 = 2 * r0 → (r0 = 0 ∨ r0 = 4) →
    (r1 + r0) ^ 2 + (r2 + r0) ^ 2 + r0 ^ 2 = 1 → ∃ e ∈ tab1, e.r = ⟨r0, r1, r2, r3⟩ := by
  decide +kernel

set_option maxHeartbeats 0 in
theorem tab1_merge : ∀ e ∈ tab1, ∀ t : Fin 2 × Fin 2 × Fin 2,
    MergeOK1 e.r t (e.root t) (e.wit.getD (idx8 t) (0, 0, 0, 0, 0)) := by
  decide +kernel

set_option maxHeartbeats 0 in
theorem tab1_sep1 : ∀ e ∈ tab1, ∀ pr ∈ pairs1, ∀ μ ∈ unitList, ∀ X Y : ZMod 4,
    mapH (Int.castRingHom (ZMod 4)) (mulH μ (βZ pr.1)) ≠
      mulH (mapH (Int.castRingHom (ZMod 4)) (βZ pr.2))
        ⟨X + Y * to4 e.r.a0, Y * to4 e.r.a1, Y * to4 e.r.a2, Y * to4 e.r.a3⟩ := by
  decide +kernel

/-- `2x ∈ ℤ/8` for `x ∈ ℤ/4`. -/
def dbl (x : ZMod 4) : ZMod 8 := 2 * (x.val : ZMod 8)

theorem dbl_to4 : ∀ x : ZMod 8, dbl (to4 x) = 2 * x := by decide

set_option maxHeartbeats 0 in
theorem tab1_sep2 : ∀ e ∈ tab1, ∀ pr ∈ pairs1, ∀ μ ∈ unitList, ∀ X Y : ZMod 4,
    mulH (mapH (Int.castRingHom (ZMod 8)) oneMI)
        (mulH (mapH (Int.castRingHom (ZMod 8)) (βZ pr.1)) ⟨1 + e.r.a0, e.r.a1, e.r.a2, e.r.a3⟩) ≠
      mulH (mapH (Int.castRingHom (ZMod 8)) (mulH μ (βZ pr.2)))
        ⟨dbl X + dbl Y * e.r.a0, dbl Y * e.r.a1, dbl Y * e.r.a2, dbl Y * e.r.a3⟩ := by
  decide +kernel

theorem tab1_sums : ∀ e ∈ tab1, (∑ t : Fin 2 × Fin 2 × Fin 2, e.F t) = 0 ∧
    (∑ t : Fin 2 × Fin 2 × Fin 2, chi0Z t * e.F t) = 0 ∧
    (∑ t : Fin 2 × Fin 2 × Fin 2, if e.c t = 0 then (1 : ℤ) else 0) = 2 ∧
    (∑ t : Fin 2 × Fin 2 × Fin 2, if e.c t = 1 then (1 : ℤ) else 0) = 2 ∧
    (∑ t : Fin 2 × Fin 2 × Fin 2, if e.c t = 2 then (1 : ℤ) else 0) = 4 ∧
    (∑ t : Fin 2 × Fin 2 × Fin 2, if e.c t = 0 then chi0Z t else 0) = 2 ∧
    (∑ t : Fin 2 × Fin 2 × Fin 2, if e.c t = 1 then chi0Z t else 0) = 2 ∧
    (∑ t : Fin 2 × Fin 2 × Fin 2, if e.c t = 2 then chi0Z t else 0) = -4 ∧
    e.c (0, 0, 0) = 0 ∧ e.c (1, 1, 0) = 1 ∧ e.c (1, 0, 1) = 2 := by
  decide +kernel

