theorem tab3_complete : ∀ r0 r1 r2 r3 : ZMod 4, (r3 = 1 ∨ r3 = 3) → 2 * r0 = 1 + r3 →
    ∃ e ∈ tab3, e.r = ⟨r0, r1, r2, r3⟩ := by
  decide +kernel

theorem tab3_merge : ∀ e ∈ tab3, ∀ t : Fin 2 × Fin 2 × Fin 2,
    MergeOK3 e.r t (e.root t) (e.wit.getD (idx8 t) (0, 0, 0, 0)) := by
  decide +kernel

theorem tab3_sep : ∀ e ∈ tab3, ∀ μ ∈ unitList, ∀ X Y : ZMod 4,
    mapH (Int.castRingHom (ZMod 4)) (mulH μ (βZ e.p1)) ≠
      mulH (mapH (Int.castRingHom (ZMod 4)) (βZ e.rc)) ⟨X + Y * e.r.a0, Y * e.r.a1, Y * e.r.a2, Y * e.r.a3⟩ := by
  decide +kernel

theorem tab3_sums : ∀ e ∈ tab3, (∑ t : Fin 2 × Fin 2 × Fin 2, e.F t) = 0 ∧
    (∑ t : Fin 2 × Fin 2 × Fin 2, chi0Z t * e.F t) = 0 ∧ e.F e.rc = 1 ∧ e.F e.p1 = -3 := by
  decide +kernel

