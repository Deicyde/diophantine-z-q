import ZInQKernel.Contrib.OneProof.HfxProof.Finite25

/-!
# hfx-proof: the finite data for `n ≡ 3 (mod 8)` (kernel `decide`)

Task hfx-proof. For every residue `r = hc(ω) mod 4` of `ω = (1 + τ(√−n))/2` (64 residues), the table
`tab3` (generated by `scratch/hfx-proof/gen_lean3.py`) gives the 2-orbit `{p1, p2}` and a point `rc` of the
6-orbit of `K_{n,2}^×` on TYZ's 8 classes, and for each `t` a witness `(x, y, μ, s)`:
`β_t (x + yω) ≡ ± μ β_{root t} (1 + 4O_B)` (`Ā(B − A) ≡ 0 mod 4`). Checked:
* `tab3_complete`: every residue occurs;
* `tab3_merge`: the witnesses are correct;
* `tab3_sep`: no `μ β_{p1} ≡ β_{rc} (X + Yω) (mod 4)` (the 2-adic obstruction);
* `tab3_sums`: `F = −3·[p1, p2] + 1·[else]` is orthogonal to `1` and `χ₀`.
-/

set_option linter.style.longLine false

namespace ZInQ.Contrib.HfxProof

open ZInQ.Contrib.T21Proof

/-- An entry of the table. -/
structure E3 where
  r : H4 (ZMod 4)
  p1 : Fin 2 × Fin 2 × Fin 2
  p2 : Fin 2 × Fin 2 × Fin 2
  rc : Fin 2 × Fin 2 × Fin 2
  wit : List (ZMod 4 × ZMod 4 × Fin 24 × Fin 2)

/-- The index of `t` in `{0,1}³`. -/
def idx8 (t : Fin 2 × Fin 2 × Fin 2) : ℕ := 4 * t.1.val + 2 * t.2.1.val + t.2.2.val

/-- The class representative of `t`. -/
def E3.root (e : E3) (t : Fin 2 × Fin 2 × Fin 2) : Fin 2 × Fin 2 × Fin 2 :=
  if t = e.p1 ∨ t = e.p2 then e.p1 else e.rc

/-- The test vector values. -/
def E3.F (e : E3) (t : Fin 2 × Fin 2 × Fin 2) : ℤ := if t = e.p1 ∨ t = e.p2 then -3 else 1

/-- `x + y ω (mod 4)` in Hurwitz coordinates. -/
def alpha4 (r : H4 (ZMod 4)) (x y : ZMod 4) : H4 (ZMod 4) := ⟨x + y * r.a0, y * r.a1, y * r.a2, y * r.a3⟩

/-- `± μ β_{t'} (mod 4)`. -/
def rhoBeta4 (i : Fin 24) (s : Fin 2) (t' : Fin 2 × Fin 2 × Fin 2) : H4 (ZMod 4) :=
  mapH (Int.castRingHom (ZMod 4)) (smulH (sg s) (mulH (unitList.getD i.val ⟨1, 0, 0, 0⟩) (βZ t')))

def sub4 (a b : H4 (ZMod 4)) : H4 (ZMod 4) := ⟨a.a0 - b.a0, a.a1 - b.a1, a.a2 - b.a2, a.a3 - b.a3⟩

/-- The merge condition for `t → t'` with witness `w`. -/
def MergeOK3 (r : H4 (ZMod 4)) (t t' : Fin 2 × Fin 2 × Fin 2) (w : ZMod 4 × ZMod 4 × Fin 24 × Fin 2) :
    Prop :=
  mulH (starH (rhoBeta4 w.2.2.1 w.2.2.2 t'))
      (sub4 (mulH (mapH (Int.castRingHom (ZMod 4)) (βZ t)) (alpha4 r w.1 w.2.1))
        (rhoBeta4 w.2.2.1 w.2.2.2 t')) = ⟨0, 0, 0, 0⟩ ∧
    nrdH (alpha4 r w.1 w.2.1) ≠ 0 ∧ nrdH (alpha4 r w.1 w.2.1) ≠ 2

instance (r t t' w) : Decidable (MergeOK3 r t t' w) := by unfold MergeOK3; infer_instance

