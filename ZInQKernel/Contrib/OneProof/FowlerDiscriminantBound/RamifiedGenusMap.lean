import Mathlib.Data.ZMod.Basic
import Mathlib.GroupTheory.Index
import Mathlib.GroupTheory.OrderOfElement
import Mathlib.NumberTheory.NumberField.ClassNumber
import Mathlib.RingTheory.ClassGroup.Basic

/-!
# Classes of products of ramified prime ideals

The binary choices are independent as ideals; class-group relations come from
principality of their product. Squaring any such product gives the rational
principal ideal generated by the product of the selected rational primes.
-/

namespace HDec.CMBranch.FowlerArithmetic

open scoped nonZeroDivisors
open NumberField IsDedekindDomain

variable {K ι : Type*} [Field K] [NumberField K] [Fintype ι]

/-- The integral ideal obtained by taking each chosen prime at most once. -/
noncomputable def genusIdeal (P : ι → HeightOneSpectrum (𝓞 K))
    (a : ι → ZMod 2) : (Ideal (𝓞 K))⁰ :=
  ∏ i, (⟨(P i).asIdeal, mem_nonZeroDivisors_of_ne_zero (P i).ne_bot⟩ :
    (Ideal (𝓞 K))⁰) ^ (a i).val

/-- The natural squarefree integer indexed by the same binary choices. -/
noncomputable def genusInteger (p : ι → ℕ) (a : ι → ZMod 2) : ℕ :=
  ∏ i, p i ^ (a i).val

private theorem class_of_prime_sq (P : HeightOneSpectrum (𝓞 K)) (p : ℕ)
    (h : P.asIdeal ^ 2 = Ideal.span {(p : 𝓞 K)}) :
    ClassGroup.mk0 (⟨P.asIdeal, mem_nonZeroDivisors_of_ne_zero P.ne_bot⟩ :
      (Ideal (𝓞 K))⁰) ^ 2 = 1 := by
  rw [← map_pow, ClassGroup.mk0_eq_one_iff]
  change (P.asIdeal ^ 2).IsPrincipal
  rw [h]
  exact ⟨p, rfl⟩

/-- A subset maps to the product of the actual integral ideal classes. Subset
symmetric difference is pointwise addition in `ZMod 2`. -/
noncomputable def genusClassMap (P : ι → HeightOneSpectrum (𝓞 K)) (p : ι → ℕ)
    (h : ∀ i, (P i).asIdeal ^ 2 = Ideal.span {(p i : 𝓞 K)}) :
    Multiplicative (ι → ZMod 2) →* ClassGroup (𝓞 K) where
  toFun a := ClassGroup.mk0 (genusIdeal P a.toAdd)
  map_one' := by simp [genusIdeal, show (1 : Multiplicative (ι → ZMod 2)).toAdd = 0 from rfl]
  map_mul' a b := by
    simp only [genusIdeal, map_prod, map_pow, ← Finset.prod_mul_distrib]
    apply Finset.prod_congr rfl
    intro i _
    change _ ^ (a.toAdd i + b.toAdd i).val = _
    rw [ZMod.val_add, ← pow_add]
    exact pow_eq_pow_of_modEq (Nat.mod_mod _ _) (class_of_prime_sq (P i) (p i) (h i))

@[simp] theorem genusClassMap_apply (P : ι → HeightOneSpectrum (𝓞 K)) (p : ι → ℕ)
    (h : ∀ i, (P i).asIdeal ^ 2 = Ideal.span {(p i : 𝓞 K)})
    (a : Multiplicative (ι → ZMod 2)) :
    genusClassMap P p h a = ClassGroup.mk0 (genusIdeal P a.toAdd) := rfl

theorem genusClassMap_sq (P : ι → HeightOneSpectrum (𝓞 K)) (p : ι → ℕ)
    (h : ∀ i, (P i).asIdeal ^ 2 = Ideal.span {(p i : 𝓞 K)})
    (a : Multiplicative (ι → ZMod 2)) : genusClassMap P p h a ^ 2 = 1 := by
  have ha : a ^ 2 = 1 := by
    change (2 : ℕ) • a.toAdd = 0
    funext i
    change (2 : ℕ) • a.toAdd i = 0
    rw [nsmul_eq_mul]
    have hz : ((2 : ℕ) : ZMod 2) = 0 := ZMod.natCast_self 2
    rw [hz, zero_mul]
  rw [← map_pow, ha, map_one]

omit [NumberField K] in
theorem genusIdeal_sq (P : ι → HeightOneSpectrum (𝓞 K)) (p : ι → ℕ)
    (h : ∀ i, (P i).asIdeal ^ 2 = Ideal.span {(p i : 𝓞 K)}) (a : ι → ZMod 2) :
    (genusIdeal P a : Ideal (𝓞 K)) ^ 2 = Ideal.span {(genusInteger p a : 𝓞 K)} := by
  classical
  let c := (nonZeroDivisors (Ideal (𝓞 K))).subtype
  change (c (∏ i, _ ^ (a i).val)) ^ 2 = _
  rw [map_prod, ← Finset.prod_pow, genusInteger, Nat.cast_prod, ← Ideal.prod_span_singleton]
  apply Finset.prod_congr rfl
  intro i _
  rw [map_pow]
  change ((P i).asIdeal ^ (a i).val) ^ 2 = Ideal.span {((p i ^ (a i).val : ℕ) : 𝓞 K)}
  rw [← pow_mul, mul_comm (a i).val, pow_mul, h, Nat.cast_pow, Ideal.span_singleton_pow]

/-- A relation among the ramified classes gives an actual integral generator whose
square is the selected rational prime product times an integral unit. -/
theorem genusClassMap_ker_generator (P : ι → HeightOneSpectrum (𝓞 K)) (p : ι → ℕ)
    (h : ∀ i, (P i).asIdeal ^ 2 = Ideal.span {(p i : 𝓞 K)})
    (a : (genusClassMap P p h).ker) :
    ∃ (α : 𝓞 K) (u : (𝓞 K)ˣ),
      (genusIdeal P a.1.toAdd : Ideal (𝓞 K)) = Ideal.span {α} ∧
      α ^ 2 = (genusInteger p a.1.toAdd : 𝓞 K) * u := by
  have h1 : ClassGroup.mk0 (genusIdeal P a.1.toAdd) = 1 := a.2
  have hp := (ClassGroup.mk0_eq_one_iff (genusIdeal P a.1.toAdd).2).mp h1
  obtain ⟨α, hα⟩ := hp
  have hsq := genusIdeal_sq P p h a.1.toAdd
  rw [hα, Ideal.span_singleton_pow] at hsq
  obtain ⟨u, hu⟩ := Ideal.span_singleton_eq_span_singleton.mp hsq.symm
  exact ⟨α, u, hα, hu.symm⟩

end HDec.CMBranch.FowlerArithmetic
