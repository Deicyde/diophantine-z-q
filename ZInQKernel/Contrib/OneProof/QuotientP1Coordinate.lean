/-!
# p1-quot: the glue field `quotientP1Coordinate` from published leaves

`HDec.MCRGlue.QuotientP1Coordinate` (`ZInQKernel/OneProof/H/TailW.lean`; bundle field
`HDec.HSyn.OpenGlue7.quotientP1Coordinate`): for the smooth model `𝒴` at `p > 324` and a triple with R1fp, R1hecke,
R2fp, a finite `q : 𝒴 → 𝒵` over `ℤ_(p)` and `ρ' : 𝒵 ≅ P¹_{ℤ_(p)}` (by charts) with the fibre relation `CoordFibres`
for `ρ' ∘ q` (the tame quotient `𝒴/Γ' = P¹`, SGA 1 Exp. V).

Main theorem (no `sorry`, standard axioms; no project glue among its hypotheses):

```
HDec.MCRQuot.quotientP1Coordinate_of_printed
    (hAF : ProperCurveAF) (hQE : FiniteQuotientExists) (hTS : TameQuotientSmooth)
    (hP1 : SmoothModelOfP1)                    -- mcr-glue's leaves L1-L4 (TailW)
    (hE : EdixhovenFixedSmooth2)               -- Edixhoven 1992 Prop. 3.4 (group generated by two automorphisms)
    (hW : AtkinLehnerFixesCM24)                -- w₆ fixes the ℤ[√−6] CM pairs (Ogg 1983, Rotger 2004)
    (hT : PkgI2.TorsionStructure.{0})          -- T5 (the chain: from mumfordTorsionAlgClosed)
    (hYI : PropTSGlue.HeckeIrreducible)        -- the chain: from deligneComponentsY3PrintedAb
    (hQ : HeckeRest.QMAutCard) (hAL : HeckeRest.ALFixedPoints) :  -- the chain: from QMCentralizerCM
    MCRGlue.QuotientP1Coordinate
```

Route: `MCRGlue.quotientP1Coordinate_of_leaves`'s plumbing with mcr-glue's glue A, B, C proved by mcr-quot's
development (helpers `QuotientP1/MCRQuotA.lean`, `QuotientP1/MCRQuotB.lean`); mcr-quot's foundational glue `P1SchemeQ`
proved (`QuotientP1/P1Scheme.lean`); glue C1 proved from Edixhoven's theorem without mcr-glue's leaves L5, L6 and
without involutions (`QuotientP1/FixedDisjoint.lean`); the nontrivial Hecke stabilizers of the three CM classes
(`CMStabObjWeak`) proved from T5, `QMAutCard`, `ALFixedPoints` and the Atkin–Lehner leaf (`QuotientP1/CMStab.lean`).
`CurveBijIso` is curve-split's `_root_.CurveSplit.curveBijIso` (`TailR`); `ModelYIrreducible` is the chain's
`HeckeIrreducible` (same body, `rfl`); Lemma NV (`CoverModelOfHeckeN`) is not used. `QuotientP1/FromFields.lean`
derives the chain inputs from its fields (`quotientP1Coordinate_of_fields`), with `HeckeIrreducible` from the
abelian-scheme Deligne leaf without Mumford's rigidity. docs/research/p1-quot.md.
-/


namespace HDec

set_option maxHeartbeats 1000000

attribute [-instance] TauCeti.FinitePadicExtension.toAlgebra
  TauCeti.FinitePadicExtension.ofInstances TauCeti.FinitePadicExtension.toModuleFinite
  TauCeti.FinitePadicExtension.toValuativeExtension

/-! ════════════════════════════════════════════════════════════════════════════════════════════
# p1-quot: `QuotientP1Coordinate` from printed leaves

`P1SchemeQ` is proved (`QuotientP1Proof.p1SchemeQ_body`, `QuotientP1/P1Scheme.lean`); glue C1 is proved from
Edixhoven's theorem for two generators without L5, L6 or involutions (`cMSectionsDisjoint'_of`,
`QuotientP1/FixedDisjoint.lean`); the CM stabilizers `CMStabObjWeak` are proved from T5, the chain's `QMAutCard`
and `ALFixedPoints`, and the Atkin–Lehner leaf `AtkinLehnerFixesCM24` (`QuotientP1/CMStab.lean`); `CurveBijIso` is curve-split's theorem; `ModelYIrreducible` is the chain's
`PropTSGlue.HeckeIrreducible` (same body, `rfl`).
════════════════════════════════════════════════════════════════════════════════════════════ -/

namespace MCRQuot

open MCRGlue ModelGlue LeafQM LeafQM.AV

/-- **(B-P¹) `P1SchemeQ`, proved** (the relative projective line of the vendored CloudW07 library). -/
theorem p1SchemeQ : P1SchemeQ := _root_.QuotientP1Proof.p1SchemeQ_body

/-- `ModelYIrreducible` is the chain's `HeckeIrreducible`. -/
theorem modelYIrreducible_iff : ModelYIrreducible = PropTSGlue.HeckeIrreducible := rfl

/-- **`QuotientP1Coordinate` from mcr-glue's leaves L1-L6, T5, `CurveBijIso`, `HeckeIrreducible` and
`CMStabObj`.** -/
theorem quotientP1Coordinate_of_leaves' (hAF : ProperCurveAF) (hQE : FiniteQuotientExists)
    (hTS : TameQuotientSmooth) (hP1 : SmoothModelOfP1) (hFix : TameFixedPointsDisjoint)
    (hCyc : TameInertiaCyclic) (hT : ObjBridge.TorsionStructure) (hC : CurveBijIso)
    (hYI : PropTSGlue.HeckeIrreducible) (hO : CMStabObj) : MCRGlue.QuotientP1Coordinate :=
  have hfix : FibreAutFixFinite := fibreAutFixFinite_of' hC hYI
  have gA : FibreAutTame := fibreAutTame_of' hT hfix
  MCRGlue.quotientP1Coordinate_of_leaves hAF hQE hTS hP1 hFix hCyc gA
    (genericQuotientP1_of'' gA hT hTS hC p1SchemeQ)
    (MCRGlue.coordinateNormalization_of (cMSectionsDisjoint_of'' gA hfix (cMStabInvolution_of hC hYI hO))
      (coordinateFromSections_of'' gA hT))

/-- **`QuotientP1Coordinate` from the leaves L1-L4, Edixhoven's tame fixed-point theorem, T5,
`HeckeIrreducible` and the glue `CMStabObjWeak`** (no L5, no L6: C1 from `cMSectionsDisjoint'_of`; `CurveBijIso` is
curve-split's `_root_.CurveSplit.curveBijIso`). The plumbing is `MCRGlue.quotientP1Coordinate_of_leaves` with C1
replaced: L1 + L2 give the quotient by `fibreAut` (finite by A), L3 makes it smooth and proper, B and L4 make it
`P¹_{ℤ_(p)}`, C2 with C1' normalizes the coordinate. -/
theorem quotientP1Coordinate_of_printed' (hAF : ProperCurveAF) (hQE : FiniteQuotientExists)
    (hTS : TameQuotientSmooth) (hP1 : SmoothModelOfP1) (hE : EdixhovenFixedSmooth2)
    (hT : PkgI2.TorsionStructure.{0}) (hYI : PropTSGlue.HeckeIrreducible) (hO : CMStabObjWeak) :
    MCRGlue.QuotientP1Coordinate := by
  intro p _ hp 𝒴 𝒜 hM hCM Y Φ π h1 hh h2
  have hC : CurveBijIso := _root_.CurveSplit.curveBijIso
  have hfix : FibreAutFixFinite := fibreAutFixFinite_of' hC hYI
  have gA : FibreAutTame := fibreAutTame_of' hT hfix
  obtain ⟨hfin, hnd⟩ := gA p hp 𝒴 𝒜 hM hCM Y Φ π h1 hh h2
  have hover := fibreAut_over 𝒴 𝒜
  obtain ⟨𝒵, q, hq, hqf⟩ :=
    hQE p 𝒴 hM.1 (hAF p 𝒴 hM.1 hM.2.1) (fibreAut 𝒴 𝒜) hfin hover
  obtain ⟨hZp, hZs⟩ := hTS p 𝒴 𝒵 q hM.1 hM.2.1 _ hfin hnd hover hq hqf
  obtain ⟨σ₀, hσ₀⟩ := genericQuotientP1_of'' gA hT hTS hC p1SchemeQ p hp 𝒴 𝒜 hM hCM Y Φ π h1 hh h2
    𝒵 q hq hqf
  obtain ⟨ρ'₀, hρ'₀⟩ := hP1 p 𝒵 hZp hZs σ₀ hσ₀
  obtain ⟨ρ', hρ', hCF⟩ := coordinateFromSections_of'' gA hT p hp 𝒴 𝒜 hM hCM Y Φ π h1 hh h2 𝒵 q hq hqf
    hZp hZs (cMSectionsDisjoint'_of hE gA hfix gQuotientPointOrbits (cMStabNontrivial_of hO)
      qbarPointsConjugate p hp 𝒴 𝒜 hM hCM Y Φ π h1 hh h2 𝒵 q hq hqf) ρ'₀ hρ'₀
  exact ⟨𝒵, q, ρ', hqf, hρ', hCF⟩

/-- **`QuotientP1Coordinate` from the leaves L1-L4, Edixhoven's tame fixed-point theorem, T5, `HeckeIrreducible`,
the chain's `QMAutCard` and the glue `CMStab24`** (the `ℤ[i]` and `ℤ[ζ₃]` clauses of `CMStabObjWeak` proved,
`QuotientP1/CMStab.lean`; the `ℤ[√−6]` object comes from the hypothesis `CMObjectsExist` of the field). -/
theorem quotientP1Coordinate_of_glue24 (hAF : ProperCurveAF) (hQE : FiniteQuotientExists)
    (hTS : TameQuotientSmooth) (hP1 : SmoothModelOfP1) (hE : EdixhovenFixedSmooth2)
    (hT : PkgI2.TorsionStructure.{0}) (hYI : PropTSGlue.HeckeIrreducible)
    (hQ : HeckeRest.QMAutCard) (h24 : CMStab24) : MCRGlue.QuotientP1Coordinate := by
  intro p _ hp 𝒴 𝒜 hM hCM Y Φ π h1 hh h2
  exact quotientP1Coordinate_of_printed' hAF hQE hTS hP1 hE hT hYI
    (cMStabObjWeak_of_cm24 hT hQ h24 hCM) p hp 𝒴 𝒜 hM hCM Y Φ π h1 hh h2

/-- **Main theorem: `QuotientP1Coordinate` from published leaves and inputs the chain supplies.** The leaves are
mcr-glue's L1-L4, Edixhoven's tame fixed-point theorem (`EdixhovenFixedSmooth2`) and the converse half of the
Atkin–Lehner fixed-point theorem at `ℤ[√−6]` (`AtkinLehnerFixesCM24`); the chain supplies T5, `HeckeIrreducible`,
`QMAutCard` and `ALFixedPoints`. No project glue is left. -/
theorem quotientP1Coordinate_of_printed (hAF : ProperCurveAF) (hQE : FiniteQuotientExists)
    (hTS : TameQuotientSmooth) (hP1 : SmoothModelOfP1) (hE : EdixhovenFixedSmooth2)
    (hW : AtkinLehnerFixesCM24) (hT : PkgI2.TorsionStructure.{0}) (hYI : PropTSGlue.HeckeIrreducible)
    (hQ : HeckeRest.QMAutCard) (hAL : HeckeRest.ALFixedPoints) : MCRGlue.QuotientP1Coordinate := by
  intro p _ hp 𝒴 𝒜 hM hCM Y Φ π h1 hh h2
  obtain ⟨P₄, h4⟩ := hCM.1
  exact quotientP1Coordinate_of_glue24 hAF hQE hTS hP1 hE hT hYI hQ (cmStab24_of hT hW hAL hQ P₄ h4)
    p hp 𝒴 𝒜 hM hCM Y Φ π h1 hh h2

end MCRQuot

end HDec
