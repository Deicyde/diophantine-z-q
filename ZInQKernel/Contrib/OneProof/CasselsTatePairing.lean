import ZInQKernel.Contrib.OneProof.Lemma54FromCasselsTate

/-!
# The Cassels–Tate pairing, as printed, gives the Cassels–Tate square property

`SelmerTwoPower.CasselsTateSquare E` (`Lemma54FromCasselsTate.lean`), the input of the manuscript's
Lemma 5.4 there, is a consequence of the Cassels–Tate pairing. This file states the pairing theorem in
its printed form, as an existence statement over the genuine `Ш(E/ℚ)` (`SelmerTwoPower.sha E`), and
proves that consequence:

* `QZ`: `ℚ/ℤ`;
* `divisiblePart A`: the maximal divisible subgroup of an abelian group `A` (the subgroup generated by
  its divisible subgroups);
* `CasselsTatePairing E`: there is a biadditive pairing `Ш(E/ℚ) × Ш(E/ℚ) → ℚ/ℤ` that is alternating
  and whose kernel is the maximal divisible subgroup of `Ш(E/ℚ)`. This is Cassels' theorem for
  elliptic curves (J. W. S. Cassels, *Arithmetic on curves of genus 1. IV. Proof of the
  Hauptvermutung*, J. reine angew. Math. 211 (1962), 95–112; Tate, Proc. ICM Stockholm 1962;
  J. S. Milne, *Arithmetic Duality Theorems*, 2nd ed., I Theorem 6.13 (a): the kernels are the
  divisible subgroups; B. Poonen and M. Stoll, *The Cassels–Tate pairing on polarized abelian
  varieties*, Ann. of Math. 150 (1999), for the alternating property, which the manuscript cites at
  Lemma 5.4), stated without naming the pairing, so weaker than the print. Poonen–Stoll is the cited and
  read statement, but a report: its introduction restates Cassels' theorem without proving
  it, so the row is GLUE until a proof (Cassels 1962 or Milne I.6) is page-read and passes a
  two-lens check; Tate 1962 is background;
* `exists_nsmul_eq_zero_H1`: every class of `H¹(G_ℚ, E(ℚˢ))` has finite order;
* `isSquare_card_tors_two_of_alternating`: a finite abelian `2`-group with a non-degenerate alternating
  `ℚ/ℤ`-valued pairing has a `2`-torsion subgroup of square order;
* `casselsTateSquare_of_pairing`: `CasselsTatePairing E → CasselsTateSquare E`;
* `PoleS12.CasselsTatePairingCurves`: `CasselsTatePairing` for the curves `E_ℓ` of Theorem 5.3, and the
  consumers `PoleS12.lemma54At_of_casselsTatePairing` (Lemma 5.4 at the curves `E_ℓ`),
  `PoleS12.lemma54_of_casselsTatePairing` (the cited leaf `PoleS12.Lemma54`) and
  `PoleS12.poleCompleteness_of_restrictedConverseGenuine_casselsTatePairing` (Theorem 5.2 from Theorem 5.3, the
  Cassels–Tate pairing of the curves `E_ℓ`, modularity and Kolyvagin's theorem).

Literature check of `CasselsTatePairing` against the print: `docs/research/cassels-tate-pairing.md`.
-/

noncomputable section

namespace ZInQ.Manuscript.SelmerTwoPower

open TauCeti TauCeti.ContCohomology ZInQ.Cofinite

/-- `ℚ/ℤ`. -/
abbrev QZ : Type := ℚ ⧸ AddSubgroup.zmultiples (1 : ℚ)

/-- **The maximal divisible subgroup** of an abelian group: the subgroup generated by the divisible
subgroups (a subgroup `H` is divisible when every `h ∈ H` has an `n`-th part in `H` for every
`n ≠ 0`). -/
def divisiblePart (A : Type*) [AddCommGroup A] : AddSubgroup A :=
  sSup {H : AddSubgroup A | ∀ h ∈ H, ∀ n : ℕ, n ≠ 0 → ∃ g ∈ H, n • g = h}

/-- A divisible subgroup lies in the maximal divisible subgroup. -/
theorem le_divisiblePart {A : Type*} [AddCommGroup A] {H : AddSubgroup A}
    (hH : ∀ h ∈ H, ∀ n : ℕ, n ≠ 0 → ∃ g ∈ H, n • g = h) : H ≤ divisiblePart A :=
  le_sSup hH

/-- **The maximal divisible subgroup is divisible**: every element of `divisiblePart A` has an `n`-th
part in `divisiblePart A`, for every `n ≠ 0`. With `le_divisiblePart`, `divisiblePart A` is the largest
divisible subgroup of `A`. -/
theorem divisiblePart_divisible {A : Type*} [AddCommGroup A] {x : A}
    (hx : x ∈ divisiblePart A) {n : ℕ} (hn : n ≠ 0) : ∃ g ∈ divisiblePart A, n • g = x := by
  rw [divisiblePart, sSup_eq_iSup', AddSubgroup.iSup_eq_closure] at hx
  induction hx using AddSubgroup.closure_induction with
  | mem y hy =>
    obtain ⟨⟨H, hH⟩, hyH⟩ := Set.mem_iUnion.mp hy
    obtain ⟨g, hgH, hg⟩ := hH y hyH n hn
    exact ⟨g, le_divisiblePart hH hgH, hg⟩
  | zero => exact ⟨0, zero_mem _, by simp⟩
  | add y z _ _ hy hz =>
    obtain ⟨g, hg, hgy⟩ := hy
    obtain ⟨g', hg', hgz⟩ := hz
    exact ⟨g + g', add_mem hg hg', by rw [nsmul_add, hgy, hgz]⟩
  | neg y _ hy =>
    obtain ⟨g, hg, hgy⟩ := hy
    exact ⟨-g, neg_mem hg, by rw [smul_neg, hgy]⟩

/-- Every element of the maximal divisible subgroup is divisible by every `n ≠ 0`. -/
theorem exists_nsmul_eq_of_mem_divisiblePart {A : Type*} [AddCommGroup A] {x : A}
    (hx : x ∈ divisiblePart A) {n : ℕ} (hn : n ≠ 0) : ∃ g : A, n • g = x := by
  obtain ⟨g, -, hg⟩ := divisiblePart_divisible hx hn
  exact ⟨g, hg⟩

/-- **The Cassels–Tate pairing for an elliptic curve `E/ℚ`** (existence form): an alternating
biadditive pairing `Sha(E/ℚ) × Sha(E/ℚ) → ℚ/ℤ` with left radical equal to the maximal divisible
subgroup. This is Cassels' elliptic-curve theorem as reported (restated, not proved) in
Poonen–Stoll, Ann. of Math. (2)
150 (1999), 1109–1149, Introduction, first paragraph (p. 2 of the author's version, p. 1110 of the journal; see the remarks
after Corollary 12 for alternation). The manuscript cites it at `diophantine_zq.tex` L1079–1081.
Milne, *Arithmetic Duality Theorems*, 2nd ed., I.6.13(a), p. 82, gives the kernels on each primary
component for the pairing with the dual; see p. 81 for alternation under the polarization defined
by a rational divisor. The pairing is not named here. -/
def CasselsTatePairing (E : WeierstrassCurve ℚ) : Prop :=
  ∃ b : sha E →+ sha E →+ QZ, (∀ x, b x x = 0) ∧
    ∀ x, (∀ y, b x y = 0) ↔ x ∈ divisiblePart (sha E)

/-- **Every class of `H¹(G_ℚ, E(ℚˢ))` has finite order** (continuous cohomology of a profinite group
with discrete coefficients is torsion in positive degree). -/
theorem exists_nsmul_eq_zero_H1 (E : WeierstrassCurve ℚ)
    (c : H1 (AbsoluteGaloisGroup ℚ) E.PointCoeff) : ∃ n : ℕ, n ≠ 0 ∧ n • c = 0 := by
  -- transport along the comparison `H¹ ≃+ continuousCohomology 1 (ofDiscreteModule ℤ G_ℚ E(ℚˢ))`,
  -- whose target is torsion: `G_ℚ` is compact and the coefficients are discrete
  set e := explicitH1AddEquivContinuousCohomology (AbsoluteGaloisGroup ℚ) E.PointCoeff
  obtain ⟨n, hn, h⟩ := isOfFinAddOrder_iff_nsmul_eq_zero.1
    (TauCeti.ContinuousCohomology.isAddTorsion_continuousCohomology
      (X := ofDiscreteModule ℤ (AbsoluteGaloisGroup ℚ) E.PointCoeff) 0 (e c))
  refine ⟨n, hn.ne', e.injective ?_⟩
  rw [map_nsmul, map_zero]
  exact h

private lemma qz_nsmul_mk (n : ℕ) (q : ℚ) :
    n • (QuotientAddGroup.mk q : QZ) = QuotientAddGroup.mk ((n : ℚ) * q) := by
  rw [← QuotientAddGroup.mk_nsmul, nsmul_eq_mul]

private lemma qz_tors_finite_card_le (n : ℕ) (hn : n ≠ 0) :
    Finite (tors QZ n) ∧ Nat.card (tors QZ n) ≤ n := by
  let e : QZ := QuotientAddGroup.mk ((n : ℚ)⁻¹)
  have hnq : (n : ℚ) ≠ 0 := by exact_mod_cast hn
  have he : n • e = 0 := by
    rw [qz_nsmul_mk, mul_inv_cancel₀ hnq, QuotientAddGroup.eq_zero_iff]
    exact AddSubgroup.mem_zmultiples 1
  have ht : tors QZ n = AddSubgroup.zmultiples e := by
    ext z
    rw [mem_tors, AddSubgroup.mem_zmultiples_iff]
    constructor
    · intro hz
      induction z using QuotientAddGroup.induction_on with
      | H q =>
        rw [qz_nsmul_mk, QuotientAddGroup.eq_zero_iff] at hz
        obtain ⟨a, ha⟩ := AddSubgroup.mem_zmultiples_iff.mp hz
        simp only [zsmul_eq_mul, mul_one] at ha
        have hq : (a : ℚ) * (n : ℚ)⁻¹ = q := by
          rw [ha, mul_comm (n : ℚ) q, mul_assoc, mul_inv_cancel₀ hnq, mul_one]
        refine ⟨a, ?_⟩
        change a • (QuotientAddGroup.mk ((n : ℚ)⁻¹) : QZ) = QuotientAddGroup.mk q
        rw [← QuotientAddGroup.mk_zsmul, zsmul_eq_mul, hq]
    · rintro ⟨a, rfl⟩
      rw [smul_comm, he, zsmul_zero]
  rw [ht]
  exact ⟨(isOfFinAddOrder_iff_nsmul_eq_zero.mpr ⟨n, Nat.pos_of_ne_zero hn, he⟩).finite_zmultiples,
    by rw [Nat.card_zmultiples]; exact addOrderOf_le_of_nsmul_eq_zero (Nat.pos_of_ne_zero hn) he⟩

private lemma alternating_skew {F : Type} [AddCommGroup F]
    (β : F →+ F →+ QZ) (halt : ∀ f, β f f = 0) (a b : F) :
    β a b = -β b a := by
  apply eq_neg_iff_add_eq_zero.mpr
  have h := halt (a + b)
  simpa only [map_add, AddMonoidHom.add_apply, halt, zero_add, add_zero, add_comm] using h

/-- **A finite abelian `2`-group with a non-degenerate alternating `ℚ/ℤ`-valued pairing has a
`2`-torsion subgroup of square order** (it splits as `B × B`). -/
theorem isSquare_card_tors_two_of_alternating {F : Type} [AddCommGroup F] [Finite F]
    (h2 : ∀ f : F, ∃ k : ℕ, 2 ^ k • f = 0) (β : F →+ F →+ QZ)
    (halt : ∀ f, β f f = 0) (hnd : ∀ f, (∀ g, β f g = 0) → f = 0) :
    IsSquare (Nat.card (tors F 2)) := by
  classical
  suffices H : ∀ (N : ℕ) (F : Type) [AddCommGroup F] [Finite F], Nat.card F = N →
      (∀ f : F, ∃ k : ℕ, 2 ^ k • f = 0) → ∀ β : F →+ F →+ QZ,
      (∀ f, β f f = 0) → (∀ f, (∀ g, β f g = 0) → f = 0) →
      IsSquare (Nat.card (tors F 2)) from H _ F rfl h2 β halt hnd
  intro N
  induction N using Nat.strong_induction_on with
  | _ N ih =>
    intro F _ _ hcard h2 β halt hnd
    by_cases hzero : ∀ f : F, f = 0
    · have : Subsingleton F := ⟨fun a b => (hzero a).trans (hzero b).symm⟩
      exact ⟨1, by rw [Nat.card_unique]⟩
    -- A pairing value of maximal order supplies a common exponent for the whole group.
    obtain ⟨xy, hmax⟩ := Finite.exists_max (fun xy : F × F => addOrderOf (β xy.1 xy.2))
    let x : F := xy.1
    let y : F := xy.2
    let c : QZ := β x y
    have horders (f g : F) : ∃ k : ℕ, addOrderOf (β f g) = 2 ^ k := by
      obtain ⟨k, hk⟩ := h2 f
      have hkβ : 2 ^ k • β f g = 0 := by
        have h := congrArg (fun t : F => β t g) hk
        simpa only [map_nsmul, AddMonoidHom.nsmul_apply, map_zero,
          AddMonoidHom.zero_apply] using h
      obtain ⟨j, _, hj⟩ := (Nat.dvd_prime_pow Nat.prime_two).mp
        (addOrderOf_dvd_of_nsmul_eq_zero hkβ)
      exact ⟨j, hj⟩
    obtain ⟨k, hk⟩ := horders x y
    change addOrderOf c = 2 ^ k at hk
    have hn : addOrderOf c ≠ 0 := by rw [hk]; positivity
    have hkill (f g : F) : addOrderOf c • β f g = 0 := by
      obtain ⟨j, hj⟩ := horders f g
      have hm : addOrderOf (β f g) ≤ addOrderOf c := hmax (f, g)
      have hjk : j ≤ k := (Nat.pow_le_pow_iff_right (by decide : 1 < 2)).mp
        (by simpa only [hj, hk] using hm)
      apply addOrderOf_dvd_iff_nsmul_eq_zero.mp
      rw [hj, hk]
      exact Nat.pow_dvd_pow 2 hjk
    have hexp (f : F) : addOrderOf c • f = 0 := by
      apply hnd
      intro g
      simpa only [map_nsmul, AddMonoidHom.nsmul_apply] using hkill f g
    have hc0 : c ≠ 0 := by
      intro hc
      apply hzero
      intro f
      have h := hexp f
      simpa only [hc, addOrderOf_zero, one_nsmul] using h
    have hkpos : 1 ≤ k := by
      by_contra h
      have hk0 : k = 0 := by omega
      apply hc0
      apply AddMonoid.addOrderOf_eq_one_iff.mp
      simpa only [hk0, pow_zero] using hk
    have htwo : 2 ∣ addOrderOf c := by
      rw [hk]
      simpa only [pow_one] using (Nat.pow_dvd_pow 2 hkpos : 2 ^ 1 ∣ 2 ^ k)
    -- The bounded torsion in ℚ/ℤ is cyclic, and c generates all pairing values.
    let C : AddSubgroup QZ := AddSubgroup.zmultiples c
    obtain ⟨hTfin, hTcard⟩ := qz_tors_finite_card_le (addOrderOf c) hn
    have : Finite (tors QZ (addOrderOf c)) := hTfin
    have hCeq : C = tors QZ (addOrderOf c) := by
      apply AddSubgroup.eq_of_le_of_card_ge
      · intro a ha
        obtain ⟨j, rfl⟩ := AddSubgroup.mem_zmultiples_iff.mp ha
        rw [mem_tors, smul_comm, addOrderOf_nsmul_eq_zero, zsmul_zero]
      · simpa only [C, Nat.card_zmultiples] using hTcard
    have : Finite C := by rw [hCeq]; infer_instance
    have hmem (f g : F) : β f g ∈ C := by
      rw [hCeq, mem_tors]
      exact hkill f g
    let c₀ : C := ⟨c, AddSubgroup.mem_zmultiples c⟩
    have hgen : ∀ a : C, a ∈ AddSubgroup.zmultiples c₀ := by
      intro a
      obtain ⟨j, hj⟩ := AddSubgroup.mem_zmultiples_iff.mp a.2
      exact AddSubgroup.mem_zmultiples_iff.mpr ⟨j, Subtype.ext hj⟩
    have hdx : addOrderOf x ∣ addOrderOf c₀ := by
      rw [AddSubgroup.addOrderOf_mk]
      exact addOrderOf_dvd_of_nsmul_eq_zero (hexp x)
    have hdy : addOrderOf y ∣ addOrderOf c₀ := by
      rw [AddSubgroup.addOrderOf_mk]
      exact addOrderOf_dvd_of_nsmul_eq_zero (hexp y)
    let fx : C →+ F := addMonoidHomOfForallMemZMultiples hgen hdx
    let fy : C →+ F := addMonoidHomOfForallMemZMultiples hgen hdy
    have hfx : fx c₀ = x := addMonoidHomOfForallMemZMultiples_apply_gen hgen hdx
    have hfy : fy c₀ = y := addMonoidHomOfForallMemZMultiples_apply_gen hgen hdy
    -- The two pairing coordinates retract the subgroup generated by x and y onto C × C.
    let rx : F →+ C := (β.flip y).codRestrict C (fun z => hmem z y)
    let ry : F →+ C := (β x).codRestrict C (fun z => hmem x z)
    let r : F →+ C × C := rx.prod ry
    let φ : C × C →+ F := fx.comp (AddMonoidHom.fst C C) +
      fy.comp (AddMonoidHom.snd C C)
    have hrφ : ∀ a, r (φ a) = a := by
      rintro ⟨a, b⟩
      obtain ⟨i, hi⟩ := AddSubgroup.mem_zmultiples_iff.mp (hgen a)
      obtain ⟨j, hj⟩ := AddSubgroup.mem_zmultiples_iff.mp (hgen b)
      rw [← hi, ← hj]
      apply Prod.ext
      · apply Subtype.ext
        change β (φ (i • c₀, j • c₀)) y = i • c
        simp [φ, hfx, hfy, halt, c]
      · apply Subtype.ext
        change β x (φ (i • c₀, j • c₀)) = j • c
        simp [φ, hfx, hfy, halt, c]
    -- The restricted pairing remains non-degenerate on the orthogonal complement.
    let B : AddSubgroup F := r.ker
    let βB : B →+ B →+ QZ :=
      { toFun := fun w => (β (w : F)).comp B.subtype
        map_zero' := by ext v; simp
        map_add' := by intro w v; ext u; simp }
    have hndB : ∀ w : B, (∀ v, βB w v = 0) → w = 0 := by
      intro w hw
      apply Subtype.ext
      apply hnd (w : F)
      have hr : r (w : F) = 0 := AddMonoidHom.mem_ker.mp w.2
      have hwy : β (w : F) y = 0 :=
        congrArg (fun a : C × C => (a.1 : QZ)) hr
      have hxw : β x (w : F) = 0 :=
        congrArg (fun a : C × C => (a.2 : QZ)) hr
      have hwx : β (w : F) x = 0 := by
        rw [alternating_skew β halt, hxw, neg_zero]
      have hwφ : ∀ a, β (w : F) (φ a) = 0 := by
        rintro ⟨a, b⟩
        obtain ⟨i, hi⟩ := AddSubgroup.mem_zmultiples_iff.mp (hgen a)
        obtain ⟨j, hj⟩ := AddSubgroup.mem_zmultiples_iff.mp (hgen b)
        rw [← hi, ← hj]
        simp [φ, hfx, hfy, hwy, hwx]
      intro z
      let v : B := ⟨z - φ (r z), AddMonoidHom.mem_ker.mpr (by
        rw [map_sub, hrφ, sub_self])⟩
      have hv := hw v
      change β (w : F) (z - φ (r z)) = 0 at hv
      rw [map_sub, hwφ, sub_zero] at hv
      exact hv
    let ι : B → F := fun b => b.1
    have hι : Function.Injective ι := Subtype.coe_injective
    have hnot : ¬Function.Surjective ι := by
      intro hs
      obtain ⟨b, hb⟩ := hs x
      have hr : r (b : F) = 0 := AddMonoidHom.mem_ker.mp b.2
      have hby : β (b : F) y = 0 :=
        congrArg (fun a : C × C => (a.1 : QZ)) hr
      apply hc0
      change (b : F) = x at hb
      simpa only [hb] using hby
    have hlt : Nat.card B < N := by
      let : Fintype F := Fintype.ofFinite F
      let : Fintype B := Fintype.ofFinite B
      rw [← hcard, Nat.card_eq_fintype_card, Nat.card_eq_fintype_card]
      exact Fintype.card_lt_of_injective_not_surjective ι hι hnot
    have h2B : ∀ w : B, ∃ k : ℕ, 2 ^ k • w = 0 := by
      intro w
      obtain ⟨k, hk⟩ := h2 (w : F)
      exact ⟨k, Subtype.ext (by simpa using hk)⟩
    obtain ⟨s, hs⟩ := ih (Nat.card B) hlt B rfl h2B βB (fun w => halt (w : F)) hndB
    have hCt : Nat.card (tors C 2) = 2 := by
      change Nat.card (nsmulAddMonoidHom (α := C) 2).ker = 2
      rw [IsAddCyclic.card_nsmulAddMonoidHom_ker C 2, Nat.card_zmultiples,
        Nat.gcd_eq_right htwo]
    refine ⟨2 * s, ?_⟩
    calc
      Nat.card (tors F 2) = Nat.card (tors ((C × C) × B) 2) :=
        card_tors_congr (splitEquiv φ r hrφ) 2
      _ = (Nat.card (tors C 2) * Nat.card (tors C 2)) * Nat.card (tors B 2) := by
        rw [card_tors_prod, card_tors_prod]
      _ = (2 * s) * (2 * s) := by rw [hCt, hs]; ring

/-- An element killed by two coprime integers is zero. -/
private theorem eq_zero_of_coprime_nsmul {A : Type*} [AddCommGroup A] {q : A} {r s : ℕ}
    (hrs : Nat.Coprime r s) (hr : r • q = 0) (hs : s • q = 0) : q = 0 := by
  have hd := Nat.dvd_gcd (addOrderOf_dvd_of_nsmul_eq_zero hr) (addOrderOf_dvd_of_nsmul_eq_zero hs)
  rw [hrs.gcd_eq_one, Nat.dvd_one, AddMonoid.addOrderOf_eq_one_iff] at hd
  exact hd

/-- A biadditive pairing on a torsion group: an element of `2`-power order that pairs to zero with
every element of `2`-power order pairs to zero with every element (split off the odd part). -/
private theorem pairing_eq_zero_of_twoPrimary {G : Type*} [AddCommGroup G] (b : G →+ G →+ QZ)
    {x : G} {kx : ℕ} (hx : 2 ^ kx • x = 0) (hfin : ∀ y : G, ∃ n : ℕ, n ≠ 0 ∧ n • y = 0)
    (h2 : ∀ s : G, (∃ k : ℕ, 2 ^ k • s = 0) → b x s = 0) (y : G) : b x y = 0 := by
  obtain ⟨N, hN0, hNy⟩ := hfin y
  obtain ⟨a, m, hm, rfl⟩ := Nat.exists_eq_two_pow_mul_odd hN0
  have hcop : Nat.Coprime (2 ^ a) m := (Nat.coprime_two_left.mpr hm).pow_left a
  have hbez : ((2 ^ a : ℕ) : ℤ) * Nat.gcdA (2 ^ a) m + (m : ℤ) * Nat.gcdB (2 ^ a) m = 1 := by
    have := Nat.gcd_eq_gcd_ab (2 ^ a) m
    rw [hcop.gcd_eq_one, Nat.cast_one] at this
    exact this.symm
  have hy : y = (((2 ^ a : ℕ) : ℤ) * Nat.gcdA (2 ^ a) m) • y +
      ((m : ℤ) * Nat.gcdB (2 ^ a) m) • y := by
    rw [← add_zsmul, hbez, one_zsmul]
  have hNy' : (((2 ^ a * m : ℕ) : ℤ)) • y = 0 := by rw [natCast_zsmul, hNy]
  have hy2 : 2 ^ a • (((m : ℤ) * Nat.gcdB (2 ^ a) m) • y) = 0 := by
    rw [← natCast_zsmul, smul_smul,
      show ((2 ^ a : ℕ) : ℤ) * ((m : ℤ) * Nat.gcdB (2 ^ a) m) =
        Nat.gcdB (2 ^ a) m * ((2 ^ a * m : ℕ) : ℤ) by push_cast; ring,
      ← smul_smul, hNy', smul_zero]
  have hy1 : m • ((((2 ^ a : ℕ) : ℤ) * Nat.gcdA (2 ^ a) m) • y) = 0 := by
    rw [← natCast_zsmul, smul_smul,
      show (m : ℤ) * (((2 ^ a : ℕ) : ℤ) * Nat.gcdA (2 ^ a) m) =
        Nat.gcdA (2 ^ a) m * ((2 ^ a * m : ℕ) : ℤ) by push_cast; ring,
      ← smul_smul, hNy', smul_zero]
  have h1 : b x ((((2 ^ a : ℕ) : ℤ) * Nat.gcdA (2 ^ a) m) • y) = 0 := by
    refine eq_zero_of_coprime_nsmul ((Nat.coprime_two_left.mpr hm).pow_left kx) ?_ ?_
    · rw [← AddMonoidHom.nsmul_apply, ← map_nsmul, hx, map_zero, AddMonoidHom.zero_apply]
    · rw [← map_nsmul, hy1, map_zero]
  rw [hy, map_add, h1, h2 _ ⟨a, hy2⟩, add_zero]

section Restriction

variable {E : WeierstrassCurve ℚ} {t : ℕ} {F : Type} [AddCommGroup F]

/-- The finite factor `F → Ш(E/ℚ)` of a decomposition `Ш(E/ℚ)[2^∞] ≅ (ℚ₂/ℤ₂)^t × F`. -/
private def finInc (e : AddCommGroup.primaryComponent (sha E) 2 ≃+ (Fin t → Q2Z2) × F) :
    F →+ sha E :=
  (AddCommGroup.primaryComponent (sha E) 2).subtype.comp
    (e.symm.toAddMonoidHom.comp (AddMonoidHom.inr _ _))

private theorem finInc_apply (e : AddCommGroup.primaryComponent (sha E) 2 ≃+ (Fin t → Q2Z2) × F)
    (f : F) : finInc e f = ((e.symm (0, f) : AddCommGroup.primaryComponent (sha E) 2) : sha E) :=
  rfl

/-- The divisible factor `(ℚ₂/ℤ₂)^t → Ш(E/ℚ)` of the decomposition. -/
private def divInc (e : AddCommGroup.primaryComponent (sha E) 2 ≃+ (Fin t → Q2Z2) × F) :
    (Fin t → Q2Z2) →+ sha E :=
  (AddCommGroup.primaryComponent (sha E) 2).subtype.comp
    (e.symm.toAddMonoidHom.comp (AddMonoidHom.inl _ _))

private theorem divInc_apply (e : AddCommGroup.primaryComponent (sha E) 2 ≃+ (Fin t → Q2Z2) × F)
    (d : Fin t → Q2Z2) :
    divInc e d = ((e.symm (d, 0) : AddCommGroup.primaryComponent (sha E) 2) : sha E) :=
  rfl

/-- Every class of `Ш(E/ℚ)[2^∞]` is a class of the divisible factor plus a class of `F`. -/
private theorem coe_eq_divInc_add_finInc
    (e : AddCommGroup.primaryComponent (sha E) 2 ≃+ (Fin t → Q2Z2) × F)
    (s : AddCommGroup.primaryComponent (sha E) 2) :
    (s : sha E) = divInc e (e s).1 + finInc e (e s).2 := by
  rw [finInc_apply, divInc_apply, ← AddSubgroup.coe_add, ← map_add, Prod.mk_add_mk, add_zero,
    zero_add, Prod.mk.eta, AddEquiv.symm_apply_apply]

/-- The divisible factor lies in the maximal divisible subgroup. -/
private theorem divInc_mem_divisiblePart
    (e : AddCommGroup.primaryComponent (sha E) 2 ≃+ (Fin t → Q2Z2) × F) (d : Fin t → Q2Z2) :
    divInc e d ∈ divisiblePart (sha E) := by
  have hdiv : ∀ x ∈ (divInc e).range, ∀ n : ℕ, n ≠ 0 → ∃ g ∈ (divInc e).range, n • g = x := by
    rintro _ ⟨d, rfl⟩ n hn
    refine ⟨divInc e (DivisibleBy.div d (n : ℤ)), ⟨_, rfl⟩, ?_⟩
    rw [← map_nsmul, ← natCast_zsmul, DivisibleBy.div_cancel d (by exact_mod_cast hn)]
  exact le_divisiblePart hdiv ⟨d, rfl⟩

end Restriction

/-- **The Cassels–Tate pairing gives the Cassels–Tate square property.** For a decomposition
`Ш(E/ℚ)[2^∞] ≅ (ℚ₂/ℤ₂)^t × F` with `F` finite, the pairing restricted to `Ш[2^∞]` kills the divisible
factor, so it descends to `F`; it is non-degenerate there (an element of `F` that pairs to zero with `F`
pairs to zero with all of `Ш(E/ℚ)`, since every class has finite order, hence lies in the maximal
divisible subgroup, and the finite `2`-group `F` has no non-zero infinitely `2`-divisible element), and
alternating, so `#F[2]` is a square (`isSquare_card_tors_two_of_alternating`). -/
theorem casselsTateSquare_of_pairing (E : WeierstrassCurve ℚ) (h : CasselsTatePairing E) :
    CasselsTateSquare E := by
  classical
  obtain ⟨b, halt, hker⟩ := h
  intro t F _ _ e
  -- skew-symmetry
  have hskew : ∀ x y, b x y = -b y x := fun x y => by
    have := halt (x + y)
    simp only [map_add, AddMonoidHom.add_apply, halt, zero_add, add_zero] at this
    rw [eq_neg_iff_add_eq_zero]
    rwa [add_comm] at this
  -- the divisible factor is in the kernel
  have hδ0 : ∀ d z, b z (divInc e d) = 0 := fun d z => by
    rw [hskew, (hker (divInc e d)).mpr (divInc_mem_divisiblePart e d) z, neg_zero]
  -- `Ш[2^∞]` and `F` are `2`-groups
  have hS2 : ∀ s : AddCommGroup.primaryComponent (sha E) 2, ∃ k : ℕ, 2 ^ k • s = 0 := fun s => by
    obtain ⟨k, hk⟩ := AddCommGroup.mem_primaryComponent.mp s.2
    exact ⟨k, Subtype.ext (by rw [AddSubgroup.coe_nsmul, AddSubgroup.coe_zero]; exact hk)⟩
  have h2F : ∀ f : F, ∃ k : ℕ, 2 ^ k • f = 0 := fun f => by
    obtain ⟨k, hk⟩ := hS2 (e.symm (0, f))
    refine ⟨k, ?_⟩
    have := congrArg e hk
    rw [map_nsmul, AddEquiv.apply_symm_apply, map_zero] at this
    simpa using congrArg Prod.snd this
  obtain ⟨K, hK⟩ : ∃ K : ℕ, ∀ f : F, 2 ^ K • f = 0 := by
    have := Fintype.ofFinite F
    choose k hk using h2F
    refine ⟨Finset.univ.sup k, fun f => ?_⟩
    have hle : k f ≤ Finset.univ.sup k := Finset.le_sup (Finset.mem_univ f)
    rw [← Nat.sub_add_cancel hle, pow_add, mul_nsmul', hk, nsmul_zero]
  -- the pairing on `F`
  let β : F →+ F →+ QZ := (b.compl₂ (finInc e)).comp (finInc e)
  have hβ : ∀ f g, β f g = b (finInc e f) (finInc e g) := fun _ _ => rfl
  -- non-degeneracy on `F`
  have hnd : ∀ f, (∀ g, β f g = 0) → f = 0 := by
    intro f hf
    obtain ⟨kf, hkf⟩ := h2F f
    have hx2 : 2 ^ kf • finInc e f = 0 := by rw [← map_nsmul, hkf, map_zero]
    -- `finInc e f` pairs to zero with `Ш[2^∞]`
    have hSz : ∀ s : AddCommGroup.primaryComponent (sha E) 2, b (finInc e f) s = 0 := fun s => by
      rw [coe_eq_divInc_add_finInc e s, map_add, hδ0, zero_add, ← hβ]
      exact hf _
    -- and with every class: split off the odd part
    have hall : ∀ y, b (finInc e f) y = 0 :=
      pairing_eq_zero_of_twoPrimary b hx2 (fun y => by
          obtain ⟨N, hN0, hN⟩ := exists_nsmul_eq_zero_H1 E (y : H1 (AbsoluteGaloisGroup ℚ) E.PointCoeff)
          exact ⟨N, hN0, Subtype.ext (by rw [AddSubgroup.coe_nsmul, AddSubgroup.coe_zero]; exact hN)⟩)
        (fun s hs => hSz ⟨s, AddCommGroup.mem_primaryComponent.mpr hs⟩)
    -- so `finInc e f` lies in the maximal divisible subgroup, and `f = 0`
    have hxD := (hker (finInc e f)).mp hall
    obtain ⟨g, hg⟩ :=
      exists_nsmul_eq_of_mem_divisiblePart hxD (n := 2 ^ K) (pow_ne_zero _ two_ne_zero)
    have hgS : g ∈ AddCommGroup.primaryComponent (sha E) 2 :=
      AddCommGroup.mem_primaryComponent.mpr ⟨K + kf, by rw [pow_add, mul_comm, mul_nsmul', hg, hx2]⟩
    have he : (2 ^ K) • (⟨g, hgS⟩ : AddCommGroup.primaryComponent (sha E) 2) = e.symm (0, f) :=
      Subtype.ext (by rw [AddSubgroup.coe_nsmul, ← finInc_apply]; exact hg)
    have := congrArg e he
    rw [map_nsmul, AddEquiv.apply_symm_apply] at this
    have hf' := congrArg Prod.snd this
    simp only [Prod.smul_snd] at hf'
    rw [← hf', hK]
  exact isSquare_card_tors_two_of_alternating h2F β (fun f => (hβ f f).trans (halt _)) hnd

end ZInQ.Manuscript.SelmerTwoPower

namespace ZInQ.Manuscript.PoleS12

open ZInQ.Manuscript.SelmerTwoPower

/-- **The Cassels–Tate pairing for the curves `E_ℓ`** (`SelmerTwoPower.CasselsTatePairing` at
`E_ℓ : y² = x(x − ℓ)(x + 3ℓ)` for positive squarefree `ℓ ≡ 11 (mod 12)`, the curves of Theorem 5.3 and
Lemma 5.4). -/
def CasselsTatePairingCurves : Prop :=
  ∀ ℓ : ℕ, 0 < ℓ → Squarefree ℓ → ℓ % 12 = 11 → CasselsTatePairing (Manuscript.curve ℓ)

theorem casselsTateSquareCurves_of_pairing (h : CasselsTatePairingCurves) : CasselsTateSquareCurves :=
  fun ℓ hℓ hsf hmod => casselsTateSquare_of_pairing _ (h ℓ hℓ hsf hmod)

/-- **Lemma 5.4 at the curves `E_ℓ` from the Cassels–Tate pairing.** -/
theorem lemma54At_of_casselsTatePairing (h : CasselsTatePairingCurves) :
    PoleRC.Lemma54At SelmerTwoPower.SelmerCorankOne :=
  lemma54At_of_casselsTate (casselsTateSquareCurves_of_pairing h)

/-- **The cited leaf `Lemma54` from Mordell–Weil and the Cassels–Tate pairing.** -/
theorem lemma54_of_casselsTatePairing (hMW : PoleRC.MordellWeil)
    (h : ∀ E : WeierstrassCurve ℚ, E.IsElliptic → CasselsTatePairing E) : Lemma54 :=
  lemma54_of_casselsTate hMW fun E hE => casselsTateSquare_of_pairing E (h E hE)

/-- **Theorem 5.2 from Theorem 5.3 over the genuine Selmer condition, the Cassels–Tate pairing of the
curves `E_ℓ`, modularity and Kolyvagin's theorem.** -/
theorem poleCompleteness_of_restrictedConverseGenuine_casselsTatePairing
    (hRC : SelmerTwoPower.RestrictedConverseGenuine) (hCT : CasselsTatePairingCurves)
    (hB : BCDTThmA) (hK : KolyvaginThm1) : Manuscript.PoleCompleteness :=
  poleCompleteness_of_restrictedConverseGenuine_casselsTate hRC
    (casselsTateSquareCurves_of_pairing hCT) hB hK

end ZInQ.Manuscript.PoleS12
