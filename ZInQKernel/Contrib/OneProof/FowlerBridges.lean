import ZInQKernel.Contrib.OneProof.FowlerBridgesIdeals

/-! # Fowler's class number bound, with its proper ideal class number -/

namespace HDec.CMBranch.FowlerBridges

open NumberField Module TauCeti.GlobalNumberFields FractionalIdeal
open scoped nonZeroDivisors

variable {k : Type} [Field k] [NumberField k]

/-- The proper fractional ideal classes: quotient by multiplication by nonzero field elements.
Multiplication by the principal fractional ideal generated by `x` is scaling by `x`. -/
def ProperIdealClasses (O : NumberFieldOrder k) : Type :=
  Quot (fun I J : O.properFractionalIdeals =>
    ∃ x : kˣ, (I.val : FractionalIdeal O.toSubalgebra⁰ k) = spanSingleton _ (x : k) * J.val)

/-- The proper ideal class quotient is equivalent to the class group of invertible fractional
ideals. This applies to orders of rank two by Proposition 7.4 of Cox (1989). -/
noncomputable def properIdealClassesEquivClassGroup (O : NumberFieldOrder k)
    (hk : finrank ℚ k = 2) : ProperIdealClasses O ≃ Pic O := by
  let unitOf (I : O.properFractionalIdeals) : (FractionalIdeal O.toSubalgebra⁰ k)ˣ :=
    ((proper_iff_isUnit O hk _).mp I.property).unit
  have hrel (I J : O.properFractionalIdeals) :
      ClassGroup.mk k (unitOf I) = ClassGroup.mk k (unitOf J) ↔
      ∃ x : kˣ, I.val = spanSingleton _ (x : k) * J.val := by
    have hu (x : kˣ) :
        unitOf I = toPrincipalIdeal O.toSubalgebra k x * unitOf J ↔
          I.val = spanSingleton _ (x : k) * J.val := by
      rw [← Units.val_inj]
      simp [unitOf]
    constructor
    · intro he
      have hz : ClassGroup.mk k (unitOf I / unitOf J) = 1 := by simp [he]
      obtain ⟨x, hx⟩ := ClassGroup.mk_eq_one_iff_exists.mp hz
      exact ⟨x, (hu x).mp (div_eq_iff_eq_mul.mp hx.symm)⟩
    · rintro ⟨x, hx⟩
      rw [(hu x).mpr hx]
      simp
  let f : ProperIdealClasses O → Pic O :=
    Quot.lift (fun I => ClassGroup.mk k (unitOf I)) fun I J => (hrel I J).mpr
  refine Equiv.ofBijective f ⟨?_, ?_⟩
  · intro X Y
    induction X using Quot.ind with
    | mk I =>
      induction Y using Quot.ind with
      | mk J => exact fun h => Quot.sound ((hrel I J).mp h)
  · intro C
    refine ClassGroup.induction (K := k) (P := fun D => ∃ X, f X = D) ?_ C
    intro U
    refine ⟨Quot.mk _ ⟨U.val, O.invertible_isProper U⟩, ?_⟩
    change ClassGroup.mk k (unitOf _) = ClassGroup.mk k U
    exact congrArg (ClassGroup.mk k) (Units.ext (by simp [unitOf]))

/-- The number of proper fractional ideal classes of an order. For imaginary quadratic orders
the underlying quotient is finite by `finite_properIdealClasses`. -/
noncomputable def properClassNumber (O : NumberFieldOrder k) : ℕ :=
  Nat.card (ProperIdealClasses O)

/-- The proper fractional ideal classes of a quadratic order form a finite type. -/
theorem finite_properIdealClasses (O : NumberFieldOrder k) (hk : finrank ℚ k = 2) :
    Finite (ProperIdealClasses O) :=
  Finite.of_equiv (Pic O) (properIdealClassesEquivClassGroup O hk).symm

/-- The class number dictionary, reusable for the degree of a singular modulus. -/
theorem card_pic_eq_properClassNumber (R : Subring k) (hR : IsImagQuadOrder k R) :
    Nat.card (CommRing.Pic R) =
      properClassNumber (toOrder R hR) := by
  let O := toOrder R hR
  exact Nat.card_congr
    ((ClassGroup.equivPic O.toSubalgebra).symm.toEquiv.trans (properIdealClassesEquivClassGroup O hR.2.1).symm)

/-- Fowler, *Some uniform effective results on André–Oort for sums of powers in ℂⁿ*,
Math. Proc. Cambridge Philos. Soc. **180** (2026), Proposition 2·7, p. 615:
"Let Δ < 0 be such that Δ ≡ 0, 1 mod 4 and let k ∈ Z>0. If h(Δ) ≤ k, then
|Δ|^{1/2} ≤ 2k²e^{21000k²}."

On p. 613, `h(Δ)` is the class number of the imaginary quadratic order of discriminant `Δ`.
On p. 612, the discriminant is the discriminant of the primitive quadratic equation
of a period, and is `f²D` for the field discriminant `D`. Here `Δ` is the trace
discriminant of the order and `h(Δ)` counts proper fractional ideals modulo principal scaling.
The instance of the order is quantified explicitly, so applying the proposition does not
require a choice of a canonical order or an order uniqueness theorem.
Publisher PDF reading: fork issue #14, comment 6973387139. -/
def FowlerProp27Print : Prop :=
  ∀ (Δ : ℤ), Δ < 0 → (Δ % 4 = 0 ∨ Δ % 4 = 1) →
    ∀ (k : Type) [Field k] [NumberField k] [IsTotallyComplex k],
      finrank ℚ k = 2 → ∀ (O : NumberFieldOrder k), O.discr = Δ →
      ∀ n : ℕ, 0 < n → properClassNumber O ≤ n →
        Real.sqrt |(Δ : ℝ)| ≤
          2 * (n : ℝ) ^ 2 * Real.exp (21000 * (n : ℝ) ^ 2)

/-- The published proposition implies the live Fowler row with no other input. -/
theorem fowlerProp27_of_print : FowlerProp27Print → FowlerProp27 := by
  intro h k _ _ R hR n hn hh
  let : IsTotallyComplex k := hR.1
  let O := toOrder R hR
  obtain ⟨b⟩ := exists_intBasis_of_isImagQuadOrder R hR
  have hd : O.discr = orderDisc R := (O.discr_eq_discr b).symm.trans (orderDisc_eq_discr R hR b).symm
  exact h (orderDisc R) (orderDisc_neg R hR) (orderDisc_mod_four R hR) k hR.2.1 O hd n hn
    ((card_pic_eq_properClassNumber R hR) ▸ hh)

end HDec.CMBranch.FowlerBridges
