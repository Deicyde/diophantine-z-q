import ZInQKernel.Contrib.OneProof.X1Igusa

/-! # igusa-gal: `X1Igusa.IgusaGL2DS` from Diamond–Shurman Thm 7.6.3 stated on `Gal(ℚ(j, E_j[N])/ℚ(j))`

Task igusa-gal (2026-11-17), report `docs/research/igusa-gal.md`, scratch `scratch/igusa-gal/`.

The leaf `X1Igusa.IgusaGL2DS` (x1-igusa) states Diamond–Shurman's Theorem 7.6.3 with `σ` ranging over
`Aut(\overline{ℚ(j)}/ℚ(j))`, while the print's group is `H_ℚ = Gal(ℚ(j, E_j[N])/ℚ(j))`. Review queue14 (11-17)
rated it GLUE because passing from the print's `σ₀ ∈ H_ℚ` to an automorphism of `\overline{ℚ(j)}` is an
extension theorem. Here:

* `IgusaGL2DSGal` (LEAF, printed form): the print's statement, with `σ₀ ∈ Gal(L_N/ℚ(j))` where
  `L_N = ℚ(j, E_j[N]) = LDS N` is the subfield of `\overline{ℚ(j)}` generated over `ℚ(j)` by the `x`- and
  `y`-coordinates of the nonzero `N`-torsion points of Diamond–Shurman's `E_j` (`EDSBar`), `N > 1` as in the
  print's §7.5–7.6. `σ₀` acts on `E_j[N] ⊆ E_j(L_N)` through `Affine.Point.map`.
* `igusaGL2DS_of_igusaGL2DSGal : IgusaGL2DSGal → X1Igusa.IgusaGL2DS`: `σ = σ₀.liftNormal \overline{ℚ(j)}`
  (`\overline{ℚ(j)}/ℚ(j)` is normal, `IsAlgClosure.normal`) agrees with `σ₀` on `L_N`
  (`AlgEquiv.liftNormal_commutes`), and every point of `E_j[N]` comes from an `L_N`-point (`exists_LDS_point`).
  The case `N = 1` is proved directly (`σ = id`).

No `sorry`, no `axiom`, no build-time code. -/

noncomputable section

namespace X1Igusa

open WeierstrassCurve LeafModCurves ZInQ.RLeaf X1Belyi

/-- The `x`- and `y`-coordinates of the nonzero `N`-torsion points of Diamond–Shurman's `E_j` over
`\overline{ℚ(j)}` (the print's `x(E_j[N]) ∪ y(E_j[N])`). -/
def coordsDS (N : ℕ) : Set Kbar :=
  {z | ∃ (x y : Kbar) (h : EDSBar.toAffine.Nonsingular x y),
    (Affine.Point.some x y h : EDSBar.toAffine.Point) ∈ nTors EDSBar N ∧ (z = x ∨ z = y)}

/-- **`ℚ(j, E_j[N])`** (Diamond–Shurman §7.5–7.6): the subfield of `\overline{ℚ(j)}` generated over `ℚ(j)` by the
coordinates of the `N`-torsion points of `E_j`. -/
def LDS (N : ℕ) : IntermediateField Qj Kbar := IntermediateField.adjoin Qj (coordsDS N)

instance (N : ℕ) : DecidableEq (LDS N) := Classical.decEq _

/-- The inclusion `ℚ(j, E_j[N]) → \overline{ℚ(j)}` on points of `E_j`. -/
abbrev incDS (N : ℕ) : (EDS.baseChange (LDS N)).toAffine.Point →+ EDSBar.toAffine.Point :=
  Affine.Point.map (W' := EDS) (LDS N).val

/-- The action of `σ₀ ∈ Gal(ℚ(j, E_j[N])/ℚ(j))` on the `ℚ(j, E_j[N])`-points of `E_j`. -/
abbrev galPtL {N : ℕ} (σ₀ : LDS N ≃ₐ[Qj] LDS N) :
    (EDS.baseChange (LDS N)).toAffine.Point →+ (EDS.baseChange (LDS N)).toAffine.Point :=
  Affine.Point.map (W' := EDS) σ₀.toAlgHom

/-- **LEAF (Diamond–Shurman, *A First Course in Modular Forms*, GTM 228, Theorem 7.6.3, first part; printed form).**
For `N > 1`, let `L_N = ℚ(j, E_j[N]) ⊆ \overline{ℚ(j)}` (`LDS N`) be generated over `ℚ(j)` by the coordinates of
the `N`-torsion of the universal curve `E_j : y² = 4x³ − g_j x − g_j`, `g_j = 27j/(j − 1728)` (DS (7.12)), `j`
transcendental (`ℚ(j) = RatFunc ℚ`). Then `ρ : Gal(L_N/ℚ(j)) → GL₂(ℤ/N)` is onto: for every basis
`e : (ℤ/N)² ≃ E_j[N]` and every `g ∈ GL₂(ℤ/N)` some `σ₀ ∈ Gal(L_N/ℚ(j))` acts on `E_j[N]` as `g` in the basis `e`:
for every `L_N`-point `P` representing `e v`, `σ₀ P` represents `e (g v)`.

Pages (read by igusa-gal in both printings): Theorem 7.6.3 p. 290 (2005) / p. 294 (2016 4th printing); `ρ` is the
action of `H_ℚ` on `E_j[N]` in the ordered basis `(P_τ, Q_τ)` of (7.11), p. 287 (2005) / p. 291 (2016), as in
Corollary 7.5.3, p. 284 / p. 288; (7.12) p. 282 / p. 286; points of `E_j` are pairs from `\overline{ℚ(j)}`,
p. 287 / p. 291; `ℚ(j, E_j[N])` is generated by `x(E_j[N]) ∪ y(E_j[N])`, p. 283 / p. 287 (over `ℂ`, carried to `ℚ`
in §7.6); `N > 1` is the standing assumption of §7.5 (p. 279 / p. 283); the group law is the chord–tangent law
with origin `[0, 1, 0]` (§7.1, pp. 253–254 / pp. 257–258).

Reading notes. (1) The print's `ρ` is an isomorphism in the basis `(P_τ, Q_τ)`, acting by
`(P^σ, Q^σ)ᵀ = ρ(σ) (P, Q)ᵀ`; for another basis `e` the action matrices are those of the print conjugated by a
fixed element of `GL₂(ℤ/N)` and transposed, so they still exhaust `GL₂(ℤ/N)`: the every-basis form here is a
consequence. (2) `E_j` is written as `EDS` (`y = 2y'`), as in `X1Igusa.IgusaGL2DS` (reading note (2) there). -/
def IgusaGL2DSGal : Prop :=
  ∀ N : ℕ, 1 < N → ∀ (e : (ZMod N × ZMod N) ≃+ nTors EDSBar N) (g : GL (Fin 2) (ZMod N)),
    ∃ σ₀ : LDS N ≃ₐ[Qj] LDS N, ∀ (v : ZMod N × ZMod N) (P : (EDS.baseChange (LDS N)).toAffine.Point),
      incDS N P = (e v : EDSBar.toAffine.Point) →
        incDS N (galPtL σ₀ P) = (e (matAct (g : Matrix (Fin 2) (Fin 2) (ZMod N)) v) : EDSBar.toAffine.Point)

/-- Every `N`-torsion point of `E_j` over `\overline{ℚ(j)}` is an `L_N`-point. -/
theorem exists_LDS_point (N : ℕ) (Q : EDSBar.toAffine.Point) (hQ : Q ∈ nTors EDSBar N) :
    ∃ P : (EDS.baseChange (LDS N)).toAffine.Point, incDS N P = Q := by
  cases Q with
  | zero => exact ⟨0, rfl⟩
  | some x y h =>
    have hx : x ∈ LDS N := IntermediateField.subset_adjoin Qj _ ⟨x, y, h, hQ, Or.inl rfl⟩
    have hy : y ∈ LDS N := IntermediateField.subset_adjoin Qj _ ⟨x, y, h, hQ, Or.inr rfl⟩
    have h' : (EDS.baseChange (LDS N)).toAffine.Nonsingular ⟨x, hx⟩ ⟨y, hy⟩ :=
      (EDS.toAffine.baseChange_nonsingular (LDS N).val.injective _ _).mp h
    exact ⟨Affine.Point.some _ _ h', rfl⟩

/-- `\overline{ℚ(j)}/ℚ(j)` is normal. -/
theorem normal_Kbar : Normal Qj Kbar := IsAlgClosure.normal Qj Kbar

attribute [local instance] normal_Kbar

/-- `σ₀.liftNormal` acts on `L_N`-points as `σ₀`. -/
theorem galPtDS_liftNormal_inc {N : ℕ} (σ₀ : LDS N ≃ₐ[Qj] LDS N)
    (P : (EDS.baseChange (LDS N)).toAffine.Point) :
    galPtDS (σ₀.liftNormal Kbar) (incDS N P) = incDS N (galPtL σ₀ P) := by
  have hc : (σ₀.liftNormal Kbar).toAlgHom.comp (LDS N).val = (LDS N).val.comp σ₀.toAlgHom := by
    ext z
    exact AlgEquiv.liftNormal_commutes σ₀ Kbar z
  show Affine.Point.map _ (Affine.Point.map _ P) = Affine.Point.map _ (Affine.Point.map _ P)
  rw [Affine.Point.map_map, Affine.Point.map_map, hc]

/-- **`IgusaGL2DSGal → IgusaGL2DS`**: the print's `Gal(ℚ(j, E_j[N])/ℚ(j))` form gives the
`Aut(\overline{ℚ(j)}/ℚ(j))` form, by `liftNormal`. -/
theorem igusaGL2DS_of_igusaGL2DSGal (h : IgusaGL2DSGal) : IgusaGL2DS := by
  intro N hN e g
  rcases Nat.lt_or_ge 1 N with h1 | h1
  · obtain ⟨σ₀, hσ₀⟩ := h N h1 e g
    refine ⟨σ₀.liftNormal Kbar, fun v => ?_⟩
    obtain ⟨P, hP⟩ := exists_LDS_point N _ (e v).2
    rw [← hP, galPtDS_liftNormal_inc]
    exact hσ₀ v P hP
  · have hN1 : N = 1 := le_antisymm h1 hN
    subst hN1
    refine ⟨AlgEquiv.refl, fun v => ?_⟩
    have hv : matAct (g : Matrix (Fin 2) (Fin 2) (ZMod 1)) v = v := Subsingleton.elim _ _
    rw [hv]
    cases (e v : EDSBar.toAffine.Point) <;> rfl

end X1Igusa
