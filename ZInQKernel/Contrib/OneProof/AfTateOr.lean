/-! ## 1. Diamond–Shurman's `X₁(N)_alg`: function field `ℚ(j, f₁)` -/

/-- `ℤ[J][T] → ℚ[J][T]`. -/
def toQ : Polynomial (Polynomial ℤ) →+* Polynomial (Polynomial ℚ) :=
  Polynomial.mapRingHom (Polynomial.mapRingHom (Int.castRingHom ℚ))

/-- `F(a, b)` for `F ∈ ℤ[J][T]`, in any commutative ring. -/
def ev2 {K : Type*} [CommRing K] (F : Polynomial (Polynomial ℤ)) (a b : K) : K :=
  (F.map (Polynomial.eval₂RingHom (Int.castRingHom K) a)).eval b

/-- **Diamond–Shurman's `X₁(N)_alg`, as far as the kernel can state it** (DS §7.7: the curve over
`ℚ` with function field `ℚ(j, f₁)`; locator UNVERIFIED). `X` is a smooth proper geometrically
connected integral curve over `ℚ` (`IsCurve`) whose function field is `ℚ(j, f₁)`: it is generated, as
a field, by two elements `j_X`, `t_X` whose polynomial relations with integer coefficients are exactly
those of `(j(τ), f₁(τ))` on `ℍ`, where `j = 1728 g₂³/Δ` and `f₁(τ) = T5Glue.weber ⟨1, τ⟩ (1/N) =
g₂(τ)g₃(τ)℘_τ(1/N)/Δ(τ)` (at the points with `g₂(τ)g₃(τ) ≠ 0`, Weber's generic branch). A field
generated by two elements is determined up to isomorphism by their ideal of relations
(`nonempty_ringEquiv_of_rel`), so this says `K(X) ≅ ℚ(j, f₁)`; the property does not depend on the
normalization of `f₁` within `ℚ(j)^× f₁ + ℚ(j)`. -/
def IsX1AlgDS (N : ℕ) (X : Over SpecQ) : Prop :=
  IsCurve X ∧ ∃ (_ : IsIntegral X.left) (jX tX : X.left.functionField),
    Subfield.closure {jX, tX} = ⊤ ∧
    ∀ F : Polynomial (Polynomial ℤ), ev2 F jX tX = 0 ↔
      ∀ τ : UpperHalfPlane, (T5Glue.pp τ).g₂ ≠ 0 → (T5Glue.pp τ).g₃ ≠ 0 →
        X1Igusa.Weber.evAn N (toQ F) τ = 0

/-! ## 2. The conclusion: characteristic polynomial, or "satisfies" with oddness -/

/-- The conclusion of the leaf at one abelian variety `J` (a representative of `J₁(N) = Pic⁰`): a
`ℚ`-quotient `π : J ↠ A` with `θ : K_f → End⁰(A)` such that, for every prime `ℓ`, `V_ℓ(A)` has a
basis `b` over `ℚ_ℓ ⊗ K_f` (free of rank 2, Diamond–Shurman Lemma 9.5.3) and **either** every
arithmetic Frobenius `σ` at `p ∤ Nℓ` has characteristic polynomial `X² − a_p X + χ(p) p` over
`ℚ_ℓ ⊗ K_f` (DS Thm 9.5.4, characteristic-polynomial reading; this disjunct is isj1-dict's
`AfTateAt`) **or** every such `σ` satisfies `X² − a_p X + χ(p) p` (DS Thm 9.5.4, "satisfies" reading)
and complex conjugation has determinant `−1` on every `ι`-component (`ρ_{A_f,ℓ}` is odd, from
`det ρ_{A_f,ℓ} = χ χ_ℓ` and `χ(−1) = 1`); this disjunct is isj1-dict's `AfTateWeakOddAt`.
`orAt_of_afTateAt` and `orAt_of_weakOddAt` are the two or-introductions. -/
def AfTateOrAt (N : ℕ) (χ : DirichletCharacter ℂ N) (f : CF N 2) (J : AbVar ℚ) : Prop :=
  ∃ (A : AbVar ℚ) (π : Hom J A) (θ : coeffField f →+* A.End0),
    AlgebraicGeometry.Surjective π.hom.left ∧
    ∀ (ℓ : ℕ) [Fact ℓ.Prime],
      ∃ b : (letI := R16Used.tensorModule ℓ A θ;
          Module.Basis (Fin 2) (ℚ_[ℓ] ⊗[ℚ] coeffField f) (A.V ℓ)),
        (∀ (p : ℕ), p.Prime → ¬ p ∣ N * ℓ → ∀ σ : GQ, IsFrobAt σ p →
          ∃ c : coeffField f, (c : ℂ) = χ (p : ZMod N) ∧
            (R16Used.frobMat ℓ A θ b σ).charpoly =
              R16Used.esPoly ℓ (⟨coeff f p, coeff_mem_coeffField f p⟩ : coeffField f)
                (c * (p : coeffField f))) ∨
        ((∀ (emb : coeffField f →+* PadicAlgCl ℓ) (c : GQ), ZInQ.Contrib.G9.PkgI4.IsComplexConj c →
          LinearMap.det (frobOn ℓ A θ emb c) = -1) ∧
        ∀ (p : ℕ), p.Prime → ¬ p ∣ N * ℓ → ∀ σ : GQ, IsFrobAt σ p →
          ∃ c : coeffField f, (c : ℂ) = χ (p : ZMod N) ∧
            Polynomial.aeval (R16Used.frobMat ℓ A θ b σ)
              (R16Used.esPoly ℓ (⟨coeff f p, coeff_mem_coeffField f p⟩ : coeffField f)
                (c * (p : coeffField f))) = 0)

/-- **LEAF (Eichler–Shimura for `A_f` over `J₁(N) = Pic⁰(X₁(N)_alg)`, Diamond–Shurman Lemma 9.5.3
and Thm 9.5.4, at Diamond–Shurman's own `X₁(N)_alg`; step R16 of the H decomposition, field
`r16CoreY`).** For `N ≥ 2` and a newform `f ∈ S₂(Γ₁(N))` with nebentypus `χ`: for every model `X`
of Diamond–Shurman's `X₁(N)_alg` (`IsX1AlgDS`: smooth proper geometrically connected curve over `ℚ`
with function field `ℚ(j, f₁)`, `f₁` Weber's function at `1/N`) having a rational point, and every
representative `V` of `Pic⁰_{X/ℚ}` with the tensor group law (vendored Jacobian-Challenge library),
there is a quotient `A` of `V` (DS's `A_f`) with `K_f`-action such that `AfTateOrAt` holds:
`V_ℓ(A)` free of rank 2 over `ℚ_ℓ ⊗ K_f`, and Frobenius at `p ∤ Nℓ` has characteristic polynomial
`X² − a_p X + χ(p) p`, or satisfies it with `ρ_{A_f,ℓ}` odd.

Sources: Diamond–Shurman, *A First Course in Modular Forms*, GTM 228 (2005): §7.5–7.7 (`X₁(N)_alg`
through `ℚ(j, f₁)`; `J₁(N) = Pic⁰`), §6.6 (`A_f = J₁(N)/I_f J₁(N)`), Lemma 9.5.3, Thm 9.5.4; Shimura,
*Introduction to the Arithmetic Theory of Automorphic Functions* (1971), Thms 7.9–7.14 (congruence
relation, characteristic polynomial, `det = χ χ_ℓ`); all numbers UNVERIFIED (unread, no network).
Rating notes: the characteristic-polynomial reading of DS 9.5.4 gives the first disjunct by
or-introduction; the "satisfies" reading gives the second together with oddness, a consequence of the
printed determinant formula for the same `A_f`. `N = 1` is omitted (`S₂(Γ₁(1)) = 0`,
`not_isNewform_one`). The model and the `Pic⁰` representative are universally quantified (DS's
construction determines `X₁(N)_alg` up to isomorphism by its function field); only `A` is
existential (no Hecke correspondences on `J₁(N)` in Lean). -/
def AfTateDSOr : Prop :=
  ∀ (N : ℕ) (χ : DirichletCharacter ℂ N) (f : CF N 2), 2 ≤ N → IsNewform f χ →
    ∀ X : Over SpecQ, IsX1AlgDS N X → Nonempty (RatPt X) →
      ∀ (V : AbelianVariety ℚ) (rep : (picardFunctorDegree X.hom 0).obj.RepresentableBy V.group.X),
        PicardTensorCompatible X.hom V.group rep → AfTateOrAt N χ f (R16IsJ1Dict.ofVendored V)

/-! ## 3. From the disjunction to the weak-odd form -/

/-- **The disjunction gives the weak-odd form (glue, proved).** The first disjunct gives the
relation by Cayley–Hamilton and oddness by isj1-dict's `odd_of_charpoly` (Chebotarev, T18, and
`χ(−1) = 1`); the second disjunct is the weak-odd form. -/
theorem weakOddAt_of_orAt {N : ℕ} {χ : DirichletCharacter ℂ N} {f : CF N 2} {J : AbVar ℚ}
    (hT : TateModuleFree) (hN : 0 < N) (hf : IsNewform f χ) (h : AfTateOrAt N χ f J) :
    R16IsJ1Dict.AfTateWeakOddAt N χ f J := by
  obtain ⟨A, π, θ, hπ, hb⟩ := h
  refine ⟨A, π, θ, hπ, fun ℓ _ => ?_⟩
  obtain ⟨b, hcp | ⟨hodd, hweak⟩⟩ := hb ℓ
  · refine ⟨b, fun emb c hc => ?_, fun p hp hpN σ hσ => ?_⟩
    · rw [(R16IsJ1Dict.trace_det_frobOn ℓ A θ b emb c).2]
      exact R16IsJ1Dict.odd_of_charpoly ℓ A hT (coeffField f) θ b emb N hN χ
        (fun p => ⟨PkgI4.coeff f p, coeff_mem_coeffField f p⟩)
        (R16IsJ1Dict.chi_neg_one_of_newform hf) hcp c hc
    · obtain ⟨c, hc, hch⟩ := hcp p hp hpN σ hσ
      exact ⟨c, hc, by rw [← hch]; exact Matrix.aeval_self_charpoly _⟩
  · exact ⟨b, hodd, hweak⟩

/-- The charpoly form gives the disjunction (or-introduction). -/
theorem orAt_of_afTateAt {N : ℕ} {χ : DirichletCharacter ℂ N} {f : CF N 2} {J : AbVar ℚ}
    (h : R16IsJ1Dict.AfTateAt N χ f J) : AfTateOrAt N χ f J := by
  obtain ⟨A, π, θ, hπ, hb⟩ := h
  exact ⟨A, π, θ, hπ, fun ℓ _ => by obtain ⟨b, hcp⟩ := hb ℓ; exact ⟨b, Or.inl hcp⟩⟩

/-- The weak-odd form gives the disjunction (or-introduction). -/
theorem orAt_of_weakOddAt {N : ℕ} {χ : DirichletCharacter ℂ N} {f : CF N 2} {J : AbVar ℚ}
    (h : R16IsJ1Dict.AfTateWeakOddAt N χ f J) : AfTateOrAt N χ f J := by
  obtain ⟨A, π, θ, hπ, hb⟩ := h
  exact ⟨A, π, θ, hπ, fun ℓ _ => by
    obtain ⟨b, hodd, hw⟩ := hb ℓ; exact ⟨b, Or.inr ⟨hodd, hw⟩⟩⟩

/-! ## 4. The dictionary: a kernel model of `X₁(N)` is Diamond–Shurman's `X₁(N)_alg` -/

/-- Ring maps commute with `ev2`. -/
theorem map_ev2 {K L : Type*} [CommRing K] [CommRing L] (φ : K →+* L) (F : Polynomial (Polynomial ℤ))
    (a b : K) : φ (ev2 F a b) = ev2 F (φ a) (φ b) := by
  unfold ev2
  rw [← Polynomial.eval₂_hom, ← Polynomial.eval_map, Polynomial.map_map]
  congr 2
  refine Polynomial.ringHom_ext (fun n => ?_) ?_
  · simp
  · simp

open X1Igusa.Weber in
/-- weber-field's `evAlg` on integer polynomials is `ev2` at `(j, w(P))`. -/
theorem evAlg_toQ (F : Polynomial (Polynomial ℤ)) (P : EjBar.toAffine.Point) :
    evAlg (toQ F) P = ev2 F (algebraMap Qj Kbar RatFunc.X) (wOf P) := by
  unfold evAlg ev2 toQ
  rw [Polynomial.coe_mapRingHom, Polynomial.map_map]
  congr 2
  refine Polynomial.ringHom_ext (fun n => ?_) ?_
  · simp
  · simp [RatFunc.algebraMap_X]

open X1Igusa.Weber in
/-- `ℚ(j)(w(P))` is generated as a field by `j` and `w(P)`. -/
theorem closure_eq_top (P : EjBar.toAffine.Point) (hw : wOf P ∈ fieldX1 P) :
    Subfield.closure ({algebraMap Qj (fieldX1 P) RatFunc.X, ⟨wOf P, hw⟩} : Set (fieldX1 P)) = ⊤ := by
  set S := Subfield.closure ({algebraMap Qj (fieldX1 P) RatFunc.X, ⟨wOf P, hw⟩} : Set (fieldX1 P))
  let U : Subfield Kbar := S.map (fieldX1 P).val.toRingHom
  have hj : algebraMap Qj Kbar RatFunc.X ∈ U :=
    Subfield.mem_map.mpr ⟨algebraMap Qj (fieldX1 P) RatFunc.X, Subfield.subset_closure (by simp), rfl⟩
  have hwU : wOf P ∈ U :=
    Subfield.mem_map.mpr ⟨⟨wOf P, hw⟩, Subfield.subset_closure (by simp), rfl⟩
  have hpol : ∀ p : Polynomial ℚ, algebraMap Qj Kbar (algebraMap (Polynomial ℚ) Qj p) ∈ U := by
    intro p
    induction p using Polynomial.induction_on' with
    | add p q hp hq => rw [map_add, map_add]; exact add_mem hp hq
    | monomial n c =>
      rw [← Polynomial.C_mul_X_pow_eq_monomial, map_mul, map_mul, map_pow, map_pow,
        RatFunc.algebraMap_X]
      refine mul_mem ?_ (pow_mem hj n)
      have : algebraMap Qj Kbar (algebraMap (Polynomial ℚ) Qj (Polynomial.C c)) = (c : Kbar) :=
        eq_ratCast ((algebraMap Qj Kbar).comp ((algebraMap (Polynomial ℚ) Qj).comp Polynomial.C)) c
      rw [this]
      exact SubfieldClass.ratCast_mem U c
  have hq : ∀ q : Qj, algebraMap Qj Kbar q ∈ U := by
    intro q
    induction q using RatFunc.induction_on with
    | f p r hr => rw [map_div₀]; exact div_mem (hpol p) (hpol r)
  let U' : IntermediateField Qj Kbar := Subfield.toIntermediateField U hq
  have hle : fieldX1 P ≤ U' := by
    rw [← adjoin_wOf, IntermediateField.adjoin_simple_le_iff]
    exact hwU
  refine eq_top_iff.mpr fun x _ => ?_
  obtain ⟨y, hy, hyx⟩ := Subfield.mem_map.mp (hle x.2)
  have : y = x := Subtype.ext hyx
  rwa [← this]

open X1Igusa.Weber in
/-- **The dictionary (glue, proved).** For `N ≥ 2`, a kernel model of `X₁(N)` (`IsX1Model`) is a
model of Diamond–Shurman's `X₁(N)_alg` (`IsX1AlgDS`): weber-field's comparison, `ℚ(j)(w(P)) =
ℚ(j)(x(P))`, and Igusa (`X1PointsConjugate`) to move from the model's point to weber-field's. -/
theorem isX1AlgDS_of_isX1Model (hI : R16IsJ1Dict.X1PointsConjugate) {N : ℕ} (hN : 2 ≤ N)
    {X : Over SpecQ} (h : IsX1Model N X) : IsX1AlgDS N X := by
  obtain ⟨hC, hInt, P', hP', ⟨e⟩⟩ := h
  obtain ⟨P, hP, hrel⟩ := weberFieldComparison N hN
  obtain ⟨σ, hσ⟩ := hI N P' P (by omega) hP' hP
  let e' : X.left.functionField ≃+* fieldX1 P := e.trans (R16IsJ1Dict.fieldX1Equiv σ hσ)
  have hw : wOf P ∈ fieldX1 P := by
    rw [← adjoin_wOf]; exact IntermediateField.mem_adjoin_simple_self _ _
  refine ⟨hC, hInt, e'.symm (algebraMap Qj (fieldX1 P) RatFunc.X), e'.symm ⟨wOf P, hw⟩, ?_,
    fun F => ?_⟩
  · set S := Subfield.closure ({e'.symm (algebraMap Qj (fieldX1 P) RatFunc.X), e'.symm ⟨wOf P, hw⟩} :
      Set X.left.functionField)
    have hle : Subfield.closure ({algebraMap Qj (fieldX1 P) RatFunc.X, ⟨wOf P, hw⟩} :
        Set (fieldX1 P)) ≤ S.map e'.toRingHom := by
      rw [Subfield.closure_le]
      rintro x (rfl | rfl)
      · exact Subfield.mem_map.mpr ⟨e'.symm (algebraMap Qj (fieldX1 P) RatFunc.X),
          Subfield.subset_closure (by simp), by simp⟩
      · exact Subfield.mem_map.mpr ⟨e'.symm ⟨wOf P, hw⟩, Subfield.subset_closure (by simp), by simp⟩
    rw [closure_eq_top P hw] at hle
    refine eq_top_iff.mpr fun x _ => ?_
    obtain ⟨y, hy, hyx⟩ := Subfield.mem_map.mp (hle (Subfield.mem_top (e' x)))
    rwa [← e'.injective hyx]
  · rw [hrel (toQ F), evAlg_toQ]
    have h1 := map_ev2 e'.symm.toRingHom F (algebraMap Qj (fieldX1 P) RatFunc.X) ⟨wOf P, hw⟩
    have h2 := map_ev2 (fieldX1 P).val.toRingHom F (algebraMap Qj (fieldX1 P) RatFunc.X) ⟨wOf P, hw⟩
    simp only [RingEquiv.toRingHom_eq_coe, RingHom.coe_coe] at h1
    change e'.symm _ = _ at h1
    rw [← h1, map_eq_zero_iff _ e'.symm.injective]
    change _ = ev2 F (algebraMap Qj Kbar RatFunc.X) (wOf P) at h2
    rw [← h2]
    exact (map_eq_zero_iff _ (fieldX1 P).val.toRingHom.injective).symm

/-! ## 5. Level one: no newforms of weight 2 (Mathlib's dimension formula) -/

open scoped MatrixGroups in
/-- `S₂(Γ₁(1)) = 0` (Mathlib's `ModularForm.levelOne_weight_two_rank_zero`). -/
theorem cuspForm_one_two_eq_zero (f : CF 1 2) : (⇑f : UpperHalfPlane → ℂ) = 0 := by
  have hG : ((CongruenceSubgroup.Gamma1 1 : Subgroup SL(2, ℤ)) : Subgroup (GL (Fin 2) ℝ)) = 𝒮ℒ := by
    have : CongruenceSubgroup.Gamma1 1 = ⊤ := by
      ext A
      simp only [Subgroup.mem_top, iff_true]
      rw [CongruenceSubgroup.Gamma1_mem]
      exact ⟨Subsingleton.elim _ _, Subsingleton.elim _ _, Subsingleton.elim _ _⟩
    rw [this, MonoidHom.range_eq_map]
  have key : ∀ (Γ : Subgroup (GL (Fin 2) ℝ)) (_ : Γ = 𝒮ℒ) (g : CuspForm Γ 2),
      (⇑g : UpperHalfPlane → ℂ) = 0 := by
    rintro Γ rfl g
    have h0 : (g : ModularForm 𝒮ℒ 2) = 0 :=
      (rank_zero_iff_forall_zero.mp ModularForm.levelOne_weight_two_rank_zero) _
    have := congrArg (fun h : ModularForm 𝒮ℒ 2 => (⇑h : UpperHalfPlane → ℂ)) h0
    simpa using this
  exact key _ hG f

/-- There is no newform of level `1` and weight `2`. -/
theorem not_isNewform_one (χ : DirichletCharacter ℂ 1) (f : CF 1 2) : ¬ IsNewform f χ := by
  intro hf
  have h1 : PkgI4.coeff f 1 = 1 := hf.1.2.1
  have hz := cuspForm_one_two_eq_zero f
  have : PkgI4.coeff f 1 = 0 := by
    simp only [PkgI4.coeff]
    rw [hz, UpperHalfPlane.qExpansion_zero]
    simp
  rw [this] at h1
  exact zero_ne_one h1

/-! ## 6. The discharge -/

/-- **The weak-odd form over every Jacobian of `X₁(N)` from the leaf (glue, proved).** -/
theorem weakOdd_of_dsOr (h : AfTateDSOr) (hI : R16IsJ1Dict.X1PointsConjugate)
    (hT : TateModuleFree) : R16IsJ1Dict.AfTateWeakOdd := by
  intro N χ f J hN hf hJ
  rcases Nat.lt_or_ge N 2 with hN1 | hN2
  · have h1 : N = 1 := by omega
    subst h1
    exact absurd hf (not_isNewform_one χ f)
  obtain ⟨X, P₀, aj, hX, hJac⟩ := hJ
  obtain ⟨V, rep, htc⟩ := R16IsJ1Dict.exists_picZero X hX.1
  have hA := h N χ f hN2 hf X (isX1AlgDS_of_isX1Model hI hN2 hX) ⟨P₀⟩ V rep htc
  exact (weakOddAt_of_orAt hT hN hf hA).of_iso
    (R16IsJ1Dict.abVarIso_picZero_of_isJacobian hX.1 hJac V rep htc).symm

/-- **The discharge of `r16CoreY`** from the leaf `AfTateDSOr`, Igusa's theorem as printed
(`X1Igusa.IgusaGL2DS`) and the bundle's `mumfordTorsionAlgClosed`. -/
theorem r16CoreY_of_dsOr_igusaDS (h : AfTateDSOr) (hI : X1Igusa.IgusaGL2DS)
    (hM : AvSplit.MumfordTorsionAlgClosed) : R16Split.R16CoreY :=
  R16IsJ1Dict.r16CoreY_of_weakOdd
    (weakOdd_of_dsOr h (X1Igusa.x1PointsConjugate_of_igusaGL2DS hI)
      (T5Torsion.TateFree.tateModuleFree_of_torsionStructure
        (AvSplit.torsionStructure_of_mumford hM))) hM

/-! ## 7. The converse dictionary, and the new leaf is never stronger than the old ones -/

/-- `F ↦ F(a, b)` as a ring map `ℤ[J][T] → K`. -/
def evHom {K : Type*} [CommRing K] (a b : K) : Polynomial (Polynomial ℤ) →+* K :=
  Polynomial.eval₂RingHom (Polynomial.eval₂RingHom (Int.castRingHom K) a) b

theorem evHom_apply {K : Type*} [CommRing K] (a b : K) (F : Polynomial (Polynomial ℤ)) :
    evHom a b F = ev2 F a b := by
  simp [evHom, ev2, Polynomial.eval_map]

/-- A field generated by `a, b` is the fraction field of `ℤ[a, b]`. -/
theorem isFractionRing_range {K : Type*} [Field K] (a b : K)
    (h : Subfield.closure ({a, b} : Set K) = ⊤) : IsFractionRing (evHom a b).range K := by
  have : FaithfulSMul (evHom a b).range K :=
    (faithfulSMul_iff_algebraMap_injective _ _).mpr Subtype.val_injective
  refine IsFractionRing.of_field _ K fun z => ?_
  have hz : z ∈ Subfield.closure ({a, b} : Set K) := h ▸ Subfield.mem_top z
  obtain ⟨y, hy, w, hw, rfl⟩ := Subfield.mem_closure_iff.mp hz
  have hle : Subring.closure ({a, b} : Set K) ≤ (evHom a b).range := by
    rw [Subring.closure_le]
    rintro x (rfl | rfl)
    · exact ⟨Polynomial.C Polynomial.X, by simp [evHom]⟩
    · exact ⟨Polynomial.X, by simp [evHom]⟩
  exact ⟨⟨y, hle hy⟩, ⟨w, hle hw⟩, rfl⟩

/-- **Fields presented by two generators with the same relations are isomorphic.** -/
theorem nonempty_ringEquiv_of_rel {K L : Type*} [Field K] [Field L] (a b : K) (c d : L)
    (hK : Subfield.closure ({a, b} : Set K) = ⊤) (hL : Subfield.closure ({c, d} : Set L) = ⊤)
    (hrel : ∀ F, ev2 F a b = 0 ↔ ev2 F c d = 0) : Nonempty (K ≃+* L) := by
  have hker : RingHom.ker (evHom a b) = RingHom.ker (evHom c d) := by
    ext F
    simp only [RingHom.mem_ker, evHom_apply, hrel]
  let e₀ : (evHom a b).range ≃+* (evHom c d).range :=
    ((RingHom.quotientKerEquivRange (evHom a b)).symm.trans (Ideal.quotEquivOfEq hker)).trans
      (RingHom.quotientKerEquivRange (evHom c d))
  have := isFractionRing_range a b hK
  have := isFractionRing_range c d hL
  exact ⟨IsFractionRing.ringEquivOfRingEquiv e₀⟩

open X1Igusa.Weber in
/-- **The converse dictionary (glue, proved).** For `N ≥ 2`, a model of Diamond–Shurman's
`X₁(N)_alg` is a kernel model of `X₁(N)` (no Igusa needed). -/
theorem isX1Model_of_isX1AlgDS {N : ℕ} (hN : 2 ≤ N) {X : Over SpecQ} (h : IsX1AlgDS N X) :
    IsX1Model N X := by
  obtain ⟨hC, hInt, jX, tX, hgen, hrelX⟩ := h
  obtain ⟨P, hP, hrel⟩ := weberFieldComparison N hN
  have hw : wOf P ∈ fieldX1 P := by
    rw [← adjoin_wOf]; exact IntermediateField.mem_adjoin_simple_self _ _
  refine ⟨hC, hInt, P, hP, nonempty_ringEquiv_of_rel jX tX (algebraMap Qj (fieldX1 P) RatFunc.X)
    ⟨wOf P, hw⟩ hgen (closure_eq_top P hw) fun F => ?_⟩
  rw [hrelX F, hrel (toQ F), evAlg_toQ]
  have h2 := map_ev2 (fieldX1 P).val.toRingHom F (algebraMap Qj (fieldX1 P) RatFunc.X) ⟨wOf P, hw⟩
  change _ = ev2 F (algebraMap Qj Kbar RatFunc.X) (wOf P) at h2
  rw [← h2]
  exact map_eq_zero_iff _ (fieldX1 P).val.toRingHom.injective

/-- **The new leaf follows from isj1-dict's `AfTateCharPolyPicZero` and Igusa** (so it is never
stronger than the characteristic-polynomial form at one model). -/
theorem dsOr_of_picZero (h : R16IsJ1Dict.AfTateCharPolyPicZero)
    (hI : R16IsJ1Dict.X1PointsConjugate) : AfTateDSOr := by
  intro N χ f hN hf X hX ⟨P₀⟩ V rep htc
  have hX' := isX1Model_of_isX1AlgDS hN hX
  obtain ⟨aj, hJ⟩ := R16IsJ1Dict.isJacobian_picZero X hX'.1 V rep htc P₀
  exact orAt_of_afTateAt (R16IsJ1Dict.afTateCharPoly_of_picZero h hI
    R16IsJ1Dict.curveIsoOfFunctionFieldIso_proof N χ f _ (by omega) hf ⟨X, P₀, aj, hX', hJ⟩)

/-- **The new leaf follows from isj1-dict's `AfTateWeakOddPicZero` and Igusa** (so it is never
stronger than the weak-reading form with oddness). -/
theorem dsOr_of_weakPicZero (h : R16IsJ1Dict.AfTateWeakOddPicZero)
    (hI : R16IsJ1Dict.X1PointsConjugate) : AfTateDSOr := by
  intro N χ f hN hf X hX ⟨P₀⟩ V rep htc
  have hX' := isX1Model_of_isX1AlgDS hN hX
  obtain ⟨aj, hJ⟩ := R16IsJ1Dict.isJacobian_picZero X hX'.1 V rep htc P₀
  exact orAt_of_weakOddAt (R16IsJ1Dict.weakOdd_of_picZero h hI
    R16IsJ1Dict.curveIsoOfFunctionFieldIso_proof N χ f _ (by omega) hf ⟨X, P₀, aj, hX', hJ⟩)

/-- **Conversely, the new leaf gives the old one** wherever a pointed model exists (the bundle's
`X1ModelExists`): with Igusa, `AfTateDSOr` gives the weak-odd form over `Pic⁰` of one model. -/
theorem weakPicZero_of_dsOr (h : AfTateDSOr) (hI : R16IsJ1Dict.X1PointsConjugate)
    (hT : TateModuleFree) (hx : LeafModCurves.X1ModelExists) : R16IsJ1Dict.AfTateWeakOddPicZero := by
  intro N χ f hN hf
  obtain ⟨X, P₀, hX⟩ := hx N hN
  obtain ⟨V, rep, htc⟩ := R16IsJ1Dict.exists_picZero X hX.1
  refine ⟨X, hX, V, rep, htc, ?_⟩
  obtain ⟨aj, hJ⟩ := R16IsJ1Dict.isJacobian_picZero X hX.1 V rep htc P₀
  exact weakOdd_of_dsOr h hI hT N χ f _ hN hf ⟨X, P₀, aj, hX, hJ⟩

end AfTateOr
