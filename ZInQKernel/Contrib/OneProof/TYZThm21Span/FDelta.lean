local instance (p : Nat.Primes) : Fact p.1.Prime := ⟨p.2⟩

/-! ## The group `ℚ̂^× U` and its double cosets -/

/-- **`U4 = (1 + 4Ô_B)^×`**: the units `w` of `B̂` with `(w − 1)/4` and `(w⁻¹ − 1)/4` in `Ô_B` (at every place).
At an odd place this is `O_{B,p}^×`; at `2` it is `1 + 4O_{B,2}`. TYZ's `U = ∏_p U_p` (L602–606,
`U_2 = ℤ_2^×(1 + 4O_{B,2})`) satisfies `ℚ̂^× U = ℚ̂^× U4`. -/
def U4 : Set ℍ[AQ]ˣ :=
  {w | LH ((1 / 4 : ℚ) • ((w : ℍ[AQ]) - 1)) ∧ LH ((1 / 4 : ℚ) • (((w⁻¹ : ℍ[AQ]ˣ) : ℍ[AQ]) - 1))}

/-- **`ℚ̂^× U`** (`= ℚ̂^× U4`), as the subgroup of `B̂^×` generated by `U4` and `ℚ̂^×`. -/
def GU : Subgroup ℍ[AQ]ˣ :=
  Subgroup.closure (U4 ∪ Set.range (Units.map (algebraMap AQ ℍ[AQ]).toMonoidHom))

/-- The double coset `B^× x ℚ̂^× U`. -/
def DCU (x : ℍ[AQ]) : Set ℍ[AQ] :=
  {y | ∃ γ : ℍ[ℚ], γ ≠ 0 ∧ ∃ h ∈ GU, y = qι γ * x * ↑h}

theorem mem_DCU_self (x : ℍ[AQ]) : x ∈ DCU x :=
  ⟨1, one_ne_zero, 1, Subgroup.one_mem _, by simp⟩

theorem DCU_trans {x y z : ℍ[AQ]} (hy : y ∈ DCU x) (hz : z ∈ DCU y) : z ∈ DCU x := by
  obtain ⟨γ, hγ, h, hh, rfl⟩ := hy
  obtain ⟨γ', hγ', h', hh', rfl⟩ := hz
  refine ⟨γ' * γ, mul_ne_zero hγ' hγ, h * h', Subgroup.mul_mem _ hh hh', ?_⟩
  rw [map_mul, Units.val_mul]; noncomm_ring

theorem DCU_symm {x y : ℍ[AQ]} (hy : y ∈ DCU x) : x ∈ DCU y := by
  obtain ⟨γ, hγ, h, hh, rfl⟩ := hy
  refine ⟨γ⁻¹, inv_ne_zero hγ, h⁻¹, Subgroup.inv_mem _ hh, ?_⟩
  have e1 : qι γ⁻¹ * qι γ = 1 := by rw [← map_mul, inv_mul_cancel₀ hγ, map_one]
  calc x = (qι γ⁻¹ * qι γ) * x * ((h : ℍ[AQ]) * ↑h⁻¹) := by rw [e1, Units.mul_inv]; simp
    _ = qι γ⁻¹ * (qι γ * x * ↑h) * ↑h⁻¹ := by noncomm_ring

theorem qι_mul_mem_DCU (x : ℍ[AQ]) {γ : ℍ[ℚ]} (hγ : γ ≠ 0) {h : ℍ[AQ]ˣ} (hh : h ∈ GU) :
    qι γ * x * ↑h ∈ DCU x :=
  ⟨γ, hγ, h, hh, rfl⟩

/-- `ℚ̂^× U ⊂ ⟨U_n, ℚ̂^×⟩` (`U4 ⊂ R̂_n^×`, hfx-proof's `mem_HgrpN_of`). -/
theorem GU_le_HgrpN (n : ℕ) [NeZero n] (τ : QNeg n →ₐ[ℚ] ℍ[ℚ]) : GU ≤ HgrpN n τ := by
  refine (Subgroup.closure_le _).mpr (Set.union_subset ?_ ?_)
  · intro w hw
    exact mem_HgrpN_of τ hw.1 hw.2
  · rintro _ ⟨z, rfl⟩
    exact Subgroup.subset_closure (Or.inr ⟨z, rfl⟩)

theorem DCU_sub_DC (n : ℕ) [NeZero n] (τ : QNeg n →ₐ[ℚ] ℍ[ℚ]) {x y : ℍ[AQ]} (hy : y ∈ DCU x) :
    y ∈ DC n τ x := by
  obtain ⟨γ, hγ, h, hh, rfl⟩ := hy
  exact ⟨γ, hγ, h, GU_le_HgrpN n τ hh, rfl⟩

/-! ## Lemma 2.5, surjectivity (copy of hfx-proof's, for the finer group `ℚ̂^× U`) -/

/-- **TYZ Lemma 2.5, surjectivity, for `Ô_B^×`** (hfx-proof's `exists_twoRep_of_unit`, whose unit `w` lies in
`U4`). -/
theorem exists_twoRepU_of_unit {v : HeightOneSpectrum (𝓞 ℚ)}
    (hv : IsPlaceTwo v) {u : ℍ[AQ]ˣ} (hu : LH u) (hu' : LH ((u⁻¹ : ℍ[AQ]ˣ) : ℍ[AQ])) :
    ∃ t, (u : ℍ[AQ]) ∈ DCU (twoRep v t) := by
  have hn : ‖Quaternion.normSq (piQ v (u : ℍ[AQ]))‖ = 1 :=
    norm_eq_one_of_mul (hu v).normSq_mem (hu' v).normSq_mem (by
      rw [← map_mul, ← map_mul, Units.mul_inv, map_one, map_one])
  obtain ⟨μ, hμ, s, t, hloc⟩ := local25 (Pw_eq_two hv) (hu v) hn
  set ε : ℍ[ℚ] := ((sg s : ℤ) : ℚ) • hurZ μ with hεdef
  have hεn : Quaternion.normSq ε = 1 := by
    rw [hεdef, Quaternion.normSq_smul, normSq_hurZ, unitList_nrdH μ hμ]
    have : ((sg s : ℤ) : ℚ) ^ 2 = 1 := by have := sg_sq s; exact_mod_cast this
    rw [this]; simp
  have hε0 : ε ≠ 0 := fun h => by rw [h, map_zero] at hεn; exact zero_ne_one hεn
  have hεZ : IsHurZ ε := by
    rw [hεdef]
    refine IsHur.smul (mem_ZS.mpr ⟨_, rfl⟩) ?_
    refine ⟨?_, ?_, ?_, ?_⟩ <;> simp only [hc_hurZ, mapH] <;> exact mem_ZS.mpr ⟨_, rfl⟩
  have hσ : ε * twoRepQ t = hurZ (smulH (sg s) (mulH μ (βZ t))) := by
    rw [twoRepQ_eq, hurZ_smulH, hurZ_mulH, hεdef, smul_mul_assoc]
  set a : ℍ[AQ]ˣ := qιU ε hε0 * twoRepU v t with hadef
  have hac : (a : ℍ[AQ]) = qι ε * twoRep v t := rfl
  set w : ℍ[AQ]ˣ := a⁻¹ * u with hwdef
  have hεnorm : ∀ w', ‖Quaternion.normSq (qp (Pw w' : ℕ) ε)‖ = 1 := fun w' => by
    rw [normSq_qp, hεn]; simp
  have hA : ∀ w', IsHur (Zp (Pw w' : ℕ)) (piQ w' (a : ℍ[AQ])) ∧
      ‖Quaternion.normSq (piQ w' (a : ℍ[AQ]))‖ = 1 ∧
      IsHur (Zp (Pw w' : ℕ)) (((1 / 4 : ℚ) : ℚ_[Pw w']) • (piQ w' (u : ℍ[AQ]) - piQ w' (a : ℍ[AQ]))) := by
    intro w'
    rw [hac, map_mul, piQ_qι]
    by_cases hw : w' = v
    · subst hw
      rw [twoRep, piQ_ιAt_self, ← map_mul, hσ]
      refine ⟨isHur_qp_hurZ _, ?_, hloc⟩
      · have hsg : (sg s : ℤ) ^ 2 = 1 := by have := sg_sq s; exact_mod_cast this
        have hσn : nrdH (smulH (sg s) (mulH μ (βZ t))) = nrdH (βZ t) := by
          rw [nrdH_smulH, nrdH_mulH, unitList_nrdH μ hμ, hsg, one_mul, one_mul]
        rw [normSq_qp, normSq_hurZ, hσn]
        obtain ⟨r, hr⟩ := nrdH_βZ_odd t
        rw [hr]
        have h2 : (2 : ℕ) = (Pw w' : ℕ) := (Pw_eq_two hv).symm
        refine le_antisymm (by exact_mod_cast Padic.norm_int_le_one (p := (Pw w' : ℕ)) _) ?_
        refine not_lt.mp fun hlt => ?_
        have := Padic.norm_intCast_lt_one_iff.mp (by exact_mod_cast hlt)
        rw [← h2] at this
        omega
    · rw [twoRep, piQ_ιAt_ne hw, mul_one]
      refine ⟨isHur_qp_hurZ' hεZ, hεnorm w', IsHur.smul (quarter_mem (Pw_ne_two hv hw)) ?_⟩
      exact (hu w').sub (isHur_qp_hurZ' hεZ)
  have hw1 : LH ((1 / 4 : ℚ) • ((w : ℍ[AQ]) - 1)) := by
    intro w'
    rw [piQ_qsmul, map_sub, map_one, hwdef, Units.val_mul, map_mul, piQ_unit_inv]
    exact quarter_conj (hA w').1 (hA w').2.1 (hA w').2.2
  have hw2 : LH ((1 / 4 : ℚ) • (((w⁻¹ : ℍ[AQ]ˣ) : ℍ[AQ]) - 1)) := by
    intro w'
    rw [piQ_qsmul, map_sub, map_one, hwdef, mul_inv_rev, inv_inv, Units.val_mul, map_mul]
    exact quarter_conj2 (hu' w') (by rw [← map_mul, Units.inv_mul, map_one]) (hA w').2.2
  refine ⟨t, ε, hε0, w, Subgroup.subset_closure (Or.inl ⟨hw1, hw2⟩), ?_⟩
  rw [← hac, hwdef, ← Units.val_mul, mul_inv_cancel_left]

/-- **TYZ Lemma 2.5, surjectivity**: every unit of `B̂` lies in `B^× (1 + 2x_t) ℚ̂^× U` for some `t`. -/
theorem exists_twoRepU {v : HeightOneSpectrum (𝓞 ℚ)} (hv : IsPlaceTwo v) (x : ℍ[AQ]ˣ) :
    ∃ t, (x : ℍ[AQ]) ∈ DCU (twoRep v t) := by
  obtain ⟨γ, hγ, h1, h2⟩ := exists_global_mul_unit x
  obtain ⟨t, ht⟩ := exists_twoRepU_of_unit hv h1 h2
  refine ⟨t, ?_⟩
  have e : (x : ℍ[AQ]) = qι γ * (((qιU γ hγ)⁻¹ * x : ℍ[AQ]ˣ) : ℍ[AQ]) := by
    show _ = qι γ * (qι γ⁻¹ * x)
    rw [← mul_assoc, ← map_mul, mul_inv_cancel₀ hγ, map_one, one_mul]
  rw [e]
  obtain ⟨γ', hγ', h, hh, e'⟩ := ht
  refine ⟨γ * γ', mul_ne_zero hγ hγ', h, hh, ?_⟩
  rw [e', map_mul]; noncomm_ring

/-! ## Lemma 2.5, injectivity -/

theorem hurZ_zero {R : Type*} [Field R] [CharZero R] : (hurZ (⟨0, 0, 0, 0⟩ : H4 ℤ) : ℍ[R]) = 0 := by
  apply hc_injective
  rw [hc_hurZ]
  ext <;> simp [mapH, hc]

/-- The local condition `ℚ_2^× (ℤ_2 + 4O_{B,2})^×` at `2` (`= ℚ_2^× U_2`). -/
def C0 : LocCond where
  P p _ y := Loc2OK (hurZ (⟨0, 0, 0, 0⟩ : H4 ℤ) : ℍ[ℚ_[p]]) y
  one p _ _ := Loc2OK.one
  mul p _ _ y z hy hz := by
    rw [hurZ_zero] at hy hz ⊢
    exact Loc2OK.mul' (T := 0) (N := 0) isHur_zero (Zp p).zero_mem (Zp p).zero_mem (by simp) hy hz
  inv p _ _ y z hy h := by
    rw [hurZ_zero] at hy ⊢
    exact Loc2OK.of_mul_eq_one' (T := 0) (Zp p).zero_mem (by simp) hy h

/-- An element of `U4` is `1 + 4a` with `a` Hurwitz at every place. -/
theorem U4_local {w : ℍ[AQ]ˣ} (hw : LH ((1 / 4 : ℚ) • ((w : ℍ[AQ]) - 1))) (w' : HeightOneSpectrum (𝓞 ℚ)) :
    ∃ a : ℍ[ℚ_[Pw w']], IsHur (Zp (Pw w' : ℕ)) a ∧ piQ w' (w : ℍ[AQ]) = 1 + (4 : ℚ_[Pw w']) • a := by
  refine ⟨_, hw w', ?_⟩
  rw [piQ_qsmul, smul_smul, map_sub, map_one]
  norm_num

theorem U4_isHur {w : ℍ[AQ]ˣ} (hw : LH ((1 / 4 : ℚ) • ((w : ℍ[AQ]) - 1))) (w' : HeightOneSpectrum (𝓞 ℚ)) :
    IsHur (Zp (Pw w' : ℕ)) (piQ w' (w : ℍ[AQ])) := by
  obtain ⟨a, ha, e⟩ := U4_local hw w'
  rw [e]
  exact isHur_one.add (ha.smul (by simp))

/-- **`ℚ̂^× U ⊂ SgC C0`.** -/
theorem GU_le_SgC {v : HeightOneSpectrum (𝓞 ℚ)} (hv : IsPlaceTwo v) : GU ≤ SgC v hv C0 := by
  refine (Subgroup.closure_le _).mpr (Set.union_subset ?_ ?_)
  · intro r hr w'
    have hu1 := U4_isHur hr.1 w'
    have hu2 := U4_isHur hr.2 w'
    have hprod : piQ w' (r : ℍ[AQ]) * piQ w' ((r⁻¹ : ℍ[AQ]ˣ) : ℍ[AQ]) = 1 := by
      rw [← map_mul, Units.mul_inv, map_one]
    have hn : ‖Quaternion.normSq (piQ w' (r : ℍ[AQ]))‖ = 1 := by
      refine norm_eq_one_of_mul hu1.normSq_mem hu2.normSq_mem ?_
      rw [← map_mul, hprod, map_one]
    refine ⟨fun _ => ?_, fun _ => ⟨1, one_ne_zero, _, by simp, hu1, hn⟩⟩
    show Loc2OK _ _
    rw [hurZ_zero]
    obtain ⟨a, ha, e⟩ := U4_local hr.1 w'
    refine ⟨1, one_ne_zero, _, by simp, hu1, hn, 1, 0, by simp, by simp, a, ha, ?_⟩
    rw [e]; simp
  · rintro _ ⟨z, rfl⟩
    refine centre_mem_SgC v hv C0 (fun p _ _ c hc => ?_) z
    show Loc2OK _ _
    rw [hurZ_zero]
    exact Loc2OK.smul_left hc Loc2OK.one

/-- The local obstruction for the group `ℚ̂^× U` (hfx-proof's `twoRep_not_mem_DC`, with `GU` for `⟨U_n, ℚ̂^×⟩`). -/
theorem twoRep_not_mem_DCU {v : HeightOneSpectrum (𝓞 ℚ)} (hv : IsPlaceTwo v) {t t' : T8}
    (hfin : ∀ (p : ℕ) [Fact p.Prime], p = 2 → ∀ (q : ℚ) (nn : H4 ℤ) (k : ℕ), q ≠ 0 →
      nrdH nn = 2 ^ k → ∀ y, C0.P p y → qp p (q • hurZ nn) * hurZ (βZ t') * y ≠ hurZ (βZ t)) :
    twoRep v t ∉ DCU (twoRep v t') := by
  rintro ⟨γ, hγ, h, hh, e⟩
  have hS := GU_le_SgC hv hh
  have hodd : ∀ (p : ℕ) [Fact p.Prime], p ≠ 2 → LocOK (qp p γ) := by
    intro p hpp hp2
    obtain ⟨w, hw⟩ := exists_place_of_prime p hpp.out
    subst hw
    have hwv : w ≠ v := fun h => hp2 (by rw [h]; exact Pw_eq_two hv)
    have e' := congrArg (piQ w) e
    rw [twoRep, twoRep, piQ_ιAt_ne hwv, map_mul, map_mul, piQ_qι, piQ_ιAt_ne hwv, mul_one] at e'
    exact ((hS w).2 hwv).of_mul_eq_one' e'.symm
  obtain ⟨q, nn, k, hq, hγq, hk⟩ := global_step γ hγ hodd
  have e' := congrArg (piQ v) e
  rw [twoRep, twoRep, piQ_ιAt_self, map_mul, map_mul, piQ_qι, piQ_ιAt_self, twoRepQ_eq,
    twoRepQ_eq, qp_hurZ, qp_hurZ, hγq] at e'
  exact hfin _ (Pw_eq_two hv) q nn k hq hk _ ((hS v).1 rfl) e'.symm

/-- **The check modulo `4`**: `μ β_t ≡ X β_{t'} (mod 4O_B)` with `μ` a Hurwitz unit forces `t = t'`. -/
theorem mod4_sep : ∀ t t' : T8, ∀ μ ∈ unitList, ∀ X Y : ZMod 4,
    mapH (Int.castRingHom (ZMod 4)) (mulH μ (βZ t)) =
      mulH (mapH (Int.castRingHom (ZMod 4)) (βZ t'))
        ⟨X + Y * ((0 : ℤ) : ZMod 4), Y * ((0 : ℤ) : ZMod 4), Y * ((0 : ℤ) : ZMod 4), Y * ((0 : ℤ) : ZMod 4)⟩ →
      t = t' := by
  decide +kernel

/-- **TYZ Lemma 2.5, injectivity**: the 8 double cosets `B^× (1 + 2x_t) ℚ̂^× U` are distinct. -/
theorem twoRep_mem_DCU_iff {v : HeightOneSpectrum (𝓞 ℚ)} (hv : IsPlaceTwo v) {t t' : T8} :
    twoRep v t ∈ DCU (twoRep v t') ↔ t = t' := by
  refine ⟨fun hmem => ?_, fun h => h ▸ mem_DCU_self _⟩
  by_contra hne
  refine twoRep_not_mem_DCU hv ?_ hmem
  intro p _ hp q nn k hq hk y hy heq
  subst hp
  obtain ⟨cc, hcc, u, rfl, hu, hnu, hR⟩ := hy
  obtain ⟨μ, hμ, X, Y, hrel⟩ := two_adic_b1 q hq nn k hk (βZ t) (βZ t') ⟨0, 0, 0, 0⟩ (nrdH_βZ_odd _)
    (nrdH_βZ_odd _) cc hcc u hnu hR heq
  exact hne (mod4_sep t t' μ hμ X Y hrel)

/-! ## The forms `f_δ` -/

/-- **TYZ's `Δ/{±1}`** (Theorem 2.4(1), L617–618): `(i + j)/2, (i − j)/2, (j + k)/2, (j − k)/2, (k + i)/2,
(k − i)/2` (one representative of each pair `±δ`). -/
def deltaQ : Fin 6 → ℍ[ℚ] :=
  ![⟨0, 1 / 2, 1 / 2, 0⟩, ⟨0, 1 / 2, -1 / 2, 0⟩, ⟨0, 0, 1 / 2, 1 / 2⟩, ⟨0, 0, 1 / 2, -1 / 2⟩,
    ⟨0, 1 / 2, 0, 1 / 2⟩, ⟨0, -1 / 2, 0, 1 / 2⟩]

/-- `x_t = a i + b j + c ζ` (`t = (a, b, c)`, `ζ = (−1 + i + j + k)/2`), TYZ's representatives of
`O_{B,2}/(ℤ_2 + 2O_{B,2})` (L646–651). -/
def xRepQ (t : T8) : ℍ[ℚ] :=
  ⟨-((t.2.2 : ℕ) : ℚ) / 2, ((t.1 : ℕ) : ℚ) + ((t.2.2 : ℕ) : ℚ) / 2, ((t.2.1 : ℕ) : ℚ) + ((t.2.2 : ℕ) : ℚ) / 2,
    ((t.2.2 : ℕ) : ℚ) / 2⟩

/-- `1 + 2x_t` is the representative `twoRepQ t`. -/
theorem twoRepQ_eq_one_add (t : T8) : twoRepQ t = 1 + (2 : ℚ) • xRepQ t := by
  ext <;> simp [twoRepQ, xRepQ] <;> ring

/-- The reduced trace `tr q = q + q̄ = 2 Re q` of `ℍ[ℚ]`. -/
def trdQ (q : ℍ[ℚ]) : ℚ := 2 * q.re

/-- **`ψ_δ(t) = (−1)^{tr(δ x_t)}`** (Theorem 2.4(1), L620–622; `tr(δ x_t) ∈ ℤ`, `trd_delta_int`). -/
def psiDelta (δ : Fin 6) (t : T8) : ℤ := (-1) ^ (⌊trdQ (deltaQ δ * xRepQ t)⌋).natAbs

/-- The values of `ψ_δ` in closed form: `(−1)` to `a + b + c, a + b, b + c, b, a + c, a`. -/
def psiTab (δ : Fin 6) (t : T8) : ℤ :=
  (-1) ^ (![(t.1 : ℕ) + t.2.1 + t.2.2, (t.1 : ℕ) + t.2.1, (t.2.1 : ℕ) + t.2.2, (t.2.1 : ℕ),
    (t.1 : ℕ) + t.2.2, (t.1 : ℕ)] δ)

theorem psiDelta_eq_tab : ∀ δ : Fin 6, ∀ t : T8, psiDelta δ t = psiTab δ t := by
  intro δ t
  obtain ⟨a, b, c⟩ := t
  fin_cases δ <;> fin_cases a <;> fin_cases b <;> fin_cases c <;>
    norm_num [psiDelta, psiTab, trdQ, deltaQ, xRepQ, Quaternion.re_mul]

theorem psiTab_orth : ∀ s t : T8,
    ∑ δ : Fin 6, psiTab δ s * psiTab δ t + 1 + chi0Rep s * chi0Rep t = if s = t then 8 else 0 := by
  decide +kernel

theorem psiTab_sum : ∀ δ : Fin 6, ∑ t : T8, psiTab δ t = 0 := by
  decide +kernel

theorem psiTab_sum_chi0 : ∀ δ : Fin 6, ∑ t : T8, chi0Rep t * psiTab δ t = 0 := by
  decide +kernel

/-- **The six `ψ_δ`, `1` and `χ₀` are orthogonal** (the 8 characters of `O_{B,2}/(ℤ_2 + 2O_{B,2})`). -/
theorem psi_orth (s t : T8) :
    ∑ δ : Fin 6, psiDelta δ s * psiDelta δ t + 1 + chi0Rep s * chi0Rep t = if s = t then 8 else 0 := by
  simp only [psiDelta_eq_tab]; exact psiTab_orth s t

theorem psi_sum (δ : Fin 6) : ∑ t : T8, psiDelta δ t = 0 := by
  simp only [psiDelta_eq_tab]; exact psiTab_sum δ

theorem psi_sum_chi0 (δ : Fin 6) : ∑ t : T8, chi0Rep t * psiDelta δ t = 0 := by
  simp only [psiDelta_eq_tab]; exact psiTab_sum_chi0 δ

/-- The place `2` (unique: `place_two_unique`). -/
def v2 : HeightOneSpectrum (𝓞 ℚ) := exists_isPlaceTwo.choose

theorem v2_spec : IsPlaceTwo v2 := exists_isPlaceTwo.choose_spec

theorem place_two_unique {v : HeightOneSpectrum (𝓞 ℚ)} (hv : IsPlaceTwo v) : v = v2 :=
  eq_of_Pw_eq (by rw [Pw_eq_two hv, Pw_eq_two v2_spec])

/-- The class `t` of a unit `x`: `x ∈ B^× (1 + 2x_t) ℚ̂^× U` (unique by `twoRep_mem_DCU_iff`). -/
def clsIdx (x : ℍ[AQ]ˣ) : T8 := (exists_twoRepU v2_spec x).choose

theorem clsIdx_spec (x : ℍ[AQ]ˣ) : (x : ℍ[AQ]) ∈ DCU (twoRep v2 (clsIdx x)) :=
  (exists_twoRepU v2_spec x).choose_spec

theorem clsIdx_eq {x : ℍ[AQ]ˣ} {t : T8} (h : (x : ℍ[AQ]) ∈ DCU (twoRep v2 t)) : clsIdx x = t :=
  (twoRep_mem_DCU_iff v2_spec).mp (DCU_trans h (DCU_symm (clsIdx_spec x)))

theorem clsIdx_eq_of_mem {x y : ℍ[AQ]ˣ} (h : (y : ℍ[AQ]) ∈ DCU x) : clsIdx y = clsIdx x :=
  clsIdx_eq (DCU_trans (clsIdx_spec x) h)

open Classical in
/-- **TYZ's `f_δ`** (Theorem 2.4(1), L615–623): the function on `B^× \ B̂^× / ℚ̂^× U` with
`f_δ(1 + 2x_t) = (−1)^{tr(δ x_t)}` on the 8 representatives of Lemma 2.5 (which determine it, by Lemma 2.5's
bijectivity, `exists_twoRepU`, `twoRep_mem_DCU_iff`); `0` off `B̂^×` (values there are never used). -/
def fDelta (δ : Fin 6) (g : ℍ[AQ]) : ℤ :=
  if h : IsUnit g then psiDelta δ (clsIdx h.unit) else 0

theorem fDelta_unit (δ : Fin 6) (x : ℍ[AQ]ˣ) : fDelta δ x = psiDelta δ (clsIdx x) := by
  rw [fDelta, dite_eq_left_of_eq_true (eq_true x.isUnit)]
  congr 2
  exact Units.ext rfl

/-- `f_δ` is left `B^×`- and right `ℚ̂^× U`-invariant. -/
theorem fDelta_eq_of_mem (δ : Fin 6) {x y : ℍ[AQ]ˣ} (h : (y : ℍ[AQ]) ∈ DCU x) : fDelta δ y = fDelta δ x := by
  rw [fDelta_unit, fDelta_unit, clsIdx_eq_of_mem h]

/-- `f_δ(1 + 2x_t) = (−1)^{tr(δ x_t)}`, at the place `2`. -/
theorem fDelta_twoRep (δ : Fin 6) {v : HeightOneSpectrum (𝓞 ℚ)} (hv : IsPlaceTwo v) (t : T8) :
    fDelta δ (twoRep v t) = psiDelta δ t := by
  have e := fDelta_unit δ (twoRepU v2 t)
  rw [twoRepU_coe] at e
  rw [place_two_unique hv, e, clsIdx_eq (x := twoRepU v2 t) (mem_DCU_self _)]

end ZInQ.Contrib.H21CSteps
