import ZInQKernel.Contrib.OneProof.Abhyankar.Defs

/-!
# abhyankar: `KummerBase` (the Kummer base `A[t, u]` is regular local of dimension 2)

`A'' = A[t, u] ⊆ Ω`, `t^a = f`, `u^b = g`, is finite over `A`, every element is `r + (element of (t, u))`, and
every maximal ideal contains `(t, u)` (it lies over `m = (f, g)`); so `A''` is local with maximal ideal
`(t, u)`. Its dimension is `2`: `≥ 2` by going down over the integrally closed `A` (`height` additivity), `≤ 2`
by Krull's height theorem; so `(t, u)` is generated by `dim A''` elements.
-/

open IsLocalRing HDec Polynomial

set_option linter.all false

noncomputable section

namespace Abhyankar

/-- **`KummerBase` is proved.** -/
theorem kummerBase : KummerBase := by
  intro A Ω _ _ _ _ _ hinj hdim f g hm a b ha hb t u ht hu
  classical
  have htmem : t ∈ Algebra.adjoin A ({t, u} : Set Ω) := Algebra.subset_adjoin (by simp)
  have humem : u ∈ Algebra.adjoin A ({t, u} : Set Ω) := Algebra.subset_adjoin (by simp)
  have hti : IsIntegral A t := ⟨X ^ a - C f, monic_X_pow_sub_C f ha.ne', by simp [ht]⟩
  have hui : IsIntegral A u := ⟨X ^ b - C g, monic_X_pow_sub_C g hb.ne', by simp [hu]⟩
  have hint : ∀ x ∈ ({t, u} : Set Ω), IsIntegral A x := by
    rintro x (rfl | rfl)
    · exact hti
    · exact hui
  haveI : Algebra.IsIntegral A (Algebra.adjoin A ({t, u} : Set Ω)) := Algebra.IsIntegral.adjoin hint
  haveI : Module.Finite A (Algebra.adjoin A ({t, u} : Set Ω)) :=
    Algebra.finite_adjoin_of_finite_of_isIntegral (by simp) hint
  haveI : IsNoetherianRing (Algebra.adjoin A ({t, u} : Set Ω)) :=
    IsNoetherianRing.of_finite A (Algebra.adjoin A ({t, u} : Set Ω))
  have hAinj : Function.Injective (algebraMap A (Algebra.adjoin A ({t, u} : Set Ω))) :=
    fun x y h => hinj (congrArg Subtype.val h)
  haveI : FaithfulSMul A (Algebra.adjoin A ({t, u} : Set Ω)) :=
    (faithfulSMul_iff_algebraMap_injective _ _).mpr hAinj
  set t'' : Algebra.adjoin A ({t, u} : Set Ω) := ⟨t, htmem⟩ with ht''
  set u'' : Algebra.adjoin A ({t, u} : Set Ω) := ⟨u, humem⟩ with hu''
  set M : Ideal (Algebra.adjoin A ({t, u} : Set Ω)) := Ideal.span {t'', u''} with hM
  have htM : t'' ∈ M := Ideal.subset_span (by simp)
  have huM : u'' ∈ M := Ideal.subset_span (by simp)
  have hft : algebraMap A _ f = t'' ^ a := Subtype.ext (by
    show algebraMap A Ω f = t ^ a
    rw [ht])
  have hgu : algebraMap A _ g = u'' ^ b := Subtype.ext (by
    show algebraMap A Ω g = u ^ b
    rw [hu])
  have hmM : ∀ r ∈ maximalIdeal A, algebraMap A (Algebra.adjoin A ({t, u} : Set Ω)) r ∈ M := by
    intro r hr
    rw [hm] at hr
    have := Ideal.mem_map_of_mem (algebraMap A (Algebra.adjoin A ({t, u} : Set Ω))) hr
    rw [Ideal.map_span, Set.image_pair] at this
    refine (Ideal.span_le.mpr ?_) this
    rintro x (rfl | rfl)
    · rw [hft]; exact Ideal.pow_mem_of_mem _ htM a ha
    · rw [hgu]; exact Ideal.pow_mem_of_mem _ huM b hb
  -- every element is `r + m`
  have hdecomp : ∀ x : Algebra.adjoin A ({t, u} : Set Ω),
      ∃ r : A, x - algebraMap A _ r ∈ M := by
    rintro ⟨x, hx⟩
    induction hx using Algebra.adjoin_induction with
    | mem x hx =>
      refine ⟨0, ?_⟩
      rw [map_zero, sub_zero]
      rcases hx with rfl | rfl
      · exact htM
      · exact huM
    | algebraMap r =>
      refine ⟨r, ?_⟩
      have : (⟨algebraMap A Ω r, Subalgebra.algebraMap_mem _ r⟩ : Algebra.adjoin A ({t, u} : Set Ω)) =
          algebraMap A _ r := rfl
      rw [this, sub_self]
      exact M.zero_mem
    | add x y hx hy ihx ihy =>
      obtain ⟨r, hr⟩ := ihx
      obtain ⟨s, hs⟩ := ihy
      refine ⟨r + s, ?_⟩
      have : (⟨x + y, add_mem hx hy⟩ : Algebra.adjoin A ({t, u} : Set Ω)) - algebraMap A _ (r + s) =
          ((⟨x, hx⟩ : Algebra.adjoin A ({t, u} : Set Ω)) - algebraMap A _ r) +
            ((⟨y, hy⟩ : Algebra.adjoin A ({t, u} : Set Ω)) - algebraMap A _ s) := by
        rw [map_add]; apply Subtype.ext; simp only [Subalgebra.coe_add, Subalgebra.coe_sub]; ring
      rw [this]
      exact add_mem hr hs
    | mul x y hx hy ihx ihy =>
      obtain ⟨r, hr⟩ := ihx
      obtain ⟨s, hs⟩ := ihy
      refine ⟨r * s, ?_⟩
      have : (⟨x * y, mul_mem hx hy⟩ : Algebra.adjoin A ({t, u} : Set Ω)) - algebraMap A _ (r * s) =
          ((⟨x, hx⟩ : Algebra.adjoin A ({t, u} : Set Ω)) - algebraMap A _ r) * ⟨y, hy⟩ +
            algebraMap A _ r * ((⟨y, hy⟩ : Algebra.adjoin A ({t, u} : Set Ω)) - algebraMap A _ s) := by
        rw [map_mul]; apply Subtype.ext
        simp only [Subalgebra.coe_add, Subalgebra.coe_sub, Subalgebra.coe_mul]; ring
      rw [this]
      exact add_mem (Ideal.mul_mem_right _ _ hr) (Ideal.mul_mem_left _ _ hs)
  -- every maximal ideal contains `M`
  have hle_max : ∀ 𝔐 : Ideal (Algebra.adjoin A ({t, u} : Set Ω)), 𝔐.IsMaximal → M ≤ 𝔐 := by
    intro 𝔐 h𝔐
    have hu𝔐 : 𝔐.under A = maximalIdeal A := IsLocalRing.eq_maximalIdeal (Ideal.IsMaximal.under A 𝔐)
    have hmem : ∀ r ∈ maximalIdeal A, algebraMap A _ r ∈ 𝔐 := by
      intro r hr
      show r ∈ 𝔐.under A
      rw [hu𝔐]; exact hr
    have hf : f ∈ maximalIdeal A := by rw [hm]; exact Ideal.subset_span (by simp)
    have hg : g ∈ maximalIdeal A := by rw [hm]; exact Ideal.subset_span (by simp)
    rw [hM, Ideal.span_le]
    rintro x (rfl | rfl)
    · have := hmem f hf
      rw [hft] at this
      exact h𝔐.isPrime.mem_of_pow_mem a this
    · have := hmem g hg
      rw [hgu] at this
      exact h𝔐.isPrime.mem_of_pow_mem b this
  have hMne : M ≠ ⊤ := by
    intro htop
    obtain ⟨𝔐, h𝔐⟩ := Ideal.exists_maximal (Algebra.adjoin A ({t, u} : Set Ω))
    exact h𝔐.ne_top (top_le_iff.mp (htop ▸ hle_max 𝔐 h𝔐))
  have hMmax : M.IsMaximal := by
    refine ⟨⟨hMne, fun J hJ => ?_⟩⟩
    obtain ⟨x, hxJ, hxM⟩ := SetLike.exists_of_lt hJ
    obtain ⟨r, hr⟩ := hdecomp x
    have hr' : r ∉ maximalIdeal A := fun h => hxM (by
      have := add_mem hr (hmM r h)
      rwa [sub_add_cancel] at this)
    have hru : IsUnit (algebraMap A (Algebra.adjoin A ({t, u} : Set Ω)) r) :=
      ((IsLocalRing.notMem_maximalIdeal).mp hr').map _
    have hrJ : algebraMap A _ r ∈ J := by
      have := sub_mem hxJ (hJ.le hr)
      rwa [sub_sub_cancel] at this
    exact Ideal.eq_top_of_isUnit_mem _ hrJ hru
  haveI : IsLocalRing (Algebra.adjoin A ({t, u} : Set Ω)) :=
    IsLocalRing.of_unique_max_ideal ⟨M, hMmax, fun 𝔐 h𝔐 =>
      (hMmax.eq_of_le h𝔐.ne_top (hle_max 𝔐 h𝔐)).symm⟩
  have hmaxeq : maximalIdeal (Algebra.adjoin A ({t, u} : Set Ω)) = M :=
    (IsLocalRing.eq_maximalIdeal hMmax).symm
  haveI : IsIntegrallyClosed A := TPurity3.isIntegrallyClosed_of_dim2 hdim
  have hspan : (maximalIdeal (Algebra.adjoin A ({t, u} : Set Ω))).spanFinrank ≤ 2 := by
    rw [hmaxeq, hM]
    exact (Submodule.spanFinrank_span_le_ncard_of_finite (by simp)).trans
      ((Set.ncard_insert_le _ _).trans (by rw [Set.ncard_singleton]))
  have hht : (maximalIdeal (Algebra.adjoin A ({t, u} : Set Ω))).height = 2 := by
    haveI : (maximalIdeal (Algebra.adjoin A ({t, u} : Set Ω))).LiesOver (maximalIdeal A) :=
      ⟨(IsLocalRing.eq_maximalIdeal (Ideal.IsMaximal.under A _)).symm⟩
    have h1 := Ideal.height_eq_height_add_of_liesOver_of_hasGoingDown (maximalIdeal A)
      (maximalIdeal (Algebra.adjoin A ({t, u} : Set Ω)))
    rw [TPurity3.height_maximalIdeal_of_dim2 hdim] at h1
    have h2 := Ideal.height_le_spanFinrank (maximalIdeal (Algebra.adjoin A ({t, u} : Set Ω)))
      (maximalIdeal.isMaximal _).ne_top
    have h3 : (maximalIdeal (Algebra.adjoin A ({t, u} : Set Ω))).height ≤ 2 :=
      h2.trans (by exact_mod_cast hspan)
    apply le_antisymm h3
    rw [h1]
    exact le_self_add
  have hdim'' : ringKrullDim (Algebra.adjoin A ({t, u} : Set Ω)) = 2 := by
    rw [← IsLocalRing.maximalIdeal_height_eq_ringKrullDim, hht]
    rfl
  refine ⟨IsRegularLocalRing.of_spanFinrank_maximalIdeal_le _ ?_, hdim'', ?_⟩
  · rw [hdim'']
    exact_mod_cast hspan
  · exact hMmax

end Abhyankar
