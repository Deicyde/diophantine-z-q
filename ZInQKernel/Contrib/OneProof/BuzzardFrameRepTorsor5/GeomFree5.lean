import ZInQKernel.Contrib.OneProof.Y3FullThreeRepZ30.OrderMod
import ZInQKernel.Contrib.OneProof.Y3FullThreeRepZ30.BuzzardLeaves
import ZInQKernel.Contrib.OneProof.Y3FullThreeRepZ30.TorsionRep
import ZInQKernel.Contrib.OneProof.Y3FullThreeRepZ30.FrameAction
import ZInQKernel.Contrib.OneProof.BuzzardFrameRepTorsor5.Defs
import Mathlib

/-!
# Generators of the 5-torsion of a false elliptic curve at a geometric point

Let `A` be a false elliptic curve over a `Z[1/30]`-scheme and `s` a geometric point of the base.
The points of `A` over `s` form a group, written multiplicatively, on which `O` acts on the left
by `a • x = x ≫ ι(a)`. The group is commutative, since `ι(2)` is the squaring map and is a
homomorphism. Let `V` be its 5-torsion and assume `|V| = 625` (`GeomCard5`, which follows from
Milne's Remark 8.4).

1. The elements `E = 3 + 2k`, `X = 2 - i + (1 + j)/2` and `Y = -2i - j` of `O` satisfy, modulo
   `5 O`, `E² = E`, `E X = X`, `E Y = 0`, `X E = 0`, `X Y = E` and `E + Y X = 1`: they behave as
   the matrix units `e₁₁`, `e₁₂` and `e₂₁` of `M₂(F₅)`.
2. Let `eV` be the set of 5-torsion points fixed by `E`. Then `v ↦ (E • v, X • v)` is a bijection
   from `V` onto `eV × eV`, with inverse `(u, w) ↦ u * (Y • w)`. Hence `|eV| = 25`, and the
   elementary abelian group `eV` is generated by two points `u` and `w`.
3. `P = u * (Y • w)` satisfies `E • P = u` and `X • P = w`. Every `v ∈ V` is
   `(E • v) * (Y • (X • v))` with `E • v` and `X • v` in `eV`, so `v` lies in the orbit of `P`.
4. The orbit map `O / 5 O → V`, `a ↦ a • P`, is a surjection between sets with 625 elements,
   hence a bijection: `a • P = 1` exactly when `a ∈ 5 O`. So `P` generates the 5-torsion.
-/

set_option autoImplicit false
noncomputable section
open LeafQM LeafQM.AV

namespace Y3Buzzard

namespace GF5

/-! ## Three matrix units of `O / 5 O` -/

/-- `E = 3 + 2k`, the element `e5`. -/
def mE : O := e5

/-- `X = 2 - i + (1 + j)/2`. -/
def mX : O := ⟨ofInt ![2, -1, 1, 0], ⟨_, rfl⟩⟩

/-- `Y = -2i - j`. -/
def mY : O := ⟨ofInt ![1, -2, -2, 0], ⟨_, rfl⟩⟩

theorem coe_five : (((5 : ℕ) : O) : B) = 5 :=
  (SubringClass.coe_natCast O 5).trans (by norm_num)

/-- `E² ≡ E` modulo `5 O`. -/
theorem rel_EE : ∃ c : O, mE * mE - mE = ((5 : ℕ) : O) * c := by
  refine ⟨⟨ofInt ![6, -2, 0, 4], ⟨_, rfl⟩⟩, Subtype.ext ?_⟩
  rw [AddSubgroupClass.coe_sub, MulMemClass.coe_mul, MulMemClass.coe_mul, coe_five]
  show ofInt ![3, -2, 0, 4] * ofInt ![3, -2, 0, 4] - ofInt ![3, -2, 0, 4] =
    5 * ofInt ![6, -2, 0, 4]
  ext <;> simp [ofInt, QuaternionAlgebra.re_ofNat, QuaternionAlgebra.imI_ofNat,
    QuaternionAlgebra.imJ_ofNat, QuaternionAlgebra.imK_ofNat] <;> norm_num

/-- `E X ≡ X` modulo `5 O`. -/
theorem rel_EX : ∃ c : O, mE * mX - mX = ((5 : ℕ) : O) * c := by
  refine ⟨⟨ofInt ![0, -2, 2, 2], ⟨_, rfl⟩⟩, Subtype.ext ?_⟩
  rw [AddSubgroupClass.coe_sub, MulMemClass.coe_mul, MulMemClass.coe_mul, coe_five]
  show ofInt ![3, -2, 0, 4] * ofInt ![2, -1, 1, 0] - ofInt ![2, -1, 1, 0] =
    5 * ofInt ![0, -2, 2, 2]
  ext <;> simp [ofInt, QuaternionAlgebra.re_ofNat, QuaternionAlgebra.imI_ofNat,
    QuaternionAlgebra.imJ_ofNat, QuaternionAlgebra.imK_ofNat] <;> norm_num

/-- `E Y ≡ 0` modulo `5 O`. -/
theorem rel_EY : ∃ c : O, mE * mY - 0 = ((5 : ℕ) : O) * c := by
  refine ⟨⟨ofInt ![-1, 0, 2, 0], ⟨_, rfl⟩⟩, Subtype.ext ?_⟩
  rw [AddSubgroupClass.coe_sub, MulMemClass.coe_mul, MulMemClass.coe_mul, coe_five,
    ZeroMemClass.coe_zero]
  show ofInt ![3, -2, 0, 4] * ofInt ![1, -2, -2, 0] - 0 = 5 * ofInt ![-1, 0, 2, 0]
  ext <;> simp [ofInt, QuaternionAlgebra.re_ofNat, QuaternionAlgebra.imI_ofNat,
    QuaternionAlgebra.imJ_ofNat, QuaternionAlgebra.imK_ofNat] <;> norm_num

/-- `X E ≡ 0` modulo `5 O`. -/
theorem rel_XE : ∃ c : O, mX * mE - 0 = ((5 : ℕ) : O) * c := by
  refine ⟨⟨ofInt ![2, -1, -1, 2], ⟨_, rfl⟩⟩, Subtype.ext ?_⟩
  rw [AddSubgroupClass.coe_sub, MulMemClass.coe_mul, MulMemClass.coe_mul, coe_five,
    ZeroMemClass.coe_zero]
  show ofInt ![2, -1, 1, 0] * ofInt ![3, -2, 0, 4] - 0 = 5 * ofInt ![2, -1, -1, 2]
  ext <;> simp [ofInt, QuaternionAlgebra.re_ofNat, QuaternionAlgebra.imI_ofNat,
    QuaternionAlgebra.imJ_ofNat, QuaternionAlgebra.imK_ofNat] <;> norm_num

/-- `X Y ≡ E` modulo `5 O`. -/
theorem rel_XY : ∃ c : O, mX * mY - mE = ((5 : ℕ) : O) * c := by
  refine ⟨⟨ofInt ![1, -1, -1, 0], ⟨_, rfl⟩⟩, Subtype.ext ?_⟩
  rw [AddSubgroupClass.coe_sub, MulMemClass.coe_mul, MulMemClass.coe_mul, coe_five]
  show ofInt ![2, -1, 1, 0] * ofInt ![1, -2, -2, 0] - ofInt ![3, -2, 0, 4] =
    5 * ofInt ![1, -1, -1, 0]
  ext <;> simp [ofInt, QuaternionAlgebra.re_ofNat, QuaternionAlgebra.imI_ofNat,
    QuaternionAlgebra.imJ_ofNat, QuaternionAlgebra.imK_ofNat] <;> norm_num

/-- `E + Y X ≡ 1` modulo `5 O`. -/
theorem rel_EYX : ∃ c : O, mE + mY * mX - 1 = ((5 : ℕ) : O) * c := by
  refine ⟨⟨ofInt ![2, -1, -1, 0], ⟨_, rfl⟩⟩, Subtype.ext ?_⟩
  rw [AddSubgroupClass.coe_sub, AddMemClass.coe_add, MulMemClass.coe_mul, MulMemClass.coe_mul,
    coe_five, OneMemClass.coe_one]
  show ofInt ![3, -2, 0, 4] + ofInt ![1, -2, -2, 0] * ofInt ![2, -1, 1, 0] - 1 =
    5 * ofInt ![2, -1, -1, 0]
  ext <;> simp [ofInt, QuaternionAlgebra.re_ofNat, QuaternionAlgebra.imI_ofNat,
    QuaternionAlgebra.imJ_ofNat, QuaternionAlgebra.imK_ofNat] <;> norm_num

/-! ## `O / 5 O` has 625 elements -/

/-- The class of the standard lift of `c`. -/
def liftMod5 (c : Fin 4 → ZMod 5) : Y3OrderMod.OMod 5 :=
  ((⟨ofInt (fun i => ((c i).val : ℤ)), Y3OrderMod.ofInt_mem _⟩ : O) : Y3OrderMod.OMod 5)

theorem five_mul_ofInt (k : Fin 4 → ℤ) : (5 : B) * ofInt k = ofInt (fun i => 5 * k i) := by
  ext <;> simp [ofInt, QuaternionAlgebra.re_ofNat, QuaternionAlgebra.imI_ofNat,
    QuaternionAlgebra.imJ_ofNat, QuaternionAlgebra.imK_ofNat] <;> ring

theorem liftMod5_injective : Function.Injective liftMod5 := by
  intro c c' h
  unfold liftMod5 at h
  obtain ⟨d, hd⟩ := Y3OrderMod.coe_eq_coe_iff.1 h
  obtain ⟨k, hk⟩ := Y3OrderMod.exists_ofInt d
  have h5 : ofInt (fun i => ((c i).val : ℤ)) - ofInt (fun i => ((c' i).val : ℤ)) =
      (5 : B) * ofInt k := by
    have := congrArg Subtype.val hd
    rw [AddSubgroupClass.coe_sub, MulMemClass.coe_mul, coe_five, hk] at this
    exact this
  rw [LeafQM.AV.ofInt_sub, five_mul_ofInt] at h5
  have h4 := LeafQM.AV.ofInt_injective h5
  funext i
  have h6 := congrFun h4 i
  simp only [Pi.sub_apply] at h6
  have h7 : (((c i).val : ℤ) : ZMod 5) - (((c' i).val : ℤ) : ZMod 5) = 0 := by
    rw [← Int.cast_sub, h6]
    push_cast
    rw [show (5 : ZMod 5) = 0 from rfl, zero_mul]
  simpa [sub_eq_zero] using h7

theorem liftMod5_surjective : Function.Surjective liftMod5 := by
  intro q
  obtain ⟨x, rfl⟩ := Y3OrderMod.coe_surjective 5 q
  obtain ⟨n, hn⟩ := Y3OrderMod.exists_ofInt x
  refine ⟨fun i => ((n i : ℤ) : ZMod 5), ?_⟩
  have hr : ∀ i, ((((n i : ℤ) : ZMod 5).val : ℕ) : ℤ) = n i % ((5 : ℕ) : ℤ) :=
    fun i => ZMod.val_intCast (n i)
  unfold liftMod5
  apply Eq.symm
  apply Y3OrderMod.coe_eq_coe_iff.2
  refine Y3OrderMod.rel_of_B x _ (ofInt (fun i => n i / ((5 : ℕ) : ℤ))) _
    (Y3OrderMod.ofInt_mem _) ?_
  have hsplit : ofInt n
      = ofInt (fun i => ((((n i : ℤ) : ZMod 5).val : ℕ) : ℤ)) +
        ((5 : ℕ) : B) * ofInt (fun i => n i / ((5 : ℕ) : ℤ)) := by
    rw [← Y3OrderMod.ofInt_smul, ← Y3OrderMod.ofInt_add]
    congr 1
    funext i
    simp only [Pi.add_apply, nsmul_eq_mul, hr]
    exact (Int.emod_add_mul_ediv (n i) ((5 : ℕ) : ℤ)).symm
  rw [hn, hsplit]
  abel

/-- `O / 5 O` has 625 elements. -/
theorem card_OMod5 : Nat.card (Y3OrderMod.OMod 5) = 625 := by
  rw [← Nat.card_congr (Equiv.ofBijective liftMod5 ⟨liftMod5_injective, liftMod5_surjective⟩),
    Nat.card_eq_fintype_card, Fintype.card_fun, ZMod.card, Fintype.card_fin]
  norm_num

/-! ## Two generators of an elementary abelian group of order 25 -/

theorem exists_span_pair {W : Type*} [AddCommGroup W] [Finite W]
    (h5 : ∀ w : W, (5 : ℕ) • w = 0) (hcard : Nat.card W = 25) :
    ∃ u v : W, ∀ w : W, ∃ c d : ℕ, w = c • u + d • v := by
  have : Fact (Nat.Prime 5) := ⟨by norm_num⟩
  let _ : Module (ZMod 5) W := AddCommGroup.zmodModule h5
  have : Module.Finite (ZMod 5) W := inferInstance
  have hfr : Module.finrank (ZMod 5) W = 2 := by
    have h1 := Module.natCard_eq_pow_finrank (K := ZMod 5) (V := W)
    rw [hcard, Nat.card_zmod] at h1
    exact Nat.pow_right_injective (le_of_lt (by norm_num : 2 < 5))
      (show 5 ^ Module.finrank (ZMod 5) W = 5 ^ 2 by rw [← h1])
  let b := Module.finBasisOfFinrankEq (ZMod 5) W hfr
  refine ⟨b 0, b 1, fun w => ⟨(b.repr w 0).val, (b.repr w 1).val, ?_⟩⟩
  have key : ∀ (c : ZMod 5) (x : W), c • x = c.val • x := fun c x => by
    conv_lhs => rw [← ZMod.natCast_zmod_val c]
    exact Nat.cast_smul_eq_nsmul (ZMod 5) c.val x
  have hs := b.sum_repr w
  rw [Fin.sum_univ_two, key, key] at hs
  exact hs.symm

theorem exists_span_pair_mul {W : Type*} [Group W] [Finite W]
    (hcomm : ∀ a b : W, a * b = b * a) (h5 : ∀ w : W, w ^ 5 = 1) (hcard : Nat.card W = 25) :
    ∃ u v : W, ∀ w : W, ∃ c d : ℕ, w = u ^ c * v ^ d := by
  let _ : CommGroup W := { (inferInstance : Group W) with mul_comm := hcomm }
  obtain ⟨u, v, h⟩ := exists_span_pair (W := Additive W)
    (fun w => congrArg Additive.ofMul (h5 (Additive.toMul w)))
    ((Nat.card_congr Additive.toMul).trans hcard)
  refine ⟨Additive.toMul u, Additive.toMul v, fun w => ?_⟩
  obtain ⟨c, d, hw⟩ := h (Additive.ofMul w)
  exact ⟨c, d, congrArg Additive.toMul hw⟩

/-! ## Left actions of `O` on groups -/

/-- A left action of `O` on a group by endomorphisms, additive in the acting element. -/
structure OAct (H : Type*) [Group H] where
  /-- The action `x ↦ a • x`. -/
  act : O → H → H
  act_add : ∀ (a b : O) (x : H), act (a + b) x = act a x * act b x
  act_comp : ∀ (a b : O) (x : H), act b (act a x) = act (b * a) x
  act_one : ∀ x : H, act 1 x = x
  act_mul : ∀ (a : O) (x y : H), act a (x * y) = act a x * act a y

namespace OAct

variable {H : Type*} [Group H] (T : OAct H)

theorem act_zero (x : H) : T.act 0 x = 1 := by
  have h := T.act_add 0 0 x
  rw [add_zero] at h
  exact mul_left_cancel (h.symm.trans (mul_one _).symm)

theorem act_natCast (n : ℕ) (x : H) : T.act (n : O) x = x ^ n := by
  induction n with
  | zero => rw [Nat.cast_zero, pow_zero]; exact T.act_zero x
  | succ n ih => rw [Nat.cast_succ, T.act_add, ih, T.act_one, pow_succ]

theorem act_one_right (a : O) : T.act a 1 = 1 := by
  have h := T.act_mul a 1 1
  rw [mul_one] at h
  exact mul_left_cancel (h.symm.trans (mul_one _).symm)

/-- `x ↦ a • x` as a monoid endomorphism. -/
def hom (a : O) : H →* H where
  toFun := T.act a
  map_one' := T.act_one_right a
  map_mul' := T.act_mul a

theorem act_pow (a : O) (x : H) (n : ℕ) : T.act a (x ^ n) = T.act a x ^ n :=
  map_pow (T.hom a) x n

theorem act_inv (a : O) (x : H) : T.act a x⁻¹ = (T.act a x)⁻¹ :=
  map_inv (T.hom a) x

include T in
/-- The group is commutative: `x ↦ 2 • x` is the squaring map and is multiplicative. -/
theorem comm (x y : H) : x * y = y * x := by
  have h := T.act_mul ((2 : ℕ) : O) x y
  rw [T.act_natCast, T.act_natCast, T.act_natCast, pow_two, pow_two, pow_two] at h
  have h' : x * (y * x) * y = x * (x * y) * y := by
    simpa only [mul_assoc] using h
  exact (mul_left_cancel (mul_right_cancel h')).symm

include T in
theorem tors_mul {x y : H} (hx : x ^ 5 = 1) (hy : y ^ 5 = 1) : (x * y) ^ 5 = 1 := by
  rw [Commute.mul_pow (T.comm x y), hx, hy, mul_one]

theorem act_tors {x : H} (hx : x ^ 5 = 1) (a : O) : T.act a x ^ 5 = 1 := by
  rw [← T.act_pow, hx, T.act_one_right]

/-- On `5`-torsion, `a • x` only depends on `a` modulo `5`. -/
theorem act_congr {x : H} (hx : x ^ 5 = 1) {a b : O}
    (hab : ∃ c : O, a - b = ((5 : ℕ) : O) * c) : T.act a x = T.act b x := by
  obtain ⟨c, hc⟩ := hab
  have ha : a = b + ((5 : ℕ) : O) * c := by rw [← hc]; abel
  rw [ha, T.act_add, ← T.act_comp c ((5 : ℕ) : O) x, T.act_natCast, ← T.act_pow, hx,
    T.act_one_right, mul_one]

theorem comb (a b : O) (c d : ℕ) (P : H) :
    T.act ((c : O) * a + (d : O) * b) P = T.act a P ^ c * T.act b P ^ d := by
  rw [T.act_add, ← T.act_comp a (c : O) P, ← T.act_comp b (d : O) P, T.act_natCast,
    T.act_natCast]

/-- The `5`-torsion points fixed by `E`. -/
def eV : Subgroup H where
  carrier := {x | x ^ 5 = 1 ∧ T.act mE x = x}
  mul_mem' := by
    rintro x y ⟨hx5, hxE⟩ ⟨hy5, hyE⟩
    exact ⟨T.tors_mul hx5 hy5, by rw [T.act_mul, hxE, hyE]⟩
  one_mem' := ⟨one_pow 5, T.act_one_right mE⟩
  inv_mem' := by
    rintro x ⟨hx5, hxE⟩
    exact ⟨by rw [inv_pow, hx5, inv_one], by rw [T.act_inv, hxE]⟩

theorem mem_eV {x : H} : x ∈ T.eV ↔ x ^ 5 = 1 ∧ T.act mE x = x := Iff.rfl

theorem decomp {x : H} (hx : x ^ 5 = 1) : x = T.act mE x * T.act mY (T.act mX x) := by
  rw [T.act_comp, ← T.act_add, T.act_congr hx rel_EYX, T.act_one]

theorem split_fst {u w : H} (hu : u ∈ T.eV) (hw : w ∈ T.eV) :
    T.act mE (u * T.act mY w) = u := by
  have hu' := T.mem_eV.1 hu
  have hw' := T.mem_eV.1 hw
  rw [T.act_mul, hu'.2, T.act_comp, T.act_congr hw'.1 rel_EY, T.act_zero, mul_one]

theorem split_snd {u w : H} (hu : u ∈ T.eV) (hw : w ∈ T.eV) :
    T.act mX (u * T.act mY w) = w := by
  have hu' := T.mem_eV.1 hu
  have hw' := T.mem_eV.1 hw
  have h1 : T.act mX u = 1 :=
    calc T.act mX u = T.act mX (T.act mE u) := by rw [hu'.2]
      _ = T.act (mX * mE) u := T.act_comp _ _ _
      _ = T.act 0 u := T.act_congr hu'.1 rel_XE
      _ = 1 := T.act_zero u
  rw [T.act_mul, h1, one_mul, T.act_comp, T.act_congr hw'.1 rel_XY, hw'.2]

/-- `v ↦ (E • v, X • v)` is a bijection from the `5`-torsion onto `eV × eV`, with inverse
`(u, w) ↦ u * (Y • w)`. -/
def split : {x : H // x ^ 5 = 1} ≃ T.eV × T.eV where
  toFun v := (⟨T.act mE v.1, T.mem_eV.2 ⟨T.act_tors v.2 mE,
      (T.act_comp mE mE v.1).trans (T.act_congr v.2 rel_EE)⟩⟩,
    ⟨T.act mX v.1, T.mem_eV.2 ⟨T.act_tors v.2 mX,
      (T.act_comp mX mE v.1).trans (T.act_congr v.2 rel_EX)⟩⟩)
  invFun p := ⟨p.1.1 * T.act mY p.2.1,
    T.tors_mul (T.mem_eV.1 p.1.2).1 (T.act_tors (T.mem_eV.1 p.2.2).1 mY)⟩
  left_inv v := Subtype.ext (T.decomp v.2).symm
  right_inv p := Prod.ext (Subtype.ext (T.split_fst p.1.2 p.2.2))
    (Subtype.ext (T.split_snd p.1.2 p.2.2))

/-- If the `5`-torsion has 625 elements, some `5`-torsion point `P` has every `5`-torsion point
in its orbit. -/
theorem exists_surj (hcard : Nat.card {x : H // x ^ 5 = 1} = 625) :
    ∃ P : H, P ^ 5 = 1 ∧ ∀ x : H, x ^ 5 = 1 → ∃ a : O, x = T.act a P := by
  have hK : Nat.card T.eV = 25 := by
    have h := (Nat.card_congr T.split).symm.trans hcard
    rw [Nat.card_prod] at h
    exact Nat.mul_self_inj.1 (h.trans (by norm_num))
  have : Finite T.eV := Nat.finite_of_card_ne_zero (by rw [hK]; norm_num)
  obtain ⟨u, v, hspan⟩ := exists_span_pair_mul (W := T.eV)
    (fun a b => Subtype.ext (T.comm a.1 b.1)) (fun w => Subtype.ext (T.mem_eV.1 w.2).1) hK
  obtain ⟨P, hPdef⟩ : ∃ P : H, P = u.1 * T.act mY v.1 := ⟨_, rfl⟩
  have hEP : T.act mE P = u.1 := by rw [hPdef]; exact T.split_fst u.2 v.2
  have hXP : T.act mX P = v.1 := by rw [hPdef]; exact T.split_snd u.2 v.2
  refine ⟨P, ?_, fun x hx => ?_⟩
  · rw [hPdef]
    exact T.tors_mul (T.mem_eV.1 u.2).1 (T.act_tors (T.mem_eV.1 v.2).1 mY)
  obtain ⟨c1, c2, h1⟩ := hspan ⟨T.act mE x, T.mem_eV.2 ⟨T.act_tors hx mE,
    (T.act_comp mE mE x).trans (T.act_congr hx rel_EE)⟩⟩
  obtain ⟨d1, d2, h2⟩ := hspan ⟨T.act mX x, T.mem_eV.2 ⟨T.act_tors hx mX,
    (T.act_comp mX mE x).trans (T.act_congr hx rel_EX)⟩⟩
  have h1' : T.act mE x = u.1 ^ c1 * v.1 ^ c2 := congrArg Subtype.val h1
  have h2' : T.act mX x = u.1 ^ d1 * v.1 ^ d2 := congrArg Subtype.val h2
  have e1 : T.act ((c1 : O) * mE + (c2 : O) * mX) P = T.act mE x := by
    rw [T.comb, hEP, hXP, h1']
  have e2 : T.act (mY * ((d1 : O) * mE + (d2 : O) * mX)) P = T.act mY (T.act mX x) := by
    rw [← T.act_comp, T.comb, hEP, hXP, h2']
  refine ⟨(c1 : O) * mE + (c2 : O) * mX + mY * ((d1 : O) * mE + (d2 : O) * mX), ?_⟩
  rw [T.act_add, e1, e2]
  exact T.decomp hx

/-- A chosen representative of a class modulo 5. -/
def rep5 (q : Y3OrderMod.OMod 5) : O := Classical.choose (Y3OrderMod.coe_surjective 5 q)

theorem rep5_spec (q : Y3OrderMod.OMod 5) : ((rep5 q : O) : Y3OrderMod.OMod 5) = q :=
  Classical.choose_spec (Y3OrderMod.coe_surjective 5 q)

/-- A generator of the `5`-torsion: its annihilator is `5 O` and its orbit is the whole
`5`-torsion. The first clause follows from the second by counting, as `O / 5 O` and the
`5`-torsion both have 625 elements. -/
theorem exists_gen (hcard : Nat.card {x : H // x ^ 5 = 1} = 625) :
    ∃ P : H, (∀ a : O, T.act a P = 1 ↔ ∃ b : O, a = ((5 : ℕ) : O) * b) ∧
      ∀ x : H, x ^ 5 = 1 → ∃ a : O, x = T.act a P := by
  obtain ⟨P, hP5, hsurj⟩ := T.exists_surj hcard
  refine ⟨P, fun a => ⟨fun ha => ?_, fun hb => ?_⟩, hsurj⟩
  · have : Finite (Y3OrderMod.OMod 5) := Y3OrderMod.finite_OMod 5 (by norm_num)
    let f : Y3OrderMod.OMod 5 → {x : H // x ^ 5 = 1} :=
      fun q => ⟨T.act (rep5 q) P, T.act_tors hP5 _⟩
    have hf : ∀ b : O, (f (b : Y3OrderMod.OMod 5)).1 = T.act b P := fun b =>
      T.act_congr hP5 (Y3OrderMod.coe_eq_coe_iff.1 (rep5_spec (b : Y3OrderMod.OMod 5)))
    have hfs : Function.Surjective f := by
      rintro ⟨x, hx⟩
      obtain ⟨b, rfl⟩ := hsurj x hx
      exact ⟨(b : Y3OrderMod.OMod 5), Subtype.ext (hf b)⟩
    have hfb := (Nat.bijective_iff_surjective_and_card f).2 ⟨hfs, card_OMod5.trans hcard.symm⟩
    have h0 : f (a : Y3OrderMod.OMod 5) = f ((0 : O) : Y3OrderMod.OMod 5) :=
      Subtype.ext ((hf a).trans (ha.trans ((T.act_zero P).symm.trans (hf 0).symm)))
    obtain ⟨c, hc⟩ := Y3OrderMod.coe_eq_coe_iff.1 (hfb.1 h0)
    exact ⟨c, by rw [← hc, sub_zero]⟩
  · obtain ⟨b, rfl⟩ := hb
    rw [← T.act_comp b ((5 : ℕ) : O) P, T.act_natCast, ← T.act_pow, hP5, T.act_one_right]

end OAct

end GF5

/-! ## The 5-torsion of a false elliptic curve at a geometric point -/

section Geom

open CategoryTheory AlgebraicGeometry Limits MonoidalCategory CartesianMonoidalCategory MonObj
open scoped CategoryTheory.Obj

attribute [local instance] FEC.grp

/-- The action `a • x = x ≫ ι(a)` of `O` on the points of `A` over `U`. -/
def GF5.fecAct {S : Scheme.{0}} (A : FEC S) (U : Over S) : GF5.OAct (U ⟶ A.F) where
  act a x := x ≫ (Over.homMk (A.iota a) (A.iota_over a) : A.F ⟶ A.F)
  act_add a b x := comp_iota_add A x a b
  act_comp a b x := comp_iota_comp_iota A x a b
  act_one x := by rw [iotaHom_one, Category.comp_id]
  act_mul a x y := by
    have := A.iota_hom a
    exact MonObj.mul_comp _ _ _

/-- At every geometric point of a `Z[1/30]`-scheme, the 5-torsion of a false elliptic curve has
a generator, given that it has 625 points. -/
theorem geomFree5_of_card (h : GeomCard5) : GeomFreeM 5 := by
  intro S A k _ _ s
  obtain ⟨P, h1, h2⟩ := (GF5.fecAct A (Over.mk s)).exists_gen (h S A k s)
  exact ⟨P, h1, h2⟩

end Geom

