/-! The function field of the fixed model embeds in punctured meromorphic germs. -/

noncomputable section

namespace ShimuraPointDict

open AlgebraicGeometry CategoryTheory Filter
open LeafModCurves AfTateLam X1Igusa.Weber UpperHalfPlane
open scoped Topology

local notation "Pol" => Polynomial (Polynomial ℤ)

/-- Integral polynomials evaluated in two algebraic generators. -/
def algEval {K : Type} [CommRing K] (a b : K) : Pol →+* K :=
  Polynomial.eval₂RingHom (Polynomial.eval₂RingHom (Int.castRingHom K) a) b

theorem algEval_apply {K : Type} [CommRing K] (a b : K) (P : Pol) :
    algEval a b P = AfTateOr.ev2 P a b := by
  rw [AfTateOr.ev2, Polynomial.eval_map]
  rfl

/-- A field generated by two elements consists of quotients of integral polynomials in them. -/
theorem exists_polynomial_fraction {K : Type} [Field K] {a b : K}
    (h : Subfield.closure {a, b} = ⊤) (g : K) :
    ∃ P Q : Pol, algEval a b Q ≠ 0 ∧ g = algEval a b P / algEval a b Q := by
  have hle : Subring.closure ({a, b} : Set K) ≤ (algEval a b).range := by
    apply Subring.closure_le.mpr
    intro x hx
    rcases Set.mem_insert_iff.mp hx with rfl | hx
    · exact ⟨Polynomial.C Polynomial.X, by simp [algEval]⟩
    · have : x = b := Set.mem_singleton_iff.mp hx
      subst x
      exact ⟨Polynomial.X, by simp [algEval]⟩
  have hg : g ∈ Subfield.closure ({a, b} : Set K) := by rw [h]; trivial
  obtain ⟨p, hp, q, hq, he⟩ := Subfield.mem_closure_iff.mp hg
  by_cases hz : q = 0
  · have : g = 0 := by simpa [hz] using he.symm
    exact ⟨0, 1, by simp, by simp [this]⟩
  · obtain ⟨P, rfl⟩ := hle hp
    obtain ⟨Q, rfl⟩ := hle hq
    exact ⟨P, Q, hz, he.symm⟩

/-- The holomorphic extensions agree with the generic branches off a discrete exceptional set. -/
private theorem eventually_good (z : ℂ) (hz : z ∈ Hs) :
    ∀ᶠ w in 𝓝[≠] z, G2f w ≠ 0 ∧ G3f w ≠ 0 := by
  have ev {f : ℂ → ℂ} (hf : DifferentiableOn ℂ f Hs) (hne : ∃ w ∈ Hs, f w ≠ 0) :
      ∀ᶠ w in 𝓝[≠] z, f w ≠ 0 := by
    have ha := hf.analyticOnNhd isOpen_Hs z hz
    rcases ha.meromorphicAt.eventually_eq_zero_or_eventually_ne_zero with he | he
    · exfalso
      obtain ⟨w, hw, hne⟩ := hne
      apply hne
      apply eq_zero_of_eventually hf hz _ w hw
      exact (ha.continuousAt.eventuallyEq_nhds_iff_eventuallyEq_nhdsNE continuousAt_const).mp he
    · exact he
  exact (ev diffOn_G2f ⟨UpperHalfPlane.I, UpperHalfPlane.I.coe_im_pos, by
    simpa only [G2f, ofComplex_apply] using g2_I_ne⟩).and
    (ev diffOn_G3f ⟨τρ, τρ.coe_im_pos, by simpa only [G3f, ofComplex_apply] using g3_ρ_ne⟩)

theorem map_punctured_coe (τ : UpperHalfPlane) :
    Filter.map ((↑) : UpperHalfPlane → ℂ) (𝓝[≠] τ) = 𝓝[≠] (τ : ℂ) := by
  have h : ((↑) : UpperHalfPlane → ℂ) ⁻¹' {(τ : ℂ)}ᶜ = {τ}ᶜ := by
    ext y
    simp [UpperHalfPlane.coe_inj]
  rw [← h]
  exact UpperHalfPlane.isOpenEmbedding_coe.map_nhdsWithin_preimage_eq _ _

/-- The original quotient and the quotient of holomorphic extensions have exactly the same
punctured limits. This also holds at the exceptional Weber parameters. -/
theorem tendsto_quotient_iff (N : ℕ) (τ : UpperHalfPlane) (P Q : Pol) (c : ℂ) :
    Tendsto (fun σ : UpperHalfPlane => evAn N (AfTateOr.toQ P) σ / evAn N (AfTateOr.toQ Q) σ)
        (𝓝[≠] τ) (𝓝 c) ↔
      Tendsto (fun z : ℂ => ez N z (AfTateOr.toQ P) / ez N z (AfTateOr.toQ Q))
        (𝓝[≠] (τ : ℂ)) (𝓝 c) := by
  rw [← map_punctured_coe τ, tendsto_map'_iff]
  have hg := eventually_good (τ : ℂ) τ.coe_im_pos
  rw [← map_punctured_coe τ, eventually_map] at hg
  apply tendsto_congr'
  filter_upwards [hg] with σ hσ
  have h₂ : (T5Glue.pp σ).g₂ ≠ 0 := by simpa [G2f] using hσ.1
  have h₃ : (T5Glue.pp σ).g₃ ≠ 0 := by simpa [G3f] using hσ.2
  simp only [Function.comp_apply, evAn_eq _ σ h₂ h₃]

section Model

variable {N : ℕ} {X : Over SpecQ} [IsIntegral X.left] {jX tX : X.left.functionField}

/-- Polynomial evaluation in the analytic coordinates, valued in germs. -/
def polynomialGerm (N : ℕ) (τ : UpperHalfPlane) : Pol →+* PuncturedGerm (τ : ℂ) :=
  (Germ.coeRingHom _).comp ((RingHom.pi fun z : ℂ => ez N z).comp AfTateOr.toQ)

theorem polynomialGerm_eq_zero_iff (hN : 2 ≤ N) (hG : IsX1Gen N X jX tX)
    (τ : UpperHalfPlane) (P : Pol) :
    polynomialGerm N τ P = 0 ↔ algEval jX tX P = 0 := by
  rw [algEval_apply, hG.2 P]
  change ((fun z => ez N z (AfTateOr.toQ P) : ℂ → ℂ) : PuncturedGerm (τ : ℂ)) =
    ((fun _ : ℂ => (0 : ℂ)) : PuncturedGerm (τ : ℂ)) ↔ _
  rw [Germ.coe_eq]
  have hdiff := diffOn_ez hN (AfTateOr.toQ P)
  have han := hdiff.analyticOnNhd isOpen_Hs (τ : ℂ) τ.coe_im_pos
  constructor
  · intro he σ h₂ h₃
    rw [evAn_eq _ σ h₂ h₃]
    apply eq_zero_of_eventually hdiff τ.coe_im_pos _ (σ : ℂ) σ.coe_im_pos
    exact (han.continuousAt.eventuallyEq_nhds_iff_eventuallyEq_nhdsNE continuousAt_const).mp he
  · intro h
    have hz : ∀ᶠ z in 𝓝[≠] (τ : ℂ), z ∈ Hs :=
      mem_of_superset (nhdsWithin_le_nhds (isOpen_Hs.mem_nhds τ.coe_im_pos)) (fun _ h => h)
    filter_upwards [hz, eventually_good (τ : ℂ) τ.coe_im_pos] with z hz hg
    let σ : UpperHalfPlane := ⟨z, hz⟩
    have h₂ : (T5Glue.pp σ).g₂ ≠ 0 := by simpa [G2f, ofComplex_apply_of_im_pos hz, σ] using hg.1
    have h₃ : (T5Glue.pp σ).g₃ ≠ 0 := by simpa [G3f, ofComplex_apply_of_im_pos hz, σ] using hg.2
    exact (evAn_eq _ σ h₂ h₃).symm.trans (h σ h₂ h₃)

private theorem polynomial_eventually_ne_zero (hN : 2 ≤ N) (hG : IsX1Gen N X jX tX)
    (τ : UpperHalfPlane) (P : Pol) (hP : algEval jX tX P ≠ 0) :
    ∀ᶠ z in 𝓝[≠] (τ : ℂ), ez N z (AfTateOr.toQ P) ≠ 0 := by
  have han := (diffOn_ez hN (AfTateOr.toQ P)).analyticOnNhd isOpen_Hs (τ : ℂ) τ.coe_im_pos
  rcases han.meromorphicAt.eventually_eq_zero_or_eventually_ne_zero with hz | hz
  · exact (hP ((polynomialGerm_eq_zero_iff hN hG τ P).mp (Germ.coe_eq.mpr hz))).elim
  · exact hz

local notation "A" => RingHom.range (algEval jX tX)

private def evalOnRange (hN : 2 ≤ N) (hG : IsX1Gen N X jX tX) (τ : UpperHalfPlane) :
    A →+* PuncturedGerm (τ : ℂ) :=
  (algEval jX tX).rangeRestrict.liftOfSurjective (algEval jX tX).rangeRestrict_surjective
    ⟨polynomialGerm N τ, fun P hp =>
      RingHom.mem_ker.mpr ((polynomialGerm_eq_zero_iff hN hG τ P).mpr
        (congrArg Subtype.val (RingHom.mem_ker.mp hp)))⟩

private theorem evalOnRange_apply (hN : 2 ≤ N) (hG : IsX1Gen N X jX tX)
    (τ : UpperHalfPlane) (P : Pol) :
    evalOnRange hN hG τ ((algEval jX tX).rangeRestrict P) = polynomialGerm N τ P :=
  RingHom.liftOfRightInverse_comp_apply _ _ _ _ P

private theorem evalOnRange_units (hN : 2 ≤ N) (hG : IsX1Gen N X jX tX) (τ : UpperHalfPlane)
    (a : nonZeroDivisors A) : IsUnit (evalOnRange hN hG τ a) := by
  obtain ⟨P, hP⟩ := (algEval jX tX).rangeRestrict_surjective a.val
  rw [← hP, evalOnRange_apply]
  apply isUnit_germ_of_eventually_ne_zero
  exact polynomial_eventually_ne_zero hN hG τ P
    (fun h => (mem_nonZeroDivisors_iff_ne_zero.mp a.property)
      (hP ▸ (Subtype.ext h : (algEval jX tX).rangeRestrict P = 0)))

private theorem fractionRing_of_generation (hG : IsX1Gen N X jX tX) :
    IsFractionRing A X.left.functionField := by
  let : FaithfulSMul A X.left.functionField :=
    (faithfulSMul_iff_algebraMap_injective _ _).mpr Subtype.val_injective
  apply IsFractionRing.of_field
  intro g
  obtain ⟨P, Q, -, h⟩ := exists_polynomial_fraction hG.1 g
  exact ⟨(algEval jX tX).rangeRestrict P, (algEval jX tX).rangeRestrict Q, h⟩

/-- Realize each rational function as its germ at the chosen parameter. -/
def fieldGerm (hN : 2 ≤ N) (hG : IsX1Gen N X jX tX) (τ : UpperHalfPlane) :
    X.left.functionField →+* PuncturedGerm (τ : ℂ) :=
  letI := fractionRing_of_generation hG
  IsLocalization.lift (evalOnRange_units hN hG τ)

theorem fieldGerm_fraction (hN : 2 ≤ N) (hG : IsX1Gen N X jX tX) (τ : UpperHalfPlane)
    (P Q : Pol) (hQ : algEval jX tX Q ≠ 0) :
    fieldGerm hN hG τ (algEval jX tX P / algEval jX tX Q) =
      ((fun z => ez N z (AfTateOr.toQ P) / ez N z (AfTateOr.toQ Q) : ℂ → ℂ) :
        PuncturedGerm (τ : ℂ)) := by
  let q : nonZeroDivisors A :=
    ⟨(algEval jX tX).rangeRestrict Q, mem_nonZeroDivisors_iff_ne_zero.mpr
      (fun he => hQ (congrArg Subtype.val he))⟩
  let := fractionRing_of_generation hG
  change IsLocalization.lift (evalOnRange_units hN hG τ)
    (algebraMap A X.left.functionField ((algEval jX tX).rangeRestrict P) /
      algebraMap A X.left.functionField q.val) = _
  rw [← IsFractionRing.mk'_eq_div, IsLocalization.lift_mk'_spec]
  change evalOnRange hN hG τ ((algEval jX tX).rangeRestrict P) =
    evalOnRange hN hG τ ((algEval jX tX).rangeRestrict Q) * _
  rw [evalOnRange_apply, evalOnRange_apply]
  apply Germ.coe_eq.mpr
  filter_upwards [polynomial_eventually_ne_zero hN hG τ Q hQ] with z hz
  exact (mul_div_cancel₀ _ hz).symm

theorem fieldGerm_meromorphic (hN : 2 ≤ N) (hG : IsX1Gen N X jX tX) (τ : UpperHalfPlane)
    (g : X.left.functionField) :
    ∃ f : ℂ → ℂ, (f : PuncturedGerm (τ : ℂ)) = fieldGerm hN hG τ g ∧
      MeromorphicAt f (τ : ℂ) := by
  obtain ⟨P, Q, hQ, rfl⟩ := exists_polynomial_fraction hG.1 g
  refine ⟨_, (fieldGerm_fraction hN hG τ P Q hQ).symm, ?_⟩
  exact ((diffOn_ez hN _).analyticOnNhd isOpen_Hs _ τ.coe_im_pos).meromorphicAt.div
    ((diffOn_ez hN _).analyticOnNhd isOpen_Hs _ τ.coe_im_pos).meromorphicAt

theorem hasValue_fraction_iff (hN : 2 ≤ N) (hG : IsX1Gen N X jX tX) (τ : UpperHalfPlane)
    (P Q : Pol) (hQ : AfTateOr.ev2 Q jX tX ≠ 0) (c : ℂ) :
    HasValue (fieldGerm hN hG τ (AfTateOr.ev2 P jX tX / AfTateOr.ev2 Q jX tX)) c ↔
      Tendsto (fun σ : UpperHalfPlane => evAn N (AfTateOr.toQ P) σ / evAn N (AfTateOr.toQ Q) σ)
        (𝓝[≠] τ) (𝓝 c) := by
  simp_rw [← algEval_apply] at hQ ⊢
  rw [fieldGerm_fraction hN hG τ P Q hQ, hasValue_coe, tendsto_quotient_iff]

end Model

