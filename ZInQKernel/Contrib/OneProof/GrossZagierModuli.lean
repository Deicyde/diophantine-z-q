import ZInQKernel.Contrib.OneProof.GrossZagierHeegner.Heegner
import ZInQKernel.Contrib.OneProof.GrossZagierHeegner.Cd

/-!
# gz-moduli: `GZHL3.GrossZagierFormulaCd` from the Gross–Zagier formula in its moduli form

Task gz-moduli (2026-11-16). Report: `docs/research/gz-moduli.md`; scratch and log: `scratch/gz-moduli/`.

`ZInQ.GZHL3.GrossZagierFormulaAt E` states the Gross–Zagier formula for the analytic Heegner point
`Σ_{Q ∈ S} weierPt E L (c φ_f(τ_Q))`. Gross and Zagier state it for the Heegner points of `X₀(N)`
(cyclic `N`-isogenies `E₁ → E₂` with `End E₁ = End E₂ = 𝒪_D`) mapped by a modular parametrization
`φ : X₀(N) → E` defined over `ℚ`. This file states that form (`GrossZagierModuliAt`) and proves
`GrossZagierFormulaAt E` from it, for every `E` (`grossZagierFormulaAt_of_moduli`), hence
`GrossZagierFormulaCd` from its `C_d` restriction (`grossZagierFormulaCd_of_moduli`).

The objects (§1).

* **`X₀(N)` over `ℚ` and `φ`.** `X₀(N)_ℚ` is not in Mathlib. A `ℚ`-morphism `φ : X₀(N) → E` is a point
  of `E(ℚ(X₀(N)))`, and `ℚ(X₀(N))` is the field of `Γ₀(N)`-modular functions with rational
  `q`-expansion at `∞` (the canonical model: Shimura 1971, Ch. 6; gz-heegner's `IsRatModFnMero`).
  So `φ = (X, Y)` with `X, Y ∈ ℚ(X₀(N))` satisfying the Weierstrass equation of `E`; `φ(∞) = O` and
  `φ` nonconstant say that `X` has a pole at `∞` (`IsModularParam`). The value of `φ` at a point is
  read off from the limits of `X` and `Y` (`modPt`), so junk values at poles play no role.
* **Heegner points.** `Y₀(N)(ℂ)` is the set of cyclic `N`-isogenies of complex elliptic curves up to
  isomorphism; in the lattice model (`E = ℂ/Λ`, `Hom(ℂ/Λ, ℂ/Λ') = {α : αΛ ⊆ Λ'}`) a point is a pair
  `Λ₁ ⊂ Λ₂` of lattices with `Λ₂/Λ₁` cyclic of order `N`, up to homothety. A Heegner point of
  discriminant `D` (Gross–Zagier Ch. II §1) has `End(Λ₁) = End(Λ₂) = 𝒪_D`; the ideal
  `𝔫 = (N, (−β + √D)/2)` with `𝒪_D/𝔫 ≅ ℤ/N` kills `Λ₂/Λ₁` (`IsHeegnerPair`). The point `τ ∈ ℍ` is
  `(⟨1, τ⟩, ⟨1/N, τ⟩)` (`pairOf`). `y_K = Σ φ(x)` over a complete set of representatives of the
  Heegner points with this `𝔫` (`IsHeegnerPointReps`).

The proof (§2–§4): the analytic parametrization `τ ↦ weierPt E L (c φ_f(τ))` is such a `φ`
(`isModularParam`, from gz-heegner's proofs that its coordinates lie in `ℚ(X₀(N))`) and `modPt` agrees
with it (`modPt_eq`); the lattice pairs of a complete set `S` of Heegner forms are a complete set of
Heegner points (`isHeegnerPointReps_of`: every Heegner pair is homothetic to `(⟨1, τ_Q⟩, ⟨1/N, τ_Q⟩)`
for a Heegner form `Q` of residue `β`, by an adapted basis and the action of `𝒪_D`).

No `sorry`, no `axiom`.
-/

noncomputable section

open UpperHalfPlane HeckeRing.GL2 WeierstrassCurve ZInQ.GZDecomp Filter Topology
open ZInQ.Contrib.TYZGenus.CM (HeegnerForm)
open scoped WeierstrassCurve.Affine MatrixGroups

namespace ZInQ.GZModuli

/-! ## §1. Objects and the leaf -/

/-- **The maximal order `𝒪_D = ℤ + ℤ·(D + √D)/2 ⊂ ℂ`** of `ℚ(√D)`, `D < 0` a fundamental discriminant
`≡ 1 (mod 4)`, with `√D = i√|D|`. -/
def cmOrder (D : ℤ) : Set ℂ :=
  {α | ∃ m n : ℤ, α = m + n * ((D + Complex.I * (Real.sqrt (-(D : ℝ)) : ℂ)) / 2)}

/-- **`End(ℂ/Λ) = {α ∈ ℂ : αΛ ⊆ Λ}`** (an endomorphism of `ℂ/Λ` lifts to `z ↦ αz`). -/
def latEnd (Λ : Submodule ℤ ℂ) : Set ℂ := {α | ∀ z ∈ Λ, α * z ∈ Λ}

/-- **`Λ ⊂ ℂ` is a lattice**: `Λ = ℤω₁ + ℤω₂` with `ω₂/ω₁ ∈ ℍ`. -/
def IsCLattice (Λ : Submodule ℤ ℂ) : Prop :=
  ∃ ω₁ ω₂ : ℂ, ω₁ ≠ 0 ∧ 0 < (ω₂ / ω₁).im ∧ Λ = Submodule.span ℤ {ω₁, ω₂}

/-- **A Heegner point of level `N`, discriminant `D` and residue `β`, in the lattice model**
(Gross–Zagier 1986, Ch. II §1; Gross 1984, §1; UNVERIFIED locators): the isogeny
`ℂ/Λ₁ → ℂ/Λ₂`, `z ↦ z`, of elliptic curves over `ℂ`, with
* kernel `Λ₂/Λ₁` cyclic of order `N` (generated by `v`, of order exactly `N`),
* `End(ℂ/Λ₁) = End(ℂ/Λ₂) = 𝒪_D`,
* the kernel killed by `𝔫 = (N, (−β + √D)/2)` (`β² ≡ D (mod 4N)`; `𝒪_D/𝔫 ≅ ℤ/N`), i.e. `𝔫` is the
  annihilator of the kernel: the Heegner point is `(𝒪_D, 𝔫, [Λ₁])` in Gross–Zagier's notation. -/
structure IsHeegnerPair (N : ℕ) (D β : ℤ) (Λ₁ Λ₂ : Submodule ℤ ℂ) : Prop where
  lattice : IsCLattice Λ₁
  cyclic : ∃ v : ℂ, Λ₂ = Λ₁ ⊔ Submodule.span ℤ {v} ∧ ∀ k : ℤ, (k : ℂ) * v ∈ Λ₁ ↔ (N : ℤ) ∣ k
  end₁ : latEnd Λ₁ = cmOrder D
  end₂ : latEnd Λ₂ = cmOrder D
  orient : ∀ z ∈ Λ₂, (-(β : ℂ) + Complex.I * (Real.sqrt (-(D : ℝ)) : ℂ)) / 2 * z ∈ Λ₁

/-- **Homothety of lattice pairs** `P' = μ P`, `μ ∈ ℂ^×`: isomorphism of the isogenies
`ℂ/Λ₁ → ℂ/Λ₂` (the points of `Y₀(N)(ℂ)` are the homothety classes). -/
def Homothetic (P P' : Submodule ℤ ℂ × Submodule ℤ ℂ) : Prop :=
  ∃ μ : ℂ, μ ≠ 0 ∧ P'.1 = P.1.map (LinearMap.mulLeft ℤ μ) ∧ P'.2 = P.2.map (LinearMap.mulLeft ℤ μ)

/-- **The point `τ ∈ ℍ` of `Y₀(N)` in the lattice model**: `ℂ/⟨1, τ⟩ → ℂ/⟨1/N, τ⟩`, i.e. the pair
`(ℂ/⟨1, τ⟩, ⟨1/N⟩)`. -/
def pairOf (N : ℕ) (τ : ℍ) : Submodule ℤ ℂ × Submodule ℤ ℂ :=
  (Submodule.span ℤ {1, (τ : ℂ)}, Submodule.span ℤ {1 / (N : ℂ), (τ : ℂ)})

/-- **`τ : R → ℍ` is a complete set of representatives of the Heegner points** of level `N`,
discriminant `D` and residue `β` (each `pairOf N (τ r)` is a Heegner point, no two are isomorphic,
and every Heegner point is isomorphic to one of them). -/
def IsHeegnerPointReps (N : ℕ) (D β : ℤ) {R : Type} (τ : R → ℍ) : Prop :=
  (∀ r, IsHeegnerPair N D β (pairOf N (τ r)).1 (pairOf N (τ r)).2) ∧
  (∀ r r', Homothetic (pairOf N (τ r)) (pairOf N (τ r')) → r = r') ∧
  ∀ Λ₁ Λ₂ : Submodule ℤ ℂ, IsHeegnerPair N D β Λ₁ Λ₂ → ∃ r, Homothetic (pairOf N (τ r)) (Λ₁, Λ₂)

open Classical in
/-- **The value `φ(τ) ∈ E(ℂ)` of `φ = (X, Y)`**: `(x₀, y₀)` if `X → x₀` and `Y → y₀` at `τ` (on a
punctured neighbourhood), and `O` otherwise (`X` has a pole at `τ`). Independent of the values of
`X`, `Y` at `τ` itself. -/
def modPt (E : WeierstrassCurve ℚ) (X Y : ℍ → ℂ) (τ : ℍ) : (E⁄ℂ).Point :=
  if h : ∃ p : ℂ × ℂ, (E⁄ℂ).Nonsingular p.1 p.2 ∧
      Tendsto (X ∘ ofComplex) (𝓝[≠] (τ : ℂ)) (𝓝 p.1) ∧
      Tendsto (Y ∘ ofComplex) (𝓝[≠] (τ : ℂ)) (𝓝 p.2)
  then .some _ _ h.choose_spec.1 else 0

/-- **`φ = (X, Y) : X₀(N) → E` is a nonconstant morphism defined over `ℚ` with `φ(∞) = O`**:
`X, Y ∈ ℚ(X₀(N))` (gz-heegner's `IsRatModFnMero`: `Γ₀(N)`-invariant, meromorphic on `ℍ` and at the
cusps, rational `q`-expansion at `∞`), `(X, Y)` satisfies the Weierstrass equation of `E` (wherever
both are regular), and `X` has a pole at the cusp `∞` (`x` has its only pole at `O`, so this says
`φ(∞) = O` and `φ` nonconstant). -/
structure IsModularParam (N : ℕ) (E : WeierstrassCurve ℚ) (X Y : ℍ → ℂ) : Prop where
  ratX : ZInQ.GZHeegner.IsRatModFnMero N X
  ratY : ZInQ.GZHeegner.IsRatModFnMero N Y
  eqn : ∀ τ : ℍ, ZInQ.GZHeegner.RegularAt X τ → ZInQ.GZHeegner.RegularAt Y τ →
    (E⁄ℂ).Equation (X τ) (Y τ)
  pole : Tendsto (fun τ : ℍ => ‖X τ‖) atImInfty atTop

/-- **The Gross–Zagier formula, moduli form (Gross–Zagier 1986, Thm I.6.3 and Ch. V Thm 2.1;
positive constant forgotten).** Let `E/ℚ` be an elliptic curve with the L-series of the newform `f`
of level `N` and trivial character, `φ = (X, Y) : X₀(N) → E` a nonconstant morphism over `ℚ` with
`φ(∞) = O` (`IsModularParam`), `D < −4` an odd fundamental discriminant with every `p ∣ N` split in
`K = ℚ(√D)`, `β² ≡ D (mod 4N)`, and `y ∈ E(K)` the Heegner point
`y_K = Σ_{x} φ(x)`, the sum over the Heegner points `x = (𝒪_K, 𝔫, [𝔞])`, `𝔫 = (N, (−β + √D)/2)`,
`[𝔞] ∈ Cl(K)` (`IsHeegnerPointReps`; for `σ ∈ Gal(H/K)` the points `x^σ` run over them, so this is
`Tr_{H/K} φ(x)`), `K` embedded in `ℂ` by `ι(√D) = i√|D|`. Let `F`, `G` be the entire continuations
of `L(f, s) = L(E, s)` and `L(f ⊗ χ_D, s)`, so that `F G = L(E/K, s)`. Then
`L'(E/K, 1) = κ · ĥ(y)` for some real `κ > 0`.

Source: B. Gross, D. Zagier, *Heegner points and derivatives of L-series*, Invent. Math. 84
(1986), 225–320: Thm I.6.3 (`L'(f, 1) = 8π²(f, f) ĥ(c_f)/(h u² √|D|)` for the `f`-isotypic part of
the Heegner divisor class `c = Σ_σ (x^σ − ∞)` in `J₀(N)(H) ⊗ ℂ`), and Ch. V Thm 2.1
(`L'(E/K, 1) = ‖ω‖² ĥ(y_K)/(c² u² √|D|)`, `φ^*ω = c · 2πi f(τ) dτ`) with its corollary that `y_K` has
infinite order iff `L'(E/K, 1) ≠ 0`; all locators and constants UNVERIFIED (no copy on this host).
Weaker than the print: the explicit positive constant is replaced by `∃ κ > 0` (this also absorbs
the normalization of Tau Ceti's `canonicalHeight` over `K` and `deg φ`); folded in:
`L(E/K, s) = L(f, s) L(f ⊗ χ_D, s)` (GZ Ch. I/IV, UNVERIFIED; textbook). -/
def GrossZagierModuliAt (E : WeierstrassCurve ℚ) : Prop :=
  ∀ (N : ℕ) [NeZero N] (f : Newform N 2), f.χ = 1 →
    (∀ n : ℕ, n ≠ 0 → coeff f n = (E.LFunction n : ℂ)) →
    ∀ X Y : ℍ → ℂ, IsModularParam N E X Y →
    ∀ D β : ℤ, IsOddImagFundDisc D → D < -4 → HeegnerHyp N D → (4 * N : ℤ) ∣ D - β ^ 2 →
    ∀ (R : Type) [Fintype R] (τ : R → ℍ), IsHeegnerPointReps N D β τ →
    ∀ (K : Type) [Field K] [NumberField K] [DecidableEq K], Module.finrank ℚ K = 2 →
    ∀ δ : K, δ ^ 2 = (D : K) →
    ∀ ι : K →ₐ[ℚ] ℂ, ι δ = Complex.I * (Real.sqrt (-(D : ℝ)) : ℂ) →
    ∀ y : (E⁄K).Point, Affine.Point.map ι y = ∑ r, modPt E X Y (τ r) →
    ∀ F G : ℂ → ℂ, IsEntireCont (coeff f) 2 F → IsEntireCont (twistCoeff f D) 2 G →
      ∃ κ : ℝ, 0 < κ ∧ deriv (fun s => F s * G s) 1 = κ * y.canonicalHeight

/-- `GrossZagierModuliAt` for every elliptic curve over `ℚ`. -/
def GrossZagierModuli : Prop :=
  ∀ (E : WeierstrassCurve ℚ) [E.IsElliptic], GrossZagierModuliAt E

/-- `GrossZagierModuliAt C_d`, `C_d : y² = x³ − d²x`, `d ≡ 5 (mod 8)` squarefree (the curves of the
route; implied by `GrossZagierModuli`: `grossZagierModuliCd_of`). -/
def GrossZagierModuliCd : Prop :=
  ∀ d : ℕ, d % 8 = 5 → Squarefree d → GrossZagierModuliAt (shortCurve (-(d : ℚ) ^ 2))

theorem grossZagierModuliCd_of (h : GrossZagierModuli) : GrossZagierModuliCd := fun d hd _ => by
  have := shortCurve_cd_isElliptic (d := d) (by omega)
  exact h _

/-! ## §2. Lattice algebra -/

open ZInQ.GZHeegner (sD sD_sq int_indep exists_coords mem_span_pair_of map_mulLeft_span_pair
  span_pair_eq gcd_eq_one_of_squarefree exists_bezout3)

theorem sD_def (D : ℤ) : Complex.I * (Real.sqrt (-(D : ℝ)) : ℂ) = sD D := rfl

theorem sD_im {D : ℤ} (hD : D < 0) : 0 < (sD D).im := by
  simpa [sD] using ZInQ.GZHL3.Reps.sqrt_pos_D hD

/-- `αu, αv ∈ M ⇒ α·⟨u, v⟩ ⊆ M`. -/
theorem mul_mem_of_gen {u v α : ℂ} {M : Submodule ℤ ℂ} (hu : α * u ∈ M) (hv : α * v ∈ M) :
    ∀ z ∈ Submodule.span ℤ {u, v}, α * z ∈ M := by
  intro z hz
  obtain ⟨a, b, rfl⟩ := Submodule.mem_span_pair.1 hz
  rw [mul_add, mul_smul_comm, mul_smul_comm]
  exact M.add_mem (M.smul_mem _ hu) (M.smul_mem _ hv)

theorem mem_map_mulLeft_iff {μ : ℂ} (hμ : μ ≠ 0) (Λ : Submodule ℤ ℂ) (w : ℂ) :
    w ∈ Λ.map (LinearMap.mulLeft ℤ μ) ↔ μ⁻¹ * w ∈ Λ := by
  constructor
  · rintro ⟨z, hz, rfl⟩
    simpa [inv_mul_cancel_left₀ hμ] using hz
  · intro h
    exact ⟨μ⁻¹ * w, h, by simp [mul_inv_cancel_left₀ hμ]⟩

/-- Relative endomorphism conditions are invariant under homothety. -/
theorem rel_map_iff {μ : ℂ} (hμ : μ ≠ 0) (a : ℂ) (Λ₁ Λ₂ : Submodule ℤ ℂ) :
    (∀ z ∈ Λ₂.map (LinearMap.mulLeft ℤ μ), a * z ∈ Λ₁.map (LinearMap.mulLeft ℤ μ)) ↔
      ∀ z ∈ Λ₂, a * z ∈ Λ₁ := by
  simp only [mem_map_mulLeft_iff hμ]
  constructor
  · intro h z hz
    have := h (μ * z) (by rwa [inv_mul_cancel_left₀ hμ])
    rwa [show μ⁻¹ * (a * (μ * z)) = a * z by field_simp] at this
  · intro h z hz
    have := h _ hz
    rwa [show a * (μ⁻¹ * z) = μ⁻¹ * (a * z) by ring] at this

theorem latEnd_map {μ : ℂ} (hμ : μ ≠ 0) (Λ : Submodule ℤ ℂ) :
    latEnd (Λ.map (LinearMap.mulLeft ℤ μ)) = latEnd Λ := by
  ext α; exact rel_map_iff hμ α Λ Λ

theorem map_mulLeft_map (M : Submodule ℤ ℂ) (j w : ℂ) :
    (M.map (LinearMap.mulLeft ℤ j)).map (LinearMap.mulLeft ℤ w) = M.map (LinearMap.mulLeft ℤ (w * j)) := by
  rw [← Submodule.map_comp]
  congr 1
  ext z; simp

/-- For a root `σ ∈ ℍ` of `a X² + b X + c` (`a > 0`, `b² − 4ac = D < 0`): `√D = 2aσ + b`. -/
theorem sD_eq_of_root {D a b c : ℤ} {σ : ℂ} (hσ : 0 < σ.im) (ha : 0 < a)
    (hroot : (a : ℂ) * σ ^ 2 + b * σ + c = 0) (hdisc : b ^ 2 - 4 * a * c = D) (hD : D < 0) :
    sD D = 2 * a * σ + b := by
  have h1 := sD_sq hD
  have hd : ((b : ℂ) ^ 2 - 4 * a * c = D) := by exact_mod_cast hdisc
  have h2 : (sD D - (2 * a * σ + b)) * (sD D + (2 * a * σ + b)) = 0 := by
    linear_combination h1 - hd - 4 * (a : ℂ) * hroot
  rcases mul_eq_zero.1 h2 with h | h
  · exact sub_eq_zero.1 h
  · exfalso
    have him := congrArg Complex.im h
    simp [Complex.mul_im, Complex.mul_re] at him
    have h3 := sD_im hD
    have ha' : (0 : ℝ) < a := by exact_mod_cast ha
    nlinarith

/-- **`End(⟨1, σ⟩) = 𝒪_D`** for a root `σ ∈ ℍ` of a form `[a, b, c]`, `a > 0`, of squarefree
discriminant `D < 0` (the form is then primitive). -/
theorem latEnd_span_root {D a b c : ℤ} {σ : ℂ} (hσ : 0 < σ.im) (ha : 0 < a)
    (hroot : (a : ℂ) * σ ^ 2 + b * σ + c = 0) (hdisc : b ^ 2 - 4 * a * c = D) (hsq : Squarefree D)
    (hD : D < 0) : latEnd (Submodule.span ℤ {1, σ}) = cmOrder D := by
  have hs := sD_eq_of_root hσ ha hroot hdisc hD
  obtain ⟨e, he⟩ : ∃ e : ℤ, b + D = 2 * e := by
    rcases Int.even_or_odd b with ⟨k, hk⟩ | ⟨k, hk⟩
    · exact ⟨k + 2 * k ^ 2 - 2 * a * c, by rw [← hdisc, hk]; ring⟩
    · exact ⟨2 * k ^ 2 + 3 * k + 1 - 2 * a * c, by rw [← hdisc, hk]; ring⟩
  have he' : (b : ℂ) + D = 2 * e := by exact_mod_cast he
  have hα : ((D : ℂ) + sD D) / 2 = e + a * σ := by
    rw [hs]; linear_combination he' / 2
  ext α
  simp only [latEnd, cmOrder, sD_def, Set.mem_ofPred_eq]
  constructor
  · intro h
    obtain ⟨x, y, hxy⟩ := exists_coords (h 1 (Submodule.subset_span (by simp)))
    obtain ⟨u, w, huw⟩ := exists_coords (h σ (Submodule.subset_span (by simp)))
    rw [mul_one] at hxy
    have e1 : ((-y * c - a * u : ℤ) : ℂ) + ((a * x - y * b - a * w : ℤ) : ℂ) * σ = 0 := by
      push_cast
      rw [hxy] at huw
      linear_combination (a : ℂ) * huw - (y : ℂ) * hroot
    obtain ⟨i1, i2⟩ := int_indep hσ e1
    obtain ⟨p, q, r, hpqr⟩ := exists_bezout3 (gcd_eq_one_of_squarefree hsq hdisc)
    have hy : y = a * (p * y + q * (x - w) - r * u) := by
      linear_combination (-y) * hpqr - q * i2 - r * i1
    refine ⟨x - (p * y + q * (x - w) - r * u) * e, p * y + q * (x - w) - r * u, ?_⟩
    rw [hα, hxy]
    have hy' : (y : ℂ) = a * ((p * y + q * (x - w) - r * u : ℤ) : ℂ) := by exact_mod_cast hy
    rw [hy']; push_cast; ring
  · rintro ⟨m, n, rfl⟩
    rw [hα]
    apply mul_mem_of_gen
    · exact mem_span_pair_of (m + n * e) (n * a) (by push_cast; ring)
    · exact mem_span_pair_of (-(n * c)) (m + n * e - n * b) (by
        push_cast; linear_combination (n : ℂ) * hroot)

/-! ### The lattice pair of a Heegner form is a Heegner point -/

open ZInQ.GZHL3 (HasResidue Gamma0Equiv IsHeegnerReps)

theorem tauH_coe {N : ℕ} {D : ℤ} (Q : HeegnerForm N D) : (Q.tauH : ℂ) = Q.tau := rfl

theorem tau_root {N : ℕ} {D : ℤ} (Q : HeegnerForm N D) :
    (Q.A : ℂ) * Q.tau ^ 2 + Q.B * Q.tau + Q.C = 0 :=
  ZInQ.GZHL3.Reps.cmPoint_root Q.A_pos Q.disc Q.D_neg

theorem tau_im {N : ℕ} {D : ℤ} (Q : HeegnerForm N D) : 0 < Q.tau.im := Q.tauH.im_pos

theorem natCast_ne_zero_of {N : ℕ} {D : ℤ} (Q : HeegnerForm N D) : (N : ℂ) ≠ 0 :=
  ZInQ.GZHeegner.N_ne_zero Q

/-- `⟨1/N, τ⟩ = ⟨1, τ⟩ + ℤ·(1/N)`, and `k/N ∈ ⟨1, τ⟩ ⇔ N ∣ k`. -/
theorem cyclic_pairOf {N : ℕ} (hN : (N : ℂ) ≠ 0) (τ : ℍ) :
    (pairOf N τ).2 = (pairOf N τ).1 ⊔ Submodule.span ℤ {1 / (N : ℂ)} ∧
      ∀ k : ℤ, (k : ℂ) * (1 / (N : ℂ)) ∈ (pairOf N τ).1 ↔ (N : ℤ) ∣ k := by
  refine ⟨le_antisymm ?_ ?_, fun k => ⟨fun h => ?_, fun h => ?_⟩⟩
  · rw [pairOf, Submodule.span_le]
    rintro _ (rfl | h)
    · exact Submodule.mem_sup_right (Submodule.subset_span rfl)
    · rw [Set.mem_singleton_iff] at h; subst h
      exact Submodule.mem_sup_left (Submodule.subset_span (by simp))
  · refine sup_le ?_ ?_
    · rw [pairOf, Submodule.span_le]
      rintro _ (rfl | h)
      · exact mem_span_pair_of N 0 (by push_cast; field_simp; ring)
      · rw [Set.mem_singleton_iff] at h; subst h
        exact mem_span_pair_of 0 1 (by ring)
    · rw [Submodule.span_le, Set.singleton_subset_iff]
      exact Submodule.subset_span (by simp)
  · obtain ⟨x, y, hxy⟩ := exists_coords h
    have e : (((N : ℤ) * x - k : ℤ) : ℂ) + (((N : ℤ) * y : ℤ) : ℂ) * (τ : ℂ) = 0 := by
      push_cast
      have := hxy; field_simp at this
      linear_combination (-1 : ℂ) * this
    obtain ⟨i1, -⟩ := int_indep τ.im_pos e
    exact ⟨x, by linarith⟩
  · obtain ⟨m, rfl⟩ := h
    exact mem_span_pair_of m 0 (by push_cast; field_simp; ring)

theorem latN_eq_map {N : ℕ} (hN : (N : ℂ) ≠ 0) (τ : ℂ) :
    Submodule.span ℤ {1 / (N : ℂ), τ} =
      (Submodule.span ℤ {1, (N : ℂ) * τ}).map (LinearMap.mulLeft ℤ (1 / (N : ℂ))) := by
  rw [map_mulLeft_span_pair]
  congr 2
  · ring
  · rw [Set.singleton_eq_singleton_iff]; field_simp

/-- **The lattice pair `(⟨1, τ_Q⟩, ⟨1/N, τ_Q⟩)` of a Heegner form of residue `β` is a Heegner
point.** -/
theorem isHeegnerPair_of_form {N : ℕ} {D β : ℤ} (hsq : Squarefree D) (Q : HeegnerForm N D)
    (hQ : HasResidue β Q) : IsHeegnerPair N D β (pairOf N Q.tauH).1 (pairOf N Q.tauH).2 := by
  have hN := natCast_ne_zero_of Q
  have hD := Q.D_neg
  have hs := sD_eq_of_root (tau_im Q) Q.A_pos (tau_root Q) Q.disc hD
  obtain ⟨A', hA'⟩ := Q.N_dvd
  obtain ⟨e, he⟩ := hQ
  have hA'c : (Q.A : ℂ) = N * A' := by exact_mod_cast hA'
  have hec : (Q.B : ℂ) - β = 2 * N * e := by exact_mod_cast he
  refine ⟨⟨1, Q.tau, one_ne_zero, by simpa using tau_im Q, rfl⟩,
    ⟨1 / (N : ℂ), cyclic_pairOf hN Q.tauH⟩, ?_, ?_, ?_⟩
  · exact latEnd_span_root (tau_im Q) Q.A_pos (tau_root Q) Q.disc hsq hD
  · show latEnd (Submodule.span ℤ {1 / (N : ℂ), Q.tau}) = cmOrder D
    rw [latN_eq_map hN, latEnd_map (one_div_ne_zero hN)]
    have hA'pos : 0 < A' := by
      have := Q.A_pos; rw [hA'] at this
      exact pos_of_mul_pos_right this (by exact_mod_cast (Nat.cast_nonneg N : (0 : ℤ) ≤ N))
    refine latEnd_span_root (a := A') (b := Q.B) (c := Q.C * N) ?_ hA'pos ?_ ?_ hsq hD
    · have : ((N : ℂ) * Q.tau).im = N * Q.tau.im := by simp
      rw [this]
      exact mul_pos (by
        have : (0 : ℝ) < N := by
          rcases Nat.eq_zero_or_pos N with h | h
          · exact absurd (by rw [h]; simp) hN
          · exact_mod_cast h
        exact this) (tau_im Q)
    · push_cast; linear_combination (N : ℂ) * tau_root Q - (N : ℂ) * Q.tau ^ 2 * hA'c
    · linear_combination Q.disc + 4 * Q.C * hA'
  · show ∀ z ∈ Submodule.span ℤ {1 / (N : ℂ), Q.tau},
      (-(β : ℂ) + Complex.I * (Real.sqrt (-(D : ℝ)) : ℂ)) / 2 * z ∈ Submodule.span ℤ {1, Q.tau}
    rw [sD_def, hs]
    apply mul_mem_of_gen
    · exact mem_span_pair_of e A' (by
        field_simp
        linear_combination hec + (2 * Q.tau) * hA'c)
    · exact mem_span_pair_of (-Q.C) (N * e - Q.B) (by
        push_cast
        linear_combination tau_root Q + Q.tau / 2 * hec)

/-! ### Every Heegner point is the lattice pair of a Heegner form of residue `β` -/

/-- From `gcd(a, b, N) = 1`: a coprime pair `(a', b') ≡ (a, b) (mod N)`. -/
theorem exists_coprime_lift {a b N : ℤ} (hN : N ≠ 0) (h : Int.gcd (Int.gcd a b) N = 1) :
    ∃ s t : ℤ, IsCoprime (a + N * s) (b + N * t) := by
  by_cases hb : b = 0
  · subst hb
    refine ⟨0, 1, ?_⟩
    simp only [mul_zero, add_zero, zero_add, mul_one]
    rw [Int.isCoprime_iff_gcd_eq_one]
    simpa [Int.gcd, Int.natAbs_abs] using h
  · classical
    set P : Finset ℕ := b.natAbs.primeFactors.filter (fun p : ℕ => ¬ (p : ℤ) ∣ a)
    set T : ℤ := ∏ p ∈ P, (p : ℤ)
    refine ⟨T, 0, ?_⟩
    rw [mul_zero, add_zero, Int.isCoprime_iff_gcd_eq_one]
    by_contra hg
    obtain ⟨p, hp, hpd⟩ := Nat.exists_prime_and_dvd hg
    have hpz : Prime (p : ℤ) := Nat.prime_iff_prime_int.mp hp
    have hpd' : (p : ℤ) ∣ ((Int.gcd (a + N * T) b : ℕ) : ℤ) := Int.natCast_dvd_natCast.mpr hpd
    have h1 : (p : ℤ) ∣ a + N * T := hpd'.trans (Int.gcd_dvd_left _ _)
    have h2 : (p : ℤ) ∣ b := hpd'.trans (Int.gcd_dvd_right _ _)
    have hpb : p ∈ b.natAbs.primeFactors :=
      Nat.mem_primeFactors.mpr ⟨hp, Int.natCast_dvd.mp h2, Int.natAbs_ne_zero.mpr hb⟩
    by_cases hpa : (p : ℤ) ∣ a
    · have hpN : ¬ (p : ℤ) ∣ N := by
        intro hpN
        have h3 : p ∣ Int.gcd (Int.gcd a b) N := by
          unfold Int.gcd
          refine Nat.dvd_gcd ?_ (Int.natCast_dvd.mp hpN)
          simpa using Nat.dvd_gcd (Int.natCast_dvd.mp hpa) (Int.natCast_dvd.mp h2)
        rw [h] at h3
        exact hp.ne_one (Nat.dvd_one.mp h3)
      have hpT : ¬ (p : ℤ) ∣ T := by
        intro hpT
        obtain ⟨q, hq, hpq⟩ := (Prime.dvd_finsetProd_iff hpz _).mp hpT
        rw [Finset.mem_filter] at hq
        have hqp : q.Prime := (Nat.mem_primeFactors.mp hq.1).1
        have : p = q := (Nat.prime_dvd_prime_iff_eq hp hqp).mp (Int.natCast_dvd_natCast.mp hpq)
        subst this
        exact hq.2 hpa
      have h4 : (p : ℤ) ∣ N * T := by
        have := dvd_sub h1 hpa
        simpa using this
      rcases hpz.dvd_or_dvd h4 with h5 | h5
      · exact hpN h5
      · exact hpT h5
    · have hpT : (p : ℤ) ∣ T := Finset.dvd_prod_of_mem _ (Finset.mem_filter.mpr ⟨hpb, hpa⟩)
      apply hpa
      have := dvd_sub h1 (dvd_mul_of_dvd_right hpT N)
      simpa using this

/-- **Adapted basis**: a pair `Λ₁ ⊂ Λ₂` with `Λ₁` a lattice and `Λ₂/Λ₁` cyclic of order `N` is
homothetic to `(⟨1, τ⟩, ⟨1/N, τ⟩)` for some `τ ∈ ℍ`. -/
theorem normalize_pair {N : ℕ} (hN0 : 0 < N) {Λ₁ Λ₂ : Submodule ℤ ℂ} (hL : IsCLattice Λ₁)
    (hc : ∃ v : ℂ, Λ₂ = Λ₁ ⊔ Submodule.span ℤ {v} ∧ ∀ k : ℤ, (k : ℂ) * v ∈ Λ₁ ↔ (N : ℤ) ∣ k) :
    ∃ τ : ℍ, Homothetic (pairOf N τ) (Λ₁, Λ₂) := by
  obtain ⟨ω₁, ω₂, hω₁, him, rfl⟩ := hL
  obtain ⟨v, rfl, hv⟩ := hc
  have hNc : (N : ℂ) ≠ 0 := by exact_mod_cast hN0.ne'
  have hNz : (N : ℤ) ≠ 0 := by exact_mod_cast hN0.ne'
  obtain ⟨a, b, hab⟩ := exists_coords ((hv N).2 dvd_rfl)
  have hg : Int.gcd (Int.gcd a b) N = 1 := by
    set g := Int.gcd (Int.gcd a b) N with hgdef
    obtain ⟨a₁, ha₁⟩ : (g : ℤ) ∣ a := (Int.gcd_dvd_left _ _).trans (Int.gcd_dvd_left _ _)
    obtain ⟨b₁, hb₁⟩ : (g : ℤ) ∣ b := (Int.gcd_dvd_left _ _).trans (Int.gcd_dvd_right _ _)
    obtain ⟨N₁, hN₁⟩ : (g : ℤ) ∣ N := Int.gcd_dvd_right _ _
    have hg0 : (g : ℂ) ≠ 0 := by
      intro h0
      have : (g : ℤ) = 0 := by exact_mod_cast h0
      rw [this, zero_mul] at hN₁; exact hNz hN₁
    have hmem : ((N₁ : ℤ) : ℂ) * v ∈ Submodule.span ℤ {ω₁, ω₂} := by
      refine mem_span_pair_of a₁ b₁ ?_
      have e1 : ((N : ℤ) : ℂ) = g * N₁ := by exact_mod_cast hN₁
      have e2 : (a : ℂ) = g * a₁ := by exact_mod_cast ha₁
      have e3 : (b : ℂ) = g * b₁ := by exact_mod_cast hb₁
      rw [e1, e2, e3] at hab
      apply mul_left_cancel₀ hg0
      linear_combination hab
    obtain ⟨k, hk⟩ := (hv N₁).1 hmem
    have h1 : (g : ℤ) * k = 1 := by
      have : (N : ℤ) * 1 = N * (g * k) := by rw [mul_one]; nth_rewrite 1 [hN₁, hk]; ring
      exact (mul_left_cancel₀ hNz this).symm
    have := Int.eq_one_of_mul_eq_one_right (by positivity) h1
    exact_mod_cast this
  obtain ⟨s, t, x, y, hxy⟩ : ∃ s t x y : ℤ, x * (a + N * s) + y * (b + N * t) = 1 := by
    obtain ⟨s, t, ⟨x, y, h⟩⟩ := exists_coprime_lift hNz hg
    exact ⟨s, t, x, y, h⟩
  set a' := a + N * s with ha'
  set b' := b + N * t with hb'
  let t₀ : ℍ := ⟨ω₂ / ω₁, him⟩
  let γ : SL(2, ℤ) := ⟨!![x, -y; b', a'], by simp [Matrix.det_fin_two]; linarith⟩
  have hden : (b' : ℂ) * (ω₂ / ω₁) + a' ≠ 0 := by
    intro h0
    have h1 : (b' : ℝ) * (ω₂ / ω₁).im = 0 := by
      have := congrArg Complex.im h0; simpa using this
    have hb0 : (b' : ℝ) = 0 := by
      rcases mul_eq_zero.1 h1 with h | h
      · exact h
      · linarith
    have hb0' : b' = 0 := by exact_mod_cast hb0
    have h2 : (b' : ℂ) * (ω₂ / ω₁) + a' = a' := by rw [hb0']; simp
    rw [h2] at h0
    have ha0 : a' = 0 := by exact_mod_cast h0
    rw [ha0, hb0'] at hxy; simp at hxy
  have hτ : ((γ • t₀ : ℍ) : ℂ) = (x * (ω₂ / ω₁) + (-y)) / (b' * (ω₂ / ω₁) + a') := by
    rw [UpperHalfPlane.coe_specialLinearGroup_apply]
    simp [γ, t₀]
  set τ : ℍ := γ • t₀
  set w : ℂ := a' * ω₁ + b' * ω₂ with hwdef
  have hw : w = ω₁ * (b' * (ω₂ / ω₁) + a') := by rw [hwdef]; field_simp; ring
  have hw0 : w ≠ 0 := by rw [hw]; exact mul_ne_zero hω₁ hden
  have hwτ : w * (τ : ℂ) = -y * ω₁ + x * ω₂ := by
    calc w * (τ : ℂ) = ω₁ * ((b' * (ω₂ / ω₁) + a') * ((x * (ω₂ / ω₁) + -y) / (b' * (ω₂ / ω₁) + a'))) := by
          rw [hτ, hw]; ring
      _ = ω₁ * (x * (ω₂ / ω₁) + -y) := by rw [← mul_div_assoc, mul_div_cancel_left₀ _ hden]
      _ = -y * ω₁ + x * ω₂ := by field_simp; ring
  have hxy' : (x : ℂ) * a' + y * b' = 1 := by exact_mod_cast hxy
  set u : ℂ := -y * ω₁ + x * ω₂ with hudef
  have hω₁' : ω₁ = x * w - b' * u := by rw [hwdef, hudef]; linear_combination (-ω₁) * hxy'
  have hω₂' : ω₂ = y * w + a' * u := by rw [hwdef, hudef]; linear_combination (-ω₂) * hxy'
  have hv' : v = w * (1 / N) - s * ω₁ - t * ω₂ := by
    have hab' : (N : ℂ) * v = a * ω₁ + b * ω₂ := by exact_mod_cast hab
    rw [hwdef, ha', hb']; push_cast; field_simp; linear_combination hab'
  refine ⟨τ, w, hw0, ?_, ?_⟩
  · show Submodule.span ℤ {ω₁, ω₂} =
      (Submodule.span ℤ {1, (τ : ℂ)}).map (LinearMap.mulLeft ℤ w)
    rw [map_mulLeft_span_pair, mul_one, hwτ]
    apply span_pair_eq
    · exact mem_span_pair_of x (-b') (by push_cast; linear_combination hω₁')
    · exact mem_span_pair_of y a' (by push_cast; linear_combination hω₂')
    · exact mem_span_pair_of a' b' (by linear_combination hwdef)
    · exact mem_span_pair_of (-y) x (by push_cast; linear_combination hudef)
  · show Submodule.span ℤ {ω₁, ω₂} ⊔ Submodule.span ℤ {v} =
      (Submodule.span ℤ {1 / (N : ℂ), (τ : ℂ)}).map (LinearMap.mulLeft ℤ w)
    rw [map_mulLeft_span_pair, hwτ]
    set wN : ℂ := w * (1 / (N : ℂ)) with hwN
    have hwN' : w = N * wN := by rw [hwN]; field_simp
    apply le_antisymm
    · refine sup_le ?_ ?_
      · rw [Submodule.span_le]
        rintro _ (rfl | h)
        · exact mem_span_pair_of (x * N) (-b') (by
            push_cast; linear_combination hω₁' + (x : ℂ) * hwN')
        · rw [Set.mem_singleton_iff] at h; subst h
          exact mem_span_pair_of (y * N) a' (by
            push_cast; linear_combination hω₂' + (y : ℂ) * hwN')
      · rw [Submodule.span_le, Set.singleton_subset_iff]
        exact mem_span_pair_of (1 - s * x * N - t * y * N) (s * b' - t * a') (by
          push_cast
          linear_combination hv' - (s : ℂ) * hω₁' - (t : ℂ) * hω₂' - ((s : ℂ) * x + t * y) * hwN')
    · rw [Submodule.span_le]
      rintro _ (rfl | h)
      · exact Submodule.mem_sup.mpr ⟨s * ω₁ + t * ω₂, mem_span_pair_of s t rfl, v,
          Submodule.subset_span rfl, by linear_combination hv'⟩
      · rw [Set.mem_singleton_iff] at h; subst h
        exact Submodule.mem_sup_left (mem_span_pair_of (-y) x (by
          push_cast; linear_combination hudef))

/-- **A normalized Heegner pair `(⟨1, τ⟩, ⟨1/N, τ⟩)` comes from a Heegner form of residue `β`**:
from `α₀ = (D + √D)/2 ∈ End⟨1, τ⟩` (`α₀ = m + nτ`, `α₀τ = p + qτ`), `τ` is a root of
`[n, 2m − D, −p]` of discriminant `D`; `α₀ ∈ End⟨1/N, τ⟩` gives `N ∣ n`, and
`(−β + √D)/2 · (1/N) ∈ ⟨1, τ⟩` gives `2m − D ≡ β (mod 2N)`. -/
theorem form_of_normalized {N : ℕ} (hN : (N : ℂ) ≠ 0) {D β : ℤ} (hD : D < 0) (hsq : Squarefree D)
    (τ : ℍ) (h1 : ((D : ℂ) + sD D) / 2 ∈ latEnd (pairOf N τ).1)
    (h2 : ((D : ℂ) + sD D) / 2 ∈ latEnd (pairOf N τ).2)
    (h3 : ∀ z ∈ (pairOf N τ).2, (-(β : ℂ) + sD D) / 2 * z ∈ (pairOf N τ).1) :
    ∃ Q : HeegnerForm N D, HasResidue β Q ∧ Q.tauH = τ := by
  have hs2 := sD_sq hD
  have hτ := τ.im_pos
  obtain ⟨m, n, hmn⟩ := exists_coords (h1 1 (Submodule.subset_span (by simp)))
  obtain ⟨p, q, hpq⟩ := exists_coords (h1 τ (Submodule.subset_span (by simp)))
  have hαim : 0 < (((D : ℂ) + sD D) / 2).im := by
    have := sD_im hD
    simp only [Complex.div_ofNat_im, Complex.add_im, Complex.intCast_im, zero_add]
    linarith
  have e : ((-D ^ 2 + D - 4 * n * p + 4 * q * m : ℤ) : ℂ) +
      ((4 * (D - m - q) : ℤ) : ℂ) * (((D : ℂ) + sD D) / 2) = 0 := by
    push_cast
    linear_combination (4 * (n : ℂ)) * hpq + (4 * (((D : ℂ) + sD D) / 2) - 4 * q) * hmn - hs2
  obtain ⟨i1, i2⟩ := int_indep hαim e
  -- `n > 0`
  have hnpos : 0 < n := by
    have him := congrArg Complex.im hmn
    simp only [mul_one, Complex.add_im, Complex.intCast_im, Complex.mul_im, Complex.intCast_re,
      zero_mul, zero_add] at him
    have h0 : (0 : ℝ) < (n : ℝ) * (τ : ℂ).im := by
      rw [him, add_zero] at hαim
      exact hαim
    by_contra hn
    push Not at hn
    have : (n : ℝ) * (τ : ℂ).im ≤ 0 :=
      mul_nonpos_of_nonpos_of_nonneg (by exact_mod_cast hn) (le_of_lt hτ)
    linarith
  -- `N ∣ n`
  obtain ⟨x, y, hxy⟩ := exists_coords (h2 (1 / (N : ℂ)) (Submodule.subset_span (by simp)))
  have hxy' : ((D : ℂ) + sD D) / 2 = x + N * y * τ := by
    have h := congrArg (fun z => (N : ℂ) * z) hxy
    simp only [mul_add] at h
    have e1 : (N : ℂ) * (((D : ℂ) + sD D) / 2 * (1 / N)) = ((D : ℂ) + sD D) / 2 := by field_simp
    have e2 : (N : ℂ) * (x * (1 / N)) = x := by field_simp
    rw [e1, e2] at h
    linear_combination h
  have e2 : ((m - x : ℤ) : ℂ) + ((n - N * y : ℤ) : ℂ) * (τ : ℂ) = 0 := by
    push_cast; linear_combination hxy' - hmn
  obtain ⟨-, i4⟩ := int_indep hτ e2
  -- the residue
  obtain ⟨x', y', hxy2⟩ := exists_coords (h3 (1 / (N : ℂ)) (Submodule.subset_span (by simp)))
  have hxy2' : (-(β : ℂ) + sD D) / 2 = N * x' + N * y' * τ := by
    have h := congrArg (fun z => (N : ℂ) * z) hxy2
    simp only [mul_add, mul_one] at h
    have e1 : (N : ℂ) * ((-(β : ℂ) + sD D) / 2 * (1 / N)) = (-(β : ℂ) + sD D) / 2 := by field_simp
    rw [e1] at h
    linear_combination h
  have e3 : ((2 * m - D - β - 2 * N * x' : ℤ) : ℂ) + ((2 * n - 2 * N * y' : ℤ) : ℂ) * (τ : ℂ) = 0 := by
    push_cast; linear_combination 2 * hxy2' - 2 * hmn
  obtain ⟨i5, -⟩ := int_indep hτ e3
  have hdisc : (2 * m - D) ^ 2 - 4 * n * (-p) = D := by linear_combination (-1 : ℤ) * i1 - m * i2
  refine ⟨⟨n, 2 * m - D, -p, hnpos, ⟨y, by linarith⟩, hdisc, hD,
    gcd_eq_one_of_squarefree hsq hdisc⟩, ⟨x', by simp only; linarith⟩, ?_⟩
  apply UpperHalfPlane.ext
  show ZInQ.Contrib.TYZGenus.CM.cmPoint n (2 * m - D) D = (τ : ℂ)
  rw [ZInQ.Contrib.TYZGenus.CM.cmPoint, sD_def, div_eq_iff (by
    have : (n : ℂ) ≠ 0 := by exact_mod_cast hnpos.ne'
    exact mul_ne_zero two_ne_zero this)]
  push_cast
  linear_combination 2 * hmn

/-- **Completeness**: every Heegner point is homothetic to the lattice pair of a form in `S`. -/
theorem exists_rep {N : ℕ} [NeZero N] {D β : ℤ} (hD : IsOddImagFundDisc D)
    {S : Finset (HeegnerForm N D)} (hS : IsHeegnerReps N D β S) {Λ₁ Λ₂ : Submodule ℤ ℂ}
    (h : IsHeegnerPair N D β Λ₁ Λ₂) : ∃ Q : S, Homothetic (pairOf N Q.1.tauH) (Λ₁, Λ₂) := by
  have hN0 : 0 < N := Nat.pos_of_ne_zero (NeZero.ne N)
  have hNc : (N : ℂ) ≠ 0 := by exact_mod_cast hN0.ne'
  obtain ⟨τ, μ, hμ, e1, e2⟩ := normalize_pair hN0 h.lattice h.cyclic
  simp only at e1 e2
  have hα : ((D : ℂ) + sD D) / 2 ∈ cmOrder D := ⟨0, 1, by simp [sD_def]⟩
  have h1 : ((D : ℂ) + sD D) / 2 ∈ latEnd (pairOf N τ).1 := by
    rw [← latEnd_map hμ, ← e1, h.end₁]; exact hα
  have h2 : ((D : ℂ) + sD D) / 2 ∈ latEnd (pairOf N τ).2 := by
    rw [← latEnd_map hμ, ← e2, h.end₂]; exact hα
  have h3 : ∀ z ∈ (pairOf N τ).2, (-(β : ℂ) + sD D) / 2 * z ∈ (pairOf N τ).1 := by
    rw [← rel_map_iff hμ, ← e1, ← e2]
    simpa only [sD_def] using h.orient
  obtain ⟨Q₀, hres, hQτ⟩ := form_of_normalized hNc hD.1 hD.2.2 τ h1 h2 h3
  subst hQτ
  obtain ⟨Q', ⟨hQ'S, hequiv⟩, -⟩ := hS.2 Q₀ hres
  obtain ⟨j, hj, hp1, hp2⟩ := ZInQ.GZHeegner.pairHom_of_equiv hequiv
  refine ⟨⟨Q', hQ'S⟩, μ * j, mul_ne_zero hμ hj, ?_, ?_⟩
  · show Λ₁ = Q'.lat.map (LinearMap.mulLeft ℤ (μ * j))
    rw [e1, ← map_mulLeft_map, ← hp1]; rfl
  · show Λ₂ = Q'.latN.map (LinearMap.mulLeft ℤ (μ * j))
    rw [e2, ← map_mulLeft_map, ← hp2]; rfl

/-- **The lattice pairs of a complete set of Heegner forms of residue `β` are a complete set of
Heegner points of residue `β`.** -/
theorem isHeegnerPointReps_of {N : ℕ} [NeZero N] {D β : ℤ} (hD : IsOddImagFundDisc D)
    {S : Finset (HeegnerForm N D)} (hS : IsHeegnerReps N D β S) :
    IsHeegnerPointReps N D β (fun Q : S => Q.1.tauH) := by
  refine ⟨fun Q => isHeegnerPair_of_form hD.2.2 Q.1 (hS.1 Q.1 Q.2), fun Q Q' h => ?_,
    fun Λ₁ Λ₂ h => exists_rep hD hS h⟩
  obtain ⟨μ, -, h1, h2⟩ := h
  have hpair : ZInQ.GZHeegner.PairHom Q'.1 Q.1 μ := ⟨h1, h2⟩
  have heq := ZInQ.GZHeegner.equiv_of_pairHom hpair
  obtain ⟨R, -, huniq⟩ := hS.2 Q'.1 (hS.1 Q'.1 Q'.2)
  have a := huniq Q'.1 ⟨Q'.2, ZInQ.GZHL3.Reps.equiv_refl _⟩
  have b := huniq Q.1 ⟨Q.2, heq⟩
  exact Subtype.ext (b.trans a.symm)

/-! ## §3. The analytic parametrization is a modular parametrization over `ℚ` -/

open ZInQ.GZHeegner (ParamSetting zPar xPar yPar gPar qC zF yF)

section Analytic

variable {E : WeierstrassCurve ℚ} [E.IsElliptic] {N : ℕ} [NeZero N] {f : Newform N 2}
  {L : PeriodPair} {c : ℚ}

theorem zPar_eq_zF (τ : ℍ) : zPar f c τ = zF f c (qC τ) := by
  rw [zPar, ZInQ.GZHeegner.eichler_eq,
    ZInQ.GZHeegner.eSum_eq_mul_vFun f _ (ZInQ.GZHeegner.norm_qC_lt_one τ.im_pos)]
  simp only [zF]; ring

theorem norm_qC (τ : ℍ) : ‖qC τ‖ = Real.exp (-(2 * Real.pi * τ.im)) := by
  rw [qC, Complex.norm_exp]
  congr 1
  simp [Complex.mul_re, Complex.mul_im]

/-- `c φ_f` is not locally constant: near every `τ` there are points `z ≠ τ` with `c φ_f(z) ∉ L`
(identity theorem on `ℍ`, and `c φ_f(τ') ∉ L` for `Im τ'` large). -/
theorem frequently_zPar_notMem (hs : ParamSetting E f L c) (τ : ℍ) :
    ∃ᶠ z in 𝓝[≠] (τ : ℂ), zPar f c (ofComplex z) ∉ L.lattice := by
  have hc : (c : ℂ) ≠ 0 := by exact_mod_cast hs.2.2.2.1
  set g : ℂ → ℂ := zPar f c ∘ ofComplex with hgdef
  have hg : AnalyticAt ℂ g τ := ZInQ.GZHeegner.analyticAt_zPar f c τ
  by_contra hcon
  rw [Filter.not_frequently] at hcon
  simp only [not_not] at hcon
  rcases hg.eventually_eq_or_eventually_ne (analyticAt_const (v := g τ)) with hA | hB
  · have hU : AnalyticOnNhd ℂ g {z : ℂ | 0 < z.im} := fun z hz =>
      ZInQ.GZHeegner.analyticAt_zPar f c ⟨z, hz⟩
    have heq := hU.eqOn_of_preconnected_of_eventuallyEq analyticOnNhd_const
      (convex_halfSpace_im_gt 0).isPreconnected τ.im_pos hA
    have hmem : g τ ∈ L.lattice := by
      obtain ⟨z, hz1, hz2⟩ := ((hA.filter_mono nhdsWithin_le_nhds).and hcon).exists
      rw [← hz1]; exact hz2
    obtain ⟨ε, hε, -, hgood⟩ := ZInQ.GZHeegner.exists_good_ball f L hc
    obtain ⟨τ', hτ'⟩ := ZInQ.GZHeegner.exists_qC_norm (r := min (ε / 2) (1 / 2))
      (by positivity) (lt_of_le_of_lt (min_le_right _ _) (by norm_num))
    have hq0 : qC τ' ≠ 0 := Complex.exp_ne_zero _
    have hlt : ‖qC τ'‖ < ε := by
      rw [hτ']; exact lt_of_le_of_lt (min_le_left _ _) (by linarith)
    apply (hgood _ hlt).2 hq0
    rw [← zPar_eq_zF, ← ZInQ.GZHeegner.zPar_ofComplex f c τ']
    have h1 : g τ' = g τ := heq τ'.im_pos
    show g τ' ∈ L.lattice
    rw [h1]; exact hmem
  · have hcont : ∀ᶠ z in 𝓝 (τ : ℂ), g z ∈ ((L.lattice : Set ℂ) \ {g τ})ᶜ :=
      hg.continuousAt.preimage_mem_nhds (L.compl_lattice_sdiff_singleton_mem_nhds (g τ))
    obtain ⟨z, hz1, hz2, hz3⟩ := ((hcont.filter_mono nhdsWithin_le_nhds).and (hB.and hcon)).exists
    exact hz1 ⟨hz3, by simpa using hz2⟩

/-- **At a pole (`c φ_f(τ) ∈ L`), `x∘φ` has no finite limit.** (`1/(x∘φ − t)` is regular at `τ` with
value `0`.) -/
theorem not_tendsto_xPar (hs : ParamSetting E f L c) (τ : ℍ) (hz : zPar f c τ ∈ L.lattice)
    (x₀ : ℂ) : ¬ Tendsto (xPar E L f c ∘ ofComplex) (𝓝[≠] (τ : ℂ)) (𝓝 x₀) := by
  intro hx
  obtain ⟨t, ht⟩ : ∃ t : ℚ, x₀ ≠ t := by
    by_cases h : x₀ = ((0 : ℚ) : ℂ)
    · exact ⟨1, by rw [h]; norm_num⟩
    · exact ⟨0, h⟩
  have hreg := (ZInQ.GZHeegner.paramRegular E N f L c hs).2.2 t τ (Or.inl hz)
  have hg0 : (gPar E L f c t ∘ ofComplex) (τ : ℂ) = 0 := by
    simp [Function.comp, UpperHalfPlane.ofComplex_apply, gPar, hz]
  have hlim0 : Tendsto (gPar E L f c t ∘ ofComplex) (𝓝[≠] (τ : ℂ)) (𝓝 0) := by
    rw [← hg0]; exact hreg.continuousAt.tendsto.mono_left nhdsWithin_le_nhds
  set F := 𝓝[≠] (τ : ℂ) ⊓ 𝓟 {z | zPar f c (ofComplex z) ∉ L.lattice} with hF
  haveI : F.NeBot := Filter.frequently_iff_neBot.mp (frequently_zPar_notMem hs τ)
  have hlim1 : Tendsto (gPar E L f c t ∘ ofComplex) F (𝓝 (x₀ - t)⁻¹) := by
    have h1 : Tendsto (fun z => (xPar E L f c (ofComplex z) - t)⁻¹) F (𝓝 (x₀ - t)⁻¹) :=
      ((hx.mono_left inf_le_left).sub_const _).inv₀ (sub_ne_zero.2 ht)
    refine h1.congr' ?_
    filter_upwards [mem_inf_of_right (mem_principal_self _)] with z hz'
    have hz'' : zPar f c (ofComplex z) ∉ L.lattice := hz'
    simp [Function.comp, gPar, hz'']
  exact inv_ne_zero (sub_ne_zero.2 ht) (tendsto_nhds_unique hlim1 (hlim0.mono_left inf_le_left))

/-- **`modPt` of the analytic parametrization is `weierPt E L (c φ_f(τ))`.** -/
theorem modPt_eq (hs : ParamSetting E f L c) (τ : ℍ) :
    modPt E (xPar E L f c) (yPar E L f c) τ = ZInQ.GZHL3.weierPt E L (zPar f c τ) := by
  have hL := hs.2.2.1
  unfold modPt
  by_cases hz : zPar f c τ ∈ L.lattice
  · rw [dif_neg, ZInQ.GZHeegner.weierPt_eq_zero E L hz]
    rintro ⟨p, -, hx, -⟩
    exact not_tendsto_xPar hs τ hz p.1 hx
  · obtain ⟨hrx, hry⟩ := (ZInQ.GZHeegner.paramRegular E N f L c hs).2.1 τ hz
    have hx : Tendsto (xPar E L f c ∘ ofComplex) (𝓝[≠] (τ : ℂ)) (𝓝 (xPar E L f c τ)) := by
      have := hrx.continuousAt.tendsto.mono_left (nhdsWithin_le_nhds (s := {(τ : ℂ)}ᶜ))
      simpa [Function.comp, UpperHalfPlane.ofComplex_apply] using this
    have hy : Tendsto (yPar E L f c ∘ ofComplex) (𝓝[≠] (τ : ℂ)) (𝓝 (yPar E L f c τ)) := by
      have := hry.continuousAt.tendsto.mono_left (nhdsWithin_le_nhds (s := {(τ : ℂ)}ᶜ))
      simpa [Function.comp, UpperHalfPlane.ofComplex_apply] using this
    have hns := ZInQ.GZHL3.weierPt_some E hL hz
    have h : ∃ p : ℂ × ℂ, (E⁄ℂ).Nonsingular p.1 p.2 ∧
        Tendsto (xPar E L f c ∘ ofComplex) (𝓝[≠] (τ : ℂ)) (𝓝 p.1) ∧
        Tendsto (yPar E L f c ∘ ofComplex) (𝓝[≠] (τ : ℂ)) (𝓝 p.2) :=
      ⟨(xPar E L f c τ, yPar E L f c τ), hns, hx, hy⟩
    rw [dif_pos h, ZInQ.GZHeegner.weierPt_eq_some E hL hz]
    have h1 := tendsto_nhds_unique h.choose_spec.2.1 hx
    have h2 := tendsto_nhds_unique h.choose_spec.2.2 hy
    simp only [Affine.Point.some.injEq]
    exact ⟨h1, h2⟩

/-- **`x∘φ` has a pole at `∞`**: `q² x(φ) = Ŷ(q)` with `Ŷ(0) = c⁻² ≠ 0` (gz-heegner). -/
theorem tendsto_norm_xPar (hs : ParamSetting E f L c) :
    Tendsto (fun τ : ℍ => ‖xPar E L f c τ‖) atImInfty atTop := by
  have hc : (c : ℂ) ≠ 0 := by exact_mod_cast hs.2.2.2.1
  set b : ℂ := (E⁄ℂ).b₂ / 12 with hb
  set Y := yF f L c b with hYdef
  have hY : AnalyticAt ℂ Y 0 := ZInQ.GZHeegner.analyticAt_yF f L hc b
  have hY0 : Y 0 = ((c : ℂ) ^ 2)⁻¹ := ZInQ.GZHeegner.yF_zero f L _ _
  obtain ⟨ε, hε, -, hgood⟩ := ZInQ.GZHeegner.exists_good_ball f L hc
  have hx : ∀ τ : ℍ, ‖qC τ‖ < ε → qC τ ^ 2 * xPar E L f c τ = Y (qC τ) := by
    intro τ hτ
    have hq0 : qC τ ≠ 0 := Complex.exp_ne_zero _
    rw [xPar, zPar_eq_zF, hYdef, ZInQ.GZHeegner.yF_eq f L hc _ (hgood _ hτ).1 hq0]
  have hnq : Tendsto (fun τ : ℍ => ‖qC τ‖) atImInfty (𝓝 0) := by
    simp_rw [norm_qC]
    refine Real.tendsto_exp_atBot.comp (tendsto_neg_atTop_atBot.comp ?_)
    exact (tendsto_comap (f := UpperHalfPlane.im)).const_mul_atTop (by positivity)
  have hq : Tendsto (fun τ : ℍ => qC τ) atImInfty (𝓝 0) := tendsto_zero_iff_norm_tendsto_zero.2 hnq
  set K : ℝ := ‖Y 0‖ with hK
  have hK0 : 0 < K := by rw [hK, hY0]; exact norm_pos_iff.2 (inv_ne_zero (pow_ne_zero 2 hc))
  have hYlim : Tendsto (fun τ : ℍ => ‖Y (qC τ)‖) atImInfty (𝓝 K) :=
    (continuous_norm.tendsto _).comp (hY.continuousAt.tendsto.comp hq)
  have hev1 : ∀ᶠ τ : ℍ in atImInfty, ‖qC τ‖ < ε := hnq.eventually (gt_mem_nhds hε)
  have hev2 : ∀ᶠ τ : ℍ in atImInfty, K / 2 < ‖Y (qC τ)‖ := hYlim.eventually (lt_mem_nhds (by linarith))
  have hq2 : Tendsto (fun τ : ℍ => ‖qC τ‖ ^ 2) atImInfty (𝓝[>] 0) := by
    refine tendsto_nhdsWithin_iff.2 ⟨by simpa using hnq.pow 2, Filter.Eventually.of_forall fun τ => ?_⟩
    have : qC τ ≠ 0 := Complex.exp_ne_zero _
    exact pow_pos (norm_pos_iff.2 this) 2
  have hinv : Tendsto (fun τ : ℍ => K / 2 * (‖qC τ‖ ^ 2)⁻¹) atImInfty atTop :=
    (tendsto_inv_nhdsGT_zero.comp hq2).const_mul_atTop (by linarith)
  refine tendsto_atTop_mono' _ ?_ hinv
  filter_upwards [hev1, hev2] with τ h1 h2
  have hpos : 0 < ‖qC τ‖ ^ 2 := pow_pos (norm_pos_iff.2 (Complex.exp_ne_zero _)) 2
  have e : ‖Y (qC τ)‖ = ‖qC τ‖ ^ 2 * ‖xPar E L f c τ‖ := by
    rw [← hx τ h1, norm_mul, norm_pow]
  rw [← div_eq_mul_inv, div_le_iff₀ hpos]
  nlinarith

/-- **The analytic parametrization `τ ↦ weierPt E L (c φ_f(τ))` is a modular parametrization over
`ℚ`**: its coordinates lie in `ℚ(X₀(N))` (gz-heegner's `isRatModFnMero_coords`), satisfy the
Weierstrass equation, and `x∘φ` has a pole at `∞`. -/
theorem isModularParam_of (hs : ParamSetting E f L c) :
    IsModularParam N E (xPar E L f c) (yPar E L f c) := by
  obtain ⟨mx, my, -⟩ := ZInQ.GZHeegner.isRatModFnMero_coords ZInQ.GZHeegner.paramRegular
    ZInQ.GZHeegner.paramCuspGrowth ZInQ.GZHeegner.paramQExpansion E f L c hs
  refine ⟨mx, my, fun τ hx _ => ?_, tendsto_norm_xPar hs⟩
  by_cases hz : zPar f c τ ∈ L.lattice
  · exact (not_tendsto_xPar hs τ hz _
      (hx.continuousAt.tendsto.mono_left nhdsWithin_le_nhds)).elim
  · exact (ZInQ.GZHL3.weierPt_some E hs.2.2.1 hz).1

end Analytic

/-! ## §4. `GrossZagierFormulaAt` from the moduli form -/

/-- **`GZHL3.GrossZagierFormulaAt E` from `GrossZagierModuliAt E`**, for every elliptic `E/ℚ`. -/
theorem grossZagierFormulaAt_of_moduli (E : WeierstrassCurve ℚ) [E.IsElliptic]
    (h : GrossZagierModuliAt E) : ZInQ.GZHL3.GrossZagierFormulaAt E := by
  intro N _ f hχ hcoeff D β hD hD4 hH hβ S hS L c hL hc hP K _ _ _ hK δ hδ ι hι y hy F G hF hG
  have hs : ParamSetting E f L c := ⟨hχ, hcoeff, hL, hc, hP⟩
  refine h N f hχ hcoeff _ _ (isModularParam_of hs) D β hD hD4 hH hβ S (fun Q => Q.1.tauH)
    (isHeegnerPointReps_of hD hS) K hK δ hδ ι hι y ?_ F G hF hG
  rw [hy, ZInQ.GZHL3.heegnerC, ← Finset.sum_coe_sort S]
  exact Finset.sum_congr rfl fun Q _ => (modPt_eq hs Q.1.tauH).symm

/-- **`GZHL3.GrossZagierFormula` from `GrossZagierModuli`.** -/
theorem grossZagierFormula_of_moduli (h : GrossZagierModuli) : ZInQ.GZHL3.GrossZagierFormula :=
  fun E _ => grossZagierFormulaAt_of_moduli E (h E)

/-- **`GZHL3.GrossZagierFormulaCd` from `GrossZagierModuliCd`** (the discharge of the
`C_d` Gross–Zagier leaf by its moduli form). -/
theorem grossZagierFormulaCd_of_moduli (h : GrossZagierModuliCd) :
    ZInQ.GZHL3.GrossZagierFormulaCd := fun d hd hsq => by
  have := shortCurve_cd_isElliptic (d := d) (by omega)
  exact grossZagierFormulaAt_of_moduli _ (h d hd hsq)

/-- **`hL3` (all `E`) with `GrossZagierFormula` replaced by its moduli form**: gz-heegner's
`grossZagierHeegner_of_printed` with `GrossZagierModuli` in place of `GZHL3.GrossZagierFormula`
(so that `#discharges` records the replacement against the current `frozenTarget`). -/
theorem grossZagierHeegner_of_moduli (hU : ZInQ.GZHL3.WeierstrassUniformization)
    (hSW : ZInQ.GZHL3.StrongWeilCurve) (hI : ZInQ.GZHL3.IsogenyLattice)
    (hGZM : GrossZagierModuli) (hGC : ZInQ.GZHL3.GrossConjugation)
    (hCM : T5Glue.ShimuraMainCM) (hX : ZInQ.GZHeegner.X0ModuliGaloisMero) :
    ZInQ.GZDecomp.GrossZagierHeegner :=
  ZInQ.GZHeegner.grossZagierHeegner_of_printed hU hSW hI (grossZagierFormula_of_moduli hGZM) hGC hCM hX

end ZInQ.GZModuli
