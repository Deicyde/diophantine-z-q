-- Adapted from Tau Ceti (https://github.com/TauCetiProject/TauCeti, commit 5a01f5fe3621, module
-- TauCeti.NumberTheory.ModularForms.Newforms.NumberField, theorem
-- `TauCeti.numberField_CoefficientField`), Apache-2.0. Modified by the Z-in-Q project (task
-- coeff-field-tc, 2026-11-17): the newform statement is generalised to every normalised full
-- eigenform and to the field generated by all Fourier coefficients (index `0` included), and the
-- result is applied to the kernel's `DSCoeffExt.EigenformCoeffFieldFinite`.
import ZInQKernel.Contrib.OneProof.DSCoeffExt
import ZInQKernel.Contrib.TauCeti.NumberTheory.ModularForms.Newforms.NumberField
import ZInQKernel.Contrib.TauCeti.NumberTheory.ModularForms.Newforms.Eigenform
import ZInQKernel.Contrib.TauCeti.NumberTheory.MulChar.Basic
import ZInQKernel.Contrib.TauCeti.RingTheory.RootsOfUnity.Basic

/-!
# `K_f` is a number field: a proof of `DSCoeffExt.EigenformCoeffFieldFinite`

Task coeff-field-tc (2026-11-17). The leaf `DSCoeffExt.EigenformCoeffFieldFinite` says that for a
normalized eigenform `f ∈ S_k(N, χ)` (Diamond–Shurman Def. 5.8.1), `k ≥ 2`, the field
`K_f = ℚ(a_n(f) : n)` is finite over `ℚ`. It is proved here outright, with no new hypothesis.

The integral input is Tau Ceti's finiteness over `ℤ` of the algebra generated by the prime-index
Hecke operators on `S_k(Γ₁(N))` in weight at least two (`TauCeti.heckeTCuspPrimeAlgebra_finite`,
from modular symbols and the injective period map), vendored with its closure for this task (see
`ThirdParty/TauCeti/NOTICE`). The argument is the one of Tau Ceti's
`TauCeti.numberField_CoefficientField`, which uses only the eigenform underlying a newform:

* the eigenvalue homomorphism `f.eigenvalueHom h₁` sends a finite `ℤ`-generating set `s` of the
  prime-index Hecke algebra to algebraic integers, and the nebentypus takes finitely many unit
  values, which are roots of unity; the field `K = ℚ(S)` they generate is finite over `ℚ`;
* `K` contains every prime coefficient `a_p` (the eigenvalue of `T_p`, the primes dividing the level
  included) and every scalar `χ(p) p^{k−1}` of the Hecke recurrence (`χ(p) = 0` for `p ∣ N`), so by
  `Eigenform.qExpansion_coeff_mem_of_forall_prime` it contains every coefficient `a_n`, `n = 0`
  included.

The kernel's `IsNormalizedEigenformDS f χ` provides the Tau Ceti eigenform `F` with
`F.toCuspForm = f` and `a₁(f) = 1`, and the kernel's `coeffField f` is the field generated by all
coefficients of `f`.
-/

noncomputable section

open UpperHalfPlane CongruenceSubgroup HeckeRing.GL2

namespace EigenformCoeffFieldFiniteProof

variable {N : ℕ} [NeZero N] {k : ℤ}

/-- **The field generated by all Fourier coefficients of a normalised full eigenform of weight at
least two is finite-dimensional over `ℚ`.** -/
theorem finiteDimensional_adjoin_qExpansion_coeff
    (f : Eigenform N k) (h₁ : (qExpansion 1 f.toCuspForm).coeff 1 = 1) (hk : 2 ≤ k) :
    FiniteDimensional ℚ
      (IntermediateField.adjoin ℚ
        (Set.range fun n : ℕ => (qExpansion 1 f.toCuspForm).coeff n)) := by
  have := TauCeti.heckeTCuspPrimeAlgebra_finite N k hk
  obtain ⟨s, hs⟩ := Module.Finite.fg_top (R := ℤ) (M := TauCeti.heckeTCuspPrimeAlgebra N k)
  let S : Set ℂ := f.eigenvalueHom h₁ '' s ∪
    Set.range fun u : (ZMod N)ˣ ↦ (f.χ u : ℂ)
  have : Finite S := ((s.finite_toSet.image _).union (Set.finite_range _)).to_subtype
  have hS : ∀ x ∈ S, IsIntegral ℚ x := by
    rintro x (⟨T, -, rfl⟩ | ⟨u, rfl⟩)
    · exact (f.isIntegral_eigenvalueHom h₁ hk T).tower_top
    · exact (f.χ.isIntegral_coe_apply u).tower_top
  -- Every eigenvalue on the prime-index Hecke algebra lies in `ℚ(S)`.
  have hT : ∀ T ∈ Submodule.span ℤ (s : Set (TauCeti.heckeTCuspPrimeAlgebra N k)),
      f.eigenvalueHom h₁ T ∈ IntermediateField.adjoin ℚ S := by
    intro T hT
    induction hT using Submodule.span_induction with
    | mem T hT => exact IntermediateField.subset_adjoin ℚ S (Or.inl ⟨T, hT, rfl⟩)
    | zero => rw [map_zero]; exact zero_mem _
    | add T T' _ _ hT hT' => rw [map_add]; exact add_mem hT hT'
    | smul n T _ hT => rw [map_zsmul]; exact zsmul_mem hT n
  -- The prime coefficients: `a_p` is the eigenvalue of `T_p`.
  have ha : ∀ p : ℕ, p.Prime →
      (qExpansion 1 f.toCuspForm).coeff p ∈ IntermediateField.adjoin ℚ S := by
    intro p hp
    rw [← f.eigenvalueHom_heckeTCuspNat h₁ hp]
    exact hT _ (hs ▸ Submodule.mem_top)
  -- The scalars `χ(p) p^{k−1}` of the Hecke recurrence (`χ(p) = 0` when `p ∣ N`).
  have hχ : ∀ p : ℕ, p.Prime →
      (MulChar.ofUnitHom f.χ : DirichletCharacter ℂ N) p * (p : ℂ) ^ (k - 1) ∈
        IntermediateField.adjoin ℚ S := by
    intro p _
    refine mul_mem ?_ ?_
    · exact MulChar.apply_mem_of_forall_unit _ (IntermediateField.adjoin ℚ S)
        (fun u ↦ by
          rw [MulChar.ofUnitHom_coe]
          exact IntermediateField.subset_adjoin ℚ S (Or.inr ⟨u, rfl⟩)) _
    · obtain ⟨m, hm⟩ : ∃ m : ℕ, k - 1 = m := ⟨(k - 1).toNat, by omega⟩
      rw [hm, zpow_natCast]
      exact pow_mem (natCast_mem _ p) m
  -- Every coefficient, `n = 0` included, lies in `ℚ(S)`.
  have hle : IntermediateField.adjoin ℚ
        (Set.range fun n : ℕ => (qExpansion 1 f.toCuspForm).coeff n) ≤
      IntermediateField.adjoin ℚ S := by
    rw [IntermediateField.adjoin_le_iff]
    rintro _ ⟨n, rfl⟩
    exact f.qExpansion_coeff_mem_of_forall_prime h₁ (IntermediateField.adjoin ℚ S) ha hχ n
  have := IntermediateField.finiteDimensional_adjoin hS
  exact FiniteDimensional.of_injective (IntermediateField.inclusion hle).toLinearMap
    (IntermediateField.inclusion_injective hle)

end EigenformCoeffFieldFiniteProof

/-- **`K_f` is a number field** for every normalized eigenform `f ∈ S_k(N, χ)`, `k ≥ 2`: the
open hypothesis `DSCoeffExt.EigenformCoeffFieldFinite`, proved. -/
theorem eigenformCoeffFieldFinite_proof : DSCoeffExt.EigenformCoeffFieldFinite := by
  intro N _ k χ f hk hf
  obtain ⟨F, rfl, -, h₁⟩ := hf
  exact EigenformCoeffFieldFiniteProof.finiteDimensional_adjoin_qExpansion_coeff F h₁ hk

end
