import ZInQKernel.Contrib.CloudR2Poincare.L4.DimensionFiniteType
import ZInQKernel.Contrib.TauCeti.AlgebraicGeometry.Morphisms.Smooth.GeometricallyIntegral

/-! # The abelian subvariety generated by a family of images -/

noncomputable section

namespace ShimuraSteps.Quotient

open CategoryTheory AlgebraicGeometry Limits MonoidalCategory CartesianMonoidalCategory MonObj
open PkgI3 PkgI3.AbVar TopologicalSpace Order
open scoped CategoryTheory.MonObj

local notation "OverQ" => Over (Spec (CommRingCat.of ℚ))

/-- A morphism from a reduced scheme with range in a closed subscheme
factors through that closed subscheme. -/
theorem factors_of_range_subset {X Y G : OverQ}
    (a : X ⟶ Y) (j : G ⟶ Y) [IsReduced X.left] [IsClosedImmersion j.left]
    (h : Set.range a.left ⊆ Set.range j.left) : ∃ w : X ⟶ G, w ≫ j = a := by
  have hclosure : Closeds.closure (a.left '' (⊤ : Closeds X.left)) ≤ j.left.ker.support := by
    rw [Closeds.closure_le]
    simpa only [Closeds.coe_top, Set.image_univ, Scheme.Hom.support_ker,
      j.left.isClosedEmbedding.isClosed_range.closure_eq] using h
  have ha : a.left.ker =
      Scheme.IdealSheafData.vanishingIdeal (Closeds.closure (a.left '' (⊤ : Closeds X.left))) := by
    rw [← Scheme.IdealSheafData.map_vanishingIdeal, Scheme.IdealSheafData.vanishingIdeal_top,
      Scheme.nilradical_eq_bot, Scheme.IdealSheafData.map_bot]
  have hj : j.left.ker ≤ a.left.ker := by
    rw [ha]
    exact Scheme.IdealSheafData.le_support_iff_le_vanishingIdeal.mp hclosure
  let w := IsClosedImmersion.lift j.left a.left hj
  have hw : w ≫ j.left = a.left := IsClosedImmersion.lift_fac _ _ _
  refine ⟨Over.homMk w ?_, Over.OverMorphism.ext hw⟩
  rw [← Over.w j, ← Category.assoc, hw, Over.w a]

private def product (A B : AbVar ℚ) : AbVar ℚ where
  X := A.X ⊗ B.X
  proper := by
    change IsProper (pullback.fst A.X.hom B.X.hom ≫ A.X.hom)
    infer_instance
  smooth := by
    change Smooth (pullback.fst A.X.hom B.X.hom ≫ A.X.hom)
    infer_instance
  geomInt := by
    change GeometricallyIntegral (pullback.fst A.X.hom B.X.hom ≫ A.X.hom)
    have : Smooth (pullback.fst A.X.hom B.X.hom ≫ A.X.hom) := inferInstance
    have : GeometricallyConnected (pullback.fst A.X.hom B.X.hom ≫ A.X.hom) :=
      GeometricallyConnected.comp _ _
    exact TauCeti.AlgebraicGeometry.Smooth.geometricallyIntegral _

/-- Factorization implies containment of scheme point ranges. -/
theorem range_le_of_factor {X Y G : OverQ} {a : X ⟶ Y} {j : G ⟶ Y}
    {w : X ⟶ G} (hw : w ≫ j = a) : Set.range a.left ⊆ Set.range j.left := by
  rintro _ ⟨x, rfl⟩
  exact ⟨w.left x, congrArg (fun f : X ⟶ Y => f.left x) hw⟩

/-- Precomposing with a surjection preserves the range on scheme points. -/
theorem range_eq_of_surj_factor {X Y G : OverQ} {a : X ⟶ Y} {j : G ⟶ Y}
    {w : X ⟶ G} (hw : w ≫ j = a) (hs : Surjective w.left) :
    Set.range a.left = Set.range j.left := by
  refine (range_le_of_factor hw).antisymm ?_
  rintro _ ⟨x, rfl⟩
  obtain ⟨y, rfl⟩ := hs.surj x
  exact ⟨y, (congrArg (fun f : X ⟶ Y => f.left y) hw).symm⟩

variable {J : AbVar ℚ}

private def imageClosed {C : AbVar ℚ} (i : AbVar.Hom C J) (hi : IsClosedImmersion i.hom.left) :
    IrreducibleCloseds J.X.left := by
  have : IsIntegral C.X.left := GeometricallyIntegral.isIntegral_of_subsingleton C.X.hom
  refine ⟨Set.range i.hom.left, ?_, i.hom.left.isClosedEmbedding.isClosed_range⟩
  simpa only [Set.image_univ] using
    (IrreducibleSpace.isIrreducible_univ C.X.left).image i.hom.left i.hom.left.continuous.continuousOn

private def Admissible (I : Set (AbVar.End J)) (Z : IrreducibleCloseds J.X.left) : Prop :=
  ∃ (C : AbVar ℚ) (i : AbVar.Hom C J) (hi : IsClosedImmersion i.hom.left),
    Z = imageClosed i hi ∧
    ∀ (G : OverQ) [GrpObj G] (j : G ⟶ J.X) [IsMonHom j],
      IsClosedImmersion j.left →
      (∀ t ∈ I, Set.range t.hom.left ⊆ Set.range j.left) →
      Set.range i.hom.left ⊆ Set.range j.left

/-- Any family of endomorphisms of an abelian variety over `ℚ` has a genuine
scheme-theoretic image sum that is an abelian subvariety. -/
theorem imageSum_exists (I : Set (AbVar.End J)) :
    ∃ (C : AbVar ℚ) (i : AbVar.Hom C J), IsImageSum I i := by
  classical
  let fact := AVGlue.imageFactorization_of_cartier
    ZInQ.Contrib.OneProof.CartierSmooth.cartierSmooth_proof
  let S := {Z : IrreducibleCloseds J.X.left // Admissible I Z}
  have hS : Nonempty S := by
    obtain ⟨C, p, i, hp, hi, hpi⟩ := fact ℚ J J (0 : AbVar.End J)
    refine ⟨⟨imageClosed i hi, C, i, hi, rfl, ?_⟩⟩
    intro G _ j _ _ _
    rw [← range_eq_of_surj_factor hpi.symm hp]
    exact range_le_of_factor (w := (1 : J.X ⟶ G)) (MonObj.one_comp j)
  have : CompactSpace J.X.left := QuasiCompact.compactSpace_of_compactSpace J.X.hom
  have hfin := ZInQ.Contrib.CloudR2Poincare.L4.scheme_dimension_ne_top J.X.hom
  have hle : krullDim S ≤ topologicalKrullDim J.X.left :=
    krullDim_le_of_strictMono Subtype.val (Subtype.strictMono_coe _)
  have : FiniteDimensionalOrder S :=
    finiteDimensionalOrder_iff_krullDim_ne_bot_and_top.mpr
      ⟨krullDim_ne_bot_iff.mpr hS, fun h => hfin (top_unique (h ▸ hle))⟩
  let l := LTSeries.longestOf S
  have hmax (Z : S) : ¬ l.last < Z := by
    intro h
    have hh := LTSeries.longestOf_is_longest (l.snoc Z h)
    change (l.snoc Z h).length ≤ l.length at hh
    rw [RelSeries.snoc_length] at hh
    omega
  obtain ⟨C, i, hi, hZi, hC⟩ := l.last.property
  have : IsIntegral C.X.left := GeometricallyIntegral.isIntegral_of_subsingleton C.X.hom
  have : IsIntegral J.X.left := GeometricallyIntegral.isIntegral_of_subsingleton J.X.hom
  refine ⟨C, i, hi, ?_, ?_⟩
  · intro t ht
    let a₀ : C.X ⊗ J.X ⟶ J.X := fst C.X J.X ≫ i.hom * snd C.X J.X ≫ t.hom
    have ha₀ : IsMonHom a₀ := by
      change IsMonHom (lift (fst C.X J.X ≫ i.hom) (snd C.X J.X ≫ t.hom) ≫ μ[J.X])
      infer_instance
    let a : AbVar.Hom (product C J) J := @Hom.mk' ℚ _ (product C J) J a₀ ha₀
    obtain ⟨D, p, j, hp, hj, haj⟩ := fact ℚ (product C J) J a
    have hrange := range_eq_of_surj_factor haj.symm hp
    have hia : Set.range i.hom.left ⊆ Set.range a.hom.left := by
      apply range_le_of_factor (w := lift (𝟙 C.X) (1 : C.X ⟶ J.X))
      change lift (𝟙 C.X) (1 : C.X ⟶ J.X) ≫
        (fst C.X J.X ≫ i.hom * snd C.X J.X ≫ t.hom) = i.hom
      rw [MonObj.comp_mul, ← Category.assoc, lift_fst, Category.id_comp,
        ← Category.assoc, lift_snd, MonObj.one_comp, _root_.mul_one]
    have hta : Set.range t.hom.left ⊆ Set.range a.hom.left := by
      apply range_le_of_factor (w := lift (1 : J.X ⟶ C.X) (𝟙 J.X))
      change lift (1 : J.X ⟶ C.X) (𝟙 J.X) ≫
        (fst C.X J.X ≫ i.hom * snd C.X J.X ≫ t.hom) = t.hom
      rw [MonObj.comp_mul, ← Category.assoc, lift_fst, MonObj.one_comp,
        ← Category.assoc, lift_snd, Category.id_comp, _root_.one_mul]
    let Z : S := ⟨imageClosed j hj, D, j, hj, rfl, by
      intro G _ g _ hclosed hg
      have : IsClosedImmersion g.left := hclosed
      obtain ⟨u, hu⟩ := factors_of_range_subset i.hom g (hC G g hclosed hg)
      obtain ⟨v, hv⟩ := factors_of_range_subset t.hom g (hg t ht)
      rw [← hrange]
      apply range_le_of_factor (w := fst C.X J.X ≫ u * snd C.X J.X ≫ v)
      change (fst C.X J.X ≫ u * snd C.X J.X ≫ v) ≫ g =
        fst C.X J.X ≫ i.hom * snd C.X J.X ≫ t.hom
      rw [MonObj.mul_comp, Category.assoc, Category.assoc, hu, hv]⟩
    have hle' : l.last ≤ Z := by
      change l.last.val ≤ imageClosed j hj
      rw [hZi]
      change Set.range i.hom.left ⊆ Set.range j.hom.left
      exact hrange ▸ hia
    have hZ : l.last = Z := (eq_or_lt_of_le hle').resolve_right (hmax Z)
    have hsets := congrArg (fun W : S => (W.val : Set J.X.left)) hZ
    change (l.last.val : Set J.X.left) = Set.range j.hom.left at hsets
    rw [hZi] at hsets
    have he : Set.range a.hom.left = Set.range i.hom.left := hrange.trans hsets.symm
    exact factors_of_range_subset t.hom i.hom (he ▸ hta)
  · intro G _ j _ hj hjt
    have : IsClosedImmersion j.left := hj
    exact factors_of_range_subset i.hom j (hC G j hj fun t ht => by
      obtain ⟨u, hu⟩ := hjt t ht
      exact range_le_of_factor hu)

/-- The general quotient existence theorem would supply the geometric quotient
for the printed family, with both of the printed geometric clauses. -/
theorem exists_printQuotient_of_abVarQuotientBySubvarietyExists
    (h : AbVarQuotientBySubvarietyExists) {N : ℕ} (ξ : ℕ → AbVar.End J) (f : PkgI4.CF N 2) :
    ∃ (C : AbVar ℚ) (i : AbVar.Hom C J) (Q : AbVar ℚ) (q : AbVar.Hom J Q),
      IsImageSum (Sat (annihilator (printRing ξ f))) i ∧ IsAbVarQuotient i q ∧
      PrintQuotient ξ f q ∧ R16Thm1.KerConnected q := by
  obtain ⟨C, i, hi⟩ := imageSum_exists (Sat (annihilator (printRing ξ f)))
  obtain ⟨Q, q, hq⟩ := h J C i hi.closed
  refine ⟨C, i, Q, q, hi, hq, ?_, ?_⟩
  · refine (printQuotient_iff_iso q hi hq).mpr ⟨Hom.mk' (𝟙 Q.X), ?_, by simp⟩
    change IsIso (𝟙 Q.X)
    infer_instance
  · exact kerConnected_of_schemeKernelConnected (schemeKernelConnected_of_isAbVarQuotient hq)

end ShimuraSteps.Quotient
