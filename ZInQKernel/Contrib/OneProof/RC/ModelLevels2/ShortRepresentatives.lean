import ZInQKernel.Contrib.OneProof.RC.ModelLevels.GeneratorOrbits
import ZInQKernel.Contrib.OneProof.RC.ModelLevels.ShortIsomorphisms

/-! # Short representatives of cyclic pairs -/

namespace WeierstrassCurve.ModelLevels

open WeierstrassCurve.Affine

/-- Over a field in which two and three are invertible, every pair class
has a short representative whose cyclic subgroup is generated by a point
of exact order. This is the surjectivity step in the coarse point reading
and applies over the algebraic closure of the detector residue field. -/
theorem pairClasses_has_short_generator {k : Type*} [Field k] [DecidableEq k]
    (h₂ : (2 : k) ≠ 0) (h₃ : (3 : k) ≠ 0) {N : ℕ} (z : PairClasses k N) :
    ∃ B : EnhancedCurve k N, B.equation.IsShortNF ∧
      (∃ P : Generators B.equation.toAffine.Point N, subgroupOfGenerator P = B.subgroup) ∧
      Quot.mk _ B = z := by
  let : Invertible (2 : k) := invertibleOfNonzero h₂
  let : Invertible (3 : k) := invertibleOfNonzero h₃
  induction z using Quot.inductionOn with
  | _ A =>
    let : A.equation.IsElliptic := A.elliptic
    let v := A.equation.toShortNF
    let e := (Point.addEquivVariableChange A.equation v).symm
    let B : EnhancedCurve k N :=
      ⟨v • A.equation, inferInstance, cyclicSubgroupsEquiv e N A.subgroup⟩
    refine ⟨B, A.equation.toShortNF_spec, subgroupOfGenerator_surjective B.subgroup, ?_⟩
    exact (Quot.sound ⟨v, rfl, rfl⟩).symm

#print axioms pairClasses_has_short_generator

end WeierstrassCurve.ModelLevels
