import ZInQKernel.Contrib.OneProof.RC.ModelLevels.Reduction
import Mathlib.Data.ZMod.Basic

/-! # Unit orbits of generators in a geometric point group -/

namespace WeierstrassCurve.ModelLevels

variable {G : Type*} [AddCommGroup G] {N : ℕ}

/-- The elements of exact additive order `N`. -/
def Generators (G : Type*) [AddCommGroup G] (N : ℕ) :=
  {P : G // addOrderOf P = N}

private theorem zmultiples_nsmul_eq_iff {P : G} (hP : addOrderOf P = N) (a : ℕ) :
    AddSubgroup.zmultiples (a • P) = AddSubgroup.zmultiples P ↔ Nat.Coprime a N := by
  simpa [hP, Nat.coprime_iff_gcd_eq_one, Int.gcd] using
    AddSubgroup.zmultiples_eq_zmultiples_iff' P (a : ℤ) 1

private theorem nsmul_val_natCast [NeZero N] {P : G} (hP : addOrderOf P = N) (a : ℕ) :
    (a : ZMod N).val • P = a • P := by
  rw [ZMod.val_natCast, ← hP, mod_addOrderOf_nsmul]

/-- On the geometric point group the units modulo `N` act on the elements
of exact order `N` by sending `P` to its scalar multiple. -/
instance generatorAction [NeZero N] : MulAction (ZMod N)ˣ (Generators G N) where
  smul a P := ⟨(a : ZMod N).val • P.1, by
    have h := (zmultiples_nsmul_eq_iff P.2 _).mpr (ZMod.val_coe_unit_coprime a)
    simpa [P.2] using congrArg (fun C : AddSubgroup G => Nat.card C) h⟩
  one_smul P := by
    apply Subtype.ext
    change (1 : ZMod N).val • P.1 = P.1
    rw [← Nat.cast_one, nsmul_val_natCast P.2, one_nsmul]
  mul_smul a b P := by
    apply Subtype.ext
    change (↑(a * b) : ZMod N).val • P.1 = (a : ZMod N).val • ((b : ZMod N).val • P.1)
    have h : (↑(a * b) : ZMod N) =
        ((a : ZMod N).val * (b : ZMod N).val : ℕ) := by
      simp [Nat.cast_mul]
    rw [h, nsmul_val_natCast P.2, mul_nsmul']

/-- The action on geometric generators is given by the natural-number
representative of the unit. -/
theorem generatorAction_apply [NeZero N] (a : (ZMod N)ˣ) (P : Generators G N) :
    (a • P).1 = (a : ZMod N).val • P.1 :=
  rfl

/-- Two exact-order points are in the same unit orbit precisely when they
generate the same cyclic subgroup. -/
theorem generatorOrbit_iff [NeZero N] (P Q : Generators G N) :
    (∃ a : (ZMod N)ˣ, a • P = Q) ↔
      AddSubgroup.zmultiples P.1 = AddSubgroup.zmultiples Q.1 := by
  constructor
  · rintro ⟨a, rfl⟩
    rw [generatorAction_apply]
    exact ((zmultiples_nsmul_eq_iff P.2 _).mpr (ZMod.val_coe_unit_coprime a)).symm
  · intro h
    have hQ : Q.1 ∈ AddSubgroup.zmultiples P.1 := h.symm ▸ AddSubgroup.mem_zmultiples Q.1
    obtain ⟨a, ha⟩ := AddSubgroup.mem_zmultiples_iff.mp hQ
    let m := (a : ZMod N).val
    have hm : m • P.1 = Q.1 := by
      rw [← ha, ← natCast_zsmul, show (m : ℤ) = a % N from ZMod.val_intCast a]
      simpa only [P.2] using mod_addOrderOf_zsmul P.1 a
    have hcop : m.Coprime N := (zmultiples_nsmul_eq_iff P.2 _).mp (by rw [hm, h])
    refine ⟨ZMod.unitOfCoprime m hcop, Subtype.ext ?_⟩
    rw [generatorAction_apply, ZMod.coe_unitOfCoprime, ZMod.val_natCast,
      Nat.mod_eq_of_lt (ZMod.val_lt (a : ZMod N)), hm]

/-- The subgroup generated by an element of exact order has that order. -/
def subgroupOfGenerator (P : Generators G N) : CyclicSubgroups G N :=
  ⟨AddSubgroup.zmultiples P.1, inferInstance, by simp [P.2]⟩

/-- Each cyclic subgroup of the prescribed order has a generator of that
order. Together with `generatorOrbit_iff` this computes the unit orbits. -/
theorem subgroupOfGenerator_surjective :
    Function.Surjective (subgroupOfGenerator (G := G) (N := N)) := by
  intro C
  obtain ⟨P, hP⟩ := isAddCyclic_iff_exists_zmultiples_eq_top.mp C.2.1
  have h : AddSubgroup.zmultiples (P : G) = C.1 := by
    change AddSubgroup.zmultiples (C.1.subtype P) = C.1
    rw [← AddMonoidHom.map_zmultiples C.1.subtype P, hP]
    ext x
    constructor
    · rintro ⟨y, _, rfl⟩
      exact y.2
    · intro hx
      exact ⟨⟨x, hx⟩, trivial, rfl⟩
  have ho : addOrderOf (P : G) = N := by
    rw [← Nat.card_zmultiples, h]
    exact C.2.2
  exact ⟨⟨P, ho⟩, Subtype.ext h⟩

#print axioms zmultiples_nsmul_eq_iff
#print axioms nsmul_val_natCast
#print axioms generatorAction
#print axioms generatorAction_apply
#print axioms generatorOrbit_iff
#print axioms subgroupOfGenerator_surjective

end WeierstrassCurve.ModelLevels
