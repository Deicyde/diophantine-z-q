import ZInQKernel.Contrib.OneProof.RC.ModelGeneric4.PairClass
import ZInQKernel.Contrib.OneProof.RC.ModelGeneric4.AnalyticClasses
import ZInQKernel.Contrib.OneProof.RC.ModelGeneric2.OpenFibre
import ZInQKernel.Contrib.OneProof.RC.ModelLevels.GenericComparison

/-! # Every complex point of the finite chart is an analytic point (item 2)

Every cyclic order-N subgroup of `ℂ/(ℤτ₀ + ℤ)` is generated by the image of `(cτ₀ + d)/N` for the
bottom row `(c, d)` of some `γ ∈ SL₂(ℤ)` (a coprime lift of a primitive residue pair), and the
homothety by `cτ₀ + d` identifies that pair with `analyticCyclicPair (γτ₀)`. With j-surjectivity
every complex cyclic pair class is analytic; item 1 and injectivity of the pinned reading then show
that every complex point of the pinned rational open is the inverse evaluation at a parameter. -/

namespace WeierstrassCurve.ModelLevels.ModelGeneric4

open AlgebraicGeometry CategoryTheory ModelGeneric ModelGeneric2 UpperHalfPlane
open WeierstrassCurve.Affine
open ZInQ.Manuscript.RC

set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 1000000
set_option synthInstance.maxHeartbeats 400000

/-- Every complex point of the pinned rational quotient is the inverse evaluation at a parameter. -/
theorem exists_rationalPointAtParameter_eq {N : ℕ} [NeZero N] (h₂ : 2 ≤ N)
    (y : Y0RationalAlgebra h₂ →ₐ[ℚ] ℂ) :
    ∃ τ : ℍ, ModelGeneric3.rationalPointAtParameter h₂ τ = y := by
  obtain ⟨τ, hτ⟩ := exists_analyticCyclicPair_eq h₂ (rationalPoints h₂ y)
  exact ⟨τ, (rationalPoints h₂).injective ((rationalPoints_rationalPointAtParameter h₂ τ).trans hτ)⟩

/-- **Item 2: surjectivity.** Every complex point of the fixed finite chart, as a scheme over the
rationals, is the analytic point of some parameter. -/
theorem exists_complexPoint_eq {N : ℕ} [NeZero N] (h₂ : 2 ≤ N)
    (x : RationalCurveComplexPoints (branchFiniteOverQ N)) :
    ∃ τ : ℍ, x.left ≫ (X0Model3.finiteChart N).ι = X0Model.complexPoint N τ := by
  let z := x.left ≫ (rationalOpenIsoOverQ h₂).inv.left
  obtain ⟨f, hf⟩ := Spec.map_surjective z
  let y : Y0RationalAlgebra h₂ →ₐ[ℚ] ℂ := f.hom.toRatAlgHom
  obtain ⟨τ, hτ⟩ := exists_rationalPointAtParameter_eq h₂ y
  refine ⟨τ, ?_⟩
  rw [← ModelGeneric3.rationalPointAtParameter_openImmersion h₂ τ, hτ,
    ← rationalOpenIso_hom_comp h₂]
  have hx : x.left = z ≫ (rationalOpenIsoOverQ h₂).hom.left := by
    simp only [z, Category.assoc, ← Over.comp_left, Iso.inv_hom_id, Over.id_left,
      Category.comp_id]
  have hfy : f = CommRingCat.ofHom y.toRingHom := CommRingCat.hom_ext rfl
  rw [hx, Category.assoc, ← hf, hfy]
  rfl

#print axioms exists_rationalPointAtParameter_eq
#print axioms exists_complexPoint_eq

end WeierstrassCurve.ModelLevels.ModelGeneric4
