import ZInQKernel.Contrib.OneProof.RC.ModelGeneric3.ChartCoordinates

/-! # Regular functions on the finite chart vary continuously with the parameter

Every element of the fixed modular function field is the germ, at every parameter, of one global
meromorphic function on the upper half-plane (the field is generated by `j` and `j(N·)`). The
value of a regular section of the finite chart at the analytic point of τ is therefore a
holomorphic function of τ near every parameter. -/

namespace WeierstrassCurve.ModelLevels.ModelGeneric4

open AlgebraicGeometry CategoryTheory Filter ModularCurve ShimuraPointDict UpperHalfPlane
open scoped Topology
open ZInQ.Manuscript.RC

open private chart_mem_finiteChart from ZInQKernel.Contrib.OneProof.RC.X0Model3.AffineEval

set_option maxHeartbeats 1000000
set_option synthInstance.maxHeartbeats 400000

variable {N : ℕ} [NeZero N]

/-- The global meromorphic representative property of an element of the modular function
field. -/
def HasGlobalRep (φ : modularFunctionField N) : Prop :=
  ∃ M : ℂ → ℂ, ∀ τ : ℍ, MeromorphicAt M (τ : ℂ) ∧
    X0Model.meromorphicIncl (τ : ℂ) (X0Model.fieldGerm N τ φ) = (M : PuncturedGerm (τ : ℂ))

private theorem hasGlobalRep_add {φ ψ : modularFunctionField N} (hφ : HasGlobalRep φ)
    (hψ : HasGlobalRep ψ) : HasGlobalRep (φ + ψ) := by
  obtain ⟨M, hM⟩ := hφ
  obtain ⟨M', hM'⟩ := hψ
  refine ⟨M + M', fun τ => ⟨(hM τ).1.add (hM' τ).1, ?_⟩⟩
  rw [map_add, map_add, (hM τ).2, (hM' τ).2]
  rfl

private theorem hasGlobalRep_mul {φ ψ : modularFunctionField N} (hφ : HasGlobalRep φ)
    (hψ : HasGlobalRep ψ) : HasGlobalRep (φ * ψ) := by
  obtain ⟨M, hM⟩ := hφ
  obtain ⟨M', hM'⟩ := hψ
  refine ⟨M * M', fun τ => ⟨(hM τ).1.mul (hM' τ).1, ?_⟩⟩
  rw [map_mul, map_mul, (hM τ).2, (hM' τ).2]
  rfl

private theorem hasGlobalRep_inv {φ : modularFunctionField N} (hφ : HasGlobalRep φ) :
    HasGlobalRep φ⁻¹ := by
  obtain ⟨M, hM⟩ := hφ
  refine ⟨fun w => (M w)⁻¹, fun τ => ⟨(hM τ).1.inv, ?_⟩⟩
  by_cases h0 : φ = 0
  · subst h0
    have h := (hM τ).2
    rw [map_zero, map_zero] at h
    have hz : M =ᶠ[𝓝[≠] (τ : ℂ)] (0 : ℂ → ℂ) := Germ.coe_eq.mp h.symm
    rw [inv_zero, map_zero, map_zero]
    exact (Germ.coe_eq.mpr (hz.mono fun w hw => by simp [hw])).symm
  · have hne : X0Model.meromorphicIncl (τ : ℂ) (X0Model.fieldGerm N τ φ) ≠ 0 := by
      intro h
      apply h0
      have h' : X0Model.fieldGerm N τ φ = 0 := Subtype.ext h
      exact (map_eq_zero_iff _ (X0Model.fieldGerm N τ).injective).mp h'
    have hev : ∀ᶠ w in 𝓝[≠] (τ : ℂ), M w ≠ 0 :=
      (hM τ).1.eventually_eq_zero_or_eventually_ne_zero.resolve_left fun h =>
        hne (by rw [(hM τ).2]; exact Germ.coe_eq.mpr h)
    have hmul : X0Model.meromorphicIncl (τ : ℂ) (X0Model.fieldGerm N τ φ⁻¹) *
        X0Model.meromorphicIncl (τ : ℂ) (X0Model.fieldGerm N τ φ) = 1 := by
      rw [← map_mul, ← map_mul, inv_mul_cancel₀ h0, map_one, map_one]
    have hmul' : ((fun w => (M w)⁻¹ : ℂ → ℂ) : PuncturedGerm (τ : ℂ)) *
        (M : PuncturedGerm (τ : ℂ)) = 1 :=
      Germ.coe_eq.mpr (hev.mono fun w hw => inv_mul_cancel₀ hw)
    rw [(hM τ).2] at hmul
    calc X0Model.meromorphicIncl (τ : ℂ) (X0Model.fieldGerm N τ φ⁻¹)
        = X0Model.meromorphicIncl (τ : ℂ) (X0Model.fieldGerm N τ φ⁻¹) *
            ((M : PuncturedGerm (τ : ℂ)) * ((fun w => (M w)⁻¹ : ℂ → ℂ) : PuncturedGerm (τ : ℂ))) := by
          rw [mul_comm (M : PuncturedGerm (τ : ℂ)), hmul', mul_one]
      _ = _ := by rw [← mul_assoc, hmul, one_mul]

private theorem hasGlobalRep_ratCast (f : ℚ →+* modularFunctionField N) (c : ℚ) :
    HasGlobalRep (f c) := by
  refine ⟨fun _ => (c : ℂ), fun τ => ⟨MeromorphicAt.const _ _, ?_⟩⟩
  have hc : X0Model.fieldGerm N τ (f c) = X0Model.constantGerm (τ : ℂ) (c : ℂ) :=
    RingHom.congr_fun (RingHom.ext_rat ((X0Model.fieldGerm N τ).comp f)
      ((X0Model.constantGerm (τ : ℂ)).comp (Rat.castHom ℂ))) c
  rw [hc]
  rfl

private theorem hasGlobalRep_jq : HasGlobalRep (⟨jq, jq_mem N⟩ : modularFunctionField N) := by
  refine ⟨X0Model.analyticJ ∘ ofComplex,
    fun τ => ⟨(X0Model.analyticOn_j τ τ.im_pos).meromorphicAt, ?_⟩⟩
  rw [X0Model.fieldGerm_j]
  change ((fun w => Polynomial.eval₂ (Rat.castHom ℂ) (X0Model.analyticJ (ofComplex w))
    Polynomial.X : ℂ → ℂ) : PuncturedGerm (τ : ℂ)) = _
  simp only [Polynomial.eval₂_X]
  rfl

private theorem hasGlobalRep_jqN : HasGlobalRep (⟨jqN N, jqN_mem N⟩ : modularFunctionField N) :=
  ⟨X0Model.analyticJN N ∘ ofComplex,
    fun τ => ⟨(X0Model.analyticOn_jN N τ τ.im_pos).meromorphicAt, X0Model.fieldGerm_jN N τ⟩⟩

/-- The series with a global meromorphic representative form an intermediate field. -/
private noncomputable def globalRepField : IntermediateField ℚ (LaurentSeries ℚ) where
  carrier := {f | ∃ hf : f ∈ modularFunctionField N, HasGlobalRep (⟨f, hf⟩ : modularFunctionField N)}
  mul_mem' := by
    rintro f g ⟨hf, Hf⟩ ⟨hg, Hg⟩
    refine ⟨mul_mem hf hg, ?_⟩
    have h := hasGlobalRep_mul Hf Hg
    rwa [show (⟨f, hf⟩ * ⟨g, hg⟩ : modularFunctionField N) = ⟨f * g, mul_mem hf hg⟩ from
      Subtype.ext (IntermediateField.coe_mul _ _ _)] at h
  add_mem' := by
    rintro f g ⟨hf, Hf⟩ ⟨hg, Hg⟩
    refine ⟨add_mem hf hg, ?_⟩
    have h := hasGlobalRep_add Hf Hg
    rwa [show (⟨f, hf⟩ + ⟨g, hg⟩ : modularFunctionField N) = ⟨f + g, add_mem hf hg⟩ from
      Subtype.ext (IntermediateField.coe_add _ _ _)] at h
  algebraMap_mem' c := by
    refine ⟨(modularFunctionField N).algebraMap_mem c, ?_⟩
    have h := hasGlobalRep_ratCast (Rat.castHom (modularFunctionField N)) c
    rwa [show (Rat.castHom (modularFunctionField N) c) = ⟨algebraMap ℚ (LaurentSeries ℚ) c,
      (modularFunctionField N).algebraMap_mem c⟩ from Subtype.ext
        ((map_ratCast (modularFunctionField N).val c).trans (eq_ratCast _ c).symm)] at h
  inv_mem' := by
    rintro f ⟨hf, Hf⟩
    refine ⟨inv_mem hf, ?_⟩
    have h := hasGlobalRep_inv Hf
    rwa [show (⟨f, hf⟩⁻¹ : modularFunctionField N) = ⟨f⁻¹, inv_mem hf⟩ from
      Subtype.ext (IntermediateField.coe_inv _ _)] at h

/-- Every element of the modular function field has a global meromorphic representative. -/
theorem hasGlobalRep (φ : modularFunctionField N) : HasGlobalRep φ := by
  have hle : modularFunctionField N ≤ globalRepField (N := N) := by
    change IntermediateField.adjoin ℚ _ ≤ _
    rw [IntermediateField.adjoin_le_iff]
    rintro x (rfl | rfl)
    · exact ⟨jq_mem N, hasGlobalRep_jq⟩
    · exact ⟨jqN_mem N, hasGlobalRep_jqN⟩
  obtain ⟨_, hψ⟩ := hle φ.property
  exact hψ

/-- **Continuity on the finite chart.** The value of a regular section of the finite chart at the
analytic point of τ depends continuously on τ. -/
theorem continuous_finitePointEval (s : Γ(X0Model.curve N, X0Model3.finiteChart N)) :
    Continuous fun τ : ℍ => X0Model3.finitePointEval N τ s := by
  obtain ⟨M, hM⟩ := hasGlobalRep (N := N)
    (X0Model.functionField N ((X0Model.curve N).germToFunctionField (X0Model3.finiteChart N) s))
  have hloc : ∀ τ : ℍ, ∃ g : ℂ → ℂ, AnalyticAt ℂ g (τ : ℂ) ∧
      (g : PuncturedGerm (τ : ℂ)) = (M : PuncturedGerm (τ : ℂ)) ∧
      X0Model3.finitePointEval N τ s = g τ := by
    intro τ
    letI : Nonempty (X0Model3.finiteChart N) := ⟨⟨_, chart_mem_finiteChart N τ⟩⟩
    obtain ⟨g, hg, he, hv⟩ :=
      X0Model.sectionAnalyticAt N τ (X0Model3.finiteChart N) s (chart_mem_finiteChart N τ)
    exact ⟨g, hg, he.trans (hM τ).2, hv⟩
  rw [continuous_iff_continuousAt]
  intro τ₀
  obtain ⟨g, hg, he, hv⟩ := hloc τ₀
  have hgM : ∀ᶠ w in 𝓝 (τ₀ : ℂ), (w ≠ (τ₀ : ℂ) → g w = M w) ∧ AnalyticAt ℂ g w :=
    (eventually_nhdsWithin_iff.mp (Germ.coe_eq.mp he)).and hg.eventually_analyticAt
  obtain ⟨U, hU, hUo, hτU⟩ := eventually_nhds_iff.mp hgM
  have hclaim : ∀ᶠ τ : ℍ in 𝓝 τ₀, X0Model3.finitePointEval N τ s = g τ := by
    filter_upwards [UpperHalfPlane.continuous_coe.tendsto τ₀ (hUo.mem_nhds hτU)] with τ hτ
    by_cases hτ₀ : τ = τ₀
    · subst hτ₀; exact hv
    · obtain ⟨gτ, hgτ, heτ, hvτ⟩ := hloc τ
      have hne : (τ : ℂ) ≠ τ₀ := fun h => hτ₀ (UpperHalfPlane.ext h)
      have hMg : M =ᶠ[𝓝 (τ : ℂ)] g := by
        filter_upwards [hUo.mem_nhds hτ, isOpen_ne.mem_nhds hne] with w hwU hw
        exact ((hU w hwU).1 hw).symm
      have hgτg : gτ =ᶠ[𝓝[≠] (τ : ℂ)] g :=
        (Germ.coe_eq.mp heτ).trans (hMg.filter_mono nhdsWithin_le_nhds)
      rw [hvτ]
      have hga : AnalyticAt ℂ g (τ : ℂ) := (hU τ hτ).2
      exact tendsto_nhds_unique (hgτ.continuousAt.tendsto.mono_left nhdsWithin_le_nhds)
        ((hga.continuousAt.tendsto.mono_left nhdsWithin_le_nhds).congr' hgτg.symm)
  have hcont : ContinuousAt (fun τ : ℍ => g τ) τ₀ :=
    hg.continuousAt.comp UpperHalfPlane.continuous_coe.continuousAt
  exact hcont.congr (hclaim.mono fun τ h => h.symm)

/-- The complex point of the pinned rational open at τ depends continuously on τ. -/
theorem continuous_rationalPointAtParameter (h₂ : 2 ≤ N) (a : ModelGeneric.Y0RationalAlgebra h₂) :
    Continuous fun τ : ℍ => ModelGeneric3.rationalPointAtParameter h₂ τ a :=
  continuous_finitePointEval ((ModelGeneric2.rationalChartSections h₂).val.symm a)

#print axioms hasGlobalRep
#print axioms continuous_finitePointEval
#print axioms continuous_rationalPointAtParameter

end WeierstrassCurve.ModelLevels.ModelGeneric4
