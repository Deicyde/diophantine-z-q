import ZInQKernel.Contrib.OneProof.RC.ModelGeneric3.AnalyticPair
import ZInQKernel.Contrib.OneProof.RingClassLattice
import ZInQKernel.Contrib.TauCeti.AlgebraicGeometry.EllipticCurve.Affine.Point.VariableChange

/-! # Homothetic lattices give the same analytic pair class -/

namespace WeierstrassCurve.ModelLevels.ModelGeneric4

open WeierstrassCurve.Affine UpperHalfPlane

open private ModelGeneric3.nsmul_div_mem_periodLattice from
  ZInQKernel.Contrib.OneProof.RC.ModelGeneric3.AnalyticPair

set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 1000000
set_option synthInstance.maxHeartbeats 400000

private theorem changePoints_scale (W V : WeierstrassCurve ℂ) (u : ℂˣ)
    (h : (⟨u, 0, 0, 0⟩ : VariableChange ℂ) • W = V) {x y : ℂ}
    (hxy : W.toAffine.Nonsingular x y)
    (h' : V.toAffine.Nonsingular ((u : ℂ)⁻¹ ^ 2 * x) ((u : ℂ)⁻¹ ^ 3 * y)) :
    changePoints W V _ h (Point.some x y hxy) = Point.some _ _ h' := by
  subst h
  change (Point.addEquivVariableChange W _).symm (Point.some x y hxy) = _
  rw [Point.coe_addEquivVariableChange_symm, Point.equivVariableChange_symm_some]
  congr 1 <;> simp [VariableChange.inv_def]

private theorem one_div_notMem {N : ℕ} [NeZero N] (h₂ : 2 ≤ N) (τ : ℍ) :
    (1 / (N : ℂ)) ∉ (PeriodPair.ofTau τ).lattice := by
  intro h
  have h1 := (ModelGeneric3.nsmul_div_mem_periodLattice (N := N) τ 1).1 (by rwa [one_smul])
  have := Nat.le_of_dvd one_pos h1
  omega

/-- **Homothety of analytic pairs.** If `ℤτ₀ + ℤ = α(ℤτ' + ℤ)`, the analytic pair at τ' is the pair
on the period curve of τ₀ with the subgroup generated by the image of `α/N`. -/
theorem analyticCyclicPair_eq_of_scale {N : ℕ} [NeZero N] (h₂ : 2 ≤ N) (τ' τ₀ : ℍ) (α : ℂ)
    (hs : T5Glue.IsScale (PeriodPair.ofTau τ₀) (PeriodPair.ofTau τ') α)
    (D : CyclicSubgroups (PeriodPair.ofTau τ₀).weierstrassCurve.toAffine.Point N)
    (hD : D.1 = AddSubgroup.zmultiples ((PeriodPair.ofTau τ₀).toPoint
      (PeriodPair.ofTau τ₀).discriminant_ne_zero (α * (1 / N)))) :
    ModelGeneric3.analyticCyclicPair (N := N) τ' =
      Quot.mk _ ⟨(PeriodPair.ofTau τ₀).weierstrassCurve,
        ⟨isUnit_iff_ne_zero.mpr (PeriodPair.ofTau τ₀).discriminant_ne_zero.weierstrassCurve_Δ_ne_zero⟩,
        D⟩ := by
  have hα : α ≠ 0 := hs.1
  let u : ℂˣ := Units.mk0 α hα
  have hu : (u : ℂ) = α := rfl
  have hcurve : (⟨u, 0, 0, 0⟩ : VariableChange ℂ) • (PeriodPair.ofTau τ').weierstrassCurve =
      (PeriodPair.ofTau τ₀).weierstrassCurve := by
    ext
    · simp [WeierstrassCurve.variableChange_a₁]
    · simp [WeierstrassCurve.variableChange_a₂]
    · simp [WeierstrassCurve.variableChange_a₃]
    · rw [WeierstrassCurve.variableChange_a₄]
      simp only [PeriodPair.weierstrassCurve_a₄, PeriodPair.weierstrassCurve_a₃,
        PeriodPair.weierstrassCurve_a₂, PeriodPair.weierstrassCurve_a₁, hs.g₂, Units.val_inv_eq_inv_val,
        hu]
      field_simp
      ring
    · rw [WeierstrassCurve.variableChange_a₆]
      simp only [PeriodPair.weierstrassCurve_a₆, PeriodPair.weierstrassCurve_a₄,
        PeriodPair.weierstrassCurve_a₃, PeriodPair.weierstrassCurve_a₂,
        PeriodPair.weierstrassCurve_a₁, hs.g₃, Units.val_inv_eq_inv_val, hu]
      field_simp
      ring
  rw [ModelGeneric3.analyticCyclicPair]
  apply (pairClasses_eq_iff _ _).2
  refine ⟨_, hcurve, ?_⟩
  rw [hD]
  change AddSubgroup.map (changePoints _ _ _ hcurve).toAddMonoidHom
    (AddSubgroup.zmultiples ((PeriodPair.ofTau τ').toPoint
      (PeriodPair.ofTau τ').discriminant_ne_zero (1 / (N : ℂ)))) = _
  rw [AddMonoidHom.map_zmultiples]
  congr 1
  have hQ := one_div_notMem h₂ τ'
  have hP : α * (1 / (N : ℂ)) ∉ (PeriodPair.ofTau τ₀).lattice := by
    rw [hs.mem_iff, inv_mul_cancel_left₀ hα]; exact hQ
  change changePoints _ _ _ hcurve ((PeriodPair.ofTau τ').toPoint _ (1 / (N : ℂ))) = _
  rw [PeriodPair.toPoint_of_notMem _ _ hQ, PeriodPair.toPoint_of_notMem _ _ hP,
    changePoints_scale _ _ u hcurve]
  · congr 1
    · rw [hs.weierstrassP, hu, inv_pow]
    · rw [hs.derivWeierstrassP, hu, inv_pow]; ring
  · have := ((WeierstrassCurve.Affine.equation_iff_nonsingular_of_Δ_ne_zero
      (PeriodPair.ofTau τ₀).discriminant_ne_zero.weierstrassCurve_Δ_ne_zero).mp
        ((PeriodPair.ofTau τ₀).equation_weierstrassP hP))
    rw [hs.weierstrassP, hs.derivWeierstrassP] at this
    rw [hu]
    convert this using 2
    · rw [inv_pow]
    · rw [inv_pow]; ring

#print axioms analyticCyclicPair_eq_of_scale

end WeierstrassCurve.ModelLevels.ModelGeneric4
