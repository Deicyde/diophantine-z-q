/-- The j-invariant of a period pair depends only on its lattice. -/
theorem jLattice_congr {L₁ L₂ : PeriodPair} (h : L₁.lattice = L₂.lattice) :
    L₁.jLattice = L₂.jLattice := by
  have hG : ∀ n, L₁.G n = L₂.G n := by
    intro n
    unfold PeriodPair.G
    rw [h]
  simp only [PeriodPair.jLattice, PeriodPair.g₂, PeriodPair.g₃, hG]

/-- A point maps to zero whenever its place and the place of zero restrict to the same
place. -/
theorem pointMapOfPushforward_eq_zero_of_restrictAlong_eq {V W : WeierstrassCurve ℂ}
    [V.IsElliptic] [W.IsElliptic]
    [GenusOnePlaceGate V.toAffine] [AbelTheorem V.toAffine]
    [GenusOnePlaceGate W.toAffine] [AbelTheorem W.toAffine]
    (ι : V.toAffine.FunctionField →ₐ[ℂ] W.toAffine.FunctionField) (hι : ι.toRingHom.IsIntegral)
    (hfin : FiniteAlong ℂ ι) (hN : NormFormulaAlong ℂ ι hfin) (P : W.toAffine.Point)
    (h : (placeOfPoint P).restrictAlong ι hι = (placeOfPoint (0 : W.toAffine.Point)).restrictAlong ι hι) :
    pointMapOfPushforward ι hι hfin hN P = 0 := by
  rw [pointMapOfPushforward_apply, pointClass, Pic0.pushforwardAlongHom_mk]
  have hD : Pic0.pushforwardAlongDegZero ι hι (pointDivisor P) = 0 := by
    refine Subtype.ext ?_
    rw [Pic0.coe_pushforwardAlongDegZero, coe_pointDivisor, map_sub,
      pushforwardAlong_single_eq ι hι, pushforwardAlong_single_eq ι hι, h, sub_self]
    rfl
  rw [hD, Pic0.mk_zero, map_zero]

/-- Two parameters have the same image under the period uniformization exactly when they
differ by a period. -/
theorem toPoint_eq_toPoint_iff (L : PeriodPair) (hL : L.DiscriminantNeZero) (a b : ℂ) :
    L.toPoint hL a = L.toPoint hL b ↔ a - b ∈ L.lattice := by
  have hadd := (L.isUniformization_toPoint hL).1
  constructor
  · intro h
    apply (L.isUniformization_toPoint hL).2.2
    have h' := hadd (a - b) b
    rw [sub_add_cancel, h] at h'
    exact (add_eq_right.mp h'.symm)
  · intro h
    have h' := hadd (a - b) b
    rw [sub_add_cancel, L.toPoint_of_mem hL h, zero_add] at h'
    exact h'

/-- The period uniformization as an additive homomorphism. -/
noncomputable def uniformization (L : PeriodPair) (hL : L.DiscriminantNeZero) :
    ℂ →+ L.weierstrassCurve.toAffine.Point where
  toFun := L.toPoint hL
  map_zero' := L.toPoint_zero hL
  map_add' := (L.isUniformization_toPoint hL).1

/-- The preimage of the subgroup generated by the image of `1/N` is `ℤτ + ℤ(1/N)`. -/
theorem toPoint_mem_zmultiples_iff (τ : ℍ) (N : ℕ) [NeZero N] (z : ℂ) :
    (PeriodPair.ofTau τ).toPoint (PeriodPair.ofTau τ).discriminant_ne_zero z ∈
        AddSubgroup.zmultiples ((PeriodPair.ofTau τ).toPoint
          (PeriodPair.ofTau τ).discriminant_ne_zero (1 / (N : ℂ))) ↔
      z ∈ Submodule.span ℤ {(τ : ℂ), 1 / (N : ℂ)} := by
  let L := PeriodPair.ofTau τ
  let hL := L.discriminant_ne_zero
  have hN : (N : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr (NeZero.ne N)
  rw [AddSubgroup.mem_zmultiples_iff, Submodule.mem_span_pair]
  constructor
  · rintro ⟨m, hm⟩
    have hm' : L.toPoint hL (m • (1 / (N : ℂ))) = L.toPoint hL z := by
      rw [← hm]
      exact map_zsmul (uniformization L hL) m (1 / (N : ℂ))
    rw [toPoint_eq_toPoint_iff, PeriodPair.ofTau_lattice, Submodule.mem_span_pair] at hm'
    obtain ⟨a, b, hab⟩ := hm'
    refine ⟨-a, m - b * N, ?_⟩
    simp only [zsmul_eq_mul, Int.cast_neg, Int.cast_sub, Int.cast_mul, Int.cast_natCast] at hab ⊢
    have hz : z = m * (1 / (N : ℂ)) - a * τ - b * 1 := by linear_combination hab
    rw [hz]
    field_simp
    ring
  · rintro ⟨a, b, hab⟩
    refine ⟨b, ?_⟩
    have hb : b • L.toPoint hL (1 / (N : ℂ)) = L.toPoint hL (b • (1 / (N : ℂ))) :=
      (map_zsmul (uniformization L hL) b _).symm
    change b • L.toPoint hL (1 / (N : ℂ)) = L.toPoint hL z
    rw [hb, toPoint_eq_toPoint_iff, PeriodPair.ofTau_lattice, Submodule.mem_span_pair]
    refine ⟨-a, 0, ?_⟩
    simp only [zsmul_eq_mul, Int.cast_neg, zero_smul, add_zero] at hab ⊢
    rw [← hab]
    ring

private theorem not_forall_mem_span (τ : ℍ) (N : ℕ) [NeZero N] :
    (1 / (2 * N : ℂ)) ∉ Submodule.span ℤ {(τ : ℂ), 1 / (N : ℂ)} := by
  have hN : (N : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr (NeZero.ne N)
  rw [Submodule.mem_span_pair]
  rintro ⟨a, b, h⟩
  have him := congrArg Complex.im h
  simp only [zsmul_eq_mul, Complex.add_im, Complex.mul_im, Complex.intCast_re,
    Complex.intCast_im, zero_mul, add_zero] at him
  have hre1 : (1 / (N : ℂ)).im = 0 := by
    rw [← Complex.ofReal_natCast, ← Complex.ofReal_one, ← Complex.ofReal_div]
    exact Complex.ofReal_im _
  have hre2 : (1 / (2 * N : ℂ)).im = 0 := by
    rw [← Complex.ofReal_natCast, ← Complex.ofReal_one, ← Complex.ofReal_ofNat,
      ← Complex.ofReal_mul, ← Complex.ofReal_div]
    exact Complex.ofReal_im _
  rw [hre1, hre2, mul_zero, add_zero] at him
  have ha : a = 0 := by
    exact_mod_cast (mul_eq_zero.mp him).resolve_right τ.im_pos.ne'
  subst a
  simp only [zero_smul, zero_add, zsmul_eq_mul] at h
  have h2 : (2 * b : ℂ) = 1 := by
    field_simp at h
    linear_combination h
  have h2' : (2 * b : ℤ) = 1 := by exact_mod_cast h2
  omega

/-- **The quotient lattice.** Let `V` be an elliptic curve and `ι` a map of function fields
from `V` to the period curve of `ℤτ + ℤ` whose restriction of places is a point homomorphism
with kernel the subgroup generated by the image of `1/N`. Then `j(V) = j(Nτ)`. -/
theorem j_eq_analyticJN_of_seam (τ : ℍ) (N : ℕ) [NeZero N] (V : WeierstrassCurve ℂ)
    [V.IsElliptic]
    (ι : V.toAffine.FunctionField →ₐ[ℂ] (PeriodPair.ofTau τ).weierstrassCurve.toAffine.FunctionField)
    (hι : ι.toRingHom.IsIntegral) (hfin : FiniteAlong ℂ ι)
    (g : haveI : (PeriodPair.ofTau τ).weierstrassCurve.IsElliptic :=
        ⟨isUnit_iff_ne_zero.mpr (PeriodPair.ofTau τ).discriminant_ne_zero.weierstrassCurve_Δ_ne_zero⟩
      (PeriodPair.ofTau τ).weierstrassCurve.toAffine.Point →+ V.toAffine.Point)
    (hg : g.ker = AddSubgroup.zmultiples ((PeriodPair.ofTau τ).toPoint
      (PeriodPair.ofTau τ).discriminant_ne_zero (1 / (N : ℂ))))
    (hseam : haveI : (PeriodPair.ofTau τ).weierstrassCurve.IsElliptic :=
        ⟨isUnit_iff_ne_zero.mpr (PeriodPair.ofTau τ).discriminant_ne_zero.weierstrassCurve_Δ_ne_zero⟩
      IsSeam ι hι g) :
    V.j = X0Model.analyticJN N τ := by
  let L := PeriodPair.ofTau τ
  have hL : L.DiscriminantNeZero := L.discriminant_ne_zero
  haveI hEll : L.weierstrassCurve.IsElliptic :=
    ⟨isUnit_iff_ne_zero.mpr hL.weierstrassCurve_Δ_ne_zero⟩
  let H := AddSubgroup.zmultiples (L.toPoint hL (1 / (N : ℂ)))
  obtain ⟨L₂, C, rfl⟩ := PeriodPair.exists_variableChange_smul_weierstrassCurve_eq V
  have hL₂ : L₂.DiscriminantNeZero := L₂.discriminant_ne_zero
  haveI hEll₂ : L₂.weierstrassCurve.IsElliptic :=
    ⟨isUnit_iff_ne_zero.mpr hL₂.weierstrassCurve_Δ_ne_zero⟩
  obtain ⟨eV⟩ := WeierstrassCurve.nonempty_functionField_algEquiv_of_variableChange
    L₂.weierstrassCurve C
  have heV : eV.toAlgHom.toRingHom.IsIntegral :=
    RingHom.isIntegral_of_surjective _ eV.surjective
  let ι' := ι.comp eV.toAlgHom
  have hι' : ι'.toRingHom.IsIntegral :=
    RingHom.IsIntegral.trans eV.toAlgHom.toRingHom ι.toRingHom heV hι
  have hfin' : FiniteAlong ℂ ι' := by
    have h1 : RingHom.Finite ι.toRingHom := hfin
    have h2 : RingHom.Finite eV.toAlgHom.toRingHom := RingHom.Finite.of_surjective _ eV.surjective
    exact RingHom.Finite.comp (g := ι.toRingHom) h1 h2
  letI := gate L.weierstrassCurve
  haveI := gate_isCentred L.weierstrassCurve
  haveI := gate_abel L.weierstrassCurve
  letI := gate L₂.weierstrassCurve
  haveI := gate_isCentred L₂.weierstrassCurve
  haveI := gate_abel L₂.weierstrassCurve
  letI := gate (C • L₂.weierstrassCurve)
  haveI := gate_isCentred (C • L₂.weierstrassCurve)
  haveI := gate_abel (C • L₂.weierstrassCurve)
  have hN := P2MW.S_WeierstrassCurve_Affine_eval_modularPolynomial_map_j_eq_zero_of_isAddCyclic_ker_pointMapOfPushforward.F4Proof.normFormulaAlong_of_charZero
    ι hfin
  have hN' := P2MW.S_WeierstrassCurve_Affine_eval_modularPolynomial_map_j_eq_zero_of_isAddCyclic_ker_pointMapOfPushforward.F4Proof.normFormulaAlong_of_charZero
    ι' hfin'
  have hker1 : (pointMapOfPushforward ι hι hfin hN).ker = H := by
    ext P
    rw [AddMonoidHom.mem_ker, pointMapOfPushforward_eq_of_seam ι hι hfin hN g g.map_zero hseam P,
      ← AddMonoidHom.mem_ker, hg]
  have hcyc : IsAddCyclic (pointMapOfPushforward ι hι hfin hN).ker := by
    rw [hker1]; infer_instance
  obtain ⟨-, hcard'⟩ :=
    WeierstrassCurve.Affine.isAddCyclic_ker_pointMapOfPushforward_of_algEquiv_conj
      L.weierstrassCurve.toAffine (C • L₂.weierstrassCurve).toAffine
      L.weierstrassCurve.toAffine L₂.weierstrassCurve.toAffine
      ι hι hfin hN AlgEquiv.refl eV ι' (fun _ => rfl) hι' hfin' hN' hcyc
  have hHcard : Nat.card H = N := by
    rw [Nat.card_zmultiples]
    exact (ModelGeneric3.latticeGenerator (N := N) τ).2
  have hle : H ≤ (pointMapOfPushforward ι' hι' hfin' hN').ker := by
    intro P hP
    rw [AddMonoidHom.mem_ker]
    apply pointMapOfPushforward_eq_zero_of_restrictAlong_eq
    have hgP : g P = 0 := by rw [← AddMonoidHom.mem_ker, hg]; exact hP
    rw [← Place.restrictAlong_restrictAlong eV.toAlgHom ι heV hι hι',
      ← Place.restrictAlong_restrictAlong eV.toAlgHom ι heV hι hι']
    change Place.restrictAlong eV.toAlgHom heV (pointPlace _ P |>.restrictAlong ι hι) =
      Place.restrictAlong eV.toAlgHom heV (pointPlace _ 0 |>.restrictAlong ι hι)
    rw [hseam P, hseam 0, hgP, g.map_zero]
  have hcardψ : Nat.card (pointMapOfPushforward ι' hι' hfin' hN').ker = N := by
    rw [hcard', hker1, hHcard]
  haveI : Finite (pointMapOfPushforward ι' hι' hfin' hN').ker :=
    Nat.finite_of_card_ne_zero (by rw [hcardψ]; exact NeZero.ne N)
  have hkerψ : (pointMapOfPushforward ι' hι' hfin' hN').ker = H :=
    (AddSubgroup.eq_of_le_of_card_ge hle (by rw [hcardψ, hHcard])).symm
  obtain ⟨F, hF, hF0, hFz⟩ :=
    PeriodPair.exists_differentiable_toPoint_comp_eq_pointMapOfPushforward_toPoint
      L L₂ hL hL₂ ι' hι' hfin' hN'
  have hper : ∀ l ∈ L.lattice, ∀ z, F (z + l) - F z ∈ L₂.lattice := by
    intro l hl z
    rw [← toPoint_eq_toPoint_iff L₂ hL₂, hFz, hFz,
      (toPoint_eq_toPoint_iff L hL (z + l) z).2 (by simpa using hl)]
  obtain ⟨α, -, hα⟩ :=
    P2MW.S_PeriodPair_exists_scale_lattice_subset_and_sublatticeIndex_eq_and_isAddCyclic_sublatticeQuotient.PeriodPair.exists_smul_mem_and_apply_eq_of_forall_sub_mem
      L L₂ hF hper
  have hkey : ∀ z, α * z ∈ L₂.lattice ↔ z ∈ Submodule.span ℤ {(τ : ℂ), 1 / (N : ℂ)} := by
    intro z
    rw [← toPoint_mem_zmultiples_iff τ N z]
    change _ ↔ L.toPoint hL z ∈ H
    rw [← hkerψ, AddMonoidHom.mem_ker, ← hFz, hα, ← L₂.toPoint_zero hL₂,
      toPoint_eq_toPoint_iff, sub_zero]
    constructor
    · intro h
      exact add_mem hF0 h
    · intro h
      simpa using sub_mem h hF0
  have hN0 : (N : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr (NeZero.ne N)
  have hα0 : α ≠ 0 := by
    rintro rfl
    exact not_forall_mem_span τ N ((hkey _).1 (by rw [zero_mul]; exact zero_mem _))
  let β : ℂˣ := Units.mk0 (α / N) (div_ne_zero hα0 hN0)
  have hlat : L₂.lattice = ((PeriodPair.ofTau (X0Model.dilate N τ)).scale β).lattice := by
    ext w
    have hw : w = α * (α⁻¹ * w) := by field_simp
    nth_rewrite 1 [hw]
    rw [hkey]
    change _ ↔ _ ∈ Submodule.span ℤ {(β : ℂ) * ((N : ℂ) * τ), (β : ℂ) * 1}
    rw [Submodule.mem_span_pair, Submodule.mem_span_pair]
    have hβ : (β : ℂ) = α / N := rfl
    constructor
    · rintro ⟨a, b, hab⟩
      refine ⟨a, b, ?_⟩
      simp only [zsmul_eq_mul, hβ] at hab ⊢
      rw [hw, ← hab]
      field_simp
    · rintro ⟨a, b, hab⟩
      refine ⟨a, b, ?_⟩
      simp only [zsmul_eq_mul, hβ] at hab ⊢
      rw [← hab]
      field_simp
  have hj₂ : L₂.weierstrassCurve.j = L₂.jLattice := by
    rw [PeriodPair.jLattice_eq_c₄_pow_three_div_Δ, WeierstrassCurve.j, div_eq_mul_inv, mul_comm,
      Units.val_inv_eq_inv_val, WeierstrassCurve.coe_Δ']
  rw [WeierstrassCurve.variableChange_j, hj₂, jLattice_congr hlat,
    P2MW.S_WeierstrassCurve_Affine_eval_modularPolynomial_map_j_eq_zero_of_isAddCyclic_ker_pointMapOfPushforward.PeriodPair.jLattice_scale,
    PeriodPair.jLattice_ofTau]
  rfl

/-- **(b1).** The actual vendored iterated Vélu quotient of the period curve of `ℤτ + ℤ` by the
subgroup generated by the image of `1/N` has j-invariant `j(Nτ)`, for every positive `N` and every
upper half-plane parameter (including parameters where `j(τ)` is algebraic). -/
theorem pairQuotientJ_analyticCyclicPair {N : ℕ} [NeZero N] (τ : ℍ) :
    ModelGeneric2.pairQuotientJ (ModelGeneric3.analyticCyclicPair (N := N) τ) =
      X0Model.analyticJN N τ := by
  let L := PeriodPair.ofTau τ
  haveI hEll : L.weierstrassCurve.IsElliptic :=
    ⟨isUnit_iff_ne_zero.mpr L.discriminant_ne_zero.weierstrassCurve_Δ_ne_zero⟩
  let G := ModelGeneric3.latticeGenerator (N := N) τ
  let H : AddSubgroup L.weierstrassCurve.toAffine.Point := (subgroupOfGenerator G).val
  have hH : IsAddCyclic H ∧ Nat.card H = N := (subgroupOfGenerator G).property
  obtain ⟨hV, ι, hι, hfin, g, hg, hseam⟩ :=
    exists_quotientSeam N (NeZero.ne N) L.weierstrassCurve H hH
  change L.weierstrassCurve.cyclicQuotientJ H N = _
  rw [cyclicQuotientJ_eq_j]
  exact j_eq_analyticJN_of_seam τ N _ ι hι hfin g hg hseam

