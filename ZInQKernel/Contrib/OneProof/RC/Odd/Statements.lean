theorem oddStageSource_example :
    OddStageSource ℤ 0 2 3 0 (fun n => Ideal.Quotient.mk _ (exChi n)) (fun q => q = 3)
      (fun D => D = 1 ∨ D = 3) (fun _ => 0) (fun n => Ideal.Quotient.mk _ (exCoeff n)) ∧
      (Ideal.Quotient.mk (Ideal.span {(2 : ℤ) ^ 3}) (exCoeff 3)) ≠ 0 := by
  obtain ⟨H, -, -⟩ := sourceHyp_example
  have H' := H.map (Ideal.Quotient.mk (Ideal.span {(2 : ℤ) ^ 3}))
  refine ⟨⟨by decide, { toSourceCore := H'.toSourceCore, depth := fun D hD hadm => ?_ }⟩, ?_⟩
  · refine two_pow_dvd_of_le ?_ (H'.depth D hD hadm)
    have : budgetLevel 0 0 2 = 2 := by decide
