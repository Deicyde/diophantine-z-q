import Mathlib

/-!
# Lane RC12-odd: the trace and inertia identities behind the coefficient rules (App F)

Manuscript (11/5), Appendix F, proof of Proposition `ex:app-coefficient-rules`:
* "`d(u)t(v) = t(v)`, `t(u)t(v) = t(uv) + t(uv^{−1})`, `t(1) = 0`. The middle equality follows from
  the characteristic-zero matrix identity `tr(A)tr(B) = tr(AB) + det(B) tr(AB^{−1})` … the last
  follows from `tr(1) = 2`" (tex 9729–9739) — `trace_mul_trace`, `trace_mul_trace_units`;
* "It follows that `t(g)t(h)F_U = 0` after reduction. Applying the middle identity to `t(gh)t(h)`
  gives `t(gh²)F_U = t(g)F_U`. Invariance under all squares … gives factorization through the
  elementary quadratic quotient" (tex 9745–9750) — `trace_square_invariance`,
  `factor_through_squares`;
* "A fresh vertex with trivial label … has the same reduced reading as `t(1)`, hence gives zero"
  (tex 9947–9948) — `primary_isolation_reading`;
* (O.12) (tex 9866–9889): `ρ(τ) = diag(1,−1)`, `ρ(φ) = diag(λ, μ)`, `t(gτ) − t(g) = −2e`,
  `t(gτφ) − t(gφ) = −2eμ`, hence `U_p^{(2)}{t(gτφ) − t(gφ)} = d(φ){t(gτ) − t(g)}` — `O12_diag`;
  the unramified blocks — `O12_unramified`;
* the Whittaker matrix identity `a(n) (p b; 0 1) = n(nb) a(np)` (tex 9846) — `whittaker_matrix`;
* the omission rule at the level of readings (tex 9919–9931): `c_p(vr₀) + c_p(vr₁) = 1` and
  `𝒜_U(Uq_τ) + 𝒜_U(Uq) = 𝒜_V(Vr₀)` — `cp_sum_odd`, `omission_rule`.

All statements are PROVED. The Galois representations, the Chebotarev approximation of `t(g)`,
`d(g)` by Hecke and diamond operators, and Casselman/Carayol's local description of the ramified
blocks (tex 9799–9864) are not formalized: they are the hypotheses of these algebraic statements
(PRINT for Casselman Thm 1 pp. 302–306, Cor p. 306, Thm 4 p. 313 and Carayol §§0.3–0.7, Thm A
pp. 409–411, as the manuscript cites them; UNVERIFIED against the prints).
-/

namespace ZInQ.Manuscript.RC.Odd

open Matrix

/-- **PROVED (tex 9734–9737).** For `2 × 2` matrices over a commutative ring,
`tr(A) tr(B) = tr(AB) + tr(A adj(B))` (Cayley–Hamilton: `adj B = tr(B)·1 − B`). -/
theorem trace_mul_trace_adj {K : Type*} [CommRing K] (A B : Matrix (Fin 2) (Fin 2) K) :
    A.trace * B.trace = (A * B).trace + (A * B.adjugate).trace := by
  simp only [trace_fin_two, adjugate_fin_two, mul_apply, Fin.sum_univ_two, of_apply, cons_val',
    cons_val_zero, cons_val_one, empty_val', cons_val_fin_one]
  ring

/-- **PROVED (tex 9734–9737).** `tr(A) tr(B) = tr(AB) + det(B) tr(A B⁻¹)` for `B ∈ GL₂`. -/
theorem trace_mul_trace_units {K : Type*} [CommRing K] (A : Matrix (Fin 2) (Fin 2) K)
    (B : GL (Fin 2) K) :
    A.trace * (B : Matrix (Fin 2) (Fin 2) K).trace =
      (A * B).trace + (B : Matrix (Fin 2) (Fin 2) K).det *
        (A * ((B⁻¹ : GL (Fin 2) K) : Matrix (Fin 2) (Fin 2) K)).trace := by
  rw [trace_mul_trace_adj]
  congr 1
  have hdet : IsUnit (B : Matrix (Fin 2) (Fin 2) K).det := Matrix.isUnits_det_units B
  rw [Matrix.coe_units_inv, Matrix.inv_def, Matrix.mul_smul, Matrix.trace_smul, smul_eq_mul,
    ← mul_assoc, Ring.mul_inverse_cancel _ hdet, one_mul]

variable {Γ M : Type*} [Group Γ] [AddCommGroup M] [Module (ZMod 2) M]

theorem neg_eq_self_zmod2 (x : M) : -x = x := by
  have h : (2 : ZMod 2) • x = 0 := by
    rw [show (2 : ZMod 2) = 0 from rfl, zero_smul]
  rw [two_smul] at h
  exact neg_eq_of_add_eq_zero_left h

/-- **PROVED (tex 9741–9747).** Trace operators `t(g)`, determinant operators `d(g)` on a
characteristic-two module, with the matrix identity `t(g)t(h) = t(gh) + d(h)t(gh⁻¹)`, `d` acting
trivially on the trace orbit of `F` (tex 9719–9733), and vanishing of two fresh traces
(`t(g)t(h)F = 0`, tex 9741–9745): then `t(gh²)F = t(g)F`. -/
theorem trace_square_invariance (t d : Γ → M →ₗ[ZMod 2] M) (F : M)
    (htr : ∀ g h (x : M), t g (t h x) = t (g * h) x + d h (t (g * h⁻¹) x))
    (hd : ∀ u v, d u (t v F) = t v F) (h2 : ∀ g h, t g (t h F) = 0) (g h : Γ) :
    t (g * h ^ 2) F = t g F := by
  have := htr (g * h) h F
  rw [h2, show g * h * h = g * h ^ 2 by rw [mul_assoc, ← sq], show g * h * h⁻¹ = g by group, hd] at this
  have h0 : t (g * h ^ 2) F = -t g F := by
    rw [eq_neg_iff_add_eq_zero]; exact this.symm
  rw [h0, neg_eq_self_zmod2]

/-- **PROVED (tex 9747–9750).** A reading invariant under multiplication by squares factors
through the elementary quadratic quotient: it is constant on cosets of the subgroup generated by
squares. -/
theorem factor_through_squares {N : Type*} (φ : Γ → N) (hφ : ∀ g h, φ (g * h ^ 2) = φ g) (g : Γ)
    {k : Γ} (hk : k ∈ Subgroup.closure {x : Γ | ∃ h, x = h ^ 2}) : φ (g * k) = φ g := by
  induction hk using Subgroup.closure_induction generalizing g with
  | mem x hx => obtain ⟨h, rfl⟩ := hx; exact hφ g h
  | one => simp
  | mul x y _ _ ihx ihy => rw [← mul_assoc, ihy, ihx]
  | inv x _ ihx => rw [← ihx (g * x⁻¹), inv_mul_cancel_right]

/-- **PROVED (tex 9739, 9947–9948).** With `t(1) = 2`, a vertex whose label is trivial in the
elementary quotient (its Frobenius lies in the subgroup generated by squares) reads zero. -/
theorem primary_isolation_reading (t d : Γ → M →ₗ[ZMod 2] M) (F : M)
    (htr : ∀ g h (x : M), t g (t h x) = t (g * h) x + d h (t (g * h⁻¹) x))
    (hd : ∀ u v, d u (t v F) = t v F) (h2 : ∀ g h, t g (t h F) = 0)
    (ht1 : ∀ x, t 1 x = (2 : ZMod 2) • x) {k : Γ}
    (hk : k ∈ Subgroup.closure {x : Γ | ∃ h, x = h ^ 2}) : t k F = 0 := by
  have := factor_through_squares (fun g => t g F) (trace_square_invariance t d F htr hd h2) 1 hk
  simp only [one_mul] at this
  rw [this, ht1, show (2 : ZMod 2) = 0 from rfl, zero_smul]

/-- **PROVED ((O.12), tex 9866–9884).** On a ramified block with `ρ(τ) = diag(1, −1)`,
`ρ(φ) = diag(λ, μ)`, `U_p^{(2)} = λ`, `d(φ) = λμ`: for every `ρ(g) = (a b; c e)`,
`t(gτ) − t(g) = −2e`, `t(gτφ) − t(gφ) = −2eμ`, and
`U_p^{(2)} {t(gτφ) − t(gφ)} = d(φ) {t(gτ) − t(g)}`. -/
theorem O12_diag {K : Type*} [CommRing K] (g : Matrix (Fin 2) (Fin 2) K) (lam mu : K) :
    let τ : Matrix (Fin 2) (Fin 2) K := diagonal ![1, -1]
    let φ : Matrix (Fin 2) (Fin 2) K := diagonal ![lam, mu]
    (g * τ).trace - g.trace = -2 * g 1 1 ∧
    (g * τ * φ).trace - (g * φ).trace = -2 * g 1 1 * mu ∧
    lam * ((g * τ * φ).trace - (g * φ).trace) = (lam * mu) * ((g * τ).trace - g.trace) := by
  intro τ φ
  simp only [τ, φ, trace_fin_two, mul_apply, Fin.sum_univ_two, diagonal_apply, Fin.isValue,
    Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons]
  norm_num
  refine ⟨by ring, by ring, by ring⟩

/-- **PROVED (tex 9885–9889).** On a block from level prime to `p` the representation is
unramified (`ρ(τ) = 1`) and both inertia differences vanish. -/
theorem O12_unramified {K : Type*} [CommRing K] (g φ : Matrix (Fin 2) (Fin 2) K) :
    (g * 1).trace - g.trace = 0 ∧ (g * 1 * φ).trace - (g * φ).trace = 0 := by
  simp

/-- **PROVED (tex 9844–9848).** `a(n) (p b; 0 1) = n(nb) a(np)`. -/
theorem whittaker_matrix {K : Type*} [CommRing K] (n p b : K) :
    !![n, 0; 0, 1] * !![p, b; 0, 1] = !![1, n * b; 0, 1] * !![n * p, 0; 0, 1] := by
  ext i j; fin_cases i <;> fin_cases j <;> simp [mul_apply, Fin.sum_univ_two] <;> ring

/-- `C_p(x) = (a_p − (ψ/η)(p)(−x/p) − 1)/2` (tex 9908), with `κ = (ψ/η)(p)(−x/p)`. -/
def Cp (ap κ : ℤ) : ℤ := (ap - κ - 1) / 2

/-- **PROVED (tex 9924–9925).** If the Legendre signs at `p` of `vr₀, vr₁` are opposite
(`κ₁ = −κ₀ = ∓1`) and `a_p` is even, then `C_p(vr₀) + C_p(vr₁) = a_p − 1` is odd: `c_p(vr₀) +
c_p(vr₁) = 1` in `𝔽₂`. -/
theorem cp_sum_odd {ap κ₀ : ℤ} (hap : Even ap) (hκ : κ₀ = 1 ∨ κ₀ = -1) :
    Cp ap κ₀ + Cp ap (-κ₀) = ap - 1 ∧ Odd (Cp ap κ₀ + Cp ap (-κ₀)) := by
  obtain ⟨e, rfl⟩ := hap
  rcases hκ with rfl | rfl
  · refine ⟨?_, ?_⟩ <;> simp only [Cp]
    · omega
    · exact ⟨e - 1, by omega⟩
  · refine ⟨?_, ?_⟩ <;> simp only [Cp]
    · omega
    · exact ⟨e - 1, by omega⟩

/-- **PROVED (tex 9919–9931).** The omission rule in `𝔽₂`. Hypotheses (all at the chosen stage,
after the integral divisions):
* `hO12`: (O.12) at coefficient one, read through the fresh-prime Hecke formula and the omission
  coefficient `H_U[pr] ≡ C_p(vr) 𝒜_V(vr)`: `c₁ 𝒜_V(vr₁) − c₀ 𝒜_V(vr₀) = 𝒜_U(Uq_τ) − 𝒜_U(Uq)`
  (`d(φ)` acting trivially on the reduced trace orbit);
* `hV`: the two `V` symbols agree (the omitted form's level omits the whole prime `p`);
* `hc`: `c_p(vr₀) + c_p(vr₁) = 1` (`cp_sum_odd`).
Then `𝒜_U(Uq_τ) + 𝒜_U(Uq) = 𝒜_V(Vr₀)`. -/
theorem omission_rule (AUq AUqτ AVr0 AVr1 c0 c1 : ZMod 2)
    (hO12 : c1 * AVr1 - c0 * AVr0 = AUqτ - AUq) (hV : AVr0 = AVr1) (hc : c0 + c1 = 1) :
    AUqτ + AUq = AVr0 := by
  subst hV
  revert AUq AUqτ AVr0 c0 c1
  decide

end ZInQ.Manuscript.RC.Odd
