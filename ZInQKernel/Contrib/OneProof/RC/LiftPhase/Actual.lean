import ZInQKernel.Contrib.OneProof.RC.LiftPhase.Pool
import ZInQKernel.Contrib.OneProof.RC.ThetaClose.Assembly
import ZInQKernel.Contrib.OneProof.RC.OldStageLaw.Stage

/-! The characteristic-zero phase on the very stage of Appendix F, used
unchanged by the pool (tex 8982–8985, 9083–9089 and 9706–9710). -/

noncomputable section

namespace ZInQ.Manuscript.RC.LiftPhase

open ThetaClose ThetaJoin ThetaCoeff BlocksPerU WeilIndex
open ZInQ.Contrib.CloudB3RC53.CoefficientDictionary

variable {ell N M m : ℕ} [Fact ell.Prime]
variable (h : ell % 4 = 3) (hN : 0 < N) (hcop : N.Coprime ell)
variable (H : DiscriminantData m N ell) (w : ℕ → ℤˣ)
variable {K : Type*} [Field K] [Algebra (ZMod ell) K] [DecidableEq K] [IsSepClosed K]
variable {Ebar : WeierstrassCurve (ZMod ell)} [Ebar.IsElliptic] {ap : ℕ → ℤ}
variable (G : PM.Geometry K (levelRing h hN) N Ebar ap) (d : PM.Evaluation K Ebar M) (L : ℕ)

/-- The manuscript product reduces to the existing Appendix F phase at the
full precision `2^M`, including the stage's zero extension. -/
theorem actualEta_reduce (n : ℕ) :
    stageReduction (Coefficients hN H w) M
      (etaSource (levelRoots hN H w) (exceptionalProduct_ne_zero hN H) n) =
      (actualLevelStage h hN hcop H w G d L).η n :=
  congrArg (stageReduction (Coefficients hN H w) M)
    (etaSource_eq _ _ H.odd H.squarefree hcop (discriminantDisjoint H) n)

/-- Use the constructed phase in the existing valuation lift on the same
actual stage, keeping the same weights, coefficient lift and unary parity. -/
def actualLift : Lift (actualLevelStage h hN hcop H w G d L) :=
  { actualLevelValLift h hN hcop H w G d L with
    η := etaSource (levelRoots hN H w) (exceptionalProduct_ne_zero hN H)
    phase := actualEta_reduce h hN hcop H w G d L }

/-- The lift supplies `hphase` on the good primes of this stage. On a
typed good domain, precompose with the existing inclusion into stage goods. -/
theorem actualLift_order {p : ℕ} (hp : (actualLevelStage h hN hcop H w G d L).Good p) :
    ∃ e : ℕ, (actualLift h hN hcop H w G d L).η p ^ (2 ^ e : ℕ) = 1 := by
  let C := levelRoots hN H w
  let hn := exceptionalProduct_ne_zero hN H
  let A := schwartzPhase C m hn
  change p.Prime ∧ p ∉ A.support at hp
  change ∃ e : ℕ, etaSource C hn p ^ (2 ^ e : ℕ) = 1
  rw [etaSource_eq C hn H.odd H.squarefree hcop (discriminantDisjoint H)]
  exact ⟨_, eta_order_of_away C hn (A.away_of_not_mem ⟨p, hp.1⟩ hp.2)⟩

/-- The embedding of the field generated by the actual root values. -/
def coefficientEmbedding : CharacterField hN H w →+* ℂ :=
  (CharacterField hN H w).val.toRingHom

omit [Fact ell.Prime] in
private theorem extractionNonzero (H : DiscriminantData m N ell) : NeZero m :=
  ⟨by have := H.odd; omega⟩

/-- The old character on the same actual local scalars, with the determinant
of the extracted ternary form. All scalars use the same embedding. -/
def actualOldCharacter (ι : Coefficients hN H w →+* ℂ) {D₀ : ℕ}
    (h4 : 4 ∣ D₀) (hm : m ∣ D₀) (he : ell ∣ D₀)
    (hlevel : ∀ q : Adelic.Prime, q.val ∣ N → q.val ∣ D₀) : (ZMod D₀)ˣ →* ℂˣ :=
  letI := extractionNonzero H
  oldCharacter h4 hm Finset.univ
    (fun q : Places m N ell (exceptionalProduct_ne_zero hN H) => rootModulus q.val)
    (residueModuli_dvd (exceptionalProduct_ne_zero hN H) h4 hm he hlevel)
    (fun q => (Units.map ι).comp (residueAlpha (ell := ell) (m := m) (levelRoots hN H w) q.val))

variable {J : Type} [AddCommGroup J] {ε : J →+ ZMod 2} {T : TypeData J ε}
variable {avoid : Finset ℕ} {W D : ℕ} [NeZero D]
variable {P : Window T.Good (actualLevelStage h hN hcop H w G d L) W}
variable (Dₗ : LevelSetup P avoid D)
variable (hm : m ∣ Dₗ.old) (he : ell ∣ Dₗ.old)
variable (hlevel : ∀ q : Adelic.Prime, q.val ∣ N → q.val ∣ Dₗ.old)

/-- Pool diamonds use the same characteristic-zero phase and its proved
two-power order. -/
def actualDiamonds : DiamondCharacters (Coefficients hN H w) (ZMod D)ˣ
    (actualLift h hN hcop H w G d L).η :=
  let hc (q : Places m N ell (exceptionalProduct_ne_zero hN H)) :=
    (residueModuli_dvd (exceptionalProduct_ne_zero hN H) Dₗ.four_dvd hm he hlevel q).trans
      Dₗ.old_dvd
  diamondCharacters Dₗ.common_four
    (poolPhase (levelRoots hN H w) (exceptionalProduct_ne_zero hN H) Dₗ.common_four hc)
    (fun u => (poolPhase_eval _ _ Dₗ.common_four (hm.trans Dₗ.old_dvd) H.odd hc u).trans
        (etaSource_eq _ _ H.odd H.squarefree hcop (discriminantDisjoint H) _).symm)
    (poolPhase_order _ _ Dₗ.common_four (hm.trans Dₗ.old_dvd) H.odd hc)

variable {F : Type} [Field F] [Algebra (Coefficients hN H w) F] (κ : F →+* ℂ)

/-- The precise `hchar` of `oldStageLaw_of_finiteAction` on the actual stage
and its empty moving-sieve block. -/
theorem actual_hchar :
    (actualOldCharacter hN H w (κ.comp (algebraMap (Coefficients hN H w) F))
      Dₗ.four_dvd hm he hlevel).comp (ZMod.unitsMap Dₗ.old_dvd) =
      (Units.map κ).comp
        (bCharacter (K := F)
          (actualDiamonds h hN hcop H w G d L Dₗ hm he hlevel) ∅) := by
  let : NeZero (actualLevelStage h hN hcop H w G d L).m := extractionNonzero H
  exact PoolCharacter.oldCharacter_comp_eq_bCharacter_of_phase
    κ Dₗ (actualLift h hN hcop H w G d L) hm H.odd
    Finset.univ (fun q : Places m N ell (exceptionalProduct_ne_zero hN H) => rootModulus q.val)
    (residueModuli_dvd (exceptionalProduct_ne_zero hN H) Dₗ.four_dvd hm he hlevel)
    (fun q => residueAlpha (ell := ell) (m := m) (levelRoots hN H w) q.val)
    (actualDiamonds h hN hcop H w G d L Dₗ hm he hlevel).η_eval
    (actualDiamonds h hN hcop H w G d L Dₗ hm he hlevel).phase_order

open OldStageLaw in
/-- Apply the existing law with its grid and finite action inputs left in
their original form and the character comparison supplied here. -/
theorem actualOldStageLaw {a : Fin 3 → ℕ} [∀ i, NeZero (2 * a i)] {step : ℚ}
    (grid : StageGrid (actualLift h hN hcop H w G d L) a step)
    (action : RelativeFiniteAction
      (actualOldCharacter hN H w (κ.comp (algebraMap (Coefficients hN H w) F))
        Dₗ.four_dvd hm he hlevel)
      (stageGridWeight (actualLift h hN hcop H w G d L)
        (κ.comp (algebraMap (Coefficients hN H w) F)) a step)) :
    OldStageLaw κ Dₗ
      (actualDiamonds h hN hcop H w G d L Dₗ hm he hlevel) :=
  oldStageLaw_of_finiteAction _ Dₗ _ grid _
    (actual_hchar h hN hcop H w G d L Dₗ hm he hlevel κ) action


end ZInQ.Manuscript.RC.LiftPhase
