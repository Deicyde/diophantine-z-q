import ZInQKernel.Contrib.OneProof.RC.WitnessSpec.RingClass
import ZInQKernel.Contrib.CloudB3RC53.GenusOdd.SqrtDiscr
import Mathlib.NumberTheory.LegendreSymbol.Basic

/-! The inert sign forces degree two at the contracted quadratic prime.
This is the ideal calculation behind residue descent, given here. -/

noncomputable section

open NumberField IsDedekindDomain TauCeti
open ZInQ.Contrib.CloudB3RC53.GenusOdd
open scoped NumberField

namespace ZInQ.Manuscript.RC.WitnessSpec

/-- At a quadratic prime of negative Legendre sign, the
prime is generated by the rational prime and has residue degree two. -/
theorem inertPrime_of_legendre {K : Type} [Field K] [NumberField K]
    (hK : Module.finrank ℚ K = 2)
    (v : HeightOneSpectrum (𝓞 K)) {p : ℕ} (hp : rationalPrimeBelow v = p)
    (hD : ¬ (p : ℤ) ∣ discr K) (hsign : letI : Fact p.Prime := ⟨hp ▸ prime_rationalPrimeBelow v⟩
      legendreSym p (discr K) = -1) :
    v.asIdeal = Ideal.span {(p : 𝓞 K)} ∧ v.asIdeal.inertiaDeg ℤ = 2 := by
  have hprime : p.Prime := hp ▸ prime_rationalPrimeBelow v
  let : Fact p.Prime := ⟨hprime⟩
  have hn := absNorm_eq_rationalPrimeBelow_pow v
  rw [hp] at hn
  have hdiv := v.absNorm_dvd_rationalPrimeBelow_pow_finrank
  rw [hn, hp, hK] at hdiv
  have hle : v.asIdeal.inertiaDeg ℤ ≤ 2 :=
    (Nat.pow_le_pow_iff_right hprime.one_lt).mp (Nat.le_of_dvd (pow_pos hprime.pos _) hdiv)
  have hne : v.asIdeal.inertiaDeg ℤ ≠ 1 := by
    intro h1
    have hN : Ideal.absNorm v.asIdeal = p := by rwa [h1, pow_one] at hn
    obtain ⟨s, hs⟩ := exists_sq_eq_discr hK
    let t : 𝓞 K := ⟨s, IsIntegral.of_pow (n := 2) (by decide)
      (by rw [hs, ← eq_intCast (algebraMap ℤ K)]; exact isIntegral_algebraMap)⟩
    have ht : t ^ 2 = (discr K : 𝓞 K) := by
      apply RingOfIntegers.ext
      push_cast
      exact hs
    let k := 𝓞 K ⧸ v.asIdeal
    let : Fintype k := Fintype.ofFinite k
    let q : 𝓞 K →+* k := Ideal.Quotient.mk v.asIdeal
    let e := (ZMod.ringEquivOfPrime k hprime (by rw [← Nat.card_eq_fintype_card]; exact hN)).symm
    have hz : (discr K : ZMod p) ≠ 0 := by
      rwa [ne_eq, ZMod.intCast_zmod_eq_zero_iff_dvd]
    have h := (legendreSym.eq_one_iff p hz).mpr
      ⟨e (q t), by simpa only [pow_two, map_mul, map_intCast] using
        (congrArg (fun z => e (q z)) ht).symm⟩
    change legendreSym p (discr K) = -1 at hsign
    rw [hsign] at h
    norm_num at h
  have hpos := Ideal.inertiaDeg_pos v.asIdeal ℤ
  have hf : v.asIdeal.inertiaDeg ℤ = 2 := by omega
  refine ⟨?_, hf⟩
  rw [← hp]
  apply asIdeal_eq_span_singleton_of_absNorm_eq_pow_finrank
  rw [hn, hp, hf, hK]


end ZInQ.Manuscript.RC.WitnessSpec
