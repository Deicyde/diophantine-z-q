import Mathlib

/-!
# Theorem 5.3, Lane RC11-even: the residual positive complex (E.3) and the wedge (E.4)

The 11/5 manuscript (`diophantine_zq.tex`), Section 7.1 (tex 1912–1940) and Appendix E, proof of
Proposition `ex:app-even-scalar` (tex 7429–7543). This file proves the finite algebra of that
proof:

* `card_le_two_of_zpowers_sup_commutator` — the group theory of the inductive vanishing of the
  two-class group of `K_n = ℚ(ζ_{2^{n+2}})⁺` (tex 7435–7446): a finite `2`-group whose
  abelianization is generated by the image of an element of order at most two (the dyadic inertia)
  is cyclic of order at most two (its Frattini quotient has one generator);
* `negCount_eq`, `negCount_odd`, `conj_neg_iff`, `conj_ne_zero`, `prod_conj_neg` — the unit
  `u = 1 + ζ + ζ⁻¹`: its real conjugates `1 + 2cos(2πa/2^m)` (odd `0 < a < 2^{m−1}`) are negative
  exactly for `2^m/3 < a`, their number `2^{m−2} − ⌊2^{m−1}/3 + 1/2⌋` is odd, so the product of the
  conjugates is negative and `N(u) = −1` (tex 7448–7461);
* `isUnit_of_augmentation_eq_one` — an element of augmentation one in `𝔽₂[G]` (`G` a finite abelian
  `2`-group, here `Gal(K_n/ℚ)`) is a unit (tex 7462–7464);
* `finrank_H1_positive`, `finrank_H2_positive`, `finrank_sumZero`, `proj_real_surjective`,
  `finrank_ker_proj_real` — `dim H¹(C_n⁺) = 2^n + s_n − 1`, `dim H²(C_n⁺) = s_n − 1` from the long
  exact sequence of the positive cone (tex 7466–7484);
* `generic_rank_one`, `generic_rank_zero` — a free generator contributes `2^n`, bounded torsion a
  bounded amount: generic rank one in degree one, zero in degree two (tex 7486–7496);
* `minimal_residue_eq_zero` — a minimal finite free model has zero residual differential
  (tex 7500–7507), so the ranks are the residual dimensions and `C⁺ ⊗ B ≃ B²[−1]` (E.3);
* `exists_lift_two_smul`, `wedge_lift_indep`, `E4_eq_two_wedge` — twice an ordinary class lifts
  because real `H¹` is killed by two; the wedge does not depend on the positive lift; and
  `u^{ev}θ = 2^{−c_E} a ∧ b = 2a ∧ z̃` (tex 7516–7543).

Everything here is PROVED.
-/

namespace ZInQ.Manuscript.RC.Even

open Module

/-! ## The two-class group of the real cyclotomic tower (tex 7435–7446) -/

/-- In a finite `p`-group, every maximal subgroup contains the commutator subgroup. -/
private theorem commutator_le_of_isCoatom_of_isPGroup {G : Type*} [Group G] [Finite G] {p : ℕ}
    [Fact p.Prime] (hG : IsPGroup p G) {M : Subgroup G} (hM : IsCoatom M) :
    commutator G ≤ M := by
  have := hG.isNilpotent
  have hMn : M.Normal := Subgroup.NormalizerCondition.normal_of_coatom M
    Group.normalizerCondition_of_isNilpotent hM
  have hidx : M.index.Prime := (Subgroup.isCoatom_iff_index_prime M).mp hM
  have hcard : Nat.card (G ⧸ M) = M.index := (Subgroup.index_eq_card M).symm
  have : Fact (Nat.card (G ⧸ M)).Prime := ⟨hcard ▸ hidx⟩
  have : IsCyclic (G ⧸ M) := isCyclic_of_prime_card rfl
  rw [← Subgroup.Normal.quotient_commutative_iff_commutator_le]
  infer_instance

/-- In a finite `p`-group, the commutator subgroup is contained in the Frattini subgroup. -/
private theorem commutator_le_frattini_of_isPGroup {G : Type*} [Group G] [Finite G] {p : ℕ}
    [Fact p.Prime] (hG : IsPGroup p G) :
    commutator G ≤ frattini G := by
  unfold frattini Order.radical
  exact le_iInf₂ fun M hM => commutator_le_of_isCoatom_of_isPGroup hG hM

/-- **The group-theoretic step of the induction** (tex 7440–7445; PROVED). Let `G = Gal(H/K_{n−1})`
be a finite `2`-group and `x` a generator of the dyadic inertia, `x² = 1`. If the quotient of
`G^{ab}` by the image of the inertia is trivial (`⟨x⟩ [G, G] = G`), then `G` is cyclic of order at
most two. -/
theorem card_le_two_of_zpowers_sup_commutator {G : Type*} [Group G] [Finite G]
    (hG : IsPGroup 2 G) (x : G) (hx : x ^ 2 = 1)
    (hgen : Subgroup.zpowers x ⊔ commutator G = ⊤) : Nat.card G ≤ 2 := by
  have h1 : Subgroup.zpowers x ⊔ frattini G = ⊤ := by
    rw [eq_top_iff, ← hgen]
    exact sup_le_sup_left (commutator_le_frattini_of_isPGroup hG) _
  have h2 : Subgroup.zpowers x = ⊤ := frattini_nongenerating h1
  have h3 : Nat.card G = orderOf x := by
    rw [← Nat.card_zpowers, h2, Subgroup.card_top]
  rw [h3]
  exact orderOf_le_of_pow_eq_one (by norm_num) hx

/-! ## The unit `1 + ζ + ζ⁻¹` (tex 7448–7464) -/

/-- The number of odd `a`, `0 < a < 2^{m−1}`, with `2^m < 3a`: the negative real conjugates
`1 + 2cos(2πa/2^m)` of `u = 1 + ζ + ζ⁻¹`, `ζ = ζ_{2^m}`. -/
def negCount (m : ℕ) : ℕ :=
  ((Finset.range (2 ^ (m - 1))).filter (fun a => a % 2 = 1 ∧ 2 ^ m < 3 * a)).card

/-- Counting formula: among the `n / 2` odd numbers below `n`, those `a` with `3a ≤ N` are the
first `min (n / 2) ((N + 3) / 6)` of them; the rest satisfy `N < 3a`. -/
private theorem card_filter_odd_lt_three_mul (n N : ℕ) :
    ((Finset.range n).filter (fun a => a % 2 = 1 ∧ N < 3 * a)).card
      + min (n / 2) ((N + 3) / 6) = n / 2 := by
  induction n with
  | zero => simp
  | succ n ih =>
    rw [Finset.range_add_one, Finset.filter_insert]
    split_ifs with h
    · rw [Finset.card_insert_of_notMem (by simp)]
      omega
    · omega

/-- `2^m = 4 · 2^(m-2)` for `m ≥ 2`. -/
private theorem two_pow_eq_four_mul {m : ℕ} (hm : 2 ≤ m) : 2 ^ m = 4 * 2 ^ (m - 2) := by
  rw [show (4 : ℕ) = 2 ^ 2 by norm_num, ← pow_add]
  congr 1
  omega

/-- `2^(m-1) = 2 · 2^(m-2)` for `m ≥ 2`. -/
private theorem two_pow_pred_eq_two_mul {m : ℕ} (hm : 2 ≤ m) :
    2 ^ (m - 1) = 2 * 2 ^ (m - 2) := by
  rw [← pow_succ']
  congr 1
  omega

/-- The powers `2^(j+1)` are congruent to `2`, `4` or `8` modulo `12`. -/
private theorem two_pow_succ_mod_twelve (j : ℕ) :
    2 ^ (j + 1) % 12 = 2 ∨ 2 ^ (j + 1) % 12 = 4 ∨ 2 ^ (j + 1) % 12 = 8 := by
  induction j with
  | zero => norm_num
  | succ j ih =>
    rw [pow_succ]
    omega

/-- **The count** (tex 7457–7460; PROVED): for `m ≥ 3`, `negCount m = 2^{m−2} − ⌊2^{m−1}/3 + 1/2⌋`,
with `⌊2^{m−1}/3 + 1/2⌋ = ⌊(2^m + 3)/6⌋`. -/
theorem negCount_eq {m : ℕ} (hm : 3 ≤ m) : negCount m = 2 ^ (m - 2) - (2 ^ m + 3) / 6 := by
  have h : negCount m + min (2 ^ (m - 1) / 2) ((2 ^ m + 3) / 6) = 2 ^ (m - 1) / 2 :=
    card_filter_odd_lt_three_mul (2 ^ (m - 1)) (2 ^ m)
  have h1 := two_pow_pred_eq_two_mul (m := m) (by omega)
  have h2 := two_pow_eq_four_mul (m := m) (by omega)
  omega

/-- **The count is odd** (tex 7460–7461: "an odd integer"; PROVED for every `m ≥ 3`). -/
theorem negCount_odd {m : ℕ} (hm : 3 ≤ m) : Odd (negCount m) := by
  rw [negCount_eq hm, Nat.odd_iff]
  have h2 := two_pow_eq_four_mul (m := m) (by omega)
  have h3 := two_pow_succ_mod_twelve (m - 3)
  rw [show m - 3 + 1 = m - 2 by omega] at h3
  omega

/-- `cos (2π/3) = -1/2`. -/
private theorem trig_cos_two_pi_div_three : Real.cos (2 * Real.pi / 3) = -1 / 2 := by
  have h : 2 * Real.pi / 3 = Real.pi - Real.pi / 3 := by ring
  rw [h, Real.cos_pi_sub, Real.cos_pi_div_three]
  norm_num

/-- The angle `2π/3` lies in `[0, π]`. -/
private theorem trig_two_pi_div_three_mem_Icc : 2 * Real.pi / 3 ∈ Set.Icc 0 Real.pi := by
  constructor <;> linarith [Real.pi_pos]

/-- For `1 ≤ m` and `a < 2^(m-1)`, the angle `2πa/2^m` lies in `[0, π]`. -/
private theorem trig_angle_mem_Icc {m a : ℕ} (hm : 1 ≤ m) (ha' : a < 2 ^ (m - 1)) :
    2 * Real.pi * a / 2 ^ m ∈ Set.Icc 0 Real.pi := by
  have hpow : (2 : ℝ) ^ m = 2 * 2 ^ (m - 1) := by
    rw [← pow_succ']
    congr 1
    omega
  have hacast : (a : ℝ) < 2 ^ (m - 1) := by exact_mod_cast ha'
  have h2pos : (0 : ℝ) < 2 ^ (m - 1) := by positivity
  constructor
  · positivity
  · rw [div_le_iff₀ (by positivity), hpow]
    nlinarith [Real.pi_pos]

/-- A finite product of negative reals over a finset of odd cardinality is negative. -/
private theorem trig_prod_neg_of_odd_card {ι : Type*} (s : Finset ι) (f : ι → ℝ)
    (hf : ∀ i ∈ s, f i < 0) (hs : Odd s.card) : ∏ i ∈ s, f i < 0 := by
  have h1 : ∏ i ∈ s, f i = ∏ i ∈ s, -(-f i) := by simp
  rw [h1, Finset.prod_neg, hs.neg_one_pow, neg_one_mul, neg_lt_zero]
  exact Finset.prod_pos fun i hi => neg_pos.mpr (hf i hi)

/-- **Which conjugates are negative** (tex 7456–7457; PROVED): for odd `a` with
`0 < a < 2^{m−1}`, `1 + 2cos(2πa/2^m) < 0 ↔ 2^m < 3a`. -/
theorem conj_neg_iff {m a : ℕ} (hm : 3 ≤ m) (ha : a % 2 = 1) (ha' : a < 2 ^ (m - 1)) :
    1 + 2 * Real.cos (2 * Real.pi * a / 2 ^ m) < 0 ↔ 2 ^ m < 3 * a := by
  have _ := ha  -- the parity of `a` is not needed here
  have hmem := trig_angle_mem_Icc (by omega) ha'
  have key : 1 + 2 * Real.cos (2 * Real.pi * a / 2 ^ m) < 0 ↔
      Real.cos (2 * Real.pi * a / 2 ^ m) < Real.cos (2 * Real.pi / 3) := by
    rw [trig_cos_two_pi_div_three]
    constructor <;> intro h <;> linarith
  rw [key, Real.strictAntiOn_cos.lt_iff_gt hmem trig_two_pi_div_three_mem_Icc,
    div_lt_div_iff₀ (by norm_num) (by positivity)]
  have hcast : ((2 : ℝ) ^ m < 3 * (a : ℝ)) ↔ 2 ^ m < 3 * a := by norm_cast
  rw [← hcast]
  constructor <;> intro h <;> nlinarith [Real.pi_pos]

/-- No real conjugate vanishes (PROVED): `2πa/2^m ≠ 2π/3`. -/
theorem conj_ne_zero {m a : ℕ} (hm : 3 ≤ m) (ha : a % 2 = 1) (ha' : a < 2 ^ (m - 1)) :
    1 + 2 * Real.cos (2 * Real.pi * a / 2 ^ m) ≠ 0 := by
  have _ := ha  -- the parity of `a` is not needed here
  intro h
  have hmem := trig_angle_mem_Icc (by omega) ha'
  have hcos : Real.cos (2 * Real.pi * a / 2 ^ m) = Real.cos (2 * Real.pi / 3) := by
    rw [trig_cos_two_pi_div_three]
    linarith
  have heq := Real.injOn_cos hmem trig_two_pi_div_three_mem_Icc hcos
  rw [div_eq_div_iff (by positivity) (by norm_num)] at heq
  have hpi : (2 * Real.pi) ≠ 0 := by positivity
  have hreal : (3 * (a : ℝ)) = 2 ^ m :=
    mul_left_cancel₀ hpi (by linear_combination heq)
  have hnat : 3 * a = 2 ^ m := by exact_mod_cast hreal
  have h3 : 3 ∣ 2 ^ m := ⟨a, hnat.symm⟩
  have := Nat.Prime.dvd_of_dvd_pow Nat.prime_three h3
  omega

/-- **`N_{K_n/ℚ}(u) = −1`, in sign** (tex 7461; PROVED): the product of the `2^{m−2}` real
conjugates `1 + 2cos(2πa/2^m)`, odd `0 < a < 2^{m−1}`, is negative (an odd number of negative
factors, none zero). The identification of this product with the norm is the standard description
of the real embeddings of `ℚ(ζ_{2^m})⁺` (GLUE). -/
theorem prod_conj_neg {m : ℕ} (hm : 3 ≤ m) :
    ∏ a ∈ (Finset.range (2 ^ (m - 1))).filter (fun a => a % 2 = 1),
      (1 + 2 * Real.cos (2 * Real.pi * a / 2 ^ m)) < 0 := by
  rw [← Finset.prod_filter_mul_prod_filter_not _ (fun a => 2 ^ m < 3 * a)]
  apply mul_neg_of_neg_of_pos
  · rw [Finset.filter_filter]
    apply trig_prod_neg_of_odd_card
    · intro a ha
      simp only [Finset.mem_filter, Finset.mem_range] at ha
      exact (conj_neg_iff hm ha.2.1 ha.1).2 ha.2.2
    · exact negCount_odd hm
  · apply Finset.prod_pos
    intro a ha
    simp only [Finset.mem_filter, Finset.mem_range] at ha
    have h1 := conj_neg_iff hm ha.1.2 ha.1.1
    have h2 := conj_ne_zero hm ha.1.2 ha.1.1
    have hnn : 0 ≤ 1 + 2 * Real.cos (2 * Real.pi * a / 2 ^ m) :=
      not_lt.mp fun h => ha.2 (h1.1 h)
    exact lt_of_le_of_ne hnn (Ne.symm h2)

/-- The group algebra `MonoidAlgebra (ZMod 2) G` has characteristic two. -/
private theorem charP_monoidAlgebra_zmod_two (G : Type*) [CommGroup G] :
    CharP (MonoidAlgebra (ZMod 2) G) 2 := by
  refine charP_of_injective_algebraMap (R := ZMod 2) ?_ 2
  intro a b h
  simpa [MonoidAlgebra.coe_algebraMap] using h

/-- In the group algebra over `ZMod 2` of a group of exponent dividing `2 ^ n`, the `2 ^ n`-th
power of any element is the scalar given by its augmentation. -/
private theorem pow_two_pow_eq_algebraMap_augmentation {G : Type*} [CommGroup G] {n : ℕ}
    (hexp : ∀ g : G, g ^ (2 ^ n) = 1) (x : MonoidAlgebra (ZMod 2) G) :
    x ^ (2 ^ n) = algebraMap (ZMod 2) (MonoidAlgebra (ZMod 2) G)
      (MonoidAlgebra.lift (ZMod 2) (ZMod 2) G 1 x) := by
  have := charP_monoidAlgebra_zmod_two G
  induction x using MonoidAlgebra.induction_linear with
  | zero => simp
  | add x y hx hy => rw [add_pow_char_pow, hx, hy, map_add, map_add]
  | single g c =>
    rw [MonoidAlgebra.single_pow, hexp g, MonoidAlgebra.lift_single]
    simp [MonoidAlgebra.coe_algebraMap]

/-- **Augmentation one is a unit in `𝔽₂[G]`** (tex 7462–7464; PROVED): for a finite abelian group
`G` of exponent dividing `2^n`, the augmentation ideal of `𝔽₂[G]` is nil, so an element of
augmentation one (the signature vector of `u`) is a unit. -/
theorem isUnit_of_augmentation_eq_one {G : Type*} [CommGroup G] {n : ℕ}
    (hexp : ∀ g : G, g ^ (2 ^ n) = 1) (x : MonoidAlgebra (ZMod 2) G)
    (hx : MonoidAlgebra.lift (ZMod 2) (ZMod 2) G 1 x = 1) : IsUnit x := by
  refine IsUnit.of_pow_eq_one (n := 2 ^ n) ?_ (pow_ne_zero _ two_ne_zero)
  rw [pow_two_pow_eq_algebraMap_augmentation hexp x, hx, map_one]

/-! ## The dimensions of the residual positive complex (tex 7466–7484) -/

/-- **`dim H¹(C_n⁺) = r_n + s_n − 1`** (tex 7466–7471; PROVED), from the exact sequence
`0 → H⁰_glob →diag ⊕_{real} H⁰ → H¹(C⁺) → H¹_glob →sig ⊕_{real} H¹` with the diagonal injective,
`dim H⁰_glob = 1`, `dim ⊕_{real} H⁰ = r`, `dim H¹_glob = r + s` (Kummer theory with trivial
two-class group) and `sig` onto (unit signatures span). -/
theorem finrank_H1_positive {K : Type*} [Field K] {H0g HR P H1g HR1 : Type*} [AddCommGroup H0g]
    [Module K H0g] [AddCommGroup HR] [Module K HR] [AddCommGroup P] [Module K P]
    [AddCommGroup H1g] [Module K H1g] [AddCommGroup HR1] [Module K HR1]
    [FiniteDimensional K H0g] [FiniteDimensional K HR] [FiniteDimensional K H1g]
    [FiniteDimensional K HR1]
    (diag : H0g →ₗ[K] HR) (δ : HR →ₗ[K] P) (ι : P →ₗ[K] H1g) (sig : H1g →ₗ[K] HR1)
    (hdiag : Function.Injective diag) (h1 : Function.Exact diag δ) (h2 : Function.Exact δ ι)
    (h3 : Function.Exact ι sig) (hsig : Function.Surjective sig) {r s : ℕ}
    (hH0 : finrank K H0g = 1) (hHR : finrank K HR = r) (hHR1 : finrank K HR1 = r)
    (hH1 : finrank K H1g = r + s) : FiniteDimensional K P ∧ finrank K P + 1 = r + s := by
  rw [LinearMap.exact_iff] at h1 h2 h3
  have hkerι : FiniteDimensional K (LinearMap.ker ι) := by
    rw [h2]; infer_instance
  have hP : FiniteDimensional K P := by
    have : FiniteDimensional K (Submodule.comap ι ⊤) := inferInstance
    rw [Submodule.comap_top] at this
    exact LinearEquiv.finiteDimensional (Submodule.topEquiv)
  refine ⟨hP, ?_⟩
  have e1 := LinearMap.finrank_range_add_finrank_ker ι
  have e2 := LinearMap.finrank_range_add_finrank_ker δ
  have e3 := LinearMap.finrank_range_add_finrank_ker sig
  have e4 := LinearMap.finrank_range_of_inj hdiag
  rw [h2] at e1
  rw [h1] at e2
  rw [h3, LinearMap.range_eq_top.mpr hsig, finrank_top] at e3
  omega

/-- **`dim H²(C_n⁺) = s_n − 1`** (tex 7472–7482; PROVED), from
`H¹_glob →sig ⊕_{real} H¹ →δ₂ H²(C⁺) →ι₂ H²_glob →res ⊕_{real} H²` exact, `sig` onto, `res` onto
(because `s ≥ 1`), `dim H²_glob = r + s − 1` and `dim ⊕_{real} H² = r`. -/
theorem finrank_H2_positive {K : Type*} [Field K] {H1g HR1 P2 H2g HR2 : Type*} [AddCommGroup H1g]
    [Module K H1g] [AddCommGroup HR1] [Module K HR1] [AddCommGroup P2] [Module K P2]
    [AddCommGroup H2g] [Module K H2g] [AddCommGroup HR2] [Module K HR2]
    [FiniteDimensional K H2g] [FiniteDimensional K HR2]
    (sig : H1g →ₗ[K] HR1) (δ₂ : HR1 →ₗ[K] P2) (ι₂ : P2 →ₗ[K] H2g) (res : H2g →ₗ[K] HR2)
    (hsig : Function.Surjective sig) (h1 : Function.Exact sig δ₂) (h2 : Function.Exact δ₂ ι₂)
    (h3 : Function.Exact ι₂ res) (hres : Function.Surjective res) {r s : ℕ}
    (hH2 : finrank K H2g + 1 = r + s) (hHR2 : finrank K HR2 = r) :
    FiniteDimensional K P2 ∧ finrank K P2 + 1 = s := by
  rw [LinearMap.exact_iff] at h1 h2 h3
  have hδ : δ₂ = 0 := by
    rw [← LinearMap.ker_eq_top, h1, LinearMap.range_eq_top.mpr hsig]
  have hinj : Function.Injective ι₂ := by
    rw [← LinearMap.ker_eq_bot, h2, hδ, LinearMap.range_zero]
  have hP : FiniteDimensional K P2 := FiniteDimensional.of_injective ι₂ hinj
  refine ⟨hP, ?_⟩
  have e1 := LinearMap.finrank_range_of_inj hinj
  have e2 := LinearMap.finrank_range_add_finrank_ker res
  rw [← h3] at e1
  rw [LinearMap.range_eq_top.mpr hres, finrank_top] at e2
  omega

/-- The local invariant description of `Br(𝒪_{K_n, S_n})[2]` (tex 7472–7476): `r + s` coordinates
(the real places first) with one sum relation. -/
def sumZero (K : Type*) [Field K] (r s : ℕ) : Submodule K (Fin (r + s) → K) :=
  LinearMap.ker (∑ i : Fin (r + s), LinearMap.proj (R := K) (φ := fun _ => K) i)

/-- The projection of `sumZero K r s` to the `r` real coordinates. -/
def projReal (K : Type*) [Field K] (r s : ℕ) : sumZero K r s →ₗ[K] (Fin r → K) :=
  (LinearMap.funLeft K K (Fin.castAdd s)).comp (sumZero K r s).subtype

/-- `dim Br(𝒪_{K_n,S_n})[2] = r + s − 1` (tex 7474–7475; PROVED), for `r + s ≥ 1`. -/
theorem finrank_sumZero (K : Type*) [Field K] {r s : ℕ} (hrs : 1 ≤ r + s) :
    finrank K (sumZero K r s) + 1 = r + s := by
  set φ := ∑ i : Fin (r + s), LinearMap.proj (R := K) (φ := fun _ => K) i
  have hsurj : Function.Surjective φ := by
    intro c
    refine ⟨Pi.single ⟨0, by omega⟩ c, ?_⟩
    simp [φ]
  have e := LinearMap.finrank_range_add_finrank_ker φ
  rw [LinearMap.range_eq_top.mpr hsurj, finrank_top, Module.finrank_self,
    Module.finrank_fin_fun] at e
  show finrank K (LinearMap.ker φ) + 1 = r + s
  omega

/-- **Projection to the real coordinates is onto because `s ≥ 1`** (tex 7475–7476; PROVED). -/
theorem proj_real_surjective (K : Type*) [Field K] {r s : ℕ} (hs : 1 ≤ s) :
    Function.Surjective (projReal K r s) := by
  intro w
  let u : Fin s → K := Pi.single ⟨0, hs⟩ (-∑ i, w i)
  let v : Fin (r + s) → K := Fin.append w u
  have hv : v ∈ sumZero K r s := by
    simp [sumZero, v, u, Fin.sum_univ_add]
  refine ⟨⟨v, hv⟩, ?_⟩
  ext i
  simp [projReal, v]

/-- **Its kernel has dimension `s − 1`** (tex 7476; PROVED). -/
theorem finrank_ker_proj_real (K : Type*) [Field K] {r s : ℕ} (hs : 1 ≤ s) :
    finrank K (LinearMap.ker (projReal K r s)) + 1 = s := by
  have e1 := LinearMap.finrank_range_add_finrank_ker (projReal K r s)
  rw [LinearMap.range_eq_top.mpr (proj_real_surjective K hs), finrank_top,
    Module.finrank_fin_fun] at e1
  have e2 := finrank_sumZero K (r := r) (s := s) (by omega)
  omega

/-! ## Generic ranks (tex 7486–7496) -/

/-- **Generic rank one in degree one** (tex 7490–7496; PROVED): if the specializations at
`t^{2^n}` have dimension `2^n r + c_n` (a free generator contributes `2^n`, torsion disks and their
Tor terms a bounded `c_n ≤ C`) and this equals `2^n + s_n − 1` with `s_n ≤ S` bounded, then `r = 1`. -/
theorem generic_rank_one {r : ℕ} {c s : ℕ → ℕ} {C S : ℕ} (hc : ∀ n, c n ≤ C) (hs : ∀ n, s n ≤ S)
    (hdim : ∀ n, 2 ^ n * r + c n + 1 = 2 ^ n + s n) : r = 1 := by
  have h := hdim (C + S + 1)
  have hc' := hc (C + S + 1)
  have hs' := hs (C + S + 1)
  have hlt : C + S + 1 < 2 ^ (C + S + 1) := Nat.lt_two_pow_self
  rcases Nat.lt_trichotomy r 1 with hr | hr | hr
  · have hr0 : r = 0 := by omega
    subst hr0
    simp only [mul_zero, zero_add] at h
    omega
  · exact hr
  · have : 2 ^ (C + S + 1) * 2 ≤ 2 ^ (C + S + 1) * r := Nat.mul_le_mul_left _ hr
    omega

/-- **Generic rank zero in degree two** (tex 7495–7496; PROVED): `2^n r + c_n = s_n − 1` with
`c_n`, `s_n` bounded forces `r = 0`. -/
theorem generic_rank_zero {r : ℕ} {c s : ℕ → ℕ} {C S : ℕ} (hc : ∀ n, c n ≤ C) (hs : ∀ n, s n ≤ S)
    (hdim : ∀ n, 2 ^ n * r + c n + 1 = s n) : r = 0 := by
  by_contra hr
  have h := hdim S
  have hc' := hc S
  have hs' := hs S
  have hlt : S < 2 ^ S := Nat.lt_two_pow_self
  have : 2 ^ S ≤ 2 ^ S * r := Nat.le_mul_of_pos_right _ (Nat.pos_of_ne_zero hr)
  omega

/-! ## (E.3): a minimal model has zero residual differential (tex 7500–7507) -/

/-- **A minimal model has zero residual differential** (tex 7502–7504; PROVED): over a local ring
`B` (here `B = 𝒪[G]`, residue field `𝔽₂((t))`), a differential matrix with entries in the maximal
ideal reduces to zero over the residue field; so each residual cohomology dimension is the rank of
the corresponding term, and dimensions `(0, 2, 0, …)` force `C⁺ ⊗ B ≃ B²[−1]` (E.3). -/
theorem minimal_residue_eq_zero {B : Type*} [CommRing B] [IsLocalRing B] {m n : ℕ}
    (A : Matrix (Fin m) (Fin n) B) (hA : ∀ i j, A i j ∈ IsLocalRing.maximalIdeal B) :
    A.map (IsLocalRing.residue B) = 0 := by
  ext i j
  simp [Matrix.map_apply, (IsLocalRing.residue_eq_zero_iff _).mpr (hA i j)]

/-! ## (E.4): the positive lift and the wedge (tex 7516–7543) -/

/-- **Twice an ordinary class lifts** (tex 1938–1939, 7516–7521; PROVED): in an exact sequence
`P →ι H¹_glob →ρ H¹_ℝ` with real `H¹` killed by two, every `2z` has a positive lift. -/
theorem exists_lift_two_smul {R P H1 HR : Type*} [Ring R] [AddCommGroup P] [Module R P]
    [AddCommGroup H1] [Module R H1] [AddCommGroup HR] [Module R HR] (ι : P →ₗ[R] H1)
    (ρ : H1 →ₗ[R] HR) (hex : Function.Exact ι ρ) (h2 : ∀ y : HR, (2 : ℕ) • y = 0) (z : H1) :
    ∃ p, ι p = (2 : ℕ) • z := by
  have h : ρ ((2 : ℕ) • z) = 0 := by rw [map_nsmul, h2]
  exact (hex _).mp h

/-- **The wedge does not depend on the positive lift** (tex 7527–7531; PROVED): two lifts differ
by a multiple of `a`, which wedges to zero with `a`. (`a ∧ b` is the determinant of the coordinate
vectors in a basis of the free rank-two module.) -/
theorem wedge_lift_indep {B : Type*} [CommRing B] (a b : Fin 2 → B) (μ : B) :
    Matrix.det (Matrix.of ![a, b + μ • a]) = Matrix.det (Matrix.of ![a, b]) := by
  simp [Matrix.det_fin_two]
  ring

/-- **`u^{ev}θ = 2^{−c_E} a ∧ b = 2a ∧ z̃`** (tex 7532–7543; PROVED): if the positive lift `b` of
`2^{c_E+1} z` is `2^{c_E+1} z̃ + μa` for a rational lift `z̃` of `z`, the clearing factor `2^{c_E}`
cancels exactly. -/
theorem E4_eq_two_wedge {K : Type*} [Field K] [CharZero K] (a z : Fin 2 → K) (cE : ℕ) (μ : K) :
    ((2 : K) ^ cE)⁻¹ * Matrix.det (Matrix.of ![a, (2 : K) ^ (cE + 1) • z + μ • a]) =
      2 * Matrix.det (Matrix.of ![a, z]) := by
  simp [Matrix.det_fin_two]
  have h2 : (2 : K) ^ cE ≠ 0 := pow_ne_zero _ two_ne_zero
  field_simp
  ring

end ZInQ.Manuscript.RC.Even
