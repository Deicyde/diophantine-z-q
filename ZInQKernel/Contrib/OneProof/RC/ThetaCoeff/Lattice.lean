import ZInQKernel.Contrib.OneProof.RC.ThetaCoeff.Hecke
import ZInQKernel.Contrib.OneProof.RC.TraceLimits.Fourier

/-! The integral module generated by good translates. We use the positive Fourier
expansion of a constituent basis at a common level and set its dummy index zero
to zero. This does not prescribe constant terms of Eisenstein series. -/

noncomputable section

namespace ZInQ.Manuscript.RC.ThetaCoeff

open Finset TraceLimits

variable {I K O G : Type} [Field K] [CommRing O] [Algebra O K] [Group G]
variable {Q : ℕ → Prop}

/-- ELLIOT (tex 9649–9654, 9662, 9762–9767): normalized newform data or a weight-two
Eisenstein character pair. The cusp input is the scalar recursion on the newform. -/
inductive EigenSource (K : Type) [Field K] (Q : ℕ → Prop)
  | cusp (a : ℕ → K) (χ : ℕ → K) (zero : a 0 = 0)
      (rec : ∀ q, Q q → GoodRec a (a q) (χ q) q)
  | eis (α β : ℕ →* K)

def EigenSource.a : EigenSource K Q → ℕ → K
  | .cusp a _ _ _ => a
  | .eis α β => eisenstein α β

def EigenSource.χ : EigenSource K Q → ℕ → K
  | .cusp _ χ _ _ => χ
  | .eis α β => fun q => α q * β q

theorem EigenSource.zero (b : EigenSource K Q) : b.a 0 = 0 := by
  cases b with
  | cusp _ _ h _ => exact h
  | eis _ _ => exact ArithmeticFunction.map_zero (f := eisenstein _ _)

theorem EigenSource.goodRec (b : EigenSource K Q) {q : ℕ} (hq : Q q) (hp : q.Prime) :
    GoodRec b.a (b.a q) (b.χ q) q := by
  cases b with
  | cusp _ _ _ h => exact h q hq
  | eis α β =>
    change GoodRec (eisenstein α β) (eisenstein α β q) (α q * β q) q
    rw [eisenstein_at_prime α β hp]
    exact eisenstein_rec _ _ hp

variable [Fintype I]

/-- ELLIOT (tex 9649–9654, 9663, 9762–9771): the constituent basis at one common level.
Each index records a basis vector, including the degeneracy label. The chosen positive
expansions are independent. The diamond group is the unit group of the common level;
`atPrime` evaluates a prime away from that level in the diamond group. -/
structure Basis (I K G : Type) [Fintype I] [Field K] [Group G] (Q : ℕ → Prop) where
  base : I → EigenSource K Q
  degree : I → ℕ
  degree_pos : ∀ i, 0 < degree i
  prime : ∀ q, Q q → q.Prime
  degree_coprime : ∀ i q, Q q → (degree i).Coprime q
  χ : I → G →* Kˣ
  atPrime : {q // Q q} → G
  χ_good : ∀ i (q : {q // Q q}), (χ i (atPrime q) : K) = (base i).χ q
  independent : Function.Injective fun v : I → K => fun n : ℕ =>
    ∑ i, v i * Odd.divCoeff (base i).a (degree i) n

variable (A : Basis I K G Q)

def Basis.eval (n : ℕ) : (I → K) →ₗ[K] K where
  toFun v := ∑ i, v i * Odd.divCoeff (A.base i).a (A.degree i) n
  map_add' v w := by simp [add_mul, Finset.sum_add_distrib]
  map_smul' c v := by simp [mul_assoc, Finset.mul_sum]

def Basis.coefK : (I → K) →ₗ[K] ({n : ℕ // n ≠ 0} → K) :=
  LinearMap.pi fun n => A.eval n

theorem Basis.eval_zero (v : I → K) : A.eval 0 v = 0 := by
  simp [Basis.eval, Odd.divCoeff, EigenSource.zero]

theorem Basis.coefK_injective : Function.Injective A.coefK := by
  intro v w he
  apply A.independent
  funext n
  rcases eq_or_ne n 0 with rfl | hn
  · exact (A.eval_zero v).trans (A.eval_zero w).symm
  · exact congrFun he ⟨n, hn⟩

/-- Scalar multiplication in each constituent coordinate. -/
def diagonalOp (c : I → K) : (I → K) →ₗ[K] (I → K) where
  toFun v i := c i * v i
  map_add' v w := by funext i; simp [mul_add]
  map_smul' a v := by funext i; simp [mul_left_comm]

@[simp] theorem diagonalOp_apply (c : I → K) (v : I → K) (i : I) :
    diagonalOp c v i = c i * v i := rfl

def Basis.diamond (u : G) : (I → K) →ₗ[K] (I → K) :=
  diagonalOp fun i => (A.χ i u : K)

def Basis.hecke (q : {q // Q q}) : (I → K) →ₗ[K] (I → K) :=
  diagonalOp fun i => (A.base i).a q

theorem Basis.diamond_mul (u v : G) (x : I → K) :
    A.diamond u (A.diamond v x) = A.diamond (u * v) x := by
  funext i
  simp [Basis.diamond, mul_assoc]

theorem Basis.commute (u : G) (q : {q // Q q}) (v : I → K) :
    A.diamond u (A.hecke q v) = A.hecke q (A.diamond u v) := by
  funext i
  simp [Basis.diamond, Basis.hecke, mul_left_comm]

theorem Basis.hecke_eval (q : {q // Q q}) (n : ℕ) (v : I → K) :
    A.eval n (A.hecke q v) =
      A.eval (q.val * n) v + if q.val ∣ n then (q.val : K) * A.eval (n / q.val)
        (A.diamond (A.atPrime q) v) else 0 := by
  classical
  have h (i : I) := ((A.base i).goodRec q.2 (A.prime q q.2)).degeneracy
    (A.prime q q.2).pos (A.degree_pos i) (A.degree_coprime i q q.2) n
  simp only [Basis.eval, Basis.hecke, Basis.diamond, LinearMap.coe_mk, AddHom.coe_mk,
    diagonalOp_apply] at *
  have h' (i : I) :
      (A.base i).a q * v i * Odd.divCoeff (A.base i).a (A.degree i) n =
      v i * (Odd.divCoeff (A.base i).a (A.degree i) (q.val * n) +
        (q.val : K) * (A.χ i (A.atPrime q) : K) *
          Odd.divCoeff (Odd.divCoeff (A.base i).a (A.degree i)) q n) := by
    rw [A.χ_good, ← h]
    ring
  simp_rw [h', mul_add, Finset.sum_add_distrib]
  congr 1
  by_cases hn : q.val ∣ n
  · rw [ite_eq_left hn, Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro i _
    simp only [Odd.divCoeff, ite_eq_left hn]
    ring
  · simp [Odd.divCoeff_of_not_dvd _ hn, hn]

/-- The generating translates, using both the good Hecke action and the diamond action. -/
inductive Translate (seed : Finset ℕ → I → K) : (I → K) → Prop
  | seed (U : Finset ℕ) : Translate seed (seed U)
  | diamond (u : G) {v : I → K} : Translate seed v → Translate seed (A.diamond u v)
  | hecke (q : {q // Q q}) {v : I → K} : Translate seed v → Translate seed (A.hecke q v)

variable (seed : Finset ℕ → I → K)

def Basis.Λ : Submodule O (I → K) := Submodule.span O {v | Translate A seed v}

theorem Basis.mem_seed (U : Finset ℕ) : seed U ∈ A.Λ (O := O) seed :=
  Submodule.subset_span (.seed U)

theorem Basis.diamond_mem (u : G) {v : I → K} (hv : v ∈ A.Λ (O := O) seed) :
    A.diamond u v ∈ A.Λ (O := O) seed := by
  induction hv using Submodule.span_induction with
  | mem x hx => exact Submodule.subset_span (.diamond u hx)
  | zero => simp
  | add x y _ _ hx hy => rw [map_add]; exact Submodule.add_mem _ hx hy
  | smul c x _ hx => rw [← LinearMap.restrictScalars_apply O, map_smul]; exact Submodule.smul_mem _ _ hx

theorem Basis.hecke_mem (q : {q // Q q}) {v : I → K} (hv : v ∈ A.Λ (O := O) seed) :
    A.hecke q v ∈ A.Λ (O := O) seed := by
  induction hv using Submodule.span_induction with
  | mem x hx => exact Submodule.subset_span (.hecke q hx)
  | zero => simp
  | add x y _ _ hx hy => rw [map_add]; exact Submodule.add_mem _ hx hy
  | smul c x _ hx => rw [← LinearMap.restrictScalars_apply O, map_smul]; exact Submodule.smul_mem _ _ hx

def Basis.latDiamond (u : G) : A.Λ (O := O) seed →ₗ[O] A.Λ (O := O) seed :=
  ((A.diamond u).restrictScalars O).restrict (fun _ h => A.diamond_mem seed u h)

def Basis.latHecke (q : {q // Q q}) : A.Λ (O := O) seed →ₗ[O] A.Λ (O := O) seed :=
  ((A.hecke q).restrictScalars O).restrict (fun _ h => A.hecke_mem seed q h)

def integralRange : Submodule O K := LinearMap.range (Algebra.linearMap O K)

/-- Tex 9660–9665: the good formula propagates integrality to the full module of
translates if the diamond translates of the original forms are integral. -/
theorem Basis.integral (hseed : ∀ U u n, A.eval n (A.diamond u (seed U)) ∈ integralRange (O := O))
    (v : A.Λ (O := O) seed) (n : ℕ) : A.eval n v ∈ integralRange (O := O) := by
  have horb (x : I → K) (hx : Translate A seed x) :
      ∀ u n, A.eval n (A.diamond u x) ∈ integralRange (O := O) := by
    induction hx with
    | seed U => exact hseed U
    | diamond u _ ih =>
      intro w n
      rw [A.diamond_mul]
      exact ih (w * u) n
    | hecke q _ ih =>
      intro u n
      rw [A.commute, A.hecke_eval q n]
      refine Submodule.add_mem _ (ih _ _) ?_
      split_ifs
      · rw [A.diamond_mul]
        simpa only [Algebra.smul_def, map_natCast] using
          (integralRange (O := O) (K := K)).smul_mem (q.val : O) (ih (A.atPrime q * u) (n / q.val))
      · exact Submodule.zero_mem _
  have hh : ∀ x ∈ A.Λ (O := O) seed, A.eval n x ∈ integralRange (O := O) := by
    apply Submodule.span_le (p := integralRange.comap ((A.eval n).restrictScalars O)) |>.mpr
    intro x hx
    change A.eval n x ∈ integralRange
    have he : A.diamond 1 x = x := by funext i; simp [Basis.diamond]
    rw [← he]
    exact horb x hx 1 n
  exact hh v v.2

variable (hinj : Function.Injective (algebraMap O K))
variable (hseed : ∀ U u n, A.eval n (A.diamond u (seed U)) ∈ integralRange (O := O))

/-- The integral restriction of the characteristic-zero Fourier coefficient. -/
def Basis.coeff (n : ℕ) : A.Λ (O := O) seed →ₗ[O] O :=
  (LinearEquiv.ofInjective (Algebra.linearMap O K) hinj).symm.toLinearMap.comp
    (((A.eval n).restrictScalars O).comp (A.Λ seed).subtype |>.codRestrict
      integralRange (fun v => A.integral seed hseed v n))

theorem Basis.coeff_spec (n : ℕ) (v : A.Λ (O := O) seed) :
    algebraMap O K (A.coeff seed hinj hseed n v) = A.eval n v :=
  congrArg Subtype.val ((LinearEquiv.ofInjective (Algebra.linearMap O K) hinj).apply_symm_apply
    ⟨A.eval n v, A.integral seed hseed v n⟩)

theorem Basis.hspec (v : A.Λ (O := O) seed) (n : {n : ℕ // n ≠ 0}) :
    algebraMap O K (A.coeff seed hinj hseed n v) = A.coefK v n :=
  A.coeff_spec seed hinj hseed n v

theorem Basis.heckeFourier (q : {q // Q q}) :
    HeckeFourier (A.coeff seed hinj hseed) (A.latHecke seed q)
      (A.latDiamond seed (A.atPrime q)) q := by
  intro n v
  apply hinj
  rw [map_add, A.coeff_spec, A.coeff_spec]
  change A.eval n (A.hecke q v) = _
  rw [A.hecke_eval]
  congr 1
  by_cases hn : q.val ∣ n
  · rw [ite_eq_left hn, ite_eq_left hn, map_mul, map_natCast, A.coeff_spec]
    rfl
  · rw [ite_eq_right hn, ite_eq_right hn, map_zero]

include hinj hseed in
/-- Finiteness follows from finite dimensionality and injectivity of the full
Fourier expansion; only finitely many Fourier-coordinate maps are needed. -/
theorem Basis.finite [IsNoetherianRing O] : (A.Λ (O := O) seed).FG := by
  let V := Submodule.span K (Set.range A.eval)
  obtain ⟨s, hs, he⟩ := (Submodule.fg_span_iff_fg_span_finset_subset _).mp
    (show V.FG from Submodule.FG.of_le_of_isNoetherian le_top)
  choose idx hidx using fun l : s => hs l.property
  let coords : A.Λ (O := O) seed →ₗ[O] (s → O) :=
    LinearMap.pi (fun l => A.coeff seed hinj hseed (idx l))
  apply lattice_fg_of_integral_coordinates _ coords
  intro v w hv
  apply Subtype.ext
  apply A.independent
  funext n
  change A.eval n v = A.eval n w
  have hm : A.eval n ∈ Submodule.span K (s : Set ((I → K) →ₗ[K] K)) :=
    he ▸ (Submodule.subset_span ⟨n, rfl⟩ : A.eval n ∈ V)
  have hEq (f : (I → K) →ₗ[K] K)
      (hf : f ∈ Submodule.span K (s : Set ((I → K) →ₗ[K] K))) : f v = f w := by
    induction hf using Submodule.span_induction with
    | mem l hl =>
      have hh := congrArg (algebraMap O K) (congrFun hv ⟨l, hl⟩)
      change algebraMap O K (A.coeff seed hinj hseed (idx ⟨l, hl⟩) v) =
        algebraMap O K (A.coeff seed hinj hseed (idx ⟨l, hl⟩) w) at hh
      simpa only [A.coeff_spec, hidx] using hh
    | zero => rfl
    | add x y _ _ hx hy => simp only [LinearMap.add_apply, hx, hy]
    | smul c x _ hx => simp only [LinearMap.smul_apply, hx]
  exact hEq _ hm

variable [TopologicalSpace K] [IsTopologicalRing K] [TopologicalSpace O]

theorem Basis.hcoeff (he : Topology.IsEmbedding (algebraMap O K)) (n : ℕ) :
    Continuous (A.coeff seed hinj hseed n) := by
  apply he.continuous_iff.mpr
  have h : (algebraMap O K) ∘ (A.coeff seed hinj hseed n) = fun v : A.Λ (O := O) seed =>
      A.eval n v := funext (A.coeff_spec seed hinj hseed n)
  rw [h]
  exact continuous_finsetSum _ fun i _ => ((continuous_apply i).comp continuous_subtype_val).mul continuous_const

