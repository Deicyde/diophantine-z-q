import ZInQKernel.Contrib.OneProof.RC.Eichler.Ideals

/-!
# Local completions and the level condition

Tex 8462–8469, 8481–8484, 9040–9042. This is the local normal-form definition of
an Eichler order (on-the-spot, c). It treats every prime dividing the level by the
same lower-left congruence, including the prime two.
-/

open scoped Quaternion

noncomputable section

namespace ZInQ.Manuscript.RC.Eichler

variable {a b : ℚ}

abbrev Bp (p : ℕ) [Fact p.Prime] (a b : ℚ) := ℍ[ℚ_[p],(a : ℚ_[p]),0,(b : ℚ_[p])]

instance (p : ℕ) [Fact p.Prime] : Algebra ℤ_[p] (Bp p a b) :=
  Algebra.compHom (Bp p a b) (algebraMap ℤ_[p] ℚ_[p])

instance (p : ℕ) [Fact p.Prime] : SMulCommClass ℤ_[p] (Bp p a b) (Bp p a b) where
  smul_comm r x y := (Algebra.mul_smul_comm r x y).symm

/-- The diagonal coefficient map into one local quaternion algebra. -/
def toLocal (p : ℕ) [Fact p.Prime] : B a b →+* Bp p a b where
  toFun x := ⟨x.re, x.imI, x.imJ, x.imK⟩
  map_zero' := by ext <;> simp
  map_one' := by ext <;> simp
  map_add' x y := by ext <;> simp
  map_mul' x y := by
    ext <;> simp [QuaternionAlgebra.re_mul, QuaternionAlgebra.imI_mul,
      QuaternionAlgebra.imJ_mul, QuaternionAlgebra.imK_mul]

/-- The `ℤ_p`-span of a rational lattice in the local algebra. -/
def localLattice (p : ℕ) [Fact p.Prime] (L : Submodule ℤ (B a b)) :
    Submodule ℤ_[p] (Bp p a b) :=
  Submodule.span ℤ_[p] (toLocal p '' (L : Set (B a b)))

/-- The local order generated by the integer order. -/
def Order.completion (R : Order a b) (p : ℕ) [Fact p.Prime] :
    Subalgebra ℤ_[p] (Bp p a b) :=
  Algebra.adjoin ℤ_[p] (toLocal p '' (R.ring : Set (B a b)))

theorem Order.completion_toSubmodule (R : Order a b) (p : ℕ) [Fact p.Prime] :
    (R.completion p).toSubmodule = localLattice p R.lattice := by
  rw [Order.completion, Algebra.adjoin_eq_span]
  congr 1
  let A : Submonoid (Bp p a b) := R.ring.toSubmonoid.map (toLocal p).toMonoidHom
  change Submonoid.closure (A : Set (Bp p a b)) = (A : Set (Bp p a b))
  rw [Submonoid.closure_eq]

abbrev M2 (K : Type*) := Matrix (Fin 2) (Fin 2) K

/-- The embedding of integral matrices into rational matrices at `p`. -/
def matrixCast (p : ℕ) [Fact p.Prime] : M2 ℤ_[p] →+* M2 ℚ_[p] :=
  (algebraMap ℤ_[p] ℚ_[p]).mapMatrix

/-- The standard level-`p^e` order inside the split local algebra, as a set. -/
def standardLevel (p e : ℕ) [Fact p.Prime] : Set (M2 ℚ_[p]) :=
  matrixCast p '' {M : M2 ℤ_[p] | (p : ℤ_[p]) ^ e ∣ M 1 0}

theorem standardLevel_zero (p : ℕ) [Fact p.Prime] :
    standardLevel p 0 = Set.range (matrixCast p) := by
  simp [standardLevel]

/-- A maximal local order is a full finite integral algebra maximal among such algebras. -/
def IsMaximalLocalOrder (p : ℕ) [Fact p.Prime] (A : Subalgebra ℤ_[p] (Bp p a b)) : Prop :=
  Module.Finite ℤ_[p] A ∧ Submodule.span ℚ_[p] (A : Set (Bp p a b)) = ⊤ ∧
    ∀ T : Subalgebra ℤ_[p] (Bp p a b), Module.Finite ℤ_[p] T →
      Submodule.span ℚ_[p] (T : Set (Bp p a b)) = ⊤ → A ≤ T → T ≤ A

/-- Local normal forms for an Eichler order of level `N` in discriminant `ell`.
The split condition records the matrix model itself. Existence of such an order from just
the ramification predicate remains separate. -/
structure IsEichler (ell N : ℕ) (R : Order a b) : Prop where
  ell_prime : ell.Prime
  N_pos : 0 < N
  prime_to_level : Nat.Coprime N ell
  ramified_maximal : ∀ (p : ℕ) [Fact p.Prime], p = ell →
    IsMaximalLocalOrder p (R.completion p)
  split_profile : ∀ (p : ℕ) [Fact p.Prime], p ≠ ell →
    ∃ f : Bp p a b ≃ₐ[ℚ_[p]] M2 ℚ_[p],
      f '' (R.completion p : Set (Bp p a b)) = standardLevel p (N.factorization p)

/-- Away from level and discriminant, the local order is the full integral matrix ring. -/
theorem IsEichler.local_split {ell N : ℕ} {R : Order a b} (h : IsEichler ell N R)
    (p : ℕ) [Fact p.Prime] (hp : ¬ p ∣ N) (hpe : p ≠ ell) :
    Nonempty (R.completion p ≃+* M2 ℤ_[p]) := by
  obtain ⟨f, hf⟩ := h.split_profile p hpe
  rw [Nat.factorization_eq_zero_of_not_dvd hp, standardLevel_zero] at hf
  have hinj : Function.Injective (matrixCast p) :=
    Matrix.map_injective (show Function.Injective (algebraMap ℤ_[p] ℚ_[p]) from Subtype.val_injective)
  let m : M2 ℤ_[p] →+* Bp p a b := f.symm.toRingHom.comp (matrixCast p)
  have hm (x : M2 ℤ_[p]) : m x ∈ R.completion p := by
    have hx : matrixCast p x ∈ f '' (R.completion p : Set (Bp p a b)) := by
      rw [hf]
      exact Set.mem_range_self x
    obtain ⟨y, hy, he⟩ := hx
    have he' : y = m x := f.injective (by simpa [m] using he)
    exact he' ▸ hy
  let g : M2 ℤ_[p] →+* R.completion p := m.codRestrict (R.completion p).toSubring hm
  refine ⟨(RingEquiv.ofBijective g ⟨?_, ?_⟩).symm⟩
  · intro x y he
    exact hinj (f.symm.injective (congrArg Subtype.val he))
  · intro y
    obtain ⟨x, hx⟩ : f y.val ∈ Set.range (matrixCast p) :=
      hf ▸ Set.mem_image_of_mem f y.prop
    exact ⟨x, Subtype.ext (f.injective (by simpa [g, m] using hx))⟩

namespace RightIdeal

/-- Local principality as a right ideal, with a generator in the local unit group. -/
def LocallyPrincipal {R : Order a b} (I : RightIdeal R) : Prop :=
  ∀ (p : ℕ) [Fact p.Prime], ∃ u : (Bp p a b)ˣ,
    (localLattice p I.lattice : Set (Bp p a b)) =
      (fun x : Bp p a b => (u : Bp p a b) * x) '' (R.completion p : Set (Bp p a b))

theorem self_locallyPrincipal (R : Order a b) : (self R).LocallyPrincipal := by
  intro p hp
  refine ⟨1, ?_⟩
  change (localLattice p R.lattice : Set (Bp p a b)) =
    (fun x : Bp p a b => ((1 : (Bp p a b)ˣ) : Bp p a b) * x) ''
      (R.completion p : Set (Bp p a b))
  rw [← R.completion_toSubmodule]
  simp
  rfl

end RightIdeal

end ZInQ.Manuscript.RC.Eichler

