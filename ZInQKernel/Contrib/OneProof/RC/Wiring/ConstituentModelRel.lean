import ZInQKernel.Contrib.OneProof.RC.Wiring.TraceModelRel

/-!
# Theorem 5.3, Lane RC0 round 3: the corrected constituent model

Manuscript `diophantine_zq.tex`, App F, proof of Proposition `ex:app-coefficient-rules`, the
integral trace module (tex 9641–9670, 9711–9771): "On a constituent and all its degeneracies,
define `t(g)` and `d(g)` to be the scalar trace and determinant of its two-dimensional Galois
representation" (9762–9767); the module generated by the translates of the forms is finite over
the coefficient DVR and preserved by these operators, "Chebotarev and continuity make scalar trace
and determinant operators limits of good Hecke and diamond operations" (9663–9669).

Batch 3's `ConstituentModel` (`TraceModelInstance.lean`) is inconsistent (`constituentModel_false`,
`TraceModelRel.lean`). `ConstituentModelRel` corrects it as `TraceModelRel` corrects `TraceModel`:
Chebotarev in the finite quotients `G/N_U`, independence of the characters at sets of good primes
only (`chi_surj`), and the two definitional fields `N_anti`, `N_chi`. One
more field changes: batch 3's `unram` (every constituent in the support of `F_U` is *trivial* on
`N_U`) cannot hold together with exact Chebotarev in `G/N_U` for the genuine representations,
which have infinite image while `N_U` must then have finite index; it is replaced by its reduced
form `level_red` (the scalar traces of the constituents of `F_U` at `gn` and `g` agree on `F_U`
modulo `𝔪Λ` for `n ∈ N_U`), which is exactly what the reduced module uses (continuity of the
traces on the finite module, tex 9663–9669) and holds for an open `N_U`.

PROVED here from the construction (batch 3's proofs, adapted): `trace_mul` (RC12's
`trace_mul_trace_units` on each constituent, then reduction), `trace_one`, `t_class`, `level`
(from `level_red`), `det_orbit`, `two_fresh`; hence `ConstituentModelRel.toTraceModelRel` and
`coefficientRules_of_constituentsRel`, `rulesUpTo_of_constituentsRel`.
-/

noncomputable section

namespace ZInQ.Manuscript.RC.Wiring

open ZInQ.Manuscript.RC.Symbols ZInQ.Manuscript.RC.Odd
open ZInQ.Contrib.CloudB3RC53.CoefficientDictionary Finset Matrix

/-- **The constituent model of the integral trace module, with Chebotarev relative to `N_U`**
(tex 9641–9771). Fields as batch 3's `ConstituentModel`, except `chebotarev` (relative to `N_U`),
`chi_surj` (for `U` a set of good primes), `level_red` (replacing `unram`), and the added `N_anti`,
`N_chi`. Kinds: `stable_t`, `stable_d`,
`det_orbit`, `level_red`, `kummer`, `chi_surj`, `chebotarev`, `typ_frob`, `bit_frob` GLUE;
`two_fresh` ELLIOT (the squarefree weight count of (O.9), tex 9741–9745); `N_anti`, `N_chi`
definition. Owner: RC12 (App F), batch 3 CoefficientDictionary. -/
structure ConstituentModelRel {L : Type*} [AddCommGroup L] {ε : L →+ ZMod 2} (T : TypeData L ε)
    (R : Finset ℕ → ZMod 2) (ap : ℕ → ℤ) (B : ℕ) where
  /-- the joint Galois group -/
  G : Type
  [instG : Group G]
  /-- the constituents (with multiplicities and degeneracies) -/
  I : Type
  /-- the characteristic-zero coefficient field -/
  K : Type
  [instK : Field K]
  /-- the coefficient ring (valuation ring) and its maximal ideal -/
  O : Type
  [instO : CommRing O]
  [instAlg : Algebra O K]
  m : Ideal O
  two_mem : (2 : O) ∈ m
  /-- the Galois representations of the constituents -/
  ρ : I → G →* GL (Fin 2) K
  /-- the integral module generated by the translates -/
  Λ : Submodule O (I → K)
  /-- GLUE (tex 9663–9669): `Λ` is preserved by the trace operators -/
  stable_t : ∀ g, ∀ v ∈ Λ, tV ρ g v ∈ Λ
  /-- GLUE (tex 9663–9669): `Λ` is preserved by the determinant operators -/
  stable_d : ∀ g, ∀ v ∈ Λ, dV ρ g v ∈ Λ
  /-- the integral forms `F_U = θ H_U` -/
  F : Finset ℕ → Λ
  /-- the coefficient-one functionals on the reduced module -/
  read : Finset ℕ → (Λ ⧸ (m • ⊤ : Submodule O Λ)) →+ ZMod 2
  /-- Frobenius elements -/
  frob : ℕ → G
  /-- the (open, normal) subgroup fixing the `U`-extension -/
  N : Finset ℕ → Subgroup G
  /-- the type characters -/
  chiType : G →* Multiplicative L
  /-- the character of `ℚ(√s*)` -/
  chiBit : ℕ → G →* Multiplicative (ZMod 2)
  /-- GLUE (tex 9711–9729): `(d(u) − 1) t(v) F_U ∈ 𝔪Λ` -/
  det_orbit : ∀ U u v, dV ρ u (tV ρ v (F U : I → K)) - tV ρ v (F U : I → K) ∈
    (m • ⊤ : Submodule O Λ).map Λ.subtype
  /-- ELLIOT (the squarefree weight count of (O.9), tex 9741–9745): `t(g) t(h) F_U ∈ 𝔪Λ` -/
  two_fresh : ∀ U g h, tV ρ g (tV ρ h (F U : I → K)) ∈ (m • ⊤ : Submodule O Λ).map Λ.subtype
  /-- GLUE (level and continuity, tex 9524–9548, 9663–9669): for `n ∈ N_U` the scalar traces at
  `gn` and `g` agree on `F_U` modulo `𝔪Λ` -/
  level_red : ∀ U g, ∀ n ∈ N U, tV ρ (g * n) (F U : I → K) - tV ρ g (F U : I → K) ∈
    (m • ⊤ : Submodule O Λ).map Λ.subtype
  /-- definition: the `U'`-extension lies in the `U`-extension for `U' ⊆ U` -/
  N_anti : ∀ U U', U' ⊆ U → N U ≤ N U'
  /-- definition: the `U`-extension contains the type fields and `ℚ(√s*)`, `s ∈ U` -/
  N_chi : ∀ U, ∀ n ∈ N U, chiType n = 1 ∧ ∀ s ∈ U, chiBit s n = 1
  /-- GLUE (Kummer detection of the elementary quotient) -/
  kummer : ∀ U g, chiType g = 1 → (∀ s ∈ U, chiBit s g = 1) →
    g ∈ Subgroup.closure (sqSet G) ⊔ N U
  /-- GLUE (independence of the quadratic characters at a set of good primes) -/
  chi_surj : ∀ (U : Finset ℕ), (∀ s ∈ U, T.Good s) → ∀ (ℓ : L) (b : ℕ → ZMod 2), ∃ g,
    chiType g = Multiplicative.ofAdd ℓ ∧ ∀ s ∈ U, chiBit s g = Multiplicative.ofAdd (b s)
  /-- GLUE (Chebotarev in the finite group `G/N_U`) -/
  chebotarev : ∀ (U : Finset ℕ), (∀ s ∈ U, T.Good s) → ∀ (g : G) (avoid : Finset ℕ),
    ∃ q h, ∃ n ∈ N U, T.Good q ∧ q ∉ avoid ∧ frob q = h * g * h⁻¹ * n
  /-- GLUE (Frobenius dictionary): the type of `q` is `χ_type(Fr_q)` -/
  typ_frob : ∀ q, T.Good q → chiType (frob q) = Multiplicative.ofAdd (T.typ q)
  /-- GLUE (Frobenius dictionary): `(q/s) = χ_s(Fr_q)` -/
  bit_frob : ∀ q s, T.Good q → T.Good s → q ≠ s →
    chiBit s (frob q) = Multiplicative.ofAdd (legBit q s)

namespace ConstituentModelRel

variable {L : Type*} [AddCommGroup L] {ε : L →+ ZMod 2} {T : TypeData L ε}
  {R : Finset ℕ → ZMod 2} {ap : ℕ → ℤ} {B : ℕ} (X : ConstituentModelRel T R ap B)

attribute [instance] ConstituentModelRel.instG ConstituentModelRel.instK
  ConstituentModelRel.instO ConstituentModelRel.instAlg

/-- The reduced trace module `M = Λ / 𝔪Λ`. -/
abbrev Mred : Type := X.Λ ⧸ (X.m • ⊤ : Submodule X.O X.Λ)

theorem two_nsmul_Mred (x : X.Mred) : 2 • x = 0 := by
  induction x using Submodule.Quotient.induction_on with
  | H v =>
    show 2 • (X.m • ⊤ : Submodule X.O X.Λ).mkQ v = 0
    rw [← map_nsmul, Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero,
      ← Nat.cast_smul_eq_nsmul X.O]
    exact Submodule.smul_mem_smul (by exact_mod_cast X.two_mem) trivial

/-- The `𝔽₂`-structure of the reduced module (`2 ∈ 𝔪`). -/
abbrev modMred : Module (ZMod 2) X.Mred := AddCommGroup.zmodModule X.two_nsmul_Mred

/-- `t(g)` on `Λ`. -/
def tΛ (g : X.G) : X.Λ →ₗ[X.O] X.Λ :=
  ((tV X.ρ g).restrictScalars X.O).restrict (X.stable_t g)

/-- `d(g)` on `Λ`. -/
def dΛ (g : X.G) : X.Λ →ₗ[X.O] X.Λ :=
  ((dV X.ρ g).restrictScalars X.O).restrict (X.stable_d g)

theorem le_comap (f : X.Λ →ₗ[X.O] X.Λ) :
    (X.m • ⊤ : Submodule X.O X.Λ) ≤ (X.m • ⊤ : Submodule X.O X.Λ).comap f := by
  rw [← Submodule.map_le_iff_le_comap, Submodule.map_smul'']
  exact smul_mono_right _ le_top

/-- The reduction of an `O`-linear endomorphism of `Λ`, as an additive map of `M`. -/
def redOp (f : X.Λ →ₗ[X.O] X.Λ) : X.Mred →+ X.Mred :=
  ((X.m • ⊤ : Submodule X.O X.Λ).mapQ _ f (X.le_comap f)).toAddMonoidHom

attribute [local instance] ConstituentModelRel.modMred

/-- `t(g)` on the reduced trace module. -/
def tM (g : X.G) : X.Mred →ₗ[ZMod 2] X.Mred := (X.redOp (X.tΛ g)).toZModLinearMap 2

/-- `d(g)` on the reduced trace module. -/
def dM (g : X.G) : X.Mred →ₗ[ZMod 2] X.Mred := (X.redOp (X.dΛ g)).toZModLinearMap 2

/-- The reduced forms `F_U`. -/
def FM (U : Finset ℕ) : X.Mred := Submodule.Quotient.mk (X.F U)

/-- The coefficient-one functionals. -/
def readM (U : Finset ℕ) : X.Mred →ₗ[ZMod 2] ZMod 2 := (X.read U).toZModLinearMap 2

theorem tM_mk (g : X.G) (v : X.Λ) :
    X.tM g (Submodule.Quotient.mk v) = Submodule.Quotient.mk (X.tΛ g v) := rfl

theorem dM_mk (g : X.G) (v : X.Λ) :
    X.dM g (Submodule.Quotient.mk v) = Submodule.Quotient.mk (X.dΛ g v) := rfl

theorem mk_eq_zero_of_mem {w : X.Λ}
    (hw : (w : X.I → X.K) ∈ (X.m • ⊤ : Submodule X.O X.Λ).map X.Λ.subtype) :
    (Submodule.Quotient.mk w : X.Mred) = 0 := by
  obtain ⟨y, hy, hyw⟩ := hw
  rw [Submodule.Quotient.mk_eq_zero]
  have e : w = y := Subtype.ext hyw.symm
  rw [e]
  exact hy

/-- **`trace_mul` on the reduced module** (PROVED: RC12's matrix identity on each constituent). -/
theorem trace_mul (g h : X.G) (x : X.Mred) :
    X.tM g (X.tM h x) = X.tM (g * h) x + X.dM h (X.tM (g * h⁻¹) x) := by
  induction x using Submodule.Quotient.induction_on with
  | H v =>
    rw [tM_mk, tM_mk, tM_mk, tM_mk, dM_mk, ← Submodule.Quotient.mk_add]
    congr 1
    apply Subtype.ext
    exact tV_mul X.ρ g h (v : X.I → X.K)

/-- `det_orbit` on the reduced module (from the GLUE field `det_orbit`). -/
theorem det_orbit' (U : Finset ℕ) (u v : X.G) : X.dM u (X.tM v (X.FM U)) = X.tM v (X.FM U) := by
  rw [FM, tM_mk, dM_mk, ← sub_eq_zero, ← Submodule.Quotient.mk_sub]
  exact X.mk_eq_zero_of_mem (X.det_orbit U u v)

/-- `two_fresh` on the reduced module (from the field `two_fresh`). -/
theorem two_fresh' (U : Finset ℕ) (g h : X.G) : X.tM g (X.tM h (X.FM U)) = 0 := by
  rw [FM, tM_mk, tM_mk]
  exact X.mk_eq_zero_of_mem (X.two_fresh U g h)

/-- **`trace_one`** (PROVED: `tr 1 = 2`, `2 ∈ 𝔪`). -/
theorem trace_one (x : X.Mred) : X.tM 1 x = (2 : ZMod 2) • x := by
  rw [show (2 : ZMod 2) = 0 from rfl, zero_smul]
  induction x using Submodule.Quotient.induction_on with
  | H v =>
    rw [tM_mk]
    have e : X.tΛ 1 v = (2 : ℕ) • v := by
      apply Subtype.ext
      show tV X.ρ 1 (v : X.I → X.K) = (((2 : ℕ) • v : X.Λ) : X.I → X.K)
      rw [tV_one, two_smul]
      simp [two_nsmul]
    rw [e, ← Submodule.mkQ_apply, map_nsmul, Submodule.mkQ_apply]
    exact X.two_nsmul_Mred _

/-- **`level`** (PROVED from the GLUE field `level_red`). -/
theorem level (U : Finset ℕ) (g n : X.G) (hn : n ∈ X.N U) :
    X.tM (g * n) (X.FM U) = X.tM g (X.FM U) := by
  rw [FM, tM_mk, tM_mk, ← sub_eq_zero, ← Submodule.Quotient.mk_sub]
  exact X.mk_eq_zero_of_mem (X.level_red U g n hn)

/-- **`t` is a class function** (PROVED). -/
theorem t_class (g h : X.G) : X.tM (h * g * h⁻¹) = X.tM g := by
  apply LinearMap.ext
  intro x
  induction x using Submodule.Quotient.induction_on with
  | H v =>
    rw [tM_mk, tM_mk]
    congr 1
    apply Subtype.ext
    show tV X.ρ (h * g * h⁻¹) (v : X.I → X.K) = tV X.ρ g v
    rw [tV_conj]

/-- **The two ELLIOT inputs of the constituent model**, for the genuine reduced operators: the
coefficient-one reading of a fresh vertex (tex 9671–9704) and (O.12) at coefficient one (tex
9905–9918), as in batch 3's `ConstituentModel.toTraceModel`. -/
def Inputs : Prop :=
  (∀ (U : Finset ℕ) (q : ℕ), (∀ s ∈ U, T.Good s) → T.Good q → q ∉ U →
      (insert q U).card ≤ B → R (insert q U) = X.readM U (X.tM (X.frob q) (X.FM U))) ∧
  (∀ (U : Finset ℕ) (p : ℕ), p ∈ U → (∀ s ∈ U, T.Good s) → U.card + 1 ≤ B → ∀ g : X.G,
      ∃ (τ φ : X.G) (κ0 : ℤ), (κ0 = 1 ∨ κ0 = -1) ∧
        X.chiType τ = 1 ∧ (∀ s ∈ U, s ≠ p → X.chiBit s τ = 1) ∧
        X.chiBit p τ = Multiplicative.ofAdd 1 ∧
        X.chiType φ = Multiplicative.ofAdd (T.typ p) ∧
        (∀ s ∈ U, s ≠ p → X.chiBit s φ = Multiplicative.ofAdd (legBit p s)) ∧
        ((Cp (ap p) (-κ0) : ℤ) : ZMod 2) *
            X.readM (U.erase p) (X.tM (g * τ * φ) (X.FM (U.erase p))) -
          ((Cp (ap p) κ0 : ℤ) : ZMod 2) * X.readM (U.erase p) (X.tM (g * φ) (X.FM (U.erase p))) =
        X.readM U (X.tM (g * τ) (X.FM U)) - X.readM U (X.tM g (X.FM U)))

/-- **The corrected trace model of the constituent model** (PROVED: the trace identities, `t(1) =
2`, class invariance and the level from the construction). -/
def toTraceModelRel (hI : X.Inputs) : TraceModelRel T R ap B where
  G := X.G
  M := X.Mred
  instMod := X.modMred
  t := X.tM
  d := X.dM
  F := X.FM
  read := X.readM
  frob := X.frob
  N := X.N
  chiType := X.chiType
  chiBit := X.chiBit
  trace_mul := X.trace_mul
  det_orbit := X.det_orbit'
  two_fresh := X.two_fresh'
  trace_one := X.trace_one
  level := X.level
  N_anti := X.N_anti
  N_chi := X.N_chi
  kummer := X.kummer
  chi_surj := X.chi_surj
  chebotarev := X.chebotarev
  t_class := X.t_class
  typ_frob := X.typ_frob
  bit_frob := X.bit_frob
  reading := hI.1
  o12 := hI.2

end ConstituentModelRel

variable {L : Type*} [AddCommGroup L] {ε : L →+ ZMod 2}

/-- **RC2's rules within a budget from a corrected constituent model** (the odd source at one
stage; PROVED). -/
theorem rulesUpTo_of_constituentsRel {T : TypeData L ε} {R : Finset ℕ → ZMod 2} {ap : ℕ → ℤ}
    {W : ℕ} (X : ConstituentModelRel T R ap (W + 1)) (hI : X.Inputs) (hap : ApEven T ap) :
    RulesUpTo ε (symb T R) W :=
  (X.toTraceModelRel hI).rulesUpTo_of_model hap

/-- **RC2's coefficient rules from corrected constituent models at every budget** (the even
source; PROVED; the corrected form of batch 3's `coefficientRules_of_constituents`). -/
theorem coefficientRules_of_constituentsRel {T : TypeData L ε} {R : Finset ℕ → ZMod 2}
    {ap : ℕ → ℤ} (X : ∀ B, ConstituentModelRel T R ap B) (hI : ∀ B, (X B).Inputs)
    (hap : ApEven T ap) : CoefficientRules ε (symb T R) :=
  coefficientRules_of_modelRel (fun B => (X B).toTraceModelRel (hI B)) hap

/-! ## The corrected constituent model is consistent -/

section Zero

variable {L₀ : Type} [AddCommGroup L₀] {ε₀ : L₀ →+ ZMod 2}

/-- **Non-vacuity of `ConstituentModelRel`** (PROVED): for every type data, budget and `a_p`, a
constituent model of the zero reading with no constituents (`I` empty, `K = ℚ`, `O = ℤ`,
`𝔪 = (2)`), over the witness group of `TraceModelRel.zero` (Chebotarev in `G/N_U` by batch 3's
`realizeNat`). -/
def ConstituentModelRel.zero (T : TypeData L₀ ε₀) (ap : ℕ → ℤ) (B : ℕ) :
    ConstituentModelRel T (fun _ => 0) ap B where
  G := Multiplicative (L₀ × (ℕ → ZMod 2))
  instG := Multiplicative.group
  I := Empty
  K := ℚ
  O := ℤ
  m := Ideal.span {2}
  two_mem := Ideal.subset_span rfl
  ρ := fun i => i.elim
  Λ := ⊤
  stable_t _ _ _ := Submodule.mem_top
  stable_d _ _ _ := Submodule.mem_top
  F _ := 0
  read _ := 0
  frob q := Multiplicative.ofAdd (T.typ q, fun s => legBit q s)
  N := zeroN L₀
  chiType := zeroChiType L₀
  chiBit := zeroChiBit L₀
  det_orbit _ _ _ := by
    convert Submodule.zero_mem _ using 1
  two_fresh _ _ _ := by
    convert Submodule.zero_mem _ using 1
  level_red _ _ _ _ := by
    convert Submodule.zero_mem _ using 1
  N_anti U U' hU' n hn := by
    rw [mem_zeroN] at hn ⊢
    exact ⟨hn.1, fun s hs => hn.2 s (hU' hs)⟩
  N_chi U n hn := mem_zeroN.mp hn
  kummer U g h1 h2 := Subgroup.mem_sup_right (mem_zeroN.mpr ⟨h1, h2⟩)
  chi_surj U _ ℓ b := ⟨Multiplicative.ofAdd (ℓ, b), rfl, fun _ _ => rfl⟩
  chebotarev U hU g avoid := by
    obtain ⟨x, -, hx, hold, -⟩ := realizeNat T U avoid hU
      (fun _ => (Multiplicative.toAdd g).1) (fun _ s => (Multiplicative.toAdd g).2 s)
      (fun _ _ => 0) 1
    obtain ⟨hq, hqU, hqa, htq⟩ := hx 0 (by norm_num)
    refine ⟨x 0, 1, g⁻¹ * Multiplicative.ofAdd (T.typ (x 0), fun s => legBit (x 0) s),
      mem_zeroN.mpr ⟨?_, fun s hs => ?_⟩, hq, hqa, by group⟩
    · rw [map_mul, map_inv, zeroChiType_apply, zeroChiType_apply, toAdd_ofAdd, htq,
        inv_mul_cancel]
    · rw [map_mul, map_inv, zeroChiBit_apply, zeroChiBit_apply, toAdd_ofAdd]
      dsimp only
      rw [hold 0 (by norm_num) s hs, inv_mul_cancel]
  typ_frob _ _ := rfl
  bit_frob _ _ _ _ _ := rfl

/-- The two inputs hold for the zero constituent model (PROVED: every reading is zero). -/
theorem ConstituentModelRel.zero_inputs (T : TypeData L₀ ε₀) (ap : ℕ → ℤ) (B : ℕ) :
    (ConstituentModelRel.zero T ap B).Inputs := by
  refine ⟨fun _ _ _ _ _ _ => rfl, fun U p _ _ _ g => ?_⟩
  refine ⟨(Multiplicative.ofAdd ((0 : L₀), (Pi.single p 1 : ℕ → ZMod 2)) :
      Multiplicative (L₀ × (ℕ → ZMod 2))),
    (Multiplicative.ofAdd (T.typ p, fun s => legBit p s) : Multiplicative (L₀ × (ℕ → ZMod 2))),
    1, Or.inl rfl, ?_, fun s _ hsp => ?_, ?_, rfl, fun _ _ _ => rfl, rfl⟩
  · show zeroChiType L₀ (Multiplicative.ofAdd ((0 : L₀), (Pi.single p 1 : ℕ → ZMod 2))) = 1
    rw [zeroChiType_apply, toAdd_ofAdd, ofAdd_zero]
  · show zeroChiBit L₀ s (Multiplicative.ofAdd ((0 : L₀), (Pi.single p 1 : ℕ → ZMod 2))) = 1
    rw [zeroChiBit_apply, toAdd_ofAdd]
    dsimp only
    rw [Pi.single_eq_of_ne hsp, ofAdd_zero]
  · show zeroChiBit L₀ p (Multiplicative.ofAdd ((0 : L₀), (Pi.single p 1 : ℕ → ZMod 2))) =
      Multiplicative.ofAdd 1
    rw [zeroChiBit_apply, toAdd_ofAdd]
    dsimp only
    rw [Pi.single_eq_same]

/-- A corrected constituent model of the zero reading with its inputs, at every budget
(PROVED). -/
theorem constituentModelRel_zero_exists (T : TypeData L₀ ε₀) (ap : ℕ → ℤ) (B : ℕ) :
    ∃ X : ConstituentModelRel T (fun _ => 0) ap B, X.Inputs :=
  ⟨ConstituentModelRel.zero T ap B, ConstituentModelRel.zero_inputs T ap B⟩

end Zero

end ZInQ.Manuscript.RC.Wiring
