import ZInQKernel.Contrib.OneProof.RC.Wiring.AddressDict3
import ZInQKernel.Contrib.OneProof.RC.Wiring.ConstituentModelRel

/-!
# Theorem 5.3, Lane RC0 round 3: the address leaf at the level of the constituent representations

`AddressPackage4` is `AddressPackage3` (`AddressDict3.lean`) with the trace models (8‴), (9‴)
replaced by the corrected constituent models with their two inputs (8⁗), (9⁗)
(`ConstituentModelRel`, `ConstituentModelRel.Inputs`; App F tex 9641–9771: the scalar trace and
determinant of the two-dimensional Galois representations of the constituents, on the finite
integral module generated by the translates of the forms). The trace identities of the reduced
module (`trace_mul`, `trace_one`, class invariance) and its level are then PROVED from the
construction (`ConstituentModelRel.toTraceModelRel`), so
`addressPackage3_of_4 : AddressPackage4 W C → AddressPackage3 W C` and
`addressPackageDictLeaf_of_4 : AddressPackageLeaf4 W → AddressPackageDictLeaf W` (PROVED). All
other conjuncts are those of `AddressPackage3`, verbatim (tex lines, kinds, owners in its
docstring). The new conjuncts are satisfiable (`coefficientConjuncts4_zero`).
-/

noncomputable section

namespace ZInQ.Manuscript.RC.Wiring

open ZInQ.Manuscript ZInQ.Contrib.CloudB3RC53 Filter

/-- **The address package, form 4**: `AddressPackage3` with conjuncts 8‴, 9‴ replaced by

| item | conjunct | tex | kind | owner |
|---|---|---|---|---|
| 8⁗ | for every cutoff `W`, at the stages of a set of `𝒰`: a `ConstituentModelRel` of the odd stage source within the budget `W + 1` with its two inputs, and `a_p` even | App F 9641–9771, 9905–9953; 9585, 9593; 10533–10540 | GLUE (integrality `stable_t`, `stable_d`; diamond formula `det_orbit`; level and continuity `level_red`; Kummer, independence, Chebotarev in `G/N_U`, Frobenius dictionary), ELLIOT (`two_fresh`, tex 9741–9745; inputs `reading`, 9671–9704, and `o12`, 9905–9918), definition (`N_U`); `a_p` even GLUE | RC12 (App F), batch 3 CoefficientDictionary |
| 9⁗ | the same for the even source of `E^{(k)}`, at every budget | as 8⁗; transported source 10288–10318 | as 8⁗ | RC12, RC11 (source) |

All other conjuncts as in `AddressPackage3` (same tex lines, kinds and owners). -/
def AddressPackage4 {ℓ : ℕ} (W : WData ℓ) (Ccoarse : ℚ) : Prop :=
  -- (1)–(4)
  Adm ℓ ∧ Odd W.kfin ∧ Squarefree W.kfin ∧
  (∃ q₀ : ℕ, q₀.Prime ∧ (q₀ : ℤ) ∣ W.kfin ∧ ¬ q₀ ∣ 2 * ℓ) ∧
  -- (5)
  ∃ CeFinal : ℤ,
  ∃ (L L₁ L₂ : Type) (_ : AddCommGroup L) (_ : Fintype L) (_ : DecidableEq L)
    (_ : AddCommGroup L₁) (_ : Fintype L₁) (_ : DecidableEq L₁) (_ : AddCommGroup L₂)
    (ε : L →+ ZMod 2) (ε₁ : L₁ →+ ZMod 2) (ε₂ : L₂ →+ ZMod 2) (π₁ : L →+ L₁) (π₂ : L →+ L₂)
    (T₁ : ℕ → CoefficientDictionary.TypeData L₁ ε₁) (Rodd : ℕ → Finset ℕ → ZMod 2)
    (apo : ℕ → ℕ → ℤ) (T₂ : CoefficientDictionary.TypeData L₂ ε₂)
    (Rev : Finset ℕ → ZMod 2) (apk : ℕ → ℤ) (Realizes : ℕ → Symbols.Config L → ℤ → Prop),
    -- (6), (7)
    (∀ x : L, x + x = 0) ∧ Function.Surjective π₁ ∧ Function.Surjective π₂ ∧
    (∀ x, ε₁ (π₁ x) = ε x) ∧ (∀ x, ε₂ (π₂ x) = ε x) ∧
    -- (8⁗) the constituent model of the odd stage source, within the budget of every cutoff
    (∀ Wc : ℕ, ∀ᶠ θ in (W.stages : Filter ℕ),
      (∃ X : ConstituentModelRel (T₁ θ) (Rodd θ) (apo θ) (Wc + 1), X.Inputs) ∧
        CoefficientDictionary.ApEven (T₁ θ) (apo θ)) ∧
    -- (9⁗) the constituent model of the even source of `E^{(k)}`, at every budget
    ((∀ B, ∃ X : ConstituentModelRel T₂ Rev apk B, X.Inputs) ∧
      CoefficientDictionary.ApEven T₂ apk) ∧
    -- (11′), (12′)
    (∃ Γ₁ : Symbols.Config L₁, Γ₁.Compatible ε₁ ∧ Γ₁.V.Nonempty ∧
      ∀ᶠ θ in (W.stages : Filter ℕ), CoefficientDictionary.symb (T₁ θ) (Rodd θ) Γ₁ = 1) ∧
    (∀ Γ : Symbols.Config L₁, Γ.Compatible ε₁ →
      (∀ᶠ θ in (W.stages : Filter ℕ), CoefficientDictionary.symb (T₁ θ) (Rodd θ) Γ = 1) →
        Γ.total = 0) ∧
    -- (13)
    (∀ Γ : Symbols.Config L₂, Symbols.IsUnitSeed ε₂ (CoefficientDictionary.symb T₂ Rev) Γ →
      Γ.total = 0) ∧
    -- (14‴) the `K`-split seed: lane RC3's no-seed trace data
    (∃ (Fc : Type) (_ : Field Fc) (_ : CharZero Fc) (O : Subring Fc) (Sev : Finset ℕ),
      (¬ ∃ Γ₂ : Symbols.Config L₂,
        Symbols.IsUnitSeed ε₂ (CoefficientDictionary.symb T₂ Rev) Γ₂ ∧ Γ₂.V.Nonempty) →
      ∀ p : ℕ, ∀ hp : p.Prime, p ∉ Sev → ¬ (p : ℤ) ∣ 6 * (W.kfin * ℓ) →
        jacobiSym W.kfin p = 1 → Nonempty (@KSplit.NoSeedTraceData Fc _ O p ⟨hp⟩
          ((ZInQ.Manuscript.curve ((W.kfin * ℓ : ℤ) : ℚ)).LFunction p))) ∧
    -- (15)
    (∀ (θ b : ℕ) (Γ : Symbols.Config L) (act' : ℕ → Option (Fin b → ZMod 2)),
      Γ.Compatible ε → (∀ u ∈ Γ.V, ∃ w, w ≠ 0 ∧ act' u = some w) →
      ∃ F : Family, ∃ hdim : F.b = b, Family.Admissible W.S W.kfin F ∧
        ∀ x : Fin b → ZMod 2, x ≠ 0 → Realizes θ (Γ.at act' x) (F.h (x ∘ Fin.cast hdim))) ∧
    -- (16₀)
    (∀ (θ : ℕ) (Δ : Symbols.Config L) (D : ℤ), Δ.Compatible ε → Realizes θ Δ D →
      AppGEndpoints.omega D = Δ.V.card ∧ (Δ.total = 0 → W.prepared D)) ∧
    -- (17)
    (∀ (θ T Wb : ℕ) (Δ : Symbols.Config L) (D : ℤ), Δ.Compatible ε → Realizes θ Δ D →
      Δ.V.card ≤ Wb → Wb + 1 ≤ T → (((max 0 (W.δo + Wb) + 2 : ℤ)) : ℚ) ≤ T - Ccoarse →
      (∀ D', W.admissible θ D' → AppGEndpoints.omega D' ≤ T → vZ (W.aθ θ D') < W.Mθ θ →
        (((AppGEndpoints.omega D' : ℤ) + W.δo : ℤ) : WithTop ℤ) ≤ vZ (W.aθ θ D')) →
      max 0 (W.δo + Wb) + 2 ≤ (W.Mθ θ : ℤ) → (T : ℤ) + W.δo < W.Mθ θ →
      CoefficientDictionary.symb (T₁ θ) (Rodd θ) (Δ.mapType π₁) = 1 →
      W.admissible θ D ∧
        vZ (W.aθ θ D) = (((AppGEndpoints.omega D : ℤ) + W.δo : ℤ) : WithTop ℤ)) ∧
    -- (18)
    (∀ (θ : ℕ) (Δ : Symbols.Config L) (D : ℤ), Δ.Compatible ε → Realizes θ Δ D →
      CoefficientDictionary.symb T₂ Rev (Δ.mapType π₂) = 1 →
      W.Lstar (D * W.kfin) ≠ 0 ∧
        padicValRat 2 (W.Lstar (D * W.kfin)) ≤ 2 * (AppGEndpoints.omega D : ℤ) + CeFinal)

/-- **Form 3 from form 4** (PROVED: `ConstituentModelRel.toTraceModelRel`). -/
theorem addressPackage3_of_4 {ℓ : ℕ} (W : WData ℓ) (Ccoarse : ℚ)
    (h : AddressPackage4 W Ccoarse) : AddressPackage3 W Ccoarse := by
  obtain ⟨hℓ, hk_odd, hk_sf, hq₀, CeFinal, L, L₁, L₂, iL, iLf, iLd, iL₁, iL₁f, iL₁d, iL₂, ε, ε₁,
    ε₂, π₁, π₂, T₁, Rodd, apo, T₂, Rev, apk, Realizes, hL, hπ₁, hπ₂, hε₁, hε₂, hodd8,
    ⟨hX, hap⟩, hrest⟩ := h
  exact ⟨hℓ, hk_odd, hk_sf, hq₀, CeFinal, L, L₁, L₂, iL, iLf, iLd, iL₁, iL₁f, iL₁d, iL₂, ε, ε₁,
    ε₂, π₁, π₂, T₁, Rodd, apo, T₂, Rev, apk, Realizes, hL, hπ₁, hπ₂, hε₁, hε₂,
    fun Wc => (hodd8 Wc).mono fun θ hθ =>
      ⟨hθ.1.elim fun X hI => ⟨X.toTraceModelRel hI⟩, hθ.2⟩,
    ⟨fun B => (hX B).elim fun X hI => ⟨X.toTraceModelRel hI⟩, hap⟩, hrest⟩

/-- **The replacement leaf, form 4**: `AddressPackage4` for every choice of the constants (as
`AddressPackageLeaf3`). -/
def AddressPackageLeaf4 {ℓ : ℕ} (W : WData ℓ) : Prop :=
  ∀ (A : ℕ) (CE CR Cper Cdet : ℤ), F3At W A CE → Gz34CompAt W Cper → Eq35At W A CR →
    VisAt W Cdet → ¬ W.OddEmptyUnit →
    AddressPackage4 W
      (((2 * (A : ℤ) + CR + CE - padicValRat 2 (W.Lstar W.hstar) + (Cper + 2) : ℤ) : ℚ) / 2 +
        Cdet)

/-- **Leaf 3 from leaf 4** (PROVED). -/
theorem addressPackageLeaf3_of_4 {ℓ : ℕ} (W : WData ℓ) (h : AddressPackageLeaf4 W) :
    AddressPackageLeaf3 W := fun A CE CR Cper Cdet h33 h34 h35 hvis hU =>
  addressPackage3_of_4 W _ (h A CE CR Cper Cdet h33 h34 h35 hvis hU)

/-- **The dictionary leaf from leaf 4** (PROVED). -/
theorem addressPackageDictLeaf_of_4 {ℓ : ℕ} (W : WData ℓ) (h : AddressPackageLeaf4 W) :
    AddressPackageDictLeaf W :=
  addressPackageDictLeaf_of_3 W (addressPackageLeaf3_of_4 W h)

/-- **`AddressLeaf` from leaf 4** (PROVED). -/
theorem addressLeaf_of_4 {ℓ : ℕ} (W : WData ℓ) (h : AddressPackageLeaf4 W) : AddressLeaf W :=
  addressLeaf_of_3 W (addressPackageLeaf3_of_4 W h)

/-- **The new coefficient conjuncts (8⁗), (9⁗) are satisfiable** (PROVED): the zero readings with
`a_p = 0` carry corrected constituent models with their inputs at every budget
(`ConstituentModelRel.zero`). -/
theorem coefficientConjuncts4_zero {L₁ L₂ : Type} [AddCommGroup L₁] [AddCommGroup L₂]
    {ε₁ : L₁ →+ ZMod 2} {ε₂ : L₂ →+ ZMod 2} (𝒰 : Filter ℕ)
    (T₁ : ℕ → CoefficientDictionary.TypeData L₁ ε₁) (T₂ : CoefficientDictionary.TypeData L₂ ε₂) :
    (∀ Wc : ℕ, ∀ᶠ θ in 𝒰,
      (∃ X : ConstituentModelRel (T₁ θ) (fun _ => 0) (fun _ => 0) (Wc + 1), X.Inputs) ∧
        CoefficientDictionary.ApEven (T₁ θ) (fun _ => 0)) ∧
    ((∀ B, ∃ X : ConstituentModelRel T₂ (fun _ => 0) (fun _ => 0) B, X.Inputs) ∧
      CoefficientDictionary.ApEven T₂ (fun _ => 0)) :=
  ⟨fun _ => Filter.Eventually.of_forall fun θ =>
      ⟨constituentModelRel_zero_exists (T₁ θ) _ _, fun _ _ => ⟨0, rfl⟩⟩,
    ⟨fun B => constituentModelRel_zero_exists T₂ _ B, fun _ _ => ⟨0, rfl⟩⟩⟩

end ZInQ.Manuscript.RC.Wiring
