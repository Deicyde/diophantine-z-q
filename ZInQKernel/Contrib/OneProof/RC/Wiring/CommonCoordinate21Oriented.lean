/-! ### The value at the orientations -/

section Orient

variable {K : Type} [Field K] [NumberField K] {ℓ : ℕ} {Q : Finset ℕ}

/-- The family's exponent at a local Frobenius lift at an orientation (tex 2733–2735,
4275–4277; the family's `orient_one`). Kind: PROVED. -/
theorem xi_orient_at (Ψ : FamilyMovingCharacter K ℓ Q) (s : ℕ) {q : ℕ} (hq : q ∈ Q)
    (v : HeightOneSpectrum (𝓞 K)) (hv : v = Ψ.orient q) (φ : Gloc K v)
    (hφ : TauCeti.IsArithFrobeniusLift (v.adicCompletion K) φ) :
    Ψ.ψ s (locMap K (Ψ.Sr s) v φ) = Multiplicative.ofAdd 1 := by
  subst hv
  exact Ψ.orient_one s q hq φ hφ

/-- **The family's exponent at the Frobenius of an orientation** (tex 2733–2735, 4275–4277): at
a new place `w` over `S₀ ⊇ Sr(s)` that is the family's orientation above `q ∈ Q`, the exponent
`Ψ.ψ s` inflated to `G_{K,S₀}` has value `1` at the Frobenius of `w` (the family's `orient_one`
for a local arithmetic Frobenius lift). Kind: PROVED. -/
theorem xi_orient (Ψ : FamilyMovingCharacter K ℓ Q) (s : ℕ) {q : ℕ} (hq : q ∈ Q)
    {S₀ S : Set (HeightOneSpectrum (𝓞 K))} (hSr : Ψ.Sr s ⊆ S₀) (w : NewPlaces K S₀ S)
    (hw : w.1 = Ψ.orient q) :
    (Ψ.ψ s).comp (inflMap K hSr).toMonoidHom (urFrobElt K w) = Multiplicative.ofAdd 1 := by
  obtain ⟨φ, hφ⟩ := urRes_surjective K w.1 (frobElt (eUr K w.1))
  have hφ' : TauCeti.IsArithFrobeniusLift (w.1.adicCompletion K) φ := by
    change urRes K w.1 φ = _
    rw [hφ, frobElt_eUr]
  have he : urFrobElt K w = locMap K S₀ w.1 φ := by
    change urFactor K w (frobElt (eUr K w.1)) = locMap K S₀ w.1 φ
    rw [urFactor_spec K w φ, hφ]
  rw [MonoidHom.comp_apply, he]
  change Ψ.ψ s (inflMap K hSr (locMap K S₀ w.1 φ)) = _
  rw [locMap_compat]
  exact xi_orient_at Ψ s hq w.1 hw φ hφ'

omit [NumberField K] in
/-- **A number field generated by the square root of a negative integer is totally complex**
(tex 2720; as lane E2's `isTotallyComplex_of_sqrt`). Kind: PROVED. -/
theorem isTotallyComplex_of_sqrt' {r : K} {k : ℤ} (hr : r ^ 2 = ((k : ℤ) : K)) (hk : k < 0) :
    IsTotallyComplex K := by
  refine ⟨fun v => ?_⟩
  by_contra h
  rw [InfinitePlace.not_isComplex_iff_isReal] at h
  have e := congrArg (InfinitePlace.embedding_of_isReal h) hr
  rw [map_pow, map_intCast] at e
  have h0 : (0 : ℝ) ≤ (InfinitePlace.embedding_of_isReal h r) ^ 2 := sq_nonneg _
  have hk' : ((k : ℤ) : ℝ) < 0 := by exact_mod_cast hk
  linarith

end Orient

/-! ### The oriented presentation -/

section Presentation

variable {ℓ : ℕ}

/-- **The staged presentation with the chain's first places at the family's orientations**
(tex 2720–2741, 2778–2796, 3455–3498, 4142–4194, 4255–4280, 4385–4451), for the genuine family
character `G` (lane RC0's `GenuineFamilyMovingCharacter`, one per family). The fields are those
of `StagedPresentation` for `Ψ = G.toFamily` (with their kinds), without `xiFrob` and `xiConj`,
and:

* `orientPl` (definition; tex 2733–2735, 4275–4277): the first place of the `i`-th step is the
  family's orientation above the `i`-th unused prime;
* `hpidx` (definition: a formalization requirement; the text's chain has one index per unused
  prime, tex 4142–4146): every index is the index of a step.

The support `S₀ s` is free beyond `Sr s ⊆ S₀ s`, and the conditions at its places outside the
places above `2N` are full; the text's exclusions of the θ-prime and of the old support are not
recorded. Kind: definition (data). -/
structure OrientedPresentation (C : TateCoef (Ecurve ℓ)) (D : RCData ℓ) (Fam : Family)
    (x : Addr Fam.b) (G : GenuineFamilyMovingCharacter C.K ℓ Fam.Q) : Type 1 where
  /-- `√k ∈ K` (definition; tex 2720) -/
  r : C.K
  /-- `r² = k` (definition; tex 2720) -/
  hr : r ^ 2 = ((D.kfin : ℤ) : C.K)
  /-- `K = ℚ(r)` (definition; tex 2720) -/
  hgen : Algebra.adjoin ℚ {r} = ⊤
  /-- the graph primes are odd primes (definition; tex 2678–2680, 4143) -/
  hprime : ∀ q ∈ Fam.Q, q.Prime ∧ q ≠ 2
  /-- the graph primes are prime to `k` and split in `K` (definition; tex 2720–2722) -/
  split : ∀ q ∈ Fam.Q, ¬ (q : ℤ) ∣ D.kfin ∧ IsSquare ((D.kfin : ℤ) : ZMod q)
  /-- the support of the coefficients at each stage (definition; tex 2729–2741, 3455–3463;
  otherwise free, with the full conditions at its places outside the places above `2N`) -/
  S₀ : ℕ → Set (HeightOneSpectrum (𝓞 C.K))
  /-- it contains the family's moving support at the stage (definition; tex 2729–2731) -/
  hSr : ∀ s, G.toFamily.Sr s ⊆ S₀ s
  /-- `E[2^∞]` is rational over `K_{S₀ s}` (GLUE: Néron–Ogg–Shafarevich, Silverman AEC VII.7.1;
  tex 2836–2838) -/
  full : ∀ s, HasFullTwoTorsion C.K (S₀ s) ((Ecurve ℓ).baseChange C.K)
  /-- an actual complex conjugation at each stage (definition; tex 2778) -/
  Cc : ∀ s, ActualConj C.K (S₀ s)
  /-- `√h_x ∈ K_{S₀ s}` (definition; tex 2726) -/
  sh : ∀ s, KS C.K (S₀ s)
  /-- `sh² = h_x` (definition; tex 2726) -/
  hs : ∀ s, sh s ^ 2 = algebraMap C.K (KS C.K (S₀ s)) ((Fam.h x : ℤ) : C.K)
  /-- `sh ≠ 0` (definition; tex 2726) -/
  hs0 : ∀ s, sh s ≠ 0
  /-- the moving part at the precision `s'` over `G_{K,S₀ s}` (definition; tex 2781–2783) -/
  ψf : ∀ s s', Multiplicative (ZMod (2 ^ (2 * s))) →* (Acoef s')ˣ
  /-- at the precision of the stage it is `(1 + t)^{(·)}` (definition; tex 2781–2783) -/
  hψf : ∀ s, ψf s s = expU s
  /-- at the other precisions it is trivial (definition: auxiliary) -/
  hψoff : ∀ s s', s' ≠ s → ψf s s' = 1
  /-- the places of the old Kummer conditions (definition; tex 2743–2760) -/
  Pk : Set (HeightOneSpectrum (𝓞 C.K))
  /-- they are the places above `2N` (definition; tex 2743–2760) -/
  hPk : Pk = placesTwoN C.K ℓ
  /-- the indices of the chain (definition; tex 4142–4146) -/
  ι : Type
  /-- decidable equality of the indices (definition) -/
  [decι : DecidableEq ι]
  /-- the two places of each index (definition; tex 4142–4146) -/
  pl : ι × Bool → HeightOneSpectrum (𝓞 C.K)
  /-- they are outside the support of the coefficients at every stage (definition;
  tex 3470–3498) -/
  hw : ∀ s j, pl j ∉ S₀ s
  /-- the index relaxed at each step (definition; tex 4142–4146) -/
  pidx : ℕ → ι
  /-- the order of the unused primes (definition; tex 4142–4146) -/
  ps : List ℕ
  /-- each unused prime is relaxed once (definition; tex 4142–4146) -/
  hnd : ps.Nodup
  /-- the chain relaxes exactly the unused primes (definition; tex 4142–4146) -/
  hps : ps.toFinset = unusedAt Fam x
  /-- each relaxed index is new (definition; tex 4142–4146) -/
  hnew : ∀ i < ps.length, pidx i ∉ chainT pidx i
  /-- the two places of the `i`-th step lie above the `i`-th unused prime (definition;
  tex 4142–4146) -/
  places : ∀ s, ∀ i < ps.length,
    SplitPair (Cc s).κ (ps.getD i 1) (pl (pidx i, false)) (pl (pidx i, true))
  /-- the first place of the `i`-th step is the family's orientation above the `i`-th unused
  prime (definition; tex 2733–2735, 4275–4277) -/
  orientPl : ∀ i < ps.length, pl (pidx i, false) = G.toFamily.orient (ps.getD i 1)
  /-- every index is the index of a step (definition: a formalization requirement; the text's
  chain has one index per unused prime, tex 4142–4146) -/
  hpidx : ∀ p : ι, ∃ j < ps.length, pidx j = p

attribute [instance] OrientedPresentation.decι

namespace OrientedPresentation

variable {C : TateCoef (Ecurve ℓ)} {D : RCData ℓ} {Fam : Family} {x : Addr Fam.b}
  {G : GenuineFamilyMovingCharacter C.K ℓ Fam.Q} (O : OrientedPresentation C D Fam x G)

/-- The prime of the `i`-th step is a graph prime (tex 4142–4146). Kind: PROVED. -/
theorem step_mem_Q {i : ℕ} (hi : i < O.ps.length) : O.ps.getD i 1 ∈ Fam.Q := by
  have hmem : O.ps.getD i 1 ∈ unusedAt Fam x := by
    rw [← O.hps, List.getD_eq_getElem O.ps 1 hi]
    exact List.mem_toFinset.mpr (List.getElem_mem hi)
  exact (mem_unusedAt.mp hmem).1

/-- **The prescribed value of the family's exponent at the first place of every index**
(tex 2731–2736, 2783, 4275–4277): `StagedPresentation.xiFrob`, from the family's `orient_one`
(`orientPl`, `xi_orient`; every index is a step's, `hpidx`). Kind: PROVED. -/
theorem xiFrob : ∀ s (p : O.ι), (G.toFamily.ψ s).comp (inflMap C.K (O.hSr s)).toMonoidHom
    (urFrobElt C.K (⟨O.pl (p, false), Set.mem_union_right (O.S₀ s)
      (Set.mem_range_self (p, false)), O.hw s (p, false)⟩ :
        NewPlaces C.K (O.S₀ s) (O.S₀ s ∪ Set.range O.pl))) = Multiplicative.ofAdd 1 := by
  intro s p
  obtain ⟨i, hi, rfl⟩ := O.hpidx p
  exact xi_orient G.toFamily s (O.step_mem_Q hi) (O.hSr s) _ (O.orientPl i hi)

/-- **The anticyclotomy of the family's exponent** (tex 2778–2795): `StagedPresentation.xiConj`,
for `k < 0` and the moving supports exactly the places above the moving primes: lane E1's
`xiConj_family'` (no print), with `K = ℚ(√k)` totally complex and of degree `2`
(`isTotallyComplex_of_sqrt'`, `finrank_of_sqrt`). Kind: PROVED. -/
theorem xiConj (hk0 : D.kfin < 0)
    (hEq : ∀ i, G.C.Sr (G.r i) =
      {u : HeightOneSpectrum (𝓞 C.K) | ((G.r i : ℤ) : 𝓞 C.K) ∈ u.asIdeal}) :
    ∀ s σ, (G.toFamily.ψ s).comp (inflMap C.K (O.hSr s)).toMonoidHom ((O.Cc s).conj σ) =
      ((G.toFamily.ψ s).comp (inflMap C.K (O.hSr s)).toMonoidHom σ)⁻¹ :=
  haveI := isTotallyComplex_of_sqrt' O.hr hk0
  ZInQ.Contrib.CloudB3E1Dihedral.xiConj_family' (finrank_of_sqrt O.hr O.hgen hk0) G hEq O.hSr O.Cc

/-- **The staged presentation of an oriented presentation** (tex 2720–2741, 4142–4194,
4385–4451): `xiFrob` and `xiConj` are the theorems above. Kind: definition. -/
def toStaged (hk0 : D.kfin < 0)
    (hEq : ∀ i, G.C.Sr (G.r i) =
      {u : HeightOneSpectrum (𝓞 C.K) | ((G.r i : ℤ) : 𝓞 C.K) ∈ u.asIdeal}) :
    StagedPresentation C D Fam x G.toFamily where
  r := O.r
  hr := O.hr
  hgen := O.hgen
  hprime := O.hprime
  split := O.split
  S₀ := O.S₀
  hSr := O.hSr
  full := O.full
  Cc := O.Cc
  sh := O.sh
  hs := O.hs
  hs0 := O.hs0
  ψf := O.ψf
  hψf := O.hψf
  hψoff := O.hψoff
  Pk := O.Pk
  hPk := O.hPk
  ι := O.ι
  pl := O.pl
  hw := O.hw
  pidx := O.pidx
  ps := O.ps
  hnd := O.hnd
  hps := O.hps
  hnew := O.hnew
  places := O.places
  xiFrob := O.xiFrob
  xiConj := O.xiConj hk0 hEq

end OrientedPresentation

end Presentation

end ZInQ.Manuscript.RC.Wiring
