import ZInQKernel.Contrib.OneProof.RC.O12Local.Conductor
import ZInQKernel.Contrib.OneProof.RC.O12.Local

/-! Carayol's comparison on the existing constituent representation (tex 9773–9797,
9810–9811, 9866–9873). We keep track of both duals and of the unit ambiguity in
the image of a lift of arithmetic Frobenius. -/

noncomputable section

namespace ZInQ.Manuscript.RC.O12Local

open Matrix AddressGenuine PrintsArith Symbols
open scoped Pointwise

variable {p : ℕ} [Fact p.Prime]

abbrev DecompositionAt (P : O12.LocalPair p) : Subgroup GalQ :=
  MulAction.stabilizer GalQ P.Q

/-- The Weil subgroup generated by absolute inertia and the selected Frobenius lift. -/
def weilAt (P : O12.LocalPair p) : Subgroup GalQ :=
  Subgroup.closure ((P.Q.inertia GalQ : Set GalQ) ∪ {P.φ})

omit [Fact p.Prime] in
theorem weilAt_le_decomposition (P : O12.LocalPair p) : weilAt P ≤ DecompositionAt P := by
  let := P.maximal.isPrime
  exact (Subgroup.closure_le _).2 (Set.union_subset (Ideal.inertia_le_stabilizer P.Q)
    (Set.singleton_subset_iff.mpr P.frob.mem_stabilizer))

/-- The reciprocity convention in tex 9784–9785, as needed on the Weil subgroup.
An arbitrary arithmetic Frobenius lift maps to the inverse uniformizer modulo units. -/
structure ReciprocityAt (P : O12.LocalPair p) where
  toUnits : weilAt P →* ℚ_[p]ˣ
  inertia_unit : ∀ w : weilAt P, (w : GalQ) ∈ P.Q.inertia GalQ → ‖(toUnits w : ℚ_[p])‖ = 1
  frob_value : ∀ w : weilAt P, (w : GalQ) = P.φ →
    ∃ u : ℚ_[p]ˣ, ‖(u : ℚ_[p])‖ = 1 ∧ toUnits w = (uniformizer p)⁻¹ * u

/-- PRINT: the principal-series case of Carayol §§0.3–0.7, Théorème A,
pp. 409–411 (UNVERIFIED), tex 9778–9791. This concerns the *same* `ρ` already
provided by the constituent model. The zero-monodromy comparison is written
using the character extensions to the decomposition group. Their restriction
to the Weil group is Carayol's `ξ⁻¹ · ω⁻¹/²`, for the inducing characters
`ξ = μ⁻¹` of the automorphic contragredient. The transpose of the inverse
matrix represents the Galois dual. -/
structure CarayolPrincipal {E : Type*} [Field E] (P : O12.LocalPair p)
    (ρ : GalQ →* GL (Fin 2) E) (C : ReciprocityAt P)
    (μ₁ μ₂ halfMod : LocalCharacter p E) where
  σ₁ : DecompositionAt P →* Eˣ
  σ₂ : DecompositionAt P →* Eˣ
  b : GL (Fin 2) E
  dual_compare : ∀ g : DecompositionAt P,
    (↑(b * (ρ g)⁻¹ * b⁻¹) : Matrix (Fin 2) (Fin 2) E).transpose =
      diagonal ![(σ₁ g : E), (σ₂ g : E)]
  weil_formula : ∀ w : weilAt P,
    let d := (Subgroup.inclusion (weilAt_le_decomposition P)) w
    σ₁ d = ((μ₁ (C.toUnits w))⁻¹)⁻¹ * (halfMod (C.toUnits w))⁻¹ ∧
      σ₂ d = ((μ₂ (C.toUnits w))⁻¹)⁻¹ * (halfMod (C.toUnits w))⁻¹

/-- The second dual in tex 9779: taking inverses on the decomposition group
and transposing the diagonal comparison gives the two character lines for `ρ`. -/
theorem CarayolPrincipal.character_lines {E : Type*} [Field E] {P : O12.LocalPair p}
    {ρ : GalQ →* GL (Fin 2) E} {C : ReciprocityAt P} {μ₁ μ₂ halfMod : LocalCharacter p E}
    (D : CarayolPrincipal P ρ C μ₁ μ₂ halfMod) :
    ∀ g : DecompositionAt P, (↑(D.b * ρ g * D.b⁻¹) : Matrix (Fin 2) (Fin 2) E) =
      diagonal ![((D.σ₁ g)⁻¹ : Eˣ).val, ((D.σ₂ g)⁻¹ : Eˣ).val] := by
  intro g
  have h := congrArg (fun A : Matrix (Fin 2) (Fin 2) E => A.transpose) (D.dual_compare g⁻¹)
  simpa only [Subgroup.coe_inv, map_inv, inv_inv, transpose_transpose, diagonal_transpose] using h

/-- With the two duals, the character on each line is `μ(rec(w))⁻¹ · ω(rec(w))¹/²`.
This is computed before specializing to inertia or Frobenius. -/
theorem CarayolPrincipal.weil_values {E : Type*} [Field E] {P : O12.LocalPair p}
    {ρ : GalQ →* GL (Fin 2) E} {C : ReciprocityAt P} {μ₁ μ₂ halfMod : LocalCharacter p E}
    (D : CarayolPrincipal P ρ C μ₁ μ₂ halfMod) (w : weilAt P) :
    let d := (Subgroup.inclusion (weilAt_le_decomposition P)) w
    (↑(D.b * ρ d * D.b⁻¹) : Matrix (Fin 2) (Fin 2) E) =
      diagonal ![((μ₁ (C.toUnits w))⁻¹ * halfMod (C.toUnits w) : Eˣ).val,
        ((μ₂ (C.toUnits w))⁻¹ * halfMod (C.toUnits w) : Eˣ).val] := by
  dsimp only
  rw [D.character_lines]
  obtain ⟨h₁, h₂⟩ := D.weil_formula w
  rw [h₁, h₂]
  simp [mul_comm]

/-- On inertia the first character is trivial and the second is the central character.
The inversion is immaterial because the prescribed character is quadratic. -/
theorem CarayolPrincipal.on_inertia {E : Type*} [Field E] {P : O12.LocalPair p}
    {ρ : GalQ →* GL (Fin 2) E} {C : ReciprocityAt P} {μ₁ μ₂ halfMod χ : LocalCharacter p E}
    (D : CarayolPrincipal P ρ C μ₁ μ₂ halfMod) (hμ₁ : charTrivialAt p μ₁ 0)
    (hhalf : charTrivialAt p halfMod 0) (hχ : χ = μ₁ * μ₂)
    (hquad : ∀ w : weilAt P, (w : GalQ) ∈ P.Q.inertia GalQ →
      (χ (C.toUnits w) : E) = if bitChar p (w : GalQ) = 1 then 1 else -1)
    {g : GalQ} (hg : g ∈ P.Q.inertia GalQ) :
    (↑(D.b * ρ g * D.b⁻¹) : Matrix (Fin 2) (Fin 2) E) =
      diagonal ![1, if bitChar p g = 1 then 1 else -1] := by
  let w : weilAt P := ⟨g, Subgroup.subset_closure (Or.inl hg)⟩
  have hu : unitAtLevel p 0 (C.toUnits w) := ⟨C.inertia_unit w hg, Or.inl rfl⟩
  have h := D.weil_values w
  change (↑(D.b * ρ g * D.b⁻¹) : Matrix (Fin 2) (Fin 2) E) = _ at h
  rw [h, hμ₁ _ hu, hhalf _ hu]
  have e : χ (C.toUnits w) = μ₂ (C.toUnits w) := by
    simp [hχ, hμ₁ _ hu]
  have hsign := hquad w hg
  rw [e] at hsign
  change (μ₂ (C.toUnits w) : E) = _ at hsign
  simp only [inv_one, mul_one, Units.val_one, Units.val_inv_eq_inv_val]
  rw [hsign]
  change _ = diagonal ![1, if bitChar p (w : GalQ) = 1 then 1 else -1]
  split <;> simp_all

/-- On the unramified line, any arithmetic Frobenius lift gives the same scalar
`√p · μ₁(p)`. The second eigenvalue uses the actual lift. -/
theorem CarayolPrincipal.on_frobenius {E : Type*} [Field E] {P : O12.LocalPair p}
    {ρ : GalQ →* GL (Fin 2) E} {C : ReciprocityAt P} {μ₁ μ₂ halfMod : LocalCharacter p E}
    (D : CarayolPrincipal P ρ C μ₁ μ₂ halfMod) (hμ₁ : charTrivialAt p μ₁ 0)
    (hhalf : charTrivialAt p halfMod 0) :
    ∃ z : E, (↑(D.b * ρ P.φ * D.b⁻¹) : Matrix (Fin 2) (Fin 2) E) =
      diagonal ![((halfMod (uniformizer p))⁻¹ : Eˣ).val * (μ₁ (uniformizer p) : E), z] := by
  let w : weilAt P := ⟨P.φ, Subgroup.subset_closure (Or.inr (Set.mem_singleton _))⟩
  obtain ⟨u, hu, hr⟩ := C.frob_value w rfl
  have hu' : unitAtLevel p 0 u := ⟨hu, Or.inl rfl⟩
  refine ⟨((μ₂ (C.toUnits w))⁻¹ * halfMod (C.toUnits w) : Eˣ).val, ?_⟩
  have h := D.weil_values w
  change (↑(D.b * ρ P.φ * D.b⁻¹) : Matrix (Fin 2) (Fin 2) E) = _ at h
  rw [h]
  congr 2
  simp [hr, hμ₁ u hu', hhalf u hu', mul_comm]

/-- PRINT: the level-prime-to-`p` case of Carayol, Théorème A (UNVERIFIED),
as already used for the unramified constituent data of the ambient constructor.
Only triviality on absolute inertia of the existing `ρ` is needed here. -/
def CarayolUnramified {E : Type*} [Field E] (P : O12.LocalPair p)
    (ρ : GalQ →* GL (Fin 2) E) : Prop :=
  ∀ g ∈ P.Q.inertia GalQ, ρ g = 1

#print axioms weilAt_le_decomposition
#print axioms CarayolPrincipal.character_lines
#print axioms CarayolPrincipal.weil_values
#print axioms CarayolPrincipal.on_inertia
#print axioms CarayolPrincipal.on_frobenius

end ZInQ.Manuscript.RC.O12Local
