/-! The coefficient ring in tex 8567–8570, and contraction of powers of two.
The elementary contraction proof is provenance (c). -/

namespace ZInQ.Manuscript.RC.LocalWeights

open NumberField IsDedekindDomain

/-- Contraction of (2^M) to the rational integers in any domain where 2 is a nonunit. -/
theorem ring_two_of_nonunit {O : Type*} [CommRing O] [IsDomain O] [CharZero O]
    (h₂ : ¬ IsUnit (2 : O)) (M : ℕ) (z : ℤ) :
    (2 : O) ^ M ∣ (z : O) ↔ (2 : ℤ) ^ M ∣ z := by
  refine ⟨?_, fun h => by simpa using (map_dvd (Int.castRingHom O) h)⟩
  induction M generalizing z with
  | zero => simp
  | succ M ih =>
    intro h
    have htwo : (2 : O) ∣ (z : O) :=
      (dvd_pow_self _ (Nat.succ_ne_zero M)).trans h
    have hz : (2 : ℤ) ∣ z := by
      by_contra hh
      have hre : z = 2 * (z / 2) + 1 := by omega
      obtain ⟨t, ht⟩ := htwo
      have hre' := congrArg (Int.castRingHom O) hre
      simp only [map_add, map_mul, map_ofNat, map_one] at hre'
      change (z : O) = 2 * ((z / 2 : ℤ) : O) + 1 at hre'
      rw [hre'] at ht
      have h1 : (2 : O) ∣ 1 := ⟨t - ((z / 2 : ℤ) : O), by linear_combination ht⟩
      exact h₂ (isUnit_of_dvd_one h1)
    obtain ⟨y, rfl⟩ := hz
    rw [Int.cast_mul, Int.cast_ofNat, pow_succ'] at h
    have h' : (2 : O) ^ M ∣ (y : O) := by
      obtain ⟨a, ha⟩ := h
      refine ⟨a, mul_left_cancel₀ (show (2 : O) ≠ 0 by norm_num) ?_⟩
      simpa only [mul_assoc] using ha
    simpa only [pow_succ'] using mul_dvd_mul_left (2 : ℤ) ((ih y) h')

variable (K : Type*) [Field K] [NumberField K]

/-- The coefficient ring is the valuation subring of the character field (K) at (v).
The relevant places are those containing 2 in their prime ideal. -/
abbrev coefficientRing (v : HeightOneSpectrum (𝓞 K)) : Type _ :=
  (v.valuation K).valuationSubring.toSubring

theorem coefficientRing_two (v : HeightOneSpectrum (𝓞 K))
    (hv : (2 : 𝓞 K) ∈ v.asIdeal) (M : ℕ) (z : ℤ) :
    (2 : coefficientRing K v) ^ M ∣ (z : coefficientRing K v) ↔ (2 : ℤ) ^ M ∣ z := by
  apply ring_two_of_nonunit _ M z
  intro hu
  obtain ⟨u, hu⟩ := hu
  have hv₂ : v.valuation K (2 : K) < 1 := by
    rw [← map_ofNat (algebraMap (𝓞 K) K) (n := 2)]
    exact (v.valuation_lt_one_iff_mem (K := K) (2 : 𝓞 K)).2 hv
  have hle : v.valuation K (((↑(u⁻¹) : coefficientRing K v)) : K) ≤ 1 :=
    (↑(u⁻¹) : coefficientRing K v).property
  have hprod : (2 : K) * (((↑(u⁻¹) : coefficientRing K v)) : K) = 1 := by
    have hu' := congrArg (fun a : coefficientRing K v => (a : K)) hu
    change (u.val : K) = (2 : K) at hu'
    rw [← hu']
    exact congrArg (fun a : coefficientRing K v => (a : K)) (Units.mul_inv u)
  have hle' := mul_le_mul_of_nonneg_left hle (zero_le : 0 ≤ v.valuation K (2 : K))
  rw [← map_mul, hprod, map_one, mul_one] at hle'
  exact (not_le_of_gt hv₂) hle'

/-- A place above two exists for every number field, by lying over. -/
theorem coefficientPlace_exists :
    ∃ v : HeightOneSpectrum (𝓞 K), (2 : 𝓞 K) ∈ v.asIdeal := by
  let P : Ideal ℤ := Ideal.span {(2 : ℤ)}
  have hp : Prime (2 : ℤ) := Nat.prime_iff_prime_int.mp Nat.prime_two
  have : P.IsPrime := Ideal.isPrime_span_singleton_of_prime hp
  have : P.IsMaximal := this.isMaximal (by simp [P])
  obtain ⟨Q, hQ, hQP⟩ := Ideal.exists_maximal_ideal_liesOver_of_isIntegral (S := 𝓞 K) P
  have hm : (2 : 𝓞 K) ∈ Q := by
    have h : (2 : ℤ) ∈ Q.under ℤ := by
      rw [← (Ideal.liesOver_iff Q P).mp hQP]
      exact Ideal.subset_span (Set.mem_singleton _)
    change algebraMap ℤ (𝓞 K) 2 ∈ Q at h
    simpa only [map_ofNat] using h
  refine ⟨⟨Q, hQ.isPrime, ?_⟩, hm⟩
  intro h
  rw [h, Ideal.mem_bot] at hm
  exact two_ne_zero hm

/-- A two-power root of unity is integral at the chosen place. -/
theorem primitiveRoot_integralAt (v : HeightOneSpectrum (𝓞 K)) {k : ℕ} {ζ : K}
    (hζ : IsPrimitiveRoot ζ (2 ^ k)) :
    ∃ η : coefficientRing K v, (η : K) = ζ ∧ IsPrimitiveRoot η (2 ^ k) := by
  let a : 𝓞 K := ⟨ζ, hζ.isIntegral (by positivity)⟩
  let η : coefficientRing K v := ⟨ζ, v.valuation_le_one (K := K) a⟩
  exact ⟨η, rfl, (IsPrimitiveRoot.map_iff_of_injective (f := Subring.subtype _) Subtype.val_injective).mp hζ⟩

/-- The field generated by the fixed character values really is cyclotomic with a
two-power conductor parameter, using the largest order occurring among the values
(provenance (c)). The bound can be the maximum of the finitely many character exponents. -/
theorem characterField_cyclotomic {S : Set ℂ}
    (h : ∃ k : ℕ, ∀ z ∈ S, z ^ (2 ^ k) = 1) :
    ∃ k : ℕ, IsCyclotomicExtension {2 ^ k} ℚ (IntermediateField.adjoin ℚ S) := by
  classical
  let k := Nat.find h
  have hk : ∀ z ∈ S, z ^ (2 ^ k) = 1 := Nat.find_spec h
  have hprim : ∃ ζ : ℂ, (ζ = 1 ∨ ζ ∈ S) ∧ IsPrimitiveRoot ζ (2 ^ k) := by
    by_cases h0 : k = 0
    · exact ⟨1, Or.inl rfl, by simpa only [h0, pow_zero] using (IsPrimitiveRoot.one (M := ℂ))⟩
    · have hmin := Nat.find_min h (m := k - 1) (show k - 1 < k by omega)
      push Not at hmin
      obtain ⟨ζ, hζS, hζ⟩ := hmin
      refine ⟨ζ, Or.inr hζS, IsPrimitiveRoot.iff_orderOf.mpr ?_⟩
      obtain ⟨j, hj, hord⟩ := (Nat.dvd_prime_pow Nat.prime_two).mp
        (orderOf_dvd_of_pow_eq_one (hk ζ hζS))
      have hnj : ¬ j < k := by
        intro hlt
        apply hζ
        exact orderOf_dvd_iff_pow_eq_one.mp (hord ▸ pow_dvd_pow 2 (show j ≤ k - 1 by omega))
      exact hord.trans (congrArg (fun a : ℕ => 2 ^ a) (by omega))
  obtain ⟨ζ, hζS, hζ⟩ := hprim
  have : NeZero (2 ^ k) := ⟨by positivity⟩
  refine ⟨k, (IntermediateField.isCyclotomicExtension_singleton_iff_eq_adjoin
    (2 ^ k) ℚ ℂ (IntermediateField.adjoin ℚ S) hζ).mpr ?_⟩
  apply le_antisymm
  · refine IntermediateField.adjoin_le_iff.mpr fun z hz => ?_
    have hmem : ζ ∈ IntermediateField.adjoin ℚ ({ζ} : Set ℂ) :=
      IntermediateField.subset_adjoin ℚ _ (Set.mem_singleton _)
    obtain ⟨j, -, rfl⟩ := hζ.eq_pow_of_pow_eq_one (hk z hz)
    exact pow_mem hmem j
  · apply IntermediateField.adjoin_le_iff.mpr
    intro z hz
    have he : z = ζ := hz
    subst z
    rcases hζS with hζS | hζS
    · rw [hζS]
      exact one_mem _
    · exact IntermediateField.subset_adjoin ℚ S hζS

/-- The character field is a number field, so its finite places are available. -/
theorem characterField_numberField {S : Set ℂ}
    (h : ∃ k : ℕ, ∀ z ∈ S, z ^ (2 ^ k) = 1) :
    NumberField (IntermediateField.adjoin ℚ S) := by
  obtain ⟨k, hk⟩ := characterField_cyclotomic h
  let := hk
  exact IsCyclotomicExtension.numberField {2 ^ k} ℚ _

/-- A root of unity and its inverse may both be evaluated in the coefficient ring. -/
theorem rootOfUnity_mem_coefficientRing (v : HeightOneSpectrum (𝓞 K)) {n : ℕ}
    (hn : 0 < n) {a : K} (ha : a ^ n = 1) :
    a ∈ (v.valuation K).valuationSubring.toSubring := by
  let a' : 𝓞 K := ⟨a, IsIntegral.of_pow hn (ha.symm ▸ isIntegral_one)⟩
  exact v.valuation_le_one (K := K) a'

/-- A fixed complex character lifts, with all its values unchanged, to the
valuation ring of the field generated by the fixed characters (tex 8567–8570). -/
theorem character_lifts_to_coefficients {G : Type*} [Group G] (χ : G →* ℂˣ)
    (S : Set ℂ) (hS : ∀ u, (χ u : ℂ) ∈ S) {n : ℕ} (hn : 0 < n)
    (hpow : ∀ u, χ u ^ n = 1) [NumberField (IntermediateField.adjoin ℚ S)]
    (v : HeightOneSpectrum (𝓞 (IntermediateField.adjoin ℚ S))) :
    ∃ χ' : G →* (coefficientRing (IntermediateField.adjoin ℚ S) v)ˣ,
      ∀ u, ((((χ' u).val : IntermediateField.adjoin ℚ S)) : ℂ) = (χ u : ℂ) := by
  let F := IntermediateField.adjoin ℚ S
  let z (u : G) : F := ⟨(χ u : ℂ), IntermediateField.subset_adjoin ℚ S (hS u)⟩
  have hroot (u : G) : z u ^ n = 1 :=
    Subtype.ext (congrArg (fun b : ℂˣ => (b : ℂ)) (hpow u))
  let a (u : G) : coefficientRing F v :=
    ⟨z u, rootOfUnity_mem_coefficientRing F v hn (hroot u)⟩
  have hmul (u w : G) : a (u * w) = a u * a w :=
    Subtype.ext (Subtype.ext (congrArg (fun b : ℂˣ => (b : ℂ)) (map_mul χ u w)))
  have hone : a 1 = 1 :=
    Subtype.ext (Subtype.ext (congrArg (fun b : ℂˣ => (b : ℂ)) (map_one χ)))
  let A (u : G) : (coefficientRing F v)ˣ :=
    ⟨a u, a u⁻¹, by rw [← hmul, mul_inv_cancel, hone], by rw [← hmul, inv_mul_cancel, hone]⟩
  exact ⟨{ toFun := A
           map_one' := Units.ext hone
           map_mul' := fun u w => Units.ext (hmul u w) }, fun _ => rfl⟩

