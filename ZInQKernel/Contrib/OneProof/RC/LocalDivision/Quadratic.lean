import ZInQKernel.Contrib.OneProof.RC.LocalDivision.Residue

/-! The quadratic subfield generated by `i`, with its integral and residue
coordinates. The explicit description of unramifiedness is provenance (c). -/

namespace ZInQ.Manuscript.RC.LocalDivision

variable {p : ℕ} [Fact p.Prime] [Fact (p % 4 = 3)]

abbrev QuadraticD (p : ℕ) [Fact p.Prime] := QuadraticAlgebra ℚ_[p] (-1) 0
abbrev IntegralQuadraticD (p : ℕ) [Fact p.Prime] := QuadraticAlgebra ℤ_[p] (-1) 0

theorem padic_neg_one_nonsquare : ¬ IsSquare (-1 : ℚ_[p]) := by
  rintro ⟨a, ha⟩
  have he : a ^ 2 + 1 ^ 2 = 0 := by rw [pow_two, ← ha]; ring
  have hh := norm_pair (Fact.out : p % 4 = 3) a 1
  rw [he, norm_zero, norm_one] at hh
  have hn := pow_le_pow_left₀ (by norm_num : (0 : ℝ) ≤ 1) (le_max_right ‖a‖ 1) 2
  linarith

local instance : Fact (¬ IsSquare (-1 : ℚ_[p])) := ⟨padic_neg_one_nonsquare⟩

noncomputable instance : Field (QuadraticD p) :=
  inferInstanceAs (Field (QuadraticAlgebra ℚ_[p] (-1) 0))

omit [Fact (p % 4 = 3)] in
theorem quadratic_rank : Module.finrank ℚ_[p] (QuadraticD p) = 2 :=
  QuadraticAlgebra.finrank_eq_two _ _

/-- The center and `i` span the quadratic subfield in the quaternion algebra. -/
noncomputable def quadraticInclusion : QuadraticD p →ₐ[ℚ_[p]] D p :=
  QuadraticAlgebra.lift ⟨⟨0, 1, 0, 0⟩, by
    apply QuaternionAlgebra.ext <;> simp⟩

omit [Fact (p % 4 = 3)] in
theorem quadraticInclusion_apply (z : QuadraticD p) :
    quadraticInclusion z = ⟨z.re, z.im, 0, 0⟩ := by
  change z.re • (1 : D p) + z.im • (⟨0, 1, 0, 0⟩ : D p) = _
  apply QuaternionAlgebra.ext <;> simp

omit [Fact (p % 4 = 3)] in
theorem quadraticInclusion_injective : Function.Injective (quadraticInclusion (p := p)) := by
  intro x y h
  rw [quadraticInclusion_apply, quadraticInclusion_apply] at h
  exact QuadraticAlgebra.ext (congrArg QuaternionAlgebra.re h) (congrArg QuaternionAlgebra.imI h)

omit [Fact (p % 4 = 3)] in
theorem quadraticInclusion_j (z : QuadraticD p) :
    (j : D p) * quadraticInclusion z = quadraticInclusion (star z) * j := by
  rw [quadraticInclusion_apply, quadraticInclusion_apply]
  simp only [QuadraticAlgebra.re_star, QuadraticAlgebra.im_star, zero_mul, add_zero]
  change (⟨0,0,1,0⟩ : D p) * ⟨z.re,z.im,0,0⟩ = ⟨z.re,-z.im,0,0⟩ * ⟨0,0,1,0⟩
  rw [QuaternionAlgebra.mk_mul_mk, QuaternionAlgebra.mk_mul_mk]
  congr 1 <;> ring

/-- The coefficientwise inclusion of the integral quadratic presentation. -/
noncomputable def quadraticIntegers : IntegralQuadraticD p →ₐ[ℤ_[p]] QuadraticD p where
  toFun z := ⟨z.re, z.im⟩
  map_zero' := rfl
  map_one' := rfl
  map_add' _ _ := rfl
  map_mul' _ _ := rfl
  commutes' _ := rfl

/-- The integral closure in the quadratic subfield is the span of `1, i`. -/
theorem quadratic_integral_iff (z : QuadraticD p) :
    IsIntegral ℤ_[p] z ↔ ∃ a : IntegralQuadraticD p, quadraticIntegers a = z := by
  constructor
  · intro hz
    have h := integral_mem_order (IsIntegral.map (quadraticInclusion (p := p)) hz)
    rw [quadraticInclusion_apply, mem_order] at h
    exact ⟨⟨⟨z.re, h.1⟩, ⟨z.im, h.2.1⟩⟩, QuadraticAlgebra.ext rfl rfl⟩
  · rintro ⟨a, rfl⟩
    exact (IsIntegral.of_finite ℤ_[p] a).map quadraticIntegers

/-- Coefficient reduction on the quadratic ring of integers. -/
noncomputable def quadraticRed : IntegralQuadraticD p →+* ResidueQuad p where
  toFun x := ⟨PadicInt.toZMod x.re, PadicInt.toZMod x.im⟩
  map_zero' := QuadraticAlgebra.ext (map_zero _) (map_zero _)
  map_one' := QuadraticAlgebra.ext (map_one _) (map_zero _)
  map_add' x y := QuadraticAlgebra.ext (map_add _ x.re y.re) (map_add _ x.im y.im)
  map_mul' x y := by
    rcases x with ⟨a, b⟩
    rcases y with ⟨c, d⟩
    rw [QuadraticAlgebra.mk_mul_mk]
    ext
    · change PadicInt.toZMod (a * c + (-1) * b * d) = _
      simp
    · change PadicInt.toZMod (a * d + b * c + 0 * b * d) = _
      simp

omit [Fact (p % 4 = 3)] in
theorem quadraticRed_surj : Function.Surjective (quadraticRed (p := p)) := by
  intro z
  obtain ⟨a, ha⟩ := ZMod.ringHom_surjective (PadicInt.toZMod (p := p)) z.re
  obtain ⟨b, hb⟩ := ZMod.ringHom_surjective (PadicInt.toZMod (p := p)) z.im
  exact ⟨⟨a, b⟩, QuadraticAlgebra.ext ha hb⟩

omit [Fact (p % 4 = 3)] in
/-- Here the residue ideal is generated by the base-field uniformizer itself. -/
theorem quadraticRed_ker :
    RingHom.ker (quadraticRed (p := p)) = Ideal.span {(p : IntegralQuadraticD p)} := by
  ext z
  rw [RingHom.mem_ker, Ideal.mem_span_singleton]
  have hr (a : ℤ_[p]) : PadicInt.toZMod a = 0 ↔ (p : ℤ_[p]) ∣ a :=
    (padic_red_eq_zero_iff a).trans (PadicInt.norm_lt_one_iff_dvd a)
  constructor
  · intro hz
    have ha : PadicInt.toZMod z.re = 0 := by
      exact congrArg QuadraticAlgebra.re hz
    have hb : PadicInt.toZMod z.im = 0 := by
      exact congrArg QuadraticAlgebra.im hz
    obtain ⟨a, ha⟩ := (hr _).mp ha
    obtain ⟨b, hb⟩ := (hr _).mp hb
    exact ⟨⟨a, b⟩, by ext <;> simp [ha, hb]⟩
  · rintro ⟨a, rfl⟩
    rw [map_mul, map_natCast]
    have hp : (p : ResidueQuad p) = 0 := by
      rw [← map_natCast (algebraMap (ZMod p) (ResidueQuad p)), ZMod.natCast_self, map_zero]
    rw [hp, zero_mul]

theorem quadraticRed_nonunit (z : IntegralQuadraticD p) : quadraticRed z = 0 ↔ ¬ IsUnit z := by
  have hn : z.norm = z.re ^ 2 + z.im ^ 2 := by
    rw [QuadraticAlgebra.norm_def]
    ring
  rw [QuadraticAlgebra.isUnit_iff_norm_isUnit, PadicInt.not_isUnit_iff,
    ← padic_red_eq_zero_iff, hn, map_add, map_pow, map_pow,
    residue_sum_sq_eq_zero (Fact.out : p % 4 = 3), QuadraticAlgebra.ext_iff]
  rfl

instance : IsLocalRing (IntegralQuadraticD p) := IsLocalRing.of_nonunits_add <| by
  intro x y hx hy
  change ¬ IsUnit x at hx
  change ¬ IsUnit y at hy
  change ¬ IsUnit (x + y)
  rw [← quadraticRed_nonunit, map_add, (quadraticRed_nonunit x).mpr hx,
    (quadraticRed_nonunit y).mpr hy, zero_add]

theorem quadratic_maximalIdeal :
    IsLocalRing.maximalIdeal (IntegralQuadraticD p) = Ideal.span {(p : IntegralQuadraticD p)} := by
  rw [← quadraticRed_ker]
  ext x
  rw [IsLocalRing.mem_maximalIdeal, RingHom.mem_ker, quadraticRed_nonunit]
  rfl

/-- The residue field of the quadratic integral model is the degree-two finite field. -/
noncomputable def quadraticResidueEquiv :
    IntegralQuadraticD p ⧸ IsLocalRing.maximalIdeal (IntegralQuadraticD p) ≃+* GaloisField p 2 := by
  have h : IsLocalRing.maximalIdeal (IntegralQuadraticD p) = RingHom.ker (quadraticRed (p := p)) :=
    quadratic_maximalIdeal.trans quadraticRed_ker.symm
  let e₁ : (IntegralQuadraticD p ⧸ IsLocalRing.maximalIdeal (IntegralQuadraticD p)) ≃+*
      (IntegralQuadraticD p ⧸ RingHom.ker (quadraticRed (p := p))) := Ideal.quotEquivOfEq h
  let e₂ : (IntegralQuadraticD p ⧸ RingHom.ker (quadraticRed (p := p))) ≃+* ResidueQuad p :=
    RingHom.quotientKerEquivOfSurjective (f := quadraticRed (p := p)) quadraticRed_surj
  let e₃ : ResidueQuad p ≃+* GaloisField p 2 := (residueEquiv (p := p)).toRingEquiv
  exact (e₁.trans e₂).trans e₃

omit [Fact (p % 4 = 3)] in
theorem quadratic_residue_degree : Module.finrank (ZMod p) (GaloisField p 2) = 2 :=
  GaloisField.finrank p (by decide)

omit [Fact (p % 4 = 3)] in
theorem quadratic_residue_separable : Algebra.IsSeparable (ZMod p) (GaloisField p 2) :=
  inferInstance

#print axioms padic_neg_one_nonsquare
#print axioms quadratic_rank
#print axioms quadraticInclusion_apply
#print axioms quadraticInclusion_injective
#print axioms quadraticInclusion_j
#print axioms quadratic_integral_iff
#print axioms quadraticRed_surj
#print axioms quadraticRed_ker
#print axioms quadraticRed_nonunit
#print axioms quadratic_maximalIdeal
#print axioms quadraticResidueEquiv
#print axioms quadratic_residue_degree
#print axioms quadratic_residue_separable

end ZInQ.Manuscript.RC.LocalDivision
