import ZInQKernel.Contrib.OneProof.RC.ModelGeneric6.CharFreeSeam

/-! # The order-two step and the composite, with degree, in every characteristic prime to the order

Continuation of `CharFreeSeam` (generic6 item 3a). The opens follow `RC/ModelGeneric4/OrderTwoStep`
(the vendored order-two function-field map `twoFFHom` is stated with the vendored
`polyToFunctionField` and `yGen` of those namespaces).

* `finrankAlong_twoFFHom_le`: the order-two Vélu map of function fields has degree at most two.
* `twoFFHom_seam`, `stepSeam_two`: generic4's order-two seam and step without `[CharZero k]`, with
  `(2 : k) ≠ 0`; the step has degree exactly two (`finrankAlong_ne_one_of_seam`).
* `exists_quotientSeam`: **separable seams** for the vendored Vélu composite: `g.ker = H` and
  `finrankAlong k ι = n`, for every cyclic `H` of order `n` with every prime factor of `n`
  nonzero in `k`. -/

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 2000000
set_option synthInstance.maxHeartbeats 400000
set_option linter.style.haveILetI false

noncomputable section

namespace ZInQ.Manuscript.RC.ModelGeneric6

open AlgebraicCurve Polynomial WeierstrassCurve

variable {k : Type} [Field k] [DecidableEq k] [IsAlgClosed k]

section OrderTwo

open P2MW.S_WeierstrassCurve_exists_veluFunctionFieldHom_restrictAlong_placeOfPoint_eq_of_isAlgClosed.WeierstrassCurve.Affine
open P2MW.S_WeierstrassCurve_exists_veluFunctionFieldHom_restrictAlong_placeOfPoint_eq_of_isAlgClosed.AlgebraicCurve.Place

attribute [-instance] WeierstrassCurve.Affine.CoordinateRing.moduleFinite
  WeierstrassCurve.Affine.instDecidableEqFunctionField WeierstrassCurve.Affine.CoordinateRing.isIntegral
  WeierstrassCurve.Affine.instIsScalarTowerPolynomialRatFuncFunctionField_definitions
  WeierstrassCurve.Affine.instAlgebraRatFuncFunctionField_definitions
  WeierstrassCurve.Affine.instIsScalarTowerRatFuncFunctionField_definitions

/-- **The order-two Vélu map of function fields has degree at most two.** The function field
of `W` is generated over the image by `x` (since `y` is a rational function of `x` and of the
image of the quotient's `y`), and `x` is a root of the monic quadratic
`T² - (u + x₀)T + (u x₀ + G)` over the image, `u` the image of the quotient's `x`. -/
theorem finrankAlong_twoFFHom_le (W : WeierstrassCurve k) [W.IsElliptic] {x₀ y₀ : k}
    (h2 : (2 : k) ≠ 0) (hQ : W.toAffine.Equation x₀ y₀) (hgy : W.veluGy x₀ y₀ = 0) :
    finrankAlong k (ModelLevels.ModelGeneric4.twoFFHom h2 hQ hgy) ≤ 2 := by
  letI : Algebra (W.veluQuotient2 x₀ y₀).toAffine.FunctionField W.toAffine.FunctionField :=
    (ModelLevels.ModelGeneric4.twoFFHom h2 hQ hgy).toRingHom.toAlgebra
  have hG : W.veluGx x₀ y₀ ≠ 0 := W.veluGx_ne_zero_of_two_torsion W.isUnit_Δ.ne_zero hQ hgy
  let u : (W.veluQuotient2 x₀ y₀).toAffine.FunctionField :=
    polyToFunctionField (W.veluQuotient2 x₀ y₀).toAffine X
  let a₀ := algebraMap k (W.veluQuotient2 x₀ y₀).toAffine.FunctionField
  let p : Polynomial (W.veluQuotient2 x₀ y₀).toAffine.FunctionField :=
    X ^ 2 + (C (-(u + a₀ x₀)) * X + C (u * a₀ x₀ + a₀ (W.veluGx x₀ y₀)))
  have hp : p.Monic := monic_X_pow_add (by exact_mod_cast degree_linear_lt)
  have hu : algebraMap _ W.toAffine.FunctionField u = ModelLevels.ModelGeneric4.twoXFun W x₀ y₀ :=
    ModelLevels.ModelGeneric4.twoFFHom_X h2 hQ hgy
  have hc : ∀ c : k, algebraMap (W.veluQuotient2 x₀ y₀).toAffine.FunctionField
      W.toAffine.FunctionField (a₀ c) = algebraMap k W.toAffine.FunctionField c :=
    fun c => (ModelLevels.ModelGeneric4.twoFFHom h2 hQ hgy).commutes c
  have hδ : polyToFunctionField W.toAffine X - algebraMap k W.toAffine.FunctionField x₀ ≠ 0 :=
    sub_ne_zero.mpr (polyToFunctionField_X_ne_algebraMap x₀)
  have hroot : aeval (polyToFunctionField W.toAffine X) p = 0 := by
    simp only [p, map_add, map_mul, map_pow, aeval_X, aeval_C, map_neg, hu, hc]
    simp only [ModelLevels.ModelGeneric4.twoXFun]
    field_simp
    ring
  have hx : IsIntegral (W.veluQuotient2 x₀ y₀).toAffine.FunctionField
      (polyToFunctionField W.toAffine X) := ⟨p, hp, hroot⟩
  -- `y` lies in the field generated by `x`.
  let K := IntermediateField.adjoin (W.veluQuotient2 x₀ y₀).toAffine.FunctionField
    ({polyToFunctionField W.toAffine X} : Set W.toAffine.FunctionField)
  have hcK : ∀ c : k, algebraMap k W.toAffine.FunctionField c ∈ K := fun c => by
    rw [← hc c]; exact K.algebraMap_mem _
  have hxK : polyToFunctionField W.toAffine X ∈ K := IntermediateField.mem_adjoin_simple_self _ _
  have hYK : ModelLevels.ModelGeneric4.twoYFun W x₀ y₀ ∈ K := by
    rw [← ModelLevels.ModelGeneric4.twoFFHom_Y h2 hQ hgy]; exact K.algebraMap_mem _
  have hpolyne : ((X - C x₀) ^ 2 - C (W.veluGx x₀ y₀) : Polynomial k) ≠ 0 := by
    refine Monic.ne_zero (Monic.sub_of_left ((monic_X_sub_C x₀).pow 2) ?_)
    rw [degree_pow, degree_X_sub_C]
    exact lt_of_le_of_lt degree_C_le (by norm_num)
  have hD : (polyToFunctionField W.toAffine X - algebraMap k W.toAffine.FunctionField x₀) ^ 2 -
      algebraMap k W.toAffine.FunctionField (W.veluGx x₀ y₀) ≠ 0 := by
    intro h0
    apply hpolyne
    apply polyToFunctionField_injective (W := W.toAffine)
    rw [map_zero, map_sub, map_pow, map_sub, polyToFunctionField_C, polyToFunctionField_C]
    exact h0
  have hyeq : yGen W.toAffine =
      (ModelLevels.ModelGeneric4.twoYFun W x₀ y₀ *
          (polyToFunctionField W.toAffine X - algebraMap k _ x₀) ^ 2 +
        algebraMap k _ (W.veluGx x₀ y₀) *
          (algebraMap k _ W.a₁ * (polyToFunctionField W.toAffine X - algebraMap k _ x₀) -
            algebraMap k _ y₀)) /
      ((polyToFunctionField W.toAffine X - algebraMap k W.toAffine.FunctionField x₀) ^ 2 -
        algebraMap k W.toAffine.FunctionField (W.veluGx x₀ y₀)) := by
    rw [eq_div_iff hD]
    simp only [ModelLevels.ModelGeneric4.twoYFun]
    field_simp
    ring
  have hyK : yGen W.toAffine ∈ K := by
    rw [hyeq]
    refine div_mem (add_mem (mul_mem hYK (pow_mem (sub_mem hxK (hcK _)) 2))
      (mul_mem (hcK _) (sub_mem (mul_mem (hcK _) (sub_mem hxK (hcK _))) (hcK _))))
      (sub_mem (pow_mem (sub_mem hxK (hcK _)) 2) (hcK _))
  have htop : K = ⊤ := by
    rw [eq_top_iff, ← ModelLevels.ModelGeneric4.adjoin_X_yGen_eq_top_twoFFHom h2 hQ hgy]
    apply IntermediateField.adjoin_le_iff.mpr
    rintro z (rfl | rfl)
    · exact hxK
    · exact hyK
  change Module.finrank (W.veluQuotient2 x₀ y₀).toAffine.FunctionField W.toAffine.FunctionField ≤ 2
  rw [← IntermediateField.finrank_top', ← htop, IntermediateField.adjoin.finrank hx]
  calc (minpoly _ (polyToFunctionField W.toAffine X)).natDegree ≤ p.natDegree :=
        natDegree_le_natDegree (minpoly.degree_le_of_ne_zero _ _ hp.ne_zero hroot)
    _ = 2 := by
        rw [natDegree_add_eq_left_of_degree_lt (by rw [degree_X_pow]; exact_mod_cast degree_linear_lt),
          natDegree_X_pow]

/-- The order-two seam with the characteristic-free gates (copy of generic4's `twoFFHom_seam`
without `[CharZero k]`). -/
theorem twoFFHom_seam (W : WeierstrassCurve k) [W.IsElliptic] {x₀ y₀ : k}
    (h2 : (2 : k) ≠ 0) (hQ : W.toAffine.Equation x₀ y₀) (hgy : W.veluGy x₀ y₀ = 0)
    (hΔ : (W.veluQuotient2 x₀ y₀).Δ ≠ 0) (P : W.toAffine.Point) :
    haveI : (W.veluQuotient2 x₀ y₀).IsElliptic := ⟨isUnit_iff_ne_zero.mpr hΔ⟩
    (pointPlace W P).restrictAlong (ModelLevels.ModelGeneric4.twoFFHom h2 hQ hgy)
        (ModelLevels.ModelGeneric4.twoFFHom_isIntegral h2 hQ hgy) =
      pointPlace (W.veluQuotient2 x₀ y₀) (veluPointMap2 h2 hQ hgy hΔ P) := by
  haveI hV : (W.veluQuotient2 x₀ y₀).IsElliptic := ⟨isUnit_iff_ne_zero.mpr hΔ⟩
  haveI := WeierstrassCurve.Affine.CoordinateRing.isDedekindDomain W
  haveI := WeierstrassCurve.Affine.CoordinateRing.isDedekindDomain (W.veluQuotient2 x₀ y₀)
  letI := gate W
  haveI := gate_isCentred W
  letI := gate (W.veluQuotient2 x₀ y₀)
  haveI := gate_isCentred (W.veluQuotient2 x₀ y₀)
  change Place.restrictAlong _ _ (placeOfPoint P) = placeOfPoint _
  have hG : W.veluGx x₀ y₀ ≠ 0 := W.veluGx_ne_zero_of_two_torsion W.isUnit_Δ.ne_zero hQ hgy
  cases P with
  | zero =>
      rw [veluPointMap2_zero, placeOfPoint_zero, placeOfPoint_zero]
      exact ModelLevels.ModelGeneric4.twoFFHom_restrict_infinite h2 hQ hgy
  | some r s h =>
      by_cases hr : r = x₀
      · rw [veluPointMap2_some_of_eq _ _ _ _ h hr, placeOfPoint_some, placeOfPoint_zero]
        refine InfinitePlace.eq_of_not_isFinitePlace _ ?_
        intro hfin
        refine ModelLevels.ModelGeneric4.twoXFun_notMem_placeOfEquation_of_eq (W := W) (y₀ := y₀)
          h.1 hr hG ?_
        rw [← ModelLevels.ModelGeneric4.twoFFHom_X h2 hQ hgy, ← mem_restrictAlong_iff,
          polyToFunctionField_apply]
        exact hfin _
      · rw [veluPointMap2_some_of_ne _ _ _ _ h hr, placeOfPoint_some, placeOfPoint_some]
        exact ModelLevels.ModelGeneric4.twoFFHom_restrict_placeOfEquation_of_ne h2 hQ hgy h.1 hr _

end OrderTwo

open P2MW.S_WeierstrassCurve_bijOn_cyclicQuotientJ_isRoot_modularPolynomial_of_transcendental_j.P2MKcKI
  in
/-- The order-two step, with degree two (copy of generic4's `stepSeam_two` with `(2 : k) ≠ 0`
in place of characteristic 0). -/
theorem stepSeam_two (h2 : (2 : k) ≠ 0) : StepSeam (k := k) 2 := by
  intro E _ H _ _ hdvd
  let := Fintype.ofFinite H
  obtain ⟨q, hq⟩ := exists_prime_addOrderOf_dvd_card (G := H) 2
    (by rwa [Fintype.card_eq_nat_card])
  have hQ2 : addOrderOf (q : E.toAffine.Point) = 2 :=
    (addOrderOf_injective H.subtype Subtype.coe_injective q).trans hq
  have hQ0 : (q : E.toAffine.Point) ≠ 0 := by
    intro h0; rw [h0, addOrderOf_zero] at hQ2; omega
  obtain ⟨x₀, y₀, hns, hqe⟩ : ∃ x₀ y₀ h, (q : E.toAffine.Point) = .some x₀ y₀ h := by
    rcases hqP : (q : E.toAffine.Point) with _ | ⟨x₀, y₀, h⟩
    · exact absurd hqP hQ0
    · exact ⟨x₀, y₀, h, rfl⟩
  have hgy : E.veluGy x₀ y₀ = 0 := by
    have h2Q : (2 : ℕ) • (q : E.toAffine.Point) = 0 := hQ2 ▸ addOrderOf_nsmul_eq_zero _
    rw [two_nsmul, hqe, ← eq_neg_iff_add_eq_zero, WeierstrassCurve.Affine.Point.neg_some] at h2Q
    have hy := (WeierstrassCurve.Affine.Point.some.inj h2Q).2
    rw [WeierstrassCurve.Affine.negY] at hy
    rw [veluGy]
    linear_combination -hy
  have hΔ := veluQuotient2_Delta_ne_zero E.isUnit_Δ.ne_zero hns.1 hgy
  haveI hV : (E.veluQuotient2 x₀ y₀).IsElliptic := ⟨isUnit_iff_ne_zero.mpr hΔ⟩
  obtain ⟨φ, hφ⟩ := E.exists_addMonoidHom_coe_eq_veluPointMap2 h2 hns.1 hgy hΔ
  have hQH : (WeierstrassCurve.Affine.Point.some x₀ y₀ hns : E.toAffine.Point) ∈ H :=
    hqe ▸ q.property
  have hbridge := E.stepCurve_stepSubgroup_two_eq h2 H hns hQH hgy hΔ φ hφ
  have hker : φ.ker = AddSubgroup.zmultiples (WeierstrassCurve.Affine.Point.some x₀ y₀ hns) := by
    rw [← hqe]
    ext P
    rw [mem_ker_veluPointMap2 E h2 hns.1 hgy hΔ φ hφ]
    have hord : addOrderOf (q : E.toAffine.Point) = 2 := hQ2
    constructor
    · rintro (rfl | hP)
      · exact AddSubgroup.zero_mem _
      · rw [hP, ← hqe]; exact AddSubgroup.mem_zmultiples _
    · intro hP
      obtain ⟨m, rfl⟩ := AddSubgroup.mem_zmultiples_iff.1 hP
      have hk : (m % 2) • (q : E.toAffine.Point) = m • (q : E.toAffine.Point) := by
        have := mod_addOrderOf_zsmul (q : E.toAffine.Point) m
        rwa [hord, Nat.cast_ofNat] at this
      rcases Int.emod_two_eq_zero_or_one m with h | h
      · left; rw [← hk, h, zero_smul]
      · right; rw [← hk, h, one_smul, hqe]
  have hseam : IsSeam (ModelLevels.ModelGeneric4.twoFFHom h2 hns.1 hgy)
      (ModelLevels.ModelGeneric4.twoFFHom_isIntegral h2 hns.1 hgy) φ := by
    intro P
    rw [show φ P = veluPointMap2 h2 hns.1 hgy hΔ P from congrFun hφ P]
    exact twoFFHom_seam E h2 hns.1 hgy hΔ P
  have hdeg : finrankAlong k (ModelLevels.ModelGeneric4.twoFFHom h2 hns.1 hgy) = 2 := by
    have hle := finrankAlong_twoFFHom_le E h2 hns.1 hgy
    have hne := finrankAlong_ne_one_of_seam _ _ φ hseam
      (P := WeierstrassCurve.Affine.Point.some x₀ y₀ hns) (by simp)
      (by rw [← AddMonoidHom.mem_ker, hker]; exact AddSubgroup.mem_zmultiples _)
    have hpos : 0 < finrankAlong k (ModelLevels.ModelGeneric4.twoFFHom h2 hns.1 hgy) := by
      letI := algebraAlong (ModelLevels.ModelGeneric4.twoFFHom h2 hns.1 hgy)
      haveI : Module.Finite (E.veluQuotient2 x₀ y₀).toAffine.FunctionField E.toAffine.FunctionField :=
        ModelLevels.ModelGeneric4.twoFFHom_finiteAlong h2 hns.1 hgy
      exact Module.finrank_pos
    omega
  have result (s : Σ V : WeierstrassCurve k, AddSubgroup V.toAffine.Point)
      (hs : s = ⟨E.veluQuotient2 x₀ y₀, H.map φ⟩) :
      ∃ _ : s.1.IsElliptic,
        ∃ (ι : s.1.toAffine.FunctionField →ₐ[k] E.toAffine.FunctionField)
          (hι : ι.toRingHom.IsIntegral), FiniteAlong k ι ∧ finrankAlong k ι = 2 ∧
          ∃ f : E.toAffine.Point →+ s.1.toAffine.Point,
            f.ker ≤ H ∧ Nat.card f.ker = 2 ∧ H.map f = s.2 ∧ IsSeam ι hι f := by
    subst hs
    refine ⟨hV, ModelLevels.ModelGeneric4.twoFFHom h2 hns.1 hgy,
      ModelLevels.ModelGeneric4.twoFFHom_isIntegral h2 hns.1 hgy,
      ModelLevels.ModelGeneric4.twoFFHom_finiteAlong h2 hns.1 hgy, hdeg, φ, ?_, ?_, rfl, hseam⟩
    · rw [hker]; exact AddSubgroup.zmultiples_le.mpr hQH
    · rw [hker, Nat.card_zmultiples, ← hqe, hQ2]
  exact result _ hbridge

/-- **Separable seams for the vendored Vélu composite, in every characteristic prime to the
order.** For every cyclic subgroup `H` of order `n` with `(ℓ : k) ≠ 0` for each prime `ℓ ∣ n`, the
actual vendored iterated Vélu quotient `E.cyclicQuotientCurve H n` is reached by a seam `g` with
`g.ker = H`, for a function-field map `ι` with `FiniteAlong k ι` and `finrankAlong k ι = n`. -/
theorem exists_quotientSeam (n : ℕ) (hn : n ≠ 0)
    (hchar : ∀ ℓ : ℕ, ℓ.Prime → ℓ ∣ n → (ℓ : k) ≠ 0)
    (E : WeierstrassCurve k) [E.IsElliptic] (H : AddSubgroup E.toAffine.Point)
    (hH : IsAddCyclic H ∧ Nat.card H = n) :
    ∃ _ : (E.cyclicQuotientCurve H n).IsElliptic,
      ∃ (ι : (E.cyclicQuotientCurve H n).toAffine.FunctionField →ₐ[k] E.toAffine.FunctionField)
        (hι : ι.toRingHom.IsIntegral), FiniteAlong k ι ∧ finrankAlong k ι = n ∧
        ∃ g : E.toAffine.Point →+ (E.cyclicQuotientCurve H n).toAffine.Point,
          g.ker = H ∧ IsSeam ι hι g :=
  exists_quotientSeam_of_steps n hn (fun ℓ hℓ hdvd => by
    by_cases h2 : ℓ = 2
    · subst h2; exact stepSeam_two (by exact_mod_cast hchar 2 Nat.prime_two hdvd)
    · exact stepSeam_of_odd hℓ h2 (hchar ℓ hℓ hdvd)) E H hH

#print axioms finrankAlong_twoFFHom_le
#print axioms twoFFHom_seam
#print axioms stepSeam_two
#print axioms exists_quotientSeam

end ZInQ.Manuscript.RC.ModelGeneric6
