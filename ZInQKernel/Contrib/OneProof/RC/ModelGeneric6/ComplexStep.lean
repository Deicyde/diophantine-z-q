/-- **Homothety of pairs, for an arbitrary period pair.** If `L = c(ℤτ' + ℤ)`, the pair on the
period curve of `L` with the subgroup generated by the image of `c/N` has the class
`analyticCyclicPair τ'`. (Generic4's `analyticCyclicPair_eq_of_scale` is the case
`L = ℤτ₀ + ℤ`; the proof is the same.) -/
theorem analyticCyclicPair_eq_of_scale' {N : ℕ} [NeZero N] (h₂ : 2 ≤ N) (τ' : ℍ)
    (P : PeriodPair) (α : ℂ) (hs : T5Glue.IsScale P (PeriodPair.ofTau τ') α)
    (D : CyclicSubgroups P.weierstrassCurve.toAffine.Point N)
    (hD : D.1 = AddSubgroup.zmultiples (P.toPoint P.discriminant_ne_zero (α * (1 / N)))) :
    ModelGeneric3.analyticCyclicPair (N := N) τ' =
      Quot.mk _ ⟨P.weierstrassCurve,
        ⟨isUnit_iff_ne_zero.mpr P.discriminant_ne_zero.weierstrassCurve_Δ_ne_zero⟩, D⟩ := by
  have hα : α ≠ 0 := hs.1
  let u : ℂˣ := Units.mk0 α hα
  have hu : (u : ℂ) = α := rfl
  have hcurve : (⟨u, 0, 0, 0⟩ : VariableChange ℂ) • (PeriodPair.ofTau τ').weierstrassCurve =
      P.weierstrassCurve := by
    ext
    · simp [WeierstrassCurve.variableChange_a₁]
    · simp [WeierstrassCurve.variableChange_a₂]
    · simp [WeierstrassCurve.variableChange_a₃]
    · rw [WeierstrassCurve.variableChange_a₄]
      simp only [PeriodPair.weierstrassCurve_a₄, PeriodPair.weierstrassCurve_a₃,
        PeriodPair.weierstrassCurve_a₂, PeriodPair.weierstrassCurve_a₁, hs.g₂,
        Units.val_inv_eq_inv_val, hu]
      field_simp
      ring
    · rw [WeierstrassCurve.variableChange_a₆]
      simp only [PeriodPair.weierstrassCurve_a₆, PeriodPair.weierstrassCurve_a₄,
        PeriodPair.weierstrassCurve_a₃, PeriodPair.weierstrassCurve_a₂,
        PeriodPair.weierstrassCurve_a₁, hs.g₃, Units.val_inv_eq_inv_val, hu]
      field_simp
      ring
  rw [ModelGeneric3.analyticCyclicPair]
  apply (pairClasses_eq_iff _ _).2
  refine ⟨_, hcurve, ?_⟩
  rw [hD]
  change AddSubgroup.map (changePoints _ _ _ hcurve).toAddMonoidHom
    (AddSubgroup.zmultiples ((PeriodPair.ofTau τ').toPoint
      (PeriodPair.ofTau τ').discriminant_ne_zero (1 / (N : ℂ)))) = _
  rw [AddMonoidHom.map_zmultiples]
  congr 1
  have hQ : (1 / (N : ℂ)) ∉ (PeriodPair.ofTau τ').lattice := by
    intro h
    have h1 := (ModelGeneric4.toPoint_eq_toPoint_iff (PeriodPair.ofTau τ')
      (PeriodPair.ofTau τ').discriminant_ne_zero (1 / (N : ℂ)) 0).2 (by simpa using h)
    have hgen := (WeierstrassCurve.ModelLevels.ModelGeneric3.latticeGenerator (N := N) τ').2
    change addOrderOf ((PeriodPair.ofTau τ').toPoint (PeriodPair.ofTau τ').discriminant_ne_zero
      (1 / (N : ℂ))) = N at hgen
    rw [h1, (PeriodPair.ofTau τ').toPoint_zero (PeriodPair.ofTau τ').discriminant_ne_zero,
      addOrderOf_zero] at hgen
    omega
  have hP : α * (1 / (N : ℂ)) ∉ P.lattice := by
    rw [hs.mem_iff, inv_mul_cancel_left₀ hα]; exact hQ
  change changePoints _ _ _ hcurve ((PeriodPair.ofTau τ').toPoint _ (1 / (N : ℂ))) = _
  rw [PeriodPair.toPoint_of_notMem _ _ hQ, PeriodPair.toPoint_of_notMem _ _ hP,
    WeierstrassCurve.ModelLevels.ModelGeneric4.changePoints_scale _ _ u hcurve]
  · congr 1
    · rw [hs.weierstrassP, hu, inv_pow]
    · rw [hs.derivWeierstrassP, hu, inv_pow]; ring
  · have := ((WeierstrassCurve.Affine.equation_iff_nonsingular_of_Δ_ne_zero
      P.discriminant_ne_zero.weierstrassCurve_Δ_ne_zero).mp (P.equation_weierstrassP hP))
    rw [hs.weierstrassP, hs.derivWeierstrassP] at this
    rw [hu]
    convert this using 2
    · rw [inv_pow]
    · rw [inv_pow]; ring

/-- `1/(2Q)` is not in `ℤτ + ℤ/Q`. -/
theorem not_mem_span_half (τ : ℍ) (Q : ℕ) [NeZero Q] :
    (1 / (2 * Q : ℂ)) ∉ Submodule.span ℤ {(τ : ℂ), 1 / (Q : ℂ)} := by
  have hQ : (Q : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr (NeZero.ne Q)
  rw [Submodule.mem_span_pair]
  rintro ⟨a, b, h⟩
  have him := congrArg Complex.im h
  simp only [zsmul_eq_mul, Complex.add_im, Complex.mul_im, Complex.intCast_re,
    Complex.intCast_im, zero_mul, add_zero] at him
  have hre1 : (1 / (Q : ℂ)).im = 0 := by
    rw [← Complex.ofReal_natCast, ← Complex.ofReal_one, ← Complex.ofReal_div]
    exact Complex.ofReal_im _
  have hre2 : (1 / (2 * Q : ℂ)).im = 0 := by
    rw [← Complex.ofReal_natCast, ← Complex.ofReal_one, ← Complex.ofReal_ofNat,
      ← Complex.ofReal_mul, ← Complex.ofReal_div]
    exact Complex.ofReal_im _
  rw [hre1, hre2, mul_zero, add_zero] at him
  have ha : a = 0 := by
    exact_mod_cast (mul_eq_zero.mp him).resolve_right τ.im_pos.ne'
  subst a
  simp only [zero_smul, zero_add, zsmul_eq_mul] at h
  have h2 : (2 * b : ℂ) = 1 := by
    field_simp at h
    linear_combination h
  have h2' : (2 * b : ℤ) = 1 := by exact_mod_cast h2
  omega

/-- The Atkin–Lehner lattice identity: `ℤτ + ℤ/Q = ω₂ (ℤτ' + ℤ)` with `ω₂ = Mcτ + d`, for
`τ' = (Qaτ + b)/(QMcτ + Qd)` and `Q(ad) - M(bc) = 1`. -/
theorem mem_span_iff_atkin (τ : ℍ) {Q M : ℕ} (hQ0 : Q ≠ 0) (a b c d : ℤ)
    (hdet : (Q : ℤ) * (a * d) - (M : ℤ) * (b * c) = 1) (τ' ω₂ : ℂ)
    (hω : ω₂ = (M : ℂ) * c * τ + d) (hω0 : ω₂ ≠ 0)
    (hτ' : ω₂ * τ' = a * τ + b / Q) (z : ℂ) :
    z ∈ Submodule.span ℤ {(τ : ℂ), 1 / (Q : ℂ)} ↔
      ω₂⁻¹ * z ∈ Submodule.span ℤ {τ', (1 : ℂ)} := by
  have hQ : (Q : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr hQ0
  have hdetC : (Q : ℂ) * (a * d) - (M : ℂ) * (b * c) = 1 := by exact_mod_cast hdet
  have hQinv : (Q : ℂ) * (Q : ℂ)⁻¹ = 1 := mul_inv_cancel₀ hQ
  rw [Submodule.mem_span_pair, Submodule.mem_span_pair]
  constructor
  · rintro ⟨m, n, rfl⟩
    refine ⟨Q * d * m - M * c * n, -b * m + a * n, ?_⟩
    simp only [zsmul_eq_mul]
    push_cast
    rw [eq_inv_mul_iff_mul_eq₀ hω0]
    have e : ω₂ * (((Q : ℂ) * d * m - M * c * n) * τ' + (-b * m + a * n) * 1) =
        ((Q : ℂ) * d * m - M * c * n) * (ω₂ * τ') + (-b * m + a * n) * ω₂ := by ring
    rw [e, hτ', hω]
    linear_combination ((m : ℂ) * τ + n * (Q : ℂ)⁻¹) * hdetC + ((d : ℂ) * (m * b - n * a)) * hQinv
  · rintro ⟨m, n, h⟩
    simp only [zsmul_eq_mul, mul_one] at h
    have hz : z = m * (ω₂ * τ') + n * ω₂ := by
      rw [← mul_inv_cancel_left₀ hω0 z, ← h]; ring
    refine ⟨a * m + M * c * n, b * m + Q * d * n, ?_⟩
    simp only [zsmul_eq_mul]
    push_cast
    rw [hz, hτ', hω]
    linear_combination ((n : ℂ) * d) * hQinv

variable {N Q : ℕ} [NeZero N]

/-- **The moduli action of `W_Q` at complex points.** Let `(E, C)` be a complex pair with class
`analyticCyclicPair τ`, `Q = q^e` the exact power of a prime `q` dividing `N`, `M = N / Q`,
`C_Q = M • C`, and let `g` be a seam (for some function-field map `ι` with `FiniteAlong`) from
`E` to the actual vendored Vélu composite `E' = E.cyclicQuotientCurve C_Q Q`, with
`g.ker = C_Q`. Then the class of `(E', g(E[Q] ⊔ C))` is `analyticCyclicPair (W_Q τ)`. -/
theorem atkinPair_complex (h₂ : 2 ≤ N) {q e : ℕ} (hq : q.Prime) (he : 0 < e) (hQe : Q = q ^ e)
    (hQ : Q ∥ N) (τ : ℍ) (E : WeierstrassCurve ℂ) [hE : E.IsElliptic]
    (C : CyclicSubgroups E.toAffine.Point N)
    (hEC : (Quot.mk _ ⟨E, hE, C⟩ : PairClasses ℂ N) = ModelGeneric3.analyticCyclicPair τ)
    [hE' : (E.cyclicQuotientCurve (smulSubgroup (N / Q) C.1) Q).IsElliptic]
    (ι : (E.cyclicQuotientCurve (smulSubgroup (N / Q) C.1) Q).toAffine.FunctionField →ₐ[ℂ]
      E.toAffine.FunctionField)
    (hι : ι.toRingHom.IsIntegral) (hfin : FiniteAlong ℂ ι)
    (g : E.toAffine.Point →+ (E.cyclicQuotientCurve (smulSubgroup (N / Q) C.1) Q).toAffine.Point)
    (hg : g.ker = smulSubgroup (N / Q) C.1) (hseam : IsSeam ι hι g) :
    (Quot.mk _ ⟨_, hE', atkinImage E hq he hQe (Nat.mul_div_cancel' hQ.dvd).symm hQ.coprime
        (Nat.cast_ne_zero.mpr (NeZero.ne N)) two_ne_zero C g hg⟩ : PairClasses ℂ N) =
      ModelGeneric3.analyticCyclicPair (N := N) (AtkinPin.atkinGL hQ • τ) := by
  obtain ⟨M, hM⟩ : ∃ M, M = N / Q := ⟨_, rfl⟩
  have hN : N = Q * M := hM ▸ (Nat.mul_div_cancel' hQ.dvd).symm
  have hQ0 : Q ≠ 0 := hQ.pos.ne'
  haveI : NeZero Q := ⟨hQ0⟩
  have hQC : (Q : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr hQ0
  have hNC : (N : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr (NeZero.ne N)
  have hNMQ : (N : ℂ) = Q * M := by exact_mod_cast hN
  have hM0 : M ≠ 0 := by
    rintro rfl; rw [mul_zero] at hN; exact NeZero.ne N hN
  have hMC : (M : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr hM0
  -- The period curve of `τ` and the pair isomorphism.
  let L := PeriodPair.ofTau τ
  have hL := L.discriminant_ne_zero
  haveI hEllL : L.weierstrassCurve.IsElliptic :=
    ⟨isUnit_iff_ne_zero.mpr hL.weierstrassCurve_Δ_ne_zero⟩
  have hu_nsmul : ∀ (n : ℕ) (z : ℂ), n • L.toPoint hL z = L.toPoint hL (n • z) :=
    fun n z => (map_nsmul (uniformization L hL) n z).symm
  have hu_zsmul : ∀ (n : ℤ) (z : ℂ), n • L.toPoint hL z = L.toPoint hL (n • z) :=
    fun n z => (map_zsmul (uniformization L hL) n z).symm
  rw [ModelGeneric3.analyticCyclicPair] at hEC
  obtain ⟨v, hv, hvC⟩ := (pairClasses_eq_iff _ _).1 hEC
  change v • E = L.weierstrassCurve at hv
  change (changePoints E L.weierstrassCurve v hv).mapAddSubgroup C.1 =
    AddSubgroup.zmultiples (L.toPoint hL (1 / (N : ℂ))) at hvC
  let c₁ := changePoints E L.weierstrassCurve v hv
  -- The quotient curve as a period curve.
  obtain ⟨L₂, C₂, hC₂⟩ := PeriodPair.exists_variableChange_smul_weierstrassCurve_eq (E.cyclicQuotientCurve (smulSubgroup (N / Q) C.1) Q)
  have hL₂ := L₂.discriminant_ne_zero
  haveI hEllL₂ : L₂.weierstrassCurve.IsElliptic :=
    ⟨isUnit_iff_ne_zero.mpr hL₂.weierstrassCurve_Δ_ne_zero⟩
  have hu₂_zsmul : ∀ (n : ℤ) (z : ℂ), n • L₂.toPoint hL₂ z = L₂.toPoint hL₂ (n • z) :=
    fun n z => (map_zsmul (uniformization L₂ hL₂) n z).symm
  have hv₂ : C₂⁻¹ • (E.cyclicQuotientCurve (smulSubgroup (N / Q) C.1) Q) = L₂.weierstrassCurve := by rw [← hC₂, inv_smul_smul]
  let c₂ := changePoints (E.cyclicQuotientCurve (smulSubgroup (N / Q) C.1) Q) L₂.weierstrassCurve C₂⁻¹ hv₂
  -- The conjugated seam between period curves, and its lift.
  obtain ⟨ι₁, hι₁, hfin₁, hs₁⟩ := isSeam_changePoints_symm E L.weierstrassCurve v hv
  obtain ⟨ι₂, hι₂, hfin₂, hs₂⟩ := isSeam_changePoints (E.cyclicQuotientCurve (smulSubgroup (N / Q) C.1) Q) L₂.weierstrassCurve C₂⁻¹ hv₂
  have hιa : (ι.comp ι₂).toRingHom.IsIntegral :=
    RingHom.IsIntegral.trans ι₂.toRingHom ι.toRingHom hι₂ hι
  have hsa := isSeam_comp' ι hι g ι₂ hι₂ c₂.toAddMonoidHom hseam hs₂ hιa
  have hιb : (ι₁.comp (ι.comp ι₂)).toRingHom.IsIntegral :=
    RingHom.IsIntegral.trans _ ι₁.toRingHom hιa hι₁
  have hsb := isSeam_comp' ι₁ hι₁ c₁.symm.toAddMonoidHom (ι.comp ι₂) hιa _ hs₁ hsa hιb
  have hfinb : FiniteAlong ℂ (ι₁.comp (ι.comp ι₂)) := by
    have h1 : RingHom.Finite ι₁.toRingHom := hfin₁
    have h2 : RingHom.Finite ι.toRingHom := hfin
    have h3 : RingHom.Finite ι₂.toRingHom := hfin₂
    have h23 : RingHom.Finite (ι.comp ι₂).toRingHom := RingHom.Finite.comp (g := ι.toRingHom) h2 h3
    exact RingHom.Finite.comp (g := ι₁.toRingHom) h1 h23
  let f := (c₂.toAddMonoidHom.comp g).comp c₁.symm.toAddMonoidHom
  obtain ⟨α, hα⟩ := exists_lift_of_seam L L₂ _ hιb hfinb f hsb
  have hfu : ∀ z, c₂ (g (c₁.symm (L.toPoint hL z))) = L₂.toPoint hL₂ (α * z) := hα
  -- The kernel: `α z ∈ L₂ ↔ z ∈ ℤτ + ℤ/Q`.
  have hu₂0 : ∀ w, L₂.toPoint hL₂ w = 0 ↔ w ∈ L₂.lattice := by
    intro w
    rw [← L₂.toPoint_zero hL₂, ModelGeneric4.toPoint_eq_toPoint_iff, sub_zero]
  have hD₀ : ∀ y, c₁.symm y ∈ C.1 ↔ y ∈ AddSubgroup.zmultiples (L.toPoint hL (1 / (N : ℂ))) := by
    intro y
    rw [← hvC]
    change _ ↔ y ∈ AddSubgroup.map c₁.toAddMonoidHom C.1
    rw [AddSubgroup.mem_map_equiv]
  have hCQ : ∀ y, c₁.symm y ∈ smulSubgroup (N / Q) C.1 ↔
      y ∈ AddSubgroup.zmultiples (L.toPoint hL (1 / (Q : ℂ))) := by
    intro y
    rw [← hM]
    constructor
    · rintro ⟨x, hx, hxy⟩
      have hx' : c₁ x ∈ AddSubgroup.zmultiples (L.toPoint hL (1 / (N : ℂ))) := by
        rw [← hD₀]; simpa using hx
      obtain ⟨j, hj⟩ := AddSubgroup.mem_zmultiples_iff.mp hx'
      refine AddSubgroup.mem_zmultiples_iff.mpr ⟨j, ?_⟩
      have hyx : y = c₁ (M • x) := by
        have h' : c₁.symm y = M • x := hxy.symm
        rw [← c₁.apply_symm_apply y, h']
      rw [hyx, map_nsmul, ← hj, smul_comm]
      congr 1
      rw [hu_nsmul]
      congr 1
      rw [nsmul_eq_mul, hNMQ]
      field_simp
    · intro hy
      obtain ⟨j, rfl⟩ := AddSubgroup.mem_zmultiples_iff.mp hy
      refine ⟨c₁.symm (j • L.toPoint hL (1 / (N : ℂ))), ?_, ?_⟩
      · exact (hD₀ _).2 (AddSubgroup.zsmul_mem _ (AddSubgroup.mem_zmultiples _) _)
      · change M • c₁.symm _ = _
        rw [← map_nsmul, smul_comm]
        congr 2
        change M • L.toPoint hL _ = L.toPoint hL _
        rw [hu_nsmul]
        congr 1
        rw [nsmul_eq_mul, hNMQ]
        field_simp
  have hkey : ∀ z, α * z ∈ L₂.lattice ↔ z ∈ Submodule.span ℤ {(τ : ℂ), 1 / (Q : ℂ)} := by
    intro z
    rw [← hu₂0, ← hfu, map_eq_zero_iff c₂ c₂.injective, ← AddMonoidHom.mem_ker, hg, hCQ]
    exact ModelGeneric4.toPoint_mem_zmultiples_iff τ Q z
  have hα0 : α ≠ 0 := by
    rintro rfl
    exact not_mem_span_half τ Q ((hkey _).1 (by rw [zero_mul]; exact zero_mem _))
  -- The Atkin–Lehner matrix.
  obtain ⟨a, b, c, d, hmat, hdet⟩ :=
    (TauCeti.isAtkinLehnerMatrix_atkinLehnerMatrix hQ).exists_entries hQ0 hN
  let τ' := AtkinPin.atkinGL hQ • τ
  have hτ'c := ZInQ.Manuscript.RC.AtkinRational.coe_atkin hQ hmat τ
  let ω₂ : ℂ := (M : ℂ) * c * τ + d
  have hω : ω₂ = (M : ℂ) * c * τ + d := rfl
  have hω0 : ω₂ ≠ 0 := by
    intro h0
    have hden : (Q : ℂ) * M * c * τ + (Q : ℂ) * d = Q * ω₂ := by rw [hω]; ring
    by_cases hc0 : c = 0
    · subst hc0
      have hd0 : (d : ℂ) = 0 := by simpa [hω] using h0
      have : d = 0 := by exact_mod_cast hd0
      rw [this] at hdet; simp at hdet
    · have hre : ((M : ℂ) * c) = (((M : ℝ) * c : ℝ) : ℂ) := by push_cast; ring
      have h0' : (((M : ℝ) * c : ℝ) : ℂ) * τ + d = 0 := by rw [← hre]; exact h0
      have him := congrArg Complex.im h0'
      simp only [Complex.add_im, Complex.im_ofReal_mul, Complex.intCast_im, add_zero,
        Complex.zero_im] at him
      have hM0' : (M : ℝ) ≠ 0 := Nat.cast_ne_zero.mpr hM0
      have hc0' : (c : ℝ) ≠ 0 := by exact_mod_cast hc0
      exact mul_ne_zero (mul_ne_zero hM0' hc0') τ.im_pos.ne' him
  have hτ' : ω₂ * (τ' : ℂ) = a * τ + b / Q := by
    have hden : (Q : ℂ) * M * c * τ + (Q : ℂ) * d = Q * ω₂ := by rw [hω]; ring
    rw [hτ'c, hden]
    field_simp
  -- The quotient lattice.
  have hscale : T5Glue.IsScale L₂ (PeriodPair.ofTau τ') (α * ω₂) := by
    refine ⟨mul_ne_zero hα0 hω0, ?_⟩
    ext w
    rw [SetLike.mem_coe, Set.mem_smul_set]
    have hw : w = α * (α⁻¹ * w) := by field_simp
    constructor
    · intro hw2
      rw [hw, hkey, mem_span_iff_atkin τ hQ0 a b c d hdet τ' ω₂ hω hω0 hτ'] at hw2
      refine ⟨ω₂⁻¹ * (α⁻¹ * w), ?_, ?_⟩
      · rw [SetLike.mem_coe, PeriodPair.ofTau_lattice]; exact hw2
      · change (α * ω₂) * (ω₂⁻¹ * (α⁻¹ * w)) = w
        field_simp
    · rintro ⟨y, hy, rfl⟩
      rw [SetLike.mem_coe, PeriodPair.ofTau_lattice] at hy
      change (α * ω₂) * y ∈ L₂.lattice
      rw [mul_assoc, hkey, mem_span_iff_atkin τ hQ0 a b c d hdet τ' ω₂ hω hω0 hτ']
      rwa [inv_mul_cancel_left₀ hω0]
  -- The image subgroup.
  have hgen : ω₂ / N = c * (τ : ℂ) / Q + d / N := by
    rw [hω, hNMQ]; field_simp
  have hrem : ∀ (r s j : ℤ), ∃ m : ℤ,
      (r * (τ : ℂ) / Q + s / Q + j / N) - m * (ω₂ / N) ∈
        Submodule.span ℤ {(τ : ℂ), 1 / (Q : ℂ)} := by
    intro r s j
    refine ⟨-M * b * r + Q * a * j, ?_⟩
    rw [Submodule.mem_span_pair]
    refine ⟨r * a * d - j * a * c, r * b * d + s - j * b * c, ?_⟩
    simp only [zsmul_eq_mul]
    push_cast
    rw [hgen, hNMQ]
    have hdetC : (Q : ℂ) * (a * d) - (M : ℂ) * (b * c) = 1 := by exact_mod_cast hdet
    have hQi : (Q : ℂ) * (Q : ℂ)⁻¹ = 1 := mul_inv_cancel₀ hQC
    have hMi : (M : ℂ) * (M : ℂ)⁻¹ = 1 := mul_inv_cancel₀ hMC
    linear_combination ((r : ℂ) * τ * (Q : ℂ)⁻¹ + j * (Q : ℂ)⁻¹ * (M : ℂ)⁻¹) * hdetC -
      (((r : ℂ) * a * d - j * a * c) * τ) * hQi -
      (((r : ℂ) * b * d - j * b * c) * (Q : ℂ)⁻¹) * hMi
  have himage : ((atkinSum Q C.1).map g).map c₂.toAddMonoidHom =
      AddSubgroup.zmultiples (L₂.toPoint hL₂ (α * ω₂ * (1 / N))) := by
    apply le_antisymm
    · rintro _ ⟨_, ⟨y, hy, rfl⟩, rfl⟩
      obtain ⟨t, ht, x, hx, rfl⟩ := AddSubgroup.mem_sup.mp hy
      -- Coordinates of `t` and `x` on the period curve.
      obtain ⟨zt, hzt⟩ := (L.isUniformization_toPoint hL).2.1 (c₁ t)
      have hQt : Q • t = 0 := (mem_torsionBy_iff Q t).1 ht
      have hQzt : (Q : ℂ) * zt ∈ L.lattice := by
        apply (L.isUniformization_toPoint hL).2.2
        rw [← nsmul_eq_mul, ← hu_nsmul, hzt, ← map_nsmul, hQt, map_zero]
      rw [PeriodPair.ofTau_lattice, Submodule.mem_span_pair] at hQzt
      obtain ⟨r, s, hrs⟩ := hQzt
      have hx' : c₁ x ∈ AddSubgroup.zmultiples (L.toPoint hL (1 / (N : ℂ))) := by
        rw [← hD₀]; simpa using hx
      obtain ⟨j, hj⟩ := AddSubgroup.mem_zmultiples_iff.mp hx'
      have hz : t + x = c₁.symm (L.toPoint hL (r * (τ : ℂ) / Q + s / Q + j / N)) := by
        apply c₁.injective
        rw [AddEquiv.apply_symm_apply, map_add, ← hzt, ← hj]
        rw [show r * (τ : ℂ) / Q + s / Q + j / N = zt + j • (1 / (N : ℂ)) by
          have : zt = (r * τ + s) / Q := by
            rw [eq_div_iff hQC]
            simp only [zsmul_eq_mul, mul_one] at hrs
            rw [mul_comm]; exact hrs.symm
          rw [this, zsmul_eq_mul]; field_simp]
        rw [(L.isUniformization_toPoint hL).1, hu_zsmul]
      obtain ⟨m, hm⟩ := hrem r s j
      refine AddSubgroup.mem_zmultiples_iff.mpr ⟨m, ?_⟩
      change m • L₂.toPoint hL₂ (α * ω₂ * (1 / N)) = c₂ (g (t + x))
      rw [hz, hfu, hu₂_zsmul, ModelGeneric4.toPoint_eq_toPoint_iff]
      have := (hkey _).2 (neg_mem hm)
      convert this using 1
      simp only [zsmul_eq_mul]
      ring
    · rw [AddSubgroup.zmultiples_le]
      refine ⟨g (c₁.symm (L.toPoint hL (ω₂ / N))), ⟨c₁.symm (L.toPoint hL (ω₂ / N)), ?_, rfl⟩, ?_⟩
      · rw [hgen, (L.isUniformization_toPoint hL).1, map_add]
        refine AddSubgroup.add_mem _ (AddSubgroup.mem_sup_left ?_) (AddSubgroup.mem_sup_right ?_)
        · have hmem : Q • ((c : ℂ) * τ / Q) ∈ L.lattice := by
            rw [PeriodPair.ofTau_lattice, Submodule.mem_span_pair]
            exact ⟨c, 0, by
              simp only [zsmul_eq_mul, nsmul_eq_mul, Int.cast_zero, zero_mul, add_zero]
              field_simp⟩
          rw [mem_torsionBy_iff, ← map_nsmul, hu_nsmul, L.toPoint_of_mem hL hmem, map_zero]
        · rw [hD₀]
          refine AddSubgroup.mem_zmultiples_iff.mpr ⟨d, ?_⟩
          rw [hu_zsmul]
          congr 1
          rw [zsmul_eq_mul]; ring
      · change c₂ (g (c₁.symm (L.toPoint hL (ω₂ / N)))) = L₂.toPoint hL₂ (α * ω₂ * (1 / N))
        rw [hfu]
        congr 1
        ring
  -- Assemble the class.
  let D₂ : CyclicSubgroups L₂.weierstrassCurve.toAffine.Point N :=
    cyclicSubgroupsEquiv c₂ N (atkinImage E hq he hQe (Nat.mul_div_cancel' hQ.dvd).symm
      hQ.coprime hNC two_ne_zero C g hg)
  have hD₂ : D₂.1 = AddSubgroup.zmultiples (L₂.toPoint hL₂ ((α * ω₂) * (1 / N))) := himage
  rw [show AtkinPin.atkinGL hQ • τ = τ' from rfl,
    analyticCyclicPair_eq_of_scale' h₂ τ' L₂ (α * ω₂) hscale D₂ hD₂]
  apply (pairClasses_eq_iff _ _).2
  exact ⟨C₂⁻¹, hv₂, rfl⟩

/-- **Generic5's item 3 at complex points, choice-free.** For every complex point `y` of the
pinned rational open, every pair `(E, C)` representing `rationalPoints y`, and every seam `g`
(for some `ι` with `FiniteAlong`) from `E` to the actual vendored Vélu composite
`E' = E.cyclicQuotientCurve C_Q Q` with `g.ker = C_Q = (N/Q) • C`, the class
`rationalPoints (y ∘ atkinRat)` is the class of `(E', g(E[Q] ⊔ C))`. Here `Q = q^e` is the exact
power of `q` in `N`, and `atkinRatAlg` is generic5's rational Atkin–Lehner map. -/
theorem rationalPoints_atkinRat_complex_moduli (h₂ : 2 ≤ N) {q e : ℕ} (hq : q.Prime) (he : 0 < e)
    (hQe : Q = q ^ e) (hQ : Q ∥ N) (y : ModelGeneric.Y0RationalAlgebra h₂ →ₐ[ℚ] ℂ)
    (E : WeierstrassCurve ℂ) [hE : E.IsElliptic] (C : CyclicSubgroups E.toAffine.Point N)
    (hEC : (Quot.mk _ ⟨E, hE, C⟩ : PairClasses ℂ N) = ModelGeneric2.rationalPoints h₂ y)
    [hE' : (E.cyclicQuotientCurve (smulSubgroup (N / Q) C.1) Q).IsElliptic]
    (ι : (E.cyclicQuotientCurve (smulSubgroup (N / Q) C.1) Q).toAffine.FunctionField →ₐ[ℂ]
      E.toAffine.FunctionField)
    (hι : ι.toRingHom.IsIntegral) (hfin : FiniteAlong ℂ ι)
    (g : E.toAffine.Point →+ (E.cyclicQuotientCurve (smulSubgroup (N / Q) C.1) Q).toAffine.Point)
    (hg : g.ker = smulSubgroup (N / Q) C.1) (hseam : IsSeam ι hι g) :
    ModelGeneric2.rationalPoints h₂ (y.comp (ModelGeneric5.atkinRatAlg h₂ hQ)) =
      Quot.mk _ ⟨_, hE', atkinImage E hq he hQe (Nat.mul_div_cancel' hQ.dvd).symm hQ.coprime
        (Nat.cast_ne_zero.mpr (NeZero.ne N)) two_ne_zero C g hg⟩ := by
  obtain ⟨τ, h1, h2⟩ := ModelGeneric5.rationalPoints_atkinRat_complex h₂ hQ y
  rw [h2, atkinPair_complex h₂ hq he hQe hQ τ E C (hEC.trans h1) ι hι hfin g hg hseam]

/-- **Independence of the choices (corollary).** Two representatives of `rationalPoints y`
with any seams give the same class. -/
theorem atkinClass_independent (h₂ : 2 ≤ N) {q e : ℕ} (hq : q.Prime) (he : 0 < e)
    (hQe : Q = q ^ e) (hQ : Q ∥ N) (y : ModelGeneric.Y0RationalAlgebra h₂ →ₐ[ℚ] ℂ)
    (E₁ : WeierstrassCurve ℂ) [hE₁ : E₁.IsElliptic] (C₁ : CyclicSubgroups E₁.toAffine.Point N)
    (hEC₁ : (Quot.mk _ ⟨E₁, hE₁, C₁⟩ : PairClasses ℂ N) = ModelGeneric2.rationalPoints h₂ y)
    [hE₁' : (E₁.cyclicQuotientCurve (smulSubgroup (N / Q) C₁.1) Q).IsElliptic]
    (ι₁ : (E₁.cyclicQuotientCurve (smulSubgroup (N / Q) C₁.1) Q).toAffine.FunctionField →ₐ[ℂ]
      E₁.toAffine.FunctionField)
    (hι₁ : ι₁.toRingHom.IsIntegral) (hfin₁ : FiniteAlong ℂ ι₁)
    (g₁ : E₁.toAffine.Point →+
      (E₁.cyclicQuotientCurve (smulSubgroup (N / Q) C₁.1) Q).toAffine.Point)
    (hg₁ : g₁.ker = smulSubgroup (N / Q) C₁.1) (hseam₁ : IsSeam ι₁ hι₁ g₁)
    (E₂ : WeierstrassCurve ℂ) [hE₂ : E₂.IsElliptic] (C₂ : CyclicSubgroups E₂.toAffine.Point N)
    (hEC₂ : (Quot.mk _ ⟨E₂, hE₂, C₂⟩ : PairClasses ℂ N) = ModelGeneric2.rationalPoints h₂ y)
    [hE₂' : (E₂.cyclicQuotientCurve (smulSubgroup (N / Q) C₂.1) Q).IsElliptic]
    (ι₂ : (E₂.cyclicQuotientCurve (smulSubgroup (N / Q) C₂.1) Q).toAffine.FunctionField →ₐ[ℂ]
      E₂.toAffine.FunctionField)
    (hι₂ : ι₂.toRingHom.IsIntegral) (hfin₂ : FiniteAlong ℂ ι₂)
    (g₂ : E₂.toAffine.Point →+
      (E₂.cyclicQuotientCurve (smulSubgroup (N / Q) C₂.1) Q).toAffine.Point)
    (hg₂ : g₂.ker = smulSubgroup (N / Q) C₂.1) (hseam₂ : IsSeam ι₂ hι₂ g₂) :
    (Quot.mk _ ⟨_, hE₁', atkinImage E₁ hq he hQe (Nat.mul_div_cancel' hQ.dvd).symm hQ.coprime
        (Nat.cast_ne_zero.mpr (NeZero.ne N)) two_ne_zero C₁ g₁ hg₁⟩ : PairClasses ℂ N) =
      Quot.mk _ ⟨_, hE₂', atkinImage E₂ hq he hQe (Nat.mul_div_cancel' hQ.dvd).symm hQ.coprime
        (Nat.cast_ne_zero.mpr (NeZero.ne N)) two_ne_zero C₂ g₂ hg₂⟩ := by
  rw [← rationalPoints_atkinRat_complex_moduli h₂ hq he hQe hQ y E₁ C₁ hEC₁ ι₁ hι₁ hfin₁ g₁ hg₁
      hseam₁,
    ← rationalPoints_atkinRat_complex_moduli h₂ hq he hQe hQ y E₂ C₂ hEC₂ ι₂ hι₂ hfin₂ g₂ hg₂
      hseam₂]

