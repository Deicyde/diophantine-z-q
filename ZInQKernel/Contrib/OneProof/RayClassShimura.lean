/-! # rayclass-cft, Part G3: the glue `CMAnalytic` from the bundle's textbook leaf `HomLinearLift`

`HomLinearLift` (hom-unify, the lifting half of T11(a); a field of the bundle through
`HomLatticeCorr`): every endomorphism `f` of `Q.A` lifts to a `ℂ`-linear `M` with `Φ(Mz) = f(Φ z)`.
The lift is unique (a `ℂ`-subspace of the countable lattice is `0`), so `f ↦ M_f` is a ring map;
for `f ∈ End_𝒪(Q)` it commutes with `ι(i)`, `ι(j)`, hence is a scalar `λ_f`; `λ_f(τ, 1)ᵀ ∈ Λ_τ`
gives a unique `β_f ∈ 𝒪` with `ι(β_f)(τ, 1)ᵀ = λ_f(τ, 1)ᵀ`. -/

set_option linter.all false

noncomputable section

namespace RayClassCFT

open CategoryTheory AlgebraicGeometry Limits MonoidalCategory CartesianMonoidalCategory MonObj
open LeafQM LeafQM.AV ShimuraCFT
open ZInQ.LeafPush2 (CPts IsUniformization)

/-! ## G3a. The lattice `Λ_τ` -/

theorem qmLattice_countable {τ : ℂ} (hτ : τ.im ≠ 0) :
    (BPAnalytic.QM.qmLattice hτ : Set (Fin 2 → ℂ)).Countable := by
  refine (Set.countable_range (fun c : Fin 4 → ℤ => ∑ i, c i • BPAnalytic.QM.qmVec τ i)).mono ?_
  intro x hx
  rw [SetLike.mem_coe, BPAnalytic.QM.qmLattice_eq, Submodule.mem_span_range_iff_exists_fun] at hx
  obtain ⟨c, hc⟩ := hx
  exact ⟨c, hc⟩

/-- A `ℂ`-linear map with values in `Λ_τ` is `0`. -/
theorem linear_eq_zero_of_mem {τ : ℂ} (hτ : τ.im ≠ 0) (N : (Fin 2 → ℂ) →ₗ[ℂ] (Fin 2 → ℂ))
    (h : ∀ z, N z ∈ BPAnalytic.QM.qmLattice hτ) : N = 0 := by
  refine LinearMap.ext fun z => ?_
  by_contra hz
  have hc := qmLattice_countable hτ
  have : (Set.univ : Set ℂ).Countable := by
    have hinj : Function.Injective (fun c : ℂ => c • N z) := smul_left_injective ℂ hz
    refine Set.MapsTo.countable_of_injOn (f := fun c : ℂ => c • N z) ?_ hinj.injOn hc
    intro c _
    have := h (c • z)
    rwa [map_smul] at this
  exact not_countable_complex this

theorem qmVec0_mem {τ : ℂ} (hτ : τ.im ≠ 0) : ![τ, 1] ∈ BPAnalytic.QM.qmLattice hτ := by
  rw [BPAnalytic.QM.qmLattice_eq]
  have := Submodule.subset_span (R := ℤ) (Set.mem_range_self (f := BPAnalytic.QM.qmVec τ) 0)
  rwa [BPAnalytic.QM.qmVec, BPAnalytic.QM.latVec0] at this

/-- `ι(b)(τ, 1)ᵀ` for `b ∈ B`, `τ ∉ ℝ`, is `0` only for `b = 0`. -/
theorem iota_eig_zero {τ : ℂ} (hτ : τ.im ≠ 0) {b : LeafQM.B}
    (h : Matrix.mulVec (iotaC b) ![τ, 1] = 0) : b = 0 := by
  have h0 := congrFun h 0
  have h1 := congrFun h 1
  simp [iotaC_apply, iota_eq, Matrix.mulVec, dotProduct, Fin.sum_univ_two] at h0 h1
  have i0 := congrArg Complex.im h0
  have r0 := congrArg Complex.re h0
  have i1 := congrArg Complex.im h1
  have r1 := congrArg Complex.re h1
  simp at i0 r0 i1 r1
  have hs : (√2 : ℝ) ≠ 0 := Real.sqrt_ne_zero'.mpr two_pos
  have a1 : (b.re : ℝ) + b.imI * √2 = 0 := i0.resolve_right hτ
  have a2 : (b.imJ : ℝ) - b.imK * √2 = 0 := i1.resolve_right hτ
  have a3 : (b.re : ℝ) - b.imI * √2 = 0 := by
    have : (b.imJ - b.imK * √2) * τ.re + (b.re - b.imI * √2) = (0 : ℝ) := by linear_combination r1
    rw [a2, zero_mul, zero_add] at this; exact this
  have a4 : -3 * (b.imJ : ℝ) - 3 * b.imK * √2 = 0 := by
    have : (b.re + b.imI * √2) * τ.re + (-3 * b.imJ - 3 * b.imK * √2) = (0 : ℝ) := by
      linear_combination r0
    rw [a1, zero_mul, zero_add] at this; exact this
  have hre : (b.re : ℝ) = 0 := by linear_combination (a1 + a3) / 2
  have himI : (b.imI : ℝ) = 0 := by
    have : (b.imI : ℝ) * √2 = 0 := by linear_combination (a1 - a3) / 2
    exact (mul_eq_zero.mp this).resolve_right hs
  have himK : (b.imK : ℝ) = 0 := by
    have : (b.imK : ℝ) * √2 = 0 := by linear_combination -(a4 + 3 * a2) / 6
    exact (mul_eq_zero.mp this).resolve_right hs
  have himJ : (b.imJ : ℝ) = 0 := by linear_combination a2 + √2 * himK
  ext <;> simp_all

theorem iota_eig_inj {τ : ℂ} (hτ : τ.im ≠ 0) {b b' : LeafQM.B}
    (h : Matrix.mulVec (iotaC b) ![τ, 1] = Matrix.mulVec (iotaC b') ![τ, 1]) : b = b' := by
  rw [← sub_eq_zero]
  apply iota_eig_zero hτ
  rw [map_sub, Matrix.sub_mulVec, h, sub_self]

/-- Elements of `Λ_τ` are `ι(β)(τ, 1)ᵀ` with `β ∈ 𝒪`. -/
theorem exists_of_mem_qmLattice {τ : ℂ} (hτ : τ.im ≠ 0) {x : Fin 2 → ℂ}
    (hx : x ∈ BPAnalytic.QM.qmLattice hτ) :
    ∃ β : LeafQM.B, InO β ∧ Matrix.mulVec (iotaC β) ![τ, 1] = x := by
  rw [BPAnalytic.QM.qmLattice_eq, Submodule.mem_span_range_iff_exists_fun] at hx
  obtain ⟨c, rfl⟩ := hx
  refine ⟨LeafQM.ofInt c, ⟨c, rfl⟩, ?_⟩
  have e : LeafQM.ofInt c = ∑ i, c i • BPAnalytic.QM.oBasis i := by
    ext <;> simp [LeafQM.ofInt, BPAnalytic.QM.oBasis, Fin.sum_univ_four] <;> ring
  rw [e, map_sum, Matrix.sum_mulVec]
  refine Finset.sum_congr rfl fun i _ => ?_
  rw [map_zsmul, Matrix.smul_mulVec]
  rfl

/-! ## G3b. The analytic representation on `End_𝒪(Q)` -/

section Lift

variable {τ : UpperHalfPlane} {Q : QML3 ℂ} {Φu : (Fin 2 → ℂ) → CPts Q.A (RingHom.id ℂ)}

abbrev LamT (τ : UpperHalfPlane) := BPAnalytic.QM.qmLattice τ.im_pos.ne'

theorem lift_unique (hU : IsUniformization (RingHom.id ℂ) (LamT τ) Φu)
    {M M' : (Fin 2 → ℂ) →ₗ[ℂ] (Fin 2 → ℂ)} (h : ∀ z, Φu (M z) = Φu (M' z)) : M = M' := by
  have hz : ∀ z, (M - M') z ∈ LamT τ := fun z => by
    rw [← hU.2.1]
    have e := hU.1 ((M - M') z) (M' z)
    rw [LinearMap.sub_apply, sub_add_cancel, h z] at e
    first
    | exact left_eq_mul.1 e
    | exact (self_eq_mul_left.1 e)
    | exact (mul_eq_right.1 e.symm)
  exact sub_eq_zero.1 (linear_eq_zero_of_mem τ.im_pos.ne' (M - M') hz)

theorem dim_two (Q : QML3 ℂ) : Q.A.dim = ((2 : ℕ) : WithBot ℕ∞) := by
  rw [Q.surface]; rfl

/-- The lift `M_f` of an endomorphism (`HomLinearLift`). -/
def liftM (hHL : ZInQ.HomUnify.HomLinearLift) (hU : IsUniformization (RingHom.id ℂ) (LamT τ) Φu)
    (f : PkgI3.AbVar.End Q.A) : (Fin 2 → ℂ) →ₗ[ℂ] (Fin 2 → ℂ) :=
  (hHL ℂ Q.A Q.A (RingHom.id ℂ) 2 2 (LamT τ) (LamT τ) Φu Φu (dim_two Q) (dim_two Q) hU hU f).choose

theorem liftM_spec (hHL : ZInQ.HomUnify.HomLinearLift)
    (hU : IsUniformization (RingHom.id ℂ) (LamT τ) Φu) (f : PkgI3.AbVar.End Q.A) (z : Fin 2 → ℂ) :
    Φu (liftM hHL hU f z) = Φu z ≫ f.hom :=
  (hHL ℂ Q.A Q.A (RingHom.id ℂ) 2 2 (LamT τ) (LamT τ) Φu Φu (dim_two Q) (dim_two Q) hU hU f).choose_spec z

theorem liftM_mul (hHL : ZInQ.HomUnify.HomLinearLift)
    (hU : IsUniformization (RingHom.id ℂ) (LamT τ) Φu) (f g : PkgI3.AbVar.End Q.A) :
    liftM hHL hU (f * g) = liftM hHL hU f ∘ₗ liftM hHL hU g := by
  refine lift_unique hU fun z => ?_
  rw [liftM_spec hHL hU, LinearMap.comp_apply, liftM_spec hHL hU, liftM_spec hHL hU, Category.assoc]
  rfl

theorem liftM_add (hHL : ZInQ.HomUnify.HomLinearLift)
    (hU : IsUniformization (RingHom.id ℂ) (LamT τ) Φu) (f g : PkgI3.AbVar.End Q.A) :
    liftM hHL hU (f + g) = liftM hHL hU f + liftM hHL hU g := by
  refine lift_unique hU fun z => ?_
  rw [liftM_spec hHL hU, LinearMap.add_apply, hU.1, liftM_spec hHL hU, liftM_spec hHL hU, PkgI3.AbVar.Hom.hom_add,
    MonObj.comp_mul]

theorem liftM_one (hHL : ZInQ.HomUnify.HomLinearLift)
    (hU : IsUniformization (RingHom.id ℂ) (LamT τ) Φu) :
    liftM hHL hU (1 : PkgI3.AbVar.End Q.A) = LinearMap.id := by
  refine lift_unique hU fun z => ?_
  rw [liftM_spec hHL hU, LinearMap.id_apply]
  exact Category.comp_id _

theorem liftM_zero (hHL : ZInQ.HomUnify.HomLinearLift)
    (hU : IsUniformization (RingHom.id ℂ) (LamT τ) Φu) :
    liftM hHL hU (0 : PkgI3.AbVar.End Q.A) = 0 := by
  refine lift_unique hU fun z => ?_
  rw [liftM_spec hHL hU, LinearMap.zero_apply, PkgI3.AbVar.Hom.hom_zero, MonObj.comp_one]
  exact ((hU.2.1 0).2 (Submodule.zero_mem _)).symm

/-- `ι(i)`, `ι(j)` as elements of `𝒪`. -/
def oI : LeafQM.O := ⟨⟨0, 1, 0, 0⟩, ⟨![0, 1, 0, 0], by ext <;> simp [LeafQM.ofInt]⟩⟩
def oJ : LeafQM.O := ⟨⟨0, 0, 1, 0⟩, ⟨![-1, 0, 2, 0], by ext <;> simp [LeafQM.ofInt]⟩⟩

theorem liftM_comm (hHL : ZInQ.HomUnify.HomLinearLift)
    (hU : IsUniformization (RingHom.id ℂ) (LamT τ) Φu)
    (hι : HDec.HSyn.G0Split.FibreQM.IotaCompatible Q Φu) {φ : PkgI3.AbVar.End Q.A}
    (hφ : φ ∈ com Q.q) (a : LeafQM.O) (z : Fin 2 → ℂ) :
    liftM hHL hU φ ((HDec.HSyn.G0Split.FibreQM.qmMat a).mulVec z) =
      (HDec.HSyn.G0Split.FibreQM.qmMat a).mulVec (liftM hHL hU φ z) := by
  have h := congrArg (fun M => M z) (lift_unique hU (M := liftM hHL hU φ ∘ₗ
    Matrix.mulVecLin (HDec.HSyn.G0Split.FibreQM.qmMat a))
    (M' := Matrix.mulVecLin (HDec.HSyn.G0Split.FibreQM.qmMat a) ∘ₗ liftM hHL hU φ) fun z => by
      simp only [LinearMap.comp_apply, Matrix.mulVecLin_apply]
      rw [liftM_spec hHL hU, hι, hι, liftM_spec hHL hU, Category.assoc, Category.assoc]
      have hc := (Subring.mem_centralizer_iff.1 hφ) (Q.q.iota a) ⟨a, rfl⟩
      have := congrArg PkgI3.AbVar.Hom.hom hc
      exact congrArg (fun g => Φu z ≫ g) this.symm)
  simpa using h

theorem qmMat_oI : HDec.HSyn.G0Split.FibreQM.qmMat oI = !![(√2 : ℂ), 0; 0, -(√2 : ℂ)] := by
  ext i j; fin_cases i <;> fin_cases j <;>
    simp [HDec.HSyn.G0Split.FibreQM.qmMat, oI, iota_eq]

theorem qmMat_oJ : HDec.HSyn.G0Split.FibreQM.qmMat oJ = !![(0 : ℂ), -3; 1, 0] := by
  ext i j; fin_cases i <;> fin_cases j <;>
    simp [HDec.HSyn.G0Split.FibreQM.qmMat, oJ, iota_eq]

/-- **Lifts of `End_𝒪` are scalars.** -/
theorem liftM_scalar (hHL : ZInQ.HomUnify.HomLinearLift)
    (hU : IsUniformization (RingHom.id ℂ) (LamT τ) Φu)
    (hι : HDec.HSyn.G0Split.FibreQM.IotaCompatible Q Φu) {φ : PkgI3.AbVar.End Q.A}
    (hφ : φ ∈ com Q.q) (z : Fin 2 → ℂ) :
    liftM hHL hU φ z = (liftM hHL hU φ ![1, 0] 0) • z := by
  set M := liftM hHL hU φ
  have hs : (√2 : ℂ) ≠ 0 := BPAnalytic.QM.sqrt2_ne_zero
  have hI0 := liftM_comm hHL hU hι hφ oI ![1, 0]
  have hI1 := liftM_comm hHL hU hι hφ oI ![0, 1]
  have hJ0 := liftM_comm hHL hU hι hφ oJ ![1, 0]
  rw [qmMat_oI] at hI0 hI1
  rw [qmMat_oJ] at hJ0
  have e0 : (!![(√2 : ℂ), 0; 0, -(√2 : ℂ)]).mulVec ![1, 0] = (√2 : ℂ) • ![1, 0] := by
    ext i; fin_cases i <;> simp [Matrix.mulVec, dotProduct]
  have e1 : (!![(√2 : ℂ), 0; 0, -(√2 : ℂ)]).mulVec ![0, 1] = (-(√2 : ℂ)) • ![0, 1] := by
    ext i; fin_cases i <;> simp [Matrix.mulVec, dotProduct]
  have eJ : (!![(0 : ℂ), -3; 1, 0]).mulVec ![1, 0] = ![0, 1] := by
    ext i; fin_cases i <;> simp [Matrix.mulVec, dotProduct]
  rw [e0, map_smul] at hI0
  rw [e1, map_smul] at hI1
  rw [eJ] at hJ0
  have u1 : M ![1, 0] 1 = 0 := by
    have := congrFun hI0 1
    simp [Matrix.mulVec, dotProduct] at this
    have h2 : (√2 : ℂ) * (2 * M ![1, 0] 1) = 0 := by linear_combination this
    have := (mul_eq_zero.mp h2).resolve_left hs
    linear_combination this / 2
  have w0 : M ![0, 1] 0 = 0 := by
    have := congrFun hI1 0
    simp [Matrix.mulVec, dotProduct] at this
    have h2 : (√2 : ℂ) * (2 * M ![0, 1] 0) = 0 := by linear_combination -this
    have := (mul_eq_zero.mp h2).resolve_left hs
    linear_combination this / 2
  have w1 : M ![0, 1] 1 = M ![1, 0] 0 := by
    have := congrFun hJ0 1
    simpa [Matrix.mulVec, dotProduct] using this
  have hz : z = z 0 • ![1, 0] + z 1 • ![0, 1] := by
    ext i; fin_cases i <;> simp
  rw [hz, map_add, map_smul, map_smul]
  ext i; fin_cases i <;> simp [u1, w0, w1] <;> ring

end Lift

/-! ## G3c. `CMAnalytic` -/

/-- **The glue `CMAnalytic`, proved from the bundle's textbook leaf `HomLinearLift`.** -/
theorem cmAnalytic_of (hHL : ZInQ.HomUnify.HomLinearLift) : CMAnalytic := by
  intro τ Q Φu hU hι
  have hτ := τ.im_pos.ne'
  set v : Fin 2 → ℂ := ![(τ : ℂ), 1]
  let lam : PkgI3.AbVar.End Q.A → ℂ := fun f => liftM hHL hU f ![1, 0] 0
  have hlam : ∀ φ : com Q.q, ∀ z, liftM hHL hU φ z = lam φ • z :=
    fun φ z => liftM_scalar hHL hU hι φ.2 z
  -- `λ_φ (τ, 1)ᵀ ∈ Λ_τ`
  have hmem : ∀ φ : com Q.q, lam φ • v ∈ LamT τ := fun φ => by
    rw [← hlam φ v, ← hU.2.1, liftM_spec hHL hU, (hU.2.1 v).2 (qmVec0_mem hτ)]
    exact MonObj.one_comp _
  choose β hβO hβ using fun φ : com Q.q => exists_of_mem_qmLattice hτ (hmem φ)
  -- `λ` on products, sums, `1`, `0`
  have lam_mul : ∀ φ ψ : com Q.q,
      lam ((φ * ψ : com Q.q) : PkgI3.AbVar.End Q.A) = lam φ * lam ψ := by
    intro φ ψ
    have h := congrArg (fun M => M ![1, 0]) (liftM_mul hHL hU φ ψ)
    simp only [LinearMap.comp_apply] at h
    rw [hlam ψ, map_smul, hlam φ] at h
    show liftM hHL hU ((φ : PkgI3.AbVar.End Q.A) * ψ) ![1, 0] 0 = _
    rw [h]; simp [lam, mul_comm]
  have lam_add : ∀ φ ψ : com Q.q,
      lam ((φ + ψ : com Q.q) : PkgI3.AbVar.End Q.A) = lam φ + lam ψ := by
    intro φ ψ
    have h := congrArg (fun M => M ![1, 0]) (liftM_add hHL hU φ ψ)
    simp only [LinearMap.add_apply] at h
    show liftM hHL hU ((φ : PkgI3.AbVar.End Q.A) + ψ) ![1, 0] 0 = _
    rw [h]; simp [lam]
  have lam_one : lam ((1 : com Q.q) : PkgI3.AbVar.End Q.A) = 1 := by
    show liftM hHL hU 1 ![1, 0] 0 = 1
    rw [liftM_one]; simp
  have lam_zero : lam ((0 : com Q.q) : PkgI3.AbVar.End Q.A) = 0 := by
    show liftM hHL hU 0 ![1, 0] 0 = 0
    rw [liftM_zero]; simp
  refine ⟨{ toFun := β, map_one' := ?_, map_mul' := ?_, map_zero' := ?_, map_add' := ?_ },
    fun φ => ⟨hβO φ, lam φ, hβ φ⟩⟩
  · apply iota_eig_inj hτ
    rw [hβ, lam_one, map_one, Matrix.one_mulVec, one_smul]
  · intro φ ψ
    apply iota_eig_inj hτ
    rw [hβ, lam_mul, map_mul, ← Matrix.mulVec_mulVec, hβ, Matrix.mulVec_smul, hβ, smul_smul,
      mul_comm]
  · apply iota_eig_inj hτ
    rw [hβ, lam_zero, map_zero, Matrix.zero_mulVec, zero_smul]
  · intro φ ψ
    apply iota_eig_inj hτ
    rw [hβ, lam_add, map_add, Matrix.add_mulVec, hβ, hβ, add_smul]

end RayClassCFT


/-! ===== from scratch/rayclass-cft/RayGlueB.lean ===== -/


/-! # rayclass-cft, Part G4: the glue `CMBaseChange`, proved

`IsPullback g` makes `Q.A` isomorphic over `L` to the base change `(P.A)_L` (`bcIso`); the isomorphism
preserves the identity (the `η`-clause at `a = 0`), hence is a homomorphism (the kernel's proved
rigidity `G0FibreSimple.rigidityHom`); conjugation by it after the kernel's `endBC` is a ring map
`End P.A → End Q.A` carrying `ι_P` to `ι_Q` (the `ι`-clause), hence `End_𝒪(P)` into `End_𝒪(Q)`. -/

set_option linter.all false

noncomputable section

namespace RayClassCFT

open CategoryTheory AlgebraicGeometry Limits MonoidalCategory CartesianMonoidalCategory MonObj
open LeafQM LeafQM.AV

variable {K L : Type} [Field K] [Field L] [Algebra K L]

/-- The map `Spec L → Spec K`. -/
abbrev fS (K L : Type) [Field K] [Field L] [Algebra K L] :
    Spec (CommRingCat.of L) ⟶ Spec (CommRingCat.of K) :=
  Spec.map (CommRingCat.ofHom (algebraMap K L))

/-- The identity point of `A(K)` is the unit section. -/
theorem one_pt_left (A : PkgI3.AbVar K) :
    ((1 : A.Pt K) : PkgI3.AbVar.ptObj K ⟶ A.X).left = η[A.X].left := by
  rw [Hom.one_def, Over.comp_left]
  have h1 : (toUnit (PkgI3.AbVar.ptObj (K := K) K)).left = 𝟙 (Spec (CommRingCat.of K)) := by
    have h := Over.w (toUnit (PkgI3.AbVar.ptObj (K := K) K))
    have h' : (toUnit (PkgI3.AbVar.ptObj (K := K) K)).left = (PkgI3.AbVar.ptObj (K := K) K).hom :=
      (Category.comp_id _).symm.trans h
    rw [h']
    show Spec.map (CommRingCat.ofHom (algebraMap K K)) = _
    rw [Algebra.algebraMap_self, CommRingCat.ofHom_id, Spec.map_id]
  rw [h1]
  exact Category.id_comp _

theorem eta_compat {P : QML3 K} {Q : QML3 L} {g : Q.A.X.left ⟶ P.A.X.left}
    (hη : ∀ a : O, (Additive.toMul (Q.e.eta a)).left ≫ g =
      fS K L ≫ (Additive.toMul (P.e.eta a)).left) :
    η[Q.A.X].left ≫ g = fS K L ≫ η[P.A.X].left := by
  have h := hη 0
  have eQ : (Additive.toMul (Q.e.eta 0)).left = η[Q.A.X].left := by
    rw [show Additive.toMul (Q.e.eta 0) = 1 by rw [map_zero]; rfl]
    exact one_pt_left Q.A
  have eP : (Additive.toMul (P.e.eta 0)).left = η[P.A.X].left := by
    rw [show Additive.toMul (P.e.eta 0) = 1 by rw [map_zero]; rfl]
    exact one_pt_left P.A
  have h' : (Additive.toMul (Q.e.eta 0)).left ≫ g = fS K L ≫ η[P.A.X].left := by
    rw [h]; congr 1
  rw [← h']; congr 1; exact eQ.symm

/-- `Q.A ≅ (P.A)_L` over `L` from the pullback square. -/
def bcIso {P : QML3 K} {Q : QML3 L} {g : Q.A.X.left ⟶ P.A.X.left}
    (hpb : IsPullback g Q.A.X.hom P.A.X.hom (fS K L)) : Q.A.X ≅ (P.A.baseChange L).X :=
  Over.isoMk hpb.isoPullback (by
    show hpb.isoPullback.hom ≫ pullback.snd _ _ = _
    exact hpb.isoPullback_hom_snd)

theorem bcIso_fst {P : QML3 K} {Q : QML3 L} {g : Q.A.X.left ⟶ P.A.X.left}
    (hpb : IsPullback g Q.A.X.hom P.A.X.hom (fS K L)) :
    (bcIso hpb).hom.left ≫ pullback.fst P.A.X.hom (fS K L) = g :=
  hpb.isoPullback_hom_fst

theorem bcIso_snd {P : QML3 K} {Q : QML3 L} {g : Q.A.X.left ⟶ P.A.X.left}
    (hpb : IsPullback g Q.A.X.hom P.A.X.hom (fS K L)) :
    (bcIso hpb).hom.left ≫ pullback.snd P.A.X.hom (fS K L) = Q.A.X.hom :=
  hpb.isoPullback_hom_snd

/-- The unit of `(P.A)_L`, on the pullback projections. -/
theorem eta_bc_fst (A : PkgI3.AbVar K) :
    η[(A.baseChange L).X].left ≫ pullback.fst A.X.hom (fS K L) = fS K L ≫ η[A.X].left := by
  let F := Over.pullback (fS K L)
  have hε1 : (Functor.LaxMonoidal.ε F).left ≫ pullback.snd (𝟙_ (Over (Spec (CommRingCat.of K)))).hom (fS K L) = 𝟙 _ := by
    exact Over.w (Functor.LaxMonoidal.ε F)
  have hε2 : (Functor.LaxMonoidal.ε F).left ≫ pullback.fst (𝟙_ (Over (Spec (CommRingCat.of K)))).hom (fS K L) = fS K L := by
    have hc : pullback.fst (𝟙_ (Over (Spec (CommRingCat.of K)))).hom (fS K L) =
        pullback.snd (𝟙_ (Over (Spec (CommRingCat.of K)))).hom (fS K L) ≫ fS K L :=
      (Category.comp_id _).symm.trans pullback.condition
    rw [hc, ← Category.assoc, hε1, Category.id_comp]
  show (Functor.LaxMonoidal.ε F ≫ F.map η[A.X]).left ≫ pullback.fst A.X.hom (fS K L) = _
  rw [Over.comp_left, Category.assoc]
  show (Functor.LaxMonoidal.ε F).left ≫ pullback.lift (pullback.fst _ _ ≫ η[A.X].left) (pullback.snd _ _) _ ≫
    pullback.fst A.X.hom (fS K L) = _
  rw [pullback.lift_fst, ← Category.assoc, hε2]

theorem eta_bc_snd (A : PkgI3.AbVar K) :
    η[(A.baseChange L).X].left ≫ pullback.snd A.X.hom (fS K L) = 𝟙 _ := by
  exact Over.w η[(A.baseChange L).X]

theorem bcIso_eta {P : QML3 K} {Q : QML3 L} {g : Q.A.X.left ⟶ P.A.X.left}
    (hpb : IsPullback g Q.A.X.hom P.A.X.hom (fS K L))
    (hη : η[Q.A.X].left ≫ g = fS K L ≫ η[P.A.X].left) :
    η[Q.A.X] ≫ (bcIso hpb).hom = η[(P.A.baseChange L).X] := by
  apply Over.OverMorphism.ext
  rw [Over.comp_left]
  apply pullback.hom_ext
  · calc (η[Q.A.X].left ≫ (bcIso hpb).hom.left) ≫ pullback.fst P.A.X.hom (fS K L)
        = η[Q.A.X].left ≫ ((bcIso hpb).hom.left ≫ pullback.fst P.A.X.hom (fS K L)) :=
          Category.assoc _ _ _
      _ = η[Q.A.X].left ≫ g := by rw [bcIso_fst]
      _ = fS K L ≫ η[P.A.X].left := hη
      _ = _ := (eta_bc_fst P.A).symm
  · calc (η[Q.A.X].left ≫ (bcIso hpb).hom.left) ≫ pullback.snd P.A.X.hom (fS K L)
        = η[Q.A.X].left ≫ ((bcIso hpb).hom.left ≫ pullback.snd P.A.X.hom (fS K L)) :=
          Category.assoc _ _ _
      _ = η[Q.A.X].left ≫ Q.A.X.hom := by rw [bcIso_snd]
      _ = 𝟙 _ := Over.w η[Q.A.X]
      _ = _ := (eta_bc_snd P.A).symm

/-! ## Rigidity: `bcIso` is a homomorphism -/

theorem bcIso_isMonHom {P : QML3 K} {Q : QML3 L} {g : Q.A.X.left ⟶ P.A.X.left}
    (hpb : IsPullback g Q.A.X.hom P.A.X.hom (fS K L))
    (hη : η[Q.A.X].left ≫ g = fS K L ≫ η[P.A.X].left) : IsMonHom (bcIso hpb).hom :=
  G0FibreSimple.rigidityHom L Q.A (P.A.baseChange L) (bcIso hpb).hom (bcIso_eta hpb hη)

theorem bcIso_inv_isMonHom {P : QML3 K} {Q : QML3 L} {g : Q.A.X.left ⟶ P.A.X.left}
    (hpb : IsPullback g Q.A.X.hom P.A.X.hom (fS K L))
    (hη : η[Q.A.X].left ≫ g = fS K L ≫ η[P.A.X].left) : IsMonHom (bcIso hpb).inv :=
  G0FibreSimple.rigidityHom L (P.A.baseChange L) Q.A (bcIso hpb).inv (by
    rw [← bcIso_eta hpb hη, Category.assoc, Iso.hom_inv_id, Category.comp_id])

/-! ## Conjugation by a group isomorphism -/

/-- `f ↦ e ∘ f ∘ e⁻¹`, `End B → End A`, for an isomorphism of abelian varieties `e : A ≅ B`. -/
def conjEnd {A B : PkgI3.AbVar L} (e : A.X ≅ B.X) (h1 : IsMonHom e.hom) (h2 : IsMonHom e.inv) :
    PkgI3.AbVar.End B →+* PkgI3.AbVar.End A where
  toFun f := @PkgI3.AbVar.Hom.mk' L _ A A (e.hom ≫ f.hom ≫ e.inv) inferInstance
  map_one' := PkgI3.AbVar.Hom.ext' (by
    change e.hom ≫ 𝟙 _ ≫ e.inv = 𝟙 _
    simp)
  map_mul' f g := PkgI3.AbVar.Hom.ext' (by
    change e.hom ≫ (g.hom ≫ f.hom) ≫ e.inv = (e.hom ≫ g.hom ≫ e.inv) ≫ (e.hom ≫ f.hom ≫ e.inv)
    simp)
  map_zero' := PkgI3.AbVar.Hom.ext' (by
    change e.hom ≫ (1 : B.X ⟶ B.X) ≫ e.inv = 1
    rw [MonObj.one_comp, MonObj.comp_one])
  map_add' f g := PkgI3.AbVar.Hom.ext' (by
    change e.hom ≫ (f.hom * g.hom) ≫ e.inv = (e.hom ≫ f.hom ≫ e.inv) * (e.hom ≫ g.hom ≫ e.inv)
    rw [MonObj.mul_comp, MonObj.comp_mul])

/-! ## `bcIso` intertwines `ι_Q` and the base change of `ι_P` -/

theorem pb_map_fst {X Y : Over (Spec (CommRingCat.of K))} (u : X ⟶ Y) :
    ((Over.pullback (fS K L)).map u).left ≫ pullback.fst Y.hom (fS K L) =
      pullback.fst X.hom (fS K L) ≫ u.left :=
  pullback.lift_fst _ _ _

theorem pb_map_snd {X Y : Over (Spec (CommRingCat.of K))} (u : X ⟶ Y) :
    ((Over.pullback (fS K L)).map u).left ≫ pullback.snd Y.hom (fS K L) =
      pullback.snd X.hom (fS K L) :=
  pullback.lift_snd _ _ _

theorem endBC_fst (A : PkgI3.AbVar K) (f : PkgI3.AbVar.End A) :
    (HDec.G0ModField.KernelField.endBC A L f).hom.left ≫ pullback.fst A.X.hom (fS K L) =
      pullback.fst A.X.hom (fS K L) ≫ f.hom.left :=
  pb_map_fst f.hom

theorem endBC_snd (A : PkgI3.AbVar K) (f : PkgI3.AbVar.End A) :
    (HDec.G0ModField.KernelField.endBC A L f).hom.left ≫ pullback.snd A.X.hom (fS K L) =
      pullback.snd A.X.hom (fS K L) :=
  pb_map_snd f.hom

theorem bc_iota {P : QML3 K} {Q : QML3 L} {g : Q.A.X.left ⟶ P.A.X.left}
    (hpb : IsPullback g Q.A.X.hom P.A.X.hom (fS K L))
    (hι : ∀ a : O, (Q.q.iota a).hom.left ≫ g = g ≫ (P.q.iota a).hom.left) (a : O) :
    (bcIso hpb).hom ≫ (HDec.G0ModField.KernelField.endBC P.A L (P.q.iota a)).hom =
      (Q.q.iota a).hom ≫ (bcIso hpb).hom := by
  apply Over.OverMorphism.ext
  show hpb.isoPullback.hom ≫ pullback.lift (pullback.fst P.A.X.hom (fS K L) ≫ (P.q.iota a).hom.left)
      (pullback.snd P.A.X.hom (fS K L)) _ = (Q.q.iota a).hom.left ≫ hpb.isoPullback.hom
  apply pullback.hom_ext
  · rw [Category.assoc, pullback.lift_fst, ← Category.assoc, hpb.isoPullback_hom_fst, Category.assoc,
      hpb.isoPullback_hom_fst, hι]
  · rw [Category.assoc, pullback.lift_snd, hpb.isoPullback_hom_snd, Category.assoc,
      hpb.isoPullback_hom_snd]
    exact (Over.w (Q.q.iota a).hom).symm

/-! ## The ring map `End P.A → End Q.A` and `CMBaseChange` -/

theorem exists_bc_ringHom {P : QML3 K} {Q : QML3 L} (h : IsBaseChangeOf (algebraMap K L) P Q) :
    ∃ R : PkgI3.AbVar.End P.A →+* PkgI3.AbVar.End Q.A, ∀ a : O, R (P.q.iota a) = Q.q.iota a := by
  obtain ⟨g, hpb, hι, hη⟩ := h
  have hη0 := eta_compat (P := P) (Q := Q) (g := g) hη
  let e := bcIso hpb
  have h1 := bcIso_isMonHom hpb hη0
  have h2 := bcIso_inv_isMonHom hpb hη0
  refine ⟨(conjEnd e h1 h2).comp (HDec.G0ModField.KernelField.endBC P.A L), fun a => ?_⟩
  apply PkgI3.AbVar.Hom.ext'
  change e.hom ≫ (HDec.G0ModField.KernelField.endBC P.A L (P.q.iota a)).hom ≫ e.inv = (Q.q.iota a).hom
  rw [← Category.assoc, bc_iota hpb hι a, Category.assoc, Iso.hom_inv_id, Category.comp_id]

theorem com_map {P : QML3 K} {Q : QML3 L} (R : PkgI3.AbVar.End P.A →+* PkgI3.AbVar.End Q.A)
    (hR : ∀ a : O, R (P.q.iota a) = Q.q.iota a) {φ : PkgI3.AbVar.End P.A} (hφ : φ ∈ com P.q) :
    R φ ∈ com Q.q := by
  rw [com, Subring.mem_centralizer_iff]
  rintro _ ⟨a, rfl⟩
  rw [← hR, ← map_mul, ← map_mul, (Subring.mem_centralizer_iff.1 hφ) _ ⟨a, rfl⟩]

/-- **The glue `CMBaseChange`, proved** (rigidity is the kernel's proved `G0FibreSimple.rigidityHom`). -/
theorem cmBaseChange : CMBaseChange := by
  intro ιe P Q h
  letI : Algebra Qbar ℂ := ιe.toAlgebra
  obtain ⟨R, hR⟩ := exists_bc_ringHom (K := Qbar) (L := ℂ) (P := P) (Q := Q) h
  refine ⟨fun ⟨φ, hφ, h2⟩ => ⟨R φ, com_map R hR hφ, ?_⟩, fun ⟨φ, hφ, h2⟩ => ⟨R φ, com_map R hR hφ, ?_⟩,
    fun ⟨φ, hφ, h2⟩ => ⟨R φ, com_map R hR hφ, ?_⟩⟩
  · rw [← map_mul, h2, map_neg, map_one]
  · have := congrArg R h2
    rwa [map_add, map_sub, map_mul, map_one, map_zero] at this
  · rw [← map_mul, h2, map_neg, map_ofNat]

end RayClassCFT


/-! ===== from scratch/gt-rayclass/NewCNO.lean ===== -/

/-! # gt-rayclass: Eichler's class number one in adelic form, proved

`ClassNumberOneB` (rayclass-cft's leaf) from the chain's `HDec.QMSplit.CNO.principal_of_lattice` (the
norm-Euclidean computation that proves `qmClassNumberOne_proof`): for `g ∈ (B ⊗ 𝔸_f)^×` the left ideal
`I = {x ∈ B : x g ∈ 𝒪̂}` is `𝒪α`, and then `u = α g ∈ 𝒪̂^×`, `g = α⁻¹ u`. The adelic inputs:
* `exists_den`: every finite adele has a denominator `d ∈ ℕ`, `d a ∈ ℤ̂`;
* `exists_int_approx`: `a ∈ ℤ̂`, `N ≥ 1` ⇒ `a = m + N b` with `m ∈ ℤ`, `b ∈ ℤ̂` (`ℤ̂ → ℤ/N` onto; Mathlib's
  `PadicInt.appr` at the primes dividing `N` and the Chinese remainder theorem). -/

noncomputable section

namespace RayClassCFT

open LeafQM NumberField IsDedekindDomain HeightOneSpectrum Rat.HeightOneSpectrum
open ShimuraCFT

/-! ## Adelic bookkeeping -/

theorem mem_ZhatQ {a : AQ} : a ∈ ZhatQ ↔ ∀ v : HeightOneSpectrum (𝓞 ℚ), a v ∈ v.adicCompletionIntegers ℚ :=
  Iff.rfl

/-- Evaluation of a finite adele at a place, as a ring hom. -/
def evQ (v : HeightOneSpectrum (𝓞 ℚ)) : AQ →+* v.adicCompletion ℚ where
  toFun a := a v
  map_one' := rfl
  map_mul' _ _ := rfl
  map_zero' := rfl
  map_add' _ _ := rfl

theorem evQ_apply (v : HeightOneSpectrum (𝓞 ℚ)) (a : AQ) : evQ v a = a v := rfl

section Den

/- As in the chain's `TailZ12`: prefer Mathlib's `instAlgebraAdicCompletion` (the instance in the statement of
`mul_nonZeroDivisor_mem_adicCompletionIntegers`). -/
attribute [local instance 2000] instAlgebraAdicCompletion

open scoped algebraMap in
/-- **Denominators**: every finite adele `a` has `d ≥ 1` with `d a ∈ ℤ̂`. -/
theorem exists_den (a : AQ) : ∃ d : ℕ, 0 < d ∧ (d : AQ) * a ∈ ZhatQ := by
  classical
  have hfin : {v : HeightOneSpectrum (𝓞 ℚ) | ¬ a v ∈ v.adicCompletionIntegers ℚ}.Finite :=
    Filter.eventually_cofinite.1 (FiniteAdeleRing.cofinite_mem_adicCompletionIntegers a)
  choose b hb hab using fun v : HeightOneSpectrum (𝓞 ℚ) =>
    adicCompletion.mul_nonZeroDivisor_mem_adicCompletionIntegers v (a v)
  set S := hfin.toFinset
  set D : 𝓞 ℚ := ∏ v ∈ S, b v with hDdef
  have hD0 : D ≠ 0 := Finset.prod_ne_zero_iff.2 (fun v _ => nonZeroDivisors.ne_zero (hb v))
  have hprod : ∀ (w : HeightOneSpectrum (𝓞 ℚ)) (T : Finset (HeightOneSpectrum (𝓞 ℚ))),
      algebraMap (𝓞 ℚ) (w.adicCompletion ℚ) (∏ v ∈ T, b v) ∈ w.adicCompletionIntegers ℚ := by
    intro w T
    rw [map_prod]
    exact prod_mem (fun v _ => coe_mem_adicCompletionIntegers w (b v))
  have hint : ∀ w : HeightOneSpectrum (𝓞 ℚ),
      a w * algebraMap (𝓞 ℚ) (w.adicCompletion ℚ) D ∈ w.adicCompletionIntegers ℚ := by
    intro w
    by_cases hw : w ∈ S
    · rw [hDdef, ← Finset.mul_prod_erase S b hw, map_mul, ← mul_assoc]
      exact mul_mem (hab w) (hprod w _)
    · have : a w ∈ w.adicCompletionIntegers ℚ := by
        by_contra hc
        exact hw (hfin.mem_toFinset.2 hc)
      exact mul_mem this (hprod w S)
  set n : ℤ := Rat.ringOfIntegersEquiv D
  have hDn : D = (n : 𝓞 ℚ) := by
    rw [show (n : 𝓞 ℚ) = Rat.ringOfIntegersEquiv.symm n from (eq_intCast _ n).symm]
    exact (Rat.ringOfIntegersEquiv.symm_apply_apply D).symm
  have hn0 : n ≠ 0 := by
    intro h0; apply hD0; rw [hDn, h0, Int.cast_zero]
  refine ⟨n.natAbs, Int.natAbs_pos.2 hn0, mem_ZhatQ.2 fun w => ?_⟩
  have h := hint w
  rw [hDn, map_intCast] at h
  change evQ w ((n.natAbs : AQ) * a) ∈ _
  rw [map_mul, map_natCast, evQ_apply, mul_comm]
  rcases Int.natAbs_eq n with h' | h'
  · rw [h'] at h; simpa using h
  · rw [h'] at h
    have := neg_mem h
    simpa using this

end Den

/-- In `ℤ_[q]`: if `q^{v_q(N)}` divides `m − appr(y)`, then `N` divides `y − m`. -/
theorem padic_div {q : ℕ} [Fact q.Prime] (y : ℤ_[q]) (m : ℤ) {N : ℕ} (hN : N ≠ 0)
    (h : (q : ℤ) ^ (N.factorization q) ∣ m - (y.appr (N.factorization q) : ℤ)) :
    ∃ c : ℤ_[q], y - m = N * c := by
  set k := N.factorization q
  obtain ⟨c1, hc1⟩ := Ideal.mem_span_singleton'.1 (PadicInt.appr_spec k y)
  obtain ⟨c2, hc2⟩ := h
  have hc2' : (m : ℤ_[q]) - ((y.appr k : ℕ) : ℤ_[q]) = (q : ℤ_[q]) ^ k * (c2 : ℤ_[q]) := by
    have := congrArg (Int.cast : ℤ → ℤ_[q]) hc2
    push_cast at this
    exact this
  have hcop : q.Coprime (N / q ^ k) := by
    rw [Nat.Prime.coprime_iff_not_dvd (Fact.out)]
    exact Nat.not_dvd_ordCompl (Fact.out) hN
  have hu : IsUnit ((N / q ^ k : ℕ) : ℤ_[q]) :=
    PadicInt.isUnit_iff.2 (PadicInt.norm_natCast_eq_one_iff.2 hcop)
  obtain ⟨u, hu⟩ := hu
  have hNf : (N : ℤ_[q]) = (q : ℤ_[q]) ^ k * ((N / q ^ k : ℕ) : ℤ_[q]) := by
    have := Nat.ordProj_mul_ordCompl_eq_self N q
    exact_mod_cast this.symm
  refine ⟨(↑u⁻¹ : ℤ_[q]) * (c1 - c2), ?_⟩
  rw [hNf, ← hu]
  have e : y - m = (q : ℤ_[q]) ^ k * (c1 - c2) := by linear_combination hc1.symm - hc2'
  rw [e]
  calc (q : ℤ_[q]) ^ k * (c1 - c2) = (q : ℤ_[q]) ^ k * ((u : ℤ_[q]) * ↑u⁻¹ * (c1 - c2)) := by
        rw [Units.mul_inv, one_mul]
    _ = (q : ℤ_[q]) ^ k * (u : ℤ_[q]) * (↑u⁻¹ * (c1 - c2)) := by ring

/-- **Approximation**: `a ∈ ℤ̂`, `N ≥ 1` ⇒ `a = m + N b` with `m ∈ ℤ`, `b ∈ ℤ̂`. -/
theorem exists_int_approx {a : AQ} (ha : a ∈ ZhatQ) (N : ℕ) (hN : 0 < N) :
    ∃ m : ℤ, ∃ b ∈ ZhatQ, a = (m : AQ) + (N : AQ) * b := by
  classical
  let loc : ∀ v : HeightOneSpectrum (𝓞 ℚ), v.adicCompletionIntegers ℚ ≃+* ℤ_[primesEquiv v] :=
    fun v => (adicCompletionIntegers.padicIntEquiv (R := 𝓞 ℚ) v :
      v.adicCompletionIntegers ℚ ≃+* ℤ_[primesEquiv v])
  let x : ∀ v : HeightOneSpectrum (𝓞 ℚ), ℤ_[primesEquiv v] := fun v => loc v ⟨a v, ha v⟩
  let r : HeightOneSpectrum (𝓞 ℚ) → ℤ := fun v =>
    ((x v).appr (N.factorization (primesEquiv v : ℕ)) : ℤ)
  let vOf : N.primeFactors → HeightOneSpectrum (𝓞 ℚ) := fun p =>
    (primesEquiv (R := 𝓞 ℚ)).symm ⟨p.1, Nat.prime_of_mem_primeFactors p.2⟩
  let I : N.primeFactors → Ideal ℤ := fun p => Ideal.span {((p.1 : ℕ) : ℤ) ^ N.factorization p.1}
  have hI : Pairwise (Function.onFun IsCoprime I) := by
    intro p p' hpp'
    simp only [Function.onFun, I]
    rw [Ideal.isCoprime_span_singleton_iff, Int.isCoprime_iff_gcd_eq_one]
    have hp := Nat.prime_of_mem_primeFactors p.2
    have hp' := Nat.prime_of_mem_primeFactors p'.2
    have hne : p.1 ≠ p'.1 := fun h => hpp' (Subtype.ext h)
    have hc : Nat.Coprime (p.1 ^ N.factorization p.1) (p'.1 ^ N.factorization p'.1) :=
      Nat.Coprime.pow _ _ ((Nat.coprime_primes hp hp').2 hne)
    rw [← Nat.cast_pow, ← Nat.cast_pow, Int.gcd_natCast_natCast]
    exact hc
  obtain ⟨m, hm⟩ := Ideal.exists_forall_sub_mem_ideal hI (fun p => r (vOf p))
  -- local divisibility at every place
  have hloc : ∀ v : HeightOneSpectrum (𝓞 ℚ), ∃ c : ℤ_[primesEquiv v], x v - m = N * c := by
    intro v
    apply padic_div (x v) m hN.ne'
    by_cases hd : (primesEquiv v : ℕ) ∣ N
    · have hmem : (primesEquiv v : ℕ) ∈ N.primeFactors :=
        Nat.mem_primeFactors.2 ⟨(primesEquiv v).2, hd, hN.ne'⟩
      have hv : vOf ⟨_, hmem⟩ = v := (primesEquiv (R := 𝓞 ℚ)).symm_apply_apply v
      have := hm ⟨_, hmem⟩
      rw [hv] at this
      exact Ideal.mem_span_singleton.1 this
    · rw [Nat.factorization_eq_zero_of_not_dvd hd, pow_zero]
      exact one_dvd _
  -- the adele `b`
  set cinv : AQ := algebraMap ℚ AQ ((N : ℚ)⁻¹) with hcinv
  have hNc : (N : AQ) * cinv = 1 := by
    rw [hcinv, ← map_natCast (algebraMap ℚ AQ) N, ← map_mul, mul_inv_cancel₀ (by exact_mod_cast hN.ne'),
      map_one]
  refine ⟨m, (a - m) * cinv, mem_ZhatQ.2 fun v => ?_, by linear_combination (-(a - (m : AQ))) * hNc⟩
  obtain ⟨c, hc⟩ := hloc v
  have e1 : (⟨a v, ha v⟩ : v.adicCompletionIntegers ℚ) - (m : v.adicCompletionIntegers ℚ) =
      (N : v.adicCompletionIntegers ℚ) * (loc v).symm c := by
    apply (loc v).injective
    rw [map_sub, map_intCast, map_mul, map_natCast, RingEquiv.apply_symm_apply]
    exact hc
  have e2 := congrArg (v.adicCompletionIntegers ℚ).subtype e1
  simp only [map_sub, map_mul, map_intCast, map_natCast] at e2
  have hNv := congrArg (evQ v) hNc
  rw [map_mul, map_natCast, map_one] at hNv
  change evQ v ((a - m) * cinv) ∈ _
  rw [map_mul, map_sub, map_intCast, evQ_apply]
  have e3 : (a v - (m : v.adicCompletion ℚ)) * evQ v cinv = ((loc v).symm c : v.adicCompletion ℚ) := by
    have e2' : a v - (m : v.adicCompletion ℚ) = (N : v.adicCompletion ℚ) * ((loc v).symm c : v.adicCompletion ℚ) :=
      e2
    rw [e2', mul_comm, ← mul_assoc, mul_comm (evQ v cinv), hNv, one_mul]
  rw [e3]
  exact ((loc v).symm c).2

/-! ## Lemmas on `B ⊗ 𝔸_f` -/

theorem OhatQ_neg {x : BAQ} (hx : x ∈ OhatQ) : -x ∈ OhatQ := by
  obtain ⟨n, hn, rfl⟩ := hx
  exact ⟨-n, fun i => ZhatS.neg_mem (hn i), ShimuraGlue.ofQ_neg n⟩

theorem OhatQ_of_cQ {x : BAQ} (h : ∀ i, cQ x i ∈ ZhatQ) : x ∈ OhatQ :=
  ⟨cQ x, h, ShimuraGlue.ofQ_coords x⟩

theorem cQ_natCast_mul (d : ℕ) (x : BAQ) : cQ ((d : BAQ) * x) = fun i => (d : AQ) * cQ x i := by
  funext i
  fin_cases i <;> simp [cQ] <;> ring

theorem natCast_mul_ofQ (d : ℕ) (n : Fin 4 → AQ) :
    (d : BAQ) * ShimuraGlue.ofQ n = ShimuraGlue.ofQ (fun i => (d : AQ) * n i) := by
  ext <;> simp [ShimuraGlue.ofQ] <;> ring

/-- Every `x ∈ B ⊗ 𝔸_f` has `D ≥ 1` with `D x ∈ 𝒪̂`. -/
theorem exists_den_B (x : BAQ) : ∃ D : ℕ, 0 < D ∧ (D : BAQ) * x ∈ OhatQ := by
  classical
  choose d hd hdx using fun i => exists_den (cQ x i)
  refine ⟨∏ i, d i, Finset.prod_pos (fun i _ => hd i), OhatQ_of_cQ fun i => ?_⟩
  rw [cQ_natCast_mul]
  show ((∏ j, d j : ℕ) : AQ) * cQ x i ∈ ZhatQ
  rw [← Finset.mul_prod_erase Finset.univ d (Finset.mem_univ i), Nat.cast_mul, mul_comm (d i : AQ),
    mul_assoc]
  exact ZhatS.mul_mem (natCast_mem ZhatS _) (hdx i)

theorem bEmb_ofInt (m : Fin 4 → ℤ) : bEmb (LeafQM.ofInt m) = ShimuraGlue.ofQ (fun i => ((m i : ℤ) : AQ)) := by
  have h1 := ShimuraGlue.ofQ_coords (bEmb (LeafQM.ofInt m))
  have h2 := cQ_bEmb (LeafQM.ofInt m)
  rw [cQ_ofInt] at h2
  conv_lhs => rw [h1]
  congr 1
  rw [show (![(bEmb (LeafQM.ofInt m)).re - (bEmb (LeafQM.ofInt m)).imJ,
      (bEmb (LeafQM.ofInt m)).imI - (bEmb (LeafQM.ofInt m)).imK,
      2 * (bEmb (LeafQM.ofInt m)).imJ, 2 * (bEmb (LeafQM.ofInt m)).imK] : Fin 4 → AQ) =
      cQ (bEmb (LeafQM.ofInt m)) from rfl, h2]
  funext i
  simp

theorem bEmb_natSmul (D : ℕ) (x : LeafQM.B) : bEmb ((D : ℚ) • x) = (D : BAQ) * bEmb x := by
  rw [map_smul, Nat.cast_smul_eq_nsmul, nsmul_eq_mul]

theorem inO_natSmul (D : ℕ) {x : LeafQM.B} (hx : InO x) : InO ((D : ℚ) • x) := by
  rw [Nat.cast_smul_eq_nsmul]
  exact (LeafQM.O.nsmul_mem (show x ∈ LeafQM.O from hx) D : _)

theorem nrd_natCast (D : ℕ) : ShimuraGlue.nrdQ ℚ ((D : ℕ) : LeafQM.B) = (D : ℚ) ^ 2 := by
  simp [ShimuraGlue.nrdQ_apply]

theorem nrd_smul (r : ℚ) (x : LeafQM.B) : ShimuraGlue.nrdQ ℚ (r • x) = r ^ 2 * ShimuraGlue.nrdQ ℚ x := by
  simp [ShimuraGlue.nrdQ_apply]; ring

theorem star_smul_B (r : ℚ) (x : LeafQM.B) : star (r • x) = r • star x := by
  ext <;> simp <;> ring

/-! ## Class number one -/

/-- **`ClassNumberOneB` proved** (Eichler's class number one for `𝒪`, adelic form), from the chain's
norm-Euclidean `HDec.QMSplit.CNO.principal_of_lattice`. -/
theorem classNumberOneB_proof : ClassNumberOneB := by
  intro g
  set h : BAQ := ((g⁻¹ : BAQˣ) : BAQ) with hh
  have hgh : (g : BAQ) * h = 1 := by simp [h]
  have hhg : h * (g : BAQ) = 1 := by simp [h]
  obtain ⟨D, hD, hDg, hDh⟩ : ∃ D : ℕ, 0 < D ∧ (D : BAQ) * g ∈ OhatQ ∧ (D : BAQ) * h ∈ OhatQ := by
    obtain ⟨D1, h1, e1⟩ := exists_den_B (g : BAQ)
    obtain ⟨D2, h2, e2⟩ := exists_den_B h
    refine ⟨D1 * D2, Nat.mul_pos h1 h2, ?_, ?_⟩
    · rw [show ((D1 * D2 : ℕ) : BAQ) = (D2 : BAQ) * D1 by rw [mul_comm D1 D2, Nat.cast_mul], mul_assoc]
      exact OhatQ_mul (OhatQ_natCast D2) e1
    · rw [Nat.cast_mul, mul_assoc]
      exact OhatQ_mul (OhatQ_natCast D1) e2
  -- the left ideal `I = B ∩ 𝒪̂ g⁻¹`
  let I : AddSubgroup LeafQM.B :=
    { carrier := {x | bEmb x * g ∈ OhatQ}
      add_mem' := fun {x y} hx hy => by
        simp only [Set.mem_setOf_eq, map_add, add_mul] at *
        exact OhatQ_add hx hy
      zero_mem' := by
        simp only [Set.mem_setOf_eq, map_zero, zero_mul]
        exact OhatQ_zero
      neg_mem' := fun {x} hx => by
        simp only [Set.mem_setOf_eq, map_neg, neg_mul] at *
        exact OhatQ_neg hx }
  have hmemI : ∀ x, x ∈ I ↔ bEmb x * g ∈ OhatQ := fun x => Iff.rfl
  have hI : ∀ q ∈ LeafQM.O, ∀ x ∈ I, q * x ∈ I := by
    intro q hq x hx
    rw [hmemI, map_mul, mul_assoc]
    exact OhatQ_mul (bEmb_mem_of_inO hq) hx
  have hdI : ∀ x ∈ I, ((D : ℕ) : ℚ) • x ∈ LeafQM.O := by
    intro x hx
    apply inO_of_bEmb_mem
    rw [bEmb_natSmul]
    have e : (D : BAQ) * bEmb x = (bEmb x * g) * ((D : BAQ) * h) := by
      calc (D : BAQ) * bEmb x = (D : BAQ) * bEmb x * (g * h) := by rw [hgh, mul_one]
        _ = ((D : BAQ) * (bEmb x * g)) * h := by simp only [mul_assoc]
        _ = ((bEmb x * g) * (D : BAQ)) * h := by rw [Nat.cast_comm]
        _ = (bEmb x * g) * ((D : BAQ) * h) := by simp only [mul_assoc]
    rw [e]
    exact OhatQ_mul hx hDh
  obtain ⟨α, hαI, hαgen⟩ := HDec.QMSplit.CNO.principal_of_lattice I hI D hD hdI
  -- `D ∈ I`, so `α ≠ 0`
  have hDI : ((D : ℕ) : LeafQM.B) ∈ I := by
    rw [hmemI, map_natCast]
    exact hDg
  obtain ⟨q0, -, hq0⟩ := hαgen _ hDI
  have hnα : ShimuraGlue.nrdQ ℚ α ≠ 0 := by
    intro h0
    have h1 := congrArg (ShimuraGlue.nrdQ ℚ) hq0
    rw [map_mul, h0, mul_zero, nrd_natCast] at h1
    have : (D : ℚ) ≠ 0 := by exact_mod_cast hD.ne'
    exact this ((pow_eq_zero_iff two_ne_zero).1 h1)
  -- an integer multiple of `α⁻¹` in `𝒪`
  have hDα : InO ((D : ℚ) • α) := hdI α hαI
  obtain ⟨M, hM⟩ : ∃ M : ℤ, ShimuraGlue.nrdQ ℚ ((D : ℚ) • α) = M := by
    have := nrd_mem_of_mem (bEmb_mem_of_inO hDα)
    rw [nrd_bEmb] at this
    exact (rat_mem_zhat_iff _).1 this
  have hM0 : M ≠ 0 := by
    intro h0
    rw [h0, Int.cast_zero, nrd_smul] at hM
    have : (D : ℚ) ≠ 0 := by exact_mod_cast hD.ne'
    exact hnα ((mul_eq_zero.1 hM).resolve_left (pow_ne_zero 2 this))
  have hMinv : InO ((M : ℚ) • binv α) := by
    have e : (M : ℚ) • binv α = (D : ℚ) • star ((D : ℚ) • α) := by
      rw [← hM, nrd_smul, binv, smul_smul, star_smul_B, smul_smul]
      congr 1
      field_simp
    rw [e]
    exact inO_natSmul D (inO_star hDα)
  set c : ℕ := M.natAbs with hcdef
  have hc : 0 < c := Int.natAbs_pos.2 hM0
  have hcO : InO ((c : ℚ) • binv α) := by
    rcases le_or_gt 0 M with hM' | hM'
    · have e : ((c : ℕ) : ℚ) = (M : ℚ) := by
        rw [hcdef, Nat.cast_natAbs, Int.cast_abs, abs_of_nonneg (by exact_mod_cast hM' : (0 : ℚ) ≤ M)]
      rw [e]; exact hMinv
    · have e : ((c : ℕ) : ℚ) = -(M : ℚ) := by
        rw [hcdef, Nat.cast_natAbs, Int.cast_abs, abs_of_neg (by exact_mod_cast hM' : (M : ℚ) < 0)]
      rw [e, neg_smul]
      exact LeafQM.O.neg_mem (show _ ∈ LeafQM.O from hMinv)
  -- approximation of `D g⁻¹` modulo `N = D² c`
  set N : ℕ := D * D * c with hNdef
  have hN : 0 < N := by positivity
  obtain ⟨nD, hnD, hDh'⟩ := hDh
  choose m b hb hmb using fun i => exists_int_approx (hnD i) N hN
  set w : BAQ := ShimuraGlue.ofQ b with hwdef
  have hw : w ∈ OhatQ := ⟨b, hb, rfl⟩
  have hsplit : (D : BAQ) * h = bEmb (LeafQM.ofInt m) + (N : BAQ) * w := by
    rw [hDh', hwdef, natCast_mul_ofQ, bEmb_ofInt, ShimuraGlue.ofQ_add]
    congr 1
    funext i
    exact hmb i
  set x0 : LeafQM.B := ((D : ℚ)⁻¹) • LeafQM.ofInt m with hx0def
  have hDu : IsUnit ((D : ℕ) : BAQ) := by
    rw [← map_natCast (algebraMap ℚ BAQ) D]
    exact (IsUnit.mk0 _ (by exact_mod_cast hD.ne' : (D : ℚ) ≠ 0)).map _
  have hx0 : bEmb x0 = h - ((D * c : ℕ) : BAQ) * w := by
    apply hDu.mul_left_cancel
    rw [← bEmb_natSmul, hx0def, smul_smul, mul_inv_cancel₀ (by exact_mod_cast hD.ne' : (D : ℚ) ≠ 0),
      one_smul, mul_sub, ← mul_assoc, ← Nat.cast_mul, ← mul_assoc D D c, ← hNdef, hsplit]
    abel
  have hx0I : x0 ∈ I := by
    rw [hmemI, hx0, sub_mul, hhg]
    have e : ((D * c : ℕ) : BAQ) * w * g = (c : BAQ) * (w * ((D : BAQ) * g)) := by
      rw [mul_comm D c, Nat.cast_mul, mul_assoc (c : BAQ), Nat.cast_comm D w]
      simp only [mul_assoc]
    rw [e, sub_eq_add_neg]
    exact OhatQ_add OhatQ_one (OhatQ_neg (OhatQ_mul (OhatQ_natCast c) (OhatQ_mul hw hDg)))
  obtain ⟨q, hq, hx0q⟩ := hαgen x0 hx0I
  -- the unit `u = α g`
  have hu0 : bEmb α * g ∈ OhatQ := hαI
  have hu1 : h * bEmb (binv α) ∈ OhatQ := by
    have e1 : h = bEmb x0 + ((D * c : ℕ) : BAQ) * w := by rw [hx0]; abel
    have e2 : h * bEmb (binv α) = bEmb q + (D : BAQ) * (w * bEmb ((c : ℚ) • binv α)) := by
      rw [e1, add_mul, hx0q, map_mul, mul_assoc, ← map_mul, mul_binv hnα, map_one, mul_one]
      congr 1
      rw [bEmb_natSmul, Nat.cast_mul, mul_assoc (D : BAQ), Nat.cast_comm c w]
      simp only [mul_assoc]
    rw [e2]
    exact OhatQ_add (bEmb_mem_of_inO hq)
      (OhatQ_mul (OhatQ_natCast D) (OhatQ_mul hw (bEmb_mem_of_inO hcO)))
  have hu01 : bEmb α * g * (h * bEmb (binv α)) = 1 := by
    rw [mul_assoc, ← mul_assoc (g : BAQ), hgh, one_mul, ← map_mul, mul_binv hnα, map_one]
  have hu10 : h * bEmb (binv α) * (bEmb α * g) = 1 := by
    rw [mul_assoc, ← mul_assoc (bEmb (binv α)), ← map_mul, binv_mul hnα, map_one, one_mul, hhg]
  let u : BAQˣ := ⟨bEmb α * g, h * bEmb (binv α), hu01, hu10⟩
  refine ⟨binv α, nrd_ne_zero_of_mul (binv_mul hnα), u, ⟨hu0, hu1⟩, ?_⟩
  show (g : BAQ) = bEmb (binv α) * (bEmb α * g)
  rw [← mul_assoc, ← map_mul, binv_mul hnα, map_one, one_mul]

end RayClassCFT


