import ZInQKernel.Contrib.OneProof.WeilPairingMumfordOpen
import ZInQKernel.Contrib.OneProof.PicZeroAbVarCharZero

/-!
# phisurj's theorems in characteristic `0`, from `PicZeroAbVar0` (fold33-pic, step 2)

piczero-char0 replaces the added field `picZeroAbVar : T09Pic.PicZeroAbVar` (every field) by its
characteristic-`0` form `PicZeroChar0.PicZeroAbVar0`, proved from three printed leaves. After phisurj, L2 is also read
by `PhiSurj.phiAmpleIsogeny_of_open` and `PhiSurj.weilPairingMumford_of_open`, whose consumers are all at fields of
characteristic `0` (number fields, or the fields of `AVB1.PoincareComplement`). This file proves their
characteristic-`0` forms from `PicZeroAbVar0`:

* `PhiSurj.phiAmpleIsogeny0_of_open : PicRepresentableAbVar → PicZeroAbVar0 → MumfordTorsionAlgClosed →
  PicZeroChar0.PhiAmpleIsogeny0`;
* `PhiSurj.weilPairingMumford0_of_open : PicRepresentableAbVar → PicZeroAbVar0 → MumfordTorsionAlgClosed →
  PhiSurj.WeilPairingMumford0`;
* `PhiSurj.t09SymmIsogenyExists0_of_four0` (TailZ24's `t09SymmIsogenyExists_of_four` with both Mumford inputs in
  characteristic `0`).

Every proof is phisurj's (or pic-dict's, TailZ24's) verbatim (generated by `scratch/fold33-pic/gen0/char0.py`):
`h2 : PicZeroAbVar` becomes `h2 : PicZeroAbVar0`, each statement gains `[CharZero k]`, and each `intro` pattern one
`_`. L2 is applied only at the field of the statement and at `AlgebraicClosure K` (characteristic `0` by Mathlib's
instance). Each characteristic-`0` statement is a consequence of the general one, never stronger.
-/

noncomputable section

open CategoryTheory AlgebraicGeometry Limits Opposite MonoidalCategory TopologicalSpace
open scoped CategoryTheory.MonObj

set_option linter.style.haveILetI false
set_option linter.unusedSectionVars false
set_option linter.unusedVariables false

namespace PicDict

open T09Pic PkgI3 PkgI3.AbVar

/-- (characteristic `0`, fold33-pic; a consequence of the statement without `CharZero`, not a field) ** (theorem of the square).** For an abelian variety `X` over an algebraically closed field `k`,
`L ∈ Pic(X)` and `x, y ∈ X(k)`: `t_{x+y}^*L ⊗ L ≅ t_x^*L ⊗ t_y^*L`. Mumford, *Abelian varieties*, §6,
Cor. 4 (UNVERIFIED numbering). Instance `X = A_K̄`, `X(K̄) = A(K̄)`. -/
def MumfordSquare0 : Prop :=
  ∀ (K : Type) [Field K] [CharZero K] (A : AbVar K) (c : (AK A).Pic) (x y : A.Pt (AlgebraicClosure K)),
    Scheme.Pic.map (trl (x * y)) c * c =
      Scheme.Pic.map (trl x) c * Scheme.Pic.map (trl y) c

/-- (characteristic `0`, fold33-pic; a consequence of the statement without `CharZero`, not a field) ** (`n_X^*L ≅ Lⁿ` on `Pic⁰`).** For `L ∈ Pic⁰(X)` (`t_x^*L ≅ L` for all `x ∈ X(k)`), `n_X^*L ≅ Lⁿ`.
Mumford §8 (iv) (UNVERIFIED numbering). Instance `X = A_K̄`. -/
def MumfordMulNPicZero0 : Prop :=
  ∀ (K : Type) [Field K] [CharZero K] (A : AbVar K) (c : (AK A).Pic), IsTranslInv c →
    ∀ n : ℕ, Scheme.Pic.map (mlN A n) c = c ^ n

/-- (characteristic `0`, fold33-pic; a consequence of the statement without `CharZero`, not a field) ** (theorem of the square).** Mumford, *Abelian varieties*, §6, Cor. 4: for `X` an abelian variety
over an algebraically closed field `k`, `L ∈ Pic(X)` and `x, y ∈ X(k)`, `t_{x+y}^*L ⊗ L ≅ t_x^*L ⊗ t_y^*L`
(UNVERIFIED numbering). -/
def MumfordSquareAC0 : Prop :=
  ∀ (k : Type) [Field k] [IsAlgClosed k] [CharZero k] (X : AbVar k) (c : X.X.left.Pic) (x y : AC.Kpt X),
    Scheme.Pic.map (AC.tr (x * y)).left c * c =
      Scheme.Pic.map (AC.tr x).left c * Scheme.Pic.map (AC.tr y).left c

/-- (characteristic `0`, fold33-pic; a consequence of the statement without `CharZero`, not a field) ** (`n_X^*L ≅ Lⁿ` for `L ∈ Pic⁰`).** Mumford §8 (iv) (UNVERIFIED numbering). -/
def MumfordMulNPicZeroAC0 : Prop :=
  ∀ (k : Type) [Field k] [IsAlgClosed k] [CharZero k] (X : AbVar k) (c : X.X.left.Pic), AC.IsTI c →
    ∀ n : ℕ, Scheme.Pic.map (AC.mul X n).left c = c ^ n

theorem mumfordSquare0_of_ac0 (h : MumfordSquareAC0) : MumfordSquare0 := by
  intro K _ _ A c x y
  have := h (AlgebraicClosure K) (AKbar A) c (pts x) (pts y)
  rw [← pts_mul, tr_pts, tr_pts, tr_pts] at this
  exact this

theorem mumfordMulNPicZero0_of_ac0 (h : MumfordMulNPicZeroAC0) : MumfordMulNPicZero0 := by
  intro K _ _ A c hc n
  have := h (AlgebraicClosure K) (AKbar A) c ((isTI_iff c).2 hc) n
  rwa [mul_AKbar] at this

end PicDict

namespace T09Pic

open PkgI3 PkgI3.AbVar HDec.WeilPairing

/-- (characteristic `0`, fold33-pic; a consequence of `WeilPairingMumford`, `weilPairingMumford0_of`) ** L4, fully genuine form (Mumford's `ē_n`).** As `WeilPairingPicZeroPrinted`, with the
pairing pinned to Mumford's genuine `ē_n` (`weilScalar`): its values, as constants of
`Γ(A_K̄, 𝒪)`, are `weilScalar`. Published: Mumford §20 and §23 (the properties), Kleiman Thm 9.2.5
(points of `Pic⁰` over `K̄` are line bundles on `A_K̄`), Mumford §8 (iv) (`n_A^*M ≅ 𝒪` for
`M ∈ Pic⁰[n]`), `Γ(A_K̄, 𝒪) = K̄`; UNVERIFIED numbering. Every clause is invariant under
`e ↦ -e`, so the leaf holds whichever sign convention for `ē_n` (`t_x^*ψ ψ⁻¹` or its inverse). -/
def WeilPairingMumford0 : Prop :=
  ∀ (K : Type) [Field K] [CharZero K] (A : AbVar K) (P : Over (Spec (CommRingCat.of K)))
    (rep : (picardFunctor A.X.hom).obj.RepresentableBy P) (B : AbVar K) (j : B.X ⟶ P),
    IsPicZero rep B j →
    ∃ e : ∀ n : ℕ, Pairing A B n,
      (∀ n : ℕ, 0 < n → (n : K) ≠ 0 → IsPerfect (e n)) ∧
      (∀ n : ℕ, 0 < n → (n : K) ≠ 0 → HDec.WeilPairing.IsGalEquivariant (e n)) ∧
      (∀ m n : ℕ, 0 < m → 0 < n → ((m * n : ℕ) : K) ≠ 0 →
        ∀ (x : tors A (m * n)) (y : tors B n),
          (e (m * n) x (torsIncl B (dvd_mul_left n m) y)).val = (e n (torsSmul A m n x) y).val) ∧
      (∀ (f : End A) (fv : End B), fv.hom ≫ j = j ≫ dualP rep f.hom → ∀ n : ℕ, 0 < n →
        (n : K) ≠ 0 → ∀ x y, e n x (torsMap fv n y) = e n (torsMap f n x) y) ∧
      (∀ L : A.X.left.Pic, IsAmple A.X.left L → ∀ lam : Hom A B, lam.hom ≫ j = phiL rep L →
        ∀ n : ℕ, 0 < n → (n : K) ≠ 0 → ∀ x : tors A n, e n x (torsMap lam n x) = 0) ∧
      (∀ n : ℕ, 0 < n → (n : K) ≠ 0 → ∀ (x : tors A n) (y : tors B n),
        constK A ((e n x y).val : AlgebraicClosure K) =
          weilScalar rep j n (Additive.toMul (x : HDec.WeilPairing.P A))
            (Additive.toMul (y : HDec.WeilPairing.P B)))

theorem weilPairingMumford0_of (h : WeilPairingMumford) : WeilPairingMumford0 := fun K _ _ => h K

end T09Pic

namespace PhiSurj

open T09Pic PkgI3 PkgI3.AbVar PicDict

variable {k : Type} [Field k]

/-- **`φ_c` is a homomorphism on `k`-points** (from L1, L2). -/
theorem phi_mul0 (h1 : PicRepresentableAbVar) (h2 : PicZeroChar0.PicZeroAbVar0) {k : Type} [Field k] [IsAlgClosed k] [CharZero k]
    (X : AbVar k) (c : X.X.left.Pic) (x y : AC.Kpt X) :
    AC.phi c (x * y) = AC.phi c x * AC.phi c y := by
  obtain ⟨P, ⟨rep⟩⟩ := h1 k X
  obtain ⟨B, j, hj⟩ := h2 k X P rep
  obtain ⟨lam, hlam⟩ := exists_hom_comp_eq_phiL rep hj c
  let _ := picardFunctorCommGrpObj X.X.hom rep
  have hmon : IsMonHom j := hj.2.2
  apply kClass_injective rep
  rw [kClass_mul, ← kpt_comp_phiL, ← kpt_comp_phiL, ← kpt_comp_phiL, ← hlam,
    ← Category.assoc, ← Category.assoc, ← Category.assoc, MonObj.mul_comp, MonObj.mul_comp]

/-- **pic-dict's `MumfordSquareAC0` is a theorem** given L1 and L2. -/
theorem mumfordSquareAC0_of_open (h1 : PicRepresentableAbVar) (h2 : PicZeroChar0.PicZeroAbVar0) : MumfordSquareAC0 := by
  intro k _ _ _ X c x y
  have h := phi_mul0 h1 h2 X c x y
  simp only [AC.phi] at h
  rw [mul_inv_eq_iff_eq_mul] at h
  rw [h]
  simp only [mul_assoc, mul_comm, mul_left_comm, mul_inv_cancel_left]

/-- **`Λ(c) = 1` for translation-invariant `c`** (Mumford §8 (iv), first form). -/
theorem mumfordBundle_eq_one_of_isTI0 (h1 : PicRepresentableAbVar) (h2 : PicZeroChar0.PicZeroAbVar0) [IsAlgClosed k] [CharZero k]
    (X : AbVar k) (c : X.X.left.Pic) (hc : AC.IsTI c) : mumfordBundle X c = 1 := by
  obtain ⟨P, ⟨rep⟩⟩ := h1 k X
  obtain ⟨B, j, hj⟩ := h2 k X P rep
  obtain ⟨lam, hlam⟩ := exists_hom_comp_eq_phiL rep hj c
  let _ := picardFunctorCommGrpObj X.X.hom rep
  have hmon : IsMonHom j := hj.2.2
  have h0 := lam_eq_zero_of_isTI rep hj hc hlam
  have hphi : phiL rep c = CartesianMonoidalCategory.toUnit X.X ≫ η[P] := by
    rw [← hlam, h0, Category.assoc, IsMonHom.one_hom j]
  rw [phiL, ← homEquiv_symm_one rep] at hphi
  have e0 : zT X X.X = (CartesianMonoidalCategory.lift (CartesianMonoidalCategory.toUnit X.X ≫ η[X.X])
      (𝟙 X.X)).left := by
    apply pullback.hom_ext <;> simp
  have hμ0 : zT X X.X ≫ (μ[X.X]).left = 𝟙 _ := by
    rw [e0, ← Over.comp_left, MonObj.lift_comp_one_left]; rfl
  have hS0 : Scheme.Pic.map (X.X.hom ≫ η[X.X].left) c = 1 := by
    rw [Scheme.Pic.map_comp, Subsingleton.elim (α := (Spec (CommRingCat.of k)).Pic)
      (Scheme.Pic.map η[X.X].left c) 1, Scheme.Pic.map_one]
  have hz0 : Scheme.Pic.map (zT X X.X) (mumfordBundle X c) = 1 := by
    rw [mumfordBundle, ← Scheme.Pic.mapHom_apply]
    simp only [map_mul, map_inv, Scheme.Pic.mapHom_apply, ← Scheme.Pic.map_comp, hμ0,
      sectionBaseChange_fst, sectionBaseChange_snd, Scheme.Pic.map_id]
    rw [hS0]
    group
  have h3 : (1 : (pullback X.X.hom X.X.hom).Pic) ∈ (Nrm X).obj (op X.X) := by
    change Scheme.Pic.map _ 1 = 1; exact Scheme.Pic.map_one _
  have h5 := Θ_inj (A := X) pushforwardUnitUniversal (T := X.X)
    (x := ⟨mumfordBundle X c, hz0⟩) (y := ⟨(1 : (pullback X.X.hom X.X.hom).Pic), h3⟩) (by
      rw [Θ_hom_app, Θ_hom_app]
      exact rep.homEquiv.symm.injective hphi)
  exact congrArg Subtype.val h5

/-- `m^*c = p₁^*c ⊗ p₂^*c` for translation-invariant `c`. -/
theorem mu_pic_of_isTI0 (h1 : PicRepresentableAbVar) (h2 : PicZeroChar0.PicZeroAbVar0) [IsAlgClosed k] [CharZero k]
    (X : AbVar k) (c : X.X.left.Pic) (hc : AC.IsTI c) :
    Scheme.Pic.map (μ[X.X]).left c =
      Scheme.Pic.map (pullback.fst X.X.hom X.X.hom) c * Scheme.Pic.map (pullback.snd X.X.hom X.X.hom) c := by
  have h := mumfordBundle_eq_one_of_isTI0 h1 h2 X c hc
  unfold mumfordBundle at h
  rw [mul_inv_eq_one, mul_inv_eq_iff_eq_mul] at h
  exact h.trans (mul_comm _ _)

/-- **pic-dict's `MumfordMulNPicZeroAC0` is a theorem** given L1 and L2. -/
theorem mumfordMulNPicZeroAC0_of_open (h1 : PicRepresentableAbVar) (h2 : PicZeroChar0.PicZeroAbVar0) :
    MumfordMulNPicZeroAC0 := by
  intro k _ _ _ X c hc n
  induction n with
  | zero =>
    have e : (AC.mul X 0).left = X.X.hom ≫ η[X.X].left := by
      simp only [AC.mul, pow_zero]
      rfl
    rw [e, Scheme.Pic.map_comp, Subsingleton.elim (α := (Spec (CommRingCat.of k)).Pic)
      (Scheme.Pic.map η[X.X].left c) 1, Scheme.Pic.map_one, pow_zero]
  | succ n ih =>
    have e : (AC.mul X (n + 1)).left =
        (CartesianMonoidalCategory.lift (AC.mul X n) (𝟙 X.X)).left ≫ (μ[X.X]).left := by
      simp only [AC.mul, pow_succ, CategoryTheory.Hom.mul_def, Over.comp_left]
    have hf : (CartesianMonoidalCategory.lift (AC.mul X n) (𝟙 X.X)).left ≫ pullback.fst X.X.hom X.X.hom =
        (AC.mul X n).left := by simp
    have hs : (CartesianMonoidalCategory.lift (AC.mul X n) (𝟙 X.X)).left ≫ pullback.snd X.X.hom X.X.hom =
        𝟙 _ := by simp
    rw [e, Scheme.Pic.map_comp, mu_pic_of_isTI0 h1 h2 X c hc, Scheme.Pic.map_mul, ← Scheme.Pic.map_comp,
      ← Scheme.Pic.map_comp, hf, hs, Scheme.Pic.map_id, ih, pow_succ]

end PhiSurj

namespace PhiSurj.AVDesc

open PicDict PkgI3 PkgI3.AbVar PicDict.Transport WeilProof WeilProof.Theta

variable {k : Type} [Field k]

/-- **`#X̂[n] ≤ n^{2g}`** over `k = k̄`, `n` invertible: `c ↦ ē_n(·, c)` embeds the translation-invariant classes
of order dividing `n` into `Hom(X[n], μ_n)` (Mumford §20: the formula is a well-defined bilinear `μ_n`-valued
pairing, weil-proof's `mumfordWeilPairingAC_proof`; its right kernel is trivial, `formula_nondeg_right`), and
`X[n] ≅ (ℤ/n)^{2g}`. -/
theorem card_isDT_le0 [IsAlgClosed k] [CharZero k] (h1 : T09Pic.PicRepresentableAbVar) (h2 : PicZeroChar0.PicZeroAbVar0)
    (hT : AvSplit.MumfordTorsionAlgClosed) (X : AbVar k) (g n : ℕ)
    (hg : topologicalKrullDim X.X.left = g) (hn : 0 < n) (hnk : (n : k) ≠ 0) :
    Finite {c : X.X.left.Pic // AC.IsDT n c} ∧ Nat.card {c : X.X.left.Pic // AC.IsDT n c} ≤ n ^ (2 * g) := by
  have : NeZero n := ⟨by omega⟩
  obtain ⟨E⟩ := exists_torsK_addEquiv hT X g n hg hn hnk
  have hW := WeilProof.mumfordWeilPairingAC_proof
  have htriv : ∀ c, AC.IsDT n c → Nonempty (AC.Triv X n c) := fun c hc =>
    nonempty_triv_ac (by rw [PhiSurj.mumfordMulNPicZeroAC0_of_open h1 h2 k X c hc.1 n, hc.2])
  have hval : ∀ (c : X.X.left.Pic) (hc : AC.IsDT n c) (x : torsK X n), ∃ u : rootsOfUnity n k,
      AC.const X ((u : kˣ) : k) = AC.formula x.1 (mem_torsK.1 x.2) c (htriv c hc).some := by
    intro c hc x
    obtain ⟨-, h2', -, -⟩ := hW k X n hn hnk x.1 x.1 (mem_torsK.1 x.2) (mem_torsK.1 x.2) c c hc hc
    obtain ⟨u, hu, hu'⟩ := h2' (htriv c hc).some
    exact ⟨⟨u, (mem_rootsOfUnity n u).2 hu⟩, hu'⟩
  choose χ hχ using hval
  have hmul : ∀ c (hc : AC.IsDT n c) (x y : torsK X n), χ c hc (x * y) = χ c hc x * χ c hc y := by
    intro c hc x y
    obtain ⟨-, -, h3, -⟩ := hW k X n hn hnk x.1 y.1 (mem_torsK.1 x.2) (mem_torsK.1 y.2) c c hc hc
    apply Subtype.ext; apply Units.ext
    apply const_injective X
    have e1 := hχ c hc (x * y)
    have e2 := hχ c hc x
    have e3 := hχ c hc y
    have e4 : AC.formula (x * y).1 (mem_torsK.1 (x * y).2) c (htriv c hc).some =
        AC.formula x.1 (mem_torsK.1 x.2) c (htriv c hc).some *
          AC.formula y.1 (mem_torsK.1 y.2) c (htriv c hc).some := h3 _
    rw [e1, e4, ← e2, ← e3, ← const_mul]
    rfl
  let Φ : {c : X.X.left.Pic // AC.IsDT n c} → (Additive (torsK X n) →+ Additive (rootsOfUnity n k)) :=
    fun c => AddMonoidHom.mk' (fun x => Additive.ofMul (χ c.1 c.2 (Additive.toMul x)))
      (fun x y => by
        change Additive.ofMul (χ c.1 c.2 (Additive.toMul x * Additive.toMul y)) = _
        rw [hmul]; rfl)
  have hΦ : Function.Injective Φ := by
    rintro ⟨c, hc⟩ ⟨c', hc'⟩ h
    have hχeq : ∀ x : torsK X n, χ c hc x = χ c' hc' x := fun x =>
      Additive.ofMul.injective (DFunLike.congr_fun h (Additive.ofMul x))
    let d := c * c'⁻¹
    have hd : AC.IsDT n d := isDT_mul hc (isDT_inv hc')
    have hdc : c = d * c' := by simp [d]
    have hone : ∀ (x : AC.Kpt X) (hx : x ^ n = 1), AC.formula x hx d (htriv d hd).some = 1 := by
      intro x hx
      let xt : torsK X n := ⟨x, mem_torsK.2 hx⟩
      obtain ⟨h1', h2', -, h4'⟩ := hW k X n hn hnk x x hx hx d c' hd hc'
      obtain ⟨-, -, -, -⟩ := hW k X n hn hnk x x hx hx c c hc hc
      obtain ⟨hi, -, -, -⟩ := hW k X n hn hnk x x hx hx (d * c') (d * c') (isDT_mul hd hc')
        (isDT_mul hd hc')
      have e1 : AC.formula x hx c (htriv c hc).some =
          AC.formula x hx (d * c') (htriv (d * c') (isDT_mul hd hc')).some :=
        formula_eq_of_eq hdc _ _ hi
      have e2 := h4' (htriv d hd).some (htriv c' hc').some (htriv (d * c') (isDT_mul hd hc')).some
      have e3 : AC.formula x hx c (htriv c hc).some = AC.formula x hx c' (htriv c' hc').some := by
        rw [← hχ c hc xt, ← hχ c' hc' xt, hχeq]
      have hunit : IsUnit (AC.formula x hx c' (htriv c' hc').some) := by
        rw [← hχ c' hc' xt]
        exact ((χ c' hc' xt : kˣ).isUnit).map
          (X.X.hom.appTop.hom.comp (Scheme.ΓSpecIso (CommRingCat.of k)).inv.hom)
      rw [e1, e2] at e3
      exact (IsUnit.mul_left_inj hunit).1 (e3.trans (one_mul _).symm)
    have hd1 := formula_nondeg_right X n hnk d (htriv d hd).some hone
    apply Subtype.ext
    show c = c'
    rw [hdc, hd1, one_mul]
  have : Finite (Additive (torsK X n)) := Finite.of_equiv _ E.symm.toEquiv
  have : Finite (Additive (torsK X n) →+ Additive (rootsOfUnity n k)) := DFunLike.finite _
  refine ⟨Finite.of_injective Φ hΦ, ?_⟩
  calc Nat.card {c : X.X.left.Pic // AC.IsDT n c}
      ≤ Nat.card (Additive (torsK X n) →+ Additive (rootsOfUnity n k)) :=
        Nat.card_le_card_of_injective Φ hΦ
    _ ≤ Nat.card (Additive (rootsOfUnity n k)) ^ (2 * g) := card_hom_le E
    _ ≤ n ^ (2 * g) := by
        apply Nat.pow_le_pow_left
        rw [Nat.card_congr (Additive.toMul : Additive (rootsOfUnity n k) ≃ _)]
        exact card_rootsOfUnity _ _

end PhiSurj.AVDesc

namespace PhiSurj

open T09Pic PkgI3 PkgI3.AbVar PicDict HDec.WeilPairing

variable {K : Type} [Field K]

/-- **`dim Pic⁰ ≤ dim A`** from L1, L2 and the torsion leaf only: `B[ℓ] ↪ Â[ℓ](A_K̄)` (`y ↦ M_y`, injective,
translation-invariant) and `#Â[ℓ] ≤ ℓ^{2 dim A}` (`AVDesc.card_isDT_le0`), while `#B[ℓ] = ℓ^{2 dim B}`. -/
theorem dim_le_of_open0 [CharZero K] (h1 : PicRepresentableAbVar) (h2 : PicZeroChar0.PicZeroAbVar0)
    (hT : AvSplit.MumfordTorsionAlgClosed) {A : AbVar K}
    {P : Over (Spec (CommRingCat.of K))} (rep : (picardFunctor A.X.hom).obj.RepresentableBy P)
    {B : AbVar K} {j : B.X ⟶ P} (hj : IsPicZero rep B j) (a b : ℕ)
    (ha : topologicalKrullDim A.X.left = a) (hb : topologicalKrullDim B.X.left = b) : b ≤ a := by
  obtain ⟨ℓ, hℓ2, hℓK⟩ := exists_two_le_natCast_ne_zero (K := K)
  have hℓ0 : 0 < ℓ := by omega
  have : NeZero ℓ := ⟨by omega⟩
  have hℓK' : (ℓ : AlgebraicClosure K) ≠ 0 := by
    rw [← map_natCast (algebraMap K (AlgebraicClosure K))]
    exact (map_ne_zero _).mpr hℓK
  have ha' : topologicalKrullDim (AKbar A).X.left = a :=
    (ZInQ.Contrib.AbVarBC.dim_baseChange_scheme (AlgebraicClosure K) A.X.left A.X.hom).trans ha
  obtain ⟨EB⟩ := exists_torsAddEquiv hT B b ℓ hb hℓ0 hℓK
  have hsub := picZeroPtsTranslInv_of_leaves pushforwardUnitUniversal geomIntegralProd
  let emb : tors B ℓ → {c : (AKbar A).X.left.Pic // AC.IsDT ℓ c} := fun y =>
    ⟨picClass rep j (Additive.toMul (y : HDec.WeilPairing.P B)), (isTI_iff _).2 (hsub K A P rep B j hj _), by
      have hy : (Additive.toMul (y : HDec.WeilPairing.P B)) ^ ℓ = 1 := by
        have := congrArg Additive.toMul (show ℓ • (y : HDec.WeilPairing.P B) = 0 from y.2)
        simpa using this
      change picHom rep hj _ ^ ℓ = 1
      rw [← map_pow, hy, map_one]⟩
  have hemb : Function.Injective emb := by
    intro y y' h
    have h' : picClass rep j (Additive.toMul (y : HDec.WeilPairing.P B)) =
        picClass rep j (Additive.toMul (y' : HDec.WeilPairing.P B)) := congrArg Subtype.val h
    exact Subtype.ext (Additive.toMul.injective (picClass_injective rep hj h'))
  obtain ⟨hfin, hcount⟩ := AVDesc.card_isDT_le0 h1 h2 hT (AKbar A) a ℓ ha' hℓ0 hℓK'
  have hle := Nat.card_le_card_of_injective emb hemb
  have hB : Nat.card (tors B ℓ) = ℓ ^ (2 * b) := by
    rw [Nat.card_congr EB.toEquiv, Nat.card_fun, Nat.card_zmod, Nat.card_eq_fintype_card,
      Fintype.card_fin]
  rw [hB] at hle
  have := (Nat.pow_le_pow_iff_right (by omega : 1 < ℓ)).mp (hle.trans hcount)
  omega

/-- **`λ_L` is an isogeny for every ample `L`, from L1, L2 and the torsion leaf** (no Weil-pairing leaf). -/
theorem phiAmpleIsogeny0_of_open (h1 : PicRepresentableAbVar) (h2 : PicZeroChar0.PicZeroAbVar0)
    (hT : AvSplit.MumfordTorsionAlgClosed) : PicZeroChar0.PhiAmpleIsogeny0 := by
  intro K _ _ A P rep B j hj L hL lam hlam
  obtain ⟨lam', hlam'⟩ := exists_hom_comp_eq_phiL rep hj L
  have hjm : Mono j := by
    have : IsOpenImmersion j.left := hj.1
    exact (Over.forget _).mono_of_mono_map (inferInstanceAs (Mono j.left))
  have he : lam = lam'.hom := by rw [← cancel_mono j, hlam, hlam']
  subst he
  have hfin := finiteOfFiniteKerPts K A B lam' (PhiAmple.finite_ker_pts rep hj hL hlam)
  refine ⟨hfin, ⟨?_⟩⟩
  have := hfin
  have : IsProper (lam'.hom.left ≫ B.X.hom) := by rw [Over.w lam'.hom]; infer_instance
  have : IsProper lam'.hom.left := IsProper.of_comp lam'.hom.left B.X.hom
  have : IrreducibleSpace B.X.left :=
    GeometricallyIrreducible.irreducibleSpace_of_subsingleton (f := B.X.hom)
  have : Nonempty A.X.left := ⟨η[A.X].left (IsLocalRing.closedPoint K)⟩
  obtain ⟨a, ha⟩ := PkgI3.AbVar.dim_finite A
  obtain ⟨b, hb⟩ := PkgI3.AbVar.dim_finite B
  have hba := dim_le_of_open0 h1 h2 hT rep hj a b ha hb
  refine surjective_of_dim_le lam'.hom.left lam'.hom.left.isClosedMap a ha ?_
  have hb' : topologicalKrullDim B.X.left = b := hb
  rw [hb']
  exact_mod_cast hba

end PhiSurj

namespace PhiSurj

open PicDict T09Pic PkgI3 PkgI3.AbVar HDec.WeilPairing

/-- `dim A ≤ dim Pic⁰`: `λ_L` (very ample `L`) is finite. -/
theorem dim_ge_of_open0 (h1 : PicRepresentableAbVar) (h2 : PicZeroChar0.PicZeroAbVar0) (hT : AvSplit.MumfordTorsionAlgClosed)
    {K : Type} [Field K] [CharZero K] {A : AbVar K} {P : Over (Spec (CommRingCat.of K))}
    (rep : (picardFunctor A.X.hom).obj.RepresentableBy P) {B : AbVar K} {j : B.X ⟶ P}
    (hj : IsPicZero rep B j) : topologicalKrullDim A.X.left ≤ topologicalKrullDim B.X.left := by
  obtain ⟨L, hL⟩ := exists_isVeryAmple A
  obtain ⟨lam, hlam⟩ := exists_hom_comp_eq_phiL rep hj L
  obtain ⟨hfin, -⟩ := phiAmpleIsogeny0_of_open h1 h2 hT K A P rep B j hj L (veryAmpleIsAmple K A L hL)
    lam.hom hlam
  have : IsProper (lam.hom.left ≫ B.X.hom) := by rw [Over.w lam.hom]; infer_instance
  have : IsProper lam.hom.left := IsProper.of_comp lam.hom.left B.X.hom
  exact dim_le_of_lqf lam.hom.left lam.hom.left.isClosedMap

/-- **The left kernel of a pairing `A[n] × Pic⁰[n] → μ_n` with trivial right kernel is trivial**, by counting:
`#Pic⁰[n] = n^{2 dim B} = n^{2 dim A} ≥ #Hom(A[n], μ_n)`, so `y ↦ e(·, y)` is onto, and characters separate points. -/
theorem left_kernel_of_open0 (h1 : PicRepresentableAbVar) (h2 : PicZeroChar0.PicZeroAbVar0) (hT : AvSplit.MumfordTorsionAlgClosed)
    {K : Type} [Field K] [CharZero K] {A : AbVar K} {P : Over (Spec (CommRingCat.of K))}
    (rep : (picardFunctor A.X.hom).obj.RepresentableBy P) {B : AbVar K} {j : B.X ⟶ P}
    (hj : IsPicZero rep B j) {n : ℕ} (hn : 0 < n) (hnK : (n : K) ≠ 0) (e : Pairing A B n)
    (hR : ∀ y : tors B n, (∀ x, e x y = 0) → y = 0) :
    ∀ x : tors A n, (∀ y, e x y = 0) → x = 0 := by
  intro x hx
  by_contra hx0
  have : NeZero n := ⟨by omega⟩
  obtain ⟨a, ha⟩ := PkgI3.AbVar.dim_finite A
  obtain ⟨b, hb⟩ := PkgI3.AbVar.dim_finite B
  have ha' : topologicalKrullDim A.X.left = a := ha
  have hb' : topologicalKrullDim B.X.left = b := hb
  have hba := dim_le_of_open0 h1 h2 hT rep hj a b ha' hb'
  have hab : a ≤ b := by
    have := dim_ge_of_open0 h1 h2 hT rep hj
    rw [ha', hb'] at this
    exact_mod_cast this
  have hab' : a = b := le_antisymm hab hba
  obtain ⟨EA⟩ := exists_torsAddEquiv hT A a n ha' hn hnK
  obtain ⟨EB⟩ := exists_torsAddEquiv hT B b n hb' hn hnK
  let Φ : tors B n →+ (tors A n →+ Mu K n) := e.flip
  have hΦ : Function.Injective Φ := by
    rw [injective_iff_map_eq_zero]
    intro y hy
    exact hR y (fun x => DFunLike.congr_fun hy x)
  have hfinH : Finite (tors A n →+ Mu K n) := by
    have : Finite (tors A n) := Finite.of_equiv _ EA.symm.toEquiv
    exact DFunLike.finite _
  have hcard : Nat.card (tors A n →+ Mu K n) ≤ Nat.card (tors B n) := by
    calc Nat.card (tors A n →+ Mu K n) ≤ Nat.card (Mu K n) ^ (2 * a) := AVDesc.card_hom_le EA
      _ ≤ n ^ (2 * a) := Nat.pow_le_pow_left (card_mu_le n) _
      _ = Nat.card (tors B n) := by
          rw [Nat.card_congr EB.toEquiv, Nat.card_fun, Nat.card_zmod, Nat.card_eq_fintype_card,
            Fintype.card_fin, hab']
  have hsurj : Function.Surjective Φ := (hΦ.bijective_of_nat_card_le hcard).2
  obtain ⟨ψ, hψ⟩ := exists_zmod_mu_injective (n := n) hnK
  obtain ⟨χ, hχ⟩ := exists_char_ne_zero EA ψ hψ x hx0
  obtain ⟨y, hy⟩ := hsurj χ
  apply hχ
  rw [← hy]
  exact hx y

/-- The right half of Mumford §20 nondegeneracy at `A_K̄`, in pic-dict's coordinates. -/
theorem weilNondegRight0_of_open (h1 : PicRepresentableAbVar) (h2 : PicZeroChar0.PicZeroAbVar0) :
    ∀ (K : Type) [Field K] [CharZero K] (A : AbVar K) (n : ℕ), 0 < n → (n : K) ≠ 0 →
      ∀ c : (AK A).Pic, IsDualTors n c → (∀ (x : tors A n) (ψ : Triv A n c), weilFormula x c ψ = 1) →
        c = 1 := by
  intro K _ _ A n hn hnK c hc hx
  have hc' := (isDT_iff n c).2 hc
  obtain ⟨ψ'⟩ := AVDesc.nonempty_triv_ac (X := AKbar A) (n := n) (c := c)
    (by rw [mumfordMulNPicZeroAC0_of_open h1 h2 _ (AKbar A) c hc'.1 n, hc'.2])
  refine AVDesc.formula_nondeg_right (AKbar A) n (natCast_ne_zero_bar hnK) c ψ' (fun σ hσ => ?_)
  obtain ⟨y, rfl⟩ := pts_surjective σ
  obtain ⟨ψ, rfl⟩ := triv_surj ψ'
  have hy : Additive.ofMul y ∈ tors A n := by
    rw [mem_tors]
    apply Additive.toMul.injective
    apply pts_injective
    rw [toMul_nsmul, toMul_ofMul, pts_pow, hσ, toMul_zero]
    exact (map_one (ptsHom A)).symm
  exact (formula_congr_pt rfl _ _ _ _).trans ((formula_bridge ⟨_, hy⟩ c ψ).trans (hx ⟨_, hy⟩ ψ))

theorem weilPairingMumford0_of_open (h1 : PicRepresentableAbVar) (h2 : PicZeroChar0.PicZeroAbVar0)
    (hT : AvSplit.MumfordTorsionAlgClosed) : WeilPairingMumford0 := by
  have hsq : MumfordSquare0 := mumfordSquare0_of_ac0 (mumfordSquareAC0_of_open h1 h2)
  have h8iv : MumfordMulNPicZero0 := mumfordMulNPicZero0_of_ac0 (mumfordMulNPicZeroAC0_of_open h1 h2)
  have hamp : AmpleBaseChangeAlgClosure := ampleBaseChangeAlgClosure
  have h20a : MumfordWeilPairing := mumfordWeilPairing_of_ac WeilProof.mumfordWeilPairingAC_proof
  have h23 : MumfordWeilAlt := mumfordWeilAlt_of_ac WeilProof.Theta.mumfordWeilAltAC_proof
  have h3 : PicZeroChar0.PhiAmpleIsogeny0 := phiAmpleIsogeny0_of_open h1 h2 hT
  have h20bR := weilNondegRight0_of_open h1 h2
  classical
  have h20d := mumfordWeilDual_of_pairing h20a
  have h20c := mumfordWeilCompat_of_pairing h20a
  intro K _ _ A P rep B j hj
  obtain ⟨L, hL⟩ := exists_isVeryAmple A
  have hLa := veryAmpleIsAmple K A L hL
  obtain ⟨lam, hlam⟩ := exists_hom_comp_eq_phiL rep hj L
  obtain ⟨hfin, hsurj⟩ := h3 K A P rep B j hj L hLa lam.hom hlam
  -- `B(K̄) ⊆ Pic⁰(A_K̄)`
  have hsub : ∀ y, IsTranslInv (picClass rep j y) := fun y => by
    obtain ⟨x, rfl⟩ := exists_lift_pt lam.hom hsurj y
    rw [picClass_phiL rep L lam.hom hlam x]
    exact phiPt_translInv (hsq K A) _ x
  have hone : picClass rep j 1 = 1 := map_one (picHom rep hj)
  have htors : ∀ (n : ℕ) (y : tors B n),
      IsDualTors n (picClass rep j (Additive.toMul (y : HDec.WeilPairing.P B))) := fun n y => by
    refine ⟨hsub _, ?_⟩
    rw [← picHom_apply rep hj, ← map_pow, ← toMul_nsmul, nsmul_tors y]
    exact hone
  have htriv : ∀ (n : ℕ) (y : tors B n),
      Nonempty (Triv A n (picClass rep j (Additive.toMul (y : HDec.WeilPairing.P B)))) :=
    fun n y => nonempty_triv (by rw [h8iv K A _ (hsub _) n, (htors n y).2])
  have hspec : ∀ (n : ℕ) (x : tors A n) (y : tors B n),
      weilScalar rep j n (Additive.toMul (x : HDec.WeilPairing.P A))
          (Additive.toMul (y : HDec.WeilPairing.P B)) =
        weilFormula x (picClass rep j (Additive.toMul (y : HDec.WeilPairing.P B))) (htriv n y).some := by
    intro n x y
    unfold weilScalar
    rw [dite_eq_left (transl_left_comp_mulN_left x)]
    exact dite_eq_left (htriv n y)
  have hval : ∀ (n : ℕ) (hn : 0 < n) (hnK : (n : K) ≠ 0) (x : tors A n) (y : tors B n),
      ∃ u : (AlgebraicClosure K)ˣ, u ^ n = 1 ∧ constK A (u : AlgebraicClosure K) =
        weilScalar rep j n (Additive.toMul (x : HDec.WeilPairing.P A))
          (Additive.toMul (y : HDec.WeilPairing.P B)) := by
    intro n hn hnK x y
    rw [hspec]
    exact (h20a K A n hn hnK x x _ _ (htors n y) (htors n y)).2.1 _
  choose u hu1 hu2 using hval
  -- the values are pinned by `weilScalar`
  have hpin : ∀ (n : ℕ) (hn : 0 < n) (hnK : (n : K) ≠ 0) (x : tors A n) (y : tors B n)
      (v : (AlgebraicClosure K)ˣ), constK A (v : AlgebraicClosure K) =
        weilScalar rep j n (Additive.toMul (x : HDec.WeilPairing.P A))
          (Additive.toMul (y : HDec.WeilPairing.P B)) → u n hn hnK x y = v := by
    intro n hn hnK x y v hv
    exact Units.ext (constK_injective A ((hu2 n hn hnK x y).trans hv.symm))
  have hux : ∀ (n : ℕ) (hn : 0 < n) (hnK : (n : K) ≠ 0) (x x' : tors A n) (y : tors B n),
      u n hn hnK (x + x') y = u n hn hnK x y * u n hn hnK x' y := by
    intro n hn hnK x x' y
    apply hpin
    rw [Units.val_mul, map_mul, hu2, hu2, hspec, hspec, hspec]
    exact ((h20a K A n hn hnK x x' _ _ (htors n y) (htors n y)).2.2.1 _).symm
  have huy : ∀ (n : ℕ) (hn : 0 < n) (hnK : (n : K) ≠ 0) (x : tors A n) (y y' : tors B n),
      u n hn hnK x (y + y') = u n hn hnK x y * u n hn hnK x y' := by
    intro n hn hnK x y y'
    apply hpin
    rw [Units.val_mul, map_mul, hu2, hu2, hspec, hspec, hspec]
    have hc : picClass rep j (Additive.toMul ((y + y' : tors B n) : HDec.WeilPairing.P B)) =
        picClass rep j (Additive.toMul (y : HDec.WeilPairing.P B)) *
          picClass rep j (Additive.toMul (y' : HDec.WeilPairing.P B)) :=
      picClass_mul rep hj _ _
    rw [← weilFormula_congr x hc]
    exact ((h20a K A n hn hnK x x _ _ (htors n y) (htors n y')).2.2.2 _ _ _).symm
  let e : ∀ n : ℕ, Pairing A B n := fun n =>
    if h : 0 < n ∧ (n : K) ≠ 0 then
      mkPairing (u n h.1 h.2) (hu1 n h.1 h.2) (hux n h.1 h.2) (huy n h.1 h.2)
    else 0
  have he : ∀ (n : ℕ) (hn : 0 < n) (hnK : (n : K) ≠ 0) (x : tors A n) (y : tors B n),
      (e n x y).val = u n hn hnK x y := by
    intro n hn hnK x y
    simp only [e, dif_pos (And.intro hn hnK), mkPairing_val]
  have he0 : ∀ (n : ℕ) (hn : 0 < n) (hnK : (n : K) ≠ 0) (x : tors A n) (y : tors B n),
      e n x y = 0 ↔ weilFormula x (picClass rep j (Additive.toMul (y : HDec.WeilPairing.P B)))
        (htriv n y).some = 1 := by
    intro n hn hnK x y
    constructor
    · intro h
      have h1 := he n hn hnK x y
      rw [h, Mu.val_zero] at h1
      rw [← hspec, ← hu2 n hn hnK x y, ← h1]
      simp
    · intro h
      apply Mu.val_injective
      rw [he n hn hnK x y, Mu.val_zero]
      apply hpin
      rw [hspec, h]
      simp
  -- independence of the trivialization
  have hind : ∀ (n : ℕ) (hn : 0 < n) (hnK : (n : K) ≠ 0) (x : tors A n) (c : (AK A).Pic),
      IsDualTors n c → ∀ ψ ψ' : Triv A n c, weilFormula x c ψ = weilFormula x c ψ' :=
    fun n hn hnK x c hc ψ ψ' => (h20a K A n hn hnK x x c c hc hc).1 ψ ψ'
  refine ⟨e, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · -- perfect
    intro n hn hnK
    have hR : ∀ y : tors B n, (∀ x, e n x y = 0) → y = 0 := fun y hy => by
      have hc := h20bR K A n hn hnK _ (htors n y) (fun x ψ => by
        rw [hind n hn hnK x _ (htors n y) ψ (htriv n y).some]
        exact (he0 n hn hnK x y).1 (hy x))
      exact Subtype.ext (Additive.toMul.injective (picClass_injective rep hj (hc.trans hone.symm)))
    refine ⟨fun x hx => ?_, hR⟩
    exact left_kernel_of_open0 h1 h2 hT rep hj hn hnK (e n) hR x hx
  · -- Galois
    intro n hn hnK σ x y
    apply Mu.val_injective
    apply Units.ext
    rw [he n hn hnK, galMu_val, he n hn hnK]
    apply constK_injective A
    rw [hu2, hspec]
    have hg : picClass rep j (Additive.toMul ((galTors B n σ y : tors B n) : HDec.WeilPairing.P B)) =
        Scheme.Pic.map (JacobianChallenge.baseChangeMap A.X.hom (galHom σ))
          (picClass rep j (Additive.toMul (y : HDec.WeilPairing.P B))) :=
      picClass_gal rep j σ _
    obtain ⟨ψ', hψ'⟩ := weilFormulaGaloisEx K A n σ x _ _ hg (htriv n y).some _
      ((hspec n x y).symm.trans (hu2 n hn hnK x y).symm)
    rw [hind n hn hnK _ _ (htors n (galTors B n σ y)) _ ψ']
    exact hψ'
  · -- compatibility
    intro m n hm hn hmnK x y
    have hnK : (n : K) ≠ 0 := by
      intro h; apply hmnK; rw [Nat.cast_mul, h, mul_zero]
    have hmn : 0 < m * n := Nat.mul_pos hm hn
    rw [he (m * n) hmn hmnK, he n hn hnK]
    apply hpin
    rw [hu2, hspec, hspec]
    exact (h20c K A m n hm hn hmnK x _ (htors n y) _ _).symm
  · -- adjoint
    intro f fv hfv n hn hnK x y
    apply Mu.val_injective
    rw [he n hn hnK, he n hn hnK]
    apply hpin
    rw [hu2, hspec, hspec]
    have hd : picClass rep j (Additive.toMul ((torsMap fv n y : tors B n) : HDec.WeilPairing.P B)) =
        Scheme.Pic.map (famMap f.hom (ptK K))
          (picClass rep j (Additive.toMul (y : HDec.WeilPairing.P B))) :=
      picClass_dual rep j f.hom fv.hom hfv _
    rw [← weilFormula_congr x hd]
    exact (h20d K A n hn hnK f x _ (htors n y) _ _).symm
  · -- `e_n(x, λ_L x) = 1`
    intro L' hL' lam' hlam' n hn hnK x
    rw [he0 n hn hnK]
    have hp : picClass rep j (Additive.toMul ((torsMap lam' n x : tors B n) : HDec.WeilPairing.P B)) =
        phiPt (bcPic A L') (Additive.toMul (x : HDec.WeilPairing.P A)) :=
      picClass_phiL rep L' lam'.hom hlam' _
    rw [← weilFormula_congr x hp]
    exact h23 K A n hn hnK _ x _
  · -- the pin
    intro n hn hnK x y
    rw [he n hn hnK]
    exact hu2 n hn hnK x y

/-- **`T09Pic.t09SymmIsogenyExists_of_four`, characteristic `0`, with both Mumford inputs in characteristic `0`**
(the proof of `PicZeroChar0.t09SymmIsogenyExists0_of_leaves` and `T09Pic.weilPairingPicZero_of_printed`,
inlined). -/
theorem t09SymmIsogenyExists0_of_four0 (h1 : PicRepresentableAbVar) (h2 : PicZeroChar0.PicZeroAbVar0)
    (h3 : PicZeroChar0.PhiAmpleIsogeny0) (h4 : WeilPairingMumford0) : PicZeroChar0.T09_SymmIsogenyExists0 := by
  intro K _ _ A
  obtain ⟨P, ⟨rep⟩⟩ := h1 K A
  obtain ⟨B, j, hj⟩ := h2 K A P rep
  obtain ⟨L, hL⟩ := exists_isVeryAmple A
  obtain ⟨lam, hlam⟩ := exists_hom_comp_eq_phiL rep hj L
  obtain ⟨e, hperf, hgal, hcompat, hdual, halt, -⟩ := h4 K A P rep B j hj
  exact ⟨{ D := { dual := B, e := e, perfect := hperf, galois := hgal, compat := hcompat,
                  dualEnd := fun f => by
                    obtain ⟨fv, hfv⟩ := exists_dual_on_picZero rep hj f.hom
                    exact ⟨fv, hdual f fv hfv⟩ }
           lam := lam
           isogeny := h3 K A P rep B j hj L (veryAmpleIsAmple K A L hL) lam.hom hlam
           symm := fun n hn hnK x => by
             rw [HDec.WeilPairing.weil_apply]
             exact halt L (veryAmpleIsAmple K A L hL) lam hlam n hn hnK x }⟩

end PhiSurj

