/-! The action of the units of `O / 3O` on the represented level-three model. -/

noncomputable section

open CategoryTheory AlgebraicGeometry Limits MonoidalCategory CartesianMonoidalCategory MonObj
open LeafQM LeafQM.AV LeafQM.AV.R1UnivRigid
open Y3Fix Y3RouteA SGRSplit HDec.VertWitness HDec.ModelGlue
open scoped CategoryTheory.Obj CategoryTheory.MonObj

namespace Y3P1j

set_option maxHeartbeats 2000000

/-- The two-sided ideal of the chosen quaternion order generated by `3`. -/
def threeIdeal : Ideal O := Ideal.span {(3 : O)}

theorem mem_threeIdeal (a : O) : a ∈ threeIdeal ↔ ∃ b : O, a = 3 * b := by
  unfold threeIdeal
  rw [Ideal.mem_span_singleton']
  constructor
  · rintro ⟨b, rfl⟩
    exact ⟨b, by noncomm_ring⟩
  · rintro ⟨b, rfl⟩
    exact ⟨b, by noncomm_ring⟩

instance : threeIdeal.IsTwoSided where
  mul_mem_of_left b ha := by
    obtain ⟨c, rfl⟩ := (mem_threeIdeal _).mp ha
    exact (mem_threeIdeal _).mpr ⟨c * b, _root_.mul_assoc _ _ _⟩

/-- The residue ring of the chosen maximal order modulo `3`. -/
abbrev OrderModThree := O ⧸ threeIdeal

def modThree : O →+* OrderModThree := Ideal.Quotient.mk threeIdeal

theorem modThree_eq_iff (a b : O) : modThree a = modThree b ↔ ∃ c : O, a - b = 3 * c :=
  (Ideal.Quotient.mk_eq_mk_iff_sub_mem a b).trans (mem_threeIdeal _)

theorem modThree_zero_iff (a : O) : modThree a = 0 ↔ ∃ c : O, a = 3 * c :=
  Ideal.Quotient.eq_zero_iff_mem.trans (mem_threeIdeal a)

theorem modThree_liftO_surjective : Function.Surjective
    (fun c : Fin 4 → ZMod 3 => modThree (liftO c)) := by
  intro x
  obtain ⟨a, rfl⟩ := (Ideal.Quotient.mk_surjective (I := threeIdeal)) x
  obtain ⟨c, hc⟩ := LeafQM.AV.Pin.exists_liftO_congr a
  exact ⟨c, ((modThree_eq_iff a (liftO c)).mpr hc).symm⟩

instance : Finite OrderModThree := Finite.of_surjective _ modThree_liftO_surjective

instance : Finite OrderModThreeˣ := Finite.of_injective _ Units.val_injective

theorem card_orderModThree_units_le : Nat.card OrderModThreeˣ ≤ 81 := by
  calc
    Nat.card OrderModThreeˣ ≤ Nat.card OrderModThree :=
      Nat.card_le_card_of_injective _ Units.val_injective
    _ ≤ Nat.card (Fin 4 → ZMod 3) :=
      Nat.card_le_card_of_surjective _ modThree_liftO_surjective
    _ = 81 := by simp [Nat.card_eq_fintype_card]

private def unitLift (u : OrderModThreeˣ) : O := Quotient.out (u : OrderModThree)

private theorem modThree_unitLift (u : OrderModThreeˣ) : modThree (unitLift u) = u :=
  Ideal.Quotient.mk_out _

private theorem modThree_mul_unitLift (a : O) (u : OrderModThreeˣ) :
    modThree (a * unitLift u) = modThree a * u := by
  rw [map_mul, modThree_unitLift]

private theorem modThree_map_eq (α : O ≃+* O) {a b : O} (h : modThree a = modThree b) :
    modThree (α a) = modThree (α b) := by
  rw [modThree_eq_iff] at h ⊢
  obtain ⟨c, hc⟩ := h
  exact ⟨α c, by rw [← map_sub, hc, map_mul, map_ofNat]⟩

private theorem modThree_map_unitLift_inv (α : O ≃+* O) (u : OrderModThreeˣ) :
    modThree (α (unitLift u)) * modThree (α (unitLift u⁻¹)) = 1 := by
  have h : modThree (unitLift u * unitLift u⁻¹) = modThree 1 := by
    rw [modThree_mul_unitLift, modThree_unitLift, Units.mul_inv, map_one]
  simpa only [map_mul, map_one] using modThree_map_eq α h

private def mapResidueUnit (α : O ≃+* O) (u : OrderModThreeˣ) : OrderModThreeˣ :=
  ⟨modThree (α (unitLift u)), modThree (α (unitLift u⁻¹)),
    modThree_map_unitLift_inv α u, by simpa using modThree_map_unitLift_inv α u⁻¹⟩

section Families

variable {S T : Scheme.{0}}

private theorem eta_eq_of_modThree_eq (𝒜 : QMAbSchemeP S) {a b : O}
    (h : modThree a = modThree b) : 𝒜.eta a = 𝒜.eta b := by
  let := 𝒜.grp
  obtain ⟨c, hc⟩ := (modThree_eq_iff a b).mp h
  have ha : a = b + 3 * c := by rw [← hc]; abel
  have hz : secF 𝒜.toQMFamily 0 = 1 := Over.OverMorphism.ext 𝒜.one_eq.symm
  have h3 : secF 𝒜.toQMFamily (3 * c) = secF 𝒜.toQMFamily 0 := Over.OverMorphism.ext (𝒜.eta_three c)
  have he : secF 𝒜.toQMFamily a = secF 𝒜.toQMFamily b := by
    rw [ha]
    rw [show secF 𝒜.toQMFamily (b + 3 * c) =
      secF 𝒜.toQMFamily b * secF 𝒜.toQMFamily (3 * c) from 𝒜.eta_add _ _, h3, hz, _root_.mul_one]
  exact congrArg CommaMorphism.left he

private def famRemark (α : O ≃+* O) (u : O) (𝒜 : QMFamily S) : QMFamily S :=
  { 𝒜 with
    iota := fun a => 𝒜.iota (α a), iota_over := fun a => 𝒜.iota_over (α a)
    eta := fun a => 𝒜.eta (α (a * u)), eta_sec := fun a => 𝒜.eta_sec (α (a * u)) }

private def remarkNL (α : O ≃+* O) (u : O) (𝒜 : QMAbSchemeP S) : QMAbSchemeNL S :=
  letI := 𝒜.grp
  { toQMFamily := famRemark α u 𝒜.toQMFamily
    grp := 𝒜.grp
    geomConn := 𝒜.geomConn
    one_eq := by
      change η[𝒜.F].left = 𝒜.eta (α (0 * u))
      rw [zero_mul, map_zero, 𝒜.one_eq]
    iota_hom := fun a => 𝒜.iota_hom (α a)
    iota_one := by
      change 𝒜.iota (α 1) = 𝟙 𝒜.F.left
      rw [map_one, 𝒜.iota_one]
    iota_mul := fun a b => by
      change 𝒜.iota (α (a * b)) = 𝒜.iota (α b) ≫ 𝒜.iota (α a)
      rw [map_mul, 𝒜.iota_mul]
    iota_add := fun a b => by
      change Over.homMk (𝒜.iota (α (a + b))) (𝒜.iota_over _) =
        Over.homMk (𝒜.iota (α a)) (𝒜.iota_over _) * Over.homMk (𝒜.iota (α b)) (𝒜.iota_over _)
      rw [map_add]
      exact 𝒜.iota_add _ _
    eta_add := fun a b => by
      change secF 𝒜.toQMFamily (α ((a + b) * u)) =
        secF 𝒜.toQMFamily (α (a * u)) * secF 𝒜.toQMFamily (α (b * u))
      rw [add_mul, map_add]
      exact 𝒜.eta_add _ _
    eta_linear := fun a b => by
      change 𝒜.eta (α ((a * b) * u)) = 𝒜.eta (α (b * u)) ≫ 𝒜.iota (α a)
      rw [_root_.mul_assoc, map_mul, 𝒜.eta_linear]
    eta_three := fun a => by
      change 𝒜.eta (α ((3 * a) * u)) = 𝒜.eta (α (0 * u))
      rw [_root_.mul_assoc, zero_mul, map_zero, map_mul, map_ofNat, 𝒜.eta_three] }

private theorem level_remarkNL (u : OrderModThreeˣ) (𝒜 : QMAbSchemeP S) :
    LevelPrint (remarkNL (RingEquiv.refl O) (unitLift u) 𝒜) := by
  intro k _ _ s
  obtain ⟨hker, hsurj⟩ := 𝒜.level k s
  refine ⟨fun a => ?_, fun x hx => ?_⟩
  · change s ≫ 𝒜.eta (a * unitLift u) = s ≫ 𝒜.eta (0 * unitLift u) ↔ _
    rw [zero_mul, hker, ← modThree_zero_iff, ← modThree_zero_iff, modThree_mul_unitLift]
    constructor
    · intro he
      calc
        modThree a = (modThree a * (u : OrderModThree)) * ↑u⁻¹ := by simp [_root_.mul_assoc]
        _ = 0 := by rw [he, zero_mul]
    · intro ha
      rw [ha, zero_mul]
  · obtain ⟨a, ha⟩ := hsurj x hx
    refine ⟨a * unitLift u⁻¹, ?_⟩
    change x = cpt s ≫ (Over.pullback s).map (secF 𝒜.toQMFamily ((a * unitLift u⁻¹) * unitLift u))
    have he : 𝒜.eta ((a * unitLift u⁻¹) * unitLift u) = 𝒜.eta a := eta_eq_of_modThree_eq 𝒜 (by
      rw [modThree_mul_unitLift, modThree_mul_unitLift, _root_.mul_assoc, Units.inv_mul, _root_.mul_one])
    have hs : secF 𝒜.toQMFamily ((a * unitLift u⁻¹) * unitLift u) = secF 𝒜.toQMFamily a :=
      Over.OverMorphism.ext he
    rwa [hs]

/-- Change the full level-three marking by right multiplication by a residue unit, keeping
the underlying abelian scheme and quaternion action. -/
def remarkP (u : OrderModThreeˣ) (𝒜 : QMAbSchemeP S) : QMAbSchemeP S :=
  { toQMAbSchemeNL := remarkNL (RingEquiv.refl O) (unitLift u) 𝒜, level := level_remarkNL u 𝒜 }

private theorem qmFamFibre_remark (u : OrderModThreeˣ)
    {𝒜 : QMAbSchemeP T} {𝒜' : QMAbSchemeP S} {g : S ⟶ T}
    (h : QMFamFibre 𝒜.toQMFamily g 𝒜'.toQMFamily) :
    QMFamFibre (remarkP u 𝒜).toQMFamily g (remarkP u 𝒜').toQMFamily := by
  obtain ⟨f, hp, hi, he⟩ := h
  exact ⟨f, hp, hi, fun a => he (a * unitLift u)⟩

end Families

section FieldPoints

variable {K : Type} [Field K]

/-- The action of a residue unit on a field-valued full level-three marking. -/
def remarkLevel {A : PkgI3.AbVar K} {q : QMStr A} (u : OrderModThreeˣ) (e : Level3 q) : Level3 q where
  eta := e.eta.comp (AddMonoidHom.mulRight (unitLift u))
  linear a b := by
    change e.eta ((a * b) * unitLift u) = qmAct q K a (e.eta (b * unitLift u))
    rw [_root_.mul_assoc, e.linear]
  ker a := by
    change e.eta (a * unitLift u) = 0 ↔ _
    rw [e.ker, ← modThree_zero_iff, ← modThree_zero_iff, modThree_mul_unitLift]
    constructor
    · intro he
      calc
        modThree a = (modThree a * (u : OrderModThree)) * ↑u⁻¹ := by simp [_root_.mul_assoc]
        _ = 0 := by rw [he, zero_mul]
    · intro ha
      rw [ha, zero_mul]

def remarkPoint (P : QML3 K) (u : OrderModThreeˣ) : QML3 K :=
  ⟨P.A, P.surface, P.q, remarkLevel u P.e⟩

/-- The change of marking on a scheme family gives the same change on a field fibre. -/
theorem isFibreOf_remark {S : Scheme.{0}} (𝒜 : QMAbSchemeP S)
    {y : Spec (CommRingCat.of K) ⟶ S} {P : QML3 K}
    (u : OrderModThreeˣ) (h : IsFibreOf 𝒜.toQMFamily y P) :
    IsFibreOf (remarkP u 𝒜).toQMFamily y (remarkPoint P u) := by
  obtain ⟨f, hp, hi, he⟩ := h
  exact ⟨f, hp, hi, fun a => he (a * unitLift u)⟩

/-- The finite residue group accounts for all ways of marking an isomorphic QM pair. -/
theorem exists_remarkPoint_iso [CharZero K] (P Q : QML3 K) (qiso : QMIso P.q Q.q) :
    ∃ u : OrderModThreeˣ, Nonempty ((remarkPoint P u).Iso Q) := by
  let e' : Level3 P.q := LeafQM.AV.Pin.transportLevel qiso.symm Q.e
  have hT := AvSplit.torsionStructure_of_mumford
    ZInQ.Contrib.CloudB3W16Torsion.mumfordTorsionAlgClosed_proof
  obtain ⟨r, s, hsr, hη⟩ := Level3.torsor hT P e'
  have hs := (modThree_eq_iff (s * r) 1).mpr hsr
  rw [map_mul, map_one] at hs
  obtain ⟨u, hu⟩ := IsUnit.of_mul_eq_one_right _ hs
  have he : remarkLevel u P.e = e' := by
    apply Level3.ext'
    apply AddMonoidHom.ext
    intro a
    change P.e.eta (a * unitLift u) = e'.eta a
    rw [hη]
    apply (P.e.eq_iff _ _).mpr
    apply (modThree_eq_iff _ _).mp
    rw [modThree_mul_unitLift, map_mul, hu]
  refine ⟨u, ?_⟩
  have iso := (LeafQM.AV.Pin.QML3.isoTransport Q P.surface qiso.symm).symm
  change Nonempty (QML3.Iso ⟨P.A, P.surface, P.q, remarkLevel u P.e⟩ Q)
  rw [he]
  exact ⟨iso⟩

end FieldPoints

section Represented

variable {B : Scheme.{0}} {Y : Over B} {𝒜 : QMAbSchemeP Y.left}

/-- The printed level-three functor represented by a universal family over a base. -/
abbrev Represents (Y : Over B) (𝒜 : QMAbSchemeP Y.left) : Prop :=
  ∀ (S : Over B), IsLocallyNoetherian S.left →
    ∀ 𝒜' : QMAbSchemeP S.left, ∃! g : S ⟶ Y, QMFamFibre 𝒜.toQMFamily g.left 𝒜'.toQMFamily

variable (hU : Represents Y 𝒜) (hN : IsLocallyNoetherian Y.left)

private def remarkHom (u : OrderModThreeˣ) : Y ⟶ Y := (hU Y hN (remarkP u 𝒜)).exists.choose

private theorem remarkHom_spec (u : OrderModThreeˣ) :
    QMFamFibre 𝒜.toQMFamily (remarkHom hU hN u).left (remarkP u 𝒜).toQMFamily :=
  (hU Y hN (remarkP u 𝒜)).exists.choose_spec

private theorem remarkHom_one : remarkHom hU hN 1 = 𝟙 Y := by
  apply (hU Y hN (remarkP 1 𝒜)).unique (remarkHom_spec hU hN 1)
  refine qmFamFibre_congr (𝒜' := 𝒜.toQMFamily) (𝒜'' := (remarkP 1 𝒜).toQMFamily)
    rfl (fun _ => HEq.rfl) (fun a => ?_) (qmFamFibre_id 𝒜.toQMFamily)
  apply heq_of_eq
  change 𝒜.eta a = 𝒜.eta (a * unitLift 1)
  apply eta_eq_of_modThree_eq 𝒜
  rw [modThree_mul_unitLift, Units.val_one, _root_.mul_one]

private theorem remarkHom_comp (u v : OrderModThreeˣ) :
    remarkHom hU hN u ≫ remarkHom hU hN v = remarkHom hU hN (v * u) := by
  apply (hU Y hN (remarkP (v * u) 𝒜)).unique _ (remarkHom_spec hU hN (v * u))
  have h := qmFamFibre_trans (remarkHom_spec hU hN v) (qmFamFibre_remark v (remarkHom_spec hU hN u))
  refine qmFamFibre_congr (𝒜' := (remarkP v (remarkP u 𝒜)).toQMFamily)
    (𝒜'' := (remarkP (v * u) 𝒜).toQMFamily) rfl (fun _ => HEq.rfl) (fun a => ?_) h
  apply heq_of_eq
  change 𝒜.eta ((a * unitLift v) * unitLift u) = 𝒜.eta (a * unitLift (v * u))
  apply eta_eq_of_modThree_eq 𝒜
  rw [modThree_mul_unitLift, modThree_mul_unitLift, modThree_mul_unitLift, Units.val_mul, _root_.mul_assoc]

private def remarkIso (u : OrderModThreeˣ) : Y ≅ Y where
  hom := remarkHom hU hN u
  inv := remarkHom hU hN u⁻¹
  hom_inv_id := by rw [remarkHom_comp, inv_mul_cancel, remarkHom_one]
  inv_hom_id := by rw [remarkHom_comp, mul_inv_cancel, remarkHom_one]

/-- On a represented level-three model the change of marking is a finite group
action by automorphisms of schemes over the base. -/
def residueUnitAction : OrderModThreeˣ →* Aut Y where
  toFun u := Aut.of (remarkIso hU hN u)
  map_one' := Aut.ext (Iso.ext (remarkHom_one hU hN))
  map_mul' u v := Aut.ext (Iso.ext (remarkHom_comp hU hN v u).symm)

theorem residueUnitAction_spec (u : OrderModThreeˣ) :
    QMFamFibre 𝒜.toQMFamily ((residueUnitAction hU hN u).asIso.hom).left (remarkP u 𝒜).toQMFamily :=
  remarkHom_spec hU hN u

/-- The action on the represented scheme induces residue re-marking on every field fibre. -/
theorem isFibreOf_residueUnitAction {K : Type} [Field K]
    {y : Spec (CommRingCat.of K) ⟶ Y.left} {P : QML3 K} (u : OrderModThreeˣ)
    (hP : IsFibreOf 𝒜.toQMFamily y P) :
    IsFibreOf 𝒜.toQMFamily (y ≫ (residueUnitAction hU hN u).asIso.hom.left) (remarkPoint P u) :=
  Y3Audit.isFibreOf_comp (residueUnitAction_spec hU hN u) (isFibreOf_remark 𝒜 u hP)

private def twistHom (α : O ≃+* O) : Y ⟶ Y := (hU Y hN (twistP α 𝒜)).exists.choose

private theorem twistHom_spec (α : O ≃+* O) :
    QMFamFibre 𝒜.toQMFamily (twistHom hU hN α).left (twistP α 𝒜).toQMFamily :=
  (hU Y hN (twistP α 𝒜)).exists.choose_spec

private theorem twistHom_refl : twistHom hU hN (RingEquiv.refl O) = 𝟙 Y := by
  apply (hU Y hN (twistP (RingEquiv.refl O) 𝒜)).unique (twistHom_spec hU hN _)
  refine qmFamFibre_congr (𝒜' := 𝒜.toQMFamily) (𝒜'' := (twistP (.refl O) 𝒜).toQMFamily)
    rfl (fun _ => HEq.rfl) (fun a => ?_) (qmFamFibre_id 𝒜.toQMFamily)
  apply heq_of_eq
  change 𝒜.eta a = 𝒜.eta (a * ((1 : Oˣ) : O))
  simp

private theorem twistHom_comp (α β : O ≃+* O) :
    twistHom hU hN α ≫ twistHom hU hN β = twistHom hU hN (β.trans α) := by
  apply (hU Y hN (twistP (β.trans α) 𝒜)).unique _ (twistHom_spec hU hN _)
  have h := qmFamFibre_trans (twistHom_spec hU hN β)
    (qmFamFibreP_op β 1 (twistHom_spec hU hN α))
  refine qmFamFibre_congr (𝒜' := (twistP β (twistP α 𝒜)).toQMFamily)
    (𝒜'' := (twistP (β.trans α) 𝒜).toQMFamily) rfl (fun _ => HEq.rfl) (fun a => ?_) h
  apply heq_of_eq
  change 𝒜.eta (α (β (a * ((1 : Oˣ) : O)) * ((1 : Oˣ) : O))) =
    𝒜.eta (α (β (a * ((1 : Oˣ) : O))))
  simp

private def representedTwist (α : O ≃+* O) : Y ≅ Y where
  hom := twistHom hU hN α
  inv := twistHom hU hN α.symm
  hom_inv_id := by rw [twistHom_comp, RingEquiv.symm_trans_self, twistHom_refl]
  inv_hom_id := by rw [twistHom_comp, RingEquiv.self_trans_symm, twistHom_refl]

private theorem isFibreOf_twistP {K : Type} [Field K] {y : Spec (CommRingCat.of K) ⟶ Y.left}
    {P : QML3 K} (α : O ≃+* O) (hP : IsFibreOf 𝒜.toQMFamily y P) :
    IsFibreOf (twistP α 𝒜).toQMFamily y (P.twist α) := by
  obtain ⟨f, hp, hi, he⟩ := hP
  refine ⟨f, hp, fun a => hi (α a), fun a => ?_⟩
  change (Additive.toMul (P.e.eta (α a))).left ≫ f = y ≫ 𝒜.eta (α (a * ((1 : Oˣ) : O)))
  simpa only [Units.val_one, _root_.mul_one] using he (α a)

private abbrev twistRep : Fin 4 → (O ≃+* O) := HDec.LeafQM.AV.Pin.Exact.rep

/-- The four Atkin–Lehner twists followed by arbitrary residue re-marking, as
actual automorphisms of the representing scheme. -/
def twistMarkAut (i : Fin 4) (u : OrderModThreeˣ) : Aut Y :=
  Aut.of ((representedTwist hU hN (twistRep i)).trans (residueUnitAction hU hN u).asIso)

theorem isFibreOf_twistMarkAut {K : Type} [Field K]
    {y : Spec (CommRingCat.of K) ⟶ Y.left} {P : QML3 K} (i : Fin 4) (u : OrderModThreeˣ)
    (hP : IsFibreOf 𝒜.toQMFamily y P) :
    IsFibreOf 𝒜.toQMFamily (y ≫ (twistMarkAut hU hN i u).asIso.hom.left)
      (remarkPoint (P.twist (twistRep i)) u) := by
  have h := Y3Audit.isFibreOf_comp (twistHom_spec hU hN (twistRep i))
    (isFibreOf_twistP (twistRep i) hP)
  change IsFibreOf 𝒜.toQMFamily
    (y ≫ (twistHom hU hN (twistRep i)).left ≫ (residueUnitAction hU hN u).asIso.hom.left) _
  rw [← Category.assoc]
  exact isFibreOf_residueUnitAction hU hN u h

private theorem remarkHom_comp_twistHom (u : OrderModThreeˣ) (α : O ≃+* O) :
    remarkHom hU hN u ≫ twistHom hU hN α =
      twistHom hU hN α ≫ remarkHom hU hN (mapResidueUnit α.symm u) := by
  let v := mapResidueUnit α.symm u
  have hleft := qmFamFibre_trans (twistHom_spec hU hN α)
    (qmFamFibreP_op α 1 (remarkHom_spec hU hN u))
  have hright := qmFamFibre_trans (remarkHom_spec hU hN v)
    (qmFamFibre_remark v (twistHom_spec hU hN α))
  apply (hU Y hN (remarkP v (twistP α 𝒜))).unique _ hright
  refine qmFamFibre_congr (𝒜' := (twistP α (remarkP u 𝒜)).toQMFamily)
    (𝒜'' := (remarkP v (twistP α 𝒜)).toQMFamily) rfl (fun _ => HEq.rfl) (fun a => ?_) hleft
  apply heq_of_eq
  change 𝒜.eta (α (a * ((1 : Oˣ) : O)) * unitLift u) =
    𝒜.eta (α ((a * unitLift v) * ((1 : Oˣ) : O)))
  simp only [Units.val_one, _root_.mul_one]
  have hv : modThree (α (unitLift v)) = modThree (unitLift u) := by
    have hv' : modThree (unitLift v) = modThree (α.symm (unitLift u)) := modThree_unitLift v
    simpa only [RingEquiv.apply_symm_apply] using modThree_map_eq α hv'
  apply eta_eq_of_modThree_eq 𝒜
  rw [map_mul, map_mul (f := α), map_mul, hv]

private theorem exists_twistHom_eq_twistMarkAut (α : O ≃+* O) :
    ∃ i : Fin 4, ∃ u : OrderModThreeˣ,
      twistHom hU hN α = (twistMarkAut hU hN i u).asIso.hom := by
  obtain ⟨i, v, hα⟩ := HDec.LeafQM.AV.Pin.Exact.rep_cover α
  let β := twistRep i
  let u : OrderModThreeˣ := Units.map (modThree.toMonoidHom.comp β.symm.toMonoidHom) v⁻¹
  have hmp : modThree (unitLift u) = modThree (β.symm (↑v⁻¹ : O)) := modThree_unitLift u
  have hmu : modThree (β (unitLift u)) = modThree (↑v⁻¹ : O) := by
    simpa only [RingEquiv.apply_symm_apply] using modThree_map_eq β hmp
  have hv₁ : 𝒜.iota (v : O) ≫ 𝒜.iota (↑v⁻¹ : O) = 𝟙 𝒜.F.left := by
    rw [← 𝒜.iota_mul, Units.inv_mul, 𝒜.iota_one]
  have hv₂ : 𝒜.iota (↑v⁻¹ : O) ≫ 𝒜.iota (v : O) = 𝟙 𝒜.F.left := by
    rw [← 𝒜.iota_mul, Units.mul_inv, 𝒜.iota_one]
  have : IsIso (𝒜.iota (v : O)) := ⟨⟨𝒜.iota (↑v⁻¹ : O), hv₁, hv₂⟩⟩
  have hp : IsPullback (𝒜.iota (v : O)) 𝒜.F.hom 𝒜.F.hom (𝟙 Y.left) :=
    IsPullback.of_horiz_isIso ⟨by rw [𝒜.iota_over, Category.comp_id]⟩
  have hiso : QMFamFibre (twistP α 𝒜).toQMFamily (𝟙 Y.left)
      (remarkP u (twistP β 𝒜)).toQMFamily := by
    refine ⟨𝒜.iota (v : O), hp, fun a => ?_, fun a => ?_⟩
    · change 𝒜.iota (β a) ≫ 𝒜.iota (v : O) = 𝒜.iota (v : O) ≫ 𝒜.iota (α a)
      rw [← 𝒜.iota_mul, ← 𝒜.iota_mul]
      congr 1
      rw [hα, _root_.mul_assoc (↑v * β a), Units.inv_mul, _root_.mul_one]
    · change 𝒜.eta (β ((a * unitLift u) * ((1 : Oˣ) : O))) ≫ 𝒜.iota (v : O) =
        𝟙 Y.left ≫ 𝒜.eta (α (a * ((1 : Oˣ) : O)))
      simp only [Units.val_one, _root_.mul_one, Category.id_comp]
      rw [← 𝒜.eta_linear, hα]
      apply eta_eq_of_modThree_eq 𝒜
      rw [map_mul (f := β), map_mul, map_mul, map_mul, map_mul, hmu, _root_.mul_assoc]
  have hl : QMFamFibre 𝒜.toQMFamily (twistHom hU hN α).left
      (remarkP u (twistP β 𝒜)).toQMFamily := by
    simpa only [Category.id_comp] using qmFamFibre_trans (twistHom_spec hU hN α) hiso
  have hr := qmFamFibre_trans (remarkHom_spec hU hN u)
    (qmFamFibre_remark u (twistHom_spec hU hN β))
  exact ⟨i, u, (hU Y hN (remarkP u (twistP β 𝒜))).unique hl hr⟩

private theorem exists_comp_twistMarkAut (i j : Fin 4) (u v : OrderModThreeˣ) :
    ∃ k : Fin 4, ∃ w : OrderModThreeˣ,
      (twistMarkAut hU hN i u).asIso.hom ≫ (twistMarkAut hU hN j v).asIso.hom =
        (twistMarkAut hU hN k w).asIso.hom := by
  let a := twistRep i
  let b := twistRep j
  let c := mapResidueUnit b.symm u
  obtain ⟨k, w, he⟩ := exists_twistHom_eq_twistMarkAut hU hN (b.trans a)
  refine ⟨k, v * (c * w), ?_⟩
  change (twistHom hU hN a ≫ remarkHom hU hN u) ≫
      (twistHom hU hN b ≫ remarkHom hU hN v) =
    twistHom hU hN (twistRep k) ≫ remarkHom hU hN (v * (c * w))
  have hc : remarkHom hU hN u ≫ twistHom hU hN b =
      twistHom hU hN b ≫ remarkHom hU hN c := remarkHom_comp_twistHom hU hN u b
  change twistHom hU hN (b.trans a) =
    twistHom hU hN (twistRep k) ≫ remarkHom hU hN w at he
  calc
    _ = (twistHom hU hN a ≫ (remarkHom hU hN u ≫ twistHom hU hN b)) ≫ remarkHom hU hN v := by
      simp only [Category.assoc]
    _ = ((twistHom hU hN a ≫ twistHom hU hN b) ≫ remarkHom hU hN c) ≫ remarkHom hU hN v := by
      rw [hc, ← Category.assoc (twistHom hU hN a)]
    _ = _ := by
      rw [twistHom_comp, he, Category.assoc, remarkHom_comp, Category.assoc, remarkHom_comp,
        _root_.mul_assoc]

private def twistMarkMonoid : Submonoid (Aut Y) where
  carrier := Set.range (fun z : Fin 4 × OrderModThreeˣ => twistMarkAut hU hN z.1 z.2)
  one_mem' := by
    obtain ⟨i, u, h⟩ := exists_twistHom_eq_twistMarkAut hU hN (RingEquiv.refl O)
    exact ⟨⟨i, u⟩, Aut.ext (Iso.ext (h.symm.trans (twistHom_refl hU hN)))⟩
  mul_mem' := by
    rintro _ _ ⟨⟨i, u⟩, rfl⟩ ⟨⟨j, v⟩, rfl⟩
    obtain ⟨k, w, h⟩ := exists_comp_twistMarkAut hU hN j i v u
    exact ⟨⟨k, w⟩, Aut.ext (Iso.ext h.symm)⟩

/-- The automorphisms given by the four twists and all level changes form a
finite subgroup of the automorphisms of the represented model over the base. -/
def twistMarkGroup : Subgroup (Aut Y) where
  toSubmonoid := twistMarkMonoid hU hN
  inv_mem' := by
    intro g hg
    let S := twistMarkMonoid hU hN
    let a : S := ⟨g, hg⟩
    have : Finite S := (Set.finite_range (fun z : Fin 4 × OrderModThreeˣ =>
      twistMarkAut hU hN z.1 z.2)).to_subtype
    have hi : Function.Injective (fun x : S => a * x) := by
      intro x y hxy
      apply Subtype.ext
      exact mul_left_cancel (congrArg Subtype.val hxy : g * x.val = g * y.val)
    obtain ⟨b, hb⟩ := Finite.surjective_of_injective hi 1
    have hgB : g * b.val = 1 := congrArg Subtype.val hb
    rw [← eq_inv_of_mul_eq_one_right hgB]
    exact b.property

theorem twistMarkGroup_finite : Finite (twistMarkGroup hU hN) :=
  (Set.finite_range (fun z : Fin 4 × OrderModThreeˣ => twistMarkAut hU hN z.1 z.2)).to_subtype

theorem twistMarkGroup_card_le : Nat.card (twistMarkGroup hU hN) ≤ 324 := by
  calc
    _ ≤ Nat.card (Fin 4 × OrderModThreeˣ) := Finite.card_range_le _
    _ = 4 * Nat.card OrderModThreeˣ := by rw [Nat.card_prod, Nat.card_fin]
    _ ≤ 324 := Nat.mul_le_mul_left _ card_orderModThree_units_le

end Represented

open HDec.QMSplit.Moduli in
/-- On the represented rational model, the finite family of automorphisms
`twistMarkAut` realizes exactly the twist classes of the underlying QM pairs. -/
theorem twistMarkAut_orbit_iff {K : Type} [Field K] [Algebra ℚ K]
    {Y : Over (Spec (CommRingCat.of ℚ))} {𝒜 : QMAbSchemeP Y.left}
    (hU : Represents Y 𝒜) (hN : IsLocallyNoetherian Y.left)
    (y y' : fieldPt K ⟶ Y) (P Q : QML3 K)
    (hP : IsFibreOf 𝒜.toQMFamily y.left P) (hQ : IsFibreOf 𝒜.toQMFamily y'.left Q) :
    (∃ i : Fin 4, ∃ u : OrderModThreeˣ, y ≫ (twistMarkAut hU hN i u).asIso.hom = y') ↔
      ∃ α : O ≃+* O, Nonempty (QMIso (P.q.twist α) Q.q) := by
  constructor
  · rintro ⟨i, u, rfl⟩
    have h := isFibreOf_twistMarkAut hU hN i u hP
    obtain ⟨e⟩ := Quotient.exact (fibreClassUnique Y.left 𝒜.toQMFamily K _ _ _ h hQ)
    exact ⟨twistRep i, ⟨⟨e.φ, e.ψ, e.left, e.right, e.equivariant⟩⟩⟩
  · rintro ⟨α, ⟨e⟩⟩
    have : CharZero K := charZero_of_injective_algebraMap (algebraMap ℚ K).injective
    obtain ⟨i, ⟨e'⟩⟩ := ElkiesX6Star.exists_rep_iso P.q α
    obtain ⟨u, ⟨iso⟩⟩ := exists_remarkPoint_iso (P.twist (twistRep i)) Q (e'.trans e)
    have h := isFibreOf_twistMarkAut hU hN i u hP
    have h' := isFibreOf_of_iso 𝒜.toQMFamily iso.symm h
    have hT := AvSplit.torsionStructure_of_mumford
      ZInQ.Contrib.CloudB3W16Torsion.mumfordTorsionAlgClosed_proof
    obtain ⟨𝒜Q, h𝒜Q⟩ := Y3Audit.exists_schemeP hT K Q
    have hQ' := hU (fieldPt K) inferInstance 𝒜Q
    exact ⟨i, u, hQ'.unique ((h𝒜Q _ _ _).mp h') ((h𝒜Q _ _ _).mp hQ)⟩

open HDec.QMSplit.Moduli in
/-- The orbits of the finite group on the represented rational model are
exactly the twist classes of the underlying geometric QM pairs. -/
theorem twistMarkGroup_orbit_iff {K : Type} [Field K] [Algebra ℚ K]
    {Y : Over (Spec (CommRingCat.of ℚ))} {𝒜 : QMAbSchemeP Y.left}
    (hU : Represents Y 𝒜) (hN : IsLocallyNoetherian Y.left)
    (y y' : fieldPt K ⟶ Y) (P Q : QML3 K)
    (hP : IsFibreOf 𝒜.toQMFamily y.left P) (hQ : IsFibreOf 𝒜.toQMFamily y'.left Q) :
    (∃ g : twistMarkGroup hU hN, y ≫ g.val.asIso.hom = y') ↔
      ∃ α : O ≃+* O, Nonempty (QMIso (P.q.twist α) Q.q) := by
  rw [← twistMarkAut_orbit_iff hU hN y y' P Q hP hQ]
  constructor
  · rintro ⟨⟨g, hg⟩, hy⟩
    obtain ⟨⟨i, u⟩, rfl⟩ := hg
    exact ⟨i, u, hy⟩
  · rintro ⟨i, u, hy⟩
    exact ⟨⟨twistMarkAut hU hN i u, ⟨⟨i, u⟩, rfl⟩⟩, hy⟩

/-- The assumed integral level-three representation supplies the full
residue-unit action on an actual proper smooth model over `ℤ[1/30]`. -/
theorem exists_residueUnitAction_of_z30 (h : Y3FullThreeRepZ30) :
    ∃ (Y : Over (Spec (CommRingCat.of Z30))) (𝒜 : QMAbSchemeP Y.left)
      (ρ : OrderModThreeˣ →* Aut Y),
      IsProper Y.hom ∧ SmoothOfRelativeDimension 1 Y.hom ∧ Represents Y 𝒜 ∧
      ∀ u, QMFamFibre 𝒜.toQMFamily (ρ u).asIso.hom.left (remarkP u 𝒜).toQMFamily := by
  obtain ⟨Y, 𝒜, hp, hs, hU⟩ := h
  have hN := isLocallyNoetherian_of_smooth hs
  exact ⟨Y, 𝒜, residueUnitAction hU hN, hp, hs, hU, residueUnitAction_spec hU hN⟩

