import ZInQKernel.Contrib.OneProof.HeckePrimeRationality.ThetaFiveTorsionCoefficients
import Mathlib.NumberTheory.Cyclotomic.PrimitiveRoots

/-!
# The explicit fifth cyclotomic coefficient field

The field generated by the actual complex fifth root is a finite Galois
extension of the rationals. Its automorphisms send the distinguished root
to one of its four nontrivial powers, and their common fixed field is ℚ.
-/

noncomputable section

open Complex
open ZInQ.Contrib.HeckePrimeRationality.ThetaFiveTorsionCoefficients

namespace ZInQ.Contrib.HeckePrimeRationality.ThetaFiveCyclotomicField

lemma complex_root_primitive : IsPrimitiveRoot zetaFive 5 :=
  Complex.isPrimitiveRoot_exp 5 (by decide)

lemma field_root_primitive : IsPrimitiveRoot zetaInField 5 := by
  apply (IsPrimitiveRoot.coe_submonoidClass_iff).mp
  exact complex_root_primitive

/-- The coefficient field is the actual fifth cyclotomic extension. -/
instance cyclotomic : IsCyclotomicExtension ({5} : Set ℕ) ℚ KFive := by
  apply (IntermediateField.isCyclotomicExtension_singleton_iff_eq_adjoin
    (n := 5) ℚ ℂ KFive complex_root_primitive).mpr
  rfl

/-- Finite dimensionality follows from the proved cyclotomic structure. -/
instance finiteDimensional : FiniteDimensional ℚ KFive :=
  IsCyclotomicExtension.finiteDimensional ({5} : Set ℕ) ℚ KFive

/-- Normality and separability are unconditional for this actual field. -/
instance galois : IsGalois ℚ KFive :=
  IsCyclotomicExtension.isGalois ({5} : Set ℕ) ℚ KFive

lemma field_root_ne_one : zetaInField ≠ 1 := by
  intro h
  have hpow : zetaInField ^ (1 : ℕ) = 1 := by simpa using h
  have hdiv := (field_root_primitive.pow_eq_one_iff_dvd 1).mp hpow
  norm_num at hdiv

/-- Each automorphism has a representative exponent between one and four. -/
theorem automorphism_root_power_nat (σ : KFive ≃ₐ[ℚ] KFive) :
    ∃ t : ℕ, 0 < t ∧ t < 5 ∧ σ zetaInField = zetaInField ^ t := by
  have hpow : (σ zetaInField) ^ 5 = 1 := by
    rw [← map_pow, field_root_primitive.pow_eq_one, map_one]
  obtain ⟨t, ht, hroot⟩ := field_root_primitive.eq_pow_of_pow_eq_one hpow
  have ht0 : t ≠ 0 := by
    intro hzero
    rw [hzero, pow_zero] at hroot
    apply field_root_ne_one
    apply σ.injective
    simpa using hroot.symm
  exact ⟨t, Nat.pos_of_ne_zero ht0, ht, hroot.symm⟩

/-- The selector in the integer-power convention used by coefficient covariance. -/
theorem automorphism_root_power_int (σ : KFive ≃ₐ[ℚ] KFive) :
    ∃ t : ℤ, ¬ (5 : ℤ) ∣ t ∧ σ zetaInField = zetaInField ^ t := by
  obtain ⟨t, ht0, ht5, hroot⟩ := automorphism_root_power_nat σ
  refine ⟨(t : ℤ), ?_, ?_⟩
  · intro hdiv
    have hdiv' : (5 : ℕ) ∣ t := by exact_mod_cast hdiv
    have hle := Nat.le_of_dvd ht0 hdiv'
    omega
  · simpa only [zpow_natCast] using hroot

/-- Elements fixed by every actual rational automorphism belong to the rational image. -/
theorem exists_rational_of_fixed (x : KFive)
    (hx : ∀ σ : KFive ≃ₐ[ℚ] KFive, σ x = x) :
    ∃ q : ℚ, algebraMap ℚ KFive q = x :=
  (IsGalois.mem_range_algebraMap_iff_fixed x).mpr hx

end ZInQ.Contrib.HeckePrimeRationality.ThetaFiveCyclotomicField
