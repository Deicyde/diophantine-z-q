import Mathlib.NumberTheory.ModularForms.JacobiTheta.TwoVariable
import Mathlib.Analysis.Complex.UpperHalfPlane.Manifold
import Mathlib.FieldTheory.IntermediateField.Adjoin.Basic

/-!
# Torsion-theta definitions at an arbitrary level

These definitions use the actual two-variable theta function and its derivative.
They introduce no modularity, nonvanishing, Fourier-arithmetic or Hecke theorem.
The corresponding proofs are separate obligations. The intended level is
positive; no mathematical claim at level zero is made.
-/

noncomputable section

namespace ZInQ.Contrib.HeckePrimeRationality.Torsion

/-- The shifted torsion point in the theta-three normalization. -/
def shiftedPoint (N : ℕ) (a b : ℤ) (τ : UpperHalfPlane) : ℂ :=
  ((a : ℂ) * (τ : ℂ) + (b : ℂ)) / (N : ℂ) + ((τ : ℂ) + 1) / 2

/-- The completed logarithmic derivative at a level-N torsion point. -/
def torsionLogDerivative (N : ℕ) (a b : ℤ) (τ : UpperHalfPlane) : ℂ :=
  (a : ℂ) / (N : ℂ) + 1 / 2 +
    jacobiTheta₂' (shiftedPoint N a b τ) (τ : ℂ) /
      (2 * (Real.pi : ℂ) * Complex.I * jacobiTheta₂ (shiftedPoint N a b τ) (τ : ℂ))

/-- The specified complex root of unity. -/
def zeta (N : ℕ) : ℂ := Complex.exp (2 * (Real.pi : ℂ) * Complex.I / (N : ℂ))

/-- Its integer-indexed power. -/
def w (N : ℕ) (b : ℤ) : ℂ := zeta N ^ b

/-- The actual coefficient field generated by this root. -/
def coefficientField (N : ℕ) : IntermediateField ℚ ℂ :=
  IntermediateField.adjoin ℚ {zeta N}

end ZInQ.Contrib.HeckePrimeRationality.Torsion
