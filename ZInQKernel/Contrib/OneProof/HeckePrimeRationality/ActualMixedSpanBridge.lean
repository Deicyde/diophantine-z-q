import ZInQKernel.Contrib.OneProof.HeckePrimeRationality.AllLevelPrincipalRationalMixedGL2Transport
import ZInQKernel.Contrib.OneProof.HeckePrimeRationality.RepeatedPrimeMixedTrace

/-!
# Equality of the Good mixed span and the all-label lower mixed span

Both spaces are generated by actual x-lambda modular forms. Equality of their
individual modular forms follows from their proved evaluations. Bad left or
right factors vanish by the verified zero extensions, so no span equality or
trace-image statement is assumed.
-/

noncomputable section
set_option autoImplicit false
set_option maxHeartbeats 1600000

open Complex Function Set
open scoped Real UpperHalfPlane BigOperators MatrixGroups ModularForm

namespace ZInQ.Contrib.HeckePrimeRationality.ActualMixedSpanBridge

open RationalGaussian RationalMixedTransport RectangularMixedTransport
open TorsionWeierstrassData TorsionWeightThree

/-- The two independent actual mixed modular constructions agree at every label. -/
theorem mixedForm_eq_crossForm (N : ℕ) (hN : 0<N) (P Q : ℤ × ℤ) :
    mixedForm N hN P Q=MixedWeightThreeDistribution.crossForm N hN P.1 P.2 Q.1 Q.2 := by
  apply _root_.ModularForm.ext
  intro τ
  rw [mixedForm_apply,MixedWeightThreeDistribution.crossForm_apply]

/-- The all-label generator range is the Good mixed span: bad factors contribute
actual zero forms, not unproved exceptions or assigned pole values. -/
theorem mixedSpan_eq_lowerMixedSpan (N : ℕ) (hN : 0<N) :
    mixedSpan N hN=RepeatedPrimeMixedTrace.lowerMixedSpan N hN := by
  apply le_antisymm
  · apply Submodule.span_le.mpr
    rintro F ⟨P,Q,hP,hQ,rfl⟩
    rw [mixedForm_eq_crossForm]
    exact Submodule.subset_span ⟨(P,Q),rfl⟩
  · apply Submodule.span_le.mpr
    rintro F ⟨⟨P,Q⟩,rfl⟩
    change MixedWeightThreeDistribution.crossForm N hN P.1 P.2 Q.1 Q.2∈mixedSpan N hN
    rw [← mixedForm_eq_crossForm N hN P Q]
    exact mixedForm_mem N hN P Q

/-- Every all-label lower mixed generator has proved Good-span membership. -/
theorem crossForm_mem_mixedSpan (N : ℕ) (hN : 0<N) (a b c d : ℤ) :
    MixedWeightThreeDistribution.crossForm N hN a b c d∈mixedSpan N hN := by
  rw [← mixedForm_eq_crossForm N hN (a,b) (c,d)]
  exact mixedForm_mem N hN (a,b) (c,d)

/-- Arbitrary positive rational transport of the exact all-label lower mixed
space, using the proved bridge rather than an EqSpan hypothesis. -/
theorem actual_positive_rational_lowerMixed_transport (N : ℕ) (hN : 0<N)
    (f : Weight N 3) (hf : f∈RepeatedPrimeMixedTrace.lowerMixedSpan N hN)
    (A : GLQ) (hA : 0<(A.det : ℚ)) :
    ∃ (M : ℕ) (hM : 0<M),N∣M ∧
      ∃ F : Weight M 3,F∈RepeatedPrimeMixedTrace.lowerMixedSpan M hM ∧
        ∀ τ : ℍ,F τ=(⇑f ∣[(3 : ℤ)] Matrix.GeneralLinearGroup.map (algebraMap ℚ ℝ) A) τ := by
  have hgood : f∈mixedSpan N hN := by rw [mixedSpan_eq_lowerMixedSpan];exact hf
  obtain ⟨M,hM,hNM,F,hF,hFeq⟩ := actual_positive_rational_mixed_transport N hN f hgood A hA
  refine ⟨M,hM,hNM,F,?_,hFeq⟩
  rw [← mixedSpan_eq_lowerMixedSpan]
  exact hF

end ZInQ.Contrib.HeckePrimeRationality.ActualMixedSpanBridge
