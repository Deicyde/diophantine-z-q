import ZInQKernel.Contrib.OneProof.HeckePrimeRationality.CoprimePrincipalProductTrace

/-!
# Coprime-prime closure of the genuine degree-two principal-product span

Linearity extends the arbitrary actual Good-product trace theorem to the
subspace generated by those products. No equality with the full modular-form
space is stated.
-/

noncomputable section
set_option autoImplicit false
open UpperHalfPlane CongruenceSubgroup Matrix.SpecialLinearGroup
open scoped BigOperators MatrixGroups ModularForm

namespace ZInQ.Contrib.HeckePrimeRationality.CoprimeProductTrace

open TorsionQuadraticGenerators AllLevelProducts DivisionEisensteinLevelMaps

set_option quotPrecheck false in
local notation "ΓP" N => (CongruenceSubgroup.Gamma N).map (mapGL ℝ)

/-- The actual Good degree-two product span is trace-stable across a coprime prime extension. -/
theorem productSpan_trace_coprime_mem (p N : ℕ) [Fact p.Prime] (h3 : 3 ≤ N) (hcop : Nat.Coprime p N)
    {f : _root_.ModularForm (ΓP (p * N)) 2}
    (hf : f ∈ productSpan (p * N) (Nat.mul_pos (Fact.out : p.Prime).pos (by omega))) :
    normalizedTrace N (p * N) (Nat.mul_pos (Fact.out : p.Prime).pos (by omega)) f ∈ productSpan N (by omega) := by
  have hle : productSpan (p * N) (Nat.mul_pos (Fact.out : p.Prime).pos (by omega)) ≤
      (productSpan N (by omega)).comap
        (normalizedTrace N (p * N) (Nat.mul_pos (Fact.out : p.Prime).pos (by omega))) := by
    apply Submodule.span_le.mpr
    rintro f ⟨v,hv,rfl⟩
    have hw : ∀ i : Fin 2, AllLevelForms.Good (p * N) (![v 0,v 1] i) := by
      intro i; fin_cases i
      · exact hv 0
      · exact hv 1
    have he : productForm (p * N) (Nat.mul_pos (Fact.out : p.Prime).pos (by omega)) 2 v hv =
        productForm (p * N) (Nat.mul_pos (Fact.out : p.Prime).pos (by omega)) 2 ![v 0,v 1] hw := by
      apply _root_.ModularForm.ext
      intro τ
      rw [productForm_apply, productForm_apply]
      simp [Fin.prod_univ_two]
    change normalizedTrace N (p * N) (Nat.mul_pos (Fact.out : p.Prime).pos (by omega))
      (productForm (p * N) (Nat.mul_pos (Fact.out : p.Prime).pos (by omega)) 2 v hv) ∈ productSpan N (by omega)
    rw [he]
    simpa only [Prod.eta] using principal_product_trace_coprime_mem p N h3 hcop
      (v 0).1 (v 0).2 (v 1).1 (v 1).2 (hv 0) (hv 1)
  exact hle hf

end ZInQ.Contrib.HeckePrimeRationality.CoprimeProductTrace
