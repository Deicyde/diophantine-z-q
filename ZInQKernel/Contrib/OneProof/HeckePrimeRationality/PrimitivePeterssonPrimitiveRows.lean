import ZInQKernel.Contrib.OneProof.HeckePrimeRationality.PrimitivePeterssonPrincipalDomain
import Mathlib.NumberTheory.ModularForms.EisensteinSeries.Basic

/-!
# Primitive bottom rows and actual parabolic cosets

The gcd-one congruence row (0,1) is identified with the quotient of Γ(N)
by the subgroup generated by T^N. A primitive integer row is lifted by
Bezout, then its top row is corrected to principal level. Equal bottom rows
differ by an actual width-N unipotent element; no orbit-size premise is used.
-/

noncomputable section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency.types false
open MeasureTheory Set UpperHalfPlane Complex Matrix Matrix.SpecialLinearGroup
open scoped Topology MatrixGroups ModularForm Pointwise ComplexConjugate

namespace ZInQ.Contrib.HeckePrimeRationality.PrimitivePetersson

abbrev infinityRow (N : ℕ) : Fin 2 → ZMod N := ![0,1]
abbrev infinityPrimitiveRows (N : ℕ) := EisensteinSeries.gammaSet N 1 (infinityRow N)

/-- The actual bottom row of a principal integral matrix. -/
def principalBottomRow (N : ℕ) (g : CongruenceSubgroup.Gamma N) : infinityPrimitiveRows N := by
  refine ⟨fun i => (g : SL(2, ℤ)) 1 i,?_,?_⟩
  · ext i
    fin_cases i
    · exact (CongruenceSubgroup.Gamma_mem.mp g.2).2.2.1
    · exact (CongruenceSubgroup.Gamma_mem.mp g.2).2.2.2
  · exact Int.isCoprime_iff_gcd_eq_one.mp (ModularGroup.bottom_row_coprime (g : SL(2, ℤ)))

/-- Every actual primitive row congruent to (0,1) occurs in Γ(N). -/
theorem principalBottomRow_surjective (N : ℕ) : Function.Surjective (principalBottomRow N) := by
  intro v
  obtain ⟨A,_,hA⟩ := ModularGroup.bottom_row_surj (Int.isCoprime_iff_gcd_eq_one.mpr v.2.2)
  have h0 : (A 1 0 : ZMod N) = 0 := by
    have hh := congrFun v.2.1 0
    change (v.1 0 : ZMod N) = 0 at hh
    rwa [← hA] at hh
  have h1 : (A 1 1 : ZMod N) = 1 := by
    have hh := congrFun v.2.1 1
    change (v.1 1 : ZMod N) = 1 at hh
    rwa [← hA] at hh
  have ha : (A 0 0 : ZMod N) = 1 := by
    have hd := congrArg (fun t : ℤ => (t : ZMod N)) A.det_coe
    simp only [Matrix.det_fin_two,Int.cast_sub,Int.cast_mul,Int.cast_one,h0,h1,mul_one,mul_zero,sub_zero] at hd
    exact hd
  let B : SL(2, ℤ) := ModularGroup.T ^ (-A 0 1) * A
  have hB : B ∈ CongruenceSubgroup.Gamma N := by
    rw [CongruenceSubgroup.Gamma_mem]
    simp only [B,Matrix.SpecialLinearGroup.coe_mul,Matrix.mul_apply,Fin.sum_univ_two,
      ModularGroup.coe_T_zpow,Matrix.cons_val_zero,Matrix.cons_val_one,Matrix.head_cons,
      Matrix.head_fin_const,one_mul,zero_mul,zero_add,Int.cast_add,Int.cast_mul,Int.cast_neg,
      ha,h0,h1,mul_zero,mul_one,add_zero,neg_add_cancel]
    simp
  have hb : principalBottomRow N ⟨B,hB⟩ = v := by
    apply Subtype.ext
    ext i
    change B 1 i = v.1 i
    simp only [B,Matrix.SpecialLinearGroup.coe_mul,Matrix.mul_apply,Fin.sum_univ_two,
      ModularGroup.coe_T_zpow]
    simpa using congrFun hA i
  exact ⟨⟨B,hB⟩,hb⟩

/-- Exact stabilizer criterion for bottom rows inside the actual principal group. -/
theorem same_bottom_iff_translation (N : ℕ) (A B : CongruenceSubgroup.Gamma N) :
    principalBottomRow N A = principalBottomRow N B ↔
      ((A : SL(2, ℤ))*(B : SL(2, ℤ))⁻¹) ∈ translationGroup N := by
  constructor
  · intro hAB
    let C : SL(2, ℤ) := (A : SL(2, ℤ))*(B : SL(2, ℤ))⁻¹
    have hC : C ∈ CongruenceSubgroup.Gamma N :=
      (CongruenceSubgroup.Gamma N).mul_mem A.2 ((CongruenceSubgroup.Gamma N).inv_mem B.2)
    have he : (fun i => (A : SL(2, ℤ)) 1 i) = (fun i => (B : SL(2, ℤ)) 1 i) := congrArg Subtype.val hAB
    have hrow : (fun i => C 1 i) = ![0,1] := by
      have hi := congrArg (fun g : SL(2, ℤ) => fun i => g 1 i) (mul_inv_cancel (B : SL(2, ℤ)))
      ext i
      change ∑ j, (A : SL(2, ℤ)) 1 j * ((B : SL(2, ℤ))⁻¹) j i = _
      have hj (j : Fin 2) : (A : SL(2, ℤ)) 1 j = (B : SL(2, ℤ)) 1 j := congrFun he j
      simp_rw [hj]
      calc (∑ j, (B : SL(2, ℤ)) 1 j * ((B : SL(2, ℤ))⁻¹) j i)
          = ((B : SL(2, ℤ))*(B : SL(2, ℤ))⁻¹) 1 i := rfl
        _ = (1 : SL(2, ℤ)) 1 i := congrFun hi i
        _ = ![0,1] i := by fin_cases i <;> rfl
    have hc0 : C 1 0 = 0 := congrFun hrow 0
    have hc1 : C 1 1 = 1 := congrFun hrow 1
    have ha : C 0 0 = 1 := by simpa only [Matrix.det_fin_two,hc0,hc1,mul_zero,mul_one,sub_zero] using C.det_coe
    have hT : C = ModularGroup.T ^ C 0 1 := by
      apply Subtype.ext
      ext i j
      fin_cases i <;> fin_cases j <;>
        simp [ModularGroup.coe_T_zpow,ha,hc0,hc1]
    have hd : (N : ℤ) ∣ C 0 1 :=
      (ZMod.intCast_zmod_eq_zero_iff_dvd (C 0 1) N).mp (CongruenceSubgroup.Gamma_mem.mp hC).2.1
    obtain ⟨n,hn⟩ := hd
    change C ∈ translationGroup N
    rw [hT,hn,← translation_power]
    exact Subgroup.mem_zpowers_iff.mpr ⟨n,rfl⟩
  · intro hT
    obtain ⟨n,hn⟩ := Subgroup.mem_zpowers_iff.mp hT
    have he : (A : SL(2, ℤ)) = (ModularGroup.T ^ N)^n * (B : SL(2, ℤ)) := by
      rw [hn,mul_assoc,inv_mul_cancel,mul_one]
    apply Subtype.ext
    ext i
    change (A : SL(2, ℤ)) 1 i = (B : SL(2, ℤ)) 1 i
    rw [he,translation_power]
    simp only [Matrix.SpecialLinearGroup.coe_mul,Matrix.mul_apply,Fin.sum_univ_two,
      ModularGroup.coe_T_zpow]
    simp

/-- The actual primitive row associated with a parabolic quotient class. -/
def quotientPrimitiveRow (N : ℕ) : parabolicQuotient N → infinityPrimitiveRows N :=
  Quotient.lift (fun g => principalBottomRow N g⁻¹) (by
    intro A B hAB
    apply (same_bottom_iff_translation N A⁻¹ B⁻¹).mpr
    change QuotientGroup.leftRel ((translationGroup N).subgroupOf (CongruenceSubgroup.Gamma N)) A B at hAB
    rw [QuotientGroup.leftRel_apply] at hAB
    simpa only [InvMemClass.coe_inv,MulMemClass.coe_mul,inv_inv] using Subgroup.mem_subgroupOf.mp hAB)

lemma quotientPrimitiveRow_mk (N : ℕ) (g : CongruenceSubgroup.Gamma N) :
    quotientPrimitiveRow N (QuotientGroup.mk g) = principalBottomRow N g⁻¹ := rfl

lemma quotientPrimitiveRow_bijective (N : ℕ) : Function.Bijective (quotientPrimitiveRow N) := by
  constructor
  · intro q r hqr
    induction q using QuotientGroup.induction_on with
    | H A =>
      induction r using QuotientGroup.induction_on with
      | H B =>
        rw [quotientPrimitiveRow_mk,quotientPrimitiveRow_mk] at hqr
        apply QuotientGroup.eq.mpr
        apply Subgroup.mem_subgroupOf.mpr
        simpa only [InvMemClass.coe_inv,MulMemClass.coe_mul,inv_inv] using
          (same_bottom_iff_translation N A⁻¹ B⁻¹).mp hqr
  · intro v
    obtain ⟨g,hg⟩ := principalBottomRow_surjective N v
    exact ⟨QuotientGroup.mk g⁻¹,by simp only [quotientPrimitiveRow_mk,inv_inv,hg]⟩

/-- A genuine fixed equivalence, independent of τ, with the actual gcd-one gamma set. -/
def primitiveRowEquiv (N : ℕ) : parabolicQuotient N ≃ infinityPrimitiveRows N :=
  Equiv.ofBijective (quotientPrimitiveRow N) (quotientPrimitiveRow_bijective N)

lemma primitiveRowEquiv_out (N : ℕ) (q : parabolicQuotient N) :
    (primitiveRowEquiv N q).1 = fun i => (((q.out)⁻¹ : CongruenceSubgroup.Gamma N) : SL(2, ℤ)) 1 i := by
  have he := congrArg (fun r : parabolicQuotient N => (primitiveRowEquiv N r).1) (QuotientGroup.out_eq' q)
  change (fun i => (((q.out)⁻¹ : CongruenceSubgroup.Gamma N) : SL(2, ℤ)) 1 i) = (primitiveRowEquiv N q).1 at he
  exact he.symm

end ZInQ.Contrib.HeckePrimeRationality.PrimitivePetersson
