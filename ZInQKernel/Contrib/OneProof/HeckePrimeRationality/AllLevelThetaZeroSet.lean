import ZInQKernel.Contrib.OneProof.HeckePrimeRationality.AllLevelThetaNonvanishing

/-!
# The actual shifted Jacobi theta zero set

The two-variable theta function is the period-one normalization of theta three.
Its shift by `(τ + 1) / 2` vanishes exactly on the lattice generated by `τ` and `1`.
The proof extends the relative paired-series estimate to real lattice coordinates,
then transports it with the actual transformation laws under the modular generators.
The derivative at the shifted origin is nonzero by the same paired estimate.
-/

noncomputable section
set_option autoImplicit false

open Complex ModularGroup
open scoped Modular Real UpperHalfPlane MatrixGroups

namespace ZInQ.Contrib.HeckePrimeRationality.AllLevelThetaZeroSet

open ZInQ.Contrib.HeckePrimeRationality

/-- The shifted origin is an actual zero, by pairing the convergent theta series. -/
theorem jacobiTheta₂_half_shift_eq_zero {τ : _root_.Complex} (hτ : 0 < τ.im) :
    _root_.jacobiTheta₂ ((τ + 1) / 2) τ = 0 := by
  have h := AllLevelTheta.hasSum_g (z₀ := (0 : ℂ)) hτ
  simpa using h.tsum_eq.symm

theorem eq_zero_add_int_mul_tau_iff (z τ : _root_.Complex) (m : _root_.Int) :
    _root_.jacobiTheta₂ (z + (m : ℂ) * τ) τ = 0 ↔ _root_.jacobiTheta₂ z τ = 0 := by
  simpa only [not_not] using not_congr (ThetaFive.ne_zero_add_int_mul_tau_iff z τ m)

/-- Every lattice translate of the shifted origin is a zero. -/
theorem jacobiTheta₂_shift_eq_zero_of_lattice (τ : _root_.UpperHalfPlane)
    (z : _root_.Complex) (hz : ∃ m n : _root_.Int, z = (m : ℂ) * (τ : ℂ) + (n : ℂ)) :
    _root_.jacobiTheta₂ (z + ((τ : ℂ) + 1) / 2) (τ : ℂ) = 0 := by
  rcases hz with ⟨m, n, rfl⟩
  rw [show (m : ℂ) * (τ : ℂ) + (n : ℂ) + ((τ : ℂ) + 1) / 2 =
      (((τ : ℂ) + 1) / 2 + (m : ℂ) * (τ : ℂ)) + (n : ℂ) by ring,
    ThetaFive.jacobiTheta₂_add_int_left, eq_zero_add_int_mul_tau_iff]
  exact jacobiTheta₂_half_shift_eq_zero τ.im_pos

/-- Integrality of both real lattice coordinates. -/
def IntegralPair (a b : _root_.Real) : Prop :=
  ∃ m n : _root_.Int, a = (m : ℝ) ∧ b = (n : ℝ)

/-- The actual theta expression in real lattice coordinates. -/
def thetaReal (a b : _root_.Real) (τ : _root_.Complex) : _root_.Complex :=
  _root_.jacobiTheta₂ ((a : ℂ) * τ + (b : ℂ) + (τ + 1) / 2) τ

theorem integralPair_T_iff (a b : _root_.Real) :
    IntegralPair a (a + b) ↔ IntegralPair a b := by
  constructor
  · rintro ⟨m, n, ha, hb⟩
    refine ⟨m, n - m, ha, ?_⟩
    push_cast
    linarith
  · rintro ⟨m, n, rfl, rfl⟩
    exact ⟨m, m + n, rfl, by push_cast; ring⟩

theorem integralPair_S_iff (a b : _root_.Real) :
    IntegralPair (-b) a ↔ IntegralPair a b := by
  constructor
  · rintro ⟨m, n, hb, ha⟩
    refine ⟨n, -m, ha, ?_⟩
    push_cast
    linarith
  · rintro ⟨m, n, rfl, rfl⟩
    exact ⟨-n, m, by push_cast; ring, rfl⟩

theorem thetaReal_add_one (a b : _root_.Real) (τ : _root_.Complex) :
    thetaReal a b (τ + 1) = thetaReal a (a + b) τ := by
  unfold thetaReal
  rw [ThetaFive.jacobiTheta₂_add_one_right]
  rw [show (a : ℂ) * (τ + 1) + (b : ℂ) + (τ + 1 + 1) / 2 + 1 / 2 =
      ((a : ℂ) * τ + ((a + b : ℝ) : ℂ) + (τ + 1) / 2) + ((1 : ℤ) : ℂ) by
        push_cast; ring,
    ThetaFive.jacobiTheta₂_add_int_left]

theorem thetaReal_ne_zero_S_iff (a b : _root_.Real) {τ : _root_.Complex} (hτ : τ ≠ 0) :
    thetaReal a b τ ≠ 0 ↔ thetaReal (-b) a (-1 / τ) ≠ 0 := by
  have hc : (1 : ℂ) / (-I * τ) ^ (1 / 2 : ℂ) ≠ 0 := by
    refine one_div_ne_zero ?_
    rw [Ne, Complex.cpow_eq_zero_iff]
    exact fun h => mul_ne_zero (neg_ne_zero.mpr I_ne_zero) hτ h.1
  have hz : ((a : ℂ) * τ + (b : ℂ) + (τ + 1) / 2) / τ =
      (((-b : ℝ) : ℂ) * (-1 / τ) + (a : ℂ) + ((-1 / τ) + 1) / 2) +
        ((-1 : ℤ) : ℂ) * (-1 / τ) := by
    field_simp
    push_cast
    ring
  have key := ThetaFive.ne_zero_add_int_mul_tau_iff
    (((-b : ℝ) : ℂ) * (-1 / τ) + (a : ℂ) + ((-1 / τ) + 1) / 2) (-1 / τ) (-1)
  unfold thetaReal
  rw [jacobiTheta₂_functional_equation, hz]
  constructor
  · intro h
    refine key.mp fun h0 => h ?_
    rw [h0, mul_zero]
  · intro h
    exact mul_ne_zero (mul_ne_zero hc (Complex.exp_ne_zero _)) (key.mpr h)

/-- Nonvanishing away from integral real coordinates, at a fixed modulus. -/
def Nonvanishing (τ : _root_.UpperHalfPlane) : Prop :=
  ∀ a b : _root_.Real, ¬ IntegralPair a b → thetaReal a b (τ : ℂ) ≠ 0

theorem nonvanishing_T_iff (τ : _root_.UpperHalfPlane) :
    Nonvanishing (T • τ) ↔ Nonvanishing τ := by
  unfold Nonvanishing
  rw [ThetaFive.coe_T_smul]
  constructor
  · intro h a b hab
    have hgood : ¬ IntegralPair a (b - a) := by
      intro hi
      apply hab
      have hi' := (integralPair_T_iff a (b - a)).mpr hi
      simpa using hi'
    have hh := h a (b - a) hgood
    simpa [thetaReal_add_one] using hh
  · intro h a b hab
    rw [thetaReal_add_one]
    exact h a (a + b) (fun hi => hab ((integralPair_T_iff a b).mp hi))

theorem nonvanishing_S_iff (τ : _root_.UpperHalfPlane) :
    Nonvanishing (S • τ) ↔ Nonvanishing τ := by
  unfold Nonvanishing
  rw [ThetaFive.coe_S_smul]
  have hτ : (τ : ℂ) ≠ 0 := τ.ne_zero
  have hτ' : -1 / (τ : ℂ) ≠ 0 := div_ne_zero (neg_ne_zero.mpr one_ne_zero) hτ
  have hinv : -1 / (-1 / (τ : ℂ)) = (τ : ℂ) := by field_simp
  constructor
  · intro h a b hab
    rw [thetaReal_ne_zero_S_iff a b hτ]
    exact h (-b) a (fun hi => hab ((integralPair_S_iff a b).mp hi))
  · intro h a b hab
    rw [thetaReal_ne_zero_S_iff a b hτ', hinv]
    have hh := h (-b) a (fun hi => hab ((integralPair_S_iff a b).mp hi))
    simpa [thetaReal] using hh

theorem nonvanishing_smul_iff (γ : SL(2, ℤ)) (τ : _root_.UpperHalfPlane) :
    Nonvanishing (γ • τ) ↔ Nonvanishing τ := by
  have hg : γ ∈ Subgroup.closure ({S, T} : Set SL(2, ℤ)) := by
    rw [SpecialLinearGroup.SL2Z_generators]
    exact Subgroup.mem_top γ
  induction hg using Subgroup.closure_induction generalizing τ with
  | mem x hx =>
    rcases hx with rfl | rfl
    · exact nonvanishing_S_iff τ
    · exact nonvanishing_T_iff τ
  | one => rw [one_smul]
  | mul x y _ _ hx hy =>
    rw [mul_smul]
    exact (hx (y • τ)).trans (hy τ)
  | inv x _ hx =>
    have h := hx (x⁻¹ • τ)
    rw [smul_inv_smul] at h
    exact h.symm

/-- The relative series estimate works for arbitrary balanced real coordinates. -/
theorem nonvanishing_of_mem_fd {τ : _root_.UpperHalfPlane} (hτ : τ ∈ 𝒟) :
    Nonvanishing τ := by
  intro a b hab
  have hy : 0 < (τ : ℂ).im := τ.im_pos
  have h3 : 3 ≤ 4 * (τ : ℂ).im ^ 2 := three_le_four_mul_im_sq_of_mem_fd hτ
  let q : ℤ := ⌊a + 1 / 2⌋
  let a₀ : ℝ := a - (q : ℝ)
  have hbal : |a₀| ≤ 1 / 2 := by
    have h1 := Int.floor_le (a + 1 / 2)
    have h2 := Int.lt_floor_add_one (a + 1 / 2)
    change |a - (⌊a + 1 / 2⌋ : ℝ)| ≤ 1 / 2
    rw [abs_le]
    constructor <;> linarith
  have heq : thetaReal a b (τ : ℂ) =
      jacobiTheta₂ (((a₀ : ℂ) * (τ : ℂ) + (b : ℂ) + ((τ : ℂ) + 1) / 2) +
        (q : ℂ) * (τ : ℂ)) (τ : ℂ) := by
    unfold thetaReal a₀
    congr 1
    push_cast
    ring
  rw [heq, ThetaFive.ne_zero_add_int_mul_tau_iff]
  let z₀ : ℂ := (a₀ : ℂ) * (τ : ℂ) + (b : ℂ)
  apply AllLevelTheta.jacobiTheta₂_shift_ne_zero hy h3
  · change |z₀.im| ≤ (τ : ℂ).im / 2
    have him : z₀.im = a₀ * (τ : ℂ).im := by simp [z₀]
    rw [him, abs_mul, abs_of_pos hy]
    nlinarith [mul_le_mul_of_nonneg_right hbal hy.le]
  · change cexp (2 * π * I * z₀) ≠ 1
    intro hw
    obtain ⟨n, hn⟩ := Complex.exp_eq_one_iff.mp hw
    have h2 : (2 * π * I : ℂ) ≠ 0 := by
      exact mul_ne_zero (mul_ne_zero two_ne_zero
        (Complex.ofReal_ne_zero.mpr Real.pi_ne_zero)) I_ne_zero
    have hz₀n : z₀ = (n : ℂ) := by
      rw [mul_comm (2 * π * I : ℂ) z₀] at hn
      exact mul_right_cancel₀ h2 hn
    have him := congrArg Complex.im hz₀n
    have hre := congrArg Complex.re hz₀n
    simp [z₀] at him hre
    have ha₀ : a₀ = 0 := him.resolve_right hy.ne'
    have ha : a = (q : ℝ) := by
      change a - (q : ℝ) = 0 at ha₀
      linarith
    have hb : b = (n : ℝ) := by simpa [ha₀] using hre
    exact hab ⟨q, n, ha, hb⟩

/-- Global nonvanishing with no rational-coordinate restriction. -/
theorem jacobiTheta₂_shift_ne_zero_of_not_lattice (τ : _root_.UpperHalfPlane)
    (z : _root_.Complex) (hz : ¬ ∃ m n : _root_.Int, z = (m : ℂ) * (τ : ℂ) + (n : ℂ)) :
    _root_.jacobiTheta₂ (z + ((τ : ℂ) + 1) / 2) (τ : ℂ) ≠ 0 := by
  let a : ℝ := z.im / (τ : ℂ).im
  let b : ℝ := z.re - a * (τ : ℂ).re
  have heq : (a : ℂ) * (τ : ℂ) + (b : ℂ) = z := by
    apply Complex.ext
    · simp [b]
    · simp [a]
      exact div_mul_cancel₀ z.im τ.im_pos.ne'
  have hgood : ¬ IntegralPair a b := by
    rintro ⟨m, n, ha, hb⟩
    apply hz
    refine ⟨m, n, ?_⟩
    rw [← heq, ha, hb]
    simp
  obtain ⟨γ, hγ⟩ := exists_smul_mem_fd τ
  have h := (nonvanishing_smul_iff γ τ).mp (nonvanishing_of_mem_fd hγ) a b hgood
  simpa [thetaReal, heq] using h

/-- The global shifted zero set of the actual two-variable Jacobi theta function. -/
theorem jacobiTheta₂_shift_eq_zero_iff (τ : _root_.UpperHalfPlane) (z : _root_.Complex) :
    _root_.jacobiTheta₂ (z + ((τ : ℂ) + 1) / 2) (τ : ℂ) = 0 ↔
      ∃ m n : _root_.Int, z = (m : ℂ) * (τ : ℂ) + (n : ℂ) := by
  constructor
  · intro h
    by_contra hz
    exact jacobiTheta₂_shift_ne_zero_of_not_lattice τ z hz h
  · exact jacobiTheta₂_shift_eq_zero_of_lattice τ z

/-! ## The actual derivative at the shifted origin -/

/-- At the shifted origin the paired derivative terms are the relative terms times `2πi`. -/
theorem derivative_pair_identity (τ : _root_.Complex) (j : _root_.Nat) :
    _root_.jacobiTheta₂'_term (j : ℤ) ((τ + 1) / 2) τ +
        _root_.jacobiTheta₂'_term (-((j : ℤ) + 1)) ((τ + 1) / 2) τ =
      (2 * π * I) * AllLevelTheta.g 0 τ j := by
  let A : ℂ := cexp (π * I * (j : ℂ)) * cexp (π * I * ((j : ℂ) * (j + 1)) * τ)
  have h1 : jacobiTheta₂_term (j : ℤ) ((τ + 1) / 2) τ = A := by
    unfold jacobiTheta₂_term A
    rw [show 2 * (π : ℂ) * I * ((j : ℤ) : ℂ) * ((τ + 1) / 2) +
        π * I * ((j : ℤ) : ℂ) ^ 2 * τ =
        π * I * (j : ℂ) + π * I * ((j : ℂ) * (j + 1)) * τ by push_cast; ring,
      Complex.exp_add]
  have hp := AllLevelTheta.pair_identity (0 : ℂ) τ j
  simp only [zero_add, mul_zero, Complex.exp_zero, one_zpow, sub_self, zero_mul] at hp
  have h2 : jacobiTheta₂_term (-((j : ℤ) + 1)) ((τ + 1) / 2) τ = -A := by
    linear_combination hp - h1
  have hg : AllLevelTheta.g 0 τ j = A * (2 * (j : ℂ) + 1) := by
    simp [AllLevelTheta.g, A]
  rw [jacobiTheta₂'_term, jacobiTheta₂'_term, h1, h2, hg]
  push_cast
  ring

/-- Pairing the convergent actual derivative series. -/
theorem hasSum_derivative_relative {τ : _root_.Complex} (hτ : 0 < τ.im) :
    HasSum (fun j : ℕ => (2 * π * I) * AllLevelTheta.g 0 τ j)
      (_root_.jacobiTheta₂' ((τ + 1) / 2) τ) := by
  have h := (hasSum_jacobiTheta₂'_term ((τ + 1) / 2) hτ).nat_add_neg_add_one
  refine h.congr_fun ?_
  intro j
  exact (derivative_pair_identity τ j).symm

/-- The derivative is nonzero throughout the height region containing the fundamental domain. -/
theorem jacobiTheta₂'_half_shift_ne_zero_of_height {τ : _root_.Complex} (hτ : 0 < τ.im)
    (h3 : 3 ≤ 4 * τ.im ^ 2) :
    _root_.jacobiTheta₂' ((τ + 1) / 2) τ ≠ 0 := by
  have hc : (2 * π * I : ℂ) ≠ 0 :=
    mul_ne_zero (mul_ne_zero two_ne_zero (Complex.ofReal_ne_zero.mpr Real.pi_ne_zero)) I_ne_zero
  have hS : HasSum (AllLevelTheta.g 0 τ)
      (jacobiTheta₂' ((τ + 1) / 2) τ / (2 * π * I)) := by
    refine ((hasSum_derivative_relative hτ).div_const (2 * π * I)).congr_fun ?_
    intro j
    exact (mul_div_cancel_left₀ _ hc).symm
  set X := Real.pi * τ.im with hX
  have hX5 : 5 / 2 < X := ThetaFive.five_halves_lt_pi_mul_im hτ h3
  set ρ := Real.exp (-π * τ.im) with hρ
  have hρ0 : 0 ≤ ρ := (Real.exp_pos _).le
  have hρu : ρ ≤ Real.exp (-1) * Real.exp (-1) := by
    rw [hρ, ← Real.exp_add, Real.exp_le_exp]
    nlinarith
  have hu := ThetaFive.exp_neg_one_lt
  have hu0 : 0 < Real.exp (-1) := Real.exp_pos _
  have hρ1 : ρ < 1 := by nlinarith
  have hM := AllLevelTheta.hasSum_majorant hρ0 hρ1
  have hz : |(0 : ℂ).im| ≤ τ.im / 2 := by simp; linarith
  have key := AllLevelTheta.norm_tsum_sub_finset_le' hS.summable hM.summable {0}
    (fun j _ => AllLevelTheta.norm_g_le hτ hz j)
  rw [hS.tsum_eq, hM.tsum_eq] at key
  simp only [Finset.sum_singleton, AllLevelTheta.g_zero, Nat.cast_zero, mul_zero, zero_add,
    pow_zero, mul_one] at key
  have hlt : 2 * (ρ / (1 - ρ) ^ 2) + (1 - ρ)⁻¹ - 1 < 1 := by
    have h1ρ : 0 < 1 - ρ := by linarith
    have hρ14 : ρ < 0.14 := by nlinarith
    rw [show 2 * (ρ / (1 - ρ) ^ 2) + (1 - ρ)⁻¹ - 1 =
        (2 * ρ + (1 - ρ) - (1 - ρ) ^ 2) / (1 - ρ) ^ 2 by field_simp]
    rw [div_lt_one (by positivity)]
    nlinarith
  intro h0
  rw [h0, zero_div, zero_sub, norm_neg, norm_one] at key
  linarith

/-- The derivative has the same transformation under `τ ↦ τ + 1` as the theta function. -/
theorem jacobiTheta₂'_add_one_right (z τ : _root_.Complex) :
    _root_.jacobiTheta₂' z (τ + 1) = _root_.jacobiTheta₂' (z + 1 / 2) τ := by
  unfold jacobiTheta₂'
  refine tsum_congr fun n => ?_
  obtain ⟨m, hm⟩ := Int.even_mul_pred_self n
  have hm' : ((n : ℂ) * ((n : ℂ) - 1)) = (m : ℂ) + m := by exact_mod_cast hm
  have h : 2 * (π : ℂ) * I * n * z + π * I * n ^ 2 * (τ + 1) =
      (2 * π * I * n * (z + 1 / 2) + π * I * n ^ 2 * τ) + m * (2 * π * I) := by
    linear_combination (π * I) * hm'
  simp only [jacobiTheta₂'_term, jacobiTheta₂_term]
  rw [h, Complex.exp_add, Complex.exp_int_mul_two_pi_mul_I, mul_one]

theorem theta_zero_sub_tau {z τ : _root_.Complex} (hz : _root_.jacobiTheta₂ z τ = 0) :
    _root_.jacobiTheta₂ (z - τ) τ = 0 := by
  have h := jacobiTheta₂_add_left' (z - τ) τ
  rw [sub_add_cancel, hz] at h
  exact (mul_eq_zero.mp h.symm).resolve_left (Complex.exp_ne_zero _)

/-- A nonzero exponential quasi-period preserves the derivative at a zero. -/
theorem derivative_ne_zero_sub_tau_iff {z τ : _root_.Complex}
    (hz : _root_.jacobiTheta₂ z τ = 0) :
    _root_.jacobiTheta₂' (z - τ) τ ≠ 0 ↔ _root_.jacobiTheta₂' z τ ≠ 0 := by
  have hz' := theta_zero_sub_tau hz
  have h := jacobiTheta₂'_add_left' (z - τ) τ
  rw [sub_add_cancel, hz', mul_zero, sub_zero] at h
  constructor
  · intro hn
    rw [h]
    exact mul_ne_zero (Complex.exp_ne_zero _) hn
  · intro hn h0
    apply hn
    rw [h, h0, mul_zero]

/-- Simplicity of the actual shifted theta zero at a fixed modulus. -/
def SimpleAt (τ : _root_.UpperHalfPlane) : Prop :=
  _root_.jacobiTheta₂' (((τ : ℂ) + 1) / 2) (τ : ℂ) ≠ 0

theorem simpleAt_T_iff (τ : _root_.UpperHalfPlane) : SimpleAt (T • τ) ↔ SimpleAt τ := by
  unfold SimpleAt
  rw [ThetaFive.coe_T_smul, jacobiTheta₂'_add_one_right,
    show ((τ : ℂ) + 1 + 1) / 2 + 1 / 2 = ((τ : ℂ) + 1) / 2 + 1 by ring,
    jacobiTheta₂'_add_left]

theorem simpleAt_S_iff (τ : _root_.UpperHalfPlane) : SimpleAt (S • τ) ↔ SimpleAt τ := by
  unfold SimpleAt
  rw [ThetaFive.coe_S_smul]
  have hτ : (τ : ℂ) ≠ 0 := τ.ne_zero
  have hτ' : 0 < (-1 / (τ : ℂ)).im := by
    rw [← ThetaFive.coe_S_smul τ]
    exact (S • τ).im_pos
  have hc : (1 : ℂ) / (-I * (τ : ℂ)) ^ (1 / 2 : ℂ) ≠ 0 := by
    refine one_div_ne_zero ?_
    rw [Ne, Complex.cpow_eq_zero_iff]
    exact fun h => mul_ne_zero (neg_ne_zero.mpr I_ne_zero) hτ h.1
  have heq : (((τ : ℂ) + 1) / 2) / (τ : ℂ) =
      ((-1 / (τ : ℂ)) + 1) / 2 - (-1 / (τ : ℂ)) := by
    field_simp
    ring
  have hz := jacobiTheta₂_half_shift_eq_zero hτ'
  have hz' := theta_zero_sub_tau hz
  have hi := derivative_ne_zero_sub_tau_iff hz
  symm
  rw [jacobiTheta₂'_functional_equation (((τ : ℂ) + 1) / 2) (τ : ℂ),
    heq, hz', mul_zero, sub_zero]
  constructor
  · intro h
    apply hi.mp
    intro h0
    apply h
    rw [h0, mul_zero]
  · intro h
    exact mul_ne_zero (div_ne_zero (mul_ne_zero hc (Complex.exp_ne_zero _)) hτ) (hi.mpr h)

theorem simpleAt_smul_iff (γ : SL(2, ℤ)) (τ : _root_.UpperHalfPlane) :
    SimpleAt (γ • τ) ↔ SimpleAt τ := by
  have hg : γ ∈ Subgroup.closure ({S, T} : Set SL(2, ℤ)) := by
    rw [SpecialLinearGroup.SL2Z_generators]
    exact Subgroup.mem_top γ
  induction hg using Subgroup.closure_induction generalizing τ with
  | mem x hx =>
    rcases hx with rfl | rfl
    · exact simpleAt_S_iff τ
    · exact simpleAt_T_iff τ
  | one => rw [one_smul]
  | mul x y _ _ hx hy =>
    rw [mul_smul]
    exact (hx (y • τ)).trans (hy τ)
  | inv x _ hx =>
    have h := hx (x⁻¹ • τ)
    rw [smul_inv_smul] at h
    exact h.symm

/-- The actual shifted theta zero is simple for every upper-half-plane modulus. -/
theorem jacobiTheta₂'_half_shift_ne_zero (τ : _root_.UpperHalfPlane) :
    _root_.jacobiTheta₂' (((τ : ℂ) + 1) / 2) (τ : ℂ) ≠ 0 := by
  obtain ⟨γ, hγ⟩ := exists_smul_mem_fd τ
  apply (simpleAt_smul_iff γ τ).mp
  exact jacobiTheta₂'_half_shift_ne_zero_of_height (γ • τ).im_pos
    (three_le_four_mul_im_sq_of_mem_fd hγ)

end ZInQ.Contrib.HeckePrimeRationality.AllLevelThetaZeroSet
