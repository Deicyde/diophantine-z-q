open UpperHalfPlane CongruenceSubgroup Matrix.SpecialLinearGroup
open scoped BigOperators MatrixGroups Matrix ModularForm
open ZInQ.Contrib.HeckePrimeRationality

/-- Literal coprime-prime trace of the actual Good upper generator. -/
example (p N : ℕ) [Fact p.Prime] (hN : 3 ≤ N) (hcop : Nat.Coprime p N)
    (a b c d : ℤ) (hP : AllLevelForms.Good (p * N) (a,b)) (hQ : AllLevelForms.Good (p * N) (c,d)) :
    DivisionEisensteinLevelMaps.normalizedTrace N (p * N)
      (Nat.mul_pos (Fact.out : p.Prime).pos (by omega))
      (AllLevelProducts.productForm (p * N) (Nat.mul_pos (Fact.out : p.Prime).pos (by omega)) 2
        ![(a,b),(c,d)] (by intro i; fin_cases i <;> assumption)) ∈
      TorsionQuadraticGenerators.productSpan N (by omega) :=
  CoprimeProductTrace.principal_product_trace_coprime_mem p N hN hcop a b c d hP hQ

/-- Literal all-divisible-level trace of an arbitrary actual upper product-span member. -/
example (N M : ℕ) (hN : 3 ≤ N) (hM : 0 < M) (hNM : N ∣ M)
    (f : _root_.ModularForm ((CongruenceSubgroup.Gamma M).map (mapGL ℝ)) 2)
    (hf : f ∈ TorsionQuadraticGenerators.productSpan M hM) :
    DivisionEisensteinLevelMaps.normalizedTrace N M hM f ∈
      TorsionQuadraticGenerators.productSpan N (by omega) :=
  AllLevelPrincipalProductTrace.trace_productSpan_all hN hM hNM hf

/-- Literal invariant descent constructs a lower Good degree-two product-span member. -/
example (N M : ℕ) (hN : 3 ≤ N) (hM : 0 < M) (hNM : N ∣ M)
    (f : _root_.ModularForm ((CongruenceSubgroup.Gamma M).map (mapGL ℝ)) 2)
    (hf : f ∈ TorsionQuadraticGenerators.productSpan M hM)
    (hinv : ∀ γ ∈ (CongruenceSubgroup.Gamma N).map (mapGL ℝ), ⇑f ∣[(2 : ℤ)] γ = ⇑f) :
    ∃ g : _root_.ModularForm ((CongruenceSubgroup.Gamma N).map (mapGL ℝ)) 2,
      g ∈ TorsionQuadraticGenerators.productSpan N (by omega) ∧
        DivisionEisensteinLevelMaps.restriction N M hNM g = f :=
  AllLevelPrincipalProductTrace.invariant_product_descent M N hN hM hNM f hf hinv

/-- The concrete composite-level generator retains every genuine Good hypothesis. -/
example (v : Fin 2 → ℤ × ℤ) (hv : ∀ i, AllLevelForms.Good 9 (v i)) :
    DivisionEisensteinLevelMaps.normalizedTrace 3 9 (by omega)
      (AllLevelProducts.productForm 9 (by omega) 2 v hv) ∈
        TorsionQuadraticGenerators.productSpan 3 (by omega) :=
  AllLevelPrincipalProductTrace.trace_productForm_all (by omega) (by omega) (by omega) v hv

