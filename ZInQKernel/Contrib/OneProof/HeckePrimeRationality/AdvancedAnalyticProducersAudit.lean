/-! Literal actual primitive Eisenstein modular-form and same-level product-span audit. -/

noncomputable section
set_option autoImplicit false
set_option pp.fullNames true
set_option pp.proofs false
attribute [local instance] Classical.propDecidable

open Complex Filter Set ModularForm
open scoped Topology Real UpperHalfPlane MatrixGroups

namespace ActualPrimitiveEisensteinAudit

open ZInQ.Contrib.HeckePrimeRationality
open PrimitiveEisensteinGcdData PrimitiveEisensteinNormalization PrimitiveEisensteinUnitSeries
open PrimitiveEisensteinCongruenceSeries PrimitiveEisensteinSeriesMembership

/-- No primitive, coefficient, inverse or generation hypothesis survives the actual root endpoint. -/
theorem literal_all_levels_actual_primitive_span (N : _root_.Nat) (hN : 3 ≤ N) (k : _root_.Nat)
    (hk : 3 ≤ k) (a : _root_.Fin 2 → _root_.ZMod N) :
    let _ : NeZero N := ⟨by omega⟩
    _root_.ModularForm.eisensteinSeriesMF (N := N)
      (by exact_mod_cast hk : (3 : _root_.Int) ≤ k) a ∈
      _root_.Submodule.span _root_.Complex
        {f : _root_.ModularForm
          ((_root_.CongruenceSubgroup.Gamma N).map (_root_.Matrix.SpecialLinearGroup.mapGL _root_.Real)) (k : _root_.Int) |
          ∃ v : _root_.Fin k → _root_.Int × _root_.Int,
            ∃ hv : ∀ i, AllLevelForms.Good N (v i),
              f = AllLevelProducts.productForm N (by omega) k v hv} := by
  let _ : NeZero N := ⟨by omega⟩
  exact actual_primitive_eisensteinSeriesMF_mem N hN k hk a

theorem literal_actual_gamma_binding {N : _root_.Nat} [NeZero N] (k : _root_.Nat) (hk : 3 ≤ k)
    (a : Fin 2 → ZMod N) (τ : _root_.UpperHalfPlane) :
    _root_.ModularForm.eisensteinSeriesMF (N := N) (by exact_mod_cast hk : (3 : _root_.Int) ≤ k) a τ =
      ∑' v : _root_.EisensteinSeries.gammaSet N 1 a,
        _root_.EisensteinSeries.eisSummand (k : _root_.Int) v.1 τ := rfl

theorem literal_constant_finite_coefficients (N : _root_.Nat) [NeZero N] (hN : 3 ≤ N)
    (k : _root_.Nat) (hk : 3 ≤ k) :
    ∃ C : _root_.Matrix (PrimitiveRow N) (PrimitiveRow N) _root_.Complex,
      ∀ (τ : _root_.UpperHalfPlane) (a : PrimitiveRow N),
        _root_.eisensteinSeries a.1 (k : _root_.Int) τ =
          ∑ b : PrimitiveRow N, C a b * rawCongruenceForm N hN k hk b.1 τ :=
  ⟨primitiveInverseCoefficients N k, fun τ a => actual_primitive_finite_combination N hN k hk a τ⟩

theorem literal_raw_normalization (N : _root_.Nat) (hN : 3 ≤ N) (k : _root_.Nat) (hk : 3 ≤ k)
    (a : Fin 2 → ZMod N) :
    rawCongruenceForm N hN k hk a = ((N : _root_.Complex)^k)⁻¹ •
      AllWeightPrincipalEisensteinForms.principalEisensteinForm N hN k hk
        (PrimitiveEisensteinGrid.residueLift a 0) (PrimitiveEisensteinGrid.residueLift a 1) := rfl

theorem literal_nonprimitive_zero (N : _root_.Nat) [NeZero N] (k : _root_.Nat) (hk : 3 ≤ k)
    (a : Fin 2 → ZMod N) (ha : ¬ IsCoprime (a 0) (a 1)) :
    _root_.ModularForm.eisensteinSeriesMF (N := N) (by exact_mod_cast hk : (3 : _root_.Int) ≤ k) a = 0 :=
  eisensteinSeriesMF_eq_zero_nonprimitive (by exact_mod_cast hk) a ha

theorem literal_level_six_primitive_row (k : _root_.Nat) (hk : 3 ≤ k) :
    _root_.ModularForm.eisensteinSeriesMF (N := 6) (by exact_mod_cast hk : (3 : _root_.Int) ≤ k) ![2,3] ∈
      TorsionInvariantForms.homogeneousProductSpan 6 (by omega) k :=
  actual_primitive_eisensteinSeriesMF_mem 6 (by omega) k hk ![2,3]

theorem literal_level_six_nonprimitive_row (k : _root_.Nat) (hk : 3 ≤ k) :
    _root_.ModularForm.eisensteinSeriesMF (N := 6) (by exact_mod_cast hk : (3 : _root_.Int) ≤ k) ![2,4] = 0 := by
  apply eisensteinSeriesMF_eq_zero_nonprimitive
  change ¬ IsCoprime (2 : ZMod 6) 4
  intro h
  have hu := h.isUnit_of_dvd' (dvd_refl (2 : ZMod 6)) (show (2 : ZMod 6) ∣ 4 from ⟨2, by norm_num⟩)
  have hc := (ZMod.isUnit_iff_coprime 2 6).mp hu
  norm_num [Nat.Coprime] at hc

theorem literal_actual_unit_inverse (N : _root_.Nat) [NeZero N] (k : _root_.Nat) (hk : 3 ≤ k) :
    _root_.IsUnit (FiniteUnitConvolution.unitConvolutionMatrix k (unitPermutation N) (fun d => d.Coprime N)) :=
  FiniteUnitConvolution.unitConvolution_isUnit k hk (unitPermutation N) (fun d => d.Coprime N)

theorem literal_actual_raw_convolution (N : _root_.Nat) [NeZero N] (hN : 3 ≤ N)
    (k : _root_.Nat) (hk : 3 ≤ k) (τ : _root_.UpperHalfPlane) :
    (fun a : PrimitiveRow N => rawCongruenceForm N hN k hk a.1 τ) =
      (FiniteUnitConvolution.unitConvolutionMatrix k (unitPermutation N) (fun d => d.Coprime N)).mulVec
        (primitiveValues N k τ) := raw_values_eq_convolution N hN k hk τ

theorem literal_same_level_combination (N : _root_.Nat) [NeZero N] (hN : 3 ≤ N)
    (k : _root_.Nat) (hk : 3 ≤ k) (a : PrimitiveRow N) :
    _root_.ModularForm.eisensteinSeriesMF (N := N) (by exact_mod_cast hk : (3 : _root_.Int) ≤ k) a.1 =
      ∑ b : PrimitiveRow N, primitiveInverseCoefficients N k a b • rawCongruenceForm N hN k hk b.1 :=
  eisensteinSeriesMF_eq_primitiveCombination N hN k hk a

end ActualPrimitiveEisensteinAudit

