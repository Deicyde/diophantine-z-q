import ZInQKernel.Contrib.OneProof.HeckePrimeRationality.PrimitivePeterssonHyperbolicSeed
import ZInQKernel.Contrib.TauCeti.MeasureTheory.Group.FundamentalDomain

/-!
# The actual parabolic strip fundamental domain

The positive strip of width N is a genuine measurable fundamental domain for
the subgroup generated by T^N. Its translates are disjoint, its covering is
proved by Euclidean floor, and the actual principal-cusp seed has zero integral
over every fundamental domain of this subgroup.
-/

noncomputable section
set_option autoImplicit false
open MeasureTheory Set UpperHalfPlane Complex Matrix.SpecialLinearGroup
open scoped Topology MatrixGroups ModularForm Pointwise ComplexConjugate

namespace ZInQ.Contrib.HeckePrimeRationality.PrimitivePetersson

/-- The actual width-N unipotent subgroup, without adjoining the centre. -/
def translationGroup (N : ℕ) : Subgroup SL(2, ℤ) := Subgroup.zpowers (ModularGroup.T ^ N)

lemma translation_power (N : ℕ) (n : ℤ) :
    (ModularGroup.T ^ N)^n = ModularGroup.T ^ ((N : ℤ)*n) := by
  rw [zpow_mul,zpow_natCast]

lemma translationGroup_le_principal (N : ℕ) : translationGroup N ≤ CongruenceSubgroup.Gamma N := by
  rw [translationGroup,Subgroup.zpowers_le]
  have hT : ModularGroup.T ^ (N : ℤ) ∈ CongruenceSubgroup.Gamma N := by
    simp only [CongruenceSubgroup.Gamma_mem,ModularGroup.coe_T_zpow]
    simp
  simpa only [zpow_natCast] using hT

/-- The half-open strip used for exact disjointness of translates. -/
def halfOpenStrip (N : ℕ) : Set ℍ := {τ | τ.re ∈ Ico 0 (N : ℝ)}

lemma halfOpenStrip_measurable (N : ℕ) : MeasurableSet (halfOpenStrip N) :=
  measurableSet_Ico.preimage (by fun_prop : Measurable UpperHalfPlane.re)

lemma halfOpenStrip_disjoint (N : ℕ) (hN : 0 < N)
    {g j : translationGroup N} (hne : g ≠ j) :
    Disjoint (g • halfOpenStrip N) (j • halfOpenStrip N) := by
  obtain ⟨n,hn⟩ := (Subgroup.mem_zpowers_iff).mp g.2
  obtain ⟨m,hm⟩ := (Subgroup.mem_zpowers_iff).mp j.2
  have hNr : (0 : ℝ) < N := by exact_mod_cast hN
  rw [Set.disjoint_left]
  rintro τ ⟨x,hx,hgx⟩ ⟨y,hy,hjy⟩
  have he : x.re+(N : ℝ)*n = y.re+(N : ℝ)*m := by
    have he := congrArg UpperHalfPlane.re (hgx.trans hjy.symm)
    simpa only [Subgroup.smul_def,← hn,← hm,translation_power,ModularGroup.re_T_zpow_smul,
      Int.cast_mul,Int.cast_natCast] using he
  change 0 ≤ x.re ∧ x.re < (N : ℝ) at hx
  change 0 ≤ y.re ∧ y.re < (N : ℝ) at hy
  have hnm : n = m := by
    rcases lt_trichotomy n m with h | h | h
    · have hr : (n : ℝ)+1 ≤ m := by exact_mod_cast (Int.add_one_le_iff.mpr h)
      have hb := mul_le_mul_of_nonneg_left hr hNr.le
      nlinarith
    · exact h
    · have hr : (m : ℝ)+1 ≤ n := by exact_mod_cast (Int.add_one_le_iff.mpr h)
      have hb := mul_le_mul_of_nonneg_left hr hNr.le
      nlinarith
  apply hne
  apply Subtype.ext
  rw [← hn,← hm,hnm]

/-- The strip genuinely covers every upper-half-plane point under T^N powers. -/
lemma halfOpenStrip_covers (N : ℕ) (hN : 0 < N) (τ : ℍ) :
    ∃ g : translationGroup N, g • τ ∈ halfOpenStrip N := by
  let n : ℤ := -Int.floor (τ.re/(N : ℝ))
  refine ⟨⟨(ModularGroup.T ^ N)^n,Subgroup.mem_zpowers_iff.mpr ⟨n,rfl⟩⟩,?_⟩
  have hNr : (0 : ℝ) < N := by exact_mod_cast hN
  change ((ModularGroup.T ^ N)^n • τ).re ∈ Ico 0 (N : ℝ)
  rw [translation_power,ModularGroup.re_T_zpow_smul]
  have he : τ.re + (((N : ℤ)*n : ℤ) : ℝ) = τ.re-Int.floor (τ.re/(N : ℝ))*(N : ℝ) := by
    simp only [n,Int.cast_mul,Int.cast_neg,Int.cast_natCast]
    ring
  rw [he]
  exact ⟨Int.sub_floor_div_mul_nonneg τ.re hNr,Int.sub_floor_div_mul_lt τ.re hNr⟩

/-- Genuine measurable fundamental domain for the actual unipotent subgroup. -/
theorem halfOpenStrip_fundamental (N : ℕ) (hN : 0 < N) :
    IsFundamentalDomain (translationGroup N) (halfOpenStrip N) (volume : Measure ℍ) := by
  refine ⟨(halfOpenStrip_measurable N).nullMeasurableSet,
    Filter.Eventually.of_forall (halfOpenStrip_covers N hN),?_⟩
  intro g j hne
  exact (halfOpenStrip_disjoint N hN hne).aedisjoint

lemma principal_period (N : ℕ) :
    (N : ℝ) ∈ ((CongruenceSubgroup.Gamma N).map (mapGL ℝ)).strictPeriods := by
  simp only [CongruenceSubgroup.strictPeriods_Gamma]
  exact AddSubgroup.mem_zmultiples_iff.mpr ⟨1,by simp⟩

/-- The actual cusp seed is invariant under T^N, not under arbitrary SL₂ matrices. -/
theorem hyperSeed_translation_invariant (N k : ℕ)
    (f : CuspForm ((CongruenceSubgroup.Gamma N).map (mapGL ℝ)) (k : ℤ))
    (g : translationGroup N) (τ : ℍ) : hyperSeed k f (g • τ) = hyperSeed k f τ := by
  obtain ⟨n,hn⟩ := Subgroup.mem_zpowers_iff.mp g.2
  have hp : (N : ℝ)*n ∈ ((CongruenceSubgroup.Gamma N).map (mapGL ℝ)).strictPeriods := by
    simp only [CongruenceSubgroup.strictPeriods_Gamma]
    exact AddSubgroup.mem_zmultiples_iff.mpr ⟨n,by simp [mul_comm]⟩
  have hv := SlashInvariantForm.vAdd_apply_of_mem_strictPeriods f τ hp
  change hyperSeed k f ((g : SL(2, ℤ)) • τ) = hyperSeed k f τ
  rw [← hn,translation_power,UpperHalfPlane.modular_T_zpow_smul]
  simp only [Int.cast_mul,Int.cast_natCast,hyperSeed,hv,UpperHalfPlane.vadd_im]

/-- The half-open strip carries the same genuine zero seed integral as the
closed strip, since their difference lies on a null vertical line. -/
theorem hyperSeed_halfOpenStrip_zero (N : ℕ) [NeZero N] (k : ℕ) (hk : 3 ≤ k)
    (f : CuspForm ((CongruenceSubgroup.Gamma N).map (mapGL ℝ)) (k : ℤ)) :
    IntegrableOn (hyperSeed k f) (halfOpenStrip N) volume ∧
      (∫ τ in halfOpenStrip N, hyperSeed k f τ) = 0 := by
  have hNr : (0 : ℝ) < N := by exact_mod_cast NeZero.pos N
  have he : (halfOpenStrip N) =ᶠ[MeasureTheory.ae (volume : Measure ℍ)] strip (N : ℝ) := by
    have ha : ∀ᵐ τ : ℍ ∂volume, τ.re ≠ (N : ℝ) := by
      rw [MeasureTheory.ae_iff]
      simp only [not_not]
      change volume (UpperHalfPlane.coe ⁻¹' {z : ℂ | z.re = (N : ℝ)}) = 0
      exact UpperHalfPlane.volume_preimage_coe_null (Complex.volume_setOf_re_eq (N : ℝ))
    filter_upwards [ha] with τ hne
    simp only [halfOpenStrip,strip,mem_setOf_eq,mem_Ico,mem_Icc]
    exact propext (and_congr_right fun _ => lt_iff_le_and_ne.trans (and_iff_left hne))
  refine ⟨(hyperSeed_integrable_strip k hk f (N : ℝ) hNr (principal_period N)).congr_set_ae he,?_⟩
  rw [setIntegral_congr_set he]
  exact hyperSeed_strip_integral_zero k hk f (N : ℝ) hNr (principal_period N)

/-- Any actual parabolic fundamental domain gives zero; analytic
integrability and zero constant term have both been independently produced. -/
theorem hyperSeed_parabolic_domain_zero (N : ℕ) [NeZero N] (k : ℕ) (hk : 3 ≤ k)
    (f : CuspForm ((CongruenceSubgroup.Gamma N).map (mapGL ℝ)) (k : ℤ))
    (D : Set ℍ) (hD : IsFundamentalDomain (translationGroup N) D volume) :
    IntegrableOn (hyperSeed k f) D volume ∧ (∫ τ in D, hyperSeed k f τ) = 0 := by
  have hs := halfOpenStrip_fundamental N (NeZero.pos N)
  have hi := hyperSeed_halfOpenStrip_zero N k hk f
  refine ⟨(hD.integrableOn_iff hs (hyperSeed_translation_invariant N k f)).mpr hi.1,?_⟩
  rw [hD.setIntegral_eq hs (hyperSeed_translation_invariant N k f)]
  exact hi.2

end ZInQ.Contrib.HeckePrimeRationality.PrimitivePetersson
