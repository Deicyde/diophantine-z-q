import ZInQKernel.Contrib.OneProof.HeckePrimeRationality.AllWeightPrincipalEisensteinForms
import ZInQKernel.Contrib.OneProof.HeckePrimeRationality.DivisionEisensteinTracePartial

/-!
# Variable-weight maps for genuine principal congruence series

Restriction and normalized finite trace carry the actual weight k. The series
span is generated by independently constructed congruence-series forms, with
bad even classes retaining the actual lattice value.
-/

noncomputable section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency.types false
open UpperHalfPlane CongruenceSubgroup Matrix.SpecialLinearGroup
open scoped BigOperators MatrixGroups ModularForm

namespace ZInQ.Contrib.HeckePrimeRationality.AllWeightSeriesTrace
open AllWeightPrincipalEisensteinForms
open DivisionEisensteinLevelMaps (principal_group_le traceIndex traceIndex_ne_zero)

set_option quotPrecheck false in
local notation "ΓP" N => (CongruenceSubgroup.Gamma N).map (mapGL ℝ)

def restrictionK (N M k : ℕ) (hNM : N ∣ M) :
    _root_.ModularForm (ΓP N) (k : ℤ) →ₗ[ℂ] _root_.ModularForm (ΓP M) (k : ℤ) :=
  _root_.ModularForm.restrictₗ (k : ℤ) ℂ (principal_group_le hNM)

theorem restrictionK_apply (N M k : ℕ) (hNM : N ∣ M)
    (f : _root_.ModularForm (ΓP N) (k : ℤ)) (τ : ℍ) : restrictionK N M k hNM f τ = f τ := rfl

theorem restrictionK_injective (N M k : ℕ) (hNM : N ∣ M) : Function.Injective (restrictionK N M k hNM) :=
  _root_.ModularForm.restrict_injective (principal_group_le hNM)

def normalizedTraceK (N M k : ℕ) (hM : 0 < M) :
    _root_.ModularForm (ΓP M) (k : ℤ) →ₗ[ℂ] _root_.ModularForm (ΓP N) (k : ℤ) := by
  let : NeZero M := ⟨hM.ne'⟩
  exact ((traceIndex N M : ℂ)⁻¹) • _root_.ModularForm.traceₗ (ΓP N)

theorem normalizedTraceK_apply (N M k : ℕ) [NeZero M] (hM : 0 < M)
    (f : _root_.ModularForm (ΓP M) (k : ℤ)) :
    normalizedTraceK N M k hM f = ((traceIndex N M : ℂ)⁻¹) • _root_.ModularForm.trace (ΓP N) f := by
  let : NeZero M := ⟨hM.ne'⟩
  rfl

theorem normalizedTraceK_restriction {N M k : ℕ} (hM : 0 < M) (hNM : N ∣ M)
    (f : _root_.ModularForm (ΓP N) (k : ℤ)) :
    normalizedTraceK N M k hM (restrictionK N M k hNM f) = f := by
  let : NeZero M := ⟨hM.ne'⟩
  have hidx : (traceIndex N M : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr (traceIndex_ne_zero N M hM)
  change (traceIndex N M : ℂ)⁻¹ • _root_.ModularForm.traceₗ (ΓP N)
    (_root_.ModularForm.restrict (principal_group_le hNM) f) = f
  rw [_root_.ModularForm.traceₗ_restrict]
  change (traceIndex N M : ℂ)⁻¹ • ((traceIndex N M : ℂ) • f) = f
  rw [smul_smul, inv_mul_cancel₀ hidx, one_smul]

theorem restrictionK_trans {N M L k : ℕ} (hNM : N ∣ M) (hML : M ∣ L)
    (f : _root_.ModularForm (ΓP N) (k : ℤ)) :
    restrictionK M L k hML (restrictionK N M k hNM f) = restrictionK N L k (dvd_trans hNM hML) f := by
  apply _root_.ModularForm.ext
  intro τ
  rfl

theorem restrictionK_self (N k : ℕ) (f : _root_.ModularForm (ΓP N) (k : ℤ)) :
    restrictionK N N k (dvd_refl N) f = f := by
  apply _root_.ModularForm.ext
  intro τ
  rfl

def seriesForm (N : ℕ) (h3 : 3 ≤ N) (k : ℕ) (hk : 3 ≤ k) (a : Fin 2 → ℤ) :
    _root_.ModularForm (ΓP N) (k : ℤ) := principalEisensteinForm N h3 k hk (a 0) (a 1)

def seriesSpanK (N : ℕ) (h3 : 3 ≤ N) (k : ℕ) (hk : 3 ≤ k) :
    Submodule ℂ (_root_.ModularForm (ΓP N) (k : ℤ)) :=
  Submodule.span ℂ (Set.range (seriesForm N h3 k hk))

theorem generator_mem_seriesSpanK (N : ℕ) (h3 : 3 ≤ N) (k : ℕ) (hk : 3 ≤ k) (a : Fin 2 → ℤ) :
    seriesForm N h3 k hk a ∈ seriesSpanK N h3 k hk := Submodule.subset_span ⟨a,rfl⟩

def seriesValue (N k : ℕ) (a b : ℤ) (τ : ℍ) : ℂ :=
  (N : ℂ) ^ k * ∑' q : ℤ × ℤ, EisensteinSeries.eisSummand (k : ℤ) ![a+N*q.1,b+N*q.2] τ

theorem seriesForm_apply (N : ℕ) (h3 : 3 ≤ N) (k : ℕ) (hk : 3 ≤ k) (a : Fin 2 → ℤ) (τ : ℍ) :
    seriesForm N h3 k hk a τ = seriesValue N k (a 0) (a 1) τ :=
  principalEisensteinForm_apply_actual N h3 k hk (a 0) (a 1) τ

/-- Homogeneity of the unchanged inverse-power summand, including its zero argument. -/
theorem scaled_summand (t : ℕ) (ht : 0 < t) (k : ℕ) (a b : ℤ) (τ : ℍ) :
    (t : ℂ) ^ k * EisensteinSeries.eisSummand (k : ℤ) ![(t : ℤ)*a,(t : ℤ)*b] τ =
      EisensteinSeries.eisSummand (k : ℤ) ![a,b] τ := by
  have htC : (t : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr ht.ne'
  simp only [EisensteinSeries.eisSummand, Matrix.cons_val_zero, Matrix.cons_val_one,
    Matrix.cons_val_fin_one, _root_.zpow_neg, _root_.zpow_natCast]
  push_cast
  rw [show (t : ℂ)*a*τ+t*b = t*(a*τ+b) by ring, mul_pow, _root_.mul_inv_rev,
    mul_left_comm, mul_inv_cancel₀ (pow_ne_zero k htC), mul_one]

theorem seriesValue_scale (t N k : ℕ) (ht : 0 < t) (a b : ℤ) (τ : ℍ) :
    seriesValue (t*N) k ((t : ℤ)*a) ((t : ℤ)*b) τ = seriesValue N k a b τ := by
  have hs (q : ℤ × ℤ) : (t : ℂ) ^ k * EisensteinSeries.eisSummand (k : ℤ)
      ![(t : ℤ)*a+(t*N : ℕ)*q.1,(t : ℤ)*b+(t*N : ℕ)*q.2] τ =
      EisensteinSeries.eisSummand (k : ℤ) ![a+N*q.1,b+N*q.2] τ := by
    have he : (![(t : ℤ)*a+(t*N : ℕ)*q.1,(t : ℤ)*b+(t*N : ℕ)*q.2] : Fin 2 → ℤ) =
        ![(t : ℤ)*(a+N*q.1),(t : ℤ)*(b+N*q.2)] := by
      ext i; fin_cases i <;> simp only [Matrix.cons_val_zero, Matrix.cons_val_one] <;> push_cast <;> ring
    rw [he]
    exact scaled_summand t ht k _ _ τ
  unfold seriesValue
  rw [Nat.cast_mul, mul_pow, mul_comm ((t : ℂ)^k) ((N : ℂ)^k), mul_assoc,
    ← tsum_mul_left, tsum_congr hs]

theorem restrictionK_generator_mul (N t k : ℕ) (h3 : 3 ≤ N) (ht : 0 < t) (hk : 3 ≤ k)
    (a : Fin 2 → ℤ) :
    restrictionK N (t*N) k (dvd_mul_left N t) (seriesForm N h3 k hk a) =
      seriesForm (t*N) (by nlinarith) k hk (fun i => (t : ℤ)*a i) := by
  apply _root_.ModularForm.ext
  intro τ
  rw [restrictionK_apply, seriesForm_apply, seriesForm_apply, seriesValue_scale t N k ht]

end ZInQ.Contrib.HeckePrimeRationality.AllWeightSeriesTrace
