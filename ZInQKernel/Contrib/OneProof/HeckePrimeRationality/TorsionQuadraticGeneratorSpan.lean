import ZInQKernel.Contrib.OneProof.HeckePrimeRationality.TorsionQuadraticGenerators
import Mathlib.LinearAlgebra.Span.Basic

/-!
# Inclusion in the span of actual degree-two torsion products

The actual x- and μ-forms constructed by finite quadratic Fourier algebra lie
in the span of degree-two principal torsion products at the same level. No
claim about spanning the whole modular-form space is made.
-/

noncomputable section
set_option autoImplicit false
open UpperHalfPlane CongruenceSubgroup Matrix.SpecialLinearGroup
open scoped BigOperators MatrixGroups ModularForm

namespace ZInQ.Contrib.HeckePrimeRationality.TorsionQuadraticGenerators

open TorsionWeierstrassData AllLevelPrincipal AllLevelProducts

set_option quotPrecheck false in
local notation "ΓP" N => (CongruenceSubgroup.Gamma N).map (mapGL ℝ)

/-- The subspace generated by genuine admissible degree-two torsion products. -/
def productSpan (N : ℕ) (hN : 0 < N) : Submodule ℂ (_root_.ModularForm (ΓP N) 2) :=
  Submodule.span ℂ {f | ∃ v : Fin 2 → ℤ × ℤ, ∃ hv : ∀ i, AllLevelForms.Good N (v i),
    f = productForm N hN 2 v hv}

/-- The bad square is zero, matching the actual zero-extended torsion value. -/
theorem lambdaSquare_of_bad (N : ℕ) (hN : 0 < N) (a b : ℤ)
    (hb : (N : ℤ) ∣ a ∧ (N : ℤ) ∣ b) : lambdaSquare N hN a b = 0 := by
  apply _root_.ModularForm.ext
  intro τ
  rw [lambdaSquare_apply]
  simp only [lambdaValue, TorsionDistributionTwo.reg_of_bad hb, mul_zero, zero_pow (by decide : 2 ≠ 0)]
  rfl

/-- Each actual squared weight-one torsion form belongs to this product span. -/
theorem lambdaSquare_mem_productSpan (N : ℕ) (hN : 0 < N) (a b : ℤ) :
    lambdaSquare N hN a b ∈ productSpan N hN := by
  by_cases hg : ¬ ((N : ℤ) ∣ a ∧ (N : ℤ) ∣ b)
  · rw [lambdaSquare_eq_product N hN a b hg]
    apply Submodule.smul_mem
    apply Submodule.subset_span
    exact ⟨fun _ => (a, b), fun _ => hg, rfl⟩
  · rw [lambdaSquare_of_bad N hN a b (not_not.mp hg)]
    exact Submodule.zero_mem _

/-- The constructed actual x-form lies in the genuine degree-two product span. -/
theorem xForm_mem_productSpan (N : ℕ) (hN : 3 ≤ N) (a b : ℤ) :
    xForm N hN a b ∈ productSpan N (by omega) := by
  classical
  unfold xForm
  apply Submodule.smul_mem
  apply Submodule.add_mem
  · exact Submodule.smul_mem _ _ (lambdaSquare_mem_productSpan N (by omega) a b)
  · apply Submodule.sum_mem
    intro Q _
    exact Submodule.smul_mem _ _ (lambdaSquare_mem_productSpan N (by omega) (Q.1 : ℕ) (Q.2 : ℕ))

/-- The constructed actual μ-form belongs to the same genuine product span. -/
theorem muForm_mem_productSpan (N : ℕ) (hN : 3 ≤ N) (a b : ℤ) :
    muForm N hN a b ∈ productSpan N (by omega) := by
  unfold muForm
  apply Submodule.smul_mem
  exact Submodule.sub_mem _ (lambdaSquare_mem_productSpan N (by omega) a b)
    (xForm_mem_productSpan N hN a b)

/-- A simultaneous actual bundle and generator inclusion, with no wanted
modularity or generation statement among the inputs. -/
theorem actual_x_mu_bundles_in_productSpan (N : ℕ) [NeZero N] (hN : 3 ≤ N) (a b : ℤ) :
    ∃ X M : _root_.ModularForm (ΓP N) 2,
      X ∈ productSpan N (by omega) ∧ M ∈ productSpan N (by omega) ∧
      (∀ τ : ℍ, X τ = xValue N a b τ) ∧ (∀ τ : ℍ, M τ = muValue N a b τ) := by
  exact ⟨xForm N hN a b, muForm N hN a b, xForm_mem_productSpan N hN a b,
    muForm_mem_productSpan N hN a b, xForm_apply N hN a b, muForm_apply N hN a b⟩

end ZInQ.Contrib.HeckePrimeRationality.TorsionQuadraticGenerators
