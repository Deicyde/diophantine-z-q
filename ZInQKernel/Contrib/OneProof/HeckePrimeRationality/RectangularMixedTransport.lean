import ZInQKernel.Contrib.OneProof.HeckePrimeRationality.RectangularWeierstrassValues

/-!
# Diagonal transport preserves the actual mixed x-lambda span

The genuine weight-three product x(P) lambda(Q) is transported by the
actual translate/restrict operators. Rectangular x transport contributes
a finite cyclic x correction, while lambda transport contributes its
actual one-dimensional shift sum. Every resulting mixed term is at the
common level nN. The slash determinant normalization is applied at weight
three, not obtained by multiplying lower-weight slash operators.
-/

noncomputable section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency.types false
set_option maxHeartbeats 1600000

open Complex Filter Set ModularForm
open scoped Topology Real UpperHalfPlane MatrixGroups ModularForm

namespace ZInQ.Contrib.HeckePrimeRationality.RectangularMixedTransport

open ZInQ.Contrib.HeckePrimeRationality
open TorsionWeierstrassData RectangularThetaLattice RectangularWeierstrassValues
open ThetaRectangular TorsionRectangularScale TorsionRectangularHomogeneous

/-- The true principal subgroup on which each actual form is defined. -/
abbrev PrincipalGroup (N : ℕ) := (CongruenceSubgroup.Gamma N).map (Matrix.SpecialLinearGroup.mapGL ℝ)

/-- The genuine actual mixed form of weight three, x at P times lambda at Q. -/
def mixedForm (N : ℕ) (hN : 0 < N) (P Q : ℤ × ℤ) : ModularForm (PrincipalGroup N) 3 :=
  ModularForm.mcast (by norm_num) ((WeierstrassForms.xForm N hN P.1 P.2).mul
    (WeierstrassForms.lambdaForm N hN Q.1 Q.2))

lemma mixedForm_apply (N : ℕ) (hN : 0 < N) (P Q : ℤ × ℤ) (τ : ℍ) :
    mixedForm N hN P Q τ = xValue N P.1 P.2 τ * lambdaValue N Q.1 Q.2 τ := by
  change WeierstrassForms.xForm N hN P.1 P.2 τ * WeierstrassForms.lambdaForm N hN Q.1 Q.2 τ = _
  rw [WeierstrassForms.xForm_apply,WeierstrassForms.lambdaForm_apply]

/-- The span is independently generated by actual Good mixed forms, not by wanted transported images. -/
def mixedSpan (N : ℕ) (hN : 0 < N) : Submodule ℂ (ModularForm (PrincipalGroup N) 3) :=
  Submodule.span ℂ {f | ∃ P Q : ℤ × ℤ, ∃ _hP : AllLevelForms.Good N P,
    ∃ _hQ : AllLevelForms.Good N Q, f=mixedForm N hN P Q}

lemma mixedForm_bad_left (N : ℕ) (hN : 0 < N) (P Q : ℤ × ℤ)
    (hP : (N : ℤ) ∣ P.1 ∧ (N : ℤ) ∣ P.2) : mixedForm N hN P Q=0 := by
  apply DFunLike.ext
  intro τ
  change mixedForm N hN P Q τ = 0
  rw [mixedForm_apply,WeierstrassForms.xValue_bad hP,zero_mul]

lemma mixedForm_bad_right (N : ℕ) (hN : 0 < N) (P Q : ℤ × ℤ)
    (hQ : (N : ℤ) ∣ Q.1 ∧ (N : ℤ) ∣ Q.2) : mixedForm N hN P Q=0 := by
  apply DFunLike.ext
  intro τ
  change mixedForm N hN P Q τ = 0
  rw [mixedForm_apply,lambdaValue,TorsionDistributionTwo.reg_of_bad hQ,mul_zero,mul_zero]

/-- All-label mixed forms are in the Good mixed span, with bad factors proved to vanish. -/
lemma mixedForm_mem (N : ℕ) (hN : 0 < N) (P Q : ℤ × ℤ) : mixedForm N hN P Q ∈ mixedSpan N hN := by
  by_cases hP : (N : ℤ) ∣ P.1 ∧ (N : ℤ) ∣ P.2
  · rw [mixedForm_bad_left N hN P Q hP]
    exact Submodule.zero_mem _
  by_cases hQ : (N : ℤ) ∣ Q.1 ∧ (N : ℤ) ∣ Q.2
  · rw [mixedForm_bad_right N hN P Q hQ]
    exact Submodule.zero_mem _
  exact Submodule.subset_span ⟨P,Q,hP,hQ,rfl⟩

/-- Real rectangular shift of an actual label. -/
def realLabel (n N : ℕ) (P : ℤ × ℤ) (b : Fin n) : ℤ × ℤ :=
  ((n : ℤ)*P.1,P.2+(N : ℤ)*(b : ℕ))

/-- Imaginary rectangular shift of an actual label. -/
def imagLabel (n N : ℕ) (P : ℤ × ℤ) (a : Fin n) : ℤ × ℤ :=
  (P.1+(N : ℤ)*(a : ℕ),(n : ℤ)*P.2)

/-- Actual real cyclic correction labels, including their separately zero-extended origin. -/
def realCyclicLabel (n N : ℕ) (b : Fin n) : ℤ × ℤ := (0,(N : ℤ)*(b : ℕ))

/-- Actual imaginary cyclic correction labels. -/
def imagCyclicLabel (n N : ℕ) (a : Fin n) : ℤ × ℤ := ((N : ℤ)*(a : ℕ),0)

/-- The genuine finite mixed-form combination in the real rectangular direction. -/
def realMixedCombination (n N : ℕ) (hn : 0 < n) (hN : 0 < N) (P Q : ℤ × ℤ) :
    ModularForm (PrincipalGroup (n*N)) 3 :=
  (∑ b : Fin n, ∑ c : Fin n, mixedForm (n*N) (Nat.mul_pos hn hN)
    (realLabel n N P b) (realLabel n N Q c)) -
  (∑ b : Fin n, ∑ c : Fin n, mixedForm (n*N) (Nat.mul_pos hn hN)
    (realCyclicLabel n N b) (realLabel n N Q c))

/-- The genuine finite mixed-form combination in the imaginary rectangular direction. -/
def imagMixedCombination (n N : ℕ) (hn : 0 < n) (hN : 0 < N) (P Q : ℤ × ℤ) :
    ModularForm (PrincipalGroup (n*N)) 3 :=
  (∑ a : Fin n, ∑ c : Fin n, mixedForm (n*N) (Nat.mul_pos hn hN)
    (imagLabel n N P a) (imagLabel n N Q c)) -
  (∑ a : Fin n, ∑ c : Fin n, mixedForm (n*N) (Nat.mul_pos hn hN)
    (imagCyclicLabel n N a) (imagLabel n N Q c))

lemma realMixedCombination_apply (n N : ℕ) (hn : 0 < n) (hN : 0 < N) (P Q : ℤ × ℤ) (τ : ℍ) :
    realMixedCombination n N hn hN P Q τ =
      ((∑ b : Fin n,xValue (n*N) ((n : ℤ)*P.1) (P.2+(N : ℤ)*(b : ℕ)) τ)-cyclicRealValue n N τ) *
        (∑ c : Fin n,lambdaValue (n*N) ((n : ℤ)*Q.1) (Q.2+(N : ℤ)*(c : ℕ)) τ) := by
  simp only [realMixedCombination,_root_.sub_apply,_root_.sum_apply,mixedForm_apply,realLabel,realCyclicLabel,
    cyclicRealValue]
  simp_rw [← Finset.mul_sum,← Finset.sum_mul]
  ring

lemma imagMixedCombination_apply (n N : ℕ) (hn : 0 < n) (hN : 0 < N) (P Q : ℤ × ℤ) (τ : ℍ) :
    imagMixedCombination n N hn hN P Q τ =
      ((∑ a : Fin n,xValue (n*N) (P.1+(N : ℤ)*(a : ℕ)) ((n : ℤ)*P.2) τ)-cyclicImagValue n N τ) *
        (∑ c : Fin n,lambdaValue (n*N) (Q.1+(N : ℤ)*(c : ℕ)) ((n : ℤ)*Q.2) τ) := by
  simp only [imagMixedCombination,_root_.sub_apply,_root_.sum_apply,mixedForm_apply,imagLabel,imagCyclicLabel,
    cyclicImagValue]
  simp_rw [← Finset.mul_sum,← Finset.sum_mul]
  ring

lemma realMixedCombination_mem (n N : ℕ) (hn : 0 < n) (hN : 0 < N) (P Q : ℤ × ℤ) :
    realMixedCombination n N hn hN P Q ∈ mixedSpan (n*N) (Nat.mul_pos hn hN) := by
  unfold realMixedCombination
  apply Submodule.sub_mem
  · apply Submodule.sum_mem
    intro b _
    apply Submodule.sum_mem
    intro c _
    exact mixedForm_mem _ _ _ _
  · apply Submodule.sum_mem
    intro b _
    apply Submodule.sum_mem
    intro c _
    exact mixedForm_mem _ _ _ _

lemma imagMixedCombination_mem (n N : ℕ) (hn : 0 < n) (hN : 0 < N) (P Q : ℤ × ℤ) :
    imagMixedCombination n N hn hN P Q ∈ mixedSpan (n*N) (Nat.mul_pos hn hN) := by
  unfold imagMixedCombination
  apply Submodule.sub_mem
  · apply Submodule.sum_mem
    intro a _
    apply Submodule.sum_mem
    intro c _
    exact mixedForm_mem _ _ _ _
  · apply Submodule.sum_mem
    intro a _
    apply Submodule.sum_mem
    intro c _
    exact mixedForm_mem _ _ _ _

variable {n : ℕ} [NeZero n]

/-- The exact actual forward weight-three slash has coefficient 1/n on the corrected double mixed sum. -/
theorem forward_mixedForm (N : ℕ) (hN : 0 < N) (P Q : ℤ × ℤ) :
    forwardWeightMap (n := n) N 3 (mixedForm N hN P Q) =
      (1/(n : ℂ)) • realMixedCombination n N (NeZero.pos n) hN P Q := by
  have hnC : (n : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr (NeZero.ne n)
  apply DFunLike.ext
  intro τ
  rw [forwardWeightMap_apply,TauCeti.slash_scaleGL_apply,scale_upTau,mixedForm_apply]
  simp only [Nat.cast_ofNat,Int.reduceSub,_root_.zpow_ofNat,_root_.smul_apply,smul_eq_mul]
  rw [realMixedCombination_apply,xValue_up n N (NeZero.pos n) hN P.1 P.2 τ,
    lambdaValue_up n N (NeZero.pos n) hN Q.1 Q.2 τ]
  field_simp

/-- The actual inverse weight-three slash has coefficient n^-2; determinant normalization is retained. -/
theorem inverse_mixedForm (N : ℕ) (hN : 0 < N) (P Q : ℤ × ℤ) :
    inverseWeightMap (n := n) N 3 (mixedForm N hN P Q) =
      (1/(n : ℂ)^2) • imagMixedCombination n N (NeZero.pos n) hN P Q := by
  apply DFunLike.ext
  intro τ
  rw [inverseWeightMap_apply,inverse_slash_weight,scale_downTau,mixedForm_apply]
  simp only [Nat.cast_ofNat,Int.reduceSub,_root_.zpow_neg,_root_.zpow_ofNat,_root_.smul_apply,smul_eq_mul,one_div]
  rw [imagMixedCombination_apply,xValue_down n N (NeZero.pos n) hN P.1 P.2 τ,
    lambdaValue_down n N (NeZero.pos n) hN Q.1 Q.2 τ]

/-- Forward diagonal translation preserves the actual MIXED span, not merely the homogeneous lambda span. -/
theorem forward_mixedSpan (N : ℕ) (hN : 0 < N) {f : ModularForm (PrincipalGroup N) 3}
    (hf : f ∈ mixedSpan N hN) :
    forwardWeightMap (n := n) N 3 f ∈ mixedSpan (n*N) (Nat.mul_pos (NeZero.pos n) hN) := by
  have hle : mixedSpan N hN ≤ (mixedSpan (n*N) (Nat.mul_pos (NeZero.pos n) hN)).comap
      (forwardWeightMap (n := n) N 3) := by
    apply Submodule.span_le.mpr
    rintro f ⟨P,Q,hP,hQ,rfl⟩
    change forwardWeightMap (n := n) N 3 (mixedForm N hN P Q) ∈
      mixedSpan (n*N) (Nat.mul_pos (NeZero.pos n) hN)
    rw [forward_mixedForm]
    exact Submodule.smul_mem _ _ (realMixedCombination_mem n N (NeZero.pos n) hN P Q)
  exact hle hf

/-- Inverse diagonal translation separately preserves the same actual mixed span at the common level. -/
theorem inverse_mixedSpan (N : ℕ) (hN : 0 < N) {f : ModularForm (PrincipalGroup N) 3}
    (hf : f ∈ mixedSpan N hN) :
    inverseWeightMap (n := n) N 3 f ∈ mixedSpan (n*N) (Nat.mul_pos (NeZero.pos n) hN) := by
  have hle : mixedSpan N hN ≤ (mixedSpan (n*N) (Nat.mul_pos (NeZero.pos n) hN)).comap
      (inverseWeightMap (n := n) N 3) := by
    apply Submodule.span_le.mpr
    rintro f ⟨P,Q,hP,hQ,rfl⟩
    change inverseWeightMap (n := n) N 3 (mixedForm N hN P Q) ∈
      mixedSpan (n*N) (Nat.mul_pos (NeZero.pos n) hN)
    rw [inverse_mixedForm]
    exact Submodule.smul_mem _ _ (imagMixedCombination_mem n N (NeZero.pos n) hN P Q)
  exact hle hf

/-- Actual corrected mixed transport with both rational diagonal slashes and no closure premise. -/
theorem actual_mixed_scaled (N : ℕ) (hN : 0 < N) (P Q : ℤ × ℤ) :
    ∃ F G : ModularForm (PrincipalGroup (n*N)) 3,
      F ∈ mixedSpan (n*N) (Nat.mul_pos (NeZero.pos n) hN) ∧
      G ∈ mixedSpan (n*N) (Nat.mul_pos (NeZero.pos n) hN) ∧
      (∀ τ : ℍ,F τ=((fun τ => xValue N P.1 P.2 τ * lambdaValue N Q.1 Q.2 τ) ∣[(3 : ℤ)] TauCeti.scaleGL n) τ) ∧
      (∀ τ : ℍ,G τ=((fun τ => xValue N P.1 P.2 τ * lambdaValue N Q.1 Q.2 τ) ∣[(3 : ℤ)] (TauCeti.scaleGL n)⁻¹) τ) := by
  refine ⟨forwardWeightMap (n := n) N 3 (mixedForm N hN P Q),
    inverseWeightMap (n := n) N 3 (mixedForm N hN P Q),
    forward_mixedSpan N hN (mixedForm_mem N hN P Q),
    inverse_mixedSpan N hN (mixedForm_mem N hN P Q),?_,?_⟩
  · intro τ
    rw [forwardWeightMap_apply]
    have he : (mixedForm N hN P Q : ℍ → ℂ) = fun τ => xValue N P.1 P.2 τ * lambdaValue N Q.1 Q.2 τ :=
      funext (mixedForm_apply N hN P Q)
    rw [he]
    simp only [Nat.cast_ofNat]
  · intro τ
    rw [inverseWeightMap_apply]
    have he : (mixedForm N hN P Q : ℍ → ℂ) = fun τ => xValue N P.1 P.2 τ * lambdaValue N Q.1 Q.2 τ :=
      funext (mixedForm_apply N hN P Q)
    rw [he]
    simp only [Nat.cast_ofNat]

end ZInQ.Contrib.HeckePrimeRationality.RectangularMixedTransport
