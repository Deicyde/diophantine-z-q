import ZInQKernel.Contrib.OneProof.HeckePrimeRationality.AllLevelEisensteinWeightTwoBounds
import ZInQKernel.Contrib.OneProof.HeckePrimeRationality.AllLevelTorsionMuDistributionNat
import ZInQKernel.Contrib.TauCeti.NumberTheory.ModularForms.Basic
import ZInQKernel.Contrib.TauCeti.NumberTheory.ModularForms.CongruenceSubgroups.Basic
import Mathlib.LinearAlgebra.Span.Basic

/-!
# Level restriction for genuine division Eisenstein series

Restriction along a divisibility of positive levels sends each independently
series-defined weight-two division Eisenstein form to its scaled torsion label
at the larger level. Thus the span of these actual series forms has upward
level maps. No whole-space spanning or downward trace closure is assumed.
-/

noncomputable section
set_option autoImplicit false
open UpperHalfPlane CongruenceSubgroup Matrix.SpecialLinearGroup
open scoped BigOperators MatrixGroups ModularForm

namespace ZInQ.Contrib.HeckePrimeRationality.DivisionEisensteinLevelMaps

open EisensteinWeightTwo

set_option quotPrecheck false in
local notation "ΓP" N => (CongruenceSubgroup.Gamma N).map (mapGL ℝ)

/-- The actual inclusion of principal groups is contravariant in the level. -/
theorem principal_group_le {N M : ℕ} (hNM : N ∣ M) : (ΓP M) ≤ (ΓP N) :=
  Subgroup.map_mono (Gamma_le_Gamma_of_dvd hNM)

/-- Actual complex-linear restriction between weight-two modular-form spaces. -/
def restriction (N M : ℕ) (hNM : N ∣ M) :
    _root_.ModularForm (ΓP N) 2 →ₗ[ℂ] _root_.ModularForm (ΓP M) 2 :=
  _root_.ModularForm.restrictₗ 2 ℂ (principal_group_le hNM)

theorem restriction_apply (N M : ℕ) (hNM : N ∣ M)
    (f : _root_.ModularForm (ΓP N) 2) (τ : ℍ) : restriction N M hNM f τ = f τ := rfl

theorem restriction_injective (N M : ℕ) (hNM : N ∣ M) :
    Function.Injective (restriction N M hNM) :=
  _root_.ModularForm.restrict_injective (principal_group_le hNM)

/-- A positive divisibility quotient is positive and realizes the level ratio. -/
theorem positive_level_ratio {N M : ℕ} (hN : 0 < N) (hM : 0 < M) (hNM : N ∣ M) :
    0 < M / N ∧ M = (M / N) * N := by
  have he : M = (M / N) * N := (Nat.div_mul_cancel hNM).symm
  refine ⟨Nat.pos_of_ne_zero ?_, he⟩
  intro hk0
  rw [hk0, zero_mul] at he
  exact hM.ne' he

/-- Generator image under a positive multiplicative change of level. -/
theorem restriction_generator_mul (N t : ℕ) (hN : 0 < N) (ht : 0 < t) (a : Fin 2 → ℤ) :
    restriction N (t * N) (by exact dvd_mul_left N t) (divisionEisensteinMF N hN a) =
      divisionEisensteinMF (t * N) (Nat.mul_pos ht hN) (fun i => (t : ℤ) * a i) := by
  apply _root_.ModularForm.ext
  intro τ
  rw [restriction_apply]
  have hleft : divisionEisensteinMF N hN a τ = TorsionWeierstrassData.xValue N (a 0) (a 1) τ := by
    have h := divisionEisensteinMF_eq_xValue_all N hN (a 0) (a 1) τ
    have he : ![a 0, a 1] = a := by ext i; fin_cases i <;> rfl
    rwa [he] at h
  have hright : divisionEisensteinMF (t * N) (Nat.mul_pos ht hN) (fun i => (t : ℤ) * a i) τ =
      TorsionWeierstrassData.xValue (t * N) ((t : ℤ) * a 0) ((t : ℤ) * a 1) τ := by
    have h := divisionEisensteinMF_eq_xValue_all (t * N) (Nat.mul_pos ht hN)
      ((t : ℤ) * a 0) ((t : ℤ) * a 1) τ
    have he : ![(t : ℤ) * a 0, (t : ℤ) * a 1] = (fun i => (t : ℤ) * a i) := by
      ext i; fin_cases i <;> rfl
    rwa [he] at h
  rw [hleft, hright, TorsionMuDistributionNat.xValue_scale ht]

/-- The exact generator image for arbitrary positive divisible levels, including bad labels. -/
theorem restriction_generator {N M : ℕ} (hN : 0 < N) (hM : 0 < M) (hNM : N ∣ M)
    (a : Fin 2 → ℤ) :
    restriction N M hNM (divisionEisensteinMF N hN a) =
      divisionEisensteinMF M hM (fun i => ((M / N : ℕ) : ℤ) * a i) := by
  obtain ⟨ht, he⟩ := positive_level_ratio hN hM hNM
  generalize hk : M / N = t at *
  subst M
  exact restriction_generator_mul N t hN ht a

/-- The upward series span is generated by the actual independent lattice-series forms. -/
def seriesSpan (N : ℕ) (hN : 0 < N) : Submodule ℂ (_root_.ModularForm (ΓP N) 2) :=
  Submodule.span ℂ (Set.range (divisionEisensteinMF N hN))

/-- Each actual series generator is in its prescribed span. -/
theorem generator_mem_seriesSpan (N : ℕ) (hN : 0 < N) (a : Fin 2 → ℤ) :
    divisionEisensteinMF N hN a ∈ seriesSpan N hN :=
  Submodule.subset_span ⟨a, rfl⟩

/-- Every series-span member restricts to a series-span member at a divisible level. -/
theorem restriction_mem_seriesSpan {N M : ℕ} (hN : 0 < N) (hM : 0 < M) (hNM : N ∣ M)
    {f : _root_.ModularForm (ΓP N) 2} (hf : f ∈ seriesSpan N hN) :
    restriction N M hNM f ∈ seriesSpan M hM := by
  have hle : seriesSpan N hN ≤ (seriesSpan M hM).comap (restriction N M hNM) := by
    apply Submodule.span_le.mpr
    rintro f ⟨a, rfl⟩
    change restriction N M hNM (divisionEisensteinMF N hN a) ∈ seriesSpan M hM
    rw [restriction_generator hN hM hNM a]
    exact generator_mem_seriesSpan M hM _
  exact hle hf

/-- Upward maps on the genuine series spans, with no desired span premise. -/
def seriesRestriction (N M : ℕ) (hN : 0 < N) (hM : 0 < M) (hNM : N ∣ M) :
    seriesSpan N hN →ₗ[ℂ] seriesSpan M hM :=
  ((restriction N M hNM).domRestrict (seriesSpan N hN)).codRestrict (seriesSpan M hM)
    (fun f => restriction_mem_seriesSpan hN hM hNM f.property)

theorem seriesRestriction_coe (N M : ℕ) (hN : 0 < N) (hM : 0 < M) (hNM : N ∣ M)
    (f : seriesSpan N hN) : (seriesRestriction N M hN hM hNM f : _root_.ModularForm (ΓP M) 2) =
      restriction N M hNM f := rfl

theorem seriesRestriction_injective (N M : ℕ) (hN : 0 < N) (hM : 0 < M) (hNM : N ∣ M) :
    Function.Injective (seriesRestriction N M hN hM hNM) := by
  intro f g he
  apply Subtype.ext
  apply restriction_injective N M hNM
  exact congrArg Subtype.val he

/-- The level maps compose on actual forms. -/
theorem restriction_trans {N M P : ℕ} (hNM : N ∣ M) (hMP : M ∣ P)
    (f : _root_.ModularForm (ΓP N) 2) :
    restriction M P hMP (restriction N M hNM f) = restriction N P (dvd_trans hNM hMP) f := by
  apply _root_.ModularForm.ext
  intro τ
  rfl

theorem restriction_self (N : ℕ) (f : _root_.ModularForm (ΓP N) 2) :
    restriction N N (dvd_refl N) f = f := by
  apply _root_.ModularForm.ext
  intro τ
  rfl

/-- Genuine series correction terms at a common divisible level add inside its series span. -/
theorem sum_restrictions_mem_seriesSpan {ι : Type*} [Fintype ι]
    (L : ι → ℕ) (hL : ∀ i, 0 < L i) (M : ℕ) (hM : 0 < M)
    (hLM : ∀ i, L i ∣ M) (f : ∀ i, _root_.ModularForm (ΓP (L i)) 2)
    (hf : ∀ i, f i ∈ seriesSpan (L i) (hL i)) (c : ι → ℂ) :
    (∑ i, c i • restriction (L i) M (hLM i) (f i)) ∈ seriesSpan M hM :=
  Submodule.sum_mem _ fun i _ => Submodule.smul_mem _ _
    (restriction_mem_seriesSpan (hL i) hM (hLM i) (hf i))

end ZInQ.Contrib.HeckePrimeRationality.DivisionEisensteinLevelMaps
