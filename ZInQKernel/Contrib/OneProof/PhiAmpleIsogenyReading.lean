import ZInQKernel.Contrib.OneProof.PicDictionary
import ZInQKernel.Contrib.CloudW07JacobiansCurves.Jacobian.AlgebraicGeometry.Modules.ZeroLocusTensor
import ZInQKernel.Contrib.CloudW07JacobiansCurves.Jacobian.AlgebraicGeometry.IdealSheaf.EffectiveCartier

/-!
# `PhiAmpleIsogeny` from reading-proof printed leaves (pic-fix2)

Mumford's two statements (§6 Application 1 and §8 Theorem 1) are stated with the hypothesis `IsAmple L ∧ IsVeryAmple L`,
an instance of the print whether Mumford's "ample" is EGA's ampleness (`IsAmple`) or "some power is very ample";
the effective divisor of §6 Application 1 is an effective Cartier divisor (an invertible ideal sheaf), with
`L = 𝒪(D)`. The bundle field `PhiAmpleIsogeny` (every ample `L`) also needs "ample ⇒ a power is very ample"
(Stacks 01VU, EGA II 4.5.10), a third leaf; the chain reads only `PhiVeryAmpleIsogeny`, which follows from the two
Mumford leaves alone (`phiVeryAmpleIsogeny_of_reading`).

* `phiAmpleIsogeny_of_reading : MumfordKLFiniteDivisorAC → MumfordPhiSurjectiveVAC → AmplePowVeryAmple →
  PhiAmpleIsogeny`;
* `phiVeryAmpleIsogeny_of_reading : MumfordKLFiniteDivisorAC → MumfordPhiSurjectiveVAC → PhiVeryAmpleIsogeny`.
-/

set_option backward.isDefEq.respectTransparency false

open CategoryTheory AlgebraicGeometry Limits Opposite MonoidalCategory
open scoped CategoryTheory.MonObj AlgebraicGeometry.Scheme.Modules

namespace PicFix2

open T09Pic PkgI3 PkgI3.AbVar PicDict

/-- `𝒪_X(D) = 𝒪_X(-D)^∨` for an effective Cartier divisor `D`, given by its invertible ideal sheaf
`𝒪_X(-D)` (`IdealSheafData.IsInvertible`: locally generated by a non-zerodivisor; Stacks, *Divisors*, effective Cartier
divisors and invertible sheaves; UNVERIFIED numbering). -/
noncomputable def divisorClass {X : Scheme.{0}} (D : X.IdealSheafData) (hD : D.IsInvertible) : X.Pic :=
  letI := hD.isInvertible_toModules
  Scheme.Pic.mk (D.toModulesᵛ)

/-- A very ample class is `𝒪(D)` for an effective Cartier divisor `D` (a hyperplane section `D = Z(i^*X_m)`;
vendored `Hom.isInvertible_zeroLocus` and `Hom.nonempty_iso_dual_toModules_tensorObj`). -/
theorem exists_divisor_of_veryAmple {k : Type} [Field k] {X : AbVar k} {c : X.X.left.Pic}
    (h : IsVeryAmple X c) :
    ∃ (D : X.X.left.IdealSheafData) (hD : D.IsInvertible), divisorClass D hD = c := by
  obtain ⟨N, hN, i, hi, hover, rfl⟩ := h
  have : IsIntegral X.X.left := GeometricallyIntegral.isIntegral_of_subsingleton X.X.hom
  obtain ⟨x⟩ : Nonempty X.X.left :=
    ⟨η[X.X].left (show PrimeSpectrum k from Nonempty.some (inferInstance : Nonempty (PrimeSpectrum k)))⟩
  obtain ⟨m, hm⟩ := TopologicalSpace.Opens.mem_iSup.mp
    ((ProjectiveSpace.iSup_standardOpen N (Spec (CommRingCat.of k))).ge (Set.mem_univ (i x)))
  have hs : coordSection i m ≠ 0 := by
    intro h0
    have h := (Scheme.Modules.Hom.zeroLocus_eq_bot_iff _).2 h0
    have hx : x ∈ (Scheme.Modules.Hom.zeroLocus (coordSection i m)).support.compl := by
      rw [compl_support_zeroLocus_coordSection]; exact hm
    apply hx
    rw [h]
    trivial
  have hD := Scheme.Modules.Hom.isInvertible_zeroLocus hs
  refine ⟨_, hD, ?_⟩
  obtain ⟨e⟩ := Scheme.Modules.Hom.nonempty_iso_dual_toModules_tensorObj (coordSection i m) hD
  have := hD.isInvertible_toModules
  rw [Scheme.Pic.map_mk]
  unfold divisorClass
  rw [Scheme.Pic.mk_eq_mk_iff]
  exact ⟨(e ≪≫ ρ_ _).symm⟩

/-- `φ_{L^n}(x) = φ_L(x)^n` (`Pic.map` is a homomorphism; as `phi_pow`). -/
theorem phi_pow {k : Type} [Field k] {X : AbVar k} (c : X.X.left.Pic) (x : AC.Kpt X) (n : ℕ) :
    AC.phi (c ^ n) x = AC.phi c x ^ n := by
  simp only [AC.phi]
  rw [← Scheme.Pic.mapHom_apply, map_pow, Scheme.Pic.mapHom_apply, mul_pow, inv_pow]

/-! ## The leaves -/

/-- **LEAF (printed form).** Mumford, *Abelian varieties*, §6, Application 1, direction (iv) ⇒ (ii): for `X` an
abelian variety over an algebraically closed field `k`, `D` an effective divisor with `L = 𝒪_X(D)` ample,
`K(L) = {x ∈ X(k) : t_x^*L ≅ L}` is finite (UNVERIFIED numbering). `D` is an effective Cartier divisor, given by
its invertible ideal sheaf (`IdealSheafData.IsInvertible`), and `L = 𝒪_X(D) = divisorClass D hD`. The hypothesis
"ample" is taken as `IsAmple L ∧ IsVeryAmple L`, an instance of the print whether Mumford's "ample" means EGA's
ampleness (`IsAmple`, Stacks 01PS) or "some power is very ample" (`L¹` very ample). -/
def MumfordKLFiniteDivisorAC : Prop :=
  ∀ (k : Type) [Field k] [IsAlgClosed k] (X : AbVar k) (D : X.X.left.IdealSheafData) (hD : D.IsInvertible),
    IsAmple X.X.left (divisorClass D hD) → IsVeryAmple X (divisorClass D hD) →
    {x : AC.Kpt X | AC.phi (divisorClass D hD) x = 1}.Finite

/-- **LEAF (printed form).** Mumford, *Abelian varieties*, §8, Theorem 1: for `X` an abelian variety over an
algebraically closed field `k`, `L` ample and `M ∈ Pic⁰(X)` (`t_x^*M ≅ M` for all `x ∈ X(k)`), `M ≅ t_x^*L ⊗ L⁻¹`
for some `x ∈ X(k)` (UNVERIFIED numbering). "Ample" is taken as `IsAmple L ∧ IsVeryAmple L`, an instance of the
print under either reading of Mumford's "ample". -/
def MumfordPhiSurjectiveVAC : Prop :=
  ∀ (k : Type) [Field k] [IsAlgClosed k] (X : AbVar k) (c₀ : X.X.left.Pic), IsAmple X.X.left c₀ →
    IsVeryAmple X c₀ → ∀ c : X.X.left.Pic, AC.IsTI c → ∃ x : AC.Kpt X, c = AC.phi c₀ x

/-- **LEAF (printed form).** An ample invertible sheaf on a scheme of finite type over an affine scheme `S` has a
power `L^d` (`d ≥ 1`) with an immersion `i : X → ℙ^n_S` over `S` and `L^d ≅ i^*𝒪(1)`: Stacks, *Morphisms*,
Lemma 29.39.4 (Tag 01VU), (1) ⇒ (5); EGA II 4.5.10 (ii) with 4.4.7; Hartshorne II Thm 7.6 (UNVERIFIED
numbering). "Ample" is Stacks' Def. 28.26.1 (Tag 01PS), which is `IsAmple`. Instance: `X` an abelian variety
over a field `k`, `S = Spec k`. -/
def AmplePowVeryAmple : Prop :=
  ∀ (k : Type) [Field k] (X : AbVar k) (c : X.X.left.Pic), IsAmple X.X.left c →
    ∃ d : ℕ, 0 < d ∧ IsVeryAmple X (c ^ d)

/-! ## Glue (proved) -/

/-- `K(L)` finite for very ample `L` from the printed form (`D` a hyperplane section). -/
theorem kl_finite_of_veryAmple (hKL : MumfordKLFiniteDivisorAC) {k : Type} [Field k] [IsAlgClosed k]
    {X : AbVar k} {c : X.X.left.Pic} (hc : IsVeryAmple X c) :
    {x : AC.Kpt X | AC.phi c x = 1}.Finite := by
  obtain ⟨D, hD, rfl⟩ := exists_divisor_of_veryAmple hc
  exact hKL k X D hD (veryAmpleIsAmple k X _ hc) hc

/-- **Main result (`PhiAmpleIsogeny`)** from the two Mumford leaves in their reading-proof form and the Stacks
lemma "ample ⇒ a power is very ample". For `L` ample on `A` over `K`: `L_K̄` is ample (proved,
`ampleBaseChangeAlgClosure`), `L_K̄^d` is very ample for some `d ≥ 1` (leaf), `K(L_K̄) ⊆ K(L_K̄^d)` (proved,
`phi_pow`) is finite (Mumford §6 App. 1 with `D` a hyperplane section), and every `y ∈ Pic⁰(K̄)` is
`φ_{L^d}(x) = φ_L(x)^d = λ_L(x^d)` (Mumford §8 Thm 1 for `L^d`; `λ_L` is a homomorphism by rigidity, proved). -/
theorem phiAmpleIsogeny_of_reading (hKL : MumfordKLFiniteDivisorAC) (h8 : MumfordPhiSurjectiveVAC)
    (hpow : AmplePowVeryAmple) : PhiAmpleIsogeny := by
  have hfin := finiteOfFiniteKerPts
  have hsub := picZeroPtsTranslInv_of_leaves pushforwardUnitUniversal geomIntegralProd
  intro K _ A P rep B j hj L hL lam hlam
  obtain ⟨lam', hlam'⟩ := exists_hom_comp_eq_phiL rep hj L
  have hjm : Mono j := by
    have : IsOpenImmersion j.left := hj.1
    exact (Over.forget _).mono_of_mono_map (inferInstanceAs (Mono j.left))
  have he : lam = lam'.hom := by rw [← cancel_mono j, hlam, hlam']
  subst he
  have hone : picClass rep j 1 = 1 := map_one (picHom rep hj)
  have hamp : IsAmple (AK A) (bcPic A L) := ampleBaseChangeAlgClosure K A L hL
  obtain ⟨d, -, hva⟩ := hpow (AlgebraicClosure K) (AKbar A) (bcPic A L) hamp
  have hampd : IsAmple (AK A) (bcPic A L ^ d) := veryAmpleIsAmple _ (AKbar A) _ hva
  refine ⟨hfin K A B lam' ?_, ?_⟩
  · refine ((kl_finite_of_veryAmple hKL hva).preimage pts_injective.injOn).subset fun x hx => ?_
    change x ≫ lam'.hom = 1 at hx
    change AC.phi (bcPic A L ^ d) (pts x) = 1
    rw [phi_pow, phi_pts, ← picClass_phiL rep L lam'.hom hlam x, hx, hone, one_pow]
  · apply surjective_of_forall_pt
    intro y
    obtain ⟨σ, hσ⟩ := h8 (AlgebraicClosure K) (AKbar A) _ hampd hva _
      ((isTI_iff _).2 (hsub K A P rep B j hj y))
    obtain ⟨x, rfl⟩ := pts_surjective σ
    refine ⟨x ^ d, picClass_injective rep hj ?_⟩
    rw [hσ, phi_pow, phi_pts, ← picClass_phiL rep L lam'.hom hlam x, MonObj.pow_comp]
    exact map_pow (picHom rep hj) _ d

/-! ## The very-ample form (for a fold that narrows the field) -/

/-- **Very ample base-changes to `K̄`** (proved): if `i : A → ℙ^N_K` is an immersion with `L = i^*𝒪(1)`, its base
change `i_K̄ : A_K̄ → ℙ^N_K̄` is an immersion (a pullback of `i`) with `L_K̄ = i_K̄^*𝒪(1)` (vendored
`ProjectiveSpace.isPullback_liftBaseChange`, `pullbackMapTwistIso`). -/
theorem isVeryAmple_bcPic {K : Type} [Field K] {A : AbVar K} {L : A.X.left.Pic} (h : IsVeryAmple A L) :
    IsVeryAmple (AKbar A) (bcPic A L) := by
  obtain ⟨N, hN, i, hi, hover, rfl⟩ := h
  let g : Spec (CommRingCat.of (AlgebraicClosure K)) ⟶ Spec (CommRingCat.of K) :=
    Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))
  have sq0 : IsPullback (pullback.fst A.X.hom g) (pullback.snd A.X.hom g)
      (i ≫ ℙ(N; Spec (CommRingCat.of K)) ↘ Spec (CommRingCat.of K)) g := by
    rw [hover]; exact IsPullback.of_hasPullback A.X.hom g
  have compat : pullback.snd A.X.hom g ≫ g =
      (pullback.fst A.X.hom g ≫ i) ≫ ℙ(N; Spec (CommRingCat.of K)) ↘ Spec (CommRingCat.of K) := by
    rw [Category.assoc, hover]; exact pullback.condition.symm
  have sq := ProjectiveSpace.isPullback_liftBaseChange (pullback.snd A.X.hom g) sq0 compat
  refine ⟨N, hN, ProjectiveSpace.liftBaseChange (pullback.snd A.X.hom g) (pullback.fst A.X.hom g ≫ i) compat,
    MorphismProperty.of_isPullback (P := @IsImmersion) sq hi, ProjectiveSpace.liftBaseChange_over _ _ _, ?_⟩
  have := ProjectiveSpace.isInvertible_twist N (Spec (CommRingCat.of K)) 1
  rw [bcPic]
  change Scheme.Pic.map (pullback.fst A.X.hom g) _ = _
  have hm := ProjectiveSpace.liftBaseChange_map (pullback.snd A.X.hom g) (pullback.fst A.X.hom g ≫ i) compat
  rw [← Scheme.Pic.map_comp]
  conv_lhs => rw [← hm]
  rw [Scheme.Pic.map_comp, Scheme.Pic.map_mk, Scheme.Pic.map_mk, Scheme.Pic.map_mk]
  rw [Scheme.Pic.mk_eq_mk_iff]
  exact ⟨(Scheme.Modules.pullback _).mapIso (ProjectiveSpace.pullbackMapTwistIso N g 1)⟩

/-- **`PhiVeryAmpleIsogeny` from the two Mumford leaves alone** (no "ample ⇒ power very ample" step): for `L`
very ample, `L_K̄` is very ample (proved) and ample (`veryAmpleIsAmple`). This is all the chain reads
(`phiVeryAmpleIsogeny_of_printed` in `t09SymmIsogenyExists_of_four`). -/
theorem phiVeryAmpleIsogeny_of_reading (hKL : MumfordKLFiniteDivisorAC) (h8 : MumfordPhiSurjectiveVAC) :
    PhiVeryAmpleIsogeny := by
  have hfin := finiteOfFiniteKerPts
  have hsub := picZeroPtsTranslInv_of_leaves pushforwardUnitUniversal geomIntegralProd
  intro K _ A P rep B j hj L hL lam hlam
  obtain ⟨lam', hlam'⟩ := exists_hom_comp_eq_phiL rep hj L
  have hjm : Mono j := by
    have : IsOpenImmersion j.left := hj.1
    exact (Over.forget _).mono_of_mono_map (inferInstanceAs (Mono j.left))
  have he : lam = lam'.hom := by rw [← cancel_mono j, hlam, hlam']
  subst he
  have hone : picClass rep j 1 = 1 := map_one (picHom rep hj)
  have hva : IsVeryAmple (AKbar A) (bcPic A L) := isVeryAmple_bcPic hL
  have hamp : IsAmple (AK A) (bcPic A L) := veryAmpleIsAmple _ (AKbar A) _ hva
  refine ⟨hfin K A B lam' ?_, ?_⟩
  · refine ((kl_finite_of_veryAmple hKL hva).preimage pts_injective.injOn).subset fun x hx => ?_
    change x ≫ lam'.hom = 1 at hx
    change AC.phi (bcPic A L) (pts x) = 1
    rw [phi_pts, ← picClass_phiL rep L lam'.hom hlam x, hx, hone]
  · apply surjective_of_forall_pt
    intro y
    obtain ⟨σ, hσ⟩ := h8 (AlgebraicClosure K) (AKbar A) _ hamp hva _
      ((isTI_iff _).2 (hsub K A P rep B j hj y))
    obtain ⟨x, rfl⟩ := pts_surjective σ
    exact ⟨x, picClass_injective rep hj (by rw [picClass_phiL rep L lam'.hom hlam x, hσ, phi_pts])⟩

/-- **`t09SymmIsogenyExists` with the very-ample L3** (the form a narrowing fold would use: the binder `h3` of
`t09SymmIsogenyExists_of_four` weakened to `PhiVeryAmpleIsogeny`). -/
theorem t09SymmIsogenyExists_of_four_va (h1 : PicRepresentableAbVar) (h2 : PicZeroAbVar)
    (h3 : PhiVeryAmpleIsogeny) (h4 : WeilPairingMumford) : HDec.WeilPairing.T09_SymmIsogenyExists :=
  t09SymmIsogenyExists_of_leaves h1 h2 h3
    (weilPairingPicZero_of_printed veryAmpleIsAmple (weilPairingPicZeroPrinted_of_mumford h4))

end PicFix2

