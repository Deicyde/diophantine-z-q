import ZInQKernel.Contrib.OneProof.C8Manuscript.PeriodCoordinates
import ZInQKernel.Contrib.OneProof.BdRInvariants

/-! # Finite descent of a single rank-one de Rham period

The project's de Rham space is `Hom_G(V, B_dR)`, not `B_dR ⊗ V`.
Thus the positive-character period enters directly. The coefficient field is
not replaced by an extension or by the field generated by the image of a new
character.
-/

noncomputable section

namespace ZInQ.Contrib.G9.RankOnePeriod

open Module PkgI4 ZInQ.Contrib.HodgeSplit

variable (p : ℕ) [Fact p.Prime]
variable (E : IntermediateField ℚ_[p] (PadicAlgCl p))
  [FiniteDimensional ℚ_[p] E] [IsGalois ℚ_[p] E]

private theorem fieldF_eq : fieldF p E = E :=
  (phiF p E).fieldRange_of_normal

/-- The existing `iotaDR` on `fieldF p E`, transported along equality of subfields. -/
def transportedIotaDR : E →ₐ[ℚ_[p]] BdR p :=
  (iotaDR p E).comp (IntermediateField.inclusion (fieldF_eq p E).ge)

theorem bdrAct_transportedIotaDR (g : GQp p) (x : E) :
    bdrAct p g (transportedIotaDR p E x) =
      transportedIotaDR p E ((AlgEquiv.restrictNormalHom E) g x) := by
  simp only [transportedIotaDR, AlgHom.comp_apply, bdrAct_iotaDR]
  apply congrArg (iotaDR p E)
  apply Subtype.ext
  rw [gammaF_apply_coe]
  change g (x : PadicAlgCl p) = ((g.restrictNormal E x : E) : PadicAlgCl p)
  exact (AlgEquiv.restrictNormal_commutes g E x).symm

/-- An explicit compatible embedding is permitted so that the period producer and
consumer can use exactly the same `E → B_dR`. The concrete adapter uses a proved
embedding and its equivariance. -/
theorem isDeRham_of_scalar_period
    (χ : GQp p →* Eˣ) (r : GQp p →* GL (Fin 1) E)
    (hr : ∀ g v, (rRep p r g v) 0 = (χ g : E) * v 0)
    (ι : E →ₐ[ℚ_[p]] BdR p)
    (hι : ∀ g x, bdrAct p g (ι x) = ι ((AlgEquiv.restrictNormalHom E) g x))
    (c : BdR p) (hc : c ≠ 0)
    (hperiod : ∀ g ∈ E.fixingSubgroup, bdrAct p g c = ι (χ g : E) * c) :
    PkgI4.IsDeRham p r := by
  classical
  let BAlg : Algebra ℚ_[p] (BdR p) := inferInstance
  let BField : Field (BdR p) := DeRhamPrint.bdrField p
  let γ : GQp p →* (E ≃ₐ[ℚ_[p]] E) := AlgEquiv.restrictNormalHom E
  have hγ : Function.Surjective γ := AlgEquiv.restrictNormalHom_surjective (PadicAlgCl p)
  have hker : γ.ker = E.fixingSubgroup := IntermediateField.restrictNormalHom_ker E
  let act := bdrActHom p
  let ρ := rRep p r
  let D := Dsp act ρ (γ.ker : Set (GQp p))
  let e : (Fin 1 → E) ≃ₗ[ℚ_[p]] E :=
    (LinearEquiv.funUnique (Fin 1) E E).restrictScalars ℚ_[p]
  let f : (Fin 1 → E) →ₗ[ℚ_[p]] BdR p := c • ι.toLinearMap.comp e.toLinearMap
  have hf : f ∈ D := by
    intro g hg v
    have hgm : g ∈ γ.ker := hg
    have hg' : g ∈ E.fixingSubgroup := hker ▸ hgm
    have hγg : γ g = 1 := MonoidHom.mem_ker.mp hgm
    change c * ι ((ρ g v) 0) = bdrAct p g (c * ι (v 0))
    rw [hr, map_mul (bdrAct p g), hperiod g hg', hι, hγg, map_mul ι]
    change c * (ι (χ g : E) * ι (v 0)) = (ι (χ g : E) * c) * ι (v 0)
    ring
  let s : (E ≃ₐ[ℚ_[p]] E) → GQp p := Function.surjInv hγ
  have hs : ∀ τ, γ (s τ) = τ := Function.surjInv_eq hγ
  let d : (E ≃ₐ[ℚ_[p]] E) → BdR p :=
    fun τ => bdrAct p (s τ) c * ι (τ (χ (s τ)⁻¹ : E))
  have hd : ∀ τ, d τ ≠ 0 := by
    let _ : Field (BdR p) := BField
    intro τ
    exact mul_ne_zero ((map_ne_zero (bdrAct p (s τ))).2 hc)
      ((map_ne_zero ι).2 ((map_ne_zero τ).2 (χ (s τ)⁻¹).ne_zero))
  have hComparison : ∃ b : Basis (E ≃ₐ[ℚ_[p]] E) (BdR p) ((Fin 1 → E) →ₗ[ℚ_[p]] BdR p),
      ∀ τ v, b τ v = d τ * ι (τ (e v)) :=
    @exists_scaledEmbeddings_basis ℚ_[p] E (BdR p) (Fin 1 → E)
      _ _ _ _ _ BField BAlg _ _ ι e d hd
  obtain ⟨b, hb⟩ := hComparison
  have hmem : ∀ τ, b τ ∈ D := by
    intro τ
    have heq : b τ = twist act ρ (s τ) f := by
      apply LinearMap.ext
      intro v
      rw [hb, twist_apply]
      change d τ * ι (τ (v 0)) = bdrAct p (s τ) (c * ι ((ρ (s τ)⁻¹ v) 0))
      rw [hr, map_mul (bdrAct p (s τ)), hι, hs, map_mul τ, map_mul ι]
      dsimp only [d]
      ring
    rw [heq]
    exact twist_mem act ρ γ (s τ) hf
  have hfg : Set.range (gfToGqp p E) = (γ.ker : Set (GQp p)) := by
    rw [hker, range_gfToGqp_eq, fieldF_eq p E]
  have hfixed (x : BdR p) : x ∈ DeRhamPrint.bdrFix p E ↔
      ∀ g ∈ (γ.ker : Set (GQp p)), bdrAct p g x = x := by
    rw [← hfg]
    constructor
    · rintro hx _ ⟨g, rfl⟩
      exact hx g
    · intro hx g
      exact hx _ ⟨g, rfl⟩
  have hB := BdRInv.bdRInvariantsPrinted_proof p E
  have hfd : FiniteDimensional ℚ_[p] (DeRhamPrint.bdrFix p E) :=
    Module.finite_of_finrank_pos (by rw [hB]; exact Module.finrank_pos)
  have hsurj (g : GQp p) : Function.Surjective (ρ g) := fun v =>
    ⟨ρ g⁻¹ v, by simpa only [inv_inv] using rho_inv_rho ρ g⁻¹ v⟩
  have hdim : finrank ℚ_[p] D = Fintype.card (E ≃ₐ[ℚ_[p]] E) *
      finrank ℚ_[p] (DeRhamPrint.bdrFix p E) :=
    @finrank_equivariantHom_of_basis ℚ_[p] (BdR p) (GQp p) (Fin 1 → E)
      (E ≃ₐ[ℚ_[p]] E) _ BField BAlg _ _ _ (γ.ker : Set (GQp p)) (bdrAct p) ρ hsurj D
      (DeRhamPrint.bdrFix p E) hfd (fun _ => Iff.rfl) hfixed b hmem
  have hcard : Fintype.card (E ≃ₐ[ℚ_[p]] E) = finrank ℚ_[p] E := by
    rw [← Nat.card_eq_fintype_card, IsGalois.card_aut_eq_finrank]
  rw [hB, hcard] at hdim
  have hsemi : ∀ g x z, act g (ι x * z) = ι (γ g x) * act g z := by
    intro g x z
    change bdrAct p g (ι x * z) = ι (γ g x) * bdrAct p g z
    rw [map_mul, hι]
  have hdesc := descent_finrank act ρ ι γ hγ hsemi
  change finrank ℚ_[p] D = finrank ℚ_[p] E *
    finrank ℚ_[p] (Dsp (bdrActHom p) (rRep p r) Set.univ) at hdesc
  rw [← ddrSpace_eq_DspAct p r] at hdesc
  rw [IsDeRham, one_mul]
  exact Nat.eq_of_mul_eq_mul_left Module.finrank_pos (hdesc.symm.trans hdim)

end ZInQ.Contrib.G9.RankOnePeriod
