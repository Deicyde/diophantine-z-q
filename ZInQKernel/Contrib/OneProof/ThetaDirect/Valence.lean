open HDec.HSyn.G0Split.FibreQM.PeriodMap (G8 U isOpen_U isPreconnected_U omegaSiegel_proof Nf dF)
open HDec.HSyn.G0Split.FibreQM.PeriodGlue (M4 M6 M4_symp M6_symp A4 B4 C4 D4 A6 B6 C6 D6 M4_map M6_map
  I1_g4 I2_g4 I1_g6 I2_g6 iota_x4 iota_x6 x4 x6 spAct_of_poly spFactor_of_poly dF_ne sub3_add1_ne detv
  denom_mul_pos σ_of_pos GammaStarGen dFh Nfh)
