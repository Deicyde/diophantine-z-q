/-! ## The valence formula for `Γ*` (proved in the kernel) and vanishing at nodes -/

/-- The valence formula for `Γ*`, inequality form (the kernel's `ValenceFormulaGammaStar`), from the proved
`valenceFormulaCocompactEq_proof` and `shimizuCovolumeO1_proof`. -/
theorem valenceGS : HDec.LeafQCheck.VB.ValenceFormulaGammaStar :=
  HDec.LeafQCheck.HM.QMSplit.valenceFormulaGammaStar_of_leaves
    ValenceCocompact.valenceFormulaCocompactEq_proof HDec.GammaStarArea.shimizuCovolumeO1_proof

/-- **Vanishing at nodes (proved).** -/
theorem eq_zero_of_nodes {m : ℕ} {F F₂ : ℂ → ℂ} (hF : AnalyticOnNhd ℂ F U) (hF₂ : AnalyticOnNhd ℂ F₂ U)
    (haF : Auto m F) (haF₂ : Auto m F₂) (T : Finset UpperHalfPlane)
    (hT : (T : Set UpperHalfPlane).Pairwise (fun z w => ∀ γ ∈ PkgI1.GammaStar, γ • z ≠ w))
    (hzero : ∀ z ∈ T, F (z : ℂ) = 0) (hne : ∀ z ∈ T, F₂ (z : ℂ) ≠ 0) (hm : m < 12 * T.card) :
    ∀ z ∈ U, F z = 0 := by
  by_contra hcon
  push_neg at hcon
  obtain ⟨z0, hz0, hFz0⟩ := hcon
  have hV := valenceGS m F hF ⟨z0, hz0, hFz0⟩ (abs_auto haF) T hT
  have key : ∀ z ∈ T, (1 : ℝ≥0∞) ≤
      ((analyticOrderAt F (z : ℂ) : ℕ∞) : ℝ≥0∞) / (HDec.LeafQCheck.VB.ellOrder z : ℝ≥0∞) := by
    intro z hz
    have hzU : (z : ℂ) ∈ U := z.im_pos
    have htop : analyticOrderAt F (z : ℂ) ≠ ⊤ := by
      intro htop
      have hev := analyticOrderAt_eq_top.mp htop
      exact hFz0 (hF.eqOn_zero_of_preconnected_of_eventuallyEq_zero isPreconnected_U hzU hev hz0)
    have hdvd := HDec.LeafQCheck.HM.QMSplit.ellipticOrderDvd_proof m F F₂ hF hF₂ haF haF₂ z
      (hne z hz) htop
    have hpos := (HDec.LeafQCheck.VB.ellipticOrderLe6_proof z).1
    have hord : analyticOrderAt F (z : ℂ) = ((analyticOrderAt F (z : ℂ)).toNat : ℕ∞) :=
      (ENat.coe_toNat htop).symm
    have hn0 : (analyticOrderAt F (z : ℂ)).toNat ≠ 0 := by
      intro h0
      have : analyticOrderAt F (z : ℂ) = 0 := by rw [hord, h0]; rfl
      exact ((hF z hzU).analyticOrderAt_eq_zero.mp this) (hzero z hz)
    have hle : HDec.LeafQCheck.VB.ellOrder z ≤ (analyticOrderAt F (z : ℂ)).toNat :=
      Nat.le_of_dvd (Nat.pos_of_ne_zero hn0) hdvd
    rw [hord, ENat.toENNReal_coe]
    rw [ENNReal.le_div_iff_mul_le (Or.inl (by exact_mod_cast hpos.ne'))
      (Or.inl (ENNReal.natCast_ne_top _)), one_mul]
    exact_mod_cast hle
  have hsum : (T.card : ℝ≥0∞) ≤ (m : ℝ≥0∞) / 12 := by
    calc (T.card : ℝ≥0∞) = ∑ z ∈ T, (1 : ℝ≥0∞) := by simp
      _ ≤ _ := Finset.sum_le_sum key
      _ ≤ _ := hV
  rw [ENNReal.le_div_iff_mul_le (Or.inl (by norm_num)) (Or.inl (by norm_num))] at hsum
  have : T.card * 12 ≤ m := by exact_mod_cast hsum
  omega

/-! ## Algebra of automorphic forms -/

theorem auto_mul {m n : ℕ} {F G : ℂ → ℂ} (hF : Auto m F) (hG : Auto n G) :
    Auto (m + n) (fun z => F z * G z) := by
  intro γ hγ z
  have e1 := hF γ hγ z
  have e2 := hG γ hγ z
  simp only
  rw [pow_add, show 2 * (m + n) = 2 * m + 2 * n by ring, pow_add]
  linear_combination (G ((γ • z : UpperHalfPlane) : ℂ) * (((γ : Matrix (Fin 2) (Fin 2) ℝ).det : ℝ) : ℂ) ^ n) * e1
    + (denom γ z ^ (2 * m) * F (z : ℂ)) * e2

theorem auto_sub {m : ℕ} {F G : ℂ → ℂ} (hF : Auto m F) (hG : Auto m G) :
    Auto m (fun z => F z - G z) := by
  intro γ hγ z
  have e1 := hF γ hγ z
  have e2 := hG γ hγ z
  simp only
  linear_combination e1 - e2

theorem auto_const_mul {m : ℕ} {F : ℂ → ℂ} (c : ℂ) (hF : Auto m F) :
    Auto m (fun z => c * F z) := by
  intro γ hγ z
  have e1 := hF γ hγ z
  simp only
  linear_combination c * e1

theorem auto_pow {m : ℕ} {F : ℂ → ℂ} (hF : Auto m F) (k : ℕ) :
    Auto (m * k) (fun z => F z ^ k) := by
  induction k with
  | zero =>
    intro γ hγ z; simp
  | succ k ih =>
    have h := auto_mul ih hF
    intro γ hγ z
    have e := h γ hγ z
    simp only at e ⊢
    rw [show m * (k + 1) = m * k + m by ring, pow_succ, pow_succ]
    exact e

/-! ## Automorphy of `S ∘ Ω` from Siegel modularity at `M4`, `M6` -/

/-- `GS w S z = S(Ω(z))/((z−3)(z+1))^w`. -/
def GS (w : ℕ) (S : Matrix (Fin 2) (Fin 2) ℂ → ℂ) (z : ℂ) : ℂ :=
  S (PkgI1.Omega z) / ((z - 3) * (z + 1)) ^ w

/-- `g ∈ GL₂(ℝ)⁺` and `GS w S` has exact automorphy of weight `2w` for `g`. -/
def SAuto (w : ℕ) (S : Matrix (Fin 2) (Fin 2) ℂ → ℂ) (γ : GL (Fin 2) ℝ) : Prop :=
  0 < (γ : Matrix (Fin 2) (Fin 2) ℝ).det ∧ ∀ z : UpperHalfPlane,
    GS w S ((γ • z : UpperHalfPlane) : ℂ) * (((γ : Matrix (Fin 2) (Fin 2) ℝ).det : ℝ) : ℂ) ^ w =
      denom γ z ^ (2 * w) * GS w S (z : ℂ)

theorem sAuto_one (w : ℕ) (S : Matrix (Fin 2) (Fin 2) ℂ → ℂ) : SAuto w S 1 := by
  refine ⟨by simp, fun z => ?_⟩
  simp [UpperHalfPlane.denom]

theorem sAuto_mul {w : ℕ} {S : Matrix (Fin 2) (Fin 2) ℂ → ℂ} {g h : GL (Fin 2) ℝ} (hg : SAuto w S g)
    (hh : SAuto w S h) : SAuto w S (g * h) := by
  refine ⟨by rw [Units.val_mul, Matrix.det_mul]; exact mul_pos hg.1 hh.1, fun z => ?_⟩
  rw [mul_smul, denom_mul_pos g h hh.1, Units.val_mul, Matrix.det_mul]
  have e1 := hg.2 (h • z)
  have e2 := hh.2 z
  push_cast
  rw [mul_pow, mul_pow]
  linear_combination ((h : Matrix (Fin 2) (Fin 2) ℝ).det : ℂ) ^ w * e1 +
    denom g ((h • z : UpperHalfPlane) : ℂ) ^ (2 * w) * e2

theorem sAuto_inv {w : ℕ} {S : Matrix (Fin 2) (Fin 2) ℂ → ℂ} {g : GL (Fin 2) ℝ} (hg : SAuto w S g) :
    SAuto w S g⁻¹ := by
  have hd : ((g⁻¹ : GL (Fin 2) ℝ) : Matrix (Fin 2) (Fin 2) ℝ).det =
      ((g : Matrix (Fin 2) (Fin 2) ℝ).det)⁻¹ := by
    rw [Matrix.coe_units_inv, Matrix.det_nonsing_inv, Ring.inverse_eq_inv']
  refine ⟨by rw [hd]; exact inv_pos.mpr hg.1, fun z => ?_⟩
  have e := hg.2 (g⁻¹ • z)
  rw [smul_inv_smul] at e
  have hc := denom_mul_pos g g⁻¹ (by rw [hd]; exact inv_pos.mpr hg.1) z
  rw [mul_inv_cancel] at hc
  have h1 : denom (1 : GL (Fin 2) ℝ) z = 1 := by simp [UpperHalfPlane.denom]
  rw [h1] at hc
  have hD : denom g ((g⁻¹ • z : UpperHalfPlane) : ℂ) ≠ 0 := denom_ne_zero _ _
  have hdet : ((g : Matrix (Fin 2) (Fin 2) ℝ).det : ℂ) ≠ 0 := by exact_mod_cast hg.1.ne'
  rw [hd]
  push_cast
  have hinv : denom g⁻¹ z = (denom g ((g⁻¹ • z : UpperHalfPlane) : ℂ))⁻¹ :=
    (eq_inv_of_mul_eq_one_right hc.symm)
  rw [hinv, inv_pow, inv_pow]
  have hD' : denom g ((g⁻¹ • z : UpperHalfPlane) : ℂ) ^ (2 * w) ≠ 0 := pow_ne_zero _ hD
  have hdet' : ((g : Matrix (Fin 2) (Fin 2) ℝ).det : ℂ) ^ w ≠ 0 := pow_ne_zero _ hdet
  field_simp
  linear_combination (-1 : ℂ) * e

theorem sAuto_scalar {w : ℕ} {S : Matrix (Fin 2) (Fin 2) ℂ → ℂ} {g : GL (Fin 2) ℝ} (q : ℚ) (hq : q ≠ 0)
    (hg : (g : Matrix (Fin 2) (Fin 2) ℝ) = (q : ℝ) • 1) : SAuto w S g := by
  have hq' : (q : ℝ) ≠ 0 := by exact_mod_cast hq
  have hdet : (g : Matrix (Fin 2) (Fin 2) ℝ).det = (q : ℝ) ^ 2 := by
    rw [hg, Matrix.det_smul, Matrix.det_one]; simp
  have hpos : 0 < (g : Matrix (Fin 2) (Fin 2) ℝ).det := by rw [hdet]; positivity
  have e00 : (g : Matrix (Fin 2) (Fin 2) ℝ) 0 0 = q := by rw [hg]; simp
  have e01 : (g : Matrix (Fin 2) (Fin 2) ℝ) 0 1 = 0 := by rw [hg]; simp
  have e10 : (g : Matrix (Fin 2) (Fin 2) ℝ) 1 0 = 0 := by rw [hg]; simp
  have e11 : (g : Matrix (Fin 2) (Fin 2) ℝ) 1 1 = q := by rw [hg]; simp
  refine ⟨hpos, fun z => ?_⟩
  have hden : denom g z = (q : ℂ) := by simp [UpperHalfPlane.denom, e10, e11]
  have hsm : g • z = z := by
    ext1
    rw [coe_smul_of_det_pos (by rwa [detv]), hden]
    simp only [UpperHalfPlane.num, e00, e01]
    have : (q : ℂ) ≠ 0 := by exact_mod_cast hq
    field_simp
    push_cast; ring
  rw [hsm, hden, hdet]
  push_cast
  rw [← pow_mul, mul_comm 2 w]
  ring

/-- The automorphy subgroup of `GS w S`. -/
def SAutoSubgroup (w : ℕ) (S : Matrix (Fin 2) (Fin 2) ℂ → ℂ) : Subgroup (GL (Fin 2) ℝ) where
  carrier := {γ | SAuto w S γ}
  one_mem' := sAuto_one w S
  mul_mem' := sAuto_mul
  inv_mem' := sAuto_inv

/-- `GS w S` is automorphic for `g` once `S` is modular at `M` along `Ω` and `M` realizes `g` (the algebra of
period-glue's `g8Auto_of_sp`, TailJ). -/
theorem sAuto_of_sp {w : ℕ} (hw : Even w) {S : Matrix (Fin 2) (Fin 2) ℂ → ℂ} (g : GL (Fin 2) ℝ)
    (hdet : 0 < (g : Matrix (Fin 2) (Fin 2) ℝ).det)
    (M : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) ℤ)
    (hS : ∀ z : ℂ, 0 < z.im → S (PkgI1.spAct M (PkgI1.Omega z)) =
      PkgI1.spFactor M (PkgI1.Omega z) ^ w * S (PkgI1.Omega z))
    (hrel : ∀ z : ℂ, 0 < z.im →
      PkgI1.spAct M (PkgI1.Omega z) = PkgI1.Omega (num g z / denom g z))
    (hfac : ∀ z : ℂ, 0 < z.im →
      PkgI1.spFactor M (PkgI1.Omega z) * ((g : Matrix (Fin 2) (Fin 2) ℝ).det : ℂ) *
        ((z - 3) * (z + 1)) =
      -1 * denom g z ^ 2 * ((num g z / denom g z - 3) * (num g z / denom g z + 1))) :
    SAuto w S g := by
  refine ⟨hdet, fun z => ?_⟩
  have hw' : ((g • z : UpperHalfPlane) : ℂ) = num g z / denom g z :=
    coe_smul_of_det_pos (by rwa [detv]) z
  have hwim : 0 < (num g z / denom g z).im := by rw [← hw']; exact (g • z).im_pos
  have hmod := hS z z.im_pos
  rw [hrel z z.im_pos] at hmod
  have hf := hfac z z.im_pos
  unfold GS
  rw [hw', hmod]
  obtain ⟨h3, h4⟩ := sub3_add1_ne z.im_pos
  obtain ⟨h5, h6⟩ := sub3_add1_ne hwim
  have hD : denom g z ≠ 0 := denom_ne_zero g z
  have hfw : (PkgI1.spFactor M (PkgI1.Omega z) * ((g : Matrix (Fin 2) (Fin 2) ℝ).det : ℂ) *
      ((z - 3) * (z + 1))) ^ w =
      (denom g z ^ 2 * ((num g z / denom g z - 3) * (num g z / denom g z + 1))) ^ w := by
    rw [hf, show -1 * denom g z ^ 2 * ((num g z / denom g z - 3) * (num g z / denom g z + 1)) =
      (-1) * (denom g z ^ 2 * ((num g z / denom g z - 3) * (num g z / denom g z + 1))) by ring,
      mul_pow, hw.neg_one_pow, one_mul]
  generalize num g z / denom g z = v at *
  have hz3 : (((z : ℂ) - 3) * ((z : ℂ) + 1)) ^ w ≠ 0 := pow_ne_zero _ (mul_ne_zero h3 h4)
  have hv3 : ((v - 3) * (v + 1)) ^ w ≠ 0 := pow_ne_zero _ (mul_ne_zero h5 h6)
  generalize ((z : ℂ) - 3) * ((z : ℂ) + 1) = A at *
  generalize (v - 3) * (v + 1) = B at *
  simp only [mul_pow, ← pow_mul] at hfw
  field_simp
  linear_combination S (PkgI1.Omega z) * hfw

/-- `GS w S` is automorphic for `g = ι(x)` once the modular embedding identities hold (period-glue's
`g8Auto_gen`, TailJ, with `sAuto_of_sp`). -/
theorem sAuto_gen {w : ℕ} (hw : Even w) {S : Matrix (Fin 2) (Fin 2) ℂ → ℂ} (g : GL (Fin 2) ℝ)
    (hdet : 0 < (g : Matrix (Fin 2) (Fin 2) ℝ).det)
    (M : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) ℤ)
    (hS : ∀ z : ℂ, 0 < z.im → S (PkgI1.spAct M (PkgI1.Omega z)) =
      PkgI1.spFactor M (PkgI1.Omega z) ^ w * S (PkgI1.Omega z))
    (A B C D : Matrix (Fin 2) (Fin 2) ℂ) (hM : M.map (Int.cast : ℤ → ℂ) = Matrix.fromBlocks A B C D)
    (hI1 : ∀ z : ℂ, dFh (num g z) (denom g z) • (A * Nf z + dF z • B) =
      Nfh (num g z) (denom g z) * (C * Nf z + dF z • D))
    (hI2 : ∀ z : ℂ, (C * Nf z + dF z • D).det * ((g : Matrix (Fin 2) (Fin 2) ℝ).det : ℂ) *
      ((z - 3) * (z + 1)) = -1 * dF z ^ 2 * ((num g z - 3 * denom g z) * (num g z + denom g z))) :
    SAuto w S g := by
  have hwim : ∀ z : ℂ, 0 < z.im → 0 < (num g z / denom g z).im := fun z hz => by
    have := (g • (⟨z, hz⟩ : UpperHalfPlane)).im_pos
    rwa [← UpperHalfPlane.coe_im, coe_smul_of_det_pos (by rwa [detv])] at this
  have hV : ∀ z : ℂ, 0 < z.im → denom g z ≠ 0 := fun z hz =>
    UpperHalfPlane.denom_ne_zero_of_im g hz.ne'
  have hP : ∀ z : ℂ, 0 < z.im → (C * Nf z + dF z • D).det ≠ 0 := fun z hz h0 => by
    have e := hI2 z
    rw [h0, zero_mul, zero_mul] at e
    obtain ⟨h5, h6⟩ := sub3_add1_ne (hwim z hz)
    have h7 : num g z - 3 * denom g z ≠ 0 := fun h => h5 (by
      rw [show num g z = 3 * denom g z by linear_combination h, mul_div_assoc,
        div_self (hV z hz)]; ring)
    have h8 : num g z + denom g z ≠ 0 := fun h => h6 (by
      rw [show num g z = -denom g z by linear_combination h, neg_div, div_self (hV z hz)]; ring)
    have := dF_ne hz
    have : -1 * dF z ^ 2 * ((num g z - 3 * denom g z) * (num g z + denom g z)) ≠ 0 := by
      apply mul_ne_zero (mul_ne_zero (by norm_num) (pow_ne_zero _ this)) (mul_ne_zero h7 h8)
    exact this e.symm
  refine sAuto_of_sp hw g hdet M hS (fun z hz => ?_) (fun z hz => ?_)
  · exact spAct_of_poly M A B C D hM z _ _ (hV z hz) (dF_ne hz) (dF_ne (hwim z hz)) (hP z hz) (hI1 z)
  · exact spFactor_of_poly M A B C D hM z _ _ _ (hV z hz) (dF_ne hz) (hI2 z)

theorem sAuto_g4 {w : ℕ} (hw : Even w) {S : Matrix (Fin 2) (Fin 2) ℂ → ℂ}
    (hS : ∀ z : ℂ, 0 < z.im → S (PkgI1.spAct M4 (PkgI1.Omega z)) =
      PkgI1.spFactor M4 (PkgI1.Omega z) ^ w * S (PkgI1.Omega z))
    {g : GL (Fin 2) ℝ} (hg : (g : Matrix (Fin 2) (Fin 2) ℝ) = PkgI1.iota x4) : SAuto w S g := by
  rw [iota_x4] at hg
  have hdet : (g : Matrix (Fin 2) (Fin 2) ℝ).det = 2 := by
    rw [hg, Matrix.det_fin_two_of]
    linear_combination (-1 : ℝ) * HDec.HSyn.G0Split.FibreQM.PeriodMap.sqrt2_sq'
  have hnum : ∀ z : ℂ, num g z = (√2 : ℂ) * z + z - 3 := fun z => by
    simp only [UpperHalfPlane.num, hg]; simp; ring
  have hden : ∀ z : ℂ, denom g z = -(√2 : ℂ) + z + 1 := fun z => by
    simp only [UpperHalfPlane.denom, hg]; simp; ring
  refine sAuto_gen hw g (by rw [hdet]; norm_num) M4 hS A4 B4 C4 D4 M4_map
    (fun z => by rw [hnum, hden]; exact I1_g4 z) (fun z => ?_)
  rw [hnum, hden, hdet]; push_cast; exact I2_g4 z

theorem sAuto_g6 {w : ℕ} (hw : Even w) {S : Matrix (Fin 2) (Fin 2) ℂ → ℂ}
    (hS : ∀ z : ℂ, 0 < z.im → S (PkgI1.spAct M6 (PkgI1.Omega z)) =
      PkgI1.spFactor M6 (PkgI1.Omega z) ^ w * S (PkgI1.Omega z))
    {g : GL (Fin 2) ℝ} (hg : (g : Matrix (Fin 2) (Fin 2) ℝ) = PkgI1.iota x6) : SAuto w S g := by
  rw [iota_x6] at hg
  have hdet : (g : Matrix (Fin 2) (Fin 2) ℝ).det = 3 := by
    rw [hg, Matrix.det_fin_two_of]; norm_num
  have hnum : ∀ z : ℂ, num g z = -3 * z / 2 - 3 / 2 := fun z => by
    simp only [UpperHalfPlane.num, hg]; simp; ring
  have hden : ∀ z : ℂ, denom g z = z / 2 - 3 / 2 := fun z => by
    simp only [UpperHalfPlane.denom, hg]; simp; ring
  refine sAuto_gen hw g (by rw [hdet]; norm_num) M6 hS A6 B6 C6 D6 M6_map
    (fun z => by rw [hnum, hden]; exact I1_g6 z) (fun z => ?_)
  rw [hnum, hden, hdet]; push_cast; exact I2_g6 z

/-- **Automorphy of `GS w S` for `Γ*` (proved)** from the Siegel modularity of `S` at `M4` and `M6` along `Ω`
(`GammaStarGen` is the kernel's theorem `gammaStarGen_proof`). -/
theorem autoGS {w : ℕ} (hw : Even w) {S : Matrix (Fin 2) (Fin 2) ℂ → ℂ}
    (h4 : ∀ z : ℂ, 0 < z.im → S (PkgI1.spAct M4 (PkgI1.Omega z)) =
      PkgI1.spFactor M4 (PkgI1.Omega z) ^ w * S (PkgI1.Omega z))
    (h6 : ∀ z : ℂ, 0 < z.im → S (PkgI1.spAct M6 (PkgI1.Omega z)) =
      PkgI1.spFactor M6 (PkgI1.Omega z) ^ w * S (PkgI1.Omega z)) :
    Auto w (GS w S) := by
  intro γ hγ z
  have hmem : γ ∈ SAutoSubgroup w S := by
    refine (Subgroup.closure_le (K := SAutoSubgroup w S)).mpr ?_
      (HDec.LeafQCheck.gammaStarGen_proof γ hγ)
    rintro g ((hg | hg) | ⟨q, hq, hg⟩)
    · exact sAuto_g4 hw h4 hg
    · exact sAuto_g6 hw h6 hg
    · exact sAuto_scalar q hq hg
  exact hmem.2 z

end HDec.ThetaDirect
