/-- **`ψ₆` (theta expression) under `M6` (proved).** -/
theorem psi6Th_M6 {Ω : Matrix (Fin 2) (Fin 2) ℂ} (hΩ : Ω ∈ PkgI1.SiegelH2) :
    psi6Th (PkgI1.spAct M6 Ω) = PkgI1.spFactor M6 Ω ^ 6 * psi6Th Ω := by
  rw [psi6Th_eq, psi6Th_eq, GapTheta.spFactor_M6 (GapTheta.pdq_of_siegel hΩ).1]
  have h : (fun m => PkgI1.thetaConst m (PkgI1.spAct M6 Ω) ^ 2) = fun m =>
      (-((Ω 0 0 + 1) * (Ω 1 1 + 2) - (Ω 0 1 - 1) ^ 2)) *
        (cexp (π * I * (GapTheta.N6 m : ℂ) / 4) * (fun m => PkgI1.thetaConst m Ω ^ 2) (GapTheta.σ6 m)) := by
    funext m; rw [GapTheta.sq6 m hΩ]; ring
  rw [h, psi6T_smul', psi6T_perm6 (fun m => PkgI1.thetaConst m Ω ^ 2), Even.neg_pow (by decide)]

