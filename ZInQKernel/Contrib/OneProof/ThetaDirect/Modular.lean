import ZInQKernel.Contrib.OneProof.ThetaDirect.Nodes

/-! # theta-direct (helper): Igusa's theta expressions `ψ₆`, `χ₁₂` transform with weights 6, 12 under `M4`, `M6`

No leaf: gt-theta's squared transformation laws (`GapTheta.sq4`, `GapTheta.sq6`, ThetaModularityM46.lean:
`θ_m(MΩ)² = −D·e^{πiN(m)/4}·θ_{σ(m)}(Ω)²` with an explicit permutation `σ` of the even characteristics and even
`N(m)`) turn `ψ₆ = psi6T(θ²)` and `χ₁₂ = chi12T(θ²)` (theta-glue's theta expressions; only squares of products of the
`t_m = θ_m²` occur) into the same expressions up to the factor `D⁶`, resp. `D¹²`: each `e²` is `±1`, and the signed
permutation maps the 60 (resp. 15) terms to themselves. The finite facts (values of `σ`, of `e² = (−1)^{N/2}`) are
checked by `decide` and `norm_num`; the term matching is a `ring` identity in ten atoms (degree 6, resp. 12).
Checked independently by scratch/theta-direct/py/psi6_check.py (exact, sympy). The lemmas `σ…`, `e…` below are
generated by scratch/theta-direct/py/gen_modular.py. -/

set_option linter.all false

noncomputable section

namespace HDec.ThetaDirect

open Complex
open scoped Real
open HDec.HSyn.G0Split.FibreQM.PeriodGlue (M4 M6)
open HDec.HSyn.G0Split.ThetaPt.ThetaGlue (psi6Th chi12Th psi6T chi12T psi6Th_eq chi12Th_eq)

/-- `e^{πik/4}² = (−1)^j` for `k = 2j`. -/
theorem e_sq_val (k j : ℤ) (hk : k = 2 * j) : cexp (π * I * (k : ℂ) / 4) ^ 2 = (-1 : ℂ) ^ j := by
  rw [← Complex.exp_nat_mul, show ((2 : ℕ) : ℂ) * (π * I * (k : ℂ) / 4) = (j : ℂ) * (π * I) by
    rw [hk]; push_cast; ring, Complex.exp_int_mul, Complex.exp_pi_mul_I]

