  simp only [psi6T, mul_pow, σ6_0000, σ6_0001, σ6_0010, σ6_0011, σ6_0100, σ6_0110, σ6_1000, σ6_1001, σ6_1100,
    σ6_1111, e6_0000, e6_0001, e6_0010, e6_0011, e6_0100, e6_0110, e6_1000, e6_1001, e6_1100, e6_1111]
  ring

