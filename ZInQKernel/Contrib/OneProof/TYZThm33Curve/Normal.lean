import ZInQKernel.Contrib.OneProof.TYZThm33Curve.Charts
import Mathlib.RingTheory.DedekindDomain.Dvr
import Mathlib.RingTheory.DiscreteValuationRing.TFAE
import ZInQKernel.Contrib.TauCeti.AlgebraicGeometry.EllipticCurve.Affine.CoordinateRing

/-!
# h33-d1: the local rings of `ESch E` are valuation rings (`E` elliptic over `ℚ`)

The inverse direction of D1: `ESch E = Proj ℚ[X, Y, Z]/(F_E)` is a normal curve.

* On `D₊(Z)`: `A_(Z) ≅ ℚ[x, y]/(W_E)` is a Dedekind domain (Tau Ceti's
  `isIntegrallyClosed_coordinateRing`), so its localizations at primes are fields or DVRs.
* Off `D₊(Z)` (the point `O = [0 : 1 : 0]`, G4(b)): in the chart `D₊(Y)`, with `u = X/Y`,
  `v = Z/Y`, the prime contains `u, v`, and `v · w = u³` with `w ≡ 1`, so the maximal ideal of the
  local ring is generated by `u`; a noetherian local domain with principal maximal ideal is a
  valuation ring.

`valuationRing_stalk_ESch : ∀ p : ESch E, ValuationRing ((ESch E).presheaf.stalk p)`.
-/

noncomputable section

set_option backward.isDefEq.respectTransparency false

open AlgebraicGeometry CategoryTheory HomogeneousLocalization

namespace ZInQ.H33D1

open ZInQ.GZSch

/-! ## §1. Commutative algebra -/

theorem valuationRing_of_ringEquiv {A B : Type*} [CommRing A] [CommRing B] [IsDomain A]
    [IsDomain B] (e : A ≃+* B) [ValuationRing A] : ValuationRing B := by
  rw [ValuationRing.iff_dvd_total]
  refine ⟨fun a b => ?_⟩
  rcases (ValuationRing.iff_dvd_total.mp (inferInstance : ValuationRing A)).total (e.symm a)
    (e.symm b) with h | h
  · left; simpa using map_dvd e h
  · right; simpa using map_dvd e h

theorem valuationRing_of_isField {A : Type*} [CommRing A] [IsDomain A] (h : IsField A) :
    ValuationRing A := by
  rw [ValuationRing.iff_dvd_total]
  refine ⟨fun a b => ?_⟩
  by_cases ha : a = 0
  · right; rw [ha]; exact dvd_zero b
  · left
    obtain ⟨c, hc⟩ := h.mul_inv_cancel ha
    exact ⟨c * b, by rw [← mul_assoc, hc, one_mul]⟩

/-- **The localization of a Dedekind domain at a prime is a valuation ring.** -/
theorem valuationRing_localization_dedekind {R : Type*} [CommRing R] [IsDedekindDomain R]
    (P : Ideal R) [P.IsPrime] (S : Type*) [CommRing S] [IsDomain S] [Algebra R S]
    [IsLocalization.AtPrime S P] : ValuationRing S := by
  by_cases hP : P = ⊥
  · subst hP
    haveI := IsLocalization.AtPrime.isLocalRing S (⊥ : Ideal R)
    apply valuationRing_of_isField
    rw [IsLocalRing.isField_iff_maximalIdeal_eq,
      ← IsLocalization.AtPrime.map_eq_maximalIdeal (⊥ : Ideal R) S, Ideal.map_bot]
  · haveI := IsLocalization.AtPrime.isDiscreteValuationRing_of_dedekind_domain R hP S
    infer_instance

/-- **A noetherian local domain with principal maximal ideal is a valuation ring.** -/
theorem valuationRing_of_maximalIdeal_principal {T : Type*} [CommRing T] [IsDomain T]
    [IsNoetherianRing T] [IsLocalRing T] (h : (IsLocalRing.maximalIdeal T).IsPrincipal) :
    ValuationRing T := by
  rw [ValuationRing.iff_dvd_total]
  refine ⟨fun a b => ?_⟩
  by_cases ha : a = 0
  · right; rw [ha]; exact dvd_zero b
  by_cases hb : b = 0
  · left; rw [hb]; exact dvd_zero a
  obtain ⟨i, hi⟩ := exists_maximalIdeal_pow_eq_of_principal T h (Ideal.span {a})
    (by rwa [Ne, Ideal.span_singleton_eq_bot])
  obtain ⟨j, hj⟩ := exists_maximalIdeal_pow_eq_of_principal T h (Ideal.span {b})
    (by rwa [Ne, Ideal.span_singleton_eq_bot])
  rcases le_total i j with hij | hij
  · left
    have hb' : b ∈ Ideal.span {a} := by
      rw [hi]
      exact Ideal.pow_le_pow_right hij (hj ▸ Ideal.mem_span_singleton_self b)
    exact Ideal.mem_span_singleton.mp hb'
  · right
    have ha' : a ∈ Ideal.span {b} := by
      rw [hj]
      exact Ideal.pow_le_pow_right hij (hi ▸ Ideal.mem_span_singleton_self a)
    exact Ideal.mem_span_singleton.mp ha'

/-! ## §2. Local rings through an open immersion -/

/-- `Localization.AtPrime q ≃ 𝒪_{X, j q}` for an open immersion `j : Spec R ⟶ X`. -/
def locEquivStalk {X : Scheme.{0}} {R : CommRingCat.{0}} (j : Spec R ⟶ X) [IsOpenImmersion j]
    (q : Spec R) : Localization.AtPrime q.asIdeal ≃+* X.presheaf.stalk (j q) :=
  ((StructureSheaf.stalkIso R q).toRingEquiv :
      Localization.AtPrime q.asIdeal ≃+* (Spec R).presheaf.stalk q).trans
    (asIso (j.stalkMap q)).commRingCatIsoToRingEquiv.symm

theorem isDomain_loc_of_chart {X : Scheme.{0}} [IsIntegral X] {R : CommRingCat.{0}}
    (j : Spec R ⟶ X) [IsOpenImmersion j] (q : Spec R) : IsDomain (Localization.AtPrime q.asIdeal) :=
  MulEquiv.isDomain (X.presheaf.stalk (j q)) (locEquivStalk j q).toMulEquiv

theorem valuationRing_of_chart {X : Scheme.{0}} [IsIntegral X] {R : CommRingCat.{0}}
    (j : Spec R ⟶ X) [IsOpenImmersion j] (q : Spec R)
    (h : ∀ [IsDomain (Localization.AtPrime q.asIdeal)], ValuationRing (Localization.AtPrime q.asIdeal)) :
    ValuationRing (X.presheaf.stalk (j q)) := by
  haveI := isDomain_loc_of_chart j q
  haveI := @h _
  exact valuationRing_of_ringEquiv (locEquivStalk j q)

theorem valuationRing_of_chart' {X : Scheme.{0}} [IsIntegral X] [IsLocallyNoetherian X]
    {R : CommRingCat.{0}} (j : Spec R ⟶ X) [IsOpenImmersion j] (q : Spec R)
    (h : ∀ [IsDomain (Localization.AtPrime q.asIdeal)] [IsNoetherianRing (Localization.AtPrime q.asIdeal)],
      ValuationRing (Localization.AtPrime q.asIdeal)) :
    ValuationRing (X.presheaf.stalk (j q)) := by
  haveI := isDomain_loc_of_chart j q
  haveI : IsNoetherianRing (Localization.AtPrime q.asIdeal) :=
    isNoetherianRing_of_ringEquiv (X.presheaf.stalk (j q)) (locEquivStalk j q).symm
  haveI := @h _ _
  exact valuationRing_of_ringEquiv (locEquivStalk j q)

/-! ## §3. The chart `D₊(Z)` -/

variable (E : WeierstrassCurve ℚ)

instance isDedekindDomain_CR [E.IsElliptic] : IsDedekindDomain (CR E) := by
  haveI : IsIntegrallyClosed (CR E) :=
    WeierstrassCurve.Affine.isIntegrallyClosed_coordinateRing E.toAffine
  exact WeierstrassCurve.Affine.isDedekindDomain_coordinateRing_of_isIntegrallyClosed E.toAffine

theorem valuationRing_loc_AZ [E.IsElliptic] (q : Spec (CommRingCat.of (AZ E)))
    [IsDomain (Localization.AtPrime q.asIdeal)] : ValuationRing (Localization.AtPrime q.asIdeal) := by
  set T := Localization.AtPrime q.asIdeal
  set e := azEquiv E
  have hloc : IsLocalization.AtPrime T q.asIdeal := inferInstance
  letI : Algebra (CR E) T := ((algebraMap (AZ E) T).comp e.symm.toRingHom).toAlgebra
  haveI : (q.asIdeal.comap e.symm.toRingHom).IsPrime := Ideal.comap_isPrime _ _
  have hmap : q.asIdeal.primeCompl.map e = (q.asIdeal.comap e.symm.toRingHom).primeCompl := by
    ext x
    simp only [Submonoid.mem_map, Ideal.primeCompl, Submonoid.mem_mk, Subsemigroup.mem_mk,
      Set.mem_compl_iff, SetLike.mem_coe, Ideal.mem_comap]
    constructor
    · rintro ⟨y, hy, rfl⟩
      simpa using hy
    · intro hx
      exact ⟨e.symm x, hx, by simp⟩
  have h2 : IsLocalization.AtPrime T (q.asIdeal.comap e.symm.toRingHom) := by
    have := (IsLocalization.isLocalization_iff_of_base_ringEquiv q.asIdeal.primeCompl T e).mp hloc
    rw [hmap] at this
    exact this
  exact valuationRing_localization_dedekind (q.asIdeal.comap e.symm.toRingHom) T

theorem valuationRing_stalk_chartZ [E.IsElliptic] (q : Spec (CommRingCat.of (AZ E))) :
    ValuationRing ((ESch E).presheaf.stalk (chartZ E q)) := by
  exact valuationRing_of_chart (chartZ E) q (valuationRing_loc_AZ E q)

/-! ## §4. The chart `D₊(Y)` at `O` -/

/-- `ℚ → (A)₀ → A_(Y)`. -/
instance algQAY : Algebra ℚ (AY E) :=
  ((algebraMap (gr E 0) (AY E)).comp (algebraMap ℚ (gr E 0))).toAlgebra

/-- `X_i / Y ∈ A_(Y)`: `u = X/Y`, `1`, `v = Z/Y`. -/
def gY (i : Fin 3) : AY E :=
  Away.mk (gr E) (yC_mem E) 1 (E.toProjective.coord i)
    (by simpa using E.toProjective.coord_mem_grading i)

/-- **`F/Yⁿ = F(u, 1, v)` for `F` homogeneous of degree `n`.** -/
theorem away_mk_eq_aeval_Y (n : ℕ) (p : MvPolynomial (Fin 3) ℚ) (hp : p.IsHomogeneous n)
    (h : Ideal.Quotient.mk (Ideal.span {E.toProjective.polynomial}) p ∈ gr E (n • 1)) :
    Away.mk (gr E) (yC_mem E) n (Ideal.Quotient.mk _ p) h = MvPolynomial.aeval (gY E) p := by
  apply val_injective
  set L := Localization.Away (yC E)
  set ψ := algebraMap E.toProjective.CoordinateRing L
  have hval : ∀ a : AY E, a.val = algebraMap (AY E) L a := fun a => rfl
  rw [hval (MvPolynomial.aeval _ p), MvPolynomial.aeval_def, MvPolynomial.eval₂_comp_left]
  rw [Away.val_mk]
  have hzx : ∀ i, ψ (E.toProjective.coord i) = ψ (yC E) * (algebraMap (AY E) L ∘ gY E) i := by
    intro i
    have key := IsLocalization.mk'_spec' L (E.toProjective.coord i)
      (⟨yC E ^ 1, 1, rfl⟩ : Submonoid.powers (yC E))
    simp only [Function.comp_apply, gY]
    rw [← hval, Away.val_mk, Localization.mk_eq_mk']
    convert key.symm using 2
    simp [ψ]
  have hmk : ψ (Ideal.Quotient.mk _ p) = MvPolynomial.eval₂ (ψ.comp (algebraMap ℚ _))
      (fun i => ψ (E.toProjective.coord i)) p := by
    conv_lhs => rw [← MvPolynomial.eval₂_eta p]
    rw [MvPolynomial.eval₂_comp_left, MvPolynomial.eval₂_comp_left]
    rfl
  have hmain : ψ (Ideal.Quotient.mk _ p) = ψ (yC E) ^ n *
      MvPolynomial.eval₂ ((algebraMap (AY E) L).comp (algebraMap ℚ (AY E)))
        (algebraMap (AY E) L ∘ gY E) p := by
    rw [hmk]
    have hfun : (fun i => ψ (E.toProjective.coord i)) =
        fun i => ψ (yC E) * (algebraMap (AY E) L ∘ gY E) i := funext hzx
    rw [hfun, eval₂_mul_homog _ _ _ hp,
      RingHom.ext_rat (ψ.comp (algebraMap ℚ _)) ((algebraMap (AY E) L).comp (algebraMap ℚ (AY E)))]
  rw [Localization.mk_eq_mk', IsLocalization.mk'_eq_iff_eq_mul, hmain]
  simp only [map_pow]
  ring

theorem gY_one : gY E 1 = 1 := by
  apply val_injective
  rw [gY, Away.val_mk, val_one, Localization.mk_eq_mk', IsLocalization.mk'_eq_iff_eq_mul,
    one_mul]
  simp

/-- `v · w = u³` in `A_(Y)`, `w = 1 + a₁u + a₃v − a₂u² − a₄uv − a₆v²`. -/
theorem gY_equation :
    gY E 2 * (1 + algebraMap ℚ (AY E) E.a₁ * gY E 0 + algebraMap ℚ (AY E) E.a₃ * gY E 2 -
      algebraMap ℚ (AY E) E.a₂ * gY E 0 ^ 2 - algebraMap ℚ (AY E) E.a₄ * gY E 0 * gY E 2 -
      algebraMap ℚ (AY E) E.a₆ * gY E 2 ^ 2) = gY E 0 ^ 3 := by
  have hp := E.toProjective.isHomogeneous_polynomial
  have h0 : (Ideal.Quotient.mk (Ideal.span {E.toProjective.polynomial}) E.toProjective.polynomial) = 0 :=
    Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
  have hmem : Ideal.Quotient.mk (Ideal.span {E.toProjective.polynomial}) E.toProjective.polynomial ∈
      gr E (3 • 1) := by simpa using E.toProjective.mk_mem_grading hp
  have h := away_mk_eq_aeval_Y E 3 _ hp hmem
  have hz : Away.mk (gr E) (yC_mem E) 3 _ hmem = 0 := by
    apply val_injective
    rw [Away.val_mk, h0, Localization.mk_zero, val_zero]
  rw [hz] at h
  simp only [WeierstrassCurve.Projective.polynomial, map_sub, map_add, map_mul, map_pow,
    MvPolynomial.aeval_X, MvPolynomial.aeval_C, gY_one, one_pow, one_mul, mul_one] at h
  linear_combination -h

theorem mem_gr_iff' {n : ℕ} {F : E.toProjective.CoordinateRing} (hF : F ∈ gr E (n • 1)) :
    ∃ p : MvPolynomial (Fin 3) ℚ, p.IsHomogeneous n ∧ Ideal.Quotient.mk _ p = F := by
  have : F ∈ gr E n := by simpa using hF
  exact E.toProjective.mem_grading_iff.mp this

/-- **A prime of `A_(Y)` containing `u` and `v` is contained in `(u, v)`.** -/
theorem le_span_uv (q : Ideal (AY E)) [q.IsPrime] (hu : gY E 0 ∈ q) (hv : gY E 2 ∈ q) :
    q ≤ Ideal.span {gY E 0, gY E 2} := by
  set I := Ideal.span {gY E 0, gY E 2}
  intro a ha
  obtain ⟨n, F, hF, rfl⟩ := Away.mk_surjective (gr E) (yC_mem E) a
  obtain ⟨p, hp, rfl⟩ := mem_gr_iff' E hF
  rw [away_mk_eq_aeval_Y E n p hp] at ha ⊢
  set π := Ideal.Quotient.mk I
  set k := π.comp (algebraMap ℚ (AY E))
  have hu' : π (gY E 0) = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (by simp))
  have hv' : π (gY E 2) = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (by simp))
  have hfun : (fun i => π (gY E i)) = k ∘ ![0, 1, 0] := by
    funext i
    fin_cases i
    · simp [hu']
    · simp [gY_one]
    · simp [hv']
  have hπ : π (MvPolynomial.aeval (gY E) p) = k (MvPolynomial.eval ![0, 1, 0] p) := by
    rw [MvPolynomial.map_aeval, MvPolynomial.coe_eval₂Hom, hfun, MvPolynomial.eval,
      MvPolynomial.coe_eval₂Hom, MvPolynomial.eval₂_comp_left, RingHom.comp_id]
  set c := MvPolynomial.eval ![0, 1, 0] p
  have hdiff : MvPolynomial.aeval (gY E) p - algebraMap ℚ (AY E) c ∈ I := by
    rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, hπ]
    simp [k]
  by_cases hc : c = 0
  · rw [hc, map_zero, sub_zero] at hdiff
    exact hdiff
  · exfalso
    have hIq : I ≤ q := by
      rw [Ideal.span_le]
      intro x hx
      rcases hx with rfl | rfl
      · exact hu
      · exact hv
    have hcq : algebraMap ℚ (AY E) c ∈ q := by
      have := q.sub_mem ha (hIq hdiff)
      simpa using this
    have hunit : IsUnit (algebraMap ℚ (AY E) c) := (isUnit_iff_ne_zero.mpr hc).map _
    exact (Ideal.IsPrime.ne_top ‹_›) (Ideal.eq_top_of_isUnit_mem _ hcq hunit)

/-- **The local ring at `O` is a valuation ring**: its maximal ideal is generated by `u`. -/
theorem valuationRing_loc_O (q : Ideal (AY E)) [q.IsPrime] (hv : gY E 2 ∈ q)
    [IsDomain (Localization.AtPrime q)] [IsNoetherianRing (Localization.AtPrime q)] :
    ValuationRing (Localization.AtPrime q) := by
  set T := Localization.AtPrime q
  set w : AY E := 1 + algebraMap ℚ (AY E) E.a₁ * gY E 0 + algebraMap ℚ (AY E) E.a₃ * gY E 2 -
      algebraMap ℚ (AY E) E.a₂ * gY E 0 ^ 2 - algebraMap ℚ (AY E) E.a₄ * gY E 0 * gY E 2 -
      algebraMap ℚ (AY E) E.a₆ * gY E 2 ^ 2 with hw
  have heq := gY_equation E
  rw [← hw] at heq
  have hu : gY E 0 ∈ q := by
    have : gY E 0 ^ 3 ∈ q := heq ▸ q.mul_mem_right _ hv
    exact ‹q.IsPrime›.mem_of_pow_mem 3 this
  have hle := le_span_uv E q hu hv
  have hw1 : w - 1 ∈ q := by
    have : w - 1 = gY E 0 * (algebraMap ℚ (AY E) E.a₁ - algebraMap ℚ (AY E) E.a₂ * gY E 0 -
        algebraMap ℚ (AY E) E.a₄ * gY E 2) +
        gY E 2 * (algebraMap ℚ (AY E) E.a₃ - algebraMap ℚ (AY E) E.a₆ * gY E 2) := by
      rw [hw]; ring
    rw [this]
    exact q.add_mem (q.mul_mem_right _ hu) (q.mul_mem_right _ hv)
  have hwq : w ∉ q := by
    intro hwq
    have : (1 : AY E) ∈ q := by simpa using q.sub_mem hwq hw1
    exact (Ideal.IsPrime.ne_top ‹_›) ((Ideal.eq_top_iff_one q).mpr this)
  have hwu : IsUnit (algebraMap (AY E) T w) :=
    IsLocalization.map_units T (⟨w, hwq⟩ : q.primeCompl)
  set uT := algebraMap (AY E) T (gY E 0)
  set vT := algebraMap (AY E) T (gY E 2)
  have hvT : vT ∈ Ideal.span {uT} := by
    have h1 : vT * algebraMap (AY E) T w = uT ^ 3 := by
      simp only [vT, uT, ← map_mul, ← map_pow, heq]
    rw [Ideal.mem_span_singleton]
    refine ⟨uT ^ 2 * ↑hwu.unit⁻¹, ?_⟩
    calc vT = vT * algebraMap (AY E) T w * ↑hwu.unit⁻¹ := by
          rw [mul_assoc, IsUnit.mul_val_inv, mul_one]
      _ = uT * (uT ^ 2 * ↑hwu.unit⁻¹) := by rw [h1]; ring
  have hm : IsLocalRing.maximalIdeal T = Ideal.span {uT} := by
    apply le_antisymm
    · rw [← IsLocalization.AtPrime.map_eq_maximalIdeal q T]
      refine (Ideal.map_mono hle).trans ?_
      rw [Ideal.map_span, Ideal.span_le]
      rintro _ ⟨x, hx, rfl⟩
      rcases hx with rfl | rfl
      · exact Ideal.mem_span_singleton_self _
      · exact hvT
    · rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe,
        ← IsLocalization.AtPrime.map_eq_maximalIdeal q T]
      exact Ideal.mem_map_of_mem _ hu
  exact valuationRing_of_maximalIdeal_principal ⟨uT, hm⟩

/-- The chart `D₊(Y)` covers the complement of `D₊(Z)`, where `v = Z/Y` vanishes. -/
theorem gY_two_eq : Away.isLocalizationElem (yC_mem E) (zC_mem E) = gY E 2 := by
  apply val_injective
  simp [gY, Away.val_mk]

instance isLocallyNoetherian_ESch : IsLocallyNoetherian (ESch E) := by
  haveI : LocallyOfFiniteType (toSpecQ E) := inferInstance
  exact LocallyOfFiniteType.isLocallyNoetherian (toSpecQ E)

/-- **The local rings of `ESch E` are valuation rings** (`ESch E` is a normal curve). -/
theorem valuationRing_stalk_ESch [E.IsElliptic] (p : ESch E) :
    ValuationRing ((ESch E).presheaf.stalk p) := by
  by_cases hp : p ∈ (chartZ E).opensRange
  · obtain ⟨q, rfl⟩ := hp
    exact valuationRing_stalk_chartZ E q
  · have hp' : p ∉ Proj.basicOpen (gr E) (zC E) := by rwa [opensRange_chartZ] at hp
    have hY := mem_basicOpen_Y_of_not_mem_Z E p hp'
    have hrY : (chartY E).opensRange = Proj.basicOpen (gr E) (yC E) := Proj.opensRange_awayι _ _ _ _
    rw [← hrY] at hY
    obtain ⟨q, rfl⟩ := hY
    have hv : gY E 2 ∈ q.asIdeal := by
      have hpre := Proj.awayι_preimage_basicOpen (gr E) (yC_mem E) one_pos (zC_mem E) one_pos
      by_contra hne
      apply hp'
      have hmem : q ∈ chartY E ⁻¹ᵁ Proj.basicOpen (gr E) (zC E) := by
        rw [chartY, hpre, PrimeSpectrum.mem_basicOpen, gY_two_eq]
        exact hne
      exact hmem
    exact valuationRing_of_chart' (chartY E) q (valuationRing_loc_O E q.asIdeal hv)

/-! ## §5. G4(b): the complement of `D₊(Z)` is the single point `O = [0 : 1 : 0]` -/

theorem eqn_O : (E.toProjective.map (RingHom.id ℚ)).Equation ![0, 1, 0] := by
  rw [WeierstrassCurve.Projective.equation_iff]; simp

/-- Evaluation at `[0 : 1 : 0]` on the homogeneous coordinate ring. -/
def evO : E.toProjective.CoordinateRing →+* ℚ := E.toProjective.evalHom (RingHom.id ℚ) (eqn_O E)

theorem evO_coord (i : Fin 3) : evO E (E.toProjective.coord i) = ![0, 1, 0] i :=
  congrFun (E.toProjective.evalHom_comp_coord (RingHom.id ℚ) (eqn_O E)) i

theorem evO_yC : evO E (yC E) = 1 := evO_coord E 1

theorem isUnit_evO_yC : IsUnit (evO E (yC E)) := isUnit_iff_exists_inv.mpr ⟨1, by rw [evO_yC, one_mul]⟩

/-- **The `ℚ`-point `O = [0 : 1 : 0]` of the chart `D₊(Y)`**: `A_(Y) →+* ℚ`, `F/Yⁿ ↦ F(0, 1, 0)`. -/
def chiO : AY E →+* ℚ :=
  (Localization.awayLift (evO E) (yC E) (isUnit_evO_yC E)).comp
    (algebraMap (AY E) (Localization.Away (yC E)))

theorem chiO_gY (i : Fin 3) : chiO E (gY E i) = ![0, 1, 0] i := by
  change Localization.awayLift (evO E) (yC E) (isUnit_evO_yC E) (gY E i).val = _
  rw [gY, Away.val_mk, Localization.awayLift_mk (evO E) (yC E) _ 1 (by rw [evO_yC, one_mul]),
    evO_coord]
  simp

theorem gY_zero_mem (q : Ideal (AY E)) [q.IsPrime] (hv : gY E 2 ∈ q) : gY E 0 ∈ q := by
  have heq := gY_equation E
  have : gY E 0 ^ 3 ∈ q := heq ▸ q.mul_mem_right _ hv
  exact ‹q.IsPrime›.mem_of_pow_mem 3 this

/-- A prime of `A_(Y)` containing `v = Z/Y` is `(u, v) = ker χ_O`. -/
theorem eq_ker_chiO (q : Ideal (AY E)) [q.IsPrime] (hv : gY E 2 ∈ q) :
    q = RingHom.ker (chiO E) := by
  have hu := gY_zero_mem E q hv
  have hk0 : gY E 0 ∈ RingHom.ker (chiO E) := RingHom.mem_ker.mpr (by rw [chiO_gY]; rfl)
  have hk2 : gY E 2 ∈ RingHom.ker (chiO E) := RingHom.mem_ker.mpr (by rw [chiO_gY]; rfl)
  haveI : (RingHom.ker (chiO E)).IsPrime := RingHom.ker_isPrime _
  have hspan : ∀ J : Ideal (AY E), gY E 0 ∈ J → gY E 2 ∈ J → Ideal.span {gY E 0, gY E 2} ≤ J := by
    intro J h0 h2
    rw [Ideal.span_le]
    intro x hx
    rcases hx with rfl | rfl
    · exact h0
    · exact h2
  exact le_antisymm ((le_span_uv E q hu hv).trans (hspan _ hk0 hk2))
    ((le_span_uv E _ hk0 hk2).trans (hspan _ hu hv))

/-- **The point `O`**: the prime `ker χ_O` of the chart `D₊(Y)`. -/
def ptO : ESch E := chartY E ⟨RingHom.ker (chiO E), RingHom.ker_isPrime _⟩

theorem chartY_mem_Z_iff (q : Spec (CommRingCat.of (AY E))) :
    chartY E q ∈ Proj.basicOpen (gr E) (zC E) ↔ gY E 2 ∉ q.asIdeal := by
  have hpre := Proj.awayι_preimage_basicOpen (gr E) (yC_mem E) one_pos (zC_mem E) one_pos
  change q ∈ chartY E ⁻¹ᵁ Proj.basicOpen (gr E) (zC E) ↔ _
  rw [chartY, hpre, PrimeSpectrum.mem_basicOpen, gY_two_eq]

/-- **G4(b): `V₊(Z) ∩ ESch E = {O}`**: a point lies outside the chart `D₊(Z)` iff it is `O`. -/
theorem not_mem_chartZ_iff (p : ESch E) : p ∉ (chartZ E).opensRange ↔ p = ptO E := by
  rw [opensRange_chartZ]
  constructor
  · intro hp
    have hY := mem_basicOpen_Y_of_not_mem_Z E p hp
    have hrY : (chartY E).opensRange = Proj.basicOpen (gr E) (yC E) := Proj.opensRange_awayι _ _ _ _
    rw [← hrY] at hY
    obtain ⟨q, rfl⟩ := hY
    have hv : gY E 2 ∈ q.asIdeal := by
      by_contra hne
      exact hp ((chartY_mem_Z_iff E q).mpr hne)
    have hq := eq_ker_chiO E q.asIdeal hv
    unfold ptO
    congr 1
    exact PrimeSpectrum.ext hq
  · rintro rfl h
    rw [ptO, chartY_mem_Z_iff] at h
    exact h (RingHom.mem_ker.mpr (by rw [chiO_gY]; rfl))

end ZInQ.H33D1
