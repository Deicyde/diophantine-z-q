import ZInQKernel.Contrib.OneProof.LogPTranscendenceBdR

/-! # Fontaine's crystalline completion and semistable embedding

The integral completion and its image are kept separate. In the log argument
only the printed non-membership over the crystalline fraction field is needed;
non-membership over `B_max` is not a premise of the receiver.
-/

noncomputable section

namespace HDec.PkgI4.FontaineComparison

open BergerBst FontaineSt BmaxOne LogPTransc
open PanBergerSplit (Ainf AinfP)
open _root_.ZInQ.Contrib.G9.BdrKer.Cp (xi ker_fontaineTheta_Cp)

variable (p : ℕ) [Fact p.Prime]

/-- `W(R)[w^n/n! : n ≥ 1]` as a subring of `W(R)[1/p]`. -/
def finiteDividedPowers (w : Ainf p) : Subring (AinfP p) :=
  Subring.closure
    (Set.range (algebraMap (Ainf p) (AinfP p)) ∪
      Set.range (fun n : ℕ => (algebraMap (Ainf p) (AinfP p) w) ^ (n + 1) *
        qpToLoc p ((((n + 1).factorial : ℕ) : ℚ_[p])⁻¹)))

/-- The `p`-adic completion of the ring before passage to `B_dR^+`. -/
abbrev CrystallineCompletion (w : Ainf p) :=
  AdicCompletion (Ideal.span ({(p : finiteDividedPowers p w)} : Set (finiteDividedPowers p w)))
    (finiteDividedPowers p w)

/-- Fontaine, *Le corps des périodes p-adiques*, Astérisque 223 (1994),
Exposé II §2.3.3, p. 78 (`A_cris` is the `p`-adic separated completion of the
sub-`W(R)`-algebra of `W(R)[1/p]` generated by the `ξ^m/m!`), §2.3.4,
pp. 78–79 (`B_cris = A_cris[1/t]`), and §§4.1.1–4.1.3, pp. 83–84 (every
element is a series `Σ a_n ξ^n/n!` with `a_n → 0` `p`-adically, and the
natural map to `B_dR^+` is injective). Agreement on the finite divided powers
fixes the normalization in the actual ambient ring. Proved as
`AcrisImage.fontaineCrystallineImage_proof`; no theorem in this file assumes it. -/
def FontaineCrystallineImage : Prop :=
  ∀ (ℓ : ℕ) [Fact ℓ.Prime] (w : Ainf ℓ)
    (hw : WittVector.fontaineTheta 𝓞_ℂ_[ℓ] ℓ w = 0),
    RingHom.ker (WittVector.fontaineTheta 𝓞_ℂ_[ℓ] ℓ) = Ideal.span {w} →
      ∃ j : CrystallineCompletion ℓ w →+* BDeRhamPlus 𝓞_ℂ_[ℓ] ℓ,
        Function.Injective j ∧
          (∀ x : finiteDividedPowers ℓ w,
            j (algebraMap (finiteDividedPowers ℓ w) (CrystallineCompletion ℓ w) x) =
              (show BDeRhamPlus 𝓞_ℂ_[ℓ] ℓ from
                algebraMap (AinfP ℓ) (AdicCompletion (Ith ℓ) (AinfP ℓ)) (x : AinfP ℓ))) ∧
          Set.range j = AcrisOf ℓ w hw

/-- Inside `B_dR`, the rational algebra generated by the completed integral
image and `t⁻¹`. No completion after inversion is involved. -/
def crystallineFromImage {w : Ainf p} {ε : PreTilt 𝓞_ℂ_[p] p} (h : IsGenEps p ε)
    (j : CrystallineCompletion p w →+* BDeRhamPlus 𝓞_ℂ_[p] p) : Subalgebra ℚ_[p] (BdR p) :=
  Algebra.adjoin ℚ_[p] (toBdR p '' Set.range j ∪ {Ring.inverse (tOf p h)})

/-- Localizing the genuine completed image recovers the live crystalline
coefficients, without identifying the topology of the abstract completion
with the filtration topology of `B_dR^+`. -/
theorem crystallineFromImage_eq {w : Ainf p} (hw : WittVector.fontaineTheta 𝓞_ℂ_[p] p w = 0)
    {ε : PreTilt 𝓞_ℂ_[p] p} (h : IsGenEps p ε)
    {j : CrystallineCompletion p w →+* BDeRhamPlus 𝓞_ℂ_[p] p}
    (hj : Set.range j = AcrisOf p w hw) : crystallineFromImage p h j = BcrisOf p h w hw := by
  unfold crystallineFromImage BcrisOf
  rw [hj]

/-- Fontaine, Astérisque 223 (1994), Exposé II, Lemme 4.3.1, p. 87:
`u = log([p̃]/p)` does not belong to the fraction field of `B_cris`. Stated for
the image presentation `BcrisOf` (Fontaine identifies `B_cris` with its image
in `B_dR`, §4.1.3, pp. 83–84; that `BcrisOf` is this image follows from
`FontaineCrystallineImage`, proved as `AcrisImage.fontaineCrystallineImage_proof`),
with `log(p) = 0`; `NotInFrac` is the cross-multiplied form inside `B_dR`. -/
def FontaineLog431 : Prop :=
  ∀ (ℓ : ℕ) [Fact ℓ.Prime] {ε : PreTilt 𝓞_ℂ_[ℓ] ℓ} (h : IsGenEps ℓ ε),
    NotInFrac ℓ (BcrisOf ℓ h (xi ℓ) (theta_xi' ℓ)) (toBdR ℓ (logPTilde ℓ))

/-- The embedding at the canonical kernel generator, using the exact
crystalline fraction-field statement rather than the stronger `B_max` one. -/
theorem injective_semistable_eval (hlog : FontaineLog431)
    {ε : PreTilt 𝓞_ℂ_[p] p} (h : IsGenEps p ε) :
    Function.Injective
      (Polynomial.aeval (R := BcrisOf p h (xi p) (theta_xi' p)) (toBdR p (logPTilde p))) :=
  transcendental_iff_injective.mp (transcendental_bcris_of_notInFrac p h (hlog p h))

/-- Fontaine II, Théorème 4.2.4, p. 86 (proved in §4.3, pp. 87–89), at
`K = ℚ_p`; Brinon–Conrad Def. 9.2.3 and Thm 9.2.10: the formal polynomial ring
`B_cris[X]`, for the image presentation `BcrisOf` of the coefficients, is
identified with `BstFOf` by `X ↦ log [p̃]`, given `FontaineLog431` (proved as
`fontaineLog431_proof`). -/
def semistablePolyEquiv (hlog : FontaineLog431)
    {ε : PreTilt 𝓞_ℂ_[p] p} (h : IsGenEps p ε) :
    Polynomial (BcrisOf p h (xi p) (theta_xi' p)) ≃ₐ[ℚ_[p]]
      BstFOf p h (xi p) (theta_xi' p) := by
  let ℓ := toBdR p (logPTilde p)
  have e : Polynomial (BcrisOf p h (xi p) (theta_xi' p)) ≃ₐ[BcrisOf p h (xi p) (theta_xi' p)]
      Algebra.adjoin (BcrisOf p h (xi p) (theta_xi' p)) {ℓ} :=
    (AlgEquiv.ofInjective _ (injective_semistable_eval p hlog h)).trans
      (Subalgebra.equivOfEq _ _ (Algebra.adjoin_singleton_eq_range_aeval _ _).symm)
  exact (e.restrictScalars ℚ_[p]).trans
    (Subalgebra.equivOfEq _ _ (bstFOf_eq_adjoin p h (theta_xi' p)).symm)

/-- The equivalence has the actual image of the formal variable, not an
arbitrary isomorphism of period rings. -/
theorem semistablePolyEquiv_X (hlog : FontaineLog431)
    {ε : PreTilt 𝓞_ℂ_[p] p} (h : IsGenEps p ε) :
    (semistablePolyEquiv p hlog h Polynomial.X : BdR p) = toBdR p (logPTilde p) := by
  change Polynomial.aeval (R := BcrisOf p h (xi p) (theta_xi' p)) (toBdR p (logPTilde p))
    Polynomial.X = _
  exact Polynomial.aeval_X _

end HDec.PkgI4.FontaineComparison
