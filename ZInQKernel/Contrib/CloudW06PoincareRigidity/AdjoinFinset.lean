/-!
# A scheme over `Spec k` base changed to `Spec k'`, as a limit over the finitely generated
`k`-subalgebras of `k'`

Let `k → k'` be a ring map. Then `k'` is the filtered colimit of the `k`-subalgebras `k[s]`
generated by the finite subsets `s` of `k'`, so `Spec k'` is the cofiltered limit of the affine
schemes `Spec k[s]`, and for every scheme `X` over `Spec k` the base change
`Spec k' ×_{Spec k} X` is the cofiltered limit of the `Spec k[s] ×_{Spec k} X`, with affine
transition morphisms. When `k` is Noetherian and `X` is proper over `k`, each stage is of finite
type over the Noetherian ring `k[s]`, hence quasi-compact and quasi-separated. This is the
situation in which the limit results of Limits, Section 32.10 (Tags 01ZM, 01ZO, 07RP) apply,
for instance `AlgebraicGeometry.exists_finiteEtale_model`; it is used in this form by the proof
of Tag 0A48 over a henselian G-ring, where `k → k'` is the completion `A → A^∧`.

## Main definitions

* `AlgebraicGeometry.AdjoinFinset.diagram` and `AlgebraicGeometry.AdjoinFinset.cocone` — the
  finitely generated subalgebras of `k'` and their inclusions into `k'`.
* `AlgebraicGeometry.AdjoinFinset.bcDiagram` and `AlgebraicGeometry.AdjoinFinset.bcCone` — the
  inverse system `{ Spec k[s] ×_{Spec k} X }` and its cone with vertex `Spec k' ×_{Spec k} X`.
* `AlgebraicGeometry.AdjoinFinset.bcProj` — the projection of that cone, written between
  pullbacks.

## Main results

* `AlgebraicGeometry.AdjoinFinset.isColimitCocone` — `k'` is the filtered colimit of the `k[s]`.
* `AlgebraicGeometry.AdjoinFinset.isLimitBcCone` — `X_{k'}` is the limit of the `X_{k[s]}`.
* `AlgebraicGeometry.AdjoinFinset.bcDiagram_compactSpace_and_quasiSeparatedSpace` and
  `AlgebraicGeometry.AdjoinFinset.bcDiagram_isAffineHom` — the stages are quasi-compact and
  quasi-separated, and the transition morphisms affine.

## Implementation notes

Mathlib's base-change functor `CategoryTheory.Over.pullback f` sends `Z ⟶ Spec k` to the second
projection of `Z ×_{Spec k} X`, so the stages are pullbacks with the `Spec` factor first.

The index category is `Finset k'` rather than the poset of finite-type subalgebras of `k'`: the
subalgebra generated by a finite set is of finite type, and the filtered-colimit criterion
`CategoryTheory.Limits.Types.FilteredColimit.isColimitOf'` is immediate for this indexing.

`CategoryTheory.isConnected_of_hasTerminal` is installed as a local instance so that the forgetful
functor of an over category is seen to preserve the limits over `(Finset k')ᵒᵖ`, which has `∅` as
a terminal object.
-/

@[expose] public section

open CategoryTheory Limits

universe u

attribute [local instance] CategoryTheory.isConnected_of_hasTerminal

open AlgebraicGeometry

namespace ZInQ.Contrib.CloudW06PoincareRigidity

namespace AdjoinFinset

section Diagram

/-- The filtered diagram of finitely generated `k`-subalgebras of a `k`-algebra `k'`, indexed by
the finite subsets of `k'` ordered by inclusion: `s` is sent to the subalgebra `k[s]`. -/
def diagram (k k' : Type u) [CommRing k] [CommRing k'] [Algebra k k'] :
    Finset k' ⥤ CommRingCat.{u} where
  obj s := CommRingCat.of (Algebra.adjoin k (s : Set k'))
  map h := CommRingCat.ofHom
    (Subalgebra.inclusion (Algebra.adjoin_mono (Finset.coe_subset.mpr (leOfHom h)))).toRingHom

/-- The cocone over `AlgebraicGeometry.AdjoinFinset.diagram` with vertex `k'`, whose legs are the
inclusions `k[s] ⊆ k'`. -/
def cocone (k k' : Type u) [CommRing k] [CommRing k'] [Algebra k k'] :
    Cocone (diagram k k') where
  pt := CommRingCat.of k'
  ι := { app := fun s => CommRingCat.ofHom (Algebra.adjoin k (s : Set k')).val.toRingHom }

/-- **A `k`-algebra is the filtered colimit of its finitely generated `k`-subalgebras.** The
forgetful functor to types reflects this colimit, and on underlying sets every element of `k'` lies
in the subalgebra generated by the singleton it spans, and the legs are injective. -/
noncomputable def isColimitCocone (k k' : Type u) [CommRing k] [CommRing k'] [Algebra k k'] :
    IsColimit (cocone k k') :=
  have := reflectsColimit_of_reflectsIsomorphisms (diagram k k') (forget CommRingCat)
  isColimitOfReflects (forget CommRingCat) <| Types.FilteredColimit.isColimitOf' _ _
    (fun x => ⟨{x}, ⟨x, Algebra.subset_adjoin (Finset.mem_singleton_self x)⟩, rfl⟩)
    fun i x y h => ⟨i, 𝟙 i, by rw [Subtype.ext h]⟩

/-- The inverse system of affine schemes `Spec k[s]`. -/
noncomputable def specDiagram (k k' : Type u) [CommRing k] [CommRing k'] [Algebra k k'] :
    (Finset k')ᵒᵖ ⥤ Scheme.{u} :=
  (diagram k k').op ⋙ Scheme.Spec

/-- Each `Spec k[s]` lies over `Spec k`, compatibly with the transition morphisms. -/
noncomputable def specToBase (k k' : Type u) [CommRing k] [CommRing k'] [Algebra k k'] :
    specDiagram k k' ⟶ (Functor.const (Finset k')ᵒᵖ).obj (Spec (.of k)) where
  app i := Spec.map (CommRingCat.ofHom (algebraMap k (Algebra.adjoin k (i.unop : Set k'))))
  naturality i j e := by
    dsimp [specDiagram, diagram]
    rw [← Spec.map_comp]
    simp only [Category.comp_id]
    rw [Spec.map_inj]
    exact CommRingCat.hom_ext (by ext x; rfl)

/-- `AlgebraicGeometry.AdjoinFinset.specDiagram` as a diagram of schemes over `Spec k`. -/
noncomputable def specOverDiagram (k k' : Type u) [CommRing k] [CommRing k'] [Algebra k k'] :
    (Finset k')ᵒᵖ ⥤ Over (Spec (.of k)) :=
  Over.lift (specDiagram k k') (specToBase k k')

/-- The cone with vertex `Spec k'` obtained by applying `Spec` to
`AlgebraicGeometry.AdjoinFinset.cocone`. -/
noncomputable def specCone (k k' : Type u) [CommRing k] [CommRing k'] [Algebra k k'] :
    Cone (specDiagram k k') :=
  Scheme.Spec.mapCone (cocone k k').op

/-- `Spec k'` is the limit of the `Spec k[s]`. -/
noncomputable def isLimitSpecCone (k k' : Type u) [CommRing k] [CommRing k'] [Algebra k k'] :
    IsLimit (specCone k k') :=
  isLimitOfPreserves _ (isColimitCocone k k').op

/-- The legs of `AlgebraicGeometry.AdjoinFinset.specCone` lie over `Spec k`. -/
theorem specCone_π_comp (k k' : Type u) [CommRing k] [CommRing k'] [Algebra k k']
    (i : (Finset k')ᵒᵖ) :
    (specCone k k').π.app i ≫ (specToBase k k').app i
      = Spec.map (CommRingCat.ofHom (algebraMap k k')) := by
  dsimp [specCone, specToBase, specDiagram, cocone, diagram]
  rw [← Spec.map_comp, Spec.map_inj]
  exact CommRingCat.hom_ext (by ext x; rfl)

/-- The cone of `AlgebraicGeometry.AdjoinFinset.specOverDiagram` with vertex `Spec k'`. -/
noncomputable def specOverCone (k k' : Type u) [CommRing k] [CommRing k'] [Algebra k k'] :
    Cone (specOverDiagram k k') :=
  Over.liftCone (specDiagram k k') (specToBase k k') (specCone k k')
    (Spec.map (CommRingCat.ofHom (algebraMap k k'))) (specCone_π_comp k k')

/-- `Spec k'` is the limit of the `Spec k[s]` in schemes over `Spec k`. -/
noncomputable def isLimitSpecOverCone (k k' : Type u) [CommRing k] [CommRing k'] [Algebra k k'] :
    IsLimit (specOverCone k k') :=
  have : Nonempty (Finset k')ᵒᵖ := ⟨Opposite.op ∅⟩
  Over.isLimitLiftCone (specDiagram k k') (specToBase k k') (specCone k k') _
    (specCone_π_comp k k') (isLimitSpecCone k k')

end Diagram

section BaseChange

/-- The inverse system `{ Spec k[s] ×_{Spec k} X }`. -/
noncomputable def bcDiagram (k k' : Type u) [CommRing k] [CommRing k'] [Algebra k k']
    {X : Scheme.{u}} (f : X ⟶ Spec (.of k)) : (Finset k')ᵒᵖ ⥤ Scheme.{u} :=
  specOverDiagram k k' ⋙ Over.pullback f ⋙ Over.forget X

/-- The cone over `AlgebraicGeometry.AdjoinFinset.bcDiagram` with vertex
`Spec k' ×_{Spec k} X`. -/
noncomputable def bcCone (k k' : Type u) [CommRing k] [CommRing k'] [Algebra k k']
    {X : Scheme.{u}} (f : X ⟶ Spec (.of k)) : Cone (bcDiagram k k' f) :=
  (Over.pullback f ⋙ Over.forget X).mapCone (specOverCone k k')

/-- **`X_{k'}` is the limit of the `X_{k[s]}`.** Base change along `f` is a right adjoint, hence
preserves limits, and the forgetful functor of an over category preserves limits over a connected
index category. -/
noncomputable def isLimitBcCone (k k' : Type u) [CommRing k] [CommRing k'] [Algebra k k']
    {X : Scheme.{u}} (f : X ⟶ Spec (.of k)) : IsLimit (bcCone k k' f) :=
  isLimitOfPreserves (Over.pullback f ⋙ Over.forget X) (isLimitSpecOverCone k k')

/-- The projection `X_{k'} ⟶ X_{k[s]}` of `AlgebraicGeometry.AdjoinFinset.bcCone`, with its
source and target written as pullbacks. -/
noncomputable def bcProj (k k' : Type u) [CommRing k] [CommRing k'] [Algebra k k']
    {X : Scheme.{u}} (f : X ⟶ Spec (.of k)) (i : (Finset k')ᵒᵖ) :
    pullback (Spec.map (CommRingCat.ofHom (algebraMap k k'))) f ⟶
      pullback (Spec.map (CommRingCat.ofHom
        (algebraMap k (Algebra.adjoin k (i.unop : Set k'))))) f :=
  (bcCone k k' f).π.app i

/-- The projection `AlgebraicGeometry.AdjoinFinset.bcProj` lies over `X`. -/
theorem bcProj_snd (k k' : Type u) [CommRing k] [CommRing k'] [Algebra k k']
    {X : Scheme.{u}} (f : X ⟶ Spec (.of k)) (i : (Finset k')ᵒᵖ) :
    bcProj k k' f i ≫
        pullback.snd (Spec.map (CommRingCat.ofHom
          (algebraMap k (Algebra.adjoin k (i.unop : Set k'))))) f =
      pullback.snd (Spec.map (CommRingCat.ofHom (algebraMap k k'))) f :=
  pullback.lift_snd _ _ _

/-- The projection `AlgebraicGeometry.AdjoinFinset.bcProj` lies over the inclusion
`Spec k' ⟶ Spec k[s]`. -/
theorem bcProj_fst (k k' : Type u) [CommRing k] [CommRing k'] [Algebra k k']
    {X : Scheme.{u}} (f : X ⟶ Spec (.of k)) (i : (Finset k')ᵒᵖ) :
    bcProj k k' f i ≫
        pullback.fst (Spec.map (CommRingCat.ofHom
          (algebraMap k (Algebra.adjoin k (i.unop : Set k'))))) f =
      pullback.fst (Spec.map (CommRingCat.ofHom (algebraMap k k'))) f ≫
        Spec.map (CommRingCat.ofHom (Algebra.adjoin k (i.unop : Set k')).val.toRingHom) :=
  pullback.lift_fst _ _ _

/-- For `k` Noetherian and `X` proper over `k`, each stage of
`AlgebraicGeometry.AdjoinFinset.bcDiagram` is quasi-compact and quasi-separated: it is of finite
type over the Noetherian ring `k[s]`. -/
theorem bcDiagram_compactSpace_and_quasiSeparatedSpace (k k' : Type u) [CommRing k]
    [CommRing k'] [Algebra k k'] {X : Scheme.{u}} (f : X ⟶ Spec (.of k))
    [IsNoetherianRing k] [IsProper f] (i : (Finset k')ᵒᵖ) :
    CompactSpace ((bcDiagram k k' f).obj i) ∧
      QuasiSeparatedSpace ((bcDiagram k k' f).obj i) := by
  let A := Algebra.adjoin k (i.unop : Set k')
  have : Algebra.FiniteType k A :=
    (Subalgebra.fg_iff_finiteType _).mp (Subalgebra.fg_adjoin_finset _)
  have : IsNoetherianRing A := Algebra.FiniteType.isNoetherianRing k A
  let g : Spec (.of A) ⟶ Spec (.of k) := Spec.map (CommRingCat.ofHom (algebraMap k A))
  have : LocallyOfFiniteType g := by
    rw [HasRingHomProperty.Spec_iff (P := @LocallyOfFiniteType)]
    exact RingHom.finiteType_algebraMap.mpr inferInstance
  have : CompactSpace X := QuasiCompact.compactSpace_of_compactSpace f
  have : IsLocallyNoetherian X := LocallyOfFiniteType.isLocallyNoetherian f
  have : IsLocallyNoetherian (pullback g f) :=
    LocallyOfFiniteType.isLocallyNoetherian (pullback.snd g f)
  refine ⟨?_, ?_⟩
  · change CompactSpace ↥(pullback g f)
    infer_instance
  · change QuasiSeparatedSpace ↥(pullback g f)
    exact IsLocallyNoetherian.quasiSeparatedSpace

/-- The transition morphisms of `AlgebraicGeometry.AdjoinFinset.bcDiagram` are affine: they are
base changes of morphisms of affine schemes. -/
theorem bcDiagram_isAffineHom (k k' : Type u) [CommRing k] [CommRing k'] [Algebra k k']
    {X : Scheme.{u}} (f : X ⟶ Spec (.of k)) {i j : (Finset k')ᵒᵖ} (e : i ⟶ j) :
    IsAffineHom ((bcDiagram k k' f).map e) := by
  change IsAffineHom (((Over.pullback f).map ((specOverDiagram k k').map e)).left)
  refine MorphismProperty.overPullbackMap f ((specOverDiagram k k').map e) ?_
  change IsAffineHom ((specDiagram k k').map e)
  have (l : (Finset k')ᵒᵖ) : IsAffine ((specDiagram k k').obj l) := by
    dsimp [specDiagram, diagram]; infer_instance
  exact isAffineHom_of_isAffine _

end BaseChange

end AdjoinFinset

end ZInQ.Contrib.CloudW06PoincareRigidity

