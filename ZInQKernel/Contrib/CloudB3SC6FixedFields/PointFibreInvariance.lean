import ZInQKernel.Contrib.CloudB3SC6FixedFields.SectionDetection
import ZInQKernel.Contrib.OneProof.ElkiesX6StarPrinted

/-!
# The point-fibre clause forces invariance of Elkies' coordinate germ

This is one direction of the missing converse, not a proof of the existential
`ElkiesX6StarFunctionField` leaf. It preserves the existing function-field-to-fibre
proofs and does not construct any fine or coarse moduli witness.
-/

namespace CloudB3SC6FixedFields

open CategoryTheory AlgebraicGeometry Limits
open _root_.HDec.LeafQM _root_.HDec.LeafQM.AV
open HDec.QMSplit.Moduli HDec.QMSplit.Moduli.ElkiesCoord

section Coordinate

variable {X : Over (Spec (CommRingCat.of ℚ))} [IsIntegral X.left]
variable [Flat X.hom] [LocallyOfFiniteType X.hom]

/-- An automorphism preserving all algebraic-point values fixes the coordinate in the function
field. The point-to-germ step uses section detection, not an assumed quotient dictionary. -/
theorem ffPullback_coordinate_of_value_invariant {t : ToP1 X.left}
    (hη : genericPoint X.left ∈ t.U) (g : X ≅ X)
    (H : ∀ x : fieldPt Qbar ⟶ X,
      t.val (K := Qbar) (x ≫ g.hom).left = t.val (K := Qbar) x.left) :
    ffPullback (Z := X.left) ((Over.forget _).mapIso g) (X.left.presheaf.germ t.U _ hη t.f) =
      X.left.presheaf.germ t.U _ hη t.f := by
  let g₀ : X.left ≅ X.left := (Over.forget _).mapIso g
  have hη' : genericPoint X.left ∈ g₀.hom ⁻¹ᵁ t.U := mem_preimage_gen g₀ hη
  rw [ffPullback_germ g₀ t.U hη hη']
  apply germ_eq_of_geometric_values (RingHom.injective (algebraMap ℚ Qbar)) X.hom hη' hη
  intro y hy hy' hyU
  let x : fieldPt Qbar ⟶ X := Over.homMk y (X6Glue.specQ_hom_ext _ _)
  have himg : (Scheme.SpecToEquivOfField Qbar X.left (y ≫ g₀.hom)).1 ∈ t.U := by
    rw [pt_comp]
    exact hy'
  have he := H x
  change t.val (K := Qbar) (y ≫ g₀.hom) = t.val (K := Qbar) y at he
  unfold ToP1.val at he
  rw [dif_pos himg, dif_pos hyU] at he
  have he' := Option.some_injective _ he
  change X6Glue.ev t.U (y ≫ g₀.hom) himg t.f = X6Glue.ev t.U y hyU t.f at he'
  rw [ev_comp_hom g₀.hom t.U y himg hy'] at he'
  exact he'

end Coordinate

section Fibre

variable {Y : Over (Spec (CommRingCat.of ℚ))} {Φ : PtEquiv Y}
variable {X : Over (Spec (CommRingCat.of ℚ))}
variable {Ψ : (fieldPt Qbar ⟶ X) ≃ Quotient (pairSetoid Qbar)} {fY : Y ⟶ X}

/-- On any coarse witness with the point-fibre clause, the coordinate belongs to the fixed set.
This is the easy containment of the missing function-field converse. -/
theorem coordinate_mem_fixedByW_of_point_fibres (h6 : X6Props Y Φ X Ψ fY)
    [IsIntegral X.left] {t : ToP1 X.left} (hη : genericPoint X.left ∈ t.U)
    (hfib : ∀ x x' : fieldPt Qbar ⟶ X,
      t.val (K := Qbar) x.left = t.val (K := Qbar) x'.left ↔
        ∃ g ∈ ElkiesX6Star.atkinLehnerW X Ψ, x ≫ g.hom = x') :
    X.left.presheaf.germ t.U _ hη t.f ∈ fixedByW Ψ := by
  haveI : SmoothOfRelativeDimension 1 X.hom := h6.2.1
  haveI : Smooth X.hom := SmoothOfRelativeDimension.smooth 1 X.hom
  intro g hg
  apply ffPullback_coordinate_of_value_invariant hη g
  intro x
  exact ((hfib x (x ≫ g.hom)).mpr ⟨g, hg, rfl⟩).symm

/-- Every rational function generated by the coordinate is fixed by `W`, from point fibres.
No equality of fixed fields is assumed. -/
theorem closure_coordinate_le_fixedByW_of_point_fibres (h6 : X6Props Y Φ X Ψ fY)
    [IsIntegral X.left] {t : ToP1 X.left} (hη : genericPoint X.left ∈ t.U)
    (hfib : ∀ x x' : fieldPt Qbar ⟶ X,
      t.val (K := Qbar) x.left = t.val (K := Qbar) x'.left ↔
        ∃ g ∈ ElkiesX6Star.atkinLehnerW X Ψ, x ≫ g.hom = x') :
    (Subfield.closure {X.left.presheaf.germ t.U _ hη t.f} : Set X.left.functionField) ⊆
      fixedByW Ψ := by
  intro a ha g hg
  have hle : Subfield.closure {X.left.presheaf.germ t.U _ hη t.f} ≤
      RingHom.eqLocusField (ffPullback (Z := X.left) ((Over.forget _).mapIso g)) (RingHom.id _) := by
    rw [Subfield.closure_le, Set.singleton_subset_iff]
    exact coordinate_mem_fixedByW_of_point_fibres h6 hη hfib g hg
  exact hle ha

end Fibre

end CloudB3SC6FixedFields
