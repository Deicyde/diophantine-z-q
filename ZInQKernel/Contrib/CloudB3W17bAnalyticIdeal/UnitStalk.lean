import Mathlib.Algebra.Category.ModuleCat.Stalk

/-!
# The stalk of the unit presheaf of modules is the stalk ring

For a presheaf of commutative rings `R` on a space `X`, the stalk at `x` of the unit presheaf of
modules (as an `R_x`-module via Mathlib's stalk module structure) is free of rank one, generated by
the germ of `1`: `r ↦ r • germ 1` is an `R_x`-linear bijection, and `germ_R(m) • germ 1` is the
module germ of `m`.
-/

open CategoryTheory TopologicalSpace Opposite

universe u

namespace ZInQ.Contrib.CloudB3W17bAnalyticIdeal.PM

variable {X : TopCat.{u}} (R : X.Presheaf CommRingCat.{u}) (x : X)

/-- The unit presheaf of modules over `R`. -/
noncomputable abbrev unitPM : PresheafOfModules.{u} (R ⋙ forget₂ CommRingCat RingCat) :=
  PresheafOfModules.unit _

/-- The (abelian-group) stalk of the unit presheaf of modules; Mathlib's stalk module structure
makes it an `R_x`-module. -/
noncomputable abbrev unitStalk : AddCommGrpCat.{u} :=
  TopCat.Presheaf.stalk (C := AddCommGrpCat.{u}) (X := X) (unitPM R).presheaf x

/-- A section of `R` viewed as a section of the unit presheaf of modules. -/
def asUnitSec {U : Opens X} (m : R.obj (op U)) : (unitPM R).obj (op U) := m

/-- The germ of `1` in the stalk of the unit presheaf of modules. -/
noncomputable def unitStalkGen : unitStalk R x :=
  TopCat.Presheaf.germ (unitPM R).presheaf ⊤ x trivial (asUnitSec R (1 : R.obj (op ⊤)))

variable {R x}

theorem unitStalkGen_eq (U : Opens X) (hx : x ∈ U) :
    unitStalkGen R x = TopCat.Presheaf.germ (unitPM R).presheaf U x hx
      (asUnitSec R (1 : R.obj (op U))) := by
  have hmap : (unitPM R).presheaf.map (homOfLE le_top : U ⟶ ⊤).op
      (asUnitSec R (1 : R.obj (op ⊤))) = asUnitSec R (1 : R.obj (op U)) :=
    (R.map (homOfLE le_top : U ⟶ ⊤).op).hom.map_one
  exact (TopCat.Presheaf.germ_res_apply _ (homOfLE le_top : U ⟶ ⊤) x hx _).symm.trans
    (congrArg _ hmap)

/-- **Germ compatibility**: `germ_R(m) • germ 1 = germ(m)` in the unit stalk. -/
theorem smul_unitStalkGen (U : Opens X) (hx : x ∈ U) (m : R.obj (op U)) :
    (R.germ U x hx m) • unitStalkGen R x =
      TopCat.Presheaf.germ (unitPM R).presheaf U x hx (asUnitSec R m) := by
  have hsm : (m • asUnitSec R (1 : R.obj (op U)) : (unitPM R).obj (op U)) = asUnitSec R m :=
    mul_one m
  have h := PresheafOfModules.germ_smul (R := R) (unitPM R) x U hx m
    (asUnitSec R (1 : R.obj (op U)))
  exact (congrArg _ (unitStalkGen_eq U hx)).trans (h.symm.trans (congrArg _ hsm))

variable (R x)

/-- `r ↦ r • germ 1`. -/
noncomputable def unitStalkMap : R.stalk x →ₗ[R.stalk x] unitStalk R x :=
  LinearMap.toSpanSingleton _ _ (unitStalkGen R x)

theorem unitStalkMap_apply (r : R.stalk x) : unitStalkMap R x r = r • unitStalkGen R x :=
  rfl

/-- **Cyclic generation by the germ of `1`, with trivial annihilator.** -/
theorem bijective_unitStalkMap : Function.Bijective (unitStalkMap R x) := by
  constructor
  · rw [← LinearMap.ker_eq_bot, LinearMap.ker_eq_bot']
    intro r hr
    obtain ⟨U, hx, r₀, rfl⟩ := TopCat.Presheaf.exists_germ_eq R r
    have h1 : TopCat.Presheaf.germ (unitPM R).presheaf U x hx (asUnitSec R r₀) =
        TopCat.Presheaf.germ (unitPM R).presheaf U x hx 0 :=
      (smul_unitStalkGen U hx r₀).symm.trans ((unitStalkMap_apply R x _).symm.trans
        (hr.trans (map_zero _).symm))
    obtain ⟨W, hW, iU, iU', he⟩ := TopCat.Presheaf.germ_eq _ x hx hx _ _ h1
    have h2 : R.map iU.op r₀ = 0 := he.trans (map_zero _)
    exact ((TopCat.Presheaf.germ_res_apply R iU x hW r₀).symm.trans
      (congrArg _ h2)).trans (map_zero _)
  · intro t
    obtain ⟨U, hx, m, rfl⟩ := TopCat.Presheaf.exists_germ_eq (unitPM R).presheaf t
    exact ⟨R.germ U x hx m, smul_unitStalkGen U hx m⟩

/-- **The stalk of the unit presheaf of modules is the stalk ring.** -/
noncomputable def unitStalkEquiv : unitStalk R x ≃ₗ[R.stalk x] R.stalk x :=
  (LinearEquiv.ofBijective (unitStalkMap R x) (bijective_unitStalkMap R x)).symm

theorem unitStalkEquiv_symm_apply (r : R.stalk x) :
    (unitStalkEquiv R x).symm r = r • unitStalkGen R x :=
  rfl

end ZInQ.Contrib.CloudB3W17bAnalyticIdeal.PM
