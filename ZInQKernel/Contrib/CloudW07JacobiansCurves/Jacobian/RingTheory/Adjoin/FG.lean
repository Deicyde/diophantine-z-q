import Mathlib.RingTheory.Adjoin.FG

/-!
# The directed system of finitely generated subalgebras

Finitely generated subalgebras form a nonempty directed poset and exhaust the
ambient algebra.
-/

namespace Subalgebra

variable (baseRing algebraRing : Type*) [CommRing baseRing] [CommRing algebraRing]
  [Algebra baseRing algebraRing]

instance : Nonempty {subalgebra : Subalgebra baseRing algebraRing // subalgebra.FG} :=
  ⟨⟨⊥, fg_bot⟩⟩

instance : IsDirectedOrder {subalgebra : Subalgebra baseRing algebraRing // subalgebra.FG} where
  directed firstSubalgebra secondSubalgebra :=
    ⟨⟨_, firstSubalgebra.2.sup secondSubalgebra.2⟩,
      Subtype.coe_le_coe.mp le_sup_left, Subtype.coe_le_coe.mp le_sup_right⟩

/-- The algebra generated by one element, regarded as a finitely generated subalgebra. -/
def fgAdjoinSingleton (element : algebraRing) :
    {subalgebra : Subalgebra baseRing algebraRing // subalgebra.FG} :=
  ⟨Algebra.adjoin baseRing {element}, ⟨{element}, by simp⟩⟩

@[simp]
lemma self_mem_fgAdjoinSingleton (element : algebraRing) :
    element ∈ (fgAdjoinSingleton baseRing algebraRing element).1 :=
  Algebra.self_mem_adjoin_singleton baseRing element

/-- Every element belongs to a finitely generated subalgebra. -/
lemma iSup_val_fg_eq_top :
    ⨆ subalgebra : {subalgebra : Subalgebra baseRing algebraRing // subalgebra.FG},
      subalgebra.1 = ⊤ :=
  le_antisymm le_top fun element _ ↦
    le_iSup (fun subalgebra : {subalgebra : Subalgebra baseRing algebraRing // subalgebra.FG} ↦
      subalgebra.1) (fgAdjoinSingleton baseRing algebraRing element)
        (self_mem_fgAdjoinSingleton baseRing algebraRing element)

end Subalgebra
