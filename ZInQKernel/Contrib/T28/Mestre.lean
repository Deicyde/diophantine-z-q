section M3
variable {K : Type*} [Field K]

/-- The identities M3 at one sextic `f`. -/
def M3At (f : Fin 7 → K) : Prop :=
  (∀ i j, pair (yv f i) (yv f j) = gramJ (J2 f) (J4 f) (J6 f) (J10 f) i j) ∧
    (∀ i j k, p6 f (cub (yv f i) (yv f j) (yv f k)) = cubJ (J2 f) (J4 f) (J6 f) (J10 f) i j k)

theorem pair_comm' (u v : Fin 3 → K) : pair u v = pair v u := by simp only [pair]; ring

theorem cub_swap12 (u v w : Fin 3 → K) : cub u v w = cub v u w := by
  funext m; fin_cases m <;> simp only [cub, Matrix.cons_val, Fin.zero_eta, Fin.mk_one] <;> ring

theorem cub_swap23 (u v w : Fin 3 → K) : cub u v w = cub u w v := by
  funext m; fin_cases m <;> simp only [cub, Matrix.cons_val, Fin.zero_eta, Fin.mk_one] <;> ring

theorem m3At_nf [CharZero K] (p q r s : K) : M3At (nf p q r s) := by
  refine ⟨fun i j => ?_, fun i j k => ?_⟩

  · match i, j with
    | 0, 0 => exact nf_G11 p q r s
    | 0, 1 => exact nf_G12 p q r s
    | 0, 2 => exact nf_G13 p q r s
    | 1, 0 => rw [pair_comm']; exact nf_G12 p q r s
    | 1, 1 => exact nf_G22 p q r s
    | 1, 2 => exact nf_G23 p q r s
    | 2, 0 => rw [pair_comm']; exact nf_G13 p q r s
    | 2, 1 => rw [pair_comm']; exact nf_G23 p q r s
    | 2, 2 => exact nf_G33 p q r s
  · match i, j, k with
    | 0, 0, 0 => exact nf_a111 p q r s
    | 0, 0, 1 => exact nf_a112 p q r s
    | 0, 0, 2 => exact nf_a113 p q r s
    | 0, 1, 0 => rw [cub_swap23 (yv (nf p q r s) 0) (yv (nf p q r s) 1) (yv (nf p q r s) 0)]; exact nf_a112 p q r s
    | 0, 1, 1 => exact nf_a122 p q r s
    | 0, 1, 2 => exact nf_a123 p q r s
    | 0, 2, 0 => rw [cub_swap23 (yv (nf p q r s) 0) (yv (nf p q r s) 2) (yv (nf p q r s) 0)]; exact nf_a113 p q r s
    | 0, 2, 1 => rw [cub_swap23 (yv (nf p q r s) 0) (yv (nf p q r s) 2) (yv (nf p q r s) 1)]; exact nf_a123 p q r s
    | 0, 2, 2 => exact nf_a133 p q r s
    | 1, 0, 0 => rw [cub_swap12 (yv (nf p q r s) 1) (yv (nf p q r s) 0) (yv (nf p q r s) 0), cub_swap23 (yv (nf p q r s) 0) (yv (nf p q r s) 1) (yv (nf p q r s) 0)]; exact nf_a112 p q r s
    | 1, 0, 1 => rw [cub_swap12 (yv (nf p q r s) 1) (yv (nf p q r s) 0) (yv (nf p q r s) 1)]; exact nf_a122 p q r s
    | 1, 0, 2 => rw [cub_swap12 (yv (nf p q r s) 1) (yv (nf p q r s) 0) (yv (nf p q r s) 2)]; exact nf_a123 p q r s
    | 1, 1, 0 => rw [cub_swap23 (yv (nf p q r s) 1) (yv (nf p q r s) 1) (yv (nf p q r s) 0), cub_swap12 (yv (nf p q r s) 1) (yv (nf p q r s) 0) (yv (nf p q r s) 1)]; exact nf_a122 p q r s
    | 1, 1, 1 => exact nf_a222 p q r s
    | 1, 1, 2 => exact nf_a223 p q r s
    | 1, 2, 0 => rw [cub_swap23 (yv (nf p q r s) 1) (yv (nf p q r s) 2) (yv (nf p q r s) 0), cub_swap12 (yv (nf p q r s) 1) (yv (nf p q r s) 0) (yv (nf p q r s) 2)]; exact nf_a123 p q r s
    | 1, 2, 1 => rw [cub_swap23 (yv (nf p q r s) 1) (yv (nf p q r s) 2) (yv (nf p q r s) 1)]; exact nf_a223 p q r s
    | 1, 2, 2 => exact nf_a233 p q r s
    | 2, 0, 0 => rw [cub_swap12 (yv (nf p q r s) 2) (yv (nf p q r s) 0) (yv (nf p q r s) 0), cub_swap23 (yv (nf p q r s) 0) (yv (nf p q r s) 2) (yv (nf p q r s) 0)]; exact nf_a113 p q r s
    | 2, 0, 1 => rw [cub_swap12 (yv (nf p q r s) 2) (yv (nf p q r s) 0) (yv (nf p q r s) 1), cub_swap23 (yv (nf p q r s) 0) (yv (nf p q r s) 2) (yv (nf p q r s) 1)]; exact nf_a123 p q r s
    | 2, 0, 2 => rw [cub_swap12 (yv (nf p q r s) 2) (yv (nf p q r s) 0) (yv (nf p q r s) 2)]; exact nf_a133 p q r s
    | 2, 1, 0 => rw [cub_swap12 (yv (nf p q r s) 2) (yv (nf p q r s) 1) (yv (nf p q r s) 0), cub_swap23 (yv (nf p q r s) 1) (yv (nf p q r s) 2) (yv (nf p q r s) 0), cub_swap12 (yv (nf p q r s) 1) (yv (nf p q r s) 0) (yv (nf p q r s) 2)]; exact nf_a123 p q r s
    | 2, 1, 1 => rw [cub_swap12 (yv (nf p q r s) 2) (yv (nf p q r s) 1) (yv (nf p q r s) 1), cub_swap23 (yv (nf p q r s) 1) (yv (nf p q r s) 2) (yv (nf p q r s) 1)]; exact nf_a223 p q r s
    | 2, 1, 2 => rw [cub_swap12 (yv (nf p q r s) 2) (yv (nf p q r s) 1) (yv (nf p q r s) 2)]; exact nf_a233 p q r s
    | 2, 2, 0 => rw [cub_swap23 (yv (nf p q r s) 2) (yv (nf p q r s) 2) (yv (nf p q r s) 0), cub_swap12 (yv (nf p q r s) 2) (yv (nf p q r s) 0) (yv (nf p q r s) 2)]; exact nf_a133 p q r s
    | 2, 2, 1 => rw [cub_swap23 (yv (nf p q r s) 2) (yv (nf p q r s) 2) (yv (nf p q r s) 1), cub_swap12 (yv (nf p q r s) 2) (yv (nf p q r s) 1) (yv (nf p q r s) 2)]; exact nf_a233 p q r s
    | 2, 2, 2 => exact nf_a333 p q r s

theorem J2_trans' [CharZero K] (f : Fin 7 → K) (b : K) : J2 (actC f 1 b 0 1 1) = J2 f := by
  rw [J2_eq, J2_eq, J2R_trans]
theorem J4_trans' [CharZero K] (f : Fin 7 → K) (b : K) : J4 (actC f 1 b 0 1 1) = J4 f := by
  rw [J4_eq, J4_eq, J4R_trans]
theorem J6_trans' [CharZero K] (f : Fin 7 → K) (b : K) : J6 (actC f 1 b 0 1 1) = J6 f := by
  rw [J6_eq, J6_eq, J6R_trans]
theorem J10_trans' [CharZero K] (f : Fin 7 → K) (b : K) : J10 (actC f 1 b 0 1 1) = J10 f := by
  rw [J10_eq, J10_eq, J10R_trans]
theorem J2_swap' (f : Fin 7 → K) : J2 (actC f 0 1 1 0 1) = J2 f := by
  rw [J2_eq, J2_eq, J2R_swap]
theorem J4_swap' (f : Fin 7 → K) : J4 (actC f 0 1 1 0 1) = J4 f := by
  rw [J4_eq, J4_eq, J4R_swap]
theorem J6_swap' (f : Fin 7 → K) : J6 (actC f 0 1 1 0 1) = J6 f := by
  rw [J6_eq, J6_eq, J6R_swap]
theorem J10_swap' (f : Fin 7 → K) : J10 (actC f 0 1 1 0 1) = J10 f := by
  rw [J10_eq, J10_eq, J10R_swap]

theorem m3At_of_trans [CharZero K] (f : Fin 7 → K) (b : K) (h : M3At (actC f 1 b 0 1 1)) :
    M3At f := by
  obtain ⟨hG, ha⟩ := h
  refine ⟨fun i j => ?_, fun i j k => ?_⟩
  · have := hG i j
    rwa [yv_trans, yv_trans, pair_qAct, J2_trans', J4_trans', J6_trans', J10_trans',
      show (1 * 1 - b * 0 : K) = 1 by ring, one_pow, one_mul] at this
  · have := ha i j k
    rwa [yv_trans, yv_trans, yv_trans, cub_qAct, p6_actC, J2_trans', J4_trans', J6_trans',
      J10_trans', show (1 * 1 - b * 0 : K) = 1 by ring, one_pow, one_mul] at this

theorem m3At_of_swap [CharZero K] (f : Fin 7 → K) (h : M3At (actC f 0 1 1 0 1)) : M3At f := by
  obtain ⟨hG, ha⟩ := h
  refine ⟨fun i j => ?_, fun i j k => ?_⟩
  · have := hG i j
    rwa [yv_swap, yv_swap, pair_qAct, J2_swap', J4_swap', J6_swap', J10_swap',
      show ((0 : K) * 0 - 1 * 1) ^ 2 = 1 by ring, one_mul] at this
  · have := ha i j k
    rwa [yv_swap, yv_swap, yv_swap, cub_qAct, p6_actC, J2_swap', J4_swap', J6_swap',
      J10_swap', show ((0 : K) * 0 - 1 * 1) ^ 6 = 1 by ring, one_mul] at this

set_option maxHeartbeats 4000000 in
theorem gramJ_homog (e j2 j4 j6 j10 : K) (i j : Fin 3) :
    gramJ (e ^ 2 * j2) (e ^ 4 * j4) (e ^ 6 * j6) (e ^ 10 * j10) i j =
      e ^ (![3, 5, 7] i + ![3, 5, 7] j) * gramJ j2 j4 j6 j10 i j := by
  fin_cases i <;> fin_cases j <;> simp [gramJ, m3G11, m3G12, m3G13, m3G22, m3G23, m3G33] <;> ring

set_option maxHeartbeats 8000000 in
theorem cubJ_homog (e j2 j4 j6 j10 : K) (i j k : Fin 3) :
    cubJ (e ^ 2 * j2) (e ^ 4 * j4) (e ^ 6 * j6) (e ^ 10 * j10) i j k =
      e ^ (1 + ![3, 5, 7] i + ![3, 5, 7] j + ![3, 5, 7] k) * cubJ j2 j4 j6 j10 i j k := by
  fin_cases i <;> fin_cases j <;> fin_cases k <;> simp [cubJ, m3a111, m3a112, m3a113, m3a122, m3a123, m3a133, m3a222, m3a223, m3a233, m3a333] <;> ring

theorem pair_smul (u v : Fin 3 → K) (s t : K) :
    pair (fun l => s * u l) (fun l => t * v l) = s * t * pair u v := by
  simp only [pair]; ring

theorem p6_cub_smul (f : Fin 7 → K) (u v w : Fin 3 → K) (e s t x : K) :
    p6 (fun i => e * f i) (cub (fun l => s * u l) (fun l => t * v l) (fun l => x * w l)) =
      e * s * t * x * p6 f (cub u v w) := by
  simp only [p6, cub, Matrix.cons_val]; ring

theorem m3At_of_scale [CharZero K] (f : Fin 7 → K) (e : K) (he : e ≠ 0)
    (h : M3At (fun i => e * f i)) : M3At f := by
  obtain ⟨hG, ha⟩ := h
  have j2 : J2 (fun i => e * f i) = e ^ 2 * J2 f := by rw [J2_eq, J2_eq, J2R_homog]
  have j4 : J4 (fun i => e * f i) = e ^ 4 * J4 f := by rw [J4_eq, J4_eq, J4R_homog]
  have j6 : J6 (fun i => e * f i) = e ^ 6 * J6 f := by rw [J6_eq, J6_eq, J6R_homog]
  have j10 : J10 (fun i => e * f i) = e ^ 10 * J10 f := by rw [J10_eq, J10_eq, J10R_homog]
  refine ⟨fun i j => ?_, fun i j k => ?_⟩
  · have := hG i j
    rw [yv_homog, yv_homog, pair_smul, j2, j4, j6, j10, gramJ_homog, ← pow_add] at this
    exact mul_left_cancel₀ (pow_ne_zero _ he) this
  · have := ha i j k
    rw [yv_homog, yv_homog, yv_homog, p6_cub_smul, j2, j4, j6, j10, cubJ_homog,
      show e * e ^ (![3, 5, 7] i) * e ^ (![3, 5, 7] j) * e ^ (![3, 5, 7] k) =
        e ^ (1 + ![3, 5, 7] i + ![3, 5, 7] j + ![3, 5, 7] k) by ring] at this
    exact mul_left_cancel₀ (pow_ne_zero _ he) this

set_option maxHeartbeats 4000000 in
/-- A sextic with a double root at `∞` has `J₁₀ = 0`. -/
theorem J10_of_top (f : Fin 7 → K) (h5 : f 5 = 0) (h6 : f 6 = 0) : J10 f = 0 := by
  rw [J10_eq]
  simp only [J10R, J10R0, J10R1, J10R2, J10R3, J10R4, J10R5, J10R6, J10R7, J10R8, J10R9, h5, h6]
  ring

/-- M3 for sextics with a root at `∞` (normal-form reduction: translation and scaling). -/
theorem m3At_of_top [CharZero K] (f : Fin 7 → K) (hf : J10 f ≠ 0) (h6 : f 6 = 0) : M3At f := by
  have h5 : f 5 ≠ 0 := fun h5 => hf (J10_of_top f h5 h6)
  apply m3At_of_trans f (-(f 4) / (5 * f 5))
  apply m3At_of_scale _ (f 5)⁻¹ (inv_ne_zero h5)
  set g : Fin 7 → K := fun i => (f 5)⁻¹ * actC f 1 (-(f 4) / (5 * f 5)) 0 1 1 i with hg
  have hnf : g = nf (g 3) (g 2) (g 1) (g 0) := by
    funext i
    fin_cases i
    · rfl
    · rfl
    · rfl
    · rfl
    · simp only [hg, nf, actC, h6]; simp; right; field_simp; try ring
    · simp only [hg, nf, actC, h6]; simp; field_simp
    · simp only [hg, nf, actC, h6]; simp
  rw [hnf]
  exact m3At_nf _ _ _ _

/-- **M3 for every sextic with `J₁₀ ≠ 0`** over an algebraically closed field of
characteristic 0. -/
theorem m3At_of_J10 [IsAlgClosed K] [CharZero K] (f : Fin 7 → K) (hf : J10 f ≠ 0) : M3At f := by
  by_cases h6 : f 6 = 0
  · exact m3At_of_top f hf h6
  open Polynomial in
  set P : K[X] := C (f 6) * X ^ 6 + C (f 5) * X ^ 5 + C (f 4) * X ^ 4 + C (f 3) * X ^ 3 +
    C (f 2) * X ^ 2 + C (f 1) * X + C (f 0) with hP
  have hdeg : P.degree ≠ 0 := by
    have : P.degree = 6 := by rw [hP]; compute_degree!
    rw [this]; decide
  obtain ⟨α, hα⟩ := IsAlgClosed.exists_root P hdeg
  apply m3At_of_trans f α
  apply m3At_of_swap
  apply m3At_of_top
  · rw [J10_swap', J10_trans']; exact hf
  · have : P.eval α = 0 := hα
    simp only [hP, eval_add, eval_mul, eval_C, eval_pow, eval_X] at this
    simp only [actC, Matrix.cons_val]; simp
    linear_combination this

end M3

/-- **Separation on the generic locus, proved** (`T28.SeparationGeneric`). -/
theorem separationGeneric : SeparationGeneric := by
  intro L _ _ _ f g hf hg hy h2 h4 h6 h10
  obtain ⟨hGf, haf⟩ := m3At_of_J10 f hf
  obtain ⟨hGg, hag⟩ := m3At_of_J10 g hg
  exact mestre_abstract f g (yv f) (yv g) hy (fun i j => by rw [hGf, hGg, h2, h4, h6, h10])
    (fun i j k => by rw [haf, hag, h2, h4, h6, h10])

/-- The identities M3 (`PkgI1.M3Identities`) hold at every sextic with `J₁₀ ≠ 0` over an
algebraically closed field of characteristic 0. -/
theorem m3Identities_of_J10 (L : Type) [Field L] [IsAlgClosed L] [CharZero L] (f : Fin 7 → L)
    (hf : J10 f ≠ 0) :
    (∀ i j, pair (yv f i) (yv f j) = gramJ (J2 f) (J4 f) (J6 f) (J10 f) i j) ∧
    (∀ i j k, p6 f (cub (yv f i) (yv f j) (yv f k)) = cubJ (J2 f) (J4 f) (J6 f) (J10 f) i j k) :=
  m3At_of_J10 f hf

/-- **T28 from the special locus alone** (the generic half is proved). -/
theorem igusaClebschSeparation_of_specialLocus (hS : SeparationSpecialLocus) :
    IgusaClebschSeparation :=
  igusaClebschSeparation_of_split separationGeneric hS

/-- **T28 from the both-special statement of task igusa-special** (the generic half is proved). -/
theorem igusaClebschSeparation_of_bothSpecial (hS : SeparationBothSpecial) :
    IgusaClebschSeparation :=
  igusaClebschSeparation_of_generic_bothSpecial separationGeneric hS

end T28

