/-- A polynomial with zero derivative is the constant `P(0)` (characteristic 0). -/
theorem eq_C_eval_zero_of_derivative {K : Type*} [Field K] [CharZero K] (P : K[X])
    (h : derivative P = 0) : P = C (P.eval 0) := by
  conv_lhs => rw [eq_C_of_derivative_eq_zero h]
  rw [coeff_zero_eq_eval_zero]

/-- Solving `P₀' = P₁, P₁' = 2P₂, P₂' = 0` (the translation action on binary quadratics). -/
theorem ode3 {K : Type*} [Field K] [CharZero K] (P0 P1 P2 : K[X]) (h0 : derivative P0 = P1)
    (h1 : derivative P1 = 2 * P2) (h2 : derivative P2 = 0) (b : K) :
    P0.eval b = P0.eval 0 + P1.eval 0 * b + P2.eval 0 * b ^ 2 ∧
      P1.eval b = P1.eval 0 + 2 * P2.eval 0 * b ∧ P2.eval b = P2.eval 0 := by
  have hP2 := eq_C_eval_zero_of_derivative P2 h2
  have hQ1 : derivative (P1 - 2 * C (P2.eval 0) * X) = 0 := by
    rw [derivative_sub, h1, derivative_mul, derivative_mul, derivative_C, derivative_X]
    conv_lhs => rw [hP2]
    simp
  have hP1 := eq_C_eval_zero_of_derivative _ hQ1
  have hQ0 : derivative (P0 - C (P1.eval 0) * X - C (P2.eval 0) * X * X) = 0 := by
    have e1 : P1 = C (P1.eval 0) + 2 * C (P2.eval 0) * X := by
      have := hP1; simp only [eval_sub, eval_mul, eval_C, eval_X, mul_zero, sub_zero] at this
      linear_combination this
    simp only [derivative_sub, h0, derivative_mul, derivative_C, derivative_X, zero_mul, zero_add,
      mul_one]
    linear_combination e1
  have hP0 := eq_C_eval_zero_of_derivative _ hQ0
  simp only [eval_sub, eval_mul, eval_C, eval_X, mul_zero, sub_zero] at hP0 hP1
  refine ⟨?_, ?_, ?_⟩
  · have := congrArg (eval b) hP0
    simp only [eval_sub, eval_mul, eval_C, eval_X, eval_pow] at this
    linear_combination this
  · have := congrArg (eval b) hP1
    simp only [eval_sub, eval_mul, eval_C, eval_X, eval_ofNat] at this
    linear_combination this
  · conv_lhs => rw [hP2]
    simp

theorem z1_trans {K : Type*} [Field K] [CharZero K] (v : Fin 7 → K) (b : K) :
    z1c0 (actC v 1 b 0 1 1) = z1c0 v + z1c1 v * b + z1c2 v * b ^ 2 ∧
      z1c1 (actC v 1 b 0 1 1) = z1c1 v + 2 * z1c2 v * b ∧
        z1c2 (actC v 1 b 0 1 1) = z1c2 v := by
  have H := ode3 _ _ _
    (z1c0_deriv (trP v) (trP_d0 v) (trP_d1 v) (trP_d2 v) (trP_d3 v) (trP_d4 v) (trP_d5 v)
      (trP_d6 v))
    (z1c1_deriv (trP v) (trP_d0 v) (trP_d1 v) (trP_d2 v) (trP_d3 v) (trP_d4 v) (trP_d5 v)
      (trP_d6 v))
    (z1c2_deriv (trP v) (trP_d0 v) (trP_d1 v) (trP_d2 v) (trP_d3 v) (trP_d4 v) (trP_d5 v)
      (trP_d6 v)) b
  have eb : (fun i => (evalRingHom b) (trP v i)) = actC v 1 b 0 1 1 := by
    funext i; exact trP_eval v b i
  have e0 : (fun i => (evalRingHom (0 : K)) (trP v i)) = v := by
    funext i; exact trP_eval_zero v i
  have k0 := z1c0_map (evalRingHom b) (trP v)
  have k1 := z1c1_map (evalRingHom b) (trP v)
  have k2 := z1c2_map (evalRingHom b) (trP v)
  have l0 := z1c0_map (evalRingHom (0 : K)) (trP v)
  have l1 := z1c1_map (evalRingHom (0 : K)) (trP v)
  have l2 := z1c2_map (evalRingHom (0 : K)) (trP v)
  rw [eb] at k0 k1 k2
  rw [e0] at l0 l1 l2
  simp only [coe_evalRingHom] at k0 k1 k2 l0 l1 l2
  rw [k0, k1, k2, l0, l1, l2] at H
  exact H

theorem z2_trans {K : Type*} [Field K] [CharZero K] (v : Fin 7 → K) (b : K) :
    z2c0 (actC v 1 b 0 1 1) = z2c0 v + z2c1 v * b + z2c2 v * b ^ 2 ∧
      z2c1 (actC v 1 b 0 1 1) = z2c1 v + 2 * z2c2 v * b ∧
        z2c2 (actC v 1 b 0 1 1) = z2c2 v := by
  have H := ode3 _ _ _
    (z2c0_deriv (trP v) (trP_d0 v) (trP_d1 v) (trP_d2 v) (trP_d3 v) (trP_d4 v) (trP_d5 v)
      (trP_d6 v))
    (z2c1_deriv (trP v) (trP_d0 v) (trP_d1 v) (trP_d2 v) (trP_d3 v) (trP_d4 v) (trP_d5 v)
      (trP_d6 v))
    (z2c2_deriv (trP v) (trP_d0 v) (trP_d1 v) (trP_d2 v) (trP_d3 v) (trP_d4 v) (trP_d5 v)
      (trP_d6 v)) b
  have eb : (fun i => (evalRingHom b) (trP v i)) = actC v 1 b 0 1 1 := by
    funext i; exact trP_eval v b i
  have e0 : (fun i => (evalRingHom (0 : K)) (trP v i)) = v := by
    funext i; exact trP_eval_zero v i
  have k0 := z2c0_map (evalRingHom b) (trP v)
  have k1 := z2c1_map (evalRingHom b) (trP v)
  have k2 := z2c2_map (evalRingHom b) (trP v)
  have l0 := z2c0_map (evalRingHom (0 : K)) (trP v)
  have l1 := z2c1_map (evalRingHom (0 : K)) (trP v)
  have l2 := z2c2_map (evalRingHom (0 : K)) (trP v)
  rw [eb] at k0 k1 k2
  rw [e0] at l0 l1 l2
  simp only [coe_evalRingHom] at k0 k1 k2 l0 l1 l2
  rw [k0, k1, k2, l0, l1, l2] at H
  exact H

theorem z3_trans {K : Type*} [Field K] [CharZero K] (v : Fin 7 → K) (b : K) :
    z3c0 (actC v 1 b 0 1 1) = z3c0 v + z3c1 v * b + z3c2 v * b ^ 2 ∧
      z3c1 (actC v 1 b 0 1 1) = z3c1 v + 2 * z3c2 v * b ∧
        z3c2 (actC v 1 b 0 1 1) = z3c2 v := by
  have H := ode3 _ _ _
    (z3c0_deriv (trP v) (trP_d0 v) (trP_d1 v) (trP_d2 v) (trP_d3 v) (trP_d4 v) (trP_d5 v)
      (trP_d6 v))
    (z3c1_deriv (trP v) (trP_d0 v) (trP_d1 v) (trP_d2 v) (trP_d3 v) (trP_d4 v) (trP_d5 v)
      (trP_d6 v))
    (z3c2_deriv (trP v) (trP_d0 v) (trP_d1 v) (trP_d2 v) (trP_d3 v) (trP_d4 v) (trP_d5 v)
      (trP_d6 v)) b
  have eb : (fun i => (evalRingHom b) (trP v i)) = actC v 1 b 0 1 1 := by
    funext i; exact trP_eval v b i
  have e0 : (fun i => (evalRingHom (0 : K)) (trP v i)) = v := by
    funext i; exact trP_eval_zero v i
  have k0 := z3c0_map (evalRingHom b) (trP v)
  have k1 := z3c1_map (evalRingHom b) (trP v)
  have k2 := z3c2_map (evalRingHom b) (trP v)
  have l0 := z3c0_map (evalRingHom (0 : K)) (trP v)
  have l1 := z3c1_map (evalRingHom (0 : K)) (trP v)
  have l2 := z3c2_map (evalRingHom (0 : K)) (trP v)
  rw [eb] at k0 k1 k2
  rw [e0] at l0 l1 l2
  simp only [coe_evalRingHom] at k0 k1 k2 l0 l1 l2
  rw [k0, k1, k2, l0, l1, l2] at H
  exact H

/-! ## Covariance of `yv` -/

section Cov
variable {K : Type*} [Field K]

theorem qAct_mul_left (q : Fin 3 → K) (s a b c d : K) :
    qAct (fun l => s * q l) a b c d = fun l => s * qAct q a b c d l := by
  funext l; fin_cases l <;> simp [qAct] <;> ring

theorem qAct_qAct (q : Fin 3 → K) (a b c d a' b' c' d' : K) :
    qAct (qAct q a b c d) a' b' c' d' =
      qAct q (a * a' + b * c') (a * b' + b * d') (c * a' + d * c') (c * b' + d * d') := by
  funext l; fin_cases l <;> simp [qAct] <;> ring

theorem yv_trans [CharZero K] (v : Fin 7 → K) (b : K) (i : Fin 3) :
    yv (actC v 1 b 0 1 1) i = qAct (yv v i) 1 b 0 1 := by
  obtain ⟨t10, t11, t12⟩ := z1_trans v b
  obtain ⟨t20, t21, t22⟩ := z2_trans v b
  obtain ⟨t30, t31, t32⟩ := z3_trans v b
  funext l
  fin_cases i <;> fin_cases l <;>
    simp [yv, qAct, y1c0_eq, y1c1_eq, y1c2_eq, y2c0_eq, y2c1_eq, y2c2_eq, y3c0_eq, y3c1_eq,
      y3c2_eq, t10, t11, t12, t20, t21, t22, t30, t31, t32] <;> ring

set_option maxHeartbeats 4000000 in
theorem yv_swap (v : Fin 7 → K) (i : Fin 3) : yv (actC v 0 1 1 0 1) i = qAct (yv v i) 0 1 1 0 := by
  funext l
  fin_cases i <;> fin_cases l <;> simp only [yv, qAct, Matrix.cons_val, y1c0, y1c1, y1c2, y2c0, y2c1, y2c2, y3c0_0, y3c0_1, y3c0_2, y3c0_3, y3c0_4, y3c0, y3c1_0, y3c1_1, y3c1_2, y3c1_3, y3c1_4, y3c1, y3c2_0, y3c2_1, y3c2_2, y3c2_3, y3c2_4, y3c2] <;>
    simp [actC] <;> ring

set_option maxHeartbeats 4000000 in
theorem yv_homog (v : Fin 7 → K) (e : K) (i : Fin 3) :
    yv (fun j => e * v j) i = fun l => e ^ (![3, 5, 7] i) * yv v i l := by
  funext l
  fin_cases i <;> fin_cases l <;> simp only [yv, Matrix.cons_val, y1c0, y1c1, y1c2, y2c0, y2c1, y2c2, y3c0_0, y3c0_1, y3c0_2, y3c0_3, y3c0_4, y3c0, y3c1_0, y3c1_1, y3c1_2, y3c1_3, y3c1_4, y3c1, y3c2_0, y3c2_1, y3c2_2, y3c2_3, y3c2_4, y3c2] <;> simp <;> ring

set_option maxHeartbeats 4000000 in
theorem yv_diag (v : Fin 7 → K) (s t : K) (i : Fin 3) :
    yv (actC v s 0 0 t 1) i = fun l => (s * t) ^ (![8, 14, 20] i) * qAct (yv v i) s 0 0 t l := by
  funext l
  fin_cases i <;> fin_cases l <;> simp only [yv, qAct, Matrix.cons_val, y1c0, y1c1, y1c2, y2c0, y2c1, y2c2, y3c0_0, y3c0_1, y3c0_2, y3c0_3, y3c0_4, y3c0, y3c1_0, y3c1_1, y3c1_2, y3c1_3, y3c1_4, y3c1, y3c2_0, y3c2_1, y3c2_2, y3c2_3, y3c2_4, y3c2] <;>
    simp [actC] <;> ring

/-- `yv` transforms correctly under `[[a, b], [c, d]]` (with `e = 1`). -/
def CovGood (a b c d : K) : Prop :=
  ∀ (v : Fin 7 → K) (i : Fin 3),
    yv (actC v a b c d 1) i = fun l => (a * d - b * c) ^ (![8, 14, 20] i) * qAct (yv v i) a b c d l

theorem CovGood.mul {a b c d a' b' c' d' : K} (h : CovGood a b c d) (h' : CovGood a' b' c' d') :
    CovGood (a * a' + b * c') (a * b' + b * d') (c * a' + d * c') (c * b' + d * d') := by
  intro v i
  have e := actC_actC v a b c d 1 a' b' c' d' 1
  rw [mul_one] at e
  have hd : (a * a' + b * c') * (c * b' + d * d') - (a * b' + b * d') * (c * a' + d * c') =
      (a * d - b * c) * (a' * d' - b' * c') := by ring
  rw [← e, h', h, qAct_mul_left, qAct_qAct, hd, mul_pow]
  funext l; ring

theorem CovGood.congr {a b c d a' b' c' d' : K} (h : CovGood a b c d) (ha : a = a') (hb : b = b')
    (hc : c = c') (hd : d = d') : CovGood a' b' c' d' := by subst ha hb hc hd; exact h

theorem covGood [CharZero K] (a b c d : K) (hdet : a * d - b * c ≠ 0) : CovGood a b c d := by
  have gD : ∀ s t : K, CovGood s 0 0 t := fun s t v i => by
    rw [yv_diag]; simp
  have gU : ∀ u : K, CovGood 1 u 0 1 := fun u v i => by
    rw [yv_trans]; funext l; simp
  have gS : CovGood (0 : K) 1 1 0 := fun v i => by
    rw [yv_swap]; funext l
    fin_cases i <;> norm_num
  by_cases hc : c = 0
  · subst hc
    have ha : a ≠ 0 := by rintro rfl; simp at hdet
    exact ((gD a d).mul (gU (b / a))).congr (by ring) (by field_simp <;> ring) (by ring) (by ring)
  · exact ((((gU (a / c)).mul gS).mul (gD c (b - a * d / c))).mul (gU (d / c))).congr
      (by field_simp <;> ring) (by field_simp <;> ring) (by ring) (by field_simp <;> ring)

/-- **Covariance of `yv`** (any field of characteristic 0, any universe). -/
theorem yv_actC [CharZero K] (f : Fin 7 → K) (a b c d e : K) (hdet : a * d - b * c ≠ 0)
    (i : Fin 3) : yv (actC f a b c d e) i =
      fun l => e ^ (![3, 5, 7] i) * (a * d - b * c) ^ (![8, 14, 20] i) * qAct (yv f i) a b c d l := by
  rw [actC_scale, yv_homog, covGood a b c d hdet]
  funext l; ring

/-- **`T28.YvCovariance` proved.** -/
theorem yvCovariance : YvCovariance := fun L _ _ f a b c d e hdet i => yv_actC f a b c d e hdet i

theorem det_rows (k0 k1 k2 : K) (q : Fin 3 → Fin 3 → K) (a b c d : K) :
    (Matrix.of ![fun l => k0 * qAct (q 0) a b c d l, fun l => k1 * qAct (q 1) a b c d l,
      fun l => k2 * qAct (q 2) a b c d l]).det =
      k0 * k1 * k2 * (a * d - b * c) ^ 3 * (Matrix.of q).det := by
  simp [Matrix.det_fin_three, qAct]; ring

/-- Relative invariance of `det yv` (Clebsch's `R`, up to a constant). -/
theorem det_yv_actC [CharZero K] (f : Fin 7 → K) (a b c d e : K) (hdet : a * d - b * c ≠ 0) :
    (Matrix.of (yv (actC f a b c d e))).det =
      e ^ 15 * (a * d - b * c) ^ 45 * (Matrix.of (yv f)).det := by
  have h : yv (actC f a b c d e) = ![fun l => e ^ 3 * (a * d - b * c) ^ 8 * qAct (yv f 0) a b c d l,
      fun l => e ^ 5 * (a * d - b * c) ^ 14 * qAct (yv f 1) a b c d l,
      fun l => e ^ 7 * (a * d - b * c) ^ 20 * qAct (yv f 2) a b c d l] := by
    funext i; fin_cases i <;> rw [yv_actC f a b c d e hdet] <;> rfl
  rw [h, det_rows]
  generalize a * d - b * c = δ
  ring

theorem det_yv_sexticAct [CharZero K] (f : Fin 7 → K) (M : Matrix (Fin 2) (Fin 2) K)
    (hM : M.det ≠ 0) (e : K) :
    (Matrix.of (yv (sexticAct f M e))).det = e ^ 15 * M.det ^ 45 * (Matrix.of (yv f)).det := by
  rw [Matrix.det_fin_two] at hM ⊢
  rw [sexticAct_eq, det_yv_actC f _ _ _ _ e hM]

end Cov

