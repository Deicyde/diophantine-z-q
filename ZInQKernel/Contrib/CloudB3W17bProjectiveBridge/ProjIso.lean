import ZInQKernel.Contrib.CloudW07JacobiansCurves.Jacobian.AlgebraicGeometry.ProjectiveSpace.Affine
import Mathlib.AlgebraicGeometry.ProjectiveSpectrum.Functor
import Mathlib.Algebra.Field.ULift

/-! Genuine projective-space comparison primitives. Neither W07's relative
projective space nor Oka's polynomial Proj is renamed into the other object.
The maps below use actual graded ring homomorphisms. -/

open CategoryTheory Limits AlgebraicGeometry MvPolynomial

set_option autoImplicit false

noncomputable section

namespace ZInQ.Contrib.CloudB3W17bProjectiveBridge

attribute [local instance] MvPolynomial.gradedAlgebra

universe u

variable {I J : Type u} {R S : Type u} [CommRing R] [CommRing S]

/-- Rename actual homogeneous coordinates, retaining each total degree. -/
def renameGraded (e : I ≃ J) :
    homogeneousSubmodule I R →+*ᵍ homogeneousSubmodule J R where
  __ := (MvPolynomial.renameEquiv R e).toRingHom
  map_mem hp := hp.rename_isHomogeneous

/-- The irrelevant ideal is generated by the variables; a coordinate bijection
therefore preserves it, providing the actual input to Proj.map. -/
theorem irrelevant_le_rename (e : I ≃ J) :
    HomogeneousIdeal.irrelevant (homogeneousSubmodule J R) ≤
      (HomogeneousIdeal.irrelevant (homogeneousSubmodule I R)).map (renameGraded e) := by
  change (HomogeneousIdeal.irrelevant (homogeneousSubmodule J R)).toIdeal ≤
    ((HomogeneousIdeal.irrelevant (homogeneousSubmodule I R)).map (renameGraded e)).toIdeal
  rw [HomogeneousIdeal.toIdeal_map, toIdeal_irrelevant_homogeneousSubmodule,
    toIdeal_irrelevant_homogeneousSubmodule, Ideal.map_span]
  apply Ideal.span_mono
  rintro _ ⟨j, rfl⟩
  exact ⟨X (e.symm j), ⟨e.symm j, rfl⟩, by simp [renameGraded, renameEquiv_apply]⟩

/-- The Proj coordinate comparison is a genuine scheme isomorphism. -/
def renameProjIso (e : I ≃ J) :
    Proj (homogeneousSubmodule J R) ≅ Proj (homogeneousSubmodule I R) where
  hom := Proj.map (renameGraded e) (irrelevant_le_rename e)
  inv := Proj.map (renameGraded e.symm) (irrelevant_le_rename e.symm)
  hom_inv_id := by
    rw [← Proj.map_comp]
    have he : (renameGraded e).comp (renameGraded e.symm) =
        GradedRingHom.id (homogeneousSubmodule J R) := by
      ext p
      simp [renameGraded, renameEquiv_apply]
    have hh : Proj.map ((renameGraded e).comp (renameGraded e.symm))
        (HomogeneousIdeal.irrelevant_le_map_comp (irrelevant_le_rename e.symm) (irrelevant_le_rename e)) =
        Proj.map (.id (homogeneousSubmodule J R)) (by simp) := by
      congr 1
    exact hh.trans (Proj.map_id)
  inv_hom_id := by
    rw [← Proj.map_comp]
    have he : (renameGraded e.symm).comp (renameGraded e) =
        GradedRingHom.id (homogeneousSubmodule I R) := by
      ext p
      simp [renameGraded, renameEquiv_apply]
    have hh : Proj.map ((renameGraded e.symm).comp (renameGraded e))
        (HomogeneousIdeal.irrelevant_le_map_comp (irrelevant_le_rename e) (irrelevant_le_rename e.symm)) =
        Proj.map (.id (homogeneousSubmodule I R)) (by simp) := by
      congr 1
    exact hh.trans (Proj.map_id)

set_option backward.isDefEq.respectTransparency false in
set_option backward.isDefEq.respectTransparency.types false in
/-- Coordinate renaming preserves the actual coefficient-spectrum structure map. -/
theorem renameProjIso_over (e : I ≃ J) :
    (renameProjIso (R := R) e).hom ≫ Proj.projectiveSpaceOverAffineToSpec I R =
      Proj.projectiveSpaceOverAffineToSpec J R := by
  let f := renameGraded (R := R) e
  let hf := irrelevant_le_rename (R := R) e
  refine (Proj.mapAffineOpenCover f hf).openCover.hom_ext _ _ fun s => ?_
  dsimp only [f, hf] at s ⊢
  simp only [Scheme.AffineOpenCover.openCover_f, Proj.mapAffineOpenCover_f,
    renameProjIso, Proj.projectiveSpaceOverAffineToSpec,
    Proj.awayι_toSpecZero_assoc,
    ← Spec.map_comp, ← CommRingCat.ofHom_comp]
  erw [Proj.awayι_comp_map_assoc (renameGraded e) (irrelevant_le_rename e) s.1.2 _ s.2.2]
  simp only [Proj.awayι_toSpecZero_assoc, ← Spec.map_comp,
    ← CommRingCat.ofHom_comp]
  congr 1
  ext r
  simp [HomogeneousLocalization.Away.map, HomogeneousLocalization.fromZeroRingHom,
    HomogeneousLocalization.map_mk, HomogeneousLocalization.val_mk,
    renameGraded, renameEquiv_apply, MvPolynomial.homogeneousSubmoduleZeroEquiv]

/-- The coefficient-base structure map uses the actual inclusion of constants.
This is the same base formula consumed by polynomial projective-space adapters. -/
theorem coefficientStructureMap_eq (I : Type u) (R : Type u) [CommRing R] :
    Proj.projectiveSpaceOverAffineToSpec I R =
      Proj.toSpecZero (homogeneousSubmodule I R) ≫
        Spec.map (CommRingCat.ofHom (algebraMap R (homogeneousSubmodule I R 0))) := by
  unfold Proj.projectiveSpaceOverAffineToSpec
  congr 2

#print axioms renameGraded
#print axioms irrelevant_le_rename
#print axioms renameProjIso
#print axioms renameProjIso_over
#print axioms coefficientStructureMap_eq

end ZInQ.Contrib.CloudB3W17bProjectiveBridge
