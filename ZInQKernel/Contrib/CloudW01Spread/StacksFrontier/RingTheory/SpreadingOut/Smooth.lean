/-!
# Smoothness spreads out in a filtered colimit of base rings

Let `R` be a commutative ring, let `A` be a filtered colimit of `R`-algebras `Aᵢ` (computed on
underlying sets), and let `φ : B →ₐ[R] C` be a map of `R`-algebras of finite presentation. This
file proves Stacks 0C0B: if the base change `1 ⊗ φ : A ⊗[R] B → A ⊗[R] C` is smooth, then already
`1 ⊗ φ : Aᵢ ⊗[R] B → Aᵢ ⊗[R] C` is smooth for some `i`.

Smoothness is formal smoothness together with finite presentation. Finite presentation of every
base change `Aᵢ ⊗[R] B → Aᵢ ⊗[R] C` is `φ`'s, base changed, so the content is formal smoothness
at a single stage. Choose a presentation `C = B[x_1, …, x_n]/I` with `I = (f_1, …, f_m)` and put
`Q = B[x_1, …, x_n]/I^2`, so that `Q ↠ C` is a square-zero extension of `B`-algebras. Formal
smoothness of a finitely presented algebra is the splitting of exactly this surjection
(`Algebra.FormallySmooth.iff_split_surjection`); the source phrases the same condition as the
existence of classes `ξ_k ∈ I/I^2` with `∑_k (∂f_j/∂x_k) ξ_k = f_j`, which is what a `B`-algebra
section `C → Q` amounts to once `x_k` is sent to `x_k - ξ_k`.

Base change carries this presentation along: `Aᵢ ⊗[R] B[x] = (Aᵢ ⊗[R] B)[x]`, the kernel of
`Aᵢ ⊗[R] B[x] ↠ Aᵢ ⊗[R] C` is the ideal generated by the image of `I` (right exactness of the
tensor product), its square is generated by the image of `I^2`, and hence `Aᵢ ⊗[R] Q` is the
square-zero extension of `Aᵢ ⊗[R] C` attached to the base changed presentation. A `B`-algebra
section `C → A ⊗[R] Q` is a tuple of `n` elements of `A ⊗[R] Q` annihilating the `f_j`; both the
elements and the finitely many identities they satisfy live at a finite stage, because
`A ⊗[R] M` is the filtered colimit of the `Aᵢ ⊗[R] M` for every `R`-module `M`. That stage `i`
works.

## Main results

* `Stacks.SpreadingOut.Smoothness.solution`: the statement of Stacks 0C0B.

## Implementation notes

The source's phrase "both sides are filtered colimits of their analogues over the `Aᵢ`" is, for
each `R`-module `M`, the pair of statements `exists_rTensor_eq` (every element of `A ⊗[R] M` comes
from some `Aᵢ ⊗[R] M`) and `exists_map_rTensor_eq_zero` (an element of `Aᵢ ⊗[R] M` dying in
`A ⊗[R] M` dies already in some `Aₖ ⊗[R] M`); together they say that the tensor product commutes
with the filtered colimit, and they are what turns a `B`-algebra section over `A` into one over a
stage. Only the diagram `i ↦ Aᵢ` is ever treated as a colimit: the hypothesis that its colimit is
computed on underlying sets gives, through `isColimitForget`, the two element-level facts
`exists_app_eq` and `exists_map_eq_zero` for `A` itself, and the passage to `A ⊗[R] M` is then
pure module theory. Vanishing is transported through the images `Aᵢ → A`, which are the directed
family of submodules of `A` whose supremum is `⊤`: a finitely generated submodule of `A` lies in
one of them (`exists_le_range_of_fg`), and the kernel of `Aₖ → A` contributes nothing after one
further step of the diagram.

`forget₂ (CommAlgCat R) CommRingCat` preserves the colimit of `pres` because the index category is
filtered, hence connected: the `R`-algebra structure of the tip of a cocone of rings can be read
off from any single object of the diagram, and connectedness makes the reading independent of the
choice. This is `Under.forget`'s preservation of connected colimits, which does not apply verbatim
because `CommAlgCat.{v} R` and `Under (CommRingCat.of R)` live in different universes here, so
the argument is repeated by hand in `isColimitForget₂`.

## References

* [StacksProject 0C0B](https://stacks.math.columbia.edu/tag/0C0B)
-/

namespace Stacks.SpreadingOut.Smoothness

open CategoryTheory Limits TensorProduct



variable {R : Type u} [CommRing R]

/-- Along a cocone of rings under the diagram of rings underlying a diagram of `R`-algebras over a
filtered index category, the composite `R → Aⱼ → s.pt` is independent of `j`. -/
public lemma app_algebraMap_eq {J : Type w} [Category.{t} J] [IsFiltered J]
    {F : J ⥤ CommAlgCat.{v} R}
    (s : Cocone (F ⋙ forget₂ (CommAlgCat.{v} R) CommRingCat.{v})) (j k : J) (r : R) :
    (s.ι.app j).hom (algebraMap R (F.obj j) r) = (s.ι.app k).hom (algebraMap R (F.obj k) r) := by
  have h : ∀ (i : J) (l : i ⟶ IsFiltered.max j k) (x : F.obj i), (s.ι.app i).hom x =
      (s.ι.app (IsFiltered.max j k)).hom ((F.map l).hom x) := by
    intro i l x
    conv_lhs => rw [← s.w l]
    simp
  rw [h j (IsFiltered.leftToMax j k), h k (IsFiltered.rightToMax j k)]
  simp

/-- The forgetful functor to rings carries a colimit presentation of an `R`-algebra over a
filtered index category to a colimit presentation of the underlying ring. -/
public noncomputable def isColimitForget₂ {J : Type w} [Category.{t} J] [IsFiltered J]
    {A : CommAlgCat.{v} R} (pres : ColimitPresentation J A) :
    IsColimit ((forget₂ (CommAlgCat.{v} R) CommRingCat.{v}).mapCocone pres.cocone) := by
  classical
  have key : ∀ s : Cocone (pres.diag ⋙ forget₂ (CommAlgCat.{v} R) CommRingCat.{v}),
      ∃! l : ((forget₂ (CommAlgCat.{v} R) CommRingCat.{v}).mapCocone pres.cocone).pt ⟶ s.pt,
        ∀ j, ((forget₂ (CommAlgCat.{v} R) CommRingCat.{v}).mapCocone pres.cocone).ι.app j ≫ l =
          s.ι.app j := by
    intro s
    have hw : ∀ {j k : J} (f : j ⟶ k) (x : ↥(pres.diag.obj j)),
        (s.ι.app k).hom ((pres.diag.map f).hom x) = (s.ι.app j).hom x := by
      intro j k f x
      conv_rhs => rw [← s.w f]
      simp
    obtain ⟨j₀⟩ : Nonempty J := IsFiltered.nonempty
    let _algs : Algebra R ↥s.pt :=
      ((s.ι.app j₀).hom.comp (algebraMap R ↥(pres.diag.obj j₀))).toAlgebra
    have hmap : ∀ (j : J) (r : R),
        (s.ι.app j).hom (algebraMap R ↥(pres.diag.obj j) r) = algebraMap R ↥s.pt r := fun j r => by
      simpa [RingHom.algebraMap_toAlgebra] using app_algebraMap_eq s j j₀ r
    let t : Cocone pres.diag :=
      { pt := CommAlgCat.of R ↥s.pt
        ι :=
          { app := fun j => CommAlgCat.ofHom { __ := (s.ι.app j).hom, commutes' := hmap j }
            naturality := fun j k f => by ext x; simpa using hw f x } }
    refine ⟨(forget₂ (CommAlgCat.{v} R) CommRingCat.{v}).map (pres.isColimit.desc t), ?_, ?_⟩
    · intro j
      simp only [Functor.mapCocone_ι_app, ← Functor.map_comp]
      rw [pres.isColimit.fac t j]
      rfl
    · intro m hm
      have hmj : ∀ (j : J) (x : ↥(pres.diag.obj j)),
          m.hom ((pres.ι.app j).hom x) = (s.ι.app j).hom x := by
        intro j x
        simpa [Functor.mapCocone_ι_app] using
          DFunLike.congr_fun (congrArg CommRingCat.Hom.hom (hm j)) x
      have hcomm : ∀ r : R, m.hom (algebraMap R ↥A r) = algebraMap R ↥s.pt r := fun r => by
        have h1 : (algebraMap R ↥A) r = (pres.ι.app j₀).hom (algebraMap R ↥(pres.diag.obj j₀) r) :=
          ((pres.ι.app j₀).hom.commutes r).symm
        rw [h1]
        conv_rhs => rw [← hmap j₀ r]
        exact hmj j₀ _
      exact congrArg (forget₂ (CommAlgCat.{v} R) CommRingCat.{v}).map
        (pres.isColimit.uniq t (CommAlgCat.ofHom { __ := m.hom, commutes' := hcomm }) fun j => by
          ext x
          exact hmj j x)
  choose l hl hl' using key
  exact ⟨l, hl, hl'⟩

/-- A ring isomorphism is of finite presentation.

Stated for a `RingEquiv` rather than obtained from `RingHom.finitePresentation_respectsIso`,
whose fields quantify over rings in a single universe. -/
public theorem finitePresentation_ringEquiv {A B : Type*} [CommRing A] [CommRing B]
    (e : A ≃+* B) : e.toRingHom.FinitePresentation :=
  RingHom.FinitePresentation.of_surjective _ e.surjective <| by
    simpa [RingHom.ker_equiv] using! Submodule.fg_bot

/-- Finite presentation of a map of `R`-algebras is inherited by base change on the right.

This is `RingHom.Finite.tensorProductMap_id` with `RingHom.Finite` replaced by
`RingHom.FinitePresentation`, and its proof: `f` is `Algebra.ofId S S'` for the algebra structure
`f` defines, and then `f ⊗ 1` is `Algebra.TensorProduct.includeLeft` read through
`(S ⊗[R] T) ⊗[S] S' ≃ₐ S' ⊗[R] T` (`Algebra.TensorProduct.comm` followed by
`Algebra.TensorProduct.cancelBaseChange`), so that it is the base change of `S → S'` along
`S → S ⊗[R] T`. -/
@[ega "IV 1.4.1" "more general"]
public theorem finitePresentation_tensorProductMap_id
    {S S' T : Type*} [CommRing S] [CommRing T] [CommRing S']
    [Algebra R S] [Algebra R T] [Algebra R S']
    {f : S →ₐ[R] S'} (hf : f.toRingHom.FinitePresentation) :
    (Algebra.TensorProduct.map f (AlgHom.id R T)).toRingHom.FinitePresentation := by
  let := f.toRingHom.toAlgebra
  have := IsScalarTower.of_algebraMap_eq' f.comp_algebraMap.symm
  have : Algebra.FinitePresentation S S' := RingHom.finitePresentation_algebraMap.mp hf
  change (Algebra.TensorProduct.map (Algebra.ofId S S')
    (AlgHom.id R T)).toRingHom.FinitePresentation
  convert_to (((Algebra.TensorProduct.comm _ _ _).trans
      (Algebra.TensorProduct.cancelBaseChange R S S S' T)).toAlgHom.comp
    Algebra.TensorProduct.includeLeft).toRingHom.FinitePresentation
  · ext <;> simp [Algebra.smul_def]
  · exact (finitePresentation_ringEquiv _).comp
      (RingHom.finitePresentation_algebraMap.mpr inferInstance)

/-- Finite presentation of a map of `R`-algebras is inherited by its base changes.

The map `1 ⊗ φ` is `φ ⊗ 1` conjugated by `Algebra.TensorProduct.comm`, so this is
`finitePresentation_tensorProductMap_id` together with
`RingHom.FinitePresentation.comp`. Transport along the two commutation isomorphisms must be done
with `finitePresentation_ringEquiv`, not with `RingHom.finitePresentation_respectsIso`: the latter
quantifies over rings in a single universe, while `S`, `B` and `C` here live in three. -/
@[ega "IV 1.4.1" "more general"]
public theorem finitePresentation_baseChange (S : Type*) [CommRing S] [Algebra R S]
    {B C : Type*} [CommRing B] [CommRing C] [Algebra R B] [Algebra R C] (φ : B →ₐ[R] C)
    (hφ : φ.toRingHom.FinitePresentation) :
    (Algebra.TensorProduct.map (AlgHom.id R S) φ).toRingHom.FinitePresentation := by
  have key : (Algebra.TensorProduct.map (AlgHom.id R S) φ).toRingHom =
      ((Algebra.TensorProduct.comm R C S).toAlgHom.comp
        ((Algebra.TensorProduct.map φ (AlgHom.id R S)).comp
          (Algebra.TensorProduct.comm R S B).toAlgHom)).toRingHom := by
    congr 1
    ext <;> simp
  rw [key]
  exact ((finitePresentation_ringEquiv (Algebra.TensorProduct.comm R C S).toRingEquiv).comp
    (finitePresentation_tensorProductMap_id (T := S) hφ)).comp
      (finitePresentation_ringEquiv (Algebra.TensorProduct.comm R S B).toRingEquiv)

section FormallySmoothCriterion

open MvPolynomial

/-- A quotient of a polynomial ring is formally smooth over the base exactly when the projection
`P ⧸ K ^ 2 → P ⧸ K` admits an algebra section, spelled out on the variables: there are elements
`y_k` congruent to `X k` modulo `K` at which every element of `K` vanishes modulo `K ^ 2`.

This is the source's criterion for smoothness of `B[x_1, …, x_n]/(f_1, …, f_m)`: writing
`y_k = X k - ξ_k` with `ξ_k ∈ K`, the second condition reads
`∑_k (∂f_j/∂x_k) ξ_k = f_j mod K ^ 2` by the first-order Taylor expansion, and it is the form
used here because it survives a change of the base ring verbatim. -/
public theorem formallySmooth_quotient_iff {S : Type*} [CommRing S] {σ : Type*}
    (K : Ideal (MvPolynomial σ S)) :
    Algebra.FormallySmooth S (MvPolynomial σ S ⧸ K) ↔
      ∃ y : σ → MvPolynomial σ S, (∀ k, y k - X k ∈ K) ∧ ∀ g ∈ K, aeval y g ∈ K ^ 2 := by
  have hk : RingHom.ker (Ideal.Quotient.mkₐ S K).toRingHom = K := Ideal.mk_ker
  constructor
  · intro h
    obtain ⟨g, hg⟩ := (Algebra.FormallySmooth.iff_split_surjection
      (Ideal.Quotient.mkₐ S K) Ideal.Quotient.mk_surjective).mp h
    choose y hy using fun k : σ =>
      Ideal.Quotient.mk_surjective (I := RingHom.ker (Ideal.Quotient.mkₐ S K).toRingHom ^ 2)
        (g (Ideal.Quotient.mk K (X k)))
    have hcomp : (Ideal.Quotient.mkₐ S
        (RingHom.ker (Ideal.Quotient.mkₐ S K).toRingHom ^ 2)).comp (aeval y) =
        g.comp (Ideal.Quotient.mkₐ S K) := by
      refine MvPolynomial.algHom_ext fun k => ?_
      simp only [AlgHom.comp_apply, MvPolynomial.aeval_X, Ideal.Quotient.mkₐ_eq_mk]
      exact hy k
    refine ⟨y, fun k => ?_, fun p hp => ?_⟩
    · have h1 := AlgHom.congr_fun hg (Ideal.Quotient.mk K (X k))
      rw [AlgHom.comp_apply, ← hy k, AlgHom.kerSquareLift_mk] at h1
      exact Ideal.Quotient.eq.mp h1
    · have h2 := AlgHom.congr_fun hcomp p
      rw [AlgHom.comp_apply, AlgHom.comp_apply,
        show (Ideal.Quotient.mkₐ S K) p = 0 from Ideal.Quotient.eq_zero_iff_mem.mpr hp,
        map_zero] at h2
      rw [← hk]
      exact Ideal.Quotient.eq_zero_iff_mem.mp h2
  · rintro ⟨y, hy1, hy2⟩
    have hmk : (Ideal.Quotient.mkₐ S K).comp (aeval y) = Ideal.Quotient.mkₐ S K := by
      refine MvPolynomial.algHom_ext fun k => ?_
      simp only [AlgHom.comp_apply, MvPolynomial.aeval_X, Ideal.Quotient.mkₐ_eq_mk]
      exact Ideal.Quotient.eq.mpr (hy1 k)
    refine Algebra.FormallySmooth.of_split (Ideal.Quotient.mkₐ S K)
      (Ideal.Quotient.liftₐ K ((Ideal.Quotient.mkₐ S _).comp (aeval y)) fun p hp => ?_) ?_
    · rw [AlgHom.comp_apply, Ideal.Quotient.mkₐ_eq_mk, Ideal.Quotient.eq_zero_iff_mem, hk]
      exact hy2 p hp
    · refine AlgHom.ext fun x => ?_
      obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective x
      simp only [AlgHom.comp_apply, AlgHom.id_apply, Ideal.Quotient.liftₐ_apply]
      exact AlgHom.congr_fun hmk p

/-- A quotient of a polynomial ring by the ideal generated by a family `f` is formally smooth over
the base exactly when there are elements `y_k` congruent to `X k` modulo the ideal at which every
`f j` vanishes modulo its square. This is `formallySmooth_quotient_iff` with the vanishing
condition tested on the generators only, which is the form that is a finite conjunction. -/
public theorem formallySmooth_quotient_span_iff {S : Type*} [CommRing S] {σ ι : Type*}
    (f : ι → MvPolynomial σ S) :
    Algebra.FormallySmooth S (MvPolynomial σ S ⧸ Ideal.span (Set.range f)) ↔
      ∃ y : σ → MvPolynomial σ S, (∀ k, y k - X k ∈ Ideal.span (Set.range f)) ∧
        ∀ j, aeval y (f j) ∈ Ideal.span (Set.range f) ^ 2 := by
  rw [formallySmooth_quotient_iff]
  refine exists_congr fun y => and_congr_right fun _ =>
    ⟨fun h j => h _ (Ideal.subset_span ⟨j, rfl⟩), fun h p hp => ?_⟩
  induction hp using Submodule.span_induction with
  | mem x hx => obtain ⟨j, rfl⟩ := hx; exact h j
  | zero => simp
  | add a b _ _ ha hb => simpa using add_mem ha hb
  | smul c a _ ha => rw [smul_eq_mul, map_mul]; exact Ideal.mul_mem_left _ _ ha

end FormallySmoothCriterion

section Bookkeeping

variable {J : Type w} [Category.{t} J] [IsFiltered J]

/-- A finite conjunction of properties, each of which holds after some morphism out of `i` and
persists along further morphisms, holds after a single morphism out of `i`. This is how finitely
many elements of a filtered colimit, and finitely many identities between them, are brought to one
stage of the diagram. -/
public lemma exists_forall_mem_of_forall_exists {i : J} {ι : Type*}
    (Q : ∀ k : J, (i ⟶ k) → ι → Prop)
    (hmono : ∀ {k l : J} (u : i ⟶ k) (v : k ⟶ l) (a : ι), Q k u a → Q l (u ≫ v) a) :
    ∀ s : Finset ι, (∀ a ∈ s, ∃ (k : J) (u : i ⟶ k), Q k u a) →
      ∃ (k : J) (u : i ⟶ k), ∀ a ∈ s, Q k u a := by
  classical
  intro s
  induction s using Finset.induction with
  | empty => exact fun _ => ⟨i, 𝟙 i, by simp⟩
  | insert a s _ ih =>
      intro h
      obtain ⟨k, u, hk⟩ := ih fun b hb => h b (Finset.mem_insert_of_mem hb)
      obtain ⟨k', u', hk'⟩ := h a (Finset.mem_insert_self a s)
      obtain ⟨l, v, v', hv⟩ := IsFiltered.span u u'
      refine ⟨l, u ≫ v, fun b hb => ?_⟩
      rcases Finset.mem_insert.mp hb with rfl | hb
      · rw [hv]; exact hmono u' v' b hk'
      · exact hmono u v b (hk b hb)

/-- A finite family of properties, each holding at some object and persisting along morphisms,
holds at a single object. -/
public lemma exists_forall_of_finite {ι : Type*} [Finite ι] (Pr : J → ι → Prop)
    (hmono : ∀ {i k : J}, (i ⟶ k) → ∀ a : ι, Pr i a → Pr k a) (h : ∀ a, ∃ i, Pr i a) :
    ∃ i, ∀ a, Pr i a := by
  classical
  have := Fintype.ofFinite ι
  choose g hg using h
  obtain ⟨S, hS⟩ := IsFiltered.sup_objs_exists (Finset.image g Finset.univ)
  refine ⟨S, fun a => ?_⟩
  obtain ⟨u⟩ := hS (Finset.mem_image_of_mem g (Finset.mem_univ a))
  exact hmono u a (hg a)

end Bookkeeping


section Diagram

variable {J : Type w} [Category.{t} J] {A : CommAlgCat.{v} R} (pres : ColimitPresentation J A)

/-- The coprojection at `k` undoes a transition map of the diagram: `ιₖ (Dₘ x) = ιᵢ x`. -/
public lemma app_map_apply {i k : J} (f : i ⟶ k) (x : ↥(pres.diag.obj i)) :
    (pres.ι.app k).hom ((pres.diag.map f).hom x) = (pres.ι.app i).hom x := by
  conv_rhs => rw [← pres.cocone.w f]
  simp

/-- The transition map of a composite, as a linear map, is the composite of the transition maps. -/
public lemma toLinearMap_map_comp {i j k : J} (f : i ⟶ j) (g : j ⟶ k) :
    (pres.diag.map (f ≫ g)).hom.toLinearMap =
      (pres.diag.map g).hom.toLinearMap ∘ₗ (pres.diag.map f).hom.toLinearMap := by
  ext x; simp

/-- Tensoring the transition map of a composite with `M` is tensoring each transition map in
turn. -/
public lemma rTensor_map_comp (M : Type*) [AddCommGroup M] [Module R M] {i j k : J}
    (f : i ⟶ j) (g : j ⟶ k) (w : ↥(pres.diag.obj i) ⊗[R] M) :
    LinearMap.rTensor M (pres.diag.map (f ≫ g)).hom.toLinearMap w =
      LinearMap.rTensor M (pres.diag.map g).hom.toLinearMap
        (LinearMap.rTensor M (pres.diag.map f).hom.toLinearMap w) := by
  rw [toLinearMap_map_comp pres f g, LinearMap.rTensor_comp_apply]

/-- After tensoring with `M`, the coprojection at `k` undoes a transition map of the diagram. -/
public lemma rTensor_app_map (M : Type*) [AddCommGroup M] [Module R M] {i k : J} (f : i ⟶ k)
    (w : ↥(pres.diag.obj i) ⊗[R] M) :
    LinearMap.rTensor M (pres.ι.app k).hom.toLinearMap
        (LinearMap.rTensor M (pres.diag.map f).hom.toLinearMap w) =
      LinearMap.rTensor M (pres.ι.app i).hom.toLinearMap w := by
  have h : (pres.ι.app i).hom.toLinearMap =
      (pres.ι.app k).hom.toLinearMap ∘ₗ (pres.diag.map f).hom.toLinearMap := by
    ext x; exact (app_map_apply pres f x).symm
  rw [h, LinearMap.rTensor_comp_apply]

/-- The image of a stage in `A` is contained in the image of any later stage. -/
public lemma range_le_range {i k : J} (f : i ⟶ k) :
    LinearMap.range (pres.ι.app i).hom.toLinearMap ≤
      LinearMap.range (pres.ι.app k).hom.toLinearMap := by
  rintro _ ⟨x, rfl⟩
  exact ⟨(pres.diag.map f).hom x, app_map_apply pres f x⟩

/-- The coprojection at `k` composed with a transition map `i ⟶ k` is the coprojection at `i`. -/
public lemma app_comp_map {i k : J} (u : i ⟶ k) :
    (pres.ι.app k).hom.comp (pres.diag.map u).hom = (pres.ι.app i).hom :=
  AlgHom.ext fun x => app_map_apply pres u x

/-- The transition map of a composite is the composite of the transition maps. -/
public lemma map_comp_hom {i j k : J} (u : i ⟶ j) (w : j ⟶ k) :
    (pres.diag.map (u ≫ w)).hom = (pres.diag.map w).hom.comp (pres.diag.map u).hom :=
  AlgHom.ext fun x => by simp

end Diagram

section Descent

variable {J : Type w} [Category.{t} J] [IsFiltered J] {A : CommAlgCat.{v} R}
  (pres : ColimitPresentation J A)
  [PreservesColimit (pres.diag ⋙ forget₂ (CommAlgCat.{v} R) CommRingCat.{v})
    (forget CommRingCat)]

/-- A colimit presentation of `A` in `CommAlgCat R` whose colimit is computed on underlying sets,
read on underlying sets. -/
public noncomputable def isColimitForget :
    IsColimit ((forget CommRingCat.{v}).mapCocone
      ((forget₂ (CommAlgCat.{v} R) CommRingCat.{v}).mapCocone pres.cocone)) :=
  isColimitOfPreserves _ (isColimitForget₂ pres)

/-- Every element of `A` comes from some stage of the diagram. -/
public lemma exists_app_eq (a : ↥A) :
    ∃ (i : J) (x : ↥(pres.diag.obj i)), (pres.ι.app i).hom x = a := by
  obtain ⟨i, x, hx⟩ := Types.jointly_surjective_of_isColimit (isColimitForget pres) a
  exact ⟨i, x, hx⟩

/-- An element of a stage of the diagram that dies in `A` already dies at a later stage. -/
public lemma exists_map_eq_zero {i : J} (x : ↥(pres.diag.obj i))
    (hx : (pres.ι.app i).hom x = 0) :
    ∃ (k : J) (f : i ⟶ k), (pres.diag.map f).hom x = 0 := by
  have h : (pres.ι.app i).hom x = (pres.ι.app i).hom 0 := by rw [hx, map_zero]
  obtain ⟨k, f, hf⟩ :=
    (Types.FilteredColimit.isColimit_eq_iff' (isColimitForget pres) x 0).mp h
  exact ⟨k, f, by simpa using hf⟩

/-- The images of the stages of the diagram span `A`. -/
public lemma iSup_range_eq_top :
    (⨆ i : J, LinearMap.range (pres.ι.app i).hom.toLinearMap : Submodule R ↥A) = ⊤ := by
  refine eq_top_iff.mpr fun a _ => ?_
  obtain ⟨i, x, hx⟩ := exists_app_eq pres a
  exact Submodule.mem_iSup_of_mem i ⟨x, hx⟩

/-- A finitely generated submodule of `A` is contained in the image of some stage. -/
public lemma exists_le_range_of_fg (N : Submodule R ↥A) (hN : N.FG) :
    ∃ i : J, N ≤ LinearMap.range (pres.ι.app i).hom.toLinearMap := by
  obtain ⟨s, hs⟩ := ((Submodule.fg_iff_compact N).mp hN).exists_finset_of_le_iSup _
    (by rw [iSup_range_eq_top pres]; exact le_top)
  obtain ⟨S, hS⟩ := IsFiltered.sup_objs_exists s
  refine ⟨S, hs.trans (iSup_le fun i => iSup_le fun hi => ?_)⟩
  obtain ⟨f⟩ := hS hi
  exact range_le_range pres f

/-- Every element of `A ⊗[R] M` comes from some stage of the diagram. -/
public lemma exists_rTensor_eq (M : Type*) [AddCommGroup M] [Module R M] (z : ↥A ⊗[R] M) :
    ∃ (i : J) (w : ↥(pres.diag.obj i) ⊗[R] M),
      LinearMap.rTensor M (pres.ι.app i).hom.toLinearMap w = z := by
  induction z using TensorProduct.inductionOn with
  | tmul a m =>
      obtain ⟨i, x, hx⟩ := exists_app_eq pres a
      exact ⟨i, x ⊗ₜ m, by simp [hx]⟩
  | add z₁ z₂ h₁ h₂ =>
      obtain ⟨i₁, w₁, hw₁⟩ := h₁
      obtain ⟨i₂, w₂, hw₂⟩ := h₂
      refine ⟨IsFiltered.max i₁ i₂,
        LinearMap.rTensor M (pres.diag.map (IsFiltered.leftToMax i₁ i₂)).hom.toLinearMap w₁ +
          LinearMap.rTensor M (pres.diag.map (IsFiltered.rightToMax i₁ i₂)).hom.toLinearMap w₂,
        ?_⟩
      rw [map_add, rTensor_app_map pres M _ w₁, rTensor_app_map pres M _ w₂, hw₁, hw₂]

/-- An element of `ker ιₖ ⊗[R] M` dies at some later stage after being sent to `Aₖ ⊗[R] M`. -/
public lemma exists_map_rTensor_subtype_eq_zero (M : Type*) [AddCommGroup M] [Module R M]
    {k : J} (u : ↥(LinearMap.ker (pres.ι.app k).hom.toLinearMap) ⊗[R] M) :
    ∃ (k' : J) (g : k ⟶ k'), LinearMap.rTensor M (pres.diag.map g).hom.toLinearMap
      (LinearMap.rTensor M (LinearMap.ker (pres.ι.app k).hom.toLinearMap).subtype u) = 0 := by
  induction u using TensorProduct.inductionOn with
  | tmul c m =>
      obtain ⟨k', g, hg⟩ := exists_map_eq_zero pres c.1 c.2
      exact ⟨k', g, by simp [hg]⟩
  | add u₁ u₂ h₁ h₂ =>
      obtain ⟨k₁, g₁, hg₁⟩ := h₁
      obtain ⟨k₂, g₂, hg₂⟩ := h₂
      obtain ⟨l, m₁, m₂, hm⟩ := IsFiltered.span g₁ g₂
      refine ⟨l, g₁ ≫ m₁, ?_⟩
      rw [map_add, map_add, rTensor_map_comp pres M g₁ m₁, hg₁, map_zero, zero_add]
      rw [hm, rTensor_map_comp pres M g₂ m₂, hg₂, map_zero]

/-- An element of `Aᵢ ⊗[R] M` that dies in `A ⊗[R] M` already dies at a later stage. -/
public lemma exists_map_rTensor_eq_zero (M : Type*) [AddCommGroup M] [Module R M] {i : J}
    (w : ↥(pres.diag.obj i) ⊗[R] M)
    (hw : LinearMap.rTensor M (pres.ι.app i).hom.toLinearMap w = 0) :
    ∃ (k : J) (f : i ⟶ k),
      LinearMap.rTensor M (pres.diag.map f).hom.toLinearMap w = 0 := by
  set L : ↥(pres.diag.obj i) →ₗ[R] ↥A := (pres.ι.app i).hom.toLinearMap with hL
  set w' := LinearMap.rTensor M L.rangeRestrict w with hw'
  have hsub : LinearMap.rTensor M (LinearMap.range L).subtype w' = 0 := by
    rw [hw', ← LinearMap.rTensor_comp_apply, LinearMap.subtype_comp_rangeRestrict, hw]
  obtain ⟨N, hNfg, hNle, y, hy⟩ := Submodule.exists_fg_le_eq_rTensor_inclusion w'
  have hy0 : LinearMap.rTensor M N.subtype y = 0 := by
    rw [← Submodule.subtype_comp_inclusion N _ hNle, LinearMap.rTensor_comp_apply, ← hy, hsub]
  obtain ⟨N', hN'fg, hle', hzero⟩ :=
    hNfg.exists_rTensor_fg_inclusion_eq (M := M) (x := y) (y := 0) (by simpa using hy0)
  obtain ⟨j, hj⟩ := exists_le_range_of_fg pres N' hN'fg
  obtain ⟨k, f, hz⟩ : ∃ (k : J) (f : i ⟶ k),
      LinearMap.rTensor M (pres.ι.app k).hom.toLinearMap.rangeRestrict
        (LinearMap.rTensor M (pres.diag.map f).hom.toLinearMap w) = 0 := by
    refine ⟨IsFiltered.max i j, IsFiltered.leftToMax i j, ?_⟩
    have hkle : N' ≤ LinearMap.range (pres.ι.app (IsFiltered.max i j)).hom.toLinearMap :=
      hj.trans (range_le_range pres (IsFiltered.rightToMax i j))
    have hNk : N ≤ LinearMap.range (pres.ι.app (IsFiltered.max i j)).hom.toLinearMap :=
      hle'.trans hkle
    have hyk : LinearMap.rTensor M (Submodule.inclusion hNk) y = 0 := by
      have hfac : Submodule.inclusion hNk =
          (Submodule.inclusion hkle).comp (Submodule.inclusion hle') := rfl
      rw [hfac, LinearMap.rTensor_comp_apply, hzero, map_zero, map_zero]
    have hle2 : LinearMap.range L ≤
        LinearMap.range (pres.ι.app (IsFiltered.max i j)).hom.toLinearMap :=
      range_le_range pres (IsFiltered.leftToMax i j)
    have hmid : (pres.ι.app (IsFiltered.max i j)).hom.toLinearMap.rangeRestrict ∘ₗ
          (pres.diag.map (IsFiltered.leftToMax i j)).hom.toLinearMap =
        Submodule.inclusion hle2 ∘ₗ L.rangeRestrict := by
      ext x
      exact app_map_apply pres (IsFiltered.leftToMax i j) x
    rw [← LinearMap.rTensor_comp_apply, hmid, LinearMap.rTensor_comp_apply, ← hw', hy,
      ← LinearMap.rTensor_comp_apply]
    have hfac2 : (Submodule.inclusion hle2).comp (Submodule.inclusion hNle) =
        Submodule.inclusion hNk := rfl
    rw [hfac2, hyk]
  have hex : Function.Exact
      (LinearMap.rTensor M (LinearMap.ker (pres.ι.app k).hom.toLinearMap).subtype)
      (LinearMap.rTensor M (pres.ι.app k).hom.toLinearMap.rangeRestrict) :=
    rTensor_exact M
      (by rw [LinearMap.exact_iff, LinearMap.ker_rangeRestrict, Submodule.range_subtype])
      (pres.ι.app k).hom.toLinearMap.surjective_rangeRestrict
  obtain ⟨u, hu⟩ := (hex _).mp hz
  obtain ⟨k', g, hg⟩ := exists_map_rTensor_subtype_eq_zero pres M u
  refine ⟨k', f ≫ g, ?_⟩
  rw [rTensor_map_comp pres M f g, ← hu, hg]

end Descent

section BaseChange

open MvPolynomial

/-- Base change of a polynomial along `B → T ⊗[R] B`, `b ↦ 1 ⊗ b`, applied to the coefficients. -/
public noncomputable def bcRight (T : Type*) [CommRing T] [Algebra R T] {B σ : Type*}
    [CommRing B] [Algebra R B] : MvPolynomial σ B →+* MvPolynomial σ (T ⊗[R] B) :=
  MvPolynomial.map (Algebra.TensorProduct.includeRight : B →ₐ[R] T ⊗[R] B).toRingHom

/-- Base change of a polynomial over a tensor product along a map of the left factor, applied to
the coefficients. -/
public noncomputable def bcMap {T T' : Type*} [CommRing T] [Algebra R T] [CommRing T']
    [Algebra R T'] (F : T →ₐ[R] T') {B σ : Type*} [CommRing B] [Algebra R B] :
    MvPolynomial σ (T ⊗[R] B) →+* MvPolynomial σ (T' ⊗[R] B) :=
  MvPolynomial.map (Algebra.TensorProduct.map F (AlgHom.id R B)).toRingHom

variable {B : Type*} [CommRing B] [Algebra R B] {σ : Type*}

/-- `bcRight` sends a variable to the same variable. -/
public lemma bcRight_X (T : Type*) [CommRing T] [Algebra R T] (k : σ) :
    bcRight (R := R) T (X k : MvPolynomial σ B) = X k :=
  MvPolynomial.map_X _ _

/-- `bcRight` sends a constant `b` to the constant `1 ⊗ b`. -/
public lemma bcRight_C (T : Type*) [CommRing T] [Algebra R T] (b : B) :
    bcRight (R := R) T (MvPolynomial.C b : MvPolynomial σ B) = MvPolynomial.C (1 ⊗ₜ[R] b) :=
  MvPolynomial.map_C _ _

/-- The coefficients of `bcRight T p` are `1 ⊗` the coefficients of `p`. -/
public lemma coeff_bcRight (T : Type*) [CommRing T] [Algebra R T] (p : MvPolynomial σ B)
    (e : σ →₀ ℕ) : (bcRight (R := R) T p).coeff e = 1 ⊗ₜ[R] p.coeff e :=
  MvPolynomial.coeff_map _ _ _

/-- The base change of an algebra map on a tensor product is, on the underlying modules, the
tensor product of the map with the identity. -/
public lemma map_id_eq_rTensor {T T' : Type*} [CommRing T] [Algebra R T] [CommRing T']
    [Algebra R T'] (F : T →ₐ[R] T') (x : T ⊗[R] B) :
    Algebra.TensorProduct.map F (AlgHom.id R B) x = LinearMap.rTensor B F.toLinearMap x := by
  induction x using TensorProduct.inductionOn with
  | tmul t b => simp
  | add x y hx hy => simp [hx, hy]

/-- `bcMap` sends a variable to the same variable. -/
public lemma bcMap_X {T T' : Type*} [CommRing T] [Algebra R T] [CommRing T'] [Algebra R T']
    (F : T →ₐ[R] T') (k : σ) : bcMap F (X k : MvPolynomial σ (T ⊗[R] B)) = X k :=
  MvPolynomial.map_X _ _

/-- The coefficients of `bcMap F p` are the images of those of `p` under `F ⊗ id`. -/
public lemma coeff_bcMap {T T' : Type*} [CommRing T] [Algebra R T] [CommRing T']
    [Algebra R T'] (F : T →ₐ[R] T') (p : MvPolynomial σ (T ⊗[R] B)) (e : σ →₀ ℕ) :
    (bcMap F p).coeff e = LinearMap.rTensor B F.toLinearMap (p.coeff e) := by
  rw [bcMap, MvPolynomial.coeff_map]
  exact map_id_eq_rTensor F _

/-- Base changing along `F` a polynomial base changed to `T` gives its base change to `T'`. -/
public lemma bcMap_bcRight {T T' : Type*} [CommRing T] [Algebra R T] [CommRing T']
    [Algebra R T'] (F : T →ₐ[R] T') (p : MvPolynomial σ B) :
    bcMap F (bcRight (R := R) T p) = bcRight T' p := by
  ext e
  rw [coeff_bcMap, coeff_bcRight, coeff_bcRight]
  simp

/-- `bcMap` is functorial: base changing along `F` and then `G` is base changing along `G ∘ F`. -/
public lemma bcMap_bcMap {T₁ T₂ T₃ : Type*} [CommRing T₁] [Algebra R T₁] [CommRing T₂]
    [Algebra R T₂] [CommRing T₃] [Algebra R T₃] (F : T₁ →ₐ[R] T₂) (G : T₂ →ₐ[R] T₃)
    (p : MvPolynomial σ (T₁ ⊗[R] B)) : bcMap G (bcMap F p) = bcMap (G.comp F) p := by
  ext e
  rw [coeff_bcMap, coeff_bcMap, coeff_bcMap, ← LinearMap.rTensor_comp_apply]
  rfl

/-- Substitution commutes with a coefficientwise ring map. -/
public lemma map_aeval_map {S S' : Type*} [CommRing S] [CommRing S'] (g : S →+* S')
    (y : σ → MvPolynomial σ S) (p : MvPolynomial σ S) :
    MvPolynomial.map g (aeval y p) =
      aeval (fun k => MvPolynomial.map g (y k)) (MvPolynomial.map g p) := by
  have h : (MvPolynomial.map g).comp (aeval y : MvPolynomial σ S →ₐ[S] MvPolynomial σ S).toRingHom =
      (aeval (fun k => MvPolynomial.map g (y k)) :
          MvPolynomial σ S' →ₐ[S'] MvPolynomial σ S').toRingHom.comp (MvPolynomial.map g) := by
    refine MvPolynomial.ringHom_ext (fun r => ?_) (fun k => ?_) <;> simp
  exact RingHom.congr_fun h p

/-- `bcMap` commutes with substitution. -/
public lemma bcMap_aeval {T T' : Type*} [CommRing T] [Algebra R T] [CommRing T'] [Algebra R T']
    (F : T →ₐ[R] T') (y : σ → MvPolynomial σ (T ⊗[R] B)) (p : MvPolynomial σ (T ⊗[R] B)) :
    bcMap F (aeval y p) = aeval (fun k => bcMap F (y k)) (bcMap F p) :=
  map_aeval_map _ y p

/-- The square of an ideal generated by a family is generated by the pairwise products. -/
public lemma sq_span_range {S ι : Type*} [CommRing S] (g : ι → S) :
    Ideal.span (Set.range g) ^ 2 = Ideal.span (Set.range fun q : ι × ι => g q.1 * g q.2) := by
  rw [pow_two, Ideal.span_mul_span]
  congr 1
  ext x
  constructor
  · rintro ⟨a, ⟨i, rfl⟩, b, ⟨j, rfl⟩, rfl⟩
    exact ⟨(i, j), rfl⟩
  · rintro ⟨⟨i, j⟩, rfl⟩
    exact ⟨g i, ⟨i, rfl⟩, g j, ⟨j, rfl⟩, rfl⟩

end BaseChange

section BaseChangePresentation

open MvPolynomial

variable {B C : Type*} [CommRing B] [CommRing C] [Algebra R B] [Algebra R C]

/-- A map of `R`-algebras of finite presentation admits a presentation by generators and relations:
a surjection onto the target from a polynomial ring in finitely many variables over the source,
whose kernel is generated by finitely many elements. -/
public lemma exists_presentation (φ : B →ₐ[R] C) (hφ : φ.toRingHom.FinitePresentation) :
    ∃ (n m : ℕ) (π : MvPolynomial (Fin n) B →ₐ[R] C) (f : Fin m → MvPolynomial (Fin n) B),
      (∀ b, π (MvPolynomial.C b) = φ b) ∧ Function.Surjective π ∧
        RingHom.ker π = Ideal.span (Set.range f) := by
  let := φ.toRingHom.toAlgebra
  have := IsScalarTower.of_algebraMap_eq' φ.comp_algebraMap.symm
  have : Algebra.FinitePresentation B C := RingHom.finitePresentation_algebraMap.mp hφ
  obtain ⟨n, ψ, hψ, hfg⟩ := Algebra.FinitePresentation.out (R := B) (A := C)
  obtain ⟨m, v, hv⟩ := Submodule.fg_iff_exists_fin_generating_family.mp hfg
  refine ⟨n, m, ψ.restrictScalars R, v, fun b => ?_, hψ, hv.symm⟩
  have h : ψ (algebraMap B (MvPolynomial (Fin n) B) b) = algebraMap B C b := ψ.commutes b
  simp only [RingHom.algebraMap_toAlgebra] at h
  simpa using h

/-- The base change to `T` of a surjection `π` presenting `C` over `B`: the ring map
`(T ⊗[R] B)[x] → T ⊗[R] C` sending `x k` to `1 ⊗ π (x k)` and a coefficient to its image under
`1 ⊗ φ`. -/
public noncomputable def bcHom (T : Type*) [CommRing T] [Algebra R T] {σ : Type*}
    (φ : B →ₐ[R] C) (π : MvPolynomial σ B →ₐ[R] C) :
    MvPolynomial σ (T ⊗[R] B) →+* T ⊗[R] C :=
  MvPolynomial.eval₂Hom (Algebra.TensorProduct.map (AlgHom.id R T) φ).toRingHom
    fun k => Algebra.TensorProduct.includeRight (π (X k))

variable {T : Type*} [CommRing T] [Algebra R T] {σ : Type*} (φ : B →ₐ[R] C)
  (π : MvPolynomial σ B →ₐ[R] C)

/-- `bcHom` sends a constant `x` to its image under `1 ⊗ φ`. -/
public lemma bcHom_C (x : T ⊗[R] B) :
    bcHom T φ π (MvPolynomial.C x) = Algebra.TensorProduct.map (AlgHom.id R T) φ x := by
  simp [bcHom]

/-- `bcHom` sends the variable `x k` to `1 ⊗ π (x k)`. -/
public lemma bcHom_X (k : σ) :
    bcHom T φ π (X k) = Algebra.TensorProduct.includeRight (π (X k)) := by
  simp [bcHom]

/-- On polynomials base changed from `B`, `bcHom` is `1 ⊗ π`. -/
public lemma bcHom_bcRight (hπC : ∀ b, π (MvPolynomial.C b) = φ b) (p : MvPolynomial σ B) :
    bcHom T φ π (bcRight (R := R) T p) = Algebra.TensorProduct.includeRight (π p) := by
  have h : (bcHom T φ π).comp (bcRight (R := R) T) =
      ((Algebra.TensorProduct.includeRight : C →ₐ[R] T ⊗[R] C).comp π).toRingHom := by
    refine MvPolynomial.ringHom_ext (fun b => ?_) (fun k => ?_)
    · simp [bcRight_C, bcHom_C, hπC]
    · simp [bcRight_X, bcHom_X]
  exact RingHom.congr_fun h p

/-- The identification `T ⊗[R] B[x] ≃ (T ⊗[R] B)[x]` sends `1 ⊗ p` to `bcRight T p`. -/
public lemma rTensorAlgEquiv_one_tmul (p : MvPolynomial σ B) :
    MvPolynomial.rTensorAlgEquiv (R := R) (S := T) (N := B) (σ := σ) (1 ⊗ₜ[R] p) =
      bcRight (R := R) T p := by
  ext e
  rw [MvPolynomial.coeff_rTensorAlgEquiv_tmul, coeff_bcRight]

/-- The identification `T ⊗[R] B[x] ≃ (T ⊗[R] B)[x]` sends `t ⊗ 1` to the constant `t ⊗ 1`. -/
public lemma rTensorAlgEquiv_tmul_one (t : T) :
    MvPolynomial.rTensorAlgEquiv (R := R) (S := T) (N := B) (σ := σ)
        (t ⊗ₜ[R] (1 : MvPolynomial σ B)) = MvPolynomial.C (t ⊗ₜ[R] (1 : B)) := by
  classical
  ext e
  rw [MvPolynomial.coeff_rTensorAlgEquiv_tmul, MvPolynomial.coeff_C, MvPolynomial.coeff_one]
  split_ifs with he
  · rfl
  · simp

/-- Through the identification `T ⊗[R] B[x] ≃ (T ⊗[R] B)[x]`, `bcHom` is `1 ⊗ π`. -/
public lemma bcHom_rTensorAlgEquiv (hπC : ∀ b, π (MvPolynomial.C b) = φ b)
    (x : T ⊗[R] MvPolynomial σ B) :
    bcHom T φ π (MvPolynomial.rTensorAlgEquiv (R := R) (S := T) (N := B) (σ := σ) x) =
      Algebra.TensorProduct.map (AlgHom.id R T) π x := by
  induction x using TensorProduct.inductionOn with
  | tmul t p =>
      have h1 : (t ⊗ₜ[R] p : T ⊗[R] MvPolynomial σ B) =
          (t ⊗ₜ[R] (1 : MvPolynomial σ B)) * ((1 : T) ⊗ₜ[R] p) := by
        rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
      rw [h1, map_mul, map_mul, rTensorAlgEquiv_tmul_one, rTensorAlgEquiv_one_tmul,
        bcHom_bcRight φ π hπC, bcHom_C]
      simp
  | add x y hx hy => simp only [map_add, hx, hy]

/-- The base change `bcHom` of a surjective presentation is surjective. -/
public lemma bcHom_surjective (hπC : ∀ b, π (MvPolynomial.C b) = φ b)
    (hπ : Function.Surjective π) : Function.Surjective (bcHom T φ π) := by
  intro z
  obtain ⟨x, hx⟩ := Algebra.TensorProduct.map_surjective (AlgHom.id R T) π
    (fun t => ⟨t, rfl⟩) hπ z
  exact ⟨MvPolynomial.rTensorAlgEquiv x, by rw [bcHom_rTensorAlgEquiv φ π hπC, hx]⟩

/-- The kernel of `bcHom` is generated by the base changes of the generators of the kernel of
`π`. -/
public lemma ker_bcHom (hπC : ∀ b, π (MvPolynomial.C b) = φ b) (hπ : Function.Surjective π)
    {ι : Type*} (f : ι → MvPolynomial σ B)
    (hker : RingHom.ker π = Ideal.span (Set.range f)) :
    RingHom.ker (bcHom T φ π) = Ideal.span (Set.range fun j => bcRight (R := R) T (f j)) := by
  set Θ := MvPolynomial.rTensorAlgEquiv (R := R) (S := T) (N := B) (σ := σ) with hΘ
  refine le_antisymm (fun x hx => ?_) ?_
  · rw [RingHom.mem_ker] at hx
    have hx' : (Algebra.TensorProduct.map (AlgHom.id R T) π) (Θ.symm x) = 0 := by
      rw [← bcHom_rTensorAlgEquiv φ π hπC, hΘ, Θ.apply_symm_apply, hx]
    have hmem : Θ.symm x ∈ Ideal.map
        (Algebra.TensorProduct.includeRight :
          MvPolynomial σ B →ₐ[R] T ⊗[R] MvPolynomial σ B) (RingHom.ker π) := by
      rw [← Algebra.TensorProduct.lTensor_ker π hπ]
      exact hx'
    rw [hker, Ideal.map_span] at hmem
    have key : ∀ z ∈ Ideal.span ((Algebra.TensorProduct.includeRight :
        MvPolynomial σ B →ₐ[R] T ⊗[R] MvPolynomial σ B) '' Set.range f),
        Θ z ∈ Ideal.span (Set.range fun j => bcRight (R := R) T (f j)) := by
      intro z hz
      induction hz using Submodule.span_induction with
      | mem u hu =>
          obtain ⟨p, ⟨j, rfl⟩, rfl⟩ := hu
          refine Ideal.subset_span ⟨j, ?_⟩
          rw [hΘ, Algebra.TensorProduct.includeRight_apply]
          exact (rTensorAlgEquiv_one_tmul (R := R) (T := T) (f j)).symm
      | zero => simp
      | add a b _ _ ha hb => rw [map_add]; exact Ideal.add_mem _ ha hb
      | smul c a _ ha => rw [smul_eq_mul, map_mul]; exact Ideal.mul_mem_left _ _ ha
    have h3 := key _ hmem
    rwa [Θ.apply_symm_apply] at h3
  · rw [Ideal.span_le]
    rintro z ⟨j, rfl⟩
    have hfj : π (f j) = 0 :=
      RingHom.mem_ker.mp (by rw [hker]; exact Ideal.subset_span ⟨j, rfl⟩)
    simp only [SetLike.mem_coe, RingHom.mem_ker, bcHom_bcRight φ π hπC, hfj, map_zero]

/-- The criterion for formal smoothness of the base change to `T`, read off a presentation of `C`
over `B`: there are elements `y k` congruent to `x k` modulo the base changed relations at which
every base changed relation vanishes to second order. -/
public theorem formallySmooth_bcHom_iff {n m : ℕ} (φ : B →ₐ[R] C)
    (π : MvPolynomial (Fin n) B →ₐ[R] C) (hπC : ∀ b, π (MvPolynomial.C b) = φ b)
    (hπ : Function.Surjective π) (f : Fin m → MvPolynomial (Fin n) B)
    (hker : RingHom.ker π = Ideal.span (Set.range f))
    (T : Type*) [CommRing T] [Algebra R T] :
    (Algebra.TensorProduct.map (AlgHom.id R T) φ).toRingHom.FormallySmooth ↔
      ∃ y : Fin n → MvPolynomial (Fin n) (T ⊗[R] B),
        (∀ k, y k - X k ∈ Ideal.span (Set.range fun j => bcRight (R := R) T (f j))) ∧
        ∀ j, aeval y (bcRight (R := R) T (f j)) ∈
          Ideal.span (Set.range fun j => bcRight (R := R) T (f j)) ^ 2 := by
  let _ : Algebra (T ⊗[R] B) (T ⊗[R] C) :=
    (Algebra.TensorProduct.map (AlgHom.id R T) φ).toRingHom.toAlgebra
  have halg : (algebraMap (T ⊗[R] B) (T ⊗[R] C) : (T ⊗[R] B) →+* T ⊗[R] C) =
      (Algebra.TensorProduct.map (AlgHom.id R T) φ).toRingHom :=
    RingHom.algebraMap_toAlgebra _
  let p : MvPolynomial (Fin n) (T ⊗[R] B) →ₐ[T ⊗[R] B] T ⊗[R] C :=
    { __ := bcHom T φ π
      commutes' := fun s => by
        rw [halg, MvPolynomial.algebraMap_eq]
        exact bcHom_C φ π s }
  have e : (MvPolynomial (Fin n) (T ⊗[R] B) ⧸
      Ideal.span (Set.range fun j => bcRight (R := R) T (f j))) ≃ₐ[T ⊗[R] B] T ⊗[R] C := by
    rw [← (ker_bcHom φ π hπC hπ f hker : RingHom.ker p = _)]
    exact Ideal.quotientKerAlgEquivOfSurjective (f := p) (bcHom_surjective φ π hπC hπ)
  rw [← formallySmooth_quotient_span_iff]
  change Algebra.FormallySmooth (T ⊗[R] B) (T ⊗[R] C) ↔ _
  exact (Algebra.FormallySmooth.iff_of_equiv e).symm

end BaseChangePresentation

section PolynomialDescent

open MvPolynomial

variable {J : Type w} [Category.{t} J] [IsFiltered J] {A : CommAlgCat.{v} R}
  (pres : ColimitPresentation J A)
  [PreservesColimit (pres.diag ⋙ forget₂ (CommAlgCat.{v} R) CommRingCat.{v})
    (forget CommRingCat)]
  {B : Type*} [CommRing B] [Algebra R B] {σ : Type*}

/-- Every polynomial with coefficients in `A ⊗[R] B` comes from a stage of the diagram. -/
public lemma exists_bcMap_eq (z : MvPolynomial σ (↥A ⊗[R] B)) :
    ∃ (i : J) (z' : MvPolynomial σ (↥(pres.diag.obj i) ⊗[R] B)),
      bcMap (pres.ι.app i).hom z' = z := by
  induction z using MvPolynomial.induction_on with
  | C a =>
      obtain ⟨i, x, hx⟩ := exists_rTensor_eq pres B a
      refine ⟨i, MvPolynomial.C x, ?_⟩
      rw [bcMap, MvPolynomial.map_C, ← hx]
      exact congrArg MvPolynomial.C (map_id_eq_rTensor _ x)
  | add p q hp hq =>
      obtain ⟨i₁, p', hp'⟩ := hp
      obtain ⟨i₂, q', hq'⟩ := hq
      refine ⟨IsFiltered.max i₁ i₂,
        bcMap (pres.diag.map (IsFiltered.leftToMax i₁ i₂)).hom p' +
          bcMap (pres.diag.map (IsFiltered.rightToMax i₁ i₂)).hom q', ?_⟩
      rw [map_add, bcMap_bcMap, bcMap_bcMap, app_comp_map, app_comp_map, hp', hq']
  | mul_X p k hp =>
      obtain ⟨i, p', hp'⟩ := hp
      exact ⟨i, p' * X k, by rw [map_mul, hp', bcMap_X]⟩

/-- A finite family of polynomials with coefficients in `A ⊗[R] B` comes from a single stage. -/
public lemma exists_forall_bcMap_eq {ι : Type*} [Finite ι]
    (z : ι → MvPolynomial σ (↥A ⊗[R] B)) :
    ∃ (i : J) (z' : ι → MvPolynomial σ (↥(pres.diag.obj i) ⊗[R] B)),
      ∀ a, bcMap (pres.ι.app i).hom (z' a) = z a := by
  obtain ⟨i, hi⟩ := exists_forall_of_finite
    (fun i a => ∃ w : MvPolynomial σ (↥(pres.diag.obj i) ⊗[R] B),
      bcMap (pres.ι.app i).hom w = z a)
    (fun {i k} u a h => by
      obtain ⟨w, hw⟩ := h
      exact ⟨bcMap (pres.diag.map u).hom w, by rw [bcMap_bcMap, app_comp_map, hw]⟩)
    (fun a => exists_bcMap_eq pres (z a))
  choose z' hz' using hi
  exact ⟨i, z', hz'⟩

/-- A polynomial at a stage of the diagram that dies over `A` already dies at a later stage. -/
public lemma exists_bcMap_eq_zero {i : J} (z : MvPolynomial σ (↥(pres.diag.obj i) ⊗[R] B))
    (hz : bcMap (pres.ι.app i).hom z = 0) :
    ∃ (k : J) (u : i ⟶ k), bcMap (pres.diag.map u).hom z = 0 := by
  obtain ⟨k, u, hu⟩ := exists_forall_mem_of_forall_exists
    (fun k (u : i ⟶ k) (e : σ →₀ ℕ) =>
      LinearMap.rTensor B (pres.diag.map u).hom.toLinearMap (z.coeff e) = 0)
    (fun {k l} u w e h => by rw [rTensor_map_comp pres B u w, h, map_zero])
    z.support
    (fun e _ => exists_map_rTensor_eq_zero pres B (z.coeff e) (by
      have h := congrArg (fun q : MvPolynomial σ _ => q.coeff e) hz
      rwa [coeff_bcMap, AddMonoidAlgebra.coeff_zero, Finsupp.zero_apply] at h))
  refine ⟨k, u, MvPolynomial.ext _ _ fun e => ?_⟩
  rw [coeff_bcMap, AddMonoidAlgebra.coeff_zero, Finsupp.zero_apply]
  by_cases he : e ∈ z.support
  · exact hu e he
  · rw [MvPolynomial.notMem_support_iff.mp he, map_zero]

/-- A finite family of polynomials at a stage of the diagram, all dying over `A`, all die at a
single later stage. -/
public lemma exists_forall_bcMap_eq_zero {ι : Type*} [Finite ι] {i : J}
    (z : ι → MvPolynomial σ (↥(pres.diag.obj i) ⊗[R] B))
    (hz : ∀ a, bcMap (pres.ι.app i).hom (z a) = 0) :
    ∃ (k : J) (u : i ⟶ k), ∀ a, bcMap (pres.diag.map u).hom (z a) = 0 := by
  classical
  have := Fintype.ofFinite ι
  obtain ⟨k, u, hu⟩ := exists_forall_mem_of_forall_exists
    (fun k (u : i ⟶ k) (a : ι) => bcMap (pres.diag.map u).hom (z a) = 0)
    (fun {k l} u w a h => by rw [map_comp_hom, ← bcMap_bcMap, h, map_zero])
    Finset.univ (fun a _ => exists_bcMap_eq_zero pres (z a) (hz a))
  exact ⟨k, u, fun a => hu a (Finset.mem_univ a)⟩

/-- The smoothness criterion for the base change to `A` descends to a stage of the diagram. -/
public lemma exists_criterion_of_criterion {n m : ℕ} (f : Fin m → MvPolynomial (Fin n) B)
    (y : Fin n → MvPolynomial (Fin n) (↥A ⊗[R] B))
    (hy1 : ∀ k, y k - X k ∈ Ideal.span (Set.range fun j => bcRight (R := R) (↥A) (f j)))
    (hy2 : ∀ j, aeval y (bcRight (R := R) (↥A) (f j)) ∈
      Ideal.span (Set.range fun j => bcRight (R := R) (↥A) (f j)) ^ 2) :
    ∃ (i : J) (y' : Fin n → MvPolynomial (Fin n) (↥(pres.diag.obj i) ⊗[R] B)),
      (∀ k, y' k - X k ∈
          Ideal.span (Set.range fun j => bcRight (R := R) (↥(pres.diag.obj i)) (f j))) ∧
        ∀ j, aeval y' (bcRight (R := R) (↥(pres.diag.obj i)) (f j)) ∈
          Ideal.span (Set.range fun j => bcRight (R := R) (↥(pres.diag.obj i)) (f j)) ^ 2 := by
  classical
  choose c hc using fun k => Ideal.mem_span_range_iff_exists_fun.mp (hy1 k)
  have hy2' : ∀ j, aeval y (bcRight (R := R) (↥A) (f j)) ∈
      Ideal.span (Set.range fun q : Fin m × Fin m =>
        bcRight (R := R) (↥A) (f q.1) * bcRight (R := R) (↥A) (f q.2)) := by
    intro j
    rw [← sq_span_range (fun j => bcRight (R := R) (↥A) (f j))]
    exact hy2 j
  choose d hd using fun j => Ideal.mem_span_range_iff_exists_fun.mp (hy2' j)
  obtain ⟨i, Z, hZ⟩ := exists_forall_bcMap_eq pres
    (Sum.elim y (Sum.elim (fun q : Fin n × Fin m => c q.1 q.2)
      (fun q : Fin m × Fin m × Fin m => d q.1 (q.2.1, q.2.2))))
  have hZy : ∀ k, bcMap (pres.ι.app i).hom (Z (Sum.inl k)) = y k := fun k => hZ (Sum.inl k)
  have hZc : ∀ k j, bcMap (pres.ι.app i).hom (Z (Sum.inr (Sum.inl (k, j)))) = c k j :=
    fun k j => hZ (Sum.inr (Sum.inl (k, j)))
  have hZd : ∀ j (q : Fin m × Fin m),
      bcMap (pres.ι.app i).hom (Z (Sum.inr (Sum.inr (j, q.1, q.2)))) = d j q :=
    fun j q => hZ (Sum.inr (Sum.inr (j, q.1, q.2)))
  set E : Fin n ⊕ Fin m → MvPolynomial (Fin n) (↥(pres.diag.obj i) ⊗[R] B) :=
    Sum.elim
      (fun k => Z (Sum.inl k) - X k -
        ∑ j, Z (Sum.inr (Sum.inl (k, j))) * bcRight (R := R) (↥(pres.diag.obj i)) (f j))
      (fun j => aeval (fun k => Z (Sum.inl k))
          (bcRight (R := R) (↥(pres.diag.obj i)) (f j)) -
        ∑ q : Fin m × Fin m, Z (Sum.inr (Sum.inr (j, q.1, q.2))) *
          (bcRight (R := R) (↥(pres.diag.obj i)) (f q.1) *
            bcRight (R := R) (↥(pres.diag.obj i)) (f q.2)))
    with hE
  have hEzero : ∀ a, bcMap (pres.ι.app i).hom (E a) = 0 := by
    intro a
    cases a with
    | inl k =>
        simp only [hE, Sum.elim_inl, map_sub, map_sum, map_mul, bcMap_X, bcMap_bcRight, hZy, hZc]
        rw [sub_eq_zero]
        simpa [smul_eq_mul] using (hc k).symm
    | inr j =>
        simp only [hE, Sum.elim_inr, map_sub, map_sum, map_mul, bcMap_aeval, bcMap_bcRight,
          hZy, hZd]
        rw [sub_eq_zero]
        simpa [smul_eq_mul] using (hd j).symm
  obtain ⟨k, u, hku⟩ := exists_forall_bcMap_eq_zero pres E hEzero
  refine ⟨k, fun k' => bcMap (pres.diag.map u).hom (Z (Sum.inl k')), fun k' => ?_, fun j => ?_⟩
  · refine Ideal.mem_span_range_iff_exists_fun.mpr
      ⟨fun j => bcMap (pres.diag.map u).hom (Z (Sum.inr (Sum.inl (k', j)))), ?_⟩
    have h := hku (Sum.inl k')
    simp only [hE, Sum.elim_inl, map_sub, map_sum, map_mul, bcMap_X, bcMap_bcRight] at h
    rw [sub_eq_zero] at h
    simpa [smul_eq_mul] using h.symm
  · rw [sq_span_range (fun j => bcRight (R := R) (↥(pres.diag.obj k)) (f j))]
    refine Ideal.mem_span_range_iff_exists_fun.mpr
      ⟨fun q : Fin m × Fin m =>
        bcMap (pres.diag.map u).hom (Z (Sum.inr (Sum.inr (j, q.1, q.2)))), ?_⟩
    have h := hku (Sum.inr j)
    simp only [hE, Sum.elim_inr, map_sub, map_sum, map_mul, bcMap_aeval, bcMap_bcRight] at h
    rw [sub_eq_zero] at h
    simpa [smul_eq_mul] using h.symm

end PolynomialDescent

/-- The content of Stacks 0C0B: formal smoothness of the base change to the colimit is already
achieved at some stage of the diagram. -/
public theorem exists_formallySmooth {J : Type w} [Category.{t} J] [IsFiltered J]
    {A : CommAlgCat.{v} R} (pres : ColimitPresentation J A)
    [PreservesColimit (pres.diag ⋙ forget₂ (CommAlgCat.{v} R) CommRingCat.{v})
      (forget CommRingCat)]
    {B C : Type*} [CommRing B] [CommRing C] [Algebra R B] [Algebra R C] (φ : B →ₐ[R] C)
    (hφ : φ.toRingHom.FinitePresentation)
    (hA : (Algebra.TensorProduct.map (AlgHom.id R ↥A) φ).toRingHom.FormallySmooth) :
    ∃ i : J,
      (Algebra.TensorProduct.map (AlgHom.id R ↥(pres.diag.obj i)) φ).toRingHom.FormallySmooth := by
  obtain ⟨n, m, π, f, hπC, hπ, hker⟩ := exists_presentation φ hφ
  obtain ⟨y, hy1, hy2⟩ := (formallySmooth_bcHom_iff φ π hπC hπ f hker ↥A).mp hA
  obtain ⟨i, y', hy'1, hy'2⟩ := exists_criterion_of_criterion pres f y hy1 hy2
  exact ⟨i, (formallySmooth_bcHom_iff φ π hπC hπ f hker _).mpr ⟨y', hy'1, hy'2⟩⟩

/-- A map of `R`-algebras of finite presentation that becomes smooth after base change to the
colimit `A` of a filtered diagram is already smooth after base change to some stage. -/
public theorem solution
    {R : Type u} [CommRing R] {J : Type w} [Category.{t} J] [IsFiltered J]
    {A : CommAlgCat.{v} R} (pres : ColimitPresentation J A)
    [PreservesColimit (pres.diag ⋙ forget₂ (CommAlgCat.{v} R) CommRingCat.{v})
      (forget CommRingCat)]
    {B C : Type*} [CommRing B] [CommRing C] [Algebra R B] [Algebra R C] (φ : B →ₐ[R] C)
    (hφ : φ.toRingHom.FinitePresentation)
    (hA : (Algebra.TensorProduct.map (AlgHom.id R ↥A) φ).toRingHom.Smooth) :
    ∃ i : J, (Algebra.TensorProduct.map (AlgHom.id R ↥(pres.diag.obj i)) φ).toRingHom.Smooth := by
  obtain ⟨i, hi⟩ := exists_formallySmooth pres φ hφ (RingHom.smooth_def.mp hA).1
  exact ⟨i, RingHom.smooth_def.mpr ⟨hi, finitePresentation_baseChange _ φ hφ⟩⟩

end Stacks.SpreadingOut.Smoothness

/-!
# Smooth ring maps spread out in a filtered colimit of base rings

Let `R` be a commutative ring, let `A` be a filtered colimit of `R`-algebras `Aᵢ`, and let
`φ : B →ₐ[R] C` be a map of `R`-algebras which is of finite presentation. If the base change
`1 ⊗ φ : A ⊗[R] B → A ⊗[R] C` is smooth, then already `1 ⊗ φ : Aᵢ ⊗[R] B → Aᵢ ⊗[R] C` is smooth
for some `i`.

The mathematics: write `C = B[x_1, …, x_n]/(f_1, …, f_m)`, so that `Aᵢ ⊗[R] C` is the quotient of
`(Aᵢ ⊗[R] B)[x_1, …, x_n]` by the images `f_{j,i}` of the `f_j`, and likewise over `A`.
Smoothness of `A ⊗[R] B → A ⊗[R] C` says that the map
`d : (f_1, …, f_m)/(f_1, …, f_m)^2 → ⨁_k (A ⊗[R] C) dx_k` is a *split injection*, i.e. that there
are classes `ξ_k` with `∑_k (∂f_j/∂x_k) ξ_k = f_j` modulo `(f_1, …, f_m)^2`. Both sides are
filtered colimits of their analogues over the `Aᵢ`, so for `i` large enough one finds classes
`ξ_{k,i}` satisfying the same identities `∑_k (∂f_{j,i}/∂x_k) ξ_{k,i} = f_{j,i}` modulo
`(f_{1,i}, …, f_{m,i})^2`, which hold because they hold in the limit. That `i` works.

This is the smooth member of a family of statements with one hypothesis shape: 07RH (surjective),
0C32 (isomorphism), 0C4F (unramified) and 07RI (étale). The framing below is 07RI's verbatim, so
that the five are interchangeable and their common dependent 07RP sees a single idiom.

## Main results

* `RingHom.Smooth.exists_baseChange_smooth_of_colimitPresentation`: the statement above.

## Implementation notes

The base ring is `R`, playing the role of the source's `A_0`. The source's index set `I` contains
`0`, its terms `A_i` for `i ≥ 0` are `A_0`-algebras, and the conclusion is about some `i ≥ 0`;
since `{i ∈ I | i ≥ 0}` is cofinal in `I` it computes the same colimit, so the source's situation
is this one with `R = A_0` and the diagram indexed by that cofinal subset. Nothing forces `R`
itself to be a term of the diagram, and the argument does not use that it is, so the hypothesis
is the weaker one.

"`A` is the filtered colimit of the `Aᵢ`" is the bundled `Limits.ColimitPresentation J A` in
`CommAlgCat R`, the category of commutative `R`-algebras: a diagram `J ⥤ CommAlgCat R`, a cocone
with tip `A`, and the assertion that the cocone is colimiting. No construction of the colimit is
chosen, and `CommAlgCat R` is used rather than `Under (CommRingCat.of R)` so that each
`↥(pres.diag.obj i)` carries its `Algebra R` instance and the tensor products below typecheck as
written. The index is an arbitrary filtered category rather than the source's nonempty directed
partial order: that is the weaker hypothesis (a nonempty directed preorder is filtered), and it
is the shape of Mathlib's own spreading-out lemma for finitely presented algebras,
`RingHom.EssFiniteType.exists_eq_comp_ι_app_of_isColimit`.

For an index category that is large relative to `A`, "colimit in `CommAlgCat.{v} R`" is strictly
weaker than the source's `A = colim A_i`, and the lemma then fails: over a filtered `J : Type 1`
whose set-level colimit is a field `K` that is not `Small.{0}`, the zero ring is the colimit in
`CommAlgCat.{0} ℤ`, so `A = 0` makes every hypothesis vacuous while no stage is smooth. The
missing content is the description of `A` as a colimit of underlying sets, and the hypothesis
that supplies it is `PreservesColimit (pres.diag ⋙ forget₂ (CommAlgCat R) CommRingCat)
(forget CommRingCat)` — exactly the instance argument Mathlib's sibling above carries. It is
found by instance search whenever `J : Type v` with `Category.{v} J` and `A : CommAlgCat.{v} R`,
which covers the source's small directed `I`, so taking it costs nothing there and keeps the
general index category.

The base change of `φ` along `R → Aᵢ` is the concrete `Algebra.TensorProduct.map (AlgHom.id R _)
φ`, that is `1 ⊗ φ`, which is the map the source writes, and is how Mathlib spells the base
change of an algebra map (`CommAlgCat.FiniteEtale.baseChange`,
`CommRingCat.tensorProd_map_right`). Those write the identity as an `↥Aᵢ`-algebra map, so that
the base change is one of `↥Aᵢ`-algebras; here it is written as an `R`-algebra map, the
underlying ring map — all that `RingHom.Smooth` sees — being the same. An abstract base change,
given by `Algebra.IsPushout R B (Aᵢ) Bᵢ` and `Algebra.IsPushout R C (Aᵢ) Cᵢ`, is carried to this
one by the canonical isomorphisms, along which smoothness transports; asking for such data for
every `i` would only add the transport to every application.

`φ` is an `AlgHom`, not a tower `[Algebra B C] [IsScalarTower R B C]`, because the three
properties in play are properties of a map with no algebra instance attached: they are
`RingHom.Smooth` and `RingHom.FinitePresentation` of the base changes and of `φ` itself.

Smoothness is Mathlib's `RingHom.Smooth`, which is `RingHom.FormallySmooth` together with
`RingHom.FinitePresentation` (`RingHom.smooth_def`). That is the source's Definition 00T2, not a
second definition: Mathlib's formal smoothness is the cotangent condition (`Ω` projective and
`H¹(L) = 0`), which with finite presentation is the source's condition on the naive cotangent
complex.

The conclusion is the source's existential. Its cofinal strengthening, `∀ i, ∃ j ≥ i`, follows in
one step from `RingHom.Smooth.isStableUnderBaseChange`, since `A_j ⊗[R] C` is the base change of
`A_i ⊗[R] C` along `A_i ⊗[R] B → A_j ⊗[R] B`, so it is a corollary rather than a separate
statement.

The name mutates `RingHom.EssFiniteType.exists_eq_comp_ι_app_of_isColimit`, Mathlib's
spreading-out lemma of the same shape: a property of a map, `exists_` the conclusion, `_of_` the
colimit hypothesis; and it is 07RI's name with `etale` replaced by `smooth`.

Faithfulness. (1) Every hypothesis is used: `hφ` fails and the conclusion with it for
`R = B = ℤ`, `C = ℚ` and `A = ℚ = colim ℤ[1/n!]`, where `ℚ → ℚ` is smooth but no
`ℤ[1/n!] → ℚ` is (it is formally étale, being a localization, and not of finite presentation);
`hA` fails together with the conclusion for `C = ℤ[x]/(x^2)` over that same system, which is of
finite presentation and smooth at no stage; and `IsFiltered J` supplies the nonemptiness that
`0 ∈ I` supplies in the source, without which no `i` exists. (2) The scalars and base are the
source's: both tensor products are over `R = A_0`, and smoothness is asserted of
`Aᵢ ⊗[R] B → Aᵢ ⊗[R] C`, a map out of `Aᵢ ⊗[R] B`, not of `R`- or `Aᵢ`-algebras. (3) The
canonical maps are pinned: the base change is the named map `1 ⊗ φ` rather than an unspecified
map `Aᵢ ⊗[R] B → Aᵢ ⊗[R] C`, and the comparison maps `Aᵢ → A` are the components of the cocone
carried by `pres`, which `pres.isColimit` exhibits as colimiting. (4) The instantiation is not
degenerate: with `R = ℤ`, `J = ℕ`, `Aᵢ = ℤ[1/i!]`, `A = ℚ`, `B = ℤ` and `C = ℤ[x]/(x(x - 2))`
the hypotheses hold and the conclusion holds exactly for those `i` with `2` invertible in
`ℤ[1/i!]`, that is for `i ≥ 2`, so the index produced is genuinely constrained.

## References

* [StacksProject 0C0B](https://stacks.math.columbia.edu/tag/0C0B)

## Tags

smooth, filtered colimit, base change, finite presentation, spreading out
-/

open CategoryTheory Limits



namespace RingHom.Smooth

/-- **Smoothness spreads out in a filtered colimit of base rings.** Let `A` be the colimit of a
filtered diagram of `R`-algebras `Aᵢ`, computed on underlying sets, and let `φ : B →ₐ[R] C` be of
finite presentation. If the base change `1 ⊗ φ : A ⊗[R] B → A ⊗[R] C` is smooth, then
`1 ⊗ φ : Aᵢ ⊗[R] B → Aᵢ ⊗[R] C` is smooth for some `i`. -/
@[stacks 0C0B "The source's `A_0` is the base ring `R` and its index set restricted to `i ≥ 0`,
which is cofinal, is the diagram; `A = colim A_i` is `Limits.ColimitPresentation J A` in
`CommAlgCat R` over a filtered `J` whose colimit is computed on underlying sets, and the base
change of `φ` is Mathlib's `Algebra.TensorProduct.map (AlgHom.id R _) φ`. Smooth is
`RingHom.Smooth`, the source's Definition 00T2. See the module docstring."]
public theorem exists_baseChange_smooth_of_colimitPresentation
    {R : Type u} [CommRing R] {J : Type w} [Category.{t} J] [IsFiltered J]
    {A : CommAlgCat.{v} R} (pres : ColimitPresentation J A)
    [PreservesColimit (pres.diag ⋙ forget₂ (CommAlgCat.{v} R) CommRingCat.{v})
      (forget CommRingCat)]
    {B C : Type*} [CommRing B] [CommRing C] [Algebra R B] [Algebra R C] (φ : B →ₐ[R] C)
    (hφ : φ.toRingHom.FinitePresentation)
    (hA : (Algebra.TensorProduct.map (AlgHom.id R ↥A) φ).toRingHom.Smooth) :
    ∃ i : J, (Algebra.TensorProduct.map (AlgHom.id R ↥(pres.diag.obj i)) φ).toRingHom.Smooth :=
  Stacks.SpreadingOut.Smoothness.solution (C := C) (B := B) (A := A) pres φ hφ hA

end RingHom.Smooth

end

/-!
# A smooth algebra over a filtered colimit descends to a finite stage

Let `I` be a filtered index category, let `(Aᵢ)_{i ∈ I}` be a filtered system of commutative
rings with filtered colimit `A = colim_{i ∈ I} Aᵢ` and canonical structure maps `ψᵢ : Aᵢ → A`,
and let `A → B` be a smooth ring map. Then there are an index `i ∈ I`, a commutative ring
`Bᵢ` and a smooth ring map `Aᵢ → Bᵢ` together with an isomorphism of `A`-algebras
`B ≅ Bᵢ ⊗_{Aᵢ} A`, where `Bᵢ ⊗_{Aᵢ} A` is the base change of `Bᵢ` along `ψᵢ`. In words: every
smooth algebra over a filtered colimit of rings is obtained by base change from a smooth
algebra over one of the rings in the system. This is Stacks Tag 0CAQ, Lemma 10.138.15.

## Conventions

* *Filtered colimit of rings.* The filtered system is a functor `F : I ⥤ CommRingCat` with `I`
  a small `IsFiltered` category. The colimit ring is `A = colimit F`, which agrees with the
  algebraic filtered colimit of rings, and the structure homomorphisms are
  `ψᵢ = colimit.ι F i : F.obj i ⟶ colimit F`.
* *Smooth ring map.* A ring homomorphism `R → S` is smooth if it is of finite presentation and
  formally smooth; this is `RingHom.Smooth` (cf. Stacks 00T2, 00TI, 00TN).
* *Base change.* Given `Aᵢ → Bᵢ` and the structure map `ψᵢ : Aᵢ → A`, the base change of `Bᵢ`
  along `ψᵢ` is `Bᵢ ⊗_{Aᵢ} A`, regarded as an `A`-algebra via the right tensor factor
  (`Algebra.TensorProduct.rightAlgebra`).
* Filteredness of `I` is essential: the result is false for arbitrary colimits.
* The conclusion is purely existential — an index `i`, a ring `Bᵢ`, a smooth map `Aᵢ → Bᵢ` and
  an `A`-algebra isomorphism `B ≅ Bᵢ ⊗_{Aᵢ} A`. No uniqueness or canonicity is claimed.
* A closely related Mathlib result is `Algebra.Smooth.exists_finiteType` (Stacks 00TP), stated
  for a general base together with an injective inclusion of a finitely generated subalgebra
  rather than a genuine filtered colimit.
-/

@[expose] public section

open CategoryTheory Limits
open scoped TensorProduct

universe u

/-! ## Decomposition of the argument

The Stacks 0CAQ argument is realised by the lemmas below:

```
  smooth  A → B   (A = colim_i A_i)
    │  (1) descend the *smooth* algebra to a finitely-generated subalgebra
    │      A₀ ⊆ A  of finite type over ℤ   [Stacks 00TP]
    ▼
  smooth  A₀ → B₀   with   B ≅ A ⊗_{A₀} B₀
    │  (2) the finite-type inclusion ι₀ : A₀ → A = colim A_i factors through
    │      a finite stage A_i = F.obj i        [Stacks 10.127.3 / 10.138.14]
    ▼
  ring map  φ : A₀ → A_i   with   ψ_i ∘ φ = ι₀
    │  (3) set  B_i := A_i ⊗_{A₀} B₀  (base change of the smooth A₀-algebra B₀
    │      along φ); base change preserves smoothness            [00TP/baseChange]
    ▼
  smooth  A_i → B_i   and   B ≅ A ⊗_{A₀} B₀ ≅ A ⊗_{A_i} (A_i ⊗_{A₀} B₀)
                               = A ⊗_{A_i} B_i ≅ B_i ⊗_{A_i} A
```

The last step uses `Algebra.TensorProduct.cancelBaseChange` and
`Algebra.TensorProduct.comm`.
-/

/-- If `A₀` is a finite-type `ℤ`-algebra and `ι₀ : A₀ → A = colimit F` is a ring map,
then `ι₀` factors through one of the rings `F.obj i` of the filtered system:
there are `i` and `φ : A₀ → F.obj i` with `(colimit.ι F i) ∘ φ = ι₀`.

This is the ring-theoretic content of Stacks 10.127.3 (a map out of a finitely
presented/finite-type ring into a filtered colimit factors through a finite
stage), specialised to the categorical colimit `colimit F` in `CommRingCat`. -/
@[sga "3 VIB 10.0" "(i)"]
theorem exists_descent_of_finiteType
    {I : Type u} [SmallCategory I] [IsFiltered I] (F : I ⥤ CommRingCat.{u})
    {A₀ : Type u} [CommRing A₀] [Algebra ℤ A₀] [Algebra.FiniteType ℤ A₀]
    (ι₀ : A₀ →+* (colimit F : CommRingCat.{u})) :
    ∃ (i : I) (φ : A₀ →+* (F.obj i : CommRingCat.{u})),
      (colimit.ι F i).hom.comp φ = ι₀ := by
  -- Helper: a single element of `F.obj i` mapping to 0 in the colimit becomes 0 at a stage.
  have zero_at_stage : ∀ (i : I) (x : F.obj i), (colimit.ι F i).hom x = 0 →
      ∃ (j : I) (p : i ⟶ j), (F.map p).hom x = 0 := by
    intro i x hx
    have h0 : (ConcreteCategory.hom (colimit.ι F i)) x
        = (ConcreteCategory.hom (colimit.ι F i)) (0 : F.obj i) := by
      change (colimit.ι F i).hom x = (colimit.ι F i).hom (0 : F.obj i)
      rw [hx, map_zero]
    rw [Concrete.colimit_rep_eq_iff_exists] at h0
    obtain ⟨k, p, q, hpq⟩ := h0
    refine ⟨k, p, ?_⟩
    change (ConcreteCategory.hom (F.map p)) x = 0
    rw [hpq]; change (F.map q).hom (0 : F.obj i) = 0; simp
  -- Helper: representatives of finitely many colimit elements at a common stage.
  have reps_fin_at_stage : ∀ (m : ℕ) (z : Fin m → (colimit F : CommRingCat.{u})),
      ∃ (j : I) (rr : Fin m → F.obj j), ∀ k, (colimit.ι F j).hom (rr k) = z k := by
    intro m z
    obtain ⟨j, hj⟩ := Stacks.SpreadingOut.Smoothness.exists_forall_of_finite
      (fun j (k : Fin m) => ∃ r : F.obj j, (colimit.ι F j).hom r = z k)
      (fun {i k} u a ⟨r, hr⟩ => ⟨(F.map u).hom r, by
        rw [← hr, ← RingHom.comp_apply, ← CommRingCat.hom_comp, colimit.w]⟩)
      (fun k => Concrete.colimit_exists_rep F (z k))
    choose r hr using hj
    exact ⟨j, r, hr⟩
  -- Main argument: `A₀` is finitely presented over `ℤ` (ℤ is Noetherian), so it is a
  -- quotient `MvPolynomial (Fin n) ℤ ⟶ A₀` with finitely generated kernel; place the
  -- variable images at a common stage, then coequalize the finitely many relations.
  obtain ⟨n, f, hsurj, hkerfg⟩ :=
    (Algebra.FinitePresentation.of_finiteType.mp inferInstance :
      Algebra.FinitePresentation ℤ A₀).out
  set y : Fin n → (colimit F : CommRingCat.{u}) := fun k => ι₀ (f (MvPolynomial.X k))
  obtain ⟨i₀, r, hr⟩ := reps_fin_at_stage n y
  set ψ₀ : MvPolynomial (Fin n) ℤ →+* F.obj i₀ :=
    MvPolynomial.eval₂Hom (algebraMap ℤ (F.obj i₀)) r with hψ₀
  have E1 : (colimit.ι F i₀).hom.comp ψ₀ = ι₀.comp f.toRingHom := by
    apply MvPolynomial.ringHom_ext
    · intro c
      change (colimit.ι F i₀).hom (ψ₀ (MvPolynomial.C c)) = ι₀ (f.toRingHom (MvPolynomial.C c))
      rw [hψ₀, MvPolynomial.eval₂Hom_C]
      have h1 : f.toRingHom (MvPolynomial.C c) = algebraMap ℤ A₀ c := by
        have hc : MvPolynomial.C c = algebraMap ℤ (MvPolynomial (Fin n) ℤ) c := by
          rw [MvPolynomial.algebraMap_eq]
        rw [hc]; exact f.commutes c
      rw [h1]; simp only [algebraMap_int_eq, eq_intCast, map_intCast]
    · intro k
      change (colimit.ι F i₀).hom (ψ₀ (MvPolynomial.X k)) = ι₀ (f.toRingHom (MvPolynomial.X k))
      rw [hψ₀, MvPolynomial.eval₂Hom_X', hr k]; rfl
  obtain ⟨gs, hgs⟩ := hkerfg
  classical
  set L : Finset (F.obj i₀) := gs.image ψ₀ with hL
  have hLzero : ∀ x ∈ L, (colimit.ι F i₀).hom x = 0 := by
    intro x hx
    obtain ⟨g, hg, rfl⟩ := Finset.mem_image.mp hx
    have hgker : g ∈ RingHom.ker f.toRingHom := by
      rw [← hgs]; exact Ideal.subset_span hg
    have heq : (colimit.ι F i₀).hom (ψ₀ g) = ι₀ (f.toRingHom g) := by
      simpa using RingHom.congr_fun E1 g
    rw [heq, RingHom.mem_ker.mp hgker, map_zero]
  obtain ⟨i₁, e, he⟩ := Stacks.SpreadingOut.Smoothness.exists_forall_mem_of_forall_exists
    (fun k (u : i₀ ⟶ k) (x : F.obj i₀) => (F.map u).hom x = 0)
    (fun {k l} u v x h => by simp [h]) L (fun x hx => zero_at_stage i₀ x (hLzero x hx))
  set ψ : MvPolynomial (Fin n) ℤ →+* F.obj i₁ := (F.map e).hom.comp ψ₀ with hψ
  have E2 : RingHom.ker f.toRingHom ≤ RingHom.ker ψ := by
    rw [← hgs, Ideal.span_le]
    intro g hg
    rw [SetLike.mem_coe, RingHom.mem_ker]
    change (F.map e).hom (ψ₀ g) = 0
    exact he (ψ₀ g) (Finset.mem_image_of_mem ψ₀ hg)
  obtain ⟨finv, hfinv⟩ := hsurj.hasRightInverse
  set φ : A₀ →+* F.obj i₁ := f.toRingHom.liftOfRightInverse finv hfinv ⟨ψ, E2⟩ with hφdef
  have hφ : φ.comp f.toRingHom = ψ :=
    RingHom.liftOfRightInverse_comp f.toRingHom finv hfinv ⟨ψ, E2⟩
  refine ⟨i₁, φ, ?_⟩
  have key : ((colimit.ι F i₁).hom.comp φ).comp f.toRingHom = ι₀.comp f.toRingHom := by
    rw [RingHom.comp_assoc, hφ, hψ, ← RingHom.comp_assoc]
    have hcolw : (colimit.ι F i₁).hom.comp (F.map e).hom = (colimit.ι F i₀).hom := by
      rw [← CommRingCat.hom_comp, colimit.w F e]
    rw [hcolw, E1]
  ext a
  obtain ⟨x, rfl⟩ := hsurj a
  exact RingHom.congr_fun key x

/-- Given a scalar tower `A₀ → A_i → A`, an `A₀`-algebra `B₀`, and a model ring `B_i`
that is `A_i`-isomorphic to the base change `A_i ⊗_{A₀} B₀`, the base change of
`B₀` to `A` is `A`-isomorphic to the base change `B_i ⊗_{A_i} A` of `B_i`. -/
theorem nonempty_algEquiv_tensorProduct_of_algEquiv (A₀ Ai A B₀ Bi : Type*)
    [CommRing A₀] [CommRing Ai] [CommRing A] [CommRing B₀] [CommRing Bi] [Algebra A₀ Ai]
    [Algebra A₀ A] [Algebra Ai A] [Algebra A₀ B₀] [Algebra Ai Bi] [IsScalarTower A₀ Ai A]
    (eBi : Bi ≃ₐ[Ai] Ai ⊗[A₀] B₀) :
    letI := Algebra.TensorProduct.rightAlgebra (R := Ai) (A := Bi) (B := A)
    Nonempty (A ⊗[A₀] B₀ ≃ₐ[A] Bi ⊗[Ai] A) := by
  let rA := Algebra.TensorProduct.rightAlgebra (R := Ai) (A := Bi) (B := A)
  -- A ⊗[A₀] B₀ ≃ₐ[A] A ⊗[Ai] (Ai ⊗[A₀] B₀)   (cancelBaseChange)
  let e2 := (Algebra.TensorProduct.cancelBaseChange A₀ Ai A A B₀)
  -- A ⊗[Ai] (Ai⊗B₀) ≃ₐ[A] A ⊗[Ai] Bi          (congr along eBi.symm)
  let e3 : A ⊗[Ai] (Ai ⊗[A₀] B₀) ≃ₐ[A] A ⊗[Ai] Bi :=
    Algebra.TensorProduct.congr AlgEquiv.refl eBi.symm
  -- A ⊗[Ai] Bi ≃ₐ[A] Bi ⊗[Ai] A               (comm, upgraded to A-algebra)
  let e4 : A ⊗[Ai] Bi ≃ₐ[A] Bi ⊗[Ai] A := by
    refine AlgEquiv.ofRingEquiv (f := (Algebra.TensorProduct.comm Ai A Bi).toRingEquiv) ?_
    intro a
    change (Algebra.TensorProduct.comm Ai A Bi) (algebraMap A _ a) = algebraMap A _ a
    rw [Algebra.TensorProduct.algebraMap_apply]
    simp [Algebra.TensorProduct.comm_tmul]
    rfl
  exact ⟨e2.symm.trans (e3.trans e4)⟩

/-- If `B₀` is a smooth `A₀`-algebra and `Ai` is any `A₀`-algebra, then the canonical
ring map `Ai → Ai ⊗[A₀] B₀`, `a ↦ a ⊗ 1` (`includeLeftRingHom`), is smooth. -/
theorem smooth_includeLeftRingHom (A₀ Ai B₀ : Type*) [CommRing A₀] [CommRing Ai] [CommRing B₀]
    [Algebra A₀ Ai] [Algebra A₀ B₀] [Algebra.Smooth A₀ B₀] :
    (Algebra.TensorProduct.includeLeftRingHom (R := A₀) (A := Ai) (B := B₀)).Smooth := by
  have hAi : (Algebra.TensorProduct.includeLeftRingHom (R := A₀) (A := Ai) (B := B₀)).toAlgebra
      = Algebra.TensorProduct.leftAlgebra (S := Ai) :=
    Algebra.algebra_ext _ _ fun _ => rfl
  change @Algebra.Smooth Ai _ (Ai ⊗[A₀] B₀) _
    (Algebra.TensorProduct.includeLeftRingHom (R := A₀) (A := Ai) (B := B₀)).toAlgebra
  rw [hAi]
  exact Algebra.Smooth.baseChange A₀ B₀ Ai

/-! ## Main result -/

/-- **Stacks Tag 0CAQ (Lemma 10.138.15).** Let `I` be a filtered category and
`F : I ⥤ CommRingCat` a filtered system of commutative rings with colimit
`A = colimit F` and structure maps `ψ_i = colimit.ι F i`. If `A → B` (given by a
morphism `f : colimit F ⟶ B`) is a smooth ring map, then there exist an index `i`,
a commutative ring `B_i`, and a smooth ring map `g : A_i → B_i`, such that `B` is
isomorphic, as an `A`-algebra, to the base change `B_i ⊗_{A_i} A` of `B_i` along
the structure map `ψ_i : A_i → A`. -/
@[stacks 0CAQ]
theorem smooth_descends_to_filtered_colimit
    {I : Type u} [SmallCategory I] [IsFiltered I] (F : I ⥤ CommRingCat.{u})
    (B : CommRingCat.{u}) (f : colimit F ⟶ B) :
    letI : Algebra (↑(colimit F) : Type u) (↑B : Type u) := f.hom.toAlgebra
    RingHom.Smooth f.hom →
    ∃ (i : I) (Bi : CommRingCat.{u}) (g : F.obj i ⟶ Bi),
      letI : Algebra (↑(F.obj i) : Type u) (↑Bi : Type u) := g.hom.toAlgebra
      letI : Algebra (↑(F.obj i) : Type u) (↑(colimit F) : Type u) :=
        (colimit.ι F i).hom.toAlgebra
      RingHom.Smooth g.hom ∧
      (letI : Algebra (↑(colimit F) : Type u) (↑B : Type u) := f.hom.toAlgebra
       letI := Algebra.TensorProduct.rightAlgebra
         (R := (↑(F.obj i) : Type u)) (A := (↑Bi : Type u)) (B := (↑(colimit F) : Type u))
       Nonempty ((↑B : Type u) ≃ₐ[(↑(colimit F) : Type u)]
         TensorProduct (↑(F.obj i) : Type u) (↑Bi : Type u) (↑(colimit F) : Type u))) := by
  -- Notation: `A := colimit F` (a `CommRing`), `f.hom : A → B` the given smooth map.
  intro hf
  -- `A`-algebra structure on `B` coming from `f`.
  let algB : Algebra (↑(colimit F) : Type u) (↑B : Type u) := f.hom.toAlgebra
  -- `RingHom.Smooth f.hom` unfolds to `Algebra.Smooth A B` for this instance.
  have hsmooth : Algebra.Smooth (↑(colimit F) : Type u) (↑B : Type u) := hf
  ----------------------------------------------------------------------------
  -- STEP 1 (Stacks 00TP, `Algebra.Smooth.exists_finiteType`).
  -- The smooth `A`-algebra `B` descends to a finite-type `ℤ`-subalgebra
  -- `A₀ ⊆ A`: there exist `A₀`, `B₀` with `A₀` finite type over `ℤ`, the
  -- structure map `A₀ → A` injective, `B₀` smooth over `A₀`, and an
  -- `A`-algebra isomorphism `B ≃ₐ[A] A ⊗[A₀] B₀`.
  ----------------------------------------------------------------------------
  obtain ⟨A₀, B₀, _, _, _, _, _, hinj, hA₀ft, hB₀smooth, ⟨eB⟩⟩ :=
    Algebra.Smooth.exists_finiteType ℤ (↑(colimit F) : Type u) (↑B : Type u)
  -- `A₀` carries: `CommRing A₀`, `Algebra ℤ A₀`, `Algebra A₀ A`,
  -- `Algebra A₀ B`, scalar towers; `B₀` carries `CommRing B₀`, `Algebra A₀ B₀`.
  -- The structure map `ι₀ : A₀ → A`.
  ----------------------------------------------------------------------------
  -- STEP 2 (Stacks 10.127.3, `exists_descent_of_finiteType`).
  -- The finite-type inclusion `ι₀ : A₀ → A = colimit F` factors through a
  -- finite stage: there are `i` and `φ : A₀ → F.obj i` with `ψ_i ∘ φ = ι₀`.
  ----------------------------------------------------------------------------
  obtain ⟨i, φ, hφ⟩ :=
    exists_descent_of_finiteType F (algebraMap A₀ (↑(colimit F) : Type u))
  -- Register `φ : A₀ → A_i` as the `A₀`-algebra structure on `A_i = F.obj i`,
  -- so the base change `A_i ⊗[A₀] B₀` is well-formed.
  let algA₀Ai : Algebra A₀ (↑(F.obj i) : Type u) := φ.toAlgebra
  -- STEP 3: assemble the witnesses.
  -- The model ring `B_i := F.obj i ⊗[A₀] B₀` (base change of `B₀` along `φ`).
  refine ⟨i, CommRingCat.of ((↑(F.obj i) : Type u) ⊗[A₀] (B₀)), ?_, ?_⟩
  · -- the structure ring map `g : A_i → B_i = A_i ⊗[A₀] B₀` (i.e. `a ↦ a ⊗ 1`),
    -- using `φ : A₀ → A_i` to make `A_i` an `A₀`-algebra.
    -- Strategy: `B_i = A_i ⊗_{A₀} B₀` is the canonical algebra map
    -- `Algebra.TensorProduct.includeLeftRingHom`-style structure map; package as a
    -- `CommRingCat` morphism `g : F.obj i ⟶ CommRingCat.of (A_i ⊗[A₀] B₀)`.
    exact CommRingCat.ofHom (Algebra.TensorProduct.includeLeftRingHom (R := A₀)
      (A := (↑(F.obj i) : Type u)) (B := B₀))
  · -- Smoothness of `g` AND the base-change iso, under the goal's `letI`s.
    refine ⟨?_, ?_⟩
    · -- (3a) Smoothness of `A_i → B_i`. `B₀` is smooth over `A₀` (`hB₀smooth`),
      -- and `B_i = A_i ⊗_{A₀} B₀` is its base change along `φ : A₀ → A_i`;
      -- smoothness is preserved by base change: `Algebra.Smooth.baseChange`
      -- (Stacks 00TP / 00T2). Need: the `A_i`-algebra structure on `B_i` here
      -- matches the `g.hom.toAlgebra` one, and the `A₀`-algebra structure on
      -- `A_i` is `φ`.
      exact @smooth_includeLeftRingHom A₀ (↑(F.obj i) : Type u) B₀ _ _ _
        algA₀Ai _ hB₀smooth
    · -- (3b) The `A`-algebra isomorphism `B ≃ₐ[A] B_i ⊗_{A_i} A`.
      -- Reduced to `nonempty_algEquiv_tensorProduct_of_algEquiv` (cancelBaseChange +
      -- comm), applied with `B_i := A_i ⊗[A₀] B₀`. We must supply: the scalar
      -- tower `A₀ → A_i → A` (from `hφ`) and the `A_i`-iso
      -- `eBi : B_i ≃ₐ[A_i] A_i ⊗[A₀] B₀`. Then chain `eB`.
      let algAiA : Algebra (↑(F.obj i) : Type u) (↑(colimit F) : Type u) :=
        (colimit.ι F i).hom.toAlgebra
      -- Scalar tower A₀ → A_i → A, from `ψ_i ∘ φ = ι₀` (hφ).
      have ist : IsScalarTower A₀ (↑(F.obj i) : Type u) (↑(colimit F) : Type u) := by
        refine IsScalarTower.of_algebraMap_eq fun x => ?_
        simpa [algAiA, RingHom.algebraMap_toAlgebra] using (RingHom.congr_fun hφ x).symm
      -- Set the `A_i`-algebra on `B_i = ↑(CommRingCat.of (A_i ⊗[A₀] B₀))` to be LITERALLY the
      -- goal's instance `g.hom.toAlgebra = (CommRingCat.ofHom includeLeftRingHom).hom.toAlgebra`,
      -- so the abstract lemma's `rightAlgebra` output matches the goal's `rightAlgebra`.
      let algAiBi : Algebra (↑(F.obj i) : Type u)
          (↑(CommRingCat.of ((↑(F.obj i) : Type u) ⊗[A₀] B₀)) : Type u) :=
        (CommRingCat.ofHom (Algebra.TensorProduct.includeLeftRingHom (R := A₀)
          (A := (↑(F.obj i) : Type u)) (B := B₀))).hom.toAlgebra
      -- `eBi : B_i ≃ₐ[A_i] A_i ⊗[A₀] B₀`. The carrier of `B_i` IS `A_i ⊗[A₀] B₀`; the source
      -- algebra is `algAiBi`, the target is the canonical `leftAlgebra`, which `algAiBi` equals.
      have eBi : @AlgEquiv (↑(F.obj i) : Type u)
          (↑(CommRingCat.of ((↑(F.obj i) : Type u) ⊗[A₀] B₀)) : Type u)
          ((↑(F.obj i) : Type u) ⊗[A₀] B₀) _ _ _ algAiBi
          (Algebra.TensorProduct.leftAlgebra) :=
        @AlgEquiv.ofRingEquiv (↑(F.obj i) : Type u)
          (↑(CommRingCat.of ((↑(F.obj i) : Type u) ⊗[A₀] B₀)) : Type u)
          ((↑(F.obj i) : Type u) ⊗[A₀] B₀) _ _ _ algAiBi Algebra.TensorProduct.leftAlgebra
          (RingEquiv.refl _) (fun _ => rfl)
      -- Apply the abstract lemma with `B_i` and its goal-matching `A_i`-algebra `algAiBi`.
      have hcore := @nonempty_algEquiv_tensorProduct_of_algEquiv A₀ (↑(F.obj i) : Type u)
        (↑(colimit F) : Type u) B₀
        (↑(CommRingCat.of ((↑(F.obj i) : Type u) ⊗[A₀] B₀)) : Type u)
        _ _ _ _ _ algA₀Ai _ algAiA _ algAiBi ist eBi
      -- The `rightAlgebra` in `hcore` is computed from `algAiBi`, matching the goal exactly.
      let rAlg := Algebra.TensorProduct.rightAlgebra
        (R := (↑(F.obj i) : Type u))
        (A := (↑(CommRingCat.of ((↑(F.obj i) : Type u) ⊗[A₀] B₀)) : Type u))
        (B := (↑(colimit F) : Type u))
      exact ⟨eB.trans hcore.some⟩

end
