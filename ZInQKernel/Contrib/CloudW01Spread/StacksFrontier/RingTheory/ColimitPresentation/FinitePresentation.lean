/-!
# Finitely presented algebras over a filtered colimit of rings come from a finite stage

Proof of Stacks 05N9: if `R = colim_λ R_λ` is a filtered colimit of rings, then the category of
finitely presented `R`-algebras is the colimit of the categories of finitely presented
`R_λ`-algebras.

## Main results

* `Stacks.ColimitPresentation.FiniteStage.solution`: the three items of Lemma 05N9.

## References

* [StacksProject 05N9](https://stacks.math.columbia.edu/tag/05N9)
-/

namespace Stacks.ColimitPresentation.FiniteStage

open CategoryTheory Limits

open scoped TensorProduct


attribute [local instance] MvPolynomial.algebraMvPolynomial

/-- A commuting square of rings whose two horizontal maps are surjective and whose right kernel is
generated by the image of the left kernel is a pushout square. -/
public lemma isPushout_of_surjective {S T A' A : CommRingCat.{u}}
    (p : S ⟶ A') (v : S ⟶ T) (a : A' ⟶ A) (π : T ⟶ A) (hsq : p ≫ a = v ≫ π)
    (hp : Function.Surjective p.hom) (hπ : Function.Surjective π.hom)
    (hker : RingHom.ker π.hom = (RingHom.ker p.hom).map v.hom) :
    IsPushout p v a π := by
  have hle : ∀ (X : CommRingCat.{u}) (l : A' ⟶ X) (r : T ⟶ X), p ≫ l = v ≫ r →
      RingHom.ker π.hom ≤ RingHom.ker r.hom := by
    intro X l r h
    rw [hker, Ideal.map_le_iff_le_comap]
    intro x hx
    have e : (p ≫ l).hom x = (v ≫ r).hom x := by rw [h]
    simp only [CommRingCat.hom_comp, RingHom.coe_comp, Function.comp_apply] at e
    rw [RingHom.mem_ker] at hx
    simp only [Ideal.mem_comap, RingHom.mem_ker, ← e, hx, map_zero]
  refine ⟨⟨hsq⟩, ⟨PushoutCocone.IsColimit.mk _
    (fun s ↦ CommRingCat.ofHom (RingHom.liftOfSurjective π.hom hπ
      ⟨s.inr.hom, hle _ s.inl s.inr s.condition⟩)) ?_ ?_ ?_⟩⟩
  · intro s
    ext y
    obtain ⟨x, rfl⟩ := hp y
    have e : (p ≫ a).hom x = (v ≫ π).hom x := by rw [hsq]
    have e2 : (p ≫ s.inl).hom x = (v ≫ s.inr).hom x := by rw [s.condition]
    simp only [CommRingCat.hom_comp, RingHom.coe_comp, Function.comp_apply] at e e2
    simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.coe_comp,
      Function.comp_apply, e, RingHom.liftOfSurjective_comp_apply, e2]
  · intro s
    ext x
    simp [RingHom.liftOfSurjective_comp_apply]
  · intro s m _ hr
    ext y
    obtain ⟨x, rfl⟩ := hπ y
    have e : (π ≫ m).hom x = s.inr.hom x := by rw [hr]
    simp only [CommRingCat.hom_comp, RingHom.coe_comp, Function.comp_apply] at e
    simp [e, RingHom.liftOfSurjective_comp_apply]


/-- Composition of ring maps, read on elements. -/
private lemma hom_comp_apply {X Y Z : CommRingCat.{u}} (p : X ⟶ Y) (q : Y ⟶ Z) (x : X) :
    q.hom (p.hom x) = (p ≫ q).hom x := rfl

/-- In a filtered category, finitely many conditions, each of which holds at some later stage and
persists along further morphisms, hold simultaneously at a single later stage. -/
private lemma exists_forall_of_isFiltered {K : Type*} [Category.{w} K] [IsFiltered K] {a : K}
    {ι : Type*} (Pr : ∀ b : K, (a ⟶ b) → ι → Prop)
    (hmono : ∀ (b b' : K) (f : a ⟶ b) (g : b ⟶ b') (i : ι), Pr b f i → Pr b' (f ≫ g) i)
    (s : Finset ι) :
    (∀ i ∈ s, ∃ (b : K) (f : a ⟶ b), Pr b f i) →
      ∃ (b : K) (f : a ⟶ b), ∀ i ∈ s, Pr b f i := by
  classical
  induction s using Finset.induction_on with
  | empty => exact fun _ => ⟨a, 𝟙 a, by simp⟩
  | @insert i s hi ih =>
      intro h
      obtain ⟨b₁, f₁, h₁⟩ := h i (Finset.mem_insert_self i s)
      obtain ⟨b₂, f₂, h₂⟩ := ih fun x hx => h x (Finset.mem_insert_of_mem hx)
      obtain ⟨l, m₁, m₂, hm⟩ := IsFiltered.span f₁ f₂
      refine ⟨l, f₁ ≫ m₁, fun x hx => ?_⟩
      rcases Finset.mem_insert.mp hx with rfl | hx
      · exact hmono _ _ f₁ m₁ x h₁
      · rw [hm]; exact hmono _ _ f₂ m₂ x (h₂ x hx)


/-! ### Descent along a filtered system of modules

The two lemmas of this section say that `- ⊗[R] M` turns a filtered system of `R`-modules whose
colimit is `N` (recorded elementwise by `hsurj` and `hz`) into a filtered system whose colimit is
`N ⊗[R] M`. -/

section ModuleDescent

variable {R : Type u} [CommRing R] {M : Type u} [AddCommGroup M] [Module R M]
  {N : Type u} [AddCommGroup N] [Module R N] {K : Type*} [Category.{w} K] [IsFiltered K]
  {P : K → Type u} [∀ a, AddCommGroup (P a)] [∀ a, Module R (P a)]
  (tr : ∀ a b : K, (a ⟶ b) → (P a →ₗ[R] P b)) (ap : ∀ a, P a →ₗ[R] N)
  (htr : ∀ (a b d : K) (f : a ⟶ b) (g : b ⟶ d), tr a d (f ≫ g) = (tr b d g).comp (tr a b f))
  (hap : ∀ (a b : K) (f : a ⟶ b), (ap b).comp (tr a b f) = ap a)
  (hsurj : ∀ x : N, ∃ (a : K) (y : P a), ap a y = x)
  (hz : ∀ (a : K) (y : P a), ap a y = 0 → ∃ (b : K) (f : a ⟶ b), tr a b f y = 0)

omit [IsFiltered K] in
include htr in
private lemma rTensor_tr_comp {a b d : K} (f : a ⟶ b) (g : b ⟶ d) (w : P a ⊗[R] M) :
    LinearMap.rTensor M (tr a d (f ≫ g)) w =
      LinearMap.rTensor M (tr b d g) (LinearMap.rTensor M (tr a b f) w) := by
  rw [htr a b d f g, LinearMap.rTensor_comp_apply]

omit [IsFiltered K] in
include hap in
private lemma range_ap_le {a b : K} (f : a ⟶ b) :
    LinearMap.range (ap a) ≤ LinearMap.range (ap b) := by
  rintro _ ⟨y, rfl⟩
  exact ⟨tr a b f y, by rw [← LinearMap.comp_apply, hap a b f]⟩

include hap hsurj in
private lemma exists_le_range_ap (Q : Submodule R N) (hQ : Q.FG) :
    ∃ a : K, Q ≤ LinearMap.range (ap a) := by
  have htop : (⨆ a : K, LinearMap.range (ap a) : Submodule R N) = ⊤ :=
    eq_top_iff.mpr fun x _ => by
      obtain ⟨a, y, hy⟩ := hsurj x
      exact Submodule.mem_iSup_of_mem a ⟨y, hy⟩
  obtain ⟨s, hs⟩ := IsCompactElement.exists_finset_of_le_iSup
    ((Submodule.fg_iff_compact Q).mp hQ) _ (by rw [htop]; exact le_top)
  obtain ⟨S, hS⟩ := IsFiltered.sup_objs_exists s
  refine ⟨S, hs.trans (iSup_le fun a => iSup_le fun ha => ?_)⟩
  obtain ⟨f⟩ := hS ha
  exact range_ap_le tr ap hap f

include htr hz in
private lemma exists_map_rTensor_subtype_eq_zero {a : K}
    (u : (LinearMap.ker (ap a)) ⊗[R] M) :
    ∃ (b : K) (f : a ⟶ b), LinearMap.rTensor M (tr a b f)
      (LinearMap.rTensor M (LinearMap.ker (ap a)).subtype u) = 0 := by
  induction u using TensorProduct.inductionOn with
  | tmul y m =>
      obtain ⟨b, f, hf⟩ := hz a y.1 (LinearMap.mem_ker.mp y.2)
      exact ⟨b, f, by simp [hf]⟩
  | add u₁ u₂ h₁ h₂ =>
      obtain ⟨b₁, f₁, hf₁⟩ := h₁
      obtain ⟨b₂, f₂, hf₂⟩ := h₂
      obtain ⟨l, m₁, m₂, hm⟩ := IsFiltered.span f₁ f₂
      refine ⟨l, f₁ ≫ m₁, ?_⟩
      rw [map_add, map_add, rTensor_tr_comp tr htr f₁ m₁, hf₁, map_zero, zero_add]
      rw [hm, rTensor_tr_comp tr htr f₂ m₂, hf₂, map_zero]

include hap hsurj in
private lemma exists_rTensor_eq (z : N ⊗[R] M) :
    ∃ (a : K) (w : P a ⊗[R] M), LinearMap.rTensor M (ap a) w = z := by
  induction z using TensorProduct.inductionOn with
  | tmul x m =>
      obtain ⟨a, y, hy⟩ := hsurj x
      exact ⟨a, y ⊗ₜ m, by simp [hy]⟩
  | add z₁ z₂ h₁ h₂ =>
      obtain ⟨a₁, w₁, hw₁⟩ := h₁
      obtain ⟨a₂, w₂, hw₂⟩ := h₂
      refine ⟨IsFiltered.max a₁ a₂,
        LinearMap.rTensor M (tr _ _ (IsFiltered.leftToMax a₁ a₂)) w₁ +
          LinearMap.rTensor M (tr _ _ (IsFiltered.rightToMax a₁ a₂)) w₂, ?_⟩
      rw [map_add, ← LinearMap.rTensor_comp_apply, ← LinearMap.rTensor_comp_apply,
        hap _ _ (IsFiltered.leftToMax a₁ a₂), hap _ _ (IsFiltered.rightToMax a₁ a₂), hw₁, hw₂]

include htr hap hsurj hz in
private lemma exists_map_rTensor_eq_zero {a : K} (w : P a ⊗[R] M)
    (hw : LinearMap.rTensor M (ap a) w = 0) :
    ∃ (b : K) (f : a ⟶ b), LinearMap.rTensor M (tr a b f) w = 0 := by
  set w' := LinearMap.rTensor M (ap a).rangeRestrict w with hw'
  have hsub : LinearMap.rTensor M (LinearMap.range (ap a)).subtype w' = 0 := by
    rw [hw', ← LinearMap.rTensor_comp_apply, LinearMap.subtype_comp_rangeRestrict, hw]
  obtain ⟨Q, hQfg, hQle, y, hy⟩ := Submodule.exists_fg_le_eq_rTensor_inclusion w'
  have hy0 : LinearMap.rTensor M Q.subtype y = 0 := by
    rw [← Submodule.subtype_comp_inclusion Q _ hQle, LinearMap.rTensor_comp_apply, ← hy, hsub]
  obtain ⟨Q', hQ'fg, hle', hzero⟩ :=
    hQfg.exists_rTensor_fg_inclusion_eq (M := M) (x := y) (y := 0) (by simpa using hy0)
  obtain ⟨d, hd⟩ := exists_le_range_ap tr ap hap hsurj Q' hQ'fg
  obtain ⟨b, f, hzz⟩ : ∃ (b : K) (f : a ⟶ b),
      LinearMap.rTensor M (ap b).rangeRestrict (LinearMap.rTensor M (tr a b f) w) = 0 := by
    refine ⟨IsFiltered.max a d, IsFiltered.leftToMax a d, ?_⟩
    have hkle : Q' ≤ LinearMap.range (ap (IsFiltered.max a d)) :=
      hd.trans (range_ap_le tr ap hap (IsFiltered.rightToMax a d))
    have hQk : Q ≤ LinearMap.range (ap (IsFiltered.max a d)) := hle'.trans hkle
    have hyk : LinearMap.rTensor M (Submodule.inclusion hQk) y = 0 := by
      have hfac : Submodule.inclusion hQk =
          (Submodule.inclusion hkle).comp (Submodule.inclusion hle') := rfl
      rw [hfac, LinearMap.rTensor_comp_apply, hzero, map_zero, map_zero]
    have hle2 : LinearMap.range (ap a) ≤ LinearMap.range (ap (IsFiltered.max a d)) :=
      range_ap_le tr ap hap (IsFiltered.leftToMax a d)
    have hmid : (ap (IsFiltered.max a d)).comp
          (tr a (IsFiltered.max a d) (IsFiltered.leftToMax a d)) = ap a :=
      hap a (IsFiltered.max a d) (IsFiltered.leftToMax a d)
    have hmid' : (ap (IsFiltered.max a d)).rangeRestrict.comp
          (tr a (IsFiltered.max a d) (IsFiltered.leftToMax a d)) =
        (Submodule.inclusion hle2).comp (ap a).rangeRestrict := by
      ext x
      exact DFunLike.congr_fun hmid x
    rw [← LinearMap.rTensor_comp_apply, hmid', LinearMap.rTensor_comp_apply, ← hw', hy,
      ← LinearMap.rTensor_comp_apply]
    have hfac2 : (Submodule.inclusion hle2).comp (Submodule.inclusion hQle) =
        Submodule.inclusion hQk := rfl
    rw [hfac2, hyk]
  have hex : Function.Exact
      (LinearMap.rTensor M (LinearMap.ker (ap b)).subtype)
      (LinearMap.rTensor M (ap b).rangeRestrict) :=
    rTensor_exact M
      (by rw [LinearMap.exact_iff, LinearMap.ker_rangeRestrict, Submodule.range_subtype])
      (ap b).surjective_rangeRestrict
  obtain ⟨u, hu⟩ := (hex _).mp hzz
  obtain ⟨b', f', hf'⟩ := exists_map_rTensor_subtype_eq_zero tr ap htr hz u
  exact ⟨b', f ≫ f', by rw [rTensor_tr_comp tr htr f f', ← hu, hf']⟩

end ModuleDescent

/-! ### Descent along a filtered system of algebras -/

section AlgebraDescent

variable {R : Type u} [CommRing R] {Bp : Type u} [CommRing Bp] [Algebra R Bp]
  {W : Type u} [CommRing W] [Algebra R W] {K : Type*} [Category.{w} K] [IsFiltered K]
  {P : K → Type u} [∀ a, CommRing (P a)] [∀ a, Algebra R (P a)]
  (tr : ∀ a b : K, (a ⟶ b) → (P a →ₐ[R] P b)) (ap : ∀ a, P a →ₐ[R] W)
  (htr : ∀ (a b d : K) (f : a ⟶ b) (g : b ⟶ d), tr a d (f ≫ g) = (tr b d g).comp (tr a b f))
  (hap : ∀ (a b : K) (f : a ⟶ b), (ap b).comp (tr a b f) = ap a)
  (hsurj : ∀ x : W, ∃ (a : K) (y : P a), ap a y = x)
  (hz : ∀ (a : K) (y : P a), ap a y = 0 → ∃ (b : K) (f : a ⟶ b), tr a b f y = 0)

/-- Base change of an algebra map along the identity, read as a linear map. -/
private lemma map_id_apply {A A' : Type u} [CommRing A] [Algebra R A] [CommRing A'] [Algebra R A']
    (φ : A →ₐ[R] A') (z : A ⊗[R] Bp) :
    Algebra.TensorProduct.map φ (AlgHom.id R Bp) z = LinearMap.rTensor Bp φ.toLinearMap z := by
  induction z using TensorProduct.inductionOn with
  | tmul x y => simp
  | add z₁ z₂ h₁ h₂ => rw [map_add, map_add, h₁, h₂]

include hap hsurj in
private lemma exists_map_alg_eq (z : W ⊗[R] Bp) :
    ∃ (a : K) (y : P a ⊗[R] Bp), Algebra.TensorProduct.map (ap a) (AlgHom.id R Bp) y = z := by
  obtain ⟨a, y, hy⟩ := exists_rTensor_eq (M := Bp) (fun a b f => (tr a b f).toLinearMap)
    (fun a => (ap a).toLinearMap)
    (fun a b f => by ext x; exact DFunLike.congr_fun (hap a b f) x) hsurj z
  exact ⟨a, y, by rw [map_id_apply, hy]⟩

include htr hap hsurj hz in
private lemma exists_map_map_eq_zero {a : K} (y : P a ⊗[R] Bp)
    (hy : Algebra.TensorProduct.map (ap a) (AlgHom.id R Bp) y = 0) :
    ∃ (b : K) (f : a ⟶ b), Algebra.TensorProduct.map (tr a b f) (AlgHom.id R Bp) y = 0 := by
  obtain ⟨b, f, hf⟩ := exists_map_rTensor_eq_zero (M := Bp)
    (fun a b f => (tr a b f).toLinearMap) (fun a => (ap a).toLinearMap)
    (fun a b d f g => by ext x; exact DFunLike.congr_fun (htr a b d f g) x)
    (fun a b f => by ext x; exact DFunLike.congr_fun (hap a b f) x) hsurj hz y
    (by rw [← map_id_apply]; exact hy)
  exact ⟨b, f, by rw [map_id_apply]; exact hf⟩

/-- Base change along `- ⊗[R] Bp` takes a composition to the composition. -/
private lemma map_id_comp {A₁ A₂ A₃ : Type u} [CommRing A₁] [Algebra R A₁] [CommRing A₂]
    [Algebra R A₂] [CommRing A₃] [Algebra R A₃] (φ : A₁ →ₐ[R] A₂) (ψ : A₂ →ₐ[R] A₃)
    (z : A₁ ⊗[R] Bp) :
    Algebra.TensorProduct.map (ψ.comp φ) (AlgHom.id R Bp) z =
      Algebra.TensorProduct.map ψ (AlgHom.id R Bp)
        (Algebra.TensorProduct.map φ (AlgHom.id R Bp) z) := by
  induction z using TensorProduct.inductionOn with
  | tmul x y => simp
  | add z₁ z₂ h₁ h₂ => simp only [map_add, h₁, h₂]

omit [IsFiltered K] in
include hap in
private lemma map_ap_map_tr {a b : K} (f : a ⟶ b) (y : P a ⊗[R] Bp) :
    Algebra.TensorProduct.map (ap b) (AlgHom.id R Bp)
        (Algebra.TensorProduct.map (tr a b f) (AlgHom.id R Bp) y) =
      Algebra.TensorProduct.map (ap a) (AlgHom.id R Bp) y := by
  rw [← map_id_comp (tr a b f) (ap b) y, hap a b f]

omit [IsFiltered K] in
include htr in
private lemma map_tr_map_tr {a b d : K} (f : a ⟶ b) (g : b ⟶ d) (y : P a ⊗[R] Bp) :
    Algebra.TensorProduct.map (tr a d (f ≫ g)) (AlgHom.id R Bp) y =
      Algebra.TensorProduct.map (tr b d g) (AlgHom.id R Bp)
        (Algebra.TensorProduct.map (tr a b f) (AlgHom.id R Bp) y) := by
  rw [htr a b d f g, map_id_comp]

include htr hap hsurj hz in
/-- Two `R`-algebra maps out of an `R`-algebra of finite type into `Bp` whose base changes to `W`
agree already have equal base changes to some stage. -/
private theorem exists_one_tmul_eq {A : Type u} [CommRing A] [Algebra R A]
    (hA : Algebra.FiniteType R A) (φ ψ : A →ₐ[R] Bp)
    (h : ∀ x : A, (1 : W) ⊗ₜ[R] φ x = (1 : W) ⊗ₜ[R] ψ x) :
    ∃ a : K, ∀ x : A, (1 : P a) ⊗ₜ[R] φ x = (1 : P a) ⊗ₜ[R] ψ x := by
  classical
  obtain ⟨t, ht⟩ := hA.out
  obtain ⟨a₀⟩ : Nonempty K := IsFiltered.nonempty
  have key : ∀ x ∈ t, ∃ (b : K) (_ : a₀ ⟶ b),
      (1 : P b) ⊗ₜ[R] φ x = (1 : P b) ⊗ₜ[R] ψ x := by
    intro x _
    have h0 : Algebra.TensorProduct.map (ap a₀) (AlgHom.id R Bp)
        ((1 : P a₀) ⊗ₜ[R] (φ x - ψ x)) = 0 := by
      simp [TensorProduct.tmul_sub, h x]
    obtain ⟨b, f, hf⟩ := exists_map_map_eq_zero tr ap htr hap hsurj hz _ h0
    exact ⟨b, f, by simpa [TensorProduct.tmul_sub, sub_eq_zero] using hf⟩
  obtain ⟨a, -, ha⟩ := exists_forall_of_isFiltered
    (fun (b : K) (_ : a₀ ⟶ b) (x : A) => (1 : P b) ⊗ₜ[R] φ x = (1 : P b) ⊗ₜ[R] ψ x)
    (fun b b' f g x hx => by
      simpa using congrArg (Algebra.TensorProduct.map (tr b b' g) (AlgHom.id R Bp)) hx)
    t key
  refine ⟨a, fun x => ?_⟩
  have hext : (Algebra.TensorProduct.includeRight (R := R) (A := P a) (B := Bp)).comp φ =
      (Algebra.TensorProduct.includeRight (R := R) (A := P a) (B := Bp)).comp ψ :=
    AlgHom.ext_of_adjoin_eq_top ht fun x hx => by
      simpa using ha x (Finset.mem_coe.mp hx)
  simpa using DFunLike.congr_fun hext x

include htr hap hsurj hz in
/-- An `R`-algebra map from an `R`-algebra of finite presentation into the base change `W ⊗[R] Bp`
factors through the base change `P a ⊗[R] Bp` at some stage `a`. -/
@[ega "IV 8.8.2.1" "partial"]
private theorem exists_algHom_map_comp_eq {A : Type u} [CommRing A] [Algebra R A]
    (hA : Algebra.FinitePresentation R A) (ρ : A →ₐ[R] W ⊗[R] Bp) :
    ∃ (a : K) (σ : A →ₐ[R] P a ⊗[R] Bp),
      (Algebra.TensorProduct.map (ap a) (AlgHom.id R Bp)).comp σ = ρ := by
  classical
  obtain ⟨n, π, hπ, hker⟩ := hA.out
  obtain ⟨s, hs⟩ := hker
  obtain ⟨a₀⟩ : Nonempty K := IsFiltered.nonempty
  obtain ⟨a₁, -, hlift⟩ := exists_forall_of_isFiltered
      (fun (b : K) (_ : a₀ ⟶ b) (i : Fin n) => ∃ y : P b ⊗[R] Bp,
        Algebra.TensorProduct.map (ap b) (AlgHom.id R Bp) y = ρ (π (MvPolynomial.X i)))
      (fun b b' f g i hi => by
        obtain ⟨y, hy⟩ := hi
        exact ⟨Algebra.TensorProduct.map (tr b b' g) (AlgHom.id R Bp) y,
          by rw [map_ap_map_tr tr ap hap, hy]⟩)
      Finset.univ (fun i _ => by
        obtain ⟨d, y, hy⟩ := exists_map_alg_eq tr ap hap hsurj (ρ (π (MvPolynomial.X i)))
        exact ⟨IsFiltered.max a₀ d, IsFiltered.leftToMax a₀ d,
          Algebra.TensorProduct.map (tr d _ (IsFiltered.rightToMax a₀ d)) (AlgHom.id R Bp) y,
          by rw [map_ap_map_tr tr ap hap, hy]⟩)
  choose y hy using fun i : Fin n => hlift i (Finset.mem_univ i)
  have hσ₀ : ∀ p : MvPolynomial (Fin n) R,
      Algebra.TensorProduct.map (ap a₁) (AlgHom.id R Bp) (MvPolynomial.aeval y p) = ρ (π p) := by
    have h : (Algebra.TensorProduct.map (ap a₁) (AlgHom.id R Bp)).comp
        (MvPolynomial.aeval y) = ρ.comp π :=
      MvPolynomial.algHom_ext fun i => by simpa using hy i
    exact fun p => DFunLike.congr_fun h p
  obtain ⟨a₂, f₂, hkill⟩ := exists_forall_of_isFiltered
      (fun (b : K) (f : a₁ ⟶ b) (r : MvPolynomial (Fin n) R) =>
        Algebra.TensorProduct.map (tr a₁ b f) (AlgHom.id R Bp) (MvPolynomial.aeval y r) = 0)
      (fun b b' f g r hr => by rw [map_tr_map_tr tr htr, hr, map_zero])
      s (fun r hr => by
        refine exists_map_map_eq_zero tr ap htr hap hsurj hz _ ?_
        have hr0 : π r = 0 := by
          have hmem : r ∈ RingHom.ker π.toRingHom := by rw [← hs]; exact Ideal.subset_span hr
          simpa [RingHom.mem_ker] using hmem
        rw [hσ₀ r, hr0, map_zero])
  set σ₁ : MvPolynomial (Fin n) R →ₐ[R] P a₂ ⊗[R] Bp :=
    (Algebra.TensorProduct.map (tr a₁ a₂ f₂) (AlgHom.id R Bp)).comp (MvPolynomial.aeval y)
    with hσ₁
  have hle : RingHom.ker π.toRingHom ≤ RingHom.ker σ₁.toRingHom := by
    rw [← hs, Ideal.span_le]
    intro r hr
    simpa [hσ₁, RingHom.mem_ker] using hkill r hr
  set σR : A →+* P a₂ ⊗[R] Bp :=
    RingHom.liftOfSurjective π.toRingHom hπ ⟨σ₁.toRingHom, hle⟩ with hσR
  have hσRπ : ∀ p, σR (π p) = σ₁ p := fun p =>
    RingHom.liftOfSurjective_comp_apply π.toRingHom hπ ⟨σ₁.toRingHom, hle⟩ p
  have hcomm : ∀ r : R, σR (algebraMap R A r) = algebraMap R (P a₂ ⊗[R] Bp) r := by
    intro r
    rw [← π.commutes r, hσRπ]
    exact σ₁.commutes r
  refine ⟨a₂, { __ := σR, commutes' := hcomm }, ?_⟩
  · ext x
    obtain ⟨p, rfl⟩ := hπ x
    change Algebra.TensorProduct.map (ap a₂) (AlgHom.id R Bp) (σR (π p)) = ρ (π p)
    rw [hσRπ, hσ₁, AlgHom.comp_apply, map_ap_map_tr tr ap hap, hσ₀]

end AlgebraDescent

section Stages

variable {J : Type v} [Category.{w} J] [IsFiltered J] {F : J ⥤ CommRingCat.{u}} {c : Cocone F}
  (hc : IsColimit c) [PreservesColimit F (forget CommRingCat.{u})]

include hc in
omit [IsFiltered J] in
/-- Every element of a filtered colimit of rings comes from a stage. -/
private lemma exists_ι_app_eq (x : c.pt) : ∃ (k : J) (y : F.obj k), c.ι.app k y = x := by
  have h := Types.jointly_surjective_of_isColimit
    (isColimitOfPreserves (forget CommRingCat.{u}) hc)
  obtain ⟨k, y, hy⟩ := h x
  exact ⟨k, y, hy⟩

include hc in
/-- Two elements of a stage with the same image in a filtered colimit of rings agree at a
later stage. -/
private lemma exists_map_eq {k : J} (x y : F.obj k) (h : c.ι.app k x = c.ι.app k y) :
    ∃ (k' : J) (u : k ⟶ k'), F.map u x = F.map u y :=
  (Types.FilteredColimit.isColimit_eq_iff' (isColimitOfPreserves (forget _) hc) x y).mp h

include hc in
/-- A polynomial over a filtered colimit of rings is the image of a polynomial over a stage. -/
private lemma exists_mvPolynomial_map_eq (n : ℕ) (p : MvPolynomial (Fin n) c.pt) :
    ∃ (k : J) (q : MvPolynomial (Fin n) (F.obj k)),
      MvPolynomial.map (c.ι.app k).hom q = p := by
  induction p using MvPolynomial.induction_on with
  | C a =>
      obtain ⟨k, y, hy⟩ := exists_ι_app_eq hc a
      exact ⟨k, MvPolynomial.C y, by simp [hy]⟩
  | add p₁ p₂ h₁ h₂ =>
      obtain ⟨k₁, q₁, hq₁⟩ := h₁
      obtain ⟨k₂, q₂, hq₂⟩ := h₂
      refine ⟨IsFiltered.max k₁ k₂,
        MvPolynomial.map (F.map (IsFiltered.leftToMax k₁ k₂)).hom q₁ +
          MvPolynomial.map (F.map (IsFiltered.rightToMax k₁ k₂)).hom q₂, ?_⟩
      rw [map_add, MvPolynomial.map_map, MvPolynomial.map_map,
        ← CommRingCat.hom_comp, ← CommRingCat.hom_comp, c.w, c.w, hq₁, hq₂]
  | mul_X p i h =>
      obtain ⟨k, q, hq⟩ := h
      exact ⟨k, q * MvPolynomial.X i, by simp [hq]⟩

include hc in
/-- A finite family of polynomials over a filtered colimit of rings comes from a single stage. -/
private lemma exists_mvPolynomial_family_map_eq (n : ℕ) {ι : Type*} [Finite ι]
    (p : ι → MvPolynomial (Fin n) c.pt) :
    ∃ (k : J) (q : ι → MvPolynomial (Fin n) (F.obj k)),
      ∀ i, MvPolynomial.map (c.ι.app k).hom (q i) = p i := by
  classical
  let _ := Fintype.ofFinite ι
  choose kk qq hqq using fun i ↦ exists_mvPolynomial_map_eq hc n (p i)
  obtain ⟨k, ⟨hk⟩⟩ : ∃ k, Nonempty (∀ i, kk i ⟶ k) := by
    have h : ∃ k, ∀ i, Nonempty (kk i ⟶ k) := by
      simpa using! IsFiltered.sup_objs_exists (Finset.univ.image kk)
    simpa [← exists_true_iff_nonempty, Classical.skolem, -exists_const_iff] using! h
  refine ⟨k, fun i ↦ MvPolynomial.map (F.map (hk i)).hom (qq i), fun i ↦ ?_⟩
  rw [MvPolynomial.map_map, ← CommRingCat.hom_comp, c.w, hqq]

include hc in
/-- Every element of a filtered colimit of rings comes from a stage lying over a given object. -/
private lemma exists_under_ι_app_eq (j : J) (x : c.pt) :
    ∃ (a : Under j) (y : F.obj a.right), (c.ι.app a.right).hom y = x := by
  obtain ⟨k, y, hy⟩ := exists_ι_app_eq hc x
  refine ⟨Under.mk (IsFiltered.leftToMax j k),
    (F.map (IsFiltered.rightToMax j k)).hom y, ?_⟩
  change (c.ι.app (IsFiltered.max j k)).hom ((F.map (IsFiltered.rightToMax j k)).hom y) = x
  rw [hom_comp_apply, c.w]
  exact hy

include hc in
/-- An element of a stage dying in a filtered colimit of rings dies at a later stage lying over a
given object. -/
private lemma exists_under_map_eq_zero (j : J) (a : Under j) (y : F.obj a.right)
    (hy : (c.ι.app a.right).hom y = 0) :
    ∃ (b : Under j) (f : a ⟶ b), (F.map f.right).hom y = 0 := by
  obtain ⟨k, u, hu⟩ := exists_map_eq hc y 0 (by rw [hy, map_zero])
  refine ⟨Under.mk (a.hom ≫ u), Under.homMk u rfl, ?_⟩
  change (F.map u).hom y = 0
  have h0 : (F.map u).hom y = (F.map u).hom 0 := hu
  rw [h0, map_zero]

/-- The stages over `j` form a filtered system of `F.obj j`-algebras with colimit `c.pt`, in the
form consumed by the descent lemmas. -/
private theorem exists_under_system (hc : IsColimit c) (j : J) :
    letI : Algebra ↥(F.obj j) ↥c.pt := (c.ι.app j).hom.toAlgebra
    letI : ∀ a : Under j, Algebra ↥(F.obj j) ↥(F.obj a.right) :=
      fun a => (F.map a.hom).hom.toAlgebra
    ∃ (tr : ∀ a b : Under j, (a ⟶ b) →
        (↥(F.obj a.right) →ₐ[↥(F.obj j)] ↥(F.obj b.right)))
      (ap : ∀ a : Under j, ↥(F.obj a.right) →ₐ[↥(F.obj j)] ↥c.pt),
      (∀ (a b d : Under j) (w : a ⟶ b) (w' : b ⟶ d),
        tr a d (w ≫ w') = (tr b d w').comp (tr a b w)) ∧
      (∀ (a b : Under j) (w : a ⟶ b), (ap b).comp (tr a b w) = ap a) ∧
      (∀ x : ↥c.pt, ∃ (a : Under j) (y : ↥(F.obj a.right)), ap a y = x) ∧
      (∀ (a : Under j) (y : ↥(F.obj a.right)), ap a y = 0 →
        ∃ (b : Under j) (w : a ⟶ b), tr a b w y = 0) ∧
      ∀ (a : Under j) (x : ↥(F.obj a.right)), ap a x = (c.ι.app a.right).hom x := by
  let _ : Algebra ↥(F.obj j) ↥c.pt := (c.ι.app j).hom.toAlgebra
  let _ : ∀ a : Under j, Algebra ↥(F.obj j) ↥(F.obj a.right) :=
    fun a => (F.map a.hom).hom.toAlgebra
  refine ⟨fun a b w =>
    { __ := (F.map w.right).hom
      commutes' := fun r => by
        change (F.map w.right).hom ((F.map a.hom).hom r) = (F.map b.hom).hom r
        rw [hom_comp_apply, ← F.map_comp, Under.w w] },
    fun a =>
    { __ := (c.ι.app a.right).hom
      commutes' := fun r => by
        change (c.ι.app a.right).hom ((F.map a.hom).hom r) = (c.ι.app j).hom r
        rw [hom_comp_apply, c.w] },
    ?_, ?_, ?_, ?_, fun _ _ => rfl⟩
  · intro a b d w w'
    ext r
    change (F.map (w ≫ w').right).hom r = (F.map w'.right).hom ((F.map w.right).hom r)
    rw [hom_comp_apply, ← F.map_comp]
    rfl
  · intro a b w
    ext r
    change (c.ι.app b.right).hom ((F.map w.right).hom r) = (c.ι.app a.right).hom r
    rw [hom_comp_apply, c.w]
  · exact exists_under_ι_app_eq hc j
  · intro a y hy
    exact exists_under_map_eq_zero hc j a y hy

include hc in
/-- Item (1) of Stacks 05N9: a finitely presented algebra over a filtered colimit of rings is
the base change of a finitely presented algebra over a stage. -/
private theorem part_one (A : CommRingCat.{u}) (f : c.pt ⟶ A) (hf : f.hom.FinitePresentation) :
    ∃ (j : J) (A' : CommRingCat.{u}) (f' : F.obj j ⟶ A') (a : A' ⟶ A),
      f'.hom.FinitePresentation ∧ IsPushout f' (c.ι.app j) a f := by
  classical
  let _ := f.hom.toAlgebra
  obtain ⟨n, π, hπ, hker⟩ := hf
  obtain ⟨s, hs⟩ := hker
  obtain ⟨k, q, hq⟩ := exists_mvPolynomial_family_map_eq hc n
    (fun x : (s : Set (MvPolynomial (Fin n) c.pt)) ↦ (x : MvPolynomial (Fin n) c.pt))
  let _ : Algebra ↥(F.obj k) ↥c.pt := (c.ι.app k).hom.toAlgebra
  have hmap : (Ideal.span (Set.range q)).map (MvPolynomial.map (c.ι.app k).hom)
      = RingHom.ker (π : MvPolynomial (Fin n) ↥c.pt →+* ↥A) := by
    have hrange : (MvPolynomial.map (c.ι.app k).hom) '' Set.range q
        = (↑s : Set (MvPolynomial (Fin n) ↥c.pt)) := by
      rw [← Set.range_comp, show (MvPolynomial.map (c.ι.app k).hom) ∘ q
        = (Subtype.val : ↥(↑s : Set (MvPolynomial (Fin n) ↥c.pt)) → _) from funext hq,
        Subtype.range_coe]
    rw [Ideal.map_span, hrange]
    simpa using hs
  have hIle : ∀ z ∈ Ideal.span (Set.range q), ((π : MvPolynomial (Fin n) ↥c.pt →+* ↥A).comp
      (MvPolynomial.map (c.ι.app k).hom)) z = 0 := by
    intro z hz
    have h := Ideal.mem_map_of_mem (MvPolynomial.map (c.ι.app k).hom) hz
    rw [hmap, RingHom.mem_ker] at h
    simpa using h
  have hIfg : (Ideal.span (Set.range q)).FG := ⟨Finset.image q Finset.univ, by simp⟩
  set aMap : CommRingCat.of (MvPolynomial (Fin n) ↥(F.obj k) ⧸ Ideal.span (Set.range q)) ⟶ A :=
    CommRingCat.ofHom (Ideal.Quotient.lift (Ideal.span (Set.range q))
      ((π : MvPolynomial (Fin n) ↥c.pt →+* ↥A).comp (MvPolynomial.map (c.ι.app k).hom)) hIle)
    with haMap
  have hsq1 : IsPushout
      (CommRingCat.ofHom (algebraMap ↥(F.obj k) (MvPolynomial (Fin n) ↥(F.obj k))))
      (c.ι.app k) (CommRingCat.ofHom (MvPolynomial.map (c.ι.app k).hom))
      (CommRingCat.ofHom (algebraMap ↥c.pt (MvPolynomial (Fin n) ↥c.pt))) :=
    (CommRingCat.isPushout_of_isPushout ↥(F.obj k) ↥c.pt (MvPolynomial (Fin n) ↥(F.obj k))
      (MvPolynomial (Fin n) ↥c.pt)).flip
  have hsq2 : IsPushout
      (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span (Set.range q))))
      (CommRingCat.ofHom (MvPolynomial.map (c.ι.app k).hom)) aMap
      (CommRingCat.ofHom (π : MvPolynomial (Fin n) ↥c.pt →+* ↥A)) := by
    refine isPushout_of_surjective _ _ _ _ ?_ Ideal.Quotient.mk_surjective hπ ?_
    · ext x
      · simp [haMap, Ideal.Quotient.lift_mk]
      · simp [haMap, Ideal.Quotient.lift_mk]
    · simpa using hmap.symm
  have e1 : CommRingCat.ofHom (algebraMap ↥(F.obj k) (MvPolynomial (Fin n) ↥(F.obj k))) ≫
      CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span (Set.range q)))
      = CommRingCat.ofHom (algebraMap ↥(F.obj k)
        (MvPolynomial (Fin n) ↥(F.obj k) ⧸ Ideal.span (Set.range q))) := by
    ext x
    simp [Ideal.Quotient.alg_map_eq]
  have e2 : CommRingCat.ofHom (algebraMap ↥c.pt (MvPolynomial (Fin n) ↥c.pt)) ≫
      CommRingCat.ofHom (π : MvPolynomial (Fin n) ↥c.pt →+* ↥A) = f := by
    ext x
    exact DFunLike.congr_fun π.comp_algebraMap x
  refine ⟨k, CommRingCat.of (MvPolynomial (Fin n) ↥(F.obj k) ⧸ Ideal.span (Set.range q)),
    CommRingCat.ofHom (algebraMap ↥(F.obj k) _), aMap, ?_, ?_⟩
  · simpa using RingHom.finitePresentation_algebraMap.mpr
      (Algebra.FinitePresentation.quotient hIfg)
  · rw [← e1, ← e2]
    exact hsq1.paste_horiz hsq2

include hc in
/-- Item (2) of Stacks 05N9. -/
private theorem part_two :
    ∀ (j : J) (A' B' B : CommRingCat.{u}) (f' : F.obj j ⟶ A') (g' : F.obj j ⟶ B')
        (g : c.pt ⟶ B) (b : B' ⟶ B), f'.hom.FinitePresentation →
        IsPushout g' (c.ι.app j) b g →
        ∀ ρ : A' ⟶ B, f' ≫ ρ = c.ι.app j ≫ g →
          ∃ (k : J) (h : j ⟶ k) (Bₖ : CommRingCat.{u}) (gₖ : F.obj k ⟶ Bₖ) (bₖ : B' ⟶ Bₖ)
              (t : Bₖ ⟶ B) (σ : A' ⟶ Bₖ), IsPushout g' (F.map h) bₖ gₖ ∧ bₖ ≫ t = b ∧
            gₖ ≫ t = c.ι.app k ≫ g ∧ f' ≫ σ = F.map h ≫ gₖ ∧ ρ = σ ≫ t := by
  intro j A' B' B f' g' g b hf hB ρ hρ
  let _ : Algebra ↥(F.obj j) ↥B' := g'.hom.toAlgebra
  let _ : Algebra ↥(F.obj j) ↥c.pt := (c.ι.app j).hom.toAlgebra
  let _ : Algebra ↥(F.obj j) ↥A' := f'.hom.toAlgebra
  let instP : ∀ a : Under j, Algebra ↥(F.obj j) ↥(F.obj a.right) :=
    fun a => (F.map a.hom).hom.toAlgebra
  obtain ⟨tr, ap, htr, hap, hsurj, hz, hapι⟩ := exists_under_system hc j
  -- the base change of `B'` to the colimit, as a concrete tensor product
  set bT : B' ⟶ CommRingCat.of (↥c.pt ⊗[↥(F.obj j)] ↥B') :=
    CommRingCat.ofHom (Algebra.TensorProduct.includeRight
      (R := ↥(F.obj j)) (A := ↥c.pt) (B := ↥B')).toRingHom with hbT
  set gT : c.pt ⟶ CommRingCat.of (↥c.pt ⊗[↥(F.obj j)] ↥B') :=
    CommRingCat.ofHom (Algebra.TensorProduct.includeLeftRingHom
      (R := ↥(F.obj j)) (A := ↥c.pt) (B := ↥B')) with hgT
  have hT : IsPushout g' (c.ι.app j) bT gT :=
    (CommRingCat.isPushout_tensorProduct ↥(F.obj j) ↥c.pt ↥B').flip
  set d₂ : B ⟶ CommRingCat.of (↥c.pt ⊗[↥(F.obj j)] ↥B') := hB.desc bT gT hT.w with hd₂
  have hbd₂ : b ≫ d₂ = bT := hB.inl_desc _ _ _
  have hgd₂ : g ≫ d₂ = gT := hB.inr_desc _ _ _
  set d₁ : CommRingCat.of (↥c.pt ⊗[↥(F.obj j)] ↥B') ⟶ B := hT.desc b g hB.w with hd₁
  have hbd₁ : bT ≫ d₁ = b := hT.inl_desc _ _ _
  have hgd₁ : gT ≫ d₁ = g := hT.inr_desc _ _ _
  have hd : d₂ ≫ d₁ = 𝟙 B := hB.hom_ext
    (by rw [Category.comp_id, ← Category.assoc, hbd₂, hbd₁])
    (by rw [Category.comp_id, ← Category.assoc, hgd₂, hgd₁])
  -- transport `ρ` into the concrete model and descend it to a stage
  have hρT : f' ≫ ρ ≫ d₂ = c.ι.app j ≫ gT := by
    rw [← Category.assoc, hρ, Category.assoc, hgd₂]
  obtain ⟨a, σA, hσA⟩ := exists_algHom_map_comp_eq (R := ↥(F.obj j)) (Bp := ↥B') (W := ↥c.pt)
    (K := Under j) (P := fun a : Under j => ↥(F.obj a.right)) tr ap htr hap hsurj hz hf
    { __ := (ρ ≫ d₂).hom
      commutes' := fun r => DFunLike.congr_fun (congrArg CommRingCat.Hom.hom hρT) r }
  set bk : B' ⟶ CommRingCat.of (↥(F.obj a.right) ⊗[↥(F.obj j)] ↥B') :=
    CommRingCat.ofHom (Algebra.TensorProduct.includeRight
      (R := ↥(F.obj j)) (A := ↥(F.obj a.right)) (B := ↥B')).toRingHom with hbk
  set gk : F.obj a.right ⟶ CommRingCat.of (↥(F.obj a.right) ⊗[↥(F.obj j)] ↥B') :=
    CommRingCat.ofHom (Algebra.TensorProduct.includeLeftRingHom
      (R := ↥(F.obj j)) (A := ↥(F.obj a.right)) (B := ↥B')) with hgk
  set tT : CommRingCat.of (↥(F.obj a.right) ⊗[↥(F.obj j)] ↥B') ⟶
      CommRingCat.of (↥c.pt ⊗[↥(F.obj j)] ↥B') :=
    CommRingCat.ofHom (Algebra.TensorProduct.map (ap a) (AlgHom.id ↥(F.obj j) ↥B')).toRingHom
    with htT
  have hbkT : bk ≫ tT = bT := by
    rw [hbk, htT, hbT]
    ext x
    simp
  have hgkT : gk ≫ tT = c.ι.app a.right ≫ gT := by
    rw [hgk, htT, hgT]
    ext x
    simp [hapι]
  refine ⟨a.right, a.hom, _, gk, bk, tT ≫ d₁, CommRingCat.ofHom σA.toRingHom, ?_, ?_, ?_, ?_, ?_⟩
  · exact (CommRingCat.isPushout_tensorProduct ↥(F.obj j) ↥(F.obj a.right) ↥B').flip
  · rw [← Category.assoc, hbkT, hbd₁]
  · rw [← Category.assoc, hgkT, Category.assoc, hgd₁]
  · ext r
    exact σA.commutes r
  · rw [← Category.assoc]
    have : CommRingCat.ofHom σA.toRingHom ≫ tT = ρ ≫ d₂ := by
      rw [htT]
      ext x
      exact DFunLike.congr_fun hσA x
    rw [this, Category.assoc, hd, Category.comp_id]

include hc in
/-- Item (3) of Stacks 05N9. -/
private theorem part_three :
    ∀ (j : J) (A' B' B : CommRingCat.{u}) (f' : F.obj j ⟶ A') (g' : F.obj j ⟶ B')
        (g : c.pt ⟶ B) (b : B' ⟶ B), f'.hom.FiniteType → IsPushout g' (c.ι.app j) b g →
        ∀ φ ψ : A' ⟶ B', f' ≫ φ = g' → f' ≫ ψ = g' → φ ≫ b = ψ ≫ b →
          ∃ (k : J) (h : j ⟶ k) (Bₖ : CommRingCat.{u}) (gₖ : F.obj k ⟶ Bₖ) (bₖ : B' ⟶ Bₖ),
            IsPushout g' (F.map h) bₖ gₖ ∧ φ ≫ bₖ = ψ ≫ bₖ := by
  intro j A' B' B f' g' g b hf hB φ ψ hφ hψ hcomm
  let _ : Algebra ↥(F.obj j) ↥B' := g'.hom.toAlgebra
  let _ : Algebra ↥(F.obj j) ↥c.pt := (c.ι.app j).hom.toAlgebra
  let _ : Algebra ↥(F.obj j) ↥A' := f'.hom.toAlgebra
  let instP : ∀ a : Under j, Algebra ↥(F.obj j) ↥(F.obj a.right) :=
    fun a => (F.map a.hom).hom.toAlgebra
  obtain ⟨tr, ap, htr, hap, hsurj, hz, -⟩ := exists_under_system hc j
  -- the base change of `B'` to the colimit, as a concrete tensor product
  set bT : B' ⟶ CommRingCat.of (↥c.pt ⊗[↥(F.obj j)] ↥B') :=
    CommRingCat.ofHom (Algebra.TensorProduct.includeRight
      (R := ↥(F.obj j)) (A := ↥c.pt) (B := ↥B')).toRingHom with hbT
  set gT : c.pt ⟶ CommRingCat.of (↥c.pt ⊗[↥(F.obj j)] ↥B') :=
    CommRingCat.ofHom (Algebra.TensorProduct.includeLeftRingHom
      (R := ↥(F.obj j)) (A := ↥c.pt) (B := ↥B')) with hgT
  have hT : IsPushout g' (c.ι.app j) bT gT :=
    (CommRingCat.isPushout_tensorProduct ↥(F.obj j) ↥c.pt ↥B').flip
  set d₂ : B ⟶ CommRingCat.of (↥c.pt ⊗[↥(F.obj j)] ↥B') := hB.desc bT gT hT.w with hd₂
  have hbd₂ : b ≫ d₂ = bT := hB.inl_desc _ _ _
  have hgd₂ : g ≫ d₂ = gT := hB.inr_desc _ _ _
  -- transport the equality into the concrete model and descend it to a stage
  have hbb : φ ≫ bT = ψ ≫ bT := by
    rw [← hbd₂, ← Category.assoc, hcomm, Category.assoc]
  obtain ⟨a, ha⟩ := exists_one_tmul_eq (R := ↥(F.obj j)) (Bp := ↥B') (W := ↥c.pt)
    (K := Under j) (P := fun a : Under j => ↥(F.obj a.right)) tr ap htr hap hsurj hz hf
    { __ := φ.hom
      commutes' := fun r => DFunLike.congr_fun (congrArg CommRingCat.Hom.hom hφ) r }
    { __ := ψ.hom
      commutes' := fun r => DFunLike.congr_fun (congrArg CommRingCat.Hom.hom hψ) r }
    (fun x => DFunLike.congr_fun (congrArg CommRingCat.Hom.hom hbb) x)
  refine ⟨a.right, a.hom, _,
    CommRingCat.ofHom (Algebra.TensorProduct.includeLeftRingHom
      (R := ↥(F.obj j)) (A := ↥(F.obj a.right)) (B := ↥B')),
    CommRingCat.ofHom (Algebra.TensorProduct.includeRight
      (R := ↥(F.obj j)) (A := ↥(F.obj a.right)) (B := ↥B')).toRingHom, ?_, ?_⟩
  · exact (CommRingCat.isPushout_tensorProduct ↥(F.obj j) ↥(F.obj a.right) ↥B').flip
  · ext x
    exact ha x

end Stages

/-- The three items of Stacks 05N9 for a filtered colimit `c` of rings, as one conjunction. -/
public theorem solution
    {J : Type v} [Category.{w} J] [IsFiltered J] {F : J ⥤ CommRingCat.{u}} {c : Cocone F}
    (hc : IsColimit c) [PreservesColimit F (forget CommRingCat.{u})] :
    (∀ (A : CommRingCat.{u}) (f : c.pt ⟶ A), f.hom.FinitePresentation →
        ∃ (j : J) (A' : CommRingCat.{u}) (f' : F.obj j ⟶ A') (a : A' ⟶ A),
          f'.hom.FinitePresentation ∧ IsPushout f' (c.ι.app j) a f) ∧
    (∀ (j : J) (A' B' B : CommRingCat.{u}) (f' : F.obj j ⟶ A') (g' : F.obj j ⟶ B')
        (g : c.pt ⟶ B) (b : B' ⟶ B), f'.hom.FinitePresentation →
        IsPushout g' (c.ι.app j) b g →
        ∀ ρ : A' ⟶ B, f' ≫ ρ = c.ι.app j ≫ g →
          ∃ (k : J) (h : j ⟶ k) (Bₖ : CommRingCat.{u}) (gₖ : F.obj k ⟶ Bₖ) (bₖ : B' ⟶ Bₖ)
              (t : Bₖ ⟶ B) (σ : A' ⟶ Bₖ), IsPushout g' (F.map h) bₖ gₖ ∧ bₖ ≫ t = b ∧
            gₖ ≫ t = c.ι.app k ≫ g ∧ f' ≫ σ = F.map h ≫ gₖ ∧ ρ = σ ≫ t) ∧
    (∀ (j : J) (A' B' B : CommRingCat.{u}) (f' : F.obj j ⟶ A') (g' : F.obj j ⟶ B')
        (g : c.pt ⟶ B) (b : B' ⟶ B), f'.hom.FiniteType → IsPushout g' (c.ι.app j) b g →
        ∀ φ ψ : A' ⟶ B', f' ≫ φ = g' → f' ≫ ψ = g' → φ ≫ b = ψ ≫ b →
          ∃ (k : J) (h : j ⟶ k) (Bₖ : CommRingCat.{u}) (gₖ : F.obj k ⟶ Bₖ) (bₖ : B' ⟶ Bₖ),
            IsPushout g' (F.map h) bₖ gₖ ∧ φ ≫ bₖ = ψ ≫ bₖ) :=
  ⟨part_one hc, part_two hc, part_three hc⟩

end Stacks.ColimitPresentation.FiniteStage

/-!
# Finitely presented algebras over a filtered colimit of rings come from a finite stage

Let `R = colim_λ R_λ` be a filtered colimit of commutative rings. Then the category of finitely
presented `R`-algebras is the colimit of the categories of finitely presented `R_λ`-algebras.
Concretely:

1. every finitely presented `R`-algebra `A` is the base change `A_λ ⊗_{R_λ} R` of a finitely
   presented `R_λ`-algebra `A_λ`, for some `λ`;
2. every `R`-algebra map `A_λ ⊗_{R_λ} R → B_λ ⊗_{R_λ} R` with `A_λ` of finite presentation over
   `R_λ` is the base change of an `R_μ`-algebra map `A_λ ⊗_{R_λ} R_μ → B_λ ⊗_{R_λ} R_μ` for some
   `μ ≥ λ`;
3. two `R_λ`-algebra maps `A_λ → B_λ` with `A_λ` of finite type over `R_λ` whose base changes to
   `R` agree already have equal base changes to `R_μ`, for some `μ ≥ λ`.

Item 1 is a matter of clearing denominators: a presentation
`A = R[x_1, …, x_n]/(f_1, …, f_m)` has all of its finitely many coefficients defined over one
`R_λ`, and `A_λ = R_λ[x_1, …, x_n]/(f_{λ,1}, …, f_{λ,m})` then base changes to `A`. Items 2 and 3
say that a finitely presented `R_λ`-algebra is a finitely presentable object: maps out of it into
the filtered colimit `B_λ ⊗_{R_λ} R = colim_{μ ≥ λ} B_λ ⊗_{R_λ} R_μ` come from a finite stage
(item 2), and become equal at a finite stage as soon as they are equal in the colimit (item 3,
where finitely many algebra generators of `A_λ` have to be caught at one stage).

## Main results

* `CommRingCat.exists_isPushout_and_exists_eq_comp_and_exists_comp_eq_of_isColimit`: items 1, 2
  and 3 above, as the three conjuncts of one statement about one filtered colimit of rings.

## Implementation notes

The source's directed system `(R_λ)_{λ ∈ Λ}` is a functor `F : J ⥤ CommRingCat` on a filtered
category together with a colimit cocone `c`, so `R` is `c.pt` and `R_λ → R` is `c.ι.app λ`; a
directed set is the special case of a directed preorder, which is filtered. The instance
argument `PreservesColimit F (forget CommRingCat)` says that the colimit is computed on
underlying sets, which is the only property of the system the mathematics uses; it is automatic
when `J` is small, and it is the hypothesis carried by the neighbouring Mathlib lemmas
`RingHom.EssFiniteType.exists_eq_comp_ι_app_of_isColimit` and `.exists_comp_map_eq_of_isColimit`
(tag `00QO`), which are items 2 and 3 for an arbitrary filtered diagram of `R_λ`-algebras in
place of the diagram of base changes.

An algebra is a ring map rather than an object of `Under`: `A_λ` is a ring `A'` together with
`f' : F.obj j ⟶ A'`, and being of finite presentation over `R_λ` is `f'.hom.FinitePresentation`.
No base change is *constructed*: `A ≅ A_λ ⊗_{R_λ} R` is `IsPushout f' (c.ι.app j) a f`, the
assertion that the square of ring maps is a pushout, which holds for every model of the tensor
product and pins the comparison map `A_λ ⊗_{R_λ} R → A` (it is the map induced by `a` and `f`)
rather than asserting a bare isomorphism.

Items 2 and 3 are stated in transposed form, which is both Mathlib's spelling of them and one
degree more general than the source's. Since `A_λ ⊗_{R_λ} R` is the pushout, giving an
`R`-algebra map `A_λ ⊗_{R_λ} R → B` is the same as giving an `R_λ`-algebra map `A_λ → B`
(`IsPushout.desc` and `IsPushout.hom_ext`), so item 2 quantifies over `R_λ`-algebra maps
`ρ : A' ⟶ B` into the base change `B` of `B_λ`, and `φ = φ_μ ⊗ 1_R` becomes `ρ = σ ≫ t`, where
`σ : A' ⟶ Bₖ` is the transpose of `φ_μ` and `t : Bₖ ⟶ B` is the canonical map from the stage `μ`,
pinned by `bₖ ≫ t = b` and `gₖ ≫ t = c.ι.app k ≫ g`. In item 3, two `R`-algebra maps out of the
pushout `A_λ ⊗_{R_λ} R` agree if and only if their restrictions along `A_λ → A_λ ⊗_{R_λ} R` do,
and the restriction of `φ ⊗ 1_R` is `φ ≫ b`; so `φ ⊗ 1_R = ψ ⊗ 1_R` is `φ ≫ b = ψ ≫ b`, and no
base change of `A_λ` is named. Two generalizations come for free this way: `B_λ` is an arbitrary
`R_λ`-algebra in items 2 and 3, the source's finite presentation of `B_λ` being unused, and
`A_λ` need only be of finite type in item 3, only finitely many algebra generators being moved.

Faithfulness. (1) No hypothesis is idle: `hc` is used by each item (for the one-object diagram
`F = ℤ` and the non-colimit cocone `ℤ → ℤ/2`, item 3 would say that `x ↦ 0` and `x ↦ 2` on
`ℤ[x]` are equal, which is false), `IsFiltered J` by items 2 and 3, and each item assumes exactly
the finiteness its argument consumes. (2) The scalars and the base are the source's: `A'`, `B'`
are algebras over `F.obj j = R_λ`, `A` and `B` over `c.pt = R`, `ρ` and `σ` are `R_λ`-algebra
maps (`f' ≫ ρ = c.ι.app j ≫ g`, `f' ≫ σ = F.map h ≫ gₖ`, the latter being `R_μ`-linearity of
`φ_μ` after transposition), and `φ, ψ` are `R_λ`-algebra maps. (3) The canonical maps are
pinned, not merely asserted to exist: base change is a pushout square rather than an
isomorphism, and the comparison `t` from the stage `μ` is determined by its two restrictions.
(4) The instantiation is not degenerate: for `J = ℕ`, `R_n = ℤ[1/n!]` and `R = ℚ`, item 1 says
that a finitely presented `ℚ`-algebra such as `ℚ[x]/(x² - 1/7)` is defined over some `ℤ[1/n!]`,
and items 2 and 3 have content because `ℚ` is not any single `R_n`.

## References

* [StacksProject 05N9](https://stacks.math.columbia.edu/tag/05N9)

## Tags

directed colimit, filtered colimit, finite presentation, base change, pushout
-/

open CategoryTheory Limits


namespace CommRingCat

/-- **Stacks 05N9.** Let `R = colim_λ R_λ` be a filtered colimit of rings, given by a filtered
diagram `F` with colimit cocone `c`.

1. Every finitely presented `R`-algebra `A` is the base change of a finitely presented
   `R_λ`-algebra `A'`, in the sense that the square `R_λ → A'`, `R_λ → R`, `A' → A`, `R → A` is
   a pushout.
2. If `A'` is of finite presentation over `R_λ` and `B` is the base change to `R` of an
   `R_λ`-algebra `B'`, then every `R_λ`-algebra map `ρ : A' → B` factors as `ρ = σ ≫ t` through
   the base change `Bₖ` of `B'` to some `R_μ` with `μ ≥ λ`, by an `R_λ`-algebra map `σ` and the
   canonical map `t : Bₖ → B`. Transposed along the pushout of item 1, this says that every
   `R`-algebra map `A' ⊗_{R_λ} R → B' ⊗_{R_λ} R` is the base change of an `R_μ`-algebra map
   `A' ⊗_{R_λ} R_μ → B' ⊗_{R_λ} R_μ`.
3. If `A'` is of finite type over `R_λ` and `φ, ψ : A' → B'` are `R_λ`-algebra maps whose base
   changes to `R` agree, then their base changes to `R_μ` agree for some `μ ≥ λ`. -/
@[stacks 05N9 "The colimit is a colimit cocone in `CommRingCat` over a filtered category, an
algebra is a ring map, and `A ≅ A_λ ⊗_{R_λ} R` is `IsPushout`, so no tensor product is
constructed. Items (2) and (3) are transposed along that pushout, which is Mathlib's spelling
and drops the source's finite presentation of `B_λ`; item (3) needs `A_λ` of finite type only.
See the module docstring."]
public theorem exists_isPushout_and_exists_eq_comp_and_exists_comp_eq_of_isColimit
    {J : Type v} [Category.{w} J] [IsFiltered J] {F : J ⥤ CommRingCat.{u}} {c : Cocone F}
    (hc : IsColimit c) [PreservesColimit F (forget CommRingCat.{u})] :
    (∀ (A : CommRingCat.{u}) (f : c.pt ⟶ A), f.hom.FinitePresentation →
        ∃ (j : J) (A' : CommRingCat.{u}) (f' : F.obj j ⟶ A') (a : A' ⟶ A),
          f'.hom.FinitePresentation ∧ IsPushout f' (c.ι.app j) a f) ∧
    (∀ (j : J) (A' B' B : CommRingCat.{u}) (f' : F.obj j ⟶ A') (g' : F.obj j ⟶ B')
        (g : c.pt ⟶ B) (b : B' ⟶ B), f'.hom.FinitePresentation →
        IsPushout g' (c.ι.app j) b g →
        ∀ ρ : A' ⟶ B, f' ≫ ρ = c.ι.app j ≫ g →
          ∃ (k : J) (h : j ⟶ k) (Bₖ : CommRingCat.{u}) (gₖ : F.obj k ⟶ Bₖ) (bₖ : B' ⟶ Bₖ)
              (t : Bₖ ⟶ B) (σ : A' ⟶ Bₖ), IsPushout g' (F.map h) bₖ gₖ ∧ bₖ ≫ t = b ∧
            gₖ ≫ t = c.ι.app k ≫ g ∧ f' ≫ σ = F.map h ≫ gₖ ∧ ρ = σ ≫ t) ∧
    (∀ (j : J) (A' B' B : CommRingCat.{u}) (f' : F.obj j ⟶ A') (g' : F.obj j ⟶ B')
        (g : c.pt ⟶ B) (b : B' ⟶ B), f'.hom.FiniteType → IsPushout g' (c.ι.app j) b g →
        ∀ φ ψ : A' ⟶ B', f' ≫ φ = g' → f' ≫ ψ = g' → φ ≫ b = ψ ≫ b →
          ∃ (k : J) (h : j ⟶ k) (Bₖ : CommRingCat.{u}) (gₖ : F.obj k ⟶ Bₖ) (bₖ : B' ⟶ Bₖ),
            IsPushout g' (F.map h) bₖ gₖ ∧ φ ≫ bₖ = ψ ≫ bₖ) :=
  Stacks.ColimitPresentation.FiniteStage.solution hc

end CommRingCat
