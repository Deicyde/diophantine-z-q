import Mathlib

/-!
# Unramified local algebras over a discrete valuation ring

An essentially finite-type, formally unramified, flat local algebra over a
DVR is again a DVR. A uniformizer of the base remains a uniformizer.

Noetherianity is obtained from essential finite type. The maximal-ideal
formula and Krull intersection give a unit-times-power factorization of each
nonzero element. Flatness makes the mapped uniformizer regular, so those
factorizations prove that the algebra is a domain before the DVR criterion
is applied.
-/

namespace ZInQ.Contrib.CloudR2Raynaud.StrictHenselization.Port

/-- Krull intersection gives a unit-times-power factorization when the
maximal ideal of a Noetherian local ring is generated by one element. -/
private theorem unit_factor_of_principal_maximalIdeal
    {S : Type*} [CommRing S] [IsLocalRing S] [IsNoetherianRing S]
    (t : S) (hmax : IsLocalRing.maximalIdeal S = Ideal.span {t})
    {x : S} (hx : x ≠ 0) :
    ∃ (n : ℕ) (u : S), IsUnit u ∧ x = t ^ n * u := by
  classical
  have hex : ∃ n : ℕ, x ∉ IsLocalRing.maximalIdeal S ^ n := by
    by_contra! hall
    apply hx
    have hmem : x ∈ (⨅ n : ℕ, IsLocalRing.maximalIdeal S ^ n) :=
      (Submodule.mem_iInf _).mpr hall
    rw [Ideal.iInf_pow_eq_bot_of_isLocalRing (IsLocalRing.maximalIdeal S)
      (IsLocalRing.maximalIdeal.isMaximal S).ne_top, Ideal.mem_bot] at hmem
    exact hmem
  cases hk : Nat.find hex with
  | zero =>
      have hnot : x ∉ IsLocalRing.maximalIdeal S ^ (0 : ℕ) := by
        simpa only [hk] using Nat.find_spec hex
      exact (hnot (by simp)).elim
  | succ n =>
      have hprev : x ∈ IsLocalRing.maximalIdeal S ^ n := by
        by_contra hprev
        exact Nat.find_min hex
          (by simpa only [hk] using Nat.lt_succ_self n) hprev
      have hnext : x ∉ IsLocalRing.maximalIdeal S ^ (n + 1) := by
        simpa only [hk] using Nat.find_spec hex
      rw [hmax, Ideal.span_singleton_pow, Ideal.mem_span_singleton] at hprev
      obtain ⟨u, hxu⟩ := hprev
      have hu : IsUnit u := by
        by_contra hnu
        have humem : u ∈ IsLocalRing.maximalIdeal S := by
          change ¬ IsUnit u
          exact hnu
        rw [hmax, Ideal.mem_span_singleton] at humem
        obtain ⟨v, huv⟩ := humem
        apply hnext
        rw [hmax, Ideal.span_singleton_pow, Ideal.mem_span_singleton]
        refine ⟨v, ?_⟩
        rw [hxu, huv, pow_succ, mul_assoc]
      exact ⟨n, u, hu, hxu⟩

/-- A regular generator of the maximal ideal forces a Noetherian local
ring to be a domain. Regularity is proved before any domain instance is used. -/
private theorem domain_of_regular_maximalIdeal_generator
    {S : Type*} [CommRing S] [IsLocalRing S] [IsNoetherianRing S]
    (t : S) (hmax : IsLocalRing.maximalIdeal S = Ideal.span {t})
    (ht : IsSMulRegular S t) : IsDomain S := by
  classical
  haveI : NoZeroDivisors S :=
    { eq_zero_or_eq_zero_of_mul_eq_zero := fun {x y} hxy => by
        by_cases hx : x = 0
        · exact Or.inl hx
        · obtain ⟨n, u, hu, hxu⟩ := unit_factor_of_principal_maximalIdeal t hmax hx
          have hxreg : IsSMulRegular S x := by
            rw [hxu]
            exact (IsSMulRegular.pow n ht).mul (IsUnit.isSMulRegular S hu)
          exact Or.inr (hxreg (by simpa only [smul_eq_mul, mul_zero] using hxy)) }
  exact NoZeroDivisors.to_isDomain S

/-- A formally unramified, essentially finite-type, flat local algebra over
a DVR is a domain and a DVR, with the image of any base uniformizer generating
its maximal ideal. -/
theorem IsDiscreteValuationRing.of_formallyUnramified
    {A : Type*} {S : Type*} [CommRing A] [IsDomain A] [IsDiscreteValuationRing A]
    [CommRing S] [IsLocalRing S] [Algebra A S] [IsLocalHom (algebraMap A S)]
    [Algebra.FormallyUnramified A S] [Algebra.EssFiniteType A S] [Module.Flat A S]
    {ϖ : A} (hϖ : Irreducible ϖ) :
    ∃ (_ : IsDomain S), IsDiscreteValuationRing S ∧ Irreducible (algebraMap A S ϖ) ∧
      IsLocalRing.maximalIdeal S = Ideal.span {algebraMap A S ϖ} := by
  haveI : IsNoetherianRing A := inferInstance
  haveI : IsNoetherianRing S := Algebra.EssFiniteType.isNoetherianRing A S
  have hmax : IsLocalRing.maximalIdeal S = Ideal.span {algebraMap A S ϖ} := by
    rw [← Algebra.FormallyUnramified.map_maximalIdeal (R := A) (S := S),
      hϖ.maximalIdeal_eq, Ideal.map_span, Set.image_singleton]
  have hregA : IsSMulRegular A ϖ := by
    intro x y hxy
    apply mul_left_cancel₀ hϖ.ne_zero
    simpa only [smul_eq_mul] using hxy
  have hreg : IsSMulRegular S (algebraMap A S ϖ) :=
    IsSMulRegular.of_flat (S := S) hregA
  letI hdom : IsDomain S :=
    domain_of_regular_maximalIdeal_generator (algebraMap A S ϖ) hmax hreg
  have hne : algebraMap A S ϖ ≠ 0 := by
    intro hzero
    have h01 : (0 : S) = 1 := hreg (by simp [hzero])
    exact zero_ne_one h01
  have hmne : IsLocalRing.maximalIdeal S ≠ ⊥ := by
    rw [hmax, Ne, Ideal.span_singleton_eq_bot]
    exact hne
  have hnf : ¬ IsField S := IsLocalRing.isField_iff_maximalIdeal_eq.not.mpr hmne
  haveI hdvr : IsDiscreteValuationRing S :=
    ((_root_.IsDiscreteValuationRing.TFAE S hnf).out 5 1).mp (by
      rw [hmax]
      infer_instance)
  have hirr : Irreducible (algebraMap A S ϖ) :=
    (_root_.IsDiscreteValuationRing.irreducible_iff_uniformizer _).mpr hmax
  exact ⟨hdom, hdvr, hirr, hmax⟩

end ZInQ.Contrib.CloudR2Raynaud.StrictHenselization.Port
