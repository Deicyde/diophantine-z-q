set_option linter.style.longLine false
set_option linter.style.haveILetI false

namespace PadicAlgCl

open Polynomial IntermediateField

noncomputable section

variable (p : ℕ) [Fact p.Prime]

/-- `ℚ_p(μ_{p^n})`: the subfield of `ℚ̄_p` generated by the `p^n`-th roots of unity. -/
def cyclotomicTower (n : ℕ) : IntermediateField ℚ_[p] (PadicAlgCl p) :=
  IntermediateField.adjoin ℚ_[p] {ζ : PadicAlgCl p | ζ ^ p ^ n = 1}

theorem mem_cyclotomicTower_of_pow_eq_one {n : ℕ} {ζ : PadicAlgCl p} (h : ζ ^ p ^ n = 1) :
    ζ ∈ cyclotomicTower p n :=
  IntermediateField.subset_adjoin ℚ_[p] _ h

theorem cyclotomicTower_mono : Monotone (cyclotomicTower p) := by
  intro m n hmn
  refine IntermediateField.adjoin.mono ℚ_[p] _ _ fun ζ (hζ : ζ ^ p ^ m = 1) => ?_
  show ζ ^ p ^ n = 1
  obtain ⟨k, rfl⟩ := Nat.exists_eq_add_of_le hmn
  rw [pow_add, pow_mul, hζ, one_pow]

/-- `ℚ̄_p` contains a primitive `p^n`-th root of unity: it is algebraically closed of
characteristic `0`. -/
theorem exists_isPrimitiveRoot_pow (n : ℕ) : ∃ ζ : PadicAlgCl p, IsPrimitiveRoot ζ (p ^ n) :=
  HasEnoughRootsOfUnity.exists_isPrimitiveRoot (PadicAlgCl p) (p ^ n)

/-- The tower is generated by one primitive root. -/
theorem cyclotomicTower_eq_adjoin (n : ℕ) {ζ : PadicAlgCl p} (hζ : IsPrimitiveRoot ζ (p ^ n)) :
    cyclotomicTower p n = IntermediateField.adjoin ℚ_[p] {ζ} := by
  haveI : NeZero (p ^ n) := ⟨pow_ne_zero n (Fact.out : p.Prime).ne_zero⟩
  apply le_antisymm
  · rw [cyclotomicTower, IntermediateField.adjoin_le_iff]
    intro ξ (hξ : ξ ^ p ^ n = 1)
    obtain ⟨i, -, rfl⟩ := hζ.eq_pow_of_pow_eq_one hξ
    exact pow_mem (IntermediateField.mem_adjoin_simple_self ℚ_[p] ζ) i
  · exact IntermediateField.adjoin.mono ℚ_[p] _ _ (Set.singleton_subset_iff.mpr hζ.pow_eq_one)

/-- **Fixing `ℚ_p(μ_{p^n})` is fixing one primitive `p^n`-th root of unity.** -/
theorem mem_fixingSubgroup_cyclotomicTower_iff (n : ℕ) {ζ : PadicAlgCl p}
    (hζ : IsPrimitiveRoot ζ (p ^ n)) (σ : PadicAlgCl p ≃ₐ[ℚ_[p]] PadicAlgCl p) :
    σ ∈ (cyclotomicTower p n).fixingSubgroup ↔ σ ζ = ζ := by
  rw [IntermediateField.mem_fixingSubgroup_iff]
  constructor
  · intro h
    exact h ζ (mem_cyclotomicTower_of_pow_eq_one p hζ.pow_eq_one)
  · intro h x hx
    rw [cyclotomicTower_eq_adjoin p n hζ] at hx
    have hle : IntermediateField.adjoin ℚ_[p] {ζ} ≤
        IntermediateField.fixedField (Subgroup.zpowers σ) := by
      rw [IntermediateField.adjoin_le_iff, Set.singleton_subset_iff, SetLike.mem_coe,
        IntermediateField.mem_fixedField_iff]
      intro f hf
      obtain ⟨z, rfl⟩ := Subgroup.mem_zpowers_iff.mp hf
      have hnat : ∀ k : ℕ, (σ ^ k) ζ = ζ := by
        intro k
        induction k with
        | zero => simp
        | succ k ih => rw [pow_succ, AlgEquiv.mul_apply, h, ih]
      rcases Int.eq_nat_or_neg z with ⟨k, rfl | rfl⟩
      · rw [zpow_natCast]; exact hnat k
      · rw [zpow_neg, zpow_natCast]
        have h1 := hnat k
        calc (σ ^ k)⁻¹ ζ = (σ ^ k)⁻¹ ((σ ^ k) ζ) := by rw [h1]
          _ = ζ := by rw [← AlgEquiv.mul_apply, inv_mul_cancel, AlgEquiv.one_apply]
    have hx' := hle hx
    rw [IntermediateField.mem_fixedField_iff] at hx'
    exact hx' σ (Subgroup.mem_zpowers σ)

/-- If `σ ζ = ζ ^ a` then `σ^j ζ = ζ ^ (a ^ j)`. -/
theorem pow_apply_eq_pow_pow (σ : PadicAlgCl p ≃ₐ[ℚ_[p]] PadicAlgCl p) {ζ : PadicAlgCl p} {a : ℕ}
    (h : σ ζ = ζ ^ a) (j : ℕ) : (σ ^ j) ζ = ζ ^ a ^ j := by
  induction j with
  | zero => simp
  | succ j ih => rw [pow_succ, AlgEquiv.mul_apply, h, map_pow, ih, ← pow_mul, ← pow_succ]

/-- **The congruence reading of `σ ∈ Gal(ℚ̄_p/ℚ_p(μ_{p^n}))`**: with `σ ζ = ζ ^ b` for a
primitive `p^N`-th root `ζ` and `n ≤ N`, it says `b ≡ 1 (mod p^n)`. -/
theorem mem_fixingSubgroup_cyclotomicTower_iff_dvd {N n : ℕ} (hn : n ≤ N) {ζ : PadicAlgCl p}
    (hζ : IsPrimitiveRoot ζ (p ^ N)) (τ : PadicAlgCl p ≃ₐ[ℚ_[p]] PadicAlgCl p) {b : ℕ}
    (hb : 1 ≤ b) (hτ : τ ζ = ζ ^ b) :
    τ ∈ (cyclotomicTower p n).fixingSubgroup ↔ p ^ n ∣ b - 1 := by
  have hpos : 0 < p ^ N := pow_pos (Fact.out : p.Prime).pos N
  have hζn : IsPrimitiveRoot (ζ ^ p ^ (N - n)) (p ^ n) :=
    hζ.pow hpos (by rw [← pow_add, Nat.sub_add_cancel hn])
  rw [mem_fixingSubgroup_cyclotomicTower_iff p n hζn, map_pow, hτ, ← pow_mul, mul_comm, pow_mul]
  have hη0 : (ζ ^ p ^ (N - n)) ≠ 0 := hζn.ne_zero (pow_ne_zero n (Fact.out : p.Prime).ne_zero)
  have hsplit : (ζ ^ p ^ (N - n)) ^ b = (ζ ^ p ^ (N - n)) ^ (b - 1) * (ζ ^ p ^ (N - n)) := by
    rw [← pow_succ, Nat.sub_add_cancel hb]
  rw [hsplit]
  constructor
  · intro h
    have h2 : (ζ ^ p ^ (N - n)) ^ (b - 1) * (ζ ^ p ^ (N - n)) = 1 * (ζ ^ p ^ (N - n)) := by
      rw [one_mul]; exact h
    exact (hζn.pow_eq_one_iff_dvd _).mp (mul_right_cancel₀ hη0 h2)
  · intro h
    rw [(hζn.pow_eq_one_iff_dvd _).mpr h, one_mul]

/-- **The tower is stable under every `σ ∈ Gal(ℚ̄_p/ℚ_p)`**: `σ` permutes the `p^n`-th roots of
unity. (The `hstab` hypothesis of the normalised-trace construction.) -/
theorem map_mem_cyclotomicTower (n : ℕ) (σ : PadicAlgCl p ≃ₐ[ℚ_[p]] PadicAlgCl p)
    {y : PadicAlgCl p} (hy : y ∈ cyclotomicTower p n) : σ y ∈ cyclotomicTower p n := by
  have hle : cyclotomicTower p n ≤ (cyclotomicTower p n).comap σ.toAlgHom := by
    rw [cyclotomicTower, IntermediateField.adjoin_le_iff]
    intro ξ (hξ : ξ ^ p ^ n = 1)
    show σ ξ ∈ cyclotomicTower p n
    exact mem_cyclotomicTower_of_pow_eq_one p (by rw [← map_pow, hξ, map_one])
  exact hle hy

/-- The tower is a finite extension of `ℚ_p`. (The `hfin` hypothesis of the normalised-trace
construction.) -/
instance finiteDimensional_cyclotomicTower (n : ℕ) :
    FiniteDimensional ℚ_[p] ↥(cyclotomicTower p n) := by
  obtain ⟨ζ, hζ⟩ := exists_isPrimitiveRoot_pow p n
  rw [cyclotomicTower_eq_adjoin p n hζ]
  exact IntermediateField.adjoin.finiteDimensional (Algebra.IsIntegral.isIntegral (R := ℚ_[p]) ζ)

end

end PadicAlgCl
