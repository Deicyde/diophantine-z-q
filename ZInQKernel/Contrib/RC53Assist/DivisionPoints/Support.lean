/-!
# Division points over the field unramified outside the support

Let `K` be a number field, `E/K` an elliptic curve given by a Weierstrass equation `W`, and `S₀`
a set of finite places of `K` containing the places dividing `m` and such that `E` has good
reduction at every place outside `S₀`. For `P ∈ E(K)`, every point `Q ∈ E(K̄)` with `m Q = P` has
coordinates in `K_{S₀}`, the maximal extension of `K` unramified outside `S₀`. Compare
Silverman, *The Arithmetic of Elliptic Curves*, Proposition VIII.1.5(b); the argument below is
the one given there. The manuscript uses this where it takes the Kummer class of a rational
point in the cohomology of `G_{K,S}` (lines 2865–2868, 3080–3084 and 3293–3295).

Let `L = K([m]⁻¹P)` be the field generated by the coordinates of all `m`-division points of
`P`. It is a finite Galois extension of `K`. Let `𝔔` be a prime of `L` above `v ∉ S₀` and `σ`
an element of its inertia group. Then `σ` preserves the `𝔔`-adic valuation ring and acts
trivially on its residue field, so it does not change the reduction of a point of `E(L)`. For a
division point `Q`, the point `σ Q - Q` is killed by `m` and reduces to the origin. At good
reduction, reduction is injective on torsion of order prime to the residue characteristic
(Silverman VII.3.1(b)), so `σ Q = Q`. Thus inertia fixes the generators of `L`, the inertia
group is trivial, and since its order is the ramification index, `𝔔` is unramified over `v`.

The local reduction step is the vendored theorem
`WeierstrassCurve.Affine.Point.map_eq_self_of_mem_inertiaSubgroup`, stated for inertia groups
of valuation rings. Its comparison with the ideal-theoretic inertia group, whose order is the
ramification index by `Ideal.card_inertia_eq_ramificationIdx`, is proved here
(`exists_mem_inertiaSubgroup`). The only hypotheses are on the curve and the support: the
places dividing `m` (for the boundary, the places above `2`) lie in `S₀`, and `W` has good
reduction outside `S₀` (`HasGoodReductionAt`). No printed arithmetic statement is assumed.

## Main results

* `HasGoodReductionAt W v`: some Weierstrass model of `W` over `K` has `v`-integral
  coefficients and `v`-unit discriminant.
* `isUnramifiedOutside_divisionField`: `K([m]⁻¹P)` is unramified outside `S₀`.
* `divisionField_le_unramifiedOutside`: hence it lies in `K_{S₀}`; so does the compositum
  `K([m]⁻¹ W(K))` (`iSup_divisionField_le_unramifiedOutside`).
* `exists_supportPoint_map_eq`: every `m`-division point of `P` over `K̄` is defined over
  `K_{S₀}`.
* `exists_nsmul_eq_supportBasePoint` and `globalDivisionPointsInSupport_of_goodReduction`: the
  input `GlobalDivisionPointsInSupport` of the retained finite boundary, at every precision.
* `fullTorsion_of_goodReduction`: `E(K_{S₀})[N]` has `N²` points, the input `FullTorsion` (the
  direction of the criterion of Néron, Ogg and Shafarevich from good reduction to unramified
  torsion, Silverman VII.7.1).
* `goodReductionKummerMap` and `centralRetainedStage_exists_witness_of_goodReduction`: the
  global Kummer map and the retained boundary with both inputs supplied.
* `globalDivisionPointsInSupport_of_baseChange`: both inputs for the base change of an
  integral Weierstrass equation (over `ℤ` or `𝓞 K`), when `S₀` contains the places above `2`
  and the places dividing its discriminant.
* `globalDivisionPointsInSupport_curveEll` and its integral form
  `globalDivisionPointsInSupport_curveEll_of_integer`: both inputs for
  `E_ℓ : y² = x(x − ℓ)(x + 3ℓ)`, when `S₀` contains the places above `2` and `3` and `ℓ` is a unit
  outside `S₀` (for integral `ℓ`: when `S₀` contains the places dividing `6ℓ`).
-/

set_option autoImplicit false

noncomputable section

namespace ZInQ.Manuscript.RC.DivisionPoints

open NumberField IsDedekindDomain WeierstrassCurve
open ZInQ.Contrib.CloudB3RC53.RankCounts (unramifiedOutside IsUnramifiedOutside)
open ZInQ.Manuscript.RC.CoefModules (KS FullTorsion TorsS)
open ZInQ.Manuscript.RC.BaseZeroAssembly.Boundary45Stage
open scoped Pointwise

/-! ### Ideal-theoretic inertia and the inertia group of the valuation ring -/

section Bridge

variable {A L K : Type*} [CommRing A] [IsDedekindDomain A] [Field L] [Algebra A L]
  [IsFractionRing A L] [Field K] [Algebra K L] (u : HeightOneSpectrum A)

/-- An automorphism that is congruent to the identity modulo `u` on `A` maps the `u`-adic
valuation ring into itself and moves each of its elements by an element of the maximal
ideal. -/
theorem valuation_apply_le_one_and_sub_lt_one (ρ : L ≃ₐ[K] L)
    (hρ : ∀ a : A, ∃ b : A, algebraMap A L b = ρ (algebraMap A L a) ∧ b - a ∈ u.asIdeal)
    {z : L} (hz : u.valuation L z ≤ 1) :
    u.valuation L (ρ z) ≤ 1 ∧ u.valuation L (ρ z - z) < 1 := by
  obtain ⟨n, ⟨d, hd⟩, hnd⟩ := u.exists_primeCompl_mul_eq_of_integer z hz
  have hdu : d ∉ u.asIdeal := hd
  obtain ⟨n', hn', hnn⟩ := hρ n
  obtain ⟨d', hd', hdd⟩ := hρ d
  have hd'u : d' ∉ u.asIdeal := fun h => hdu (by simpa using u.asIdeal.sub_mem h hdd)
  have hvd : u.valuation L (algebraMap A L d) = 1 := (u.valuation_eq_one_iff_notMem).2 hdu
  have hvd' : u.valuation L (algebraMap A L d') = 1 := (u.valuation_eq_one_iff_notMem).2 hd'u
  have hnd' : z * algebraMap A L d = algebraMap A L n := hnd
  have hρz : ρ z * algebraMap A L d' = algebraMap A L n' := by
    rw [hd', hn', ← map_mul, hnd']
  constructor
  · have h := congrArg (u.valuation L) hρz
    rw [map_mul, hvd', mul_one] at h
    rw [h]
    exact u.valuation_le_one n'
  · have key : (ρ z - z) * (algebraMap A L d' * algebraMap A L d) =
        algebraMap A L ((n' - n) * d - n * (d' - d)) := by
      rw [map_sub, map_mul, map_mul, map_sub, map_sub, ← hρz, ← hnd']
      ring
    have hmem : (n' - n) * d - n * (d' - d) ∈ u.asIdeal :=
      u.asIdeal.sub_mem (u.asIdeal.mul_mem_right _ hnn) (u.asIdeal.mul_mem_left _ hdd)
    have h := congrArg (u.valuation L) key
    rw [map_mul, map_mul, hvd', hvd, mul_one, mul_one] at h
    rw [h]
    exact (u.valuation_lt_one_iff_mem _).2 hmem

/-- **Ideal-theoretic inertia lies in the inertia group of the valuation ring.** If `σ` and
`σ⁻¹` are congruent to the identity modulo `u` on `A`, then `σ` lies in the decomposition group
of the `u`-adic valuation ring of `L` and acts trivially on its residue field. -/
theorem exists_mem_inertiaSubgroup (σ : L ≃ₐ[K] L)
    (hσ : ∀ a : A, ∃ b : A, algebraMap A L b = σ (algebraMap A L a) ∧ b - a ∈ u.asIdeal)
    (hσ' : ∀ a : A, ∃ b : A, algebraMap A L b = σ⁻¹ (algebraMap A L a) ∧ b - a ∈ u.asIdeal) :
    ∃ τ ∈ (u.valuation L).valuationSubring.inertiaSubgroup K, (τ : L ≃ₐ[K] L) = σ := by
  have hstab : σ ∈ (u.valuation L).valuationSubring.decompositionSubgroup K := by
    rw [MulAction.mem_stabilizer_iff]
    ext z
    rw [ValuationSubring.mem_pointwise_smul_iff_inv_smul_mem, AlgEquiv.smul_def,
      Valuation.mem_valuationSubring_iff, Valuation.mem_valuationSubring_iff]
    constructor
    · intro h
      have h2 := (valuation_apply_le_one_and_sub_lt_one u σ hσ h).1
      rwa [← AlgEquiv.mul_apply, mul_inv_cancel, AlgEquiv.one_apply] at h2
    · intro h
      exact (valuation_apply_le_one_and_sub_lt_one u σ⁻¹ hσ' h).1
  refine ⟨⟨σ, hstab⟩, ?_, rfl⟩
  rw [ValuationSubring.mem_inertiaSubgroup_iff]
  intro x
  rw [← sub_eq_zero, ← map_sub, IsLocalRing.residue_eq_zero_iff, Valuation.mem_maximalIdeal_iff]
  have hx : u.valuation L x ≤ 1 := ((u.valuation L).mem_valuationSubring_iff _).1 x.2
  have := (valuation_apply_le_one_and_sub_lt_one u σ hσ hx).2
  simpa [ValuationSubring.coe_decompositionSubgroup_smul] using this

end Bridge

/-! ### Valuations along an extension of Dedekind domains -/

section Transfer

variable {R B K L : Type*} [CommRing R] [IsDedekindDomain R] [CommRing B] [IsDedekindDomain B]
  [Field K] [Field L] [Algebra R K] [IsFractionRing R K] [Algebra B L] [IsFractionRing B L]
  [Algebra R B] [Algebra K L] [Algebra R L] [IsScalarTower R K L] [IsScalarTower R B L]
  (v : HeightOneSpectrum R) (u : HeightOneSpectrum B)
  (huv : ∀ a : R, algebraMap R B a ∈ u.asIdeal ↔ a ∈ v.asIdeal)

include huv in
/-- A `v`-integral element is integral at every prime `u` above `v`. -/
theorem valuation_algebraMap_le_one {z : K} (hz : v.valuation K z ≤ 1) :
    u.valuation L (algebraMap K L z) ≤ 1 := by
  obtain ⟨n, ⟨d, hd⟩, hnd⟩ := v.exists_primeCompl_mul_eq_of_integer z hz
  have hdv : d ∉ v.asIdeal := hd
  have hdu : algebraMap R B d ∉ u.asIdeal := fun h => hdv ((huv d).1 h)
  have hvd : u.valuation L (algebraMap B L (algebraMap R B d)) = 1 :=
    (u.valuation_eq_one_iff_notMem).2 hdu
  have hnd' : algebraMap K L z * algebraMap B L (algebraMap R B d) =
      algebraMap B L (algebraMap R B n) := by
    rw [← IsScalarTower.algebraMap_apply, ← IsScalarTower.algebraMap_apply,
      IsScalarTower.algebraMap_apply R K L, IsScalarTower.algebraMap_apply R K L, ← map_mul, hnd]
  have h := congrArg (u.valuation L) hnd'
  rw [map_mul, hvd, mul_one] at h
  rw [h]
  exact u.valuation_le_one _

include huv in
/-- A `v`-adic unit is a unit at every prime `u` above `v`. -/
theorem valuation_algebraMap_eq_one {z : K} (hz : v.valuation K z = 1) :
    u.valuation L (algebraMap K L z) = 1 := by
  have hz0 : z ≠ 0 := by
    rintro rfl
    simp at hz
  have h1 := valuation_algebraMap_le_one (L := L) v u huv hz.le
  have h2 := valuation_algebraMap_le_one (L := L) v u huv (z := z⁻¹)
    (by rw [map_inv₀, hz, inv_one])
  rw [map_inv₀, map_inv₀] at h2
  have hne : u.valuation L (algebraMap K L z) ≠ 0 := by
    rw [Valuation.ne_zero_iff]
    exact (map_ne_zero _).2 hz0
  refine le_antisymm h1 ?_
  calc (1 : _) = u.valuation L (algebraMap K L z) * (u.valuation L (algebraMap K L z))⁻¹ :=
        (mul_inv_cancel₀ hne).symm
    _ ≤ u.valuation L (algebraMap K L z) * 1 := by gcongr
    _ = u.valuation L (algebraMap K L z) := mul_one _

end Transfer

/-! ### Inertia fixes division points at good reduction -/

section LocalInertia

variable {A K L : Type*} [CommRing A] [IsDedekindDomain A] [Field K] [Field L] [Algebra K L]
  [Algebra A L] [IsFractionRing A L] [DecidableEq L] (u : HeightOneSpectrum A)

/-- If the coefficients of `W` are `u`-integral and its discriminant is a `u`-adic unit, an
element of the inertia group of the `u`-adic valuation ring fixes every point `P` such that it
fixes `n • P`, for `n ∉ u`. -/
theorem map_eq_self_of_valuation (W : WeierstrassCurve K)
    (h₁ : u.valuation L (algebraMap K L W.a₁) ≤ 1) (h₂ : u.valuation L (algebraMap K L W.a₂) ≤ 1)
    (h₃ : u.valuation L (algebraMap K L W.a₃) ≤ 1) (h₄ : u.valuation L (algebraMap K L W.a₄) ≤ 1)
    (h₆ : u.valuation L (algebraMap K L W.a₆) ≤ 1) (hΔ : u.valuation L (algebraMap K L W.Δ) = 1)
    {n : ℕ} (hn : (n : A) ∉ u.asIdeal)
    {σ : (u.valuation L).valuationSubring.decompositionSubgroup K}
    (hσ : σ ∈ (u.valuation L).valuationSubring.inertiaSubgroup K) {P : (W⁄L).toAffine.Point}
    (hP : Affine.Point.map (σ : L ≃ₐ[K] L).toAlgHom (n • P) = n • P) :
    Affine.Point.map (σ : L ≃ₐ[K] L).toAlgHom P = P := by
  have lift : ∀ z : K, u.valuation L (algebraMap K L z) ≤ 1 →
      ∃ r : (u.valuation L).valuationSubring,
        algebraMap (u.valuation L).valuationSubring L r = algebraMap K L z :=
    fun z hz => ⟨⟨algebraMap K L z, ((u.valuation L).mem_valuationSubring_iff _).2 hz⟩, rfl⟩
  have : IsIntegral (u.valuation L).valuationSubring (W⁄L) :=
    isIntegral_of_exists_lift _ (lift _ h₁) (lift _ h₂) (lift _ h₃) (lift _ h₄) (lift _ h₆)
  have : (integralModel (u.valuation L).valuationSubring (W⁄L)).IsElliptic := by
    rw [isElliptic_iff,
      (Valuation.valuationSubring.integers (u.valuation L)).isUnit_iff_valuation_eq_one,
      integralModel_Δ_eq]
    show u.valuation L (W.map (algebraMap K L)).Δ = 1
    rw [map_Δ]
    exact hΔ
  exact Affine.Point.map_eq_self_of_mem_inertiaSubgroup u hn hσ hP

/-- The same after a change of variables over `K`: it suffices that some model `C • W` has
`u`-integral coefficients and `u`-unit discriminant. -/
theorem map_eq_self_of_variableChange (W : WeierstrassCurve K) (C : VariableChange K)
    (h₁ : u.valuation L (algebraMap K L (C • W).a₁) ≤ 1)
    (h₂ : u.valuation L (algebraMap K L (C • W).a₂) ≤ 1)
    (h₃ : u.valuation L (algebraMap K L (C • W).a₃) ≤ 1)
    (h₄ : u.valuation L (algebraMap K L (C • W).a₄) ≤ 1)
    (h₆ : u.valuation L (algebraMap K L (C • W).a₆) ≤ 1)
    (hΔ : u.valuation L (algebraMap K L (C • W).Δ) = 1)
    {n : ℕ} (hn : (n : A) ∉ u.asIdeal)
    {σ : (u.valuation L).valuationSubring.decompositionSubgroup K}
    (hσ : σ ∈ (u.valuation L).valuationSubring.inertiaSubgroup K) {P : (W⁄L).toAffine.Point}
    (hP : Affine.Point.map (σ : L ≃ₐ[K] L).toAlgHom (n • P) = n • P) :
    Affine.Point.map (σ : L ≃ₐ[K] L).toAlgHom P = P := by
  set e := W.pointEquivVariableChange L C
  have h1 : Affine.Point.map (σ : L ≃ₐ[K] L).toAlgHom (n • e.symm P) = n • e.symm P := by
    rw [← map_nsmul e.symm, map_pointEquivVariableChange_symm, hP]
  have h2 := map_eq_self_of_valuation u (C • W) h₁ h₂ h₃ h₄ h₆ hΔ hn hσ h1
  rw [map_pointEquivVariableChange_symm] at h2
  exact e.symm.injective h2

end LocalInertia

/-! ### Good reduction -/

section GoodReduction

variable {K : Type} [Field K] [NumberField K]

/-- **Good reduction at a finite place** `v`: after a change of variables over `K`, the
Weierstrass coefficients are `v`-integral and the discriminant is a `v`-adic unit. Such an
equation is minimal at `v` and has nonsingular reduction. -/
def HasGoodReductionAt (W : WeierstrassCurve K) (v : HeightOneSpectrum (𝓞 K)) : Prop :=
  ∃ C : VariableChange K,
    v.valuation K (C • W).a₁ ≤ 1 ∧ v.valuation K (C • W).a₂ ≤ 1 ∧
      v.valuation K (C • W).a₃ ≤ 1 ∧ v.valuation K (C • W).a₄ ≤ 1 ∧
        v.valuation K (C • W).a₆ ≤ 1 ∧ v.valuation K (C • W).Δ = 1

/-- The base change of an integral Weierstrass equation has good reduction at every place not
dividing its discriminant. Here the equation is over any ring `R` mapping to `𝓞 K`, such as `ℤ`
or `𝓞 K` itself. -/
theorem hasGoodReductionAt_baseChange {R : Type*} [CommRing R] [Algebra R (𝓞 K)] [Algebra R K]
    [IsScalarTower R (𝓞 K) K] (W₀ : WeierstrassCurve R) (v : HeightOneSpectrum (𝓞 K))
    (hv : algebraMap R (𝓞 K) W₀.Δ ∉ v.asIdeal) :
    HasGoodReductionAt (W₀.baseChange K) v := by
  have hle : ∀ r : R, v.valuation K (algebraMap R K r) ≤ 1 := fun r => by
    rw [IsScalarTower.algebraMap_apply R (𝓞 K) K]
    exact v.valuation_le_one _
  refine ⟨1, ?_, ?_, ?_, ?_, ?_, ?_⟩ <;> rw [one_smul]
  · exact hle W₀.a₁
  · exact hle W₀.a₂
  · exact hle W₀.a₃
  · exact hle W₀.a₄
  · exact hle W₀.a₆
  · show v.valuation K (W₀.map (algebraMap R K)).Δ = 1
    rw [map_Δ, IsScalarTower.algebraMap_apply R (𝓞 K) K]
    exact (v.valuation_eq_one_iff_notMem).2 hv

end GoodReduction

/-! ### The field generated by the division points of a rational point -/

section DivisionField

open scoped Classical

variable {K : Type} [Field K] [NumberField K] [DecidableEq K] (W : WeierstrassCurve K)

omit [NumberField K] in
/-- A point coming from `W(K)` is carried to the corresponding point by every `K`-embedding. -/
theorem map_map_ofId {E F : Type} [Field E] [Field F] [Algebra K E] [Algebra K F]
    [DecidableEq E] [DecidableEq F] (f : E →ₐ[K] F) (X : (W.baseChange K).toAffine.Point) :
    Affine.Point.map (W' := W) f (Affine.Point.map (W' := W) (Algebra.ofId K E) X) =
      Affine.Point.map (W' := W) (Algebra.ofId K F) X := by
  rw [Affine.Point.map_map]
  exact congrArg (fun g : K →ₐ[K] F => Affine.Point.map (W' := W) g X) (Subsingleton.elim _ _)

/-- The image of a point of `W(K)` in the points over the algebraic closure. -/
def closurePoint (P : W.toAffine.Point) : (W.baseChange (AlgebraicClosure K)).toAffine.Point :=
  Affine.Point.map (W' := W) (Algebra.ofId K (AlgebraicClosure K))
    (Affine.Point.equivBaseChangeSelf W.toAffine P)

omit [NumberField K] in
/-- It is fixed by every automorphism of the algebraic closure over `K`. -/
theorem map_closurePoint (σ : AlgebraicClosure K →ₐ[K] AlgebraicClosure K)
    (P : W.toAffine.Point) :
    Affine.Point.map (W' := W) σ (closurePoint W P) = closurePoint W P :=
  map_map_ofId W σ _

/-- The `m`-division points of `P` over the algebraic closure. -/
def divisionPoints (m : ℕ) (P : W.toAffine.Point) :
    Set (W.baseChange (AlgebraicClosure K)).toAffine.Point :=
  {Q | m • Q = closurePoint W P}

/-- The coordinates of the `m`-division points of `P`. -/
def divisionCoords (m : ℕ) (P : W.toAffine.Point) : Set (AlgebraicClosure K) :=
  Affine.Point.xCoord '' divisionPoints W m P ∪ Affine.Point.yCoord '' divisionPoints W m P

/-- **The field `K([m]⁻¹P)`** generated over `K` by the coordinates of the `m`-division points
of `P`. -/
def divisionField (m : ℕ) (P : W.toAffine.Point) : IntermediateField K (AlgebraicClosure K) :=
  IntermediateField.adjoin K (divisionCoords W m P)

variable [W.IsElliptic]

/-- Division points exist over the algebraic closure. -/
theorem exists_mem_divisionPoints {m : ℕ} (hm : m ≠ 0) (P : W.toAffine.Point) :
    ∃ Q, Q ∈ divisionPoints W m P := by
  have hm' : (m : AlgebraicClosure K) ≠ 0 := Nat.cast_ne_zero.2 hm
  obtain ⟨Q, hQ⟩ :=
    (W.baseChange (AlgebraicClosure K)).toAffine.nsmul_surjective hm' (closurePoint W P)
  exact ⟨Q, hQ⟩

/-- There are finitely many of them: they form a coset of the `m`-torsion. -/
theorem finite_divisionPoints {m : ℕ} (hm : m ≠ 0) (P : W.toAffine.Point) :
    (divisionPoints W m P).Finite := by
  obtain ⟨Q₀, hQ₀⟩ := exists_mem_divisionPoints W hm P
  have hQ₀' : m • Q₀ = closurePoint W P := hQ₀
  have : Finite (AddSubgroup.torsionBy
      (W.baseChange (AlgebraicClosure K)).toAffine.Point (m : ℤ)) :=
    (W.baseChange (AlgebraicClosure K)).finite_torsionBy (by exact_mod_cast hm)
  refine (Set.finite_range fun t : AddSubgroup.torsionBy
    (W.baseChange (AlgebraicClosure K)).toAffine.Point (m : ℤ) => Q₀ + (t : _)).subset ?_
  intro Q hQ
  have hQ' : m • Q = closurePoint W P := hQ
  refine ⟨⟨Q - Q₀, (Submodule.mem_torsionBy_iff (R := ℤ) _ _).2 ?_⟩, ?_⟩
  · rw [smul_sub, natCast_zsmul, natCast_zsmul, hQ', hQ₀', sub_self]
  · show Q₀ + (Q - Q₀) = Q
    abel

theorem finite_divisionCoords {m : ℕ} (hm : m ≠ 0) (P : W.toAffine.Point) :
    (divisionCoords W m P).Finite :=
  ((finite_divisionPoints W hm P).image _).union ((finite_divisionPoints W hm P).image _)

/-- `K([m]⁻¹P)` is finite over `K`. -/
theorem finiteDimensional_divisionField {m : ℕ} (hm : m ≠ 0) (P : W.toAffine.Point) :
    FiniteDimensional K (divisionField W m P) := by
  have := (finite_divisionCoords W hm P).to_subtype
  exact IntermediateField.finiteDimensional_adjoin fun x _ => Algebra.IsIntegral.isIntegral x

omit [NumberField K] [W.IsElliptic] in
/-- The division points of `P` are permuted by the automorphisms of `K̄` over `K`. -/
theorem map_mem_divisionPoints (σ : AlgebraicClosure K →ₐ[K] AlgebraicClosure K) {m : ℕ}
    {P : W.toAffine.Point} {Q : (W.baseChange (AlgebraicClosure K)).toAffine.Point}
    (hQ : Q ∈ divisionPoints W m P) :
    Affine.Point.map (W' := W) σ Q ∈ divisionPoints W m P := by
  have hQ' : m • Q = closurePoint W P := hQ
  show m • Affine.Point.map (W' := W) σ Q = closurePoint W P
  rw [← map_nsmul, hQ', map_closurePoint]

omit [NumberField K] [W.IsElliptic] in
/-- `K([m]⁻¹P)` is normal over `K`. -/
theorem normal_divisionField (m : ℕ) (P : W.toAffine.Point) :
    Normal K (divisionField W m P) := by
  rw [IntermediateField.normal_iff_forall_map_le']
  intro σ
  rw [divisionField, IntermediateField.adjoin_map, IntermediateField.adjoin_le_iff]
  rintro _ ⟨c, hc, rfl⟩
  apply IntermediateField.subset_adjoin
  have hσ := fun {Q} (hQ : Q ∈ divisionPoints W m P) =>
    map_mem_divisionPoints W (σ : AlgebraicClosure K →ₐ[K] AlgebraicClosure K) hQ
  rcases hc with ⟨Q, hQ, rfl⟩ | ⟨Q, hQ, rfl⟩
  · exact Or.inl ⟨_, hσ hQ, Affine.Point.xCoord_map _ _⟩
  · exact Or.inr ⟨_, hσ hQ, Affine.Point.yCoord_map _ _⟩

end DivisionField

/-! ### `K([m]⁻¹P)` is unramified outside the support -/

section Unramified

open scoped Classical

variable {K : Type} [Field K] [NumberField K] [DecidableEq K] (W : WeierstrassCurve K)
  [W.IsElliptic]

/-- **`K([m]⁻¹P)/K` is unramified outside `S₀`** when `S₀` contains the places dividing `m` and
`W` has good reduction outside `S₀` (compare Silverman VIII.1.5(b)). Every prime of the integral
closure of `𝓞 K` in `K([m]⁻¹P)` above a place outside `S₀` has ramification index one. -/
theorem isUnramifiedOutside_divisionField {m : ℕ} (hm : m ≠ 0)
    (S0 : Set (HeightOneSpectrum (𝓞 K)))
    (hmS : ∀ v : HeightOneSpectrum (𝓞 K), (m : 𝓞 K) ∈ v.asIdeal → v ∈ S0)
    (hgood : ∀ v : HeightOneSpectrum (𝓞 K), v ∉ S0 → HasGoodReductionAt W v)
    (P : W.toAffine.Point) : IsUnramifiedOutside K S0 (divisionField W m P) := by
  intro v hv Q hQ hQv
  have : FiniteDimensional K (divisionField W m P) := finiteDimensional_divisionField W hm P
  have : Normal K (divisionField W m P) := normal_divisionField W m P
  have : IsGalois K (divisionField W m P) := {}
  have : Module.Finite (𝓞 K) (integralClosure (𝓞 K) (divisionField W m P)) :=
    IsIntegralClosure.finite (𝓞 K) K (divisionField W m P) _
  have : IsDedekindDomain (integralClosure (𝓞 K) (divisionField W m P)) :=
    IsIntegralClosure.isDedekindDomain (𝓞 K) K (divisionField W m P) _
  have : IsFractionRing (integralClosure (𝓞 K) (divisionField W m P)) (divisionField W m P) :=
    IsIntegralClosure.isFractionRing_of_finite_extension (𝓞 K) K (divisionField W m P) _
  let := IsIntegralClosure.MulSemiringAction (𝓞 K) K (divisionField W m P)
    (integralClosure (𝓞 K) (divisionField W m P))
  have : IsGaloisGroup (divisionField W m P ≃ₐ[K] divisionField W m P) (𝓞 K)
      (integralClosure (𝓞 K) (divisionField W m P)) :=
    IsGaloisGroup.of_isFractionRing _ _ _ K (divisionField W m P)
  have hQne : Q ≠ ⊥ := Ideal.ne_bot_of_liesOver_of_ne_bot v.ne_bot Q
  let u : HeightOneSpectrum (integralClosure (𝓞 K) (divisionField W m P)) := ⟨Q, hQ, hQne⟩
  have huv : ∀ a : 𝓞 K, algebraMap (𝓞 K) _ a ∈ u.asIdeal ↔ a ∈ v.asIdeal := by
    intro a
    rw [Ideal.over_def Q v.asIdeal]
    rfl
  rw [← Ideal.card_inertia_eq_ramificationIdx (𝓞 K)
    (divisionField W m P ≃ₐ[K] divisionField W m P) Q]
  suffices hbot : Q.inertia (divisionField W m P ≃ₐ[K] divisionField W m P) = ⊥ by
    rw [hbot]
    exact Subgroup.card_bot
  rw [eq_bot_iff]
  intro σ hσ
  rw [Subgroup.mem_bot]
  have hcong : ∀ ρ ∈ Q.inertia (divisionField W m P ≃ₐ[K] divisionField W m P),
      ∀ a : integralClosure (𝓞 K) (divisionField W m P),
        ∃ b, algebraMap _ (divisionField W m P) b = ρ (algebraMap _ _ a) ∧ b - a ∈ u.asIdeal :=
    fun ρ hρ a => ⟨ρ • a, algebraMap_galRestrict_apply (𝓞 K) ρ a, Ideal.mem_inertia.1 hρ a⟩
  obtain ⟨τ, hτ, rfl⟩ :=
    exists_mem_inertiaSubgroup u σ (hcong σ hσ) (hcong σ⁻¹ (inv_mem hσ))
  obtain ⟨C, h₁, h₂, h₃, h₄, h₆, hΔ⟩ := hgood v hv
  have hmu : (m : integralClosure (𝓞 K) (divisionField W m P)) ∉ u.asIdeal := by
    rw [← map_natCast (algebraMap (𝓞 K) (integralClosure (𝓞 K) (divisionField W m P))), huv]
    exact fun h => hv (hmS v h)
  have hfix : ∀ R ∈ divisionPoints W m P,
      ∃ R' : (W.baseChange (divisionField W m P)).toAffine.Point,
        Affine.Point.map (W' := W) (divisionField W m P).val R' = R ∧
          Affine.Point.map (W' := W)
            (τ : divisionField W m P ≃ₐ[K] divisionField W m P).toAlgHom R' = R' := by
    intro R hR
    have hx : Affine.Point.xCoord R ∈ Set.range (divisionField W m P).val :=
      ⟨⟨_, IntermediateField.subset_adjoin K _ (Or.inl ⟨R, hR, rfl⟩)⟩, rfl⟩
    have hy : Affine.Point.yCoord R ∈ Set.range (divisionField W m P).val :=
      ⟨⟨_, IntermediateField.subset_adjoin K _ (Or.inr ⟨R, hR, rfl⟩)⟩, rfl⟩
    obtain ⟨R', hR'⟩ := (Affine.Point.exists_map_eq_iff R (divisionField W m P).val).2 ⟨hx, hy⟩
    refine ⟨R', hR', ?_⟩
    have hPL : m • R' = Affine.Point.map (W' := W) (Algebra.ofId K (divisionField W m P))
        (Affine.Point.equivBaseChangeSelf W.toAffine P) := by
      apply Affine.Point.map_injective (W' := W) (divisionField W m P).val
      rw [map_nsmul, hR', map_map_ofId]
      exact hR
    refine map_eq_self_of_variableChange u W C (valuation_algebraMap_le_one v u huv h₁)
      (valuation_algebraMap_le_one v u huv h₂) (valuation_algebraMap_le_one v u huv h₃)
      (valuation_algebraMap_le_one v u huv h₄) (valuation_algebraMap_le_one v u huv h₆)
      (valuation_algebraMap_eq_one v u huv hΔ) hmu hτ ?_
    rw [hPL, map_map_ofId]
  have htop : IntermediateField.adjoin K
      {c : divisionField W m P | (c : AlgebraicClosure K) ∈ divisionCoords W m P} = ⊤ := by
    apply IntermediateField.lift_injective (divisionField W m P)
    rw [IntermediateField.lift_adjoin, IntermediateField.lift_top]
    show _ = IntermediateField.adjoin K (divisionCoords W m P)
    congr 1
    ext c
    constructor
    · rintro ⟨c', hc', rfl⟩
      exact hc'
    · intro hc
      exact ⟨⟨c, IntermediateField.subset_adjoin K _ hc⟩, hc, rfl⟩
  apply TauCeti.IntermediateField.algEquiv_eq_one_of_adjoin_eq_top htop
  rintro c (⟨R, hR, hcR⟩ | ⟨R, hR, hcR⟩)
  · obtain ⟨R', hR', hfixR⟩ := hfix R hR
    have hc : c = Affine.Point.xCoord R' := by
      apply Subtype.ext
      rw [← hcR, ← hR', Affine.Point.xCoord_map]
      rfl
    rw [hc]
    exact ((Affine.Point.map_eq_self_iff _ R').1 hfixR).1
  · obtain ⟨R', hR', hfixR⟩ := hfix R hR
    have hc : c = Affine.Point.yCoord R' := by
      apply Subtype.ext
      rw [← hcR, ← hR', Affine.Point.yCoord_map]
      rfl
    rw [hc]
    exact ((Affine.Point.map_eq_self_iff _ R').1 hfixR).2

end Unramified

/-! ### Division points over the support field -/

section Support

open scoped Classical

variable {K : Type} [Field K] [NumberField K] [DecidableEq K] (W : WeierstrassCurve K)
  [W.IsElliptic] {S0 : Set (HeightOneSpectrum (𝓞 K))} {m : ℕ} (hm : m ≠ 0)
  (hmS : ∀ v : HeightOneSpectrum (𝓞 K), (m : 𝓞 K) ∈ v.asIdeal → v ∈ S0)
  (hgood : ∀ v : HeightOneSpectrum (𝓞 K), v ∉ S0 → HasGoodReductionAt W v)

include hm hmS hgood

/-- **`K([m]⁻¹P)` lies in `K_{S₀}`.** -/
theorem divisionField_le_unramifiedOutside (P : W.toAffine.Point) :
    divisionField W m P ≤ unramifiedOutside K S0 :=
  le_iSup₂_of_le (f := fun (L : IntermediateField K (AlgebraicClosure K))
      (_ : FiniteDimensional K L ∧ Normal K L ∧ IsUnramifiedOutside K S0 L) => L)
    (divisionField W m P) ⟨finiteDimensional_divisionField W hm P, normal_divisionField W m P,
      isUnramifiedOutside_divisionField W hm S0 hmS hgood P⟩ le_rfl

/-- **`K([m]⁻¹ W(K))` lies in `K_{S₀}`**: the compositum of the fields `K([m]⁻¹P)` over all
`P ∈ W(K)`, the field of Silverman VIII.1.5. -/
theorem iSup_divisionField_le_unramifiedOutside :
    ⨆ P : W.toAffine.Point, divisionField W m P ≤ unramifiedOutside K S0 :=
  iSup_le fun P => divisionField_le_unramifiedOutside W hm hmS hgood P

/-- **Every `m`-division point of `P` over `K̄` is defined over `K_{S₀}`.** -/
theorem exists_supportPoint_map_eq (P : W.toAffine.Point)
    (R : (W.baseChange (AlgebraicClosure K)).toAffine.Point) (hR : m • R = closurePoint W P) :
    ∃ Q : (W.baseChange (KS K S0)).toAffine.Point,
      Affine.Point.map (W' := W) (unramifiedOutside K S0).val Q = R := by
  have hle := divisionField_le_unramifiedOutside W hm hmS hgood P
  have hx : Affine.Point.xCoord R ∈ Set.range (unramifiedOutside K S0).val :=
    ⟨⟨_, hle (IntermediateField.subset_adjoin K _ (Or.inl ⟨R, hR, rfl⟩))⟩, rfl⟩
  have hy : Affine.Point.yCoord R ∈ Set.range (unramifiedOutside K S0).val :=
    ⟨⟨_, hle (IntermediateField.subset_adjoin K _ (Or.inr ⟨R, hR, rfl⟩))⟩, rfl⟩
  exact (Affine.Point.exists_map_eq_iff R (unramifiedOutside K S0).val).2 ⟨hx, hy⟩

/-- **Division points of every rational point exist in the support field.** For every
`P ∈ W(K)` there is `Q ∈ W(K_{S₀})` with `m Q = P`. -/
theorem exists_nsmul_eq_supportBasePoint (P : W.toAffine.Point) :
    ∃ Q : SupportPoints (S0 := S0) W, m • Q = supportBasePoint (S0 := S0) W P := by
  obtain ⟨R, hR⟩ := exists_mem_divisionPoints W hm P
  obtain ⟨Q, hQ⟩ := exists_supportPoint_map_eq W hm hmS hgood P R hR
  refine ⟨Q, ?_⟩
  have key : m • Q = Affine.Point.map (W' := W) (Algebra.ofId K (KS K S0))
      (Affine.Point.equivBaseChangeSelf W.toAffine P) := by
    apply Affine.Point.map_injective (W' := W) (unramifiedOutside K S0).val
    rw [map_nsmul, hQ, map_map_ofId]
    exact hR
  exact key

end Support

/-! ### The inputs of the retained finite boundary -/

section Inputs

open scoped Classical
open Matrix
open ZInQ.Manuscript.RC.BaseZeroAssembly (SplitNormStage)

variable {K : Type} [Field K] [NumberField K] [DecidableEq K] (W : WeierstrassCurve K)
  [W.IsElliptic] {S0 : Set (HeightOneSpectrum (𝓞 K))}

omit [NumberField K] [DecidableEq K] in
/-- A place containing `2 ^ i` contains `2`. -/
theorem natCast_mem_of_two_pow {v : HeightOneSpectrum (𝓞 K)} {i : ℕ}
    (hv : ((2 ^ i : ℕ) : 𝓞 K) ∈ v.asIdeal) : (2 : 𝓞 K) ∈ v.asIdeal := by
  rw [Nat.cast_pow, Nat.cast_ofNat] at hv
  exact v.isPrime.mem_of_pow_mem i hv

/-- **`GlobalDivisionPointsInSupport` for the actual support field.** If `S₀` contains the
places above `2` and `W` has good reduction outside `S₀`, every point of `W(K)` has a
`2^i`-division point in `W(K_{S₀})`, at every precision `i`. -/
theorem globalDivisionPointsInSupport_of_goodReduction
    (h2 : ∀ v : HeightOneSpectrum (𝓞 K), (2 : 𝓞 K) ∈ v.asIdeal → v ∈ S0)
    (hgood : ∀ v : HeightOneSpectrum (𝓞 K), v ∉ S0 → HasGoodReductionAt W v) (i : ℕ) :
    GlobalDivisionPointsInSupport (S0 := S0) W i := fun P =>
  exists_nsmul_eq_supportBasePoint W (m := 2 ^ i) (pow_ne_zero _ two_ne_zero)
    (fun v hv => h2 v (natCast_mem_of_two_pow hv)) hgood P

/-- **The full torsion is defined over the support field.** If `S₀` contains the places dividing
`N` and `W` has good reduction outside `S₀`, then `W(K_{S₀})[N]` has `N²` points. This is the
implication from good reduction to unramified torsion in the criterion of Néron, Ogg and
Shafarevich (Silverman VII.7.1), for the actual field `K_{S₀}`. -/
theorem fullTorsion_of_goodReduction {N : ℕ} (hN : N ≠ 0)
    (hNS : ∀ v : HeightOneSpectrum (𝓞 K), (N : 𝓞 K) ∈ v.asIdeal → v ∈ S0)
    (hgood : ∀ v : HeightOneSpectrum (𝓞 K), v ∉ S0 → HasGoodReductionAt W v) :
    FullTorsion K S0 W N := by
  let ι := (unramifiedOutside K S0).val
  have hmem : ∀ t : TorsS K S0 W N, Affine.Point.map (W' := W) ι t.1 ∈
      AddSubgroup.torsionBy (W.baseChange (AlgebraicClosure K)).toAffine.Point (N : ℤ) := by
    intro t
    refine (Submodule.mem_torsionBy_iff (R := ℤ) _ _).2 ?_
    rw [← map_zsmul, (Submodule.mem_torsionBy_iff (R := ℤ) _ _).1 t.2, map_zero]
  let f : TorsS K S0 W N →
      AddSubgroup.torsionBy (W.baseChange (AlgebraicClosure K)).toAffine.Point (N : ℤ) :=
    fun t => ⟨Affine.Point.map (W' := W) ι t.1, hmem t⟩
  have hf : Function.Bijective f := by
    constructor
    · intro t t' htt
      exact Subtype.ext (Affine.Point.map_injective (W' := W) ι (congrArg Subtype.val htt))
    · intro R
      have hR : N • (R : (W.baseChange (AlgebraicClosure K)).toAffine.Point) =
          closurePoint W 0 := by
        rw [closurePoint, map_zero, map_zero, ← natCast_zsmul]
        exact (Submodule.mem_torsionBy_iff (R := ℤ) _ _).1 R.2
      obtain ⟨Q, hQ⟩ := exists_supportPoint_map_eq W hN hNS hgood 0 R hR
      have hQt : Q ∈ AddSubgroup.torsionBy (W.baseChange (KS K S0)).toAffine.Point (N : ℤ) := by
        refine (Submodule.mem_torsionBy_iff (R := ℤ) _ _).2 ?_
        apply Affine.Point.map_injective (W' := W) ι
        rw [map_zsmul, hQ, map_zero]
        exact (Submodule.mem_torsionBy_iff (R := ℤ) _ _).1 R.2
      exact ⟨⟨Q, hQt⟩, Subtype.ext hQ⟩
  have hN' : ((N : ℤ) : AlgebraicClosure K) ≠ 0 := by
    rw [Int.cast_natCast]
    exact Nat.cast_ne_zero.2 hN
  unfold FullTorsion
  rw [Nat.card_congr (Equiv.ofBijective f hf),
    (W.baseChange (AlgebraicClosure K)).natCard_torsionBy hN', Int.natAbs_natCast]

/-- The full `2^i`-torsion input `FullTorsion K S₀ W (2^i)` of the central datum. -/
theorem fullTorsion_two_pow_of_goodReduction
    (h2 : ∀ v : HeightOneSpectrum (𝓞 K), (2 : 𝓞 K) ∈ v.asIdeal → v ∈ S0)
    (hgood : ∀ v : HeightOneSpectrum (𝓞 K), v ∉ S0 → HasGoodReductionAt W v) (i : ℕ) :
    FullTorsion K S0 W (2 ^ i) :=
  fullTorsion_of_goodReduction W (pow_ne_zero _ two_ne_zero)
    (fun v hv => h2 v (natCast_mem_of_two_pow hv)) hgood

/-- The division point supplied to the global Kummer cocycle is a genuine `2^i`-division point
of the given rational point. -/
theorem supportDivisionPoint_spec_of_goodReduction
    (h2 : ∀ v : HeightOneSpectrum (𝓞 K), (2 : 𝓞 K) ∈ v.asIdeal → v ∈ S0)
    (hgood : ∀ v : HeightOneSpectrum (𝓞 K), v ∉ S0 → HasGoodReductionAt W v) (i : ℕ)
    (P : W.toAffine.Point) :
    (2 ^ i : ℕ) • supportDivisionPoint W i
        (globalDivisionPointsInSupport_of_goodReduction W h2 hgood i) P =
      supportBasePoint (S0 := S0) W P :=
  supportDivisionPoint_spec W i _ P

/-- **Both inputs for the base change of an integral Weierstrass equation** over a ring `R`
mapping to `𝓞 K` (for instance `ℤ`), when `S₀` contains the places above `2` and the places
dividing its discriminant. -/
theorem globalDivisionPointsInSupport_of_baseChange {R : Type*} [CommRing R] [Algebra R (𝓞 K)]
    [Algebra R K] [IsScalarTower R (𝓞 K) K] (W₀ : WeierstrassCurve R)
    [(W₀.baseChange K).IsElliptic]
    (h2 : ∀ v : HeightOneSpectrum (𝓞 K), (2 : 𝓞 K) ∈ v.asIdeal → v ∈ S0)
    (hΔ : ∀ v : HeightOneSpectrum (𝓞 K), algebraMap R (𝓞 K) W₀.Δ ∈ v.asIdeal → v ∈ S0)
    (i : ℕ) :
    GlobalDivisionPointsInSupport (S0 := S0) (W₀.baseChange K) i ∧
      FullTorsion K S0 (W₀.baseChange K) (2 ^ i) := by
  have hgood : ∀ v : HeightOneSpectrum (𝓞 K), v ∉ S0 →
      HasGoodReductionAt (W₀.baseChange K) v :=
    fun v hv => hasGoodReductionAt_baseChange W₀ v fun h => hv (hΔ v h)
  exact ⟨globalDivisionPointsInSupport_of_goodReduction _ h2 hgood i,
    fullTorsion_two_pow_of_goodReduction _ h2 hgood i⟩

/-- The actual global Kummer map of the central datum, with the division-point and torsion inputs
supplied by good reduction. -/
def goodReductionKummerMap {S : Set (HeightOneSpectrum (𝓞 K))} (hS : S0 ⊆ S)
    (Pold : Set (HeightOneSpectrum (𝓞 K)))
    (h2 : ∀ v : HeightOneSpectrum (𝓞 K), (2 : 𝓞 K) ∈ v.asIdeal → v ∈ S0)
    (hgood : ∀ v : HeightOneSpectrum (𝓞 K), v ∉ S0 → HasGoodReductionAt W v) (i : ℕ) :
    W.toAffine.Point →+ cochainClasses
      (centralSelData W i hS (fullTorsion_two_pow_of_goodReduction W h2 hgood i) Pold) :=
  globalKummerMap W i (globalDivisionPointsInSupport_of_goodReduction W h2 hgood i) hS
    (fullTorsion_two_pow_of_goodReduction W h2 hgood i) Pold

/-- The retained finite-model boundary of `centralRetainedStage`, with the division-point and
torsion inputs supplied by good reduction. The remaining record `C` is unchanged. -/
theorem centralRetainedStage_exists_witness_of_goodReduction
    {S : Set (HeightOneSpectrum (𝓞 K))} (hS : S0 ⊆ S) (Pold : Set (HeightOneSpectrum (𝓞 K)))
    (h2 : ∀ v : HeightOneSpectrum (𝓞 K), (2 : 𝓞 K) ∈ v.asIdeal → v ∈ S0)
    (hgood : ∀ v : HeightOneSpectrum (𝓞 K), v ∉ S0 → HasGoodReductionAt W v) (i : ℕ)
    {P : W.toAffine.Point} (T : SplitNormStage P) (L : ℤ) (N M0 : ℕ)
    (C : CentralRetainedInput W i hS (fullTorsion_two_pow_of_goodReduction W h2 hgood i) Pold
      (globalDivisionPointsInSupport_of_goodReduction W h2 hgood i) T L N M0) :
    ∃ v : Fin M0 → ℤ_[2], ∀ a : Fin N,
      C.zeta a - ((L * (T.a - 2) : ℤ) : ℤ_[2]) * C.jay a - (C.dC *ᵥ v) a ∈
        ZInQ.Manuscript.RC.BaseZeroLimit.twoAdicStage i :=
  centralRetainedStage_exists_witness W i hS _ Pold _ T L N M0 C

end Inputs

/-! ### The curves `y² = (x − e₁)(x − e₂)(x − e₃)` and `E_ℓ` -/

section Curves

open scoped Classical
open ZInQ.Manuscript.RC.CoefModules (cubicCurve cubicCurve_Δ curveEll isElliptic_curveEll)

variable {K : Type} [Field K] [NumberField K]

/-- A natural number outside `v` is a `v`-adic unit. -/
theorem valuation_natCast_eq_one (v : HeightOneSpectrum (𝓞 K)) {n : ℕ}
    (hn : (n : 𝓞 K) ∉ v.asIdeal) : v.valuation K (n : K) = 1 := by
  rw [← map_natCast (algebraMap (𝓞 K) K)]
  exact (v.valuation_eq_one_iff_notMem).2 hn

/-- `y² = (x − e₁)(x − e₂)(x − e₃)` has good reduction at `v` when the roots are `v`-integral,
`v ∤ 2` and the differences of the roots are `v`-adic units. -/
theorem hasGoodReductionAt_cubicCurve (v : HeightOneSpectrum (𝓞 K)) {e₁ e₂ e₃ : K}
    (h₁ : v.valuation K e₁ ≤ 1) (h₂ : v.valuation K e₂ ≤ 1) (h₃ : v.valuation K e₃ ≤ 1)
    (h2 : (2 : 𝓞 K) ∉ v.asIdeal)
    (hd : v.valuation K ((e₁ - e₂) * (e₁ - e₃) * (e₂ - e₃)) = 1) :
    HasGoodReductionAt (cubicCurve e₁ e₂ e₃) v := by
  have hv2 : v.valuation K (2 : K) = 1 := by
    have := valuation_natCast_eq_one v (n := 2) (by exact_mod_cast h2)
    exact_mod_cast this
  refine ⟨1, ?_, ?_, ?_, ?_, ?_, ?_⟩ <;> rw [one_smul]
  · show v.valuation K 0 ≤ 1
    rw [map_zero]
    exact zero_le
  · show v.valuation K (-(e₁ + e₂ + e₃)) ≤ 1
    rw [Valuation.map_neg]
    exact Valuation.map_add_le _ (Valuation.map_add_le _ h₁ h₂) h₃
  · show v.valuation K 0 ≤ 1
    rw [map_zero]
    exact zero_le
  · show v.valuation K (e₁ * e₂ + e₁ * e₃ + e₂ * e₃) ≤ 1
    refine Valuation.map_add_le _ (Valuation.map_add_le _ ?_ ?_) ?_ <;> rw [map_mul] <;>
      exact mul_le_one' ‹_› ‹_›
  · show v.valuation K (-(e₁ * e₂ * e₃)) ≤ 1
    rw [Valuation.map_neg, map_mul, map_mul]
    exact mul_le_one' (mul_le_one' h₁ h₂) h₃
  · rw [cubicCurve_Δ, map_mul, map_pow, hd, one_pow, mul_one,
      show (16 : K) = 2 ^ 4 by norm_num, map_pow, hv2, one_pow]

/-- **`E_ℓ : y² = x(x − ℓ)(x + 3ℓ)` has good reduction at every place `v ∤ 6` at which `ℓ` is a
unit.** -/
theorem hasGoodReductionAt_curveEll (v : HeightOneSpectrum (𝓞 K)) {ℓ : K}
    (hℓ : v.valuation K ℓ = 1) (h2 : (2 : 𝓞 K) ∉ v.asIdeal) (h3 : (3 : 𝓞 K) ∉ v.asIdeal) :
    HasGoodReductionAt (curveEll ℓ) v := by
  have hv2 : v.valuation K (2 : K) = 1 := by
    have := valuation_natCast_eq_one v (n := 2) (by exact_mod_cast h2)
    exact_mod_cast this
  have hv3 : v.valuation K (3 : K) = 1 := by
    have := valuation_natCast_eq_one v (n := 3) (by exact_mod_cast h3)
    exact_mod_cast this
  refine hasGoodReductionAt_cubicCurve v (by rw [map_zero]; exact zero_le) hℓ.le ?_ h2 ?_
  · rw [map_mul, Valuation.map_neg, hv3, hℓ, one_mul]
  · rw [show ((0 : K) - ℓ) * (0 - -3 * ℓ) * (ℓ - -3 * ℓ) = -(2 ^ 2 * 3 * ℓ ^ 3) by ring,
      Valuation.map_neg, map_mul, map_mul, map_pow, map_pow, hv2, hv3, hℓ]
    simp

/-- **Both inputs for `E_ℓ`.** If `S₀` contains the places above `2` and `3`, and `ℓ ≠ 0` is a
unit outside `S₀`, then every point of `E_ℓ(K)` has a `2^i`-division point over `K_{S₀}`, and
`E_ℓ[2^i]` is defined over `K_{S₀}`. -/
theorem globalDivisionPointsInSupport_curveEll [DecidableEq K]
    {S0 : Set (HeightOneSpectrum (𝓞 K))} {ℓ : K} (hℓ0 : ℓ ≠ 0)
    (h2 : ∀ v : HeightOneSpectrum (𝓞 K), (2 : 𝓞 K) ∈ v.asIdeal → v ∈ S0)
    (h3 : ∀ v : HeightOneSpectrum (𝓞 K), (3 : 𝓞 K) ∈ v.asIdeal → v ∈ S0)
    (hℓ : ∀ v : HeightOneSpectrum (𝓞 K), v ∉ S0 → v.valuation K ℓ = 1) (i : ℕ) :
    GlobalDivisionPointsInSupport (S0 := S0) (curveEll ℓ) i ∧
      FullTorsion K S0 (curveEll ℓ) (2 ^ i) := by
  have : (curveEll ℓ).IsElliptic := isElliptic_curveEll hℓ0
  have hgood : ∀ v : HeightOneSpectrum (𝓞 K), v ∉ S0 → HasGoodReductionAt (curveEll ℓ) v :=
    fun v hv => hasGoodReductionAt_curveEll v (hℓ v hv) (fun h => hv (h2 v h))
      (fun h => hv (h3 v h))
  exact ⟨globalDivisionPointsInSupport_of_goodReduction _ h2 hgood i,
    fullTorsion_two_pow_of_goodReduction _ h2 hgood i⟩

/-- **Both inputs for `E_ℓ` with integral `ℓ`**, when `S₀` contains every place dividing `6ℓ`. -/
theorem globalDivisionPointsInSupport_curveEll_of_integer [DecidableEq K]
    {S0 : Set (HeightOneSpectrum (𝓞 K))} {ℓ : 𝓞 K} (hℓ0 : ℓ ≠ 0)
    (hS0 : ∀ v : HeightOneSpectrum (𝓞 K), 6 * ℓ ∈ v.asIdeal → v ∈ S0) (i : ℕ) :
    GlobalDivisionPointsInSupport (S0 := S0) (curveEll (algebraMap (𝓞 K) K ℓ)) i ∧
      FullTorsion K S0 (curveEll (algebraMap (𝓞 K) K ℓ)) (2 ^ i) := by
  refine globalDivisionPointsInSupport_curveEll
    ((map_ne_zero_iff _ (FaithfulSMul.algebraMap_injective (𝓞 K) K)).2 hℓ0) ?_ ?_ ?_ i
  · intro v hv
    apply hS0 v
    rw [show (6 : 𝓞 K) * ℓ = 2 * (3 * ℓ) by ring]
    exact v.asIdeal.mul_mem_right _ hv
  · intro v hv
    apply hS0 v
    rw [show (6 : 𝓞 K) * ℓ = 3 * (2 * ℓ) by ring]
    exact v.asIdeal.mul_mem_right _ hv
  · intro v hv
    refine (v.valuation_eq_one_iff_notMem).2 fun h => hv (hS0 v ?_)
    exact v.asIdeal.mul_mem_left _ h

end Curves

