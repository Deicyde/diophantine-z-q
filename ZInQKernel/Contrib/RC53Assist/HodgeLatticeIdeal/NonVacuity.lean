import ZInQKernel.Contrib.RC53Assist.HodgeLatticeIdeal.Fractional

/-!
# Non-vacuity and orientation examples over the rational number field

The lattice `𝓞_ℚ` is tested in coordinates `η = 1/2` and `η = 2`. The corresponding
coefficient lattices are `2 𝓞_ℚ` and `(1/2) 𝓞_ℚ`. A scalar section of index two remains
index two after either coordinate change. The norm identity works for every nonzero
fractional ideal of any number field; no principality predicate is required.

Locators: `Coordinates.secIndex_coordinate`, `IdealLines.secIndex_mul_absNorm`, Mathlib,
`FractionalIdeal.mem_one_iff`, `Algebra.norm_self`.
These are examples of the algebraic dictionary, not constructions of a new group model.
-/

set_option maxHeartbeats 800000
set_option autoImplicit false

noncomputable section

namespace ZInQ.Contrib.RC53Assist.HodgeLatticeIdeal.NonVacuity

open NumberField
open ZInQ.DefFaltings

/-- DEFINITION. The ordinary integral lattice in the rational number field.
Locator: Mathlib, `FractionalIdeal.coe_one`. -/
def rationalUnitLattice : Submodule (𝓞 ℚ) ℚ :=
  (1 : FractionalIdeal (nonZeroDivisors (𝓞 ℚ)) ℚ)

/-- THEOREM. The integral lattice is the span of one.
Locator: Mathlib, `FractionalIdeal.mem_one_iff`, `Submodule.mem_span_singleton`. -/
theorem rationalUnitLattice_eq_span :
    rationalUnitLattice = Submodule.span (𝓞 ℚ) {(1 : ℚ)} := by
  ext x
  constructor
  · intro hx
    obtain ⟨r, hr⟩ := (FractionalIdeal.mem_one_iff (nonZeroDivisors (𝓞 ℚ))).mp hx
    exact Submodule.mem_span_singleton.mpr ⟨r, by simpa [Algebra.smul_def] using hr⟩
  · intro hx
    obtain ⟨r, hr⟩ := Submodule.mem_span_singleton.mp hx
    exact (FractionalIdeal.mem_one_iff (nonZeroDivisors (𝓞 ℚ))).mpr
      ⟨r, by simpa [Algebra.smul_def] using hr⟩

/-- THEOREM. A nonzero scalar coordinate pulls a singleton span back to its coefficient span.
Locator: `Coordinates.coordinateMap_injective`, Mathlib, `Submodule.mem_span_singleton`. -/
theorem rational_coefficient_span_smul (η b : ℚ) (hη : η ≠ 0) :
    coefficientSubmodule (Submodule.span (𝓞 ℚ) {b • η}) η =
      Submodule.span (𝓞 ℚ) {b} := by
  ext a
  constructor
  · intro ha
    obtain ⟨r, hr⟩ := Submodule.mem_span_singleton.mp ha
    apply Submodule.mem_span_singleton.mpr
    refine ⟨r, coordinateMap_injective (L := ℚ) η hη ?_⟩
    change (r • b) • η = a • η
    rw [smul_assoc]
    exact hr
  · intro ha
    obtain ⟨r, hr⟩ := Submodule.mem_span_singleton.mp ha
    change a • η ∈ Submodule.span (𝓞 ℚ) {b • η}
    rw [← hr, smul_assoc]
    exact Submodule.smul_mem _ r (Submodule.mem_span_singleton_self _)

/-- THEOREM. Coordinates in the non-integral vector `1/2` give the ideal generated by two.
Locator: `rational_coefficient_span_smul`, `rationalUnitLattice_eq_span`. -/
theorem rational_half_coefficient :
    coefficientSubmodule rationalUnitLattice (1 / 2 : ℚ) =
      Submodule.span (𝓞 ℚ) {(2 : ℚ)} := by
  rw [rationalUnitLattice_eq_span]
  have h := rational_coefficient_span_smul (1 / 2) 2 (by norm_num)
  norm_num [smul_eq_mul] at h
  exact h

/-- THEOREM. Coordinates in the non-generator two give a genuine fractional coefficient lattice.
Locator: `rational_coefficient_span_smul`, `rationalUnitLattice_eq_span`. -/
theorem rational_two_coefficient :
    coefficientSubmodule rationalUnitLattice (2 : ℚ) =
      Submodule.span (𝓞 ℚ) {(1 / 2 : ℚ)} := by
  rw [rationalUnitLattice_eq_span]
  have h := rational_coefficient_span_smul 2 (1 / 2) (by norm_num)
  norm_num [smul_eq_mul] at h
  exact h

/-- THEOREM. The vector `1/2` is not in the ordinary integral lattice.
Locator: Mathlib, `Algebra.coe_norm_int`, `Algebra.norm_self`; integer parity. -/
theorem rational_half_not_integral : (1 / 2 : ℚ) ∉ rationalUnitLattice := by
  intro hh
  obtain ⟨a, ha⟩ := (FractionalIdeal.mem_one_iff (nonZeroDivisors (𝓞 ℚ))).mp hh
  have hc : (Algebra.norm ℤ a : ℚ) = 1 / 2 := by
    simpa [ha] using Algebra.coe_norm_int a
  have hq : (2 : ℚ) * (Algebra.norm ℤ a : ℚ) = 1 := by
    rw [hc]
    norm_num
  have hz : (2 : ℤ) * Algebra.norm ℤ a = 1 := by exact_mod_cast hq
  omega

/-- THEOREM. The coefficient lattice of the vector two genuinely contains a non-integral scalar.
Locator: `rational_two_coefficient`, `rational_half_not_integral`. -/
theorem rational_two_fractional_not_integral :
    (1 / 2 : ℚ) ∈ coefficientSubmodule rationalUnitLattice (2 : ℚ) ∧
      (1 / 2 : ℚ) ∉ rationalUnitLattice := by
  refine ⟨?_, rational_half_not_integral⟩
  rw [rational_two_coefficient]
  exact Submodule.mem_span_singleton_self _

/-- THEOREM. One has index one in the ordinary integral lattice.
Locator: `HodgeData.secIndex`, Mathlib, `AddSubgroup.relIndex_self`. -/
theorem rational_index_one : secIndex rationalUnitLattice (1 : ℚ) = 1 := by
  rw [rationalUnitLattice_eq_span]
  exact AddSubgroup.relIndex_self _

/-- THEOREM. Two has index two, not the reverse index.
Locator: `IdealLines.secIndex_mul_absNorm`, Mathlib, `Algebra.norm_self`. -/
theorem rational_index_two : secIndex rationalUnitLattice (2 : ℚ) = 2 := by
  have h2 : (2 : ℚ) ∈ (1 : FractionalIdeal (nonZeroDivisors (𝓞 ℚ)) ℚ) := by
    exact (FractionalIdeal.mem_one_iff (nonZeroDivisors (𝓞 ℚ))).mpr
      ⟨(2 : 𝓞 ℚ), rfl⟩
  have h := secIndex_mul_absNorm (1 : FractionalIdeal (nonZeroDivisors (𝓞 ℚ)) ℚ)
    h2 (by norm_num)
  have hi : (secIndex rationalUnitLattice (2 : ℚ) : ℚ) = 2 := by
    simpa [rationalUnitLattice] using h
  exact_mod_cast hi

/-- THEOREM. In half coordinates, coefficient four represents the section two, with index two.
Locator: `Coordinates.secIndex_coordinate`, `rational_half_coefficient`, `rational_index_two`. -/
theorem rational_half_index :
    secIndex (Submodule.span (𝓞 ℚ) {(2 : ℚ)}) (4 : ℚ) = 2 := by
  have h := secIndex_coordinate (Module.finrank_self ℚ) (1 / 2 : ℚ) (by norm_num)
    rationalUnitLattice (4 : ℚ)
  rw [rational_half_coefficient] at h
  norm_num [smul_eq_mul] at h
  rw [← h, rational_index_two]

/-- THEOREM. In two coordinates, coefficient one represents the section two, with index two.
Locator: `Coordinates.secIndex_coordinate`, `rational_two_coefficient`, `rational_index_two`. -/
theorem rational_two_index :
    secIndex (Submodule.span (𝓞 ℚ) {(1 / 2 : ℚ)}) (1 : ℚ) = 2 := by
  have h := secIndex_coordinate (Module.finrank_self ℚ) (2 : ℚ) (by norm_num)
    rationalUnitLattice (1 : ℚ)
  rw [rational_two_coefficient] at h
  norm_num [smul_eq_mul] at h
  rw [← h, rational_index_two]

/-- THEOREM. The half-coordinate coefficient lattice is nonzero, finitely generated,
spans the rational field, and has a common denominator.
Locator: `rational_half_coefficient`, Mathlib, `Submodule.fg_span_singleton`,
`FractionalIdeal.isFractional_of_fg`; `Coordinates.submodule_spans_of_ne_bot`. -/
theorem rational_half_fractional :
    let I := coefficientSubmodule rationalUnitLattice (1 / 2 : ℚ)
    I ≠ ⊥ ∧ I.FG ∧ Submodule.span ℚ (I : Set ℚ) = ⊤ ∧
      IsFractional (nonZeroDivisors (𝓞 ℚ)) I := by
  dsimp only
  have hfg : (coefficientSubmodule rationalUnitLattice (1 / 2 : ℚ)).FG := by
    rw [rational_half_coefficient]
    exact Submodule.fg_span_singleton _
  have hn : coefficientSubmodule rationalUnitLattice (1 / 2 : ℚ) ≠ ⊥ := by
    intro hbot
    have h2 : (2 : ℚ) ∈ coefficientSubmodule rationalUnitLattice (1 / 2 : ℚ) := by
      rw [rational_half_coefficient]
      exact Submodule.mem_span_singleton_self _
    have hz : (2 : ℚ) = 0 := by
      have : (2 : ℚ) ∈ (⊥ : Submodule (𝓞 ℚ) ℚ) := hbot ▸ h2
      exact this
    norm_num at hz
  exact ⟨hn, hfg, submodule_spans_of_ne_bot _ hn, FractionalIdeal.isFractional_of_fg hfg⟩

/-- THEOREM. Unit coordinates recover any fractional ideal, whether principal or not.
Locator: `Coordinates.mem_coefficientSubmodule`, Mathlib, `smul_eq_mul`. -/
theorem arbitrary_fractionalIdeal_unit_coordinates {L : Type*} [Field L] [NumberField L]
    (I : FractionalIdeal (nonZeroDivisors (𝓞 L)) L) :
    coefficientSubmodule (I : Submodule (𝓞 L) L) (1 : L) = (I : Submodule (𝓞 L) L) := by
  ext a
  simp [smul_eq_mul]

/-- THEOREM. Every nonzero fractional ideal admits the norm-index dictionary without a
principality assumption.
Locator: `IdealLines.secIndex_mul_absNorm`, Mathlib, `Algebra.norm_ne_zero_iff`. -/
theorem arbitrary_fractionalIdeal_norm_index {L : Type*} [Field L] [NumberField L]
    (I : FractionalIdeal (nonZeroDivisors (𝓞 L)) L) {a : L} (ha : a ∈ I) (ha0 : a ≠ 0) :
    (secIndex (I : Submodule (𝓞 L) L) a : ℚ) * FractionalIdeal.absNorm I =
      |Algebra.norm ℚ a| ∧ secIndex (I : Submodule (𝓞 L) L) a ≠ 0 := by
  have h := secIndex_mul_absNorm I ha ha0
  refine ⟨h, ?_⟩
  intro hz
  rw [hz, Nat.cast_zero, zero_mul] at h
  exact (Algebra.norm_ne_zero_iff.mpr ha0) (abs_eq_zero.mp h.symm)

end ZInQ.Contrib.RC53Assist.HodgeLatticeIdeal.NonVacuity
