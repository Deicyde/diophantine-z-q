import Mathlib.Algebra.Homology.Embedding.CochainComplex

/-!
# Genuine quadratic-field objects and Selmer cocycles

The field is generated by the specified square root in the separable closure.
The compact and rational complexes have the Tate coefficients and the ordinary
Kummer condition. The discrete cocycle complex uses local triviality at every
finite and infinite place, through the genuine quadratic Selmer subgroup.
It retains the whole degree-zero coefficient module, not only degree-one classes.
-/

noncomputable section

set_option maxHeartbeats 600000
set_option backward.isDefEq.respectTransparency false

namespace ZInQ.Manuscript.RC53Assist.CentralUniversal

open CategoryTheory NumberField IsDedekindDomain
open ZInQ.Manuscript.RC53Assist.CentralKummer
open ZInQ.Manuscript.RC53Assist.QuadraticDescent
open ZInQ.Manuscript.RC.SelmerComplex ZInQ.Manuscript.RC.CoefModules
open ZInQ.Manuscript.RC.KummerMaps ZInQ.Manuscript.RC.LambdaCoef
open ZInQ.Manuscript.SelmerTwoPower ZInQ.Contrib.CloudB3RC53
open ZInQ.Contrib.CloudB3RC53.PairedFunctional ZInQ.Contrib.CloudB3RC53.SelmerDuality
open TauCeti TauCeti.ContCohomology

section TorsionFreeTerms

variable {R G M : Type} [CommRing R] [Group G] [TopologicalSpace G]
  [IsTopologicalGroup G] [AddCommGroup M] [Module R M]
  [DistribMulAction G M] [SMulCommClass G R M] [TopologicalSpace M]
  [ContinuousAdd M] [ContinuousConstSMul R M] [ContinuousSMul G M]
  [Module.IsTorsionFree R M]

omit [IsTopologicalGroup G] [ContinuousSMul G M] in
/-- Continuous cochains with torsion-free coefficients are torsion-free. -/
theorem continuousCochain_isTorsionFree (n : ℕ) :
    Module.IsTorsionFree R (contCochain R G M n) := by
  have : Module.IsTorsionFree R ((Fin n → G) → M) := inferInstance
  exact Function.Injective.moduleIsTorsionFree
    (fun c : contCochain R G M n => cfun c)
    (fun _ _ h => Subtype.ext h) (fun _ _ => rfl)

/-- Extension by zero preserves torsion-freeness of continuous cochain terms. -/
theorem naturalCochains_isTorsionFree (n : ℤ) :
    Module.IsTorsionFree R ((natCx (contCochains R G M)).X n) := by
  cases n with
  | ofNat m => exact continuousCochain_isTorsionFree m
  | negSucc m => exact inferInstanceAs (Module.IsTorsionFree R PUnit)

end TorsionFreeTerms

section CompactTerms

variable {K : Type} [Field K] [NumberField K]
  (S : Set (HeightOneSpectrum (𝓞 K))) (W : WeierstrassCurve K) [W.IsElliptic]
  (hFull : ∀ n : ℕ, FullTorsion K S W (2 ^ n))

include hFull in
/-- Restricting a torsion-free Tate coefficient module to a local group does not change its scalars. -/
theorem localTate_isTorsionFree (v : HeightOneSpectrum (𝓞 K)) :
    Module.IsTorsionFree ℤ_[2] (ResMod (locMap K S v) (TateS K S W)) := by
  have : HasFullTwoTorsion K S W := ⟨hFull⟩
  have : Module.IsTorsionFree ℤ_[2] (TateS K S W) := inferInstance
  exact Function.Injective.moduleIsTorsionFree
    (fun x : ResMod (locMap K S v) (TateS K S W) => (show TateS K S W from x))
    (fun _ _ h => h) (fun _ _ => rfl)

/-- Every term of the genuine compact Kummer complex is torsion-free. -/
theorem compactKummerTerm_isTorsionFree (n : ℤ) :
    Module.IsTorsionFree ℤ_[2] ((compactKummerComplex S W hFull).X n) := by
  classical
  have : HasFullTwoTorsion K S W := ⟨hFull⟩
  have : Module.IsTorsionFree ℤ_[2] (TateS K S W) := inferInstance
  have hG := naturalCochains_isTorsionFree
    (R := ℤ_[2]) (G := GKS K S) (M := TateS K S W) n
  have hL (v : Places K S) (j : ℤ) : Module.IsTorsionFree ℤ_[2]
      ((natCx (contCochains ℤ_[2] (Gloc K v.1)
        (ResMod (locMap K S v.1) (TateS K S W)))).X j) := by
    have := localTate_isTorsionFree S W hFull v.1
    exact naturalCochains_isTorsionFree j
  have hU (v : Places K S) : Module.IsTorsionFree ℤ_[2]
      ((tateKummerCondition W hFull v.1).X n) := by
    have := hL v n
    let f := (tateKummerConditionι W hFull v.1).f n n rfl
    exact Function.Injective.moduleIsTorsionFree f
      (cocycleConditionι_injective _ _ n) (fun a x => f.map_smul a x)
  let := hG
  let : ∀ v : Places K S, Module.IsTorsionFree ℤ_[2]
      ((tateKummerCondition W hFull v.1).X n) := hU
  let : ∀ v : Places K S, Module.IsTorsionFree ℤ_[2]
      ((natCx (contCochains ℤ_[2] (Gloc K v.1)
        (ResMod (locMap K S v.1) (TateS K S W)))).X (n - 1)) := fun v => hL v (n - 1)
  change Module.IsTorsionFree ℤ_[2]
    (((natCx (contCochains ℤ_[2] (GKS K S) (TateS K S W))).X n) ×
      (∀ v : Places K S, (tateKummerCondition W hFull v.1).X n) ×
      (∀ v : Places K S, (natCx (contCochains ℤ_[2] (Gloc K v.1)
        (ResMod (locMap K S v.1) (TateS K S W)))).X (n - 1)))
  infer_instance

end CompactTerms

/-- The specified quadratic field inside the separable closure of the rationals. -/
abbrev QuadraticField (k : ℤ) : Type := IntermediateField.adjoin ℚ {sqrtK k}

instance quadraticField_finiteDimensional (k : ℤ) : FiniteDimensional ℚ (QuadraticField k) :=
  IntermediateField.adjoin.finiteDimensional (Algebra.IsIntegral.isIntegral (sqrtK k))

instance quadraticField_numberField (k : ℤ) : NumberField (QuadraticField k) :=
  NumberField.of_module_finite ℚ (QuadraticField k)

/-- The subgroup used by the genuine Selmer group fixes exactly this field. -/
theorem quadraticField_fixingSubgroup (k : ℤ) :
    galK (sqrtK k) = (IntermediateField.adjoin ℚ {sqrtK k}).fixingSubgroup :=
  galK_eq_fixingAdjoin _

section ArithmeticComplexes

variable (ℓ : ℕ) (k : ℤ) [(Ecurve ℓ).IsElliptic]
  (S : Set (HeightOneSpectrum (𝓞 (QuadraticField k))))
  (hFull : ∀ n : ℕ, FullTorsion (QuadraticField k) S
    ((Ecurve ℓ).baseChange (QuadraticField k)) (2 ^ n))

/-- The genuine ordinary compact Kummer complex of the specified curve and field. -/
abbrev arithmeticCompactComplex : CochainComplex (ModuleCat.{0} ℤ_[2]) ℤ :=
  compactKummerComplex S ((Ecurve ℓ).baseChange (QuadraticField k)) hFull

/-- Its genuine rational scalar extension. -/
abbrev arithmeticRationalComplex : CochainComplex (ModuleCat.{0} ℚ_[2]) ℤ :=
  rationalKummerComplex S ((Ecurve ℓ).baseChange (QuadraticField k)) hFull

instance arithmeticCompactTerm_isTorsionFree (n : ℤ) :
    Module.IsTorsionFree ℤ_[2] ((arithmeticCompactComplex ℓ k S hFull).X n) :=
  compactKummerTerm_isTorsionFree S _ hFull n

end ArithmeticComplexes

end ZInQ.Manuscript.RC53Assist.CentralUniversal
