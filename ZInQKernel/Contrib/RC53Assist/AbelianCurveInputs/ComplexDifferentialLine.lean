import ZInQKernel.Contrib.RC53Assist.AbelianCurveInputs.CanonicalResidues
import Mathlib.Basic.Complex.Basic
import Mathlib.LinearAlgebra.TensorProduct.Tower

/-!
# The complex algebraic holomorphic differential line

The normalized comparison is now independent of the separating parameter. Its
regular Kähler preimage on a nonsingular Weierstrass function field is the
constant-field line generated by dx/(2y + a₁x + a₃). This applies over the complex
numbers as well. Scalar extension of actual rational sheaf sections is kept
separate from identifying analytic holomorphic forms or proving GAGA.

Locators: `CloudB3RC53/ModularWeil/DifferentialLine.lean`, the S2 clause;
Silverman III.1.5 and II, §§4–5.
-/

set_option maxHeartbeats 800000
set_option autoImplicit false
set_option linter.style.haveILetI false
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

noncomputable section

namespace ZInQ.Contrib.RC53Assist.AbelianCurveInputs.ComplexDifferentialLine

open Module TauCeti Polynomial KaehlerDifferential
open AlgebraicGeometry CategoryTheory
open ZInQ.Contrib.RC53Assist.AbelianCurve
open scoped IntermediateField TensorProduct

/-- THEOREM. Every normalized separating-parameter comparison takes the actual
invariant Kähler form to the same invariant Weil differential.
Locator: the closed cotrace chain rule, parameter independence, and
`InvariantDifferential.invariantWeilDifferential`. -/
theorem comparison_invariant_parameter_free {k : Type} [Field k] [CharZero k]
    (W : WeierstrassCurve.Affine k) [W.IsElliptic] {x : W.FunctionField}
    (hx : Transcendental k x) :
    letI := W.isFunctionField.finiteDimensional_adjoin hx
    letI := weilDifferentialSpaceModule W.isFunctionField
    comparison W.isFunctionField
      (WeierstrassCurve.Affine.isIntegrallyClosedIn_functionField W) hx
      (WeierstrassCurve.Affine.invariantDifferential W) =
        InvariantDifferential.invariantWeilDifferential W := by
  haveI := W.isFunctionField.finiteDimensional_adjoin hx
  haveI := W.isFunctionField.finiteDimensional_adjoin
    (WeierstrassCurve.Affine.transcendental_genericX W)
  letI := weilDifferentialSpaceModule W.isFunctionField
  have heq := comparison_parameter_independent CanonicalResidues.separatingCotraceChainRule
    k W.FunctionField W.isFunctionField
    (WeierstrassCurve.Affine.isIntegrallyClosedIn_functionField W) x W.genericX hx
    (WeierstrassCurve.Affine.transcendental_genericX W)
  rw [heq, LocalFacts.comparison_eq_divisorZero]
  rfl

/-- DEFINITION. The regular Kähler submodule is the preimage of the actual
holomorphic Weil filtration under the normalized comparison.
Locator: the canonical comparison and `InvariantDifferential.DivisorZero.lean`. -/
def regularKaehlerSubmodule {k : Type} [Field k] [CharZero k]
    (W : WeierstrassCurve.Affine k) [W.IsElliptic] :
    Submodule k (KaehlerDifferential k W.FunctionField) := by
  letI := weilDifferentialSpaceModule W.isFunctionField
  letI := isScalarTower_weilDifferentialSpace W.isFunctionField
  exact (holomorphicWeilSubmodule (k := k) (F := W.FunctionField)).comap
    ((comparison W.isFunctionField
      (WeierstrassCurve.Affine.isIntegrallyClosedIn_functionField W)
      (WeierstrassCurve.Affine.transcendental_genericX W)).restrictScalars k).toLinearMap

/-- THEOREM. The regular Kähler submodule is independent of the separating
parameter and consists of unique constant multiples of the invariant form.
Locator: parameter independence and the proved S2c holomorphic characterization. -/
theorem mem_regularKaehler_iff {k : Type} [Field k] [CharZero k]
    (W : WeierstrassCurve.Affine k) [W.IsElliptic]
    (η : KaehlerDifferential k W.FunctionField) :
    η ∈ regularKaehlerSubmodule W ↔
      ∃! c : k, c • WeierstrassCurve.Affine.invariantDifferential W = η := by
  letI := weilDifferentialSpaceModule W.isFunctionField
  letI := isScalarTower_weilDifferentialSpace W.isFunctionField
  change (comparison W.isFunctionField
    (WeierstrassCurve.Affine.isIntegrallyClosedIn_functionField W)
    (WeierstrassCurve.Affine.transcendental_genericX W) η :
      Module.Dual k ↥(repartitionSpace k W.FunctionField)) ∈
    weilDifferentialFiltration (0 : Divisor k W.FunctionField) ↔ _
  exact LocalFacts.comparison_mem_holomorphic_iff W η

/-- THEOREM. The actual regular Kähler space is the constant-field span of
its invariant differential, not merely a vector space of dimension one.
Locator: `mem_regularKaehler_iff` and the nonzero invariant differential. -/
theorem regularKaehler_eq_span {k : Type} [Field k] [CharZero k]
    (W : WeierstrassCurve.Affine k) [W.IsElliptic] :
    regularKaehlerSubmodule W = Submodule.span k {WeierstrassCurve.Affine.invariantDifferential W} := by
  ext η
  rw [mem_regularKaehler_iff, Submodule.mem_span_singleton]
  constructor
  · rintro ⟨c, hc, _⟩
    exact ⟨c, hc⟩
  · rintro ⟨c, hc⟩
    refine ⟨c, hc, fun d hd => ?_⟩
    exact smul_left_injective k (WeierstrassCurve.Affine.invariantDifferential_ne_zero W)
      (hd.trans hc.symm)

/-- THEOREM. Over the complex numbers, the regular Kähler differentials are
exactly the complex line generated by dx/(2y + a₁x + a₃).
This is the algebraic function-field form, not an analytic GAGA identification.
Locator: the S2 clause and `regularKaehler_eq_span`. -/
theorem complex_regularKaehler_eq_span
    (W : WeierstrassCurve.Affine ℂ) [W.IsElliptic] :
    regularKaehlerSubmodule W = Submodule.span ℂ {WeierstrassCurve.Affine.invariantDifferential W} :=
  regularKaehler_eq_span W

/-- THEOREM. The complex holomorphic Weil filtration is exactly the image line
of the actual invariant form, for every separating parameter.
Locator: the closed comparison normalization and Silverman III.1.5. -/
theorem complex_holomorphicWeil_eq_span_comparison
    (W : WeierstrassCurve.Affine ℂ) [W.IsElliptic] {x : W.FunctionField}
    (hx : Transcendental ℂ x) :
    letI := W.isFunctionField.finiteDimensional_adjoin hx
    letI := weilDifferentialSpaceModule W.isFunctionField
    weilDifferentialFiltration (0 : Divisor ℂ W.FunctionField) =
      Submodule.span ℂ {(comparison W.isFunctionField
        (WeierstrassCurve.Affine.isIntegrallyClosedIn_functionField W) hx
        (WeierstrassCurve.Affine.invariantDifferential W) :
          Module.Dual ℂ ↥(repartitionSpace ℂ W.FunctionField))} := by
  haveI := W.isFunctionField.finiteDimensional_adjoin hx
  letI := weilDifferentialSpaceModule W.isFunctionField
  rw [comparison_invariant_parameter_free]
  exact InvariantDifferential.holomorphicWeilDifferentials_eq_span W

/-- DEFINITION. Restriction of the intrinsic comparison to its proved
holomorphic image is a rational-linear equivalence of the actual sheaf sections.
Locator: the closed canonical package and `LinearEquiv.ofBijective`. -/
def canonicalRegularSectionEquiv {X : Scheme.{0}} [IsIntegral X]
    (f : X ⟶ Spec (.of ℚ)) [Smooth f] [IsProper f] [GeometricallyIntegral f]
    (hd : topologicalKrullDim X = 1) :
    letI := functionFieldAlgebra f
    let hF := isFunctionField_of_dimension_one f hd
    letI := weilDifferentialSpaceModule hF
    letI := globalSectionsModule f (differentialSheaf f)
    Γ(differentialSheaf f, ⊤) ≃ₗ[ℚ]
      ↥(holomorphicWeilSubmodule (k := ℚ) (F := X.functionField)) := by
  letI := functionFieldAlgebra f
  let hF := isFunctionField_of_dimension_one f hd
  letI := weilDifferentialSpaceModule hF
  letI := globalSectionsModule f (differentialSheaf f)
  let H := holomorphicWeilSubmodule (k := ℚ) (F := X.functionField)
  let L := intrinsicWeilComparison f hd
  have hC := CanonicalResidues.regularDifferentialComparisonCanonical.image X f hd
  have hmem : ∀ s, L s ∈ H := by
    intro s
    change intrinsicWeilComparison f hd s ∈
      holomorphicWeilSubmodule (k := ℚ) (F := X.functionField)
    rw [← hC.2]
    exact ⟨s, rfl⟩
  let L₀ := L.codRestrict H hmem
  refine LinearEquiv.ofBijective L₀ ⟨?_, ?_⟩
  · intro s t hst
    exact hC.1 (congrArg Subtype.val hst)
  · intro ω
    have hw : (ω : ↥(weilDifferentialSpace ℚ X.functionField)) ∈ L.range := by
      rw [hC.2]
      exact ω.2
    obtain ⟨s, hs⟩ := hw
    exact ⟨s, Subtype.ext hs⟩

/-- THEOREM. The equivalence on actual global sections is the intrinsic
restriction–cotrace map, with no dimension-chosen map replacing it.
Locator: `canonicalRegularSectionEquiv`. -/
theorem canonicalRegularSectionEquiv_apply {X : Scheme.{0}} [IsIntegral X]
    (f : X ⟶ Spec (.of ℚ)) [Smooth f] [IsProper f] [GeometricallyIntegral f]
    (hd : topologicalKrullDim X = 1) :
    letI := functionFieldAlgebra f
    let hF := isFunctionField_of_dimension_one f hd
    letI := weilDifferentialSpaceModule hF
    letI := globalSectionsModule f (differentialSheaf f)
    ∀ s : Γ(differentialSheaf f, ⊤),
      (canonicalRegularSectionEquiv f hd s : ↥(weilDifferentialSpace ℚ X.functionField)) =
        intrinsicWeilComparison f hd s := by
  dsimp only
  intro s
  rfl

/-- THEOREM. Extending the genuine rational regular Kähler submodule to complex
scalars gives the complex span of the extended invariant form.
Locator: `Submodule.baseChange_span` and `regularKaehler_eq_span`.
This statement does not replace the analytic holomorphic space by a tensor product. -/
theorem complexified_regularKaehler_eq_span {k : Type} [Field k] [CharZero k] [Algebra k ℂ]
    (W : WeierstrassCurve.Affine k) [W.IsElliptic] :
    (regularKaehlerSubmodule W).baseChange ℂ =
      Submodule.span ℂ {(1 : ℂ) ⊗ₜ[k] WeierstrassCurve.Affine.invariantDifferential W} := by
  rw [regularKaehler_eq_span, Submodule.baseChange_span, Set.image_singleton]
  rfl

/-- DEFINITION. Scalar extension to the complex numbers of the canonical
comparison of actual rational sheaf sections with regular Weil differentials.
Locator: `canonicalRegularSectionEquiv` and `TensorProduct.AlgebraTensorModule.congr`.
No analytic realization or sheaf-cohomology base-change assertion is assumed. -/
def complexifiedCanonicalRegularSectionEquiv {X : Scheme.{0}} [IsIntegral X]
    (f : X ⟶ Spec (.of ℚ)) [Smooth f] [IsProper f] [GeometricallyIntegral f]
    (hd : topologicalKrullDim X = 1) :
    letI := functionFieldAlgebra f
    let hF := isFunctionField_of_dimension_one f hd
    letI := weilDifferentialSpaceModule hF
    letI := globalSectionsModule f (differentialSheaf f)
    (ℂ ⊗[ℚ] Γ(differentialSheaf f, ⊤)) ≃ₗ[ℂ]
      (ℂ ⊗[ℚ] ↥(holomorphicWeilSubmodule (k := ℚ) (F := X.functionField))) := by
  letI := functionFieldAlgebra f
  let hF := isFunctionField_of_dimension_one f hd
  letI := weilDifferentialSpaceModule hF
  letI := globalSectionsModule f (differentialSheaf f)
  exact TensorProduct.AlgebraTensorModule.congr (LinearEquiv.refl ℂ ℂ)
    (canonicalRegularSectionEquiv f hd)

/-- THEOREM. On pure tensors, the scalar-extended comparison is the actual
intrinsic generic-restriction map, not a dimension-chosen equivalence.
Locator: `complexifiedCanonicalRegularSectionEquiv` and tensor-map evaluation. -/
theorem complexifiedCanonicalRegularSectionEquiv_tmul {X : Scheme.{0}} [IsIntegral X]
    (f : X ⟶ Spec (.of ℚ)) [Smooth f] [IsProper f] [GeometricallyIntegral f]
    (hd : topologicalKrullDim X = 1) :
    letI := functionFieldAlgebra f
    let hF := isFunctionField_of_dimension_one f hd
    letI := weilDifferentialSpaceModule hF
    letI := globalSectionsModule f (differentialSheaf f)
    ∀ (c : ℂ) (s : Γ(differentialSheaf f, ⊤)),
      ((holomorphicWeilSubmodule (k := ℚ) (F := X.functionField)).subtype.baseChange ℂ)
        (complexifiedCanonicalRegularSectionEquiv f hd (c ⊗ₜ[ℚ] s)) =
          c ⊗ₜ[ℚ] intrinsicWeilComparison f hd s := by
  letI := functionFieldAlgebra f
  let hF := isFunctionField_of_dimension_one f hd
  letI := weilDifferentialSpaceModule hF
  letI := globalSectionsModule f (differentialSheaf f)
  dsimp only
  intro c s
  rw [complexifiedCanonicalRegularSectionEquiv,
    TensorProduct.AlgebraTensorModule.congr_tmul, LinearEquiv.refl_apply,
    LinearMap.baseChange_tmul]
  rfl

/-- THEOREM. The scalar-extended canonical comparison is natural for the actual
sheaf differential pullback of a curve isomorphism and the actual Weil cotrace.
Locator: the closed `RegularDifferentialComparisonCanonical.naturality` field
and functorial scalar extension. -/
theorem complexified_intrinsic_naturality {X Y : Scheme.{0}} [IsIntegral X] [IsIntegral Y]
    (f : X ⟶ Spec (.of ℚ)) [Smooth f] [IsProper f] [GeometricallyIntegral f]
    (g : Y ⟶ Spec (.of ℚ)) [Smooth g] [IsProper g] [GeometricallyIntegral g]
    (hdX : topologicalKrullDim X = 1) (hdY : topologicalKrullDim Y = 1)
    (i : X ≅ Y) (hi : i.hom ≫ g = f) :
    letI := functionFieldAlgebra f
    letI := functionFieldAlgebra g
    let hFX := isFunctionField_of_dimension_one f hdX
    let hFY := isFunctionField_of_dimension_one g hdY
    letI := weilDifferentialSpaceModule hFX
    letI := weilDifferentialSpaceModule hFY
    letI := globalSectionsModule f (differentialSheaf f)
    letI := globalSectionsModule g (differentialSheaf g)
    ∀ v : ℂ ⊗[ℚ] Γ(differentialSheaf g, ⊤),
      (intrinsicWeilComparison f hdX).baseChange ℂ
        ((globalDifferentialPullback f g i.hom hi).baseChange ℂ v) =
      (weilFieldTransport (curveFunctionFieldEquiv f g i) hFY hFX).baseChange ℂ
        ((intrinsicWeilComparison g hdY).baseChange ℂ v) := by
  letI := functionFieldAlgebra f
  letI := functionFieldAlgebra g
  let hFX := isFunctionField_of_dimension_one f hdX
  let hFY := isFunctionField_of_dimension_one g hdY
  letI := weilDifferentialSpaceModule hFX
  letI := weilDifferentialSpaceModule hFY
  letI := globalSectionsModule f (differentialSheaf f)
  letI := globalSectionsModule g (differentialSheaf g)
  dsimp only
  intro v
  induction v using TensorProduct.induction_on with
  | zero => simp
  | tmul c s =>
    simp only [LinearMap.baseChange_tmul]
    exact congrArg (fun w => c ⊗ₜ[ℚ] w)
      (CanonicalResidues.regularDifferentialComparisonCanonical.naturality X Y f g
        hdX hdY i hi s)
  | add a b ha hb => simp only [map_add, ha, hb]

/-- THEOREM. The holomorphic criterion holds for every separating parameter,
not only the Weierstrass X coordinate. Locator: the proved parameter-independent
comparison and the actual S2c invariant differential. -/
theorem comparison_mem_holomorphic_iff_parameter_free {k : Type} [Field k] [CharZero k]
    (W : WeierstrassCurve.Affine k) [W.IsElliptic] {x : W.FunctionField}
    (hx : Transcendental k x) (η : KaehlerDifferential k W.FunctionField) :
    letI := W.isFunctionField.finiteDimensional_adjoin hx
    letI := weilDifferentialSpaceModule W.isFunctionField
    (comparison W.isFunctionField
      (WeierstrassCurve.Affine.isIntegrallyClosedIn_functionField W) hx η :
        Module.Dual k ↥(repartitionSpace k W.FunctionField)) ∈
      weilDifferentialFiltration (0 : Divisor k W.FunctionField) ↔
        ∃! c : k, c • WeierstrassCurve.Affine.invariantDifferential W = η := by
  haveI := W.isFunctionField.finiteDimensional_adjoin hx
  haveI := W.isFunctionField.finiteDimensional_adjoin
    (WeierstrassCurve.Affine.transcendental_genericX W)
  letI := weilDifferentialSpaceModule W.isFunctionField
  have heq := comparison_parameter_independent CanonicalResidues.separatingCotraceChainRule
    k W.FunctionField W.isFunctionField
    (WeierstrassCurve.Affine.isIntegrallyClosedIn_functionField W) x W.genericX hx
    (WeierstrassCurve.Affine.transcendental_genericX W)
  rw [heq]
  exact LocalFacts.comparison_mem_holomorphic_iff W η

/-- THEOREM. The complex algebraic holomorphic line is generated by the explicit
Weierstrass differential dx/(2y + a₁x + a₃).
Locator: the S2 formula; `invariantDifferential_def` and
`invariantDifferentialDenom_def`. -/
theorem complex_regularKaehler_explicit_formula
    (W : WeierstrassCurve.Affine ℂ) [W.IsElliptic] :
    regularKaehlerSubmodule W = Submodule.span ℂ
      {(2 * W.genericY + algebraMap ℂ W.FunctionField W.a₁ * W.genericX +
          algebraMap ℂ W.FunctionField W.a₃)⁻¹ • D ℂ W.FunctionField W.genericX} := by
  rw [complex_regularKaehler_eq_span, WeierstrassCurve.Affine.invariantDifferential_def,
    WeierstrassCurve.Affine.invariantDifferentialDenom_def]

end ZInQ.Contrib.RC53Assist.AbelianCurveInputs.ComplexDifferentialLine
