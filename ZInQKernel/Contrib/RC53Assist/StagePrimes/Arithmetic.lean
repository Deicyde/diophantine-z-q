open ZInQ.Contrib.RC53Assist.InnerLimitArith
open ZInQ.Contrib.RC53Assist.FrobeniusMatch
open scoped Pointwise WeierstrassCurve PowerSeries.WithPiTopology

variable {K : Type} [Field K] [NumberField K]

attribute [local instance] Ideal.Quotient.field

/-- Over the rational integers, the order of an unramified arithmetic Frobenius
is the residue degree. -/
theorem int_frobenius_order [IsGalois ℚ K]
    (Q : Ideal (𝓞 K)) [Q.IsPrime] [Algebra.IsUnramifiedAt ℤ Q]
    (σ : K ≃ₐ[ℚ] K) (hσ : IsArithFrobAt ℤ σ Q) :
    orderOf σ = Q.inertiaDeg ℤ := by
  have hunder : Q.under ℤ ≠ ⊥ := by
    intro h
    have : Q.LiesOver (⊥ : Ideal ℤ) := ⟨h.symm⟩
    exact hσ.ne_bot (Ideal.eq_bot_of_liesOver_bot ℤ Q)
  let _ : Q.IsMaximal := (inferInstance : Q.IsPrime).isMaximal hσ.ne_bot
  let _ : (Q.under ℤ).IsMaximal := (Ideal.IsPrime.under ℤ Q).isMaximal hunder
  let _ : Finite (ℤ ⧸ Q.under ℤ) := Ring.HasFiniteQuotients.finiteQuotient hunder
  let _ : Fintype (ℤ ⧸ Q.under ℤ) := Fintype.ofFinite _
  have hI : Q.inertia (K ≃ₐ[ℚ] K) = ⊥ := by
    apply Subgroup.eq_bot_of_card_eq
    rw [Ideal.card_inertia_eq_ramificationIdx ℤ (K ≃ₐ[ℚ] K) Q]
    exact (Ideal.ramificationIdx_eq_one_iff (R := ℤ) (q := Q)).mpr inferInstance
  have hinj : Function.Injective
      (Ideal.Quotient.stabilizerHom Q (Q.under ℤ) (K ≃ₐ[ℚ] K)) := by
    rw [← MonoidHom.ker_eq_bot_iff, Ideal.Quotient.ker_stabilizerHom, eq_bot_iff]
    intro τ hτ
    have hτ' : (τ : K ≃ₐ[ℚ] K) ∈ Q.inertia (K ≃ₐ[ℚ] K) :=
      Ideal.coe_mem_inertia.mpr hτ
    rw [hI, Subgroup.mem_bot] at hτ'
    exact Subgroup.mem_bot.mpr (Subtype.ext hτ')
  have hres :
      Ideal.Quotient.stabilizerHom Q (Q.under ℤ) (K ≃ₐ[ℚ] K)
        ⟨σ, hσ.mem_stabilizer⟩ =
      FiniteField.frobeniusAlgEquivOfAlgebraic (ℤ ⧸ Q.under ℤ) (𝓞 K ⧸ Q) := by
    ext x
    obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective x
    rw [Ideal.Quotient.stabilizerHom_apply,
      FiniteField.coe_frobeniusAlgEquivOfAlgebraic]
    simpa only [← Nat.card_eq_fintype_card, MulAction.subgroup_smul_def,
      MulSemiringAction.toAlgHom_apply] using hσ.mk_apply x
  have horder :
      orderOf (⟨σ, hσ.mem_stabilizer⟩ : MulAction.stabilizer (K ≃ₐ[ℚ] K) Q) =
      Q.inertiaDeg ℤ := by
    rw [← orderOf_injective _ hinj, hres,
      FiniteField.orderOf_frobeniusAlgEquivOfAlgebraic,
      ← Ideal.inertiaDeg_eq_of_isMaximal (Q.under ℤ) Q]
  exact (Subgroup.orderOf_coe (⟨σ, hσ.mem_stabilizer⟩ :
    MulAction.stabilizer (K ≃ₐ[ℚ] K) Q)).trans horder

/-- In a quadratic number field, an unramified arithmetic Frobenius is nontrivial
if and only if its residue degree is two. -/
theorem quadratic_frobenius_ne_one_iff (hdegree : Module.finrank ℚ K = 2)
    (Q : Ideal (𝓞 K)) [Q.IsPrime] [Algebra.IsUnramifiedAt ℤ Q]
    (σ : K ≃ₐ[ℚ] K) (hσ : IsArithFrobAt ℤ σ Q) :
    σ ≠ 1 ↔ Q.inertiaDeg ℤ = 2 := by
  let _ : Algebra.IsQuadraticExtension ℚ K := ⟨hdegree⟩
  have horder := int_frobenius_order Q σ hσ
  have hcard : Nat.card (K ≃ₐ[ℚ] K) = 2 :=
    (IsGalois.card_aut_eq_finrank ℚ K).trans hdegree
  constructor
  · intro hne
    have hdvd : orderOf σ ∣ 2 := hcard ▸ orderOf_dvd_natCard σ
    rcases Nat.prime_two.eq_one_or_self_of_dvd (orderOf σ) hdvd with h | h
    · exact False.elim (hne (orderOf_eq_one_iff.mp h))
    · exact horder.symm.trans h
  · intro htwo hone
    rw [hone, orderOf_one, htwo] at horder
    omega

/-- At an unramified rational prime in a quadratic number field, the arithmetic
Frobenius is nontrivial if and only if the prime above it is the principal ideal
generated by the rational prime. -/
theorem quadratic_frobenius_ne_one_iff_inert (hdegree : Module.finrank ℚ K = 2)
    (p : ℕ) (hp : p.Prime) (Q : Ideal (𝓞 K)) [Q.IsPrime]
    [Q.LiesOver (Ideal.span {(p : ℤ)})] [Algebra.IsUnramifiedAt ℤ Q]
    (σ : K ≃ₐ[ℚ] K) (hσ : IsArithFrobAt ℤ σ Q) :
    σ ≠ 1 ↔ Q = Ideal.span {(p : 𝓞 K)} := by
  let _ : Algebra.IsQuadraticExtension ℚ K := ⟨hdegree⟩
  constructor
  · intro hne
    have hf := (quadratic_frobenius_ne_one_iff hdegree Q σ hσ).mp hne
    have hcard : Nat.card (𝓞 K ⧸ Q) = p ^ 2 := by
      have hn := Ideal.pow_inertiaDeg p Q
      rw [hf] at hn
      simpa only [Ideal.absNorm_apply, Submodule.cardQuot_apply] using hn.symm
    have hpQ : (p : 𝓞 K) ∈ Q := by
      have hmem : (p : ℤ) ∈ Q.under ℤ := by
        rw [← Ideal.over_def Q (Ideal.span {(p : ℤ)})]
        exact Ideal.mem_span_singleton_self _
      simpa only [Ideal.mem_under, map_natCast] using hmem
    let q : HeightOneSpectrum (𝓞 K) := ⟨Q, inferInstance, hσ.ne_bot⟩
    exact inert_prime_eq_span hdegree p hp q hpQ hcard
  · intro hQ hone
    have horder := int_frobenius_order Q σ hσ
    have hf : Q.inertiaDeg ℤ = 1 := by
      simpa only [hone, orderOf_one] using horder.symm
    have hn := Ideal.pow_inertiaDeg p Q
    rw [hf, pow_one, hQ, Ideal.absNorm_span_natCast,
      RingOfIntegers.rank, hdegree, pow_two] at hn
    nlinarith [hp.one_lt]

/-- A ring automorphism of a number field is a rational algebra automorphism. -/
def rationalAutomorphism (κ : K ≃+* K) : K ≃ₐ[ℚ] K :=
  AlgEquiv.ofRingEquiv (f := κ) fun r => by
    rw [eq_ratCast]
    exact map_ratCast κ r

/-- Contracting the prime of a rational Frobenius gives the Frobenius condition
for its actual restriction to the number field. -/
theorem rational_frobenius_contraction
    (e : AlgebraicClosure K ≃ₐ[ℚ] Qbar) (κ : K ≃+* K)
    (g : GalQ) (p : ℕ) [Fact p.Prime]
    (P : Ideal Zbar) [P.IsPrime] (hP : P.under ℤ = Ideal.span {(p : ℤ)})
    (hF : ∀ x y : Zbar, (y : Qbar) = g (x : Qbar) - (x : Qbar) ^ p → y ∈ P)
    (hagree : ∀ x : K, g (e (algebraMap K (AlgebraicClosure K) x)) =
      e (algebraMap K (AlgebraicClosure K) (κ x))) :
    let Q := (P.comap (integersEquiv e)).under (𝓞 K)
    Q.under ℤ = Ideal.span {(p : ℤ)} ∧
      IsArithFrobAt ℤ (rationalAutomorphism κ) Q := by
  let Q := (P.comap (integersEquiv e)).under (𝓞 K)
  have hQ : Q.under ℤ = Ideal.span {(p : ℤ)} := by
    change ((P.comap (integersEquiv e)).under (𝓞 K)).under ℤ = _
    rw [Ideal.under_under]
    calc
      (P.comap (integersEquiv e)).under ℤ = P.under ℤ := by
        ext n
        simp only [Ideal.mem_comap, eq_intCast, map_intCast]
      _ = Ideal.span {(p : ℤ)} := hP
  refine ⟨hQ, ?_⟩
  have hFr := rational_isArithFrobAt g p P hP hF
  intro x
  change rationalAutomorphism κ • x - x ^ Nat.card (ℤ ⧸ Q.under ℤ) ∈ Q
  rw [hQ, ZInQ.Contrib.ChebFD.C10.card_quot]
  change integersEquiv e (algebraMap (𝓞 K) (𝓞 (AlgebraicClosure K))
    (rationalAutomorphism κ • x - x ^ p)) ∈ P
  rw [map_sub, map_pow, map_sub, map_pow]
  have he : integersEquiv e (algebraMap (𝓞 K) (𝓞 (AlgebraicClosure K))
      (rationalAutomorphism κ • x)) =
      g • integersEquiv e (algebraMap (𝓞 K) (𝓞 (AlgebraicClosure K)) x) := by
    apply RingOfIntegers.ext
    change e (algebraMap K (AlgebraicClosure K) (κ (x : K))) =
      g (e (algebraMap K (AlgebraicClosure K) (x : K)))
    exact (hagree (x : K)).symm
  rw [he]
  simpa only [hP, ZInQ.Contrib.ChebFD.C10.card_quot,
    MulSemiringAction.toAlgHom_apply] using
    hFr (integersEquiv e (algebraMap (𝓞 K) (𝓞 (AlgebraicClosure K)) x))

/-- A rational prime unramified in a quadratic number field and having the
nontrivial arithmetic Frobenius is inert, with residue cardinality its square. -/
theorem inert_of_nontrivial_rational_frobenius
    (hdegree : Module.finrank ℚ K = 2)
    (e : AlgebraicClosure K ≃ₐ[ℚ] Qbar) (κ : K ≃+* K)
    (hκ : κ ≠ RingEquiv.refl K)
    (g : GalQ) (p : ℕ) (hp : p.Prime) (hF : IsFrobAt g p)
    (hagree : ∀ x : K, g (e (algebraMap K (AlgebraicClosure K) x)) =
      e (algebraMap K (AlgebraicClosure K) (κ x)))
    (hdisc : ¬ (p : ℤ) ∣ NumberField.discr K) :
    (Ideal.span {(p : 𝓞 K)}).IsPrime ∧
      Nat.card (𝓞 K ⧸ Ideal.span {(p : 𝓞 K)}) = p ^ 2 := by
  let _ : Algebra.IsQuadraticExtension ℚ K := ⟨hdegree⟩
  let _ : Fact p.Prime := ⟨hp⟩
  obtain ⟨P, hP, hPZ, hFr⟩ := hF
  have : P.IsPrime := hP
  let Q := (P.comap (integersEquiv e)).under (𝓞 K)
  have : Q.IsPrime := Ideal.IsPrime.under _ _
  obtain ⟨hQZ, hQF⟩ := rational_frobenius_contraction e κ g p P hPZ hFr hagree
  have hpQ : (p : 𝓞 K) ∈ Q := by
    have hmem : (p : ℤ) ∈ Q.under ℤ := by
      rw [hQZ]
      exact Ideal.mem_span_singleton_self _
    simpa only [Ideal.mem_under, map_natCast] using hmem
  have hQne : Q ≠ ⊥ := by
    intro hbot
    have hpzero : (p : 𝓞 K) = 0 := by simpa [hbot] using hpQ
    exact hp.ne_zero (Nat.cast_eq_zero.mp hpzero)
  have : Algebra.IsUnramifiedAt ℤ Q :=
    (NumberField.not_dvd_discr_iff_forall_mem K (𝓞 K)
      (Nat.prime_iff_prime_int.mp hp)).mp hdisc Q inferInstance (by simpa using hpQ)
  have hne : rationalAutomorphism κ ≠ 1 := by
    intro h
    apply hκ
    exact congrArg AlgEquiv.toRingEquiv h
  have hf : Q.inertiaDeg ℤ = 2 :=
    (quadratic_frobenius_ne_one_iff hdegree Q (rationalAutomorphism κ) hQF).mp hne
  have : Q.LiesOver (Ideal.span {(p : ℤ)}) := ⟨hQZ.symm⟩
  have hcard : Nat.card (𝓞 K ⧸ Q) = p ^ 2 := by
    have hn := Ideal.pow_inertiaDeg p Q
    rw [hf] at hn
    simpa only [Ideal.absNorm_apply, Submodule.cardQuot_apply] using hn.symm
  let q : HeightOneSpectrum (𝓞 K) := ⟨Q, inferInstance, hQne⟩
  have hspan : Q = Ideal.span {(p : 𝓞 K)} :=
    inert_prime_eq_span hdegree p hp q hpQ hcard
  exact ⟨hspan ▸ inferInstance, hspan ▸ hcard⟩

/-- The rational primes to exclude: discriminant divisors and primes below the
specified finite set of places. -/
def badRationalPrimes (S : Set (HeightOneSpectrum (𝓞 K))) (hS : S.Finite) : Finset ℕ :=
  (NumberField.discr K).natAbs.primeFactors ∪
    hS.toFinset.image (fun q => Ideal.absNorm (q.asIdeal.under ℤ))

/-- Avoiding the excluded rational primes guarantees unramifiedness in the number
field, by the discriminant criterion. -/
theorem not_dvd_discr_of_notMem_badRationalPrimes
    (S : Set (HeightOneSpectrum (𝓞 K))) (hS : S.Finite)
    (p : ℕ) (hp : p.Prime) (havoid : p ∉ badRationalPrimes S hS) :
    ¬ (p : ℤ) ∣ NumberField.discr K := by
  intro hdvd
  have hd : p ∣ (NumberField.discr K).natAbs := by
    simpa using (Int.natAbs_dvd_natAbs.mpr hdvd)
  have hzero : (NumberField.discr K).natAbs ≠ 0 :=
    Int.natAbs_ne_zero.mpr (NumberField.discr_ne_zero K)
  exact havoid (Finset.mem_union_left _ (Nat.mem_primeFactors.mpr ⟨hp, hd, hzero⟩))

/-- A prime above a rational prime avoiding the excluded set cannot belong to the
specified finite set of places. -/
theorem prime_notMem_of_notMem_badRationalPrimes
    (S : Set (HeightOneSpectrum (𝓞 K))) (hS : S.Finite)
    (p : ℕ) (hp : p.Prime) (havoid : p ∉ badRationalPrimes S hS)
    (q : HeightOneSpectrum (𝓞 K)) (habove : (p : 𝓞 K) ∈ q.asIdeal) :
    q ∉ S := by
  intro hq
  have : q.asIdeal.LiesOver (Ideal.span {(p : ℤ)}) :=
    (Ideal.liesOver_span_iff q.isPrime.ne_top (Nat.prime_iff_prime_int.mp hp)).mpr
      (by simpa using habove)
  have hunder : q.asIdeal.under ℤ = Ideal.span {(p : ℤ)} :=
    (Ideal.over_def q.asIdeal (Ideal.span {(p : ℤ)})).symm
  have hnorm : Ideal.absNorm (q.asIdeal.under ℤ) = p := by
    rw [hunder, Ideal.absNorm_span_natCast]
    simp
  exact havoid (Finset.mem_union_right _ (Finset.mem_image.mpr
    ⟨q, hS.mem_toFinset.mpr hq, hnorm⟩))

/-- Enlarge each previously chosen exclusion set by the arithmetic exclusions. -/
def safeExclusions (S : Set (HeightOneSpectrum (𝓞 K))) (hS : S.Finite)
    (excl : ℕ → Finset ℕ) : ℕ → Finset ℕ :=
  fun i => excl i ∪ badRationalPrimes S hS

section Selection

open ZInQ.Manuscript.RC.Uniform (Lambda)

variable (S : Set (HeightOneSpectrum (𝓞 K))) (hS : S.Finite)
    (e : AlgebraicClosure K ≃ₐ[ℚ] Qbar)
    (α : GKS K S →* Lambdaˣ) [IsContChar α]
    (E : WeierstrassCurve ℚ) [E.IsElliptic]
    (C : ZInQ.Manuscript.RC.CoefModules.ActualConj K S)
    (H : ∀ i, derivativeKernel S e α E i)
    (F : ℕ → IntermediateField ℚ Qbar) [∀ i, FiniteDimensional ℚ (F i)]
    (excl : ℕ → Finset ℕ)

/-- Kernel membership and Chebotarev agreement force the selected rational
Frobenius to restrict to the actual conjugation on the number field. -/
theorem kernel_selection_agrees (i : ℕ) (x : K) :
    (selectedDerivativePrimes S e α E C (fun j => H j) F excl).frob i
      (e (algebraMap K (AlgebraicClosure K) x)) =
      e (algebraMap K (AlgebraicClosure K) (C.κ x)) := by
  rw [selectedDerivativePrimes_agree_characterField S e α E C (fun j => H j) F excl i _
    (characterField_containsK S e α i x)]
  change tateConjQ e C ((H i : GalQ) (e (algebraMap K (AlgebraicClosure K) x))) = _
  rw [derivativeKernel_fixes_characterField S e α E i (H i) _
    (characterField_containsK S e α i x), tateConjQ_apply_e, C.hτ]

/-- The derivative primes selected with the arithmetic exclusions are inert.
The conclusion is deduced from the actual nontrivial conjugation, not assumed. -/
theorem kernel_selection_inert (hdegree : Module.finrank ℚ K = 2)
    (hκ : C.κ ≠ RingEquiv.refl K) (i : ℕ) :
    let D := selectedDerivativePrimes S e α E C (fun j => H j) F (safeExclusions S hS excl)
    (Ideal.span {(D.ell i : 𝓞 K)}).IsPrime ∧
      Nat.card (𝓞 K ⧸ Ideal.span {(D.ell i : 𝓞 K)}) = D.ell i ^ 2 := by
  let D := selectedDerivativePrimes S e α E C (fun j => H j) F (safeExclusions S hS excl)
  have havoid : D.ell i ∉ badRationalPrimes S hS :=
    fun h => D.avoid i (Finset.mem_union_right (excl i) h)
  exact inert_of_nontrivial_rational_frobenius hdegree e C.κ hκ
    (D.frob i) (D.ell i) (D.prime i) (D.isFrob i)
    (kernel_selection_agrees S e α E C H F (safeExclusions S hS excl) i)
    (not_dvd_discr_of_notMem_badRationalPrimes S hS (D.ell i) (D.prime i) havoid)

/-- The stage prime is the principal prime generated by the selected rational
prime. No prime family or stage-prime property is supplied to this construction. -/
def stagePrimeFamily (hdegree : Module.finrank ℚ K = 2)
    (hκ : C.κ ≠ RingEquiv.refl K) : ℕ → HeightOneSpectrum (𝓞 K) := fun i =>
  let D := selectedDerivativePrimes S e α E C (fun j => H j) F (safeExclusions S hS excl)
  { asIdeal := Ideal.span {(D.ell i : 𝓞 K)}
    isPrime := (kernel_selection_inert S hS e α E C H F excl hdegree hκ i).1
    ne_bot := Ideal.span_singleton_eq_bot.not.mpr
      (Nat.cast_ne_zero.mpr (D.prime i).ne_zero) }

/-- Every constructed stage prime lies outside the specified finite set, lies
above its selected rational prime, has the required residue cardinality, and is
the unique prime of the number field above that rational prime. -/
theorem stagePrimeFamily_spec (hdegree : Module.finrank ℚ K = 2)
    (hκ : C.κ ≠ RingEquiv.refl K) (i : ℕ) :
    let D := selectedDerivativePrimes S e α E C (fun j => H j) F (safeExclusions S hS excl)
    let q := stagePrimeFamily S hS e α E C H F excl hdegree hκ i
    q ∉ S ∧ (D.ell i : 𝓞 K) ∈ q.asIdeal ∧
      Nat.card (𝓞 K ⧸ q.asIdeal) = D.ell i ^ 2 ∧
      ∀ q' : HeightOneSpectrum (𝓞 K), (D.ell i : 𝓞 K) ∈ q'.asIdeal → q' = q := by
  let D := selectedDerivativePrimes S e α E C (fun j => H j) F (safeExclusions S hS excl)
  let q := stagePrimeFamily S hS e α E C H F excl hdegree hκ i
  have habove : (D.ell i : 𝓞 K) ∈ q.asIdeal := Ideal.mem_span_singleton_self _
  have havoid : D.ell i ∉ badRationalPrimes S hS :=
    fun h => D.avoid i (Finset.mem_union_right (excl i) h)
  refine ⟨prime_notMem_of_notMem_badRationalPrimes S hS (D.ell i) (D.prime i) havoid q habove,
    habove, (kernel_selection_inert S hS e α E C H F excl hdegree hκ i).2, ?_⟩
  intro q' hq'
  apply HeightOneSpectrum.ext
  have hle : q.asIdeal ≤ q'.asIdeal := by
    change Ideal.span {(D.ell i : 𝓞 K)} ≤ q'.asIdeal
    rw [Ideal.span_le]
    intro x hx
    obtain rfl := Set.mem_singleton_iff.mp hx
    exact hq'
  exact ((q.isPrime.isMaximal q.ne_bot).eq_of_le q'.isPrime.ne_top hle).symm

variable [HasFullTwoTorsion K S (E⁄K)]

/-- A compatible arithmetic label from the genuine finite-stage kernel elements
in a quadratic number field with nontrivial conjugation. The stage primes,
incidence, residue cardinalities, Frobenius match, and character congruences are
all constructed or proved. -/
def compatibleArithmeticLabelFromStageKernel
    (hdegree : Module.finrank ℚ K = 2) (hκ : C.κ ≠ RingEquiv.refl K) :
    CompatibleArithmeticLabel E K S α :=
  compatibleArithmeticLabelFromKernel S e α E C F (safeExclusions S hS excl) H
    (stagePrimeFamily S hS e α E C H F excl hdegree hκ)
    (fun i => (stagePrimeFamily_spec S hS e α E C H F excl hdegree hκ i).1)
    hdegree
    (fun i => (stagePrimeFamily_spec S hS e α E C H F excl hdegree hκ i).2.1)
    (fun i => (stagePrimeFamily_spec S hS e α E C H F excl hdegree hκ i).2.2.1)

/-- For an imaginary quadratic number field, actual complex conjugation is
necessarily nontrivial on the base field. Thus no separate nontriviality or
stage-prime hypothesis is an input to the compatible-label construction. -/
def compatibleArithmeticLabelFromImaginaryQuadraticKernel [IsTotallyComplex K]
    (hdegree : Module.finrank ℚ K = 2) : CompatibleArithmeticLabel E K S α :=
  compatibleArithmeticLabelFromStageKernel S hS e α E C H F excl hdegree
    (ZInQ.Manuscript.RC.CoefModules.complexConj_restrict_ne_refl
      K C.ι C.τ C.hι C.κ C.hτ)

end Selection

end ZInQ.Contrib.RC53Assist.StagePrimes
