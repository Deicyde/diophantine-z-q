import Mathlib.NumberTheory.Padics.Complex
import Mathlib.RingTheory.RootsOfUnity.AlgebraicallyClosed
import ZInQKernel.Contrib.TauCeti.NumberTheory.Cyclotomic.Adjoin
import ZInQKernel.Contrib.TauCeti.NumberTheory.Cyclotomic.CyclotomicCharacter
import ZInQKernel.Contrib.CloudB3W11TateTrace.AlgebraicTrace

/-!
# The genuine cyclotomic tower and its algebraic normalized traces

The finite level is `K(μ_{p^n})`, formed in the intermediate-field lattice
inside `PadicAlgCl p`; no surrogate Galois action or character is used.
Root-adjoin results are reused from Tau Ceti (Apache-2.0, vendored revision
5a01f5fe3621126cccf9ba22e700493cbc7b7156).

Uniform boundedness of the traces on the infinite tower is NOT proved here.
-/

noncomputable section

set_option linter.style.haveILetI false

namespace ZInQ.Contrib.CloudB3W11TateTrace

open IntermediateField

variable (p : ℕ) [Fact p.Prime]

/-- The field generated by all `p^n`-th roots of unity. -/
def rootField (n : ℕ) : IntermediateField ℚ_[p] (PadicAlgCl p) :=
  IntermediateField.adjoin ℚ_[p] {ζ : PadicAlgCl p | ζ ^ p ^ n = 1}

/-- The actual finite cyclotomic level over `K`. -/
def cyclotomicLevel (K : IntermediateField ℚ_[p] (PadicAlgCl p)) (n : ℕ) :
    IntermediateField ℚ_[p] (PadicAlgCl p) := K ⊔ rootField p n

/-- The actual algebraic cyclotomic tower `K(μ_{p^∞})`. -/
def cyclotomicTower (K : IntermediateField ℚ_[p] (PadicAlgCl p)) :
    IntermediateField ℚ_[p] (PadicAlgCl p) := ⨆ n : ℕ, cyclotomicLevel p K n

theorem rootField_mono : Monotone (rootField p) := by
  intro n m hnm
  apply IntermediateField.adjoin_le_iff.mpr
  intro ζ hζ
  obtain ⟨d, hd⟩ := Nat.pow_dvd_pow p hnm
  apply IntermediateField.subset_adjoin
  change ζ ^ p ^ m = 1
  rw [hd, pow_mul, hζ, one_pow]

theorem cyclotomicLevel_mono (K : IntermediateField ℚ_[p] (PadicAlgCl p)) :
    Monotone (cyclotomicLevel p K) :=
  fun _ _ h => sup_le_sup le_rfl (rootField_mono p h)

instance rootField_finiteDimensional (n : ℕ) : FiniteDimensional ℚ_[p] (rootField p n) := by
  obtain ⟨ζ, hζ⟩ := HasEnoughRootsOfUnity.exists_isPrimitiveRoot (PadicAlgCl p) (p ^ n)
  letI : IsCyclotomicExtension {p ^ n} ℚ_[p] (rootField p n) :=
    hζ.isCyclotomicExtension_adjoin_nth_roots
  exact IsCyclotomicExtension.finiteDimensional {p ^ n} ℚ_[p] (rootField p n)

instance cyclotomicLevel_finiteDimensional (K : IntermediateField ℚ_[p] (PadicAlgCl p))
    [FiniteDimensional ℚ_[p] K] (n : ℕ) : FiniteDimensional ℚ_[p] (cyclotomicLevel p K n) :=
  IntermediateField.finiteDimensional_sup K (rootField p n)

theorem le_cyclotomicLevel (K : IntermediateField ℚ_[p] (PadicAlgCl p)) (n : ℕ) :
    K ≤ cyclotomicLevel p K n := le_sup_left

theorem cyclotomicLevel_le_tower (K : IntermediateField ℚ_[p] (PadicAlgCl p)) (n : ℕ) :
    cyclotomicLevel p K n ≤ cyclotomicTower p K := le_iSup _ n

/-- Every algebraic point of the tower lies at a finite level. -/
theorem mem_cyclotomicTower_iff (K : IntermediateField ℚ_[p] (PadicAlgCl p))
    (x : PadicAlgCl p) : x ∈ cyclotomicTower p K ↔ ∃ n : ℕ, x ∈ cyclotomicLevel p K n := by
  change x ∈ (↑(⨆ n, cyclotomicLevel p K n) : Set (PadicAlgCl p)) ↔ _
  rw [IntermediateField.coe_iSup_of_directed (cyclotomicLevel_mono p K).directed_le]
  exact Set.mem_iUnion

/-- The tower is also the field generated over `K` by all `p`-power roots. -/
theorem cyclotomicTower_eq (K : IntermediateField ℚ_[p] (PadicAlgCl p)) :
    cyclotomicTower p K = K ⊔
      IntermediateField.adjoin ℚ_[p] {ζ : PadicAlgCl p | ∃ n : ℕ, ζ ^ p ^ n = 1} := by
  apply le_antisymm
  · apply iSup_le
    intro n
    apply sup_le_sup_left
    exact IntermediateField.adjoin.mono _ _ _ (fun ζ hζ => ⟨n, hζ⟩)
  · apply sup_le
    · exact (le_cyclotomicLevel p K 0).trans (cyclotomicLevel_le_tower p K 0)
    · apply IntermediateField.adjoin_le_iff.mpr
      rintro ζ ⟨n, hζ⟩
      exact cyclotomicLevel_le_tower p K n
        ((le_sup_right : rootField p n ≤ cyclotomicLevel p K n)
          (IntermediateField.subset_adjoin ℚ_[p] _ hζ))

/-- Identification of the cyclotomic kernel, using Tau Ceti's proved theorem. -/
theorem mem_fixingSubgroup_tower_iff (K : IntermediateField ℚ_[p] (PadicAlgCl p))
    (σ : PadicAlgCl p ≃ₐ[ℚ_[p]] PadicAlgCl p) :
    σ ∈ (cyclotomicTower p K).fixingSubgroup ↔
      σ ∈ K.fixingSubgroup ∧ cyclotomicCharacter (PadicAlgCl p) p σ.toRingEquiv = 1 := by
  rw [cyclotomicTower_eq, IntermediateField.fixingSubgroup_sup]
  exact and_congr_right fun _ =>
    TauCeti.mem_fixingSubgroup_adjoin_iff_cyclotomicCharacter_eq_one p

/-- Every automorphism fixing `K` preserves each finite cyclotomic level. -/
theorem cyclotomicLevel_stable (K : IntermediateField ℚ_[p] (PadicAlgCl p)) (n : ℕ)
    (σ : PadicAlgCl p ≃ₐ[ℚ_[p]] PadicAlgCl p) (hσ : σ ∈ K.fixingSubgroup)
    {x : PadicAlgCl p} (hx : x ∈ cyclotomicLevel p K n) :
    σ x ∈ cyclotomicLevel p K n := by
  have hle : cyclotomicLevel p K n ≤ (cyclotomicLevel p K n).comap σ.toAlgHom := by
    apply sup_le
    · intro y hy
      change σ y ∈ cyclotomicLevel p K n
      rw [(IntermediateField.mem_fixingSubgroup_iff K σ).mp hσ y hy]
      exact (le_sup_left : K ≤ cyclotomicLevel p K n) hy
    · apply IntermediateField.adjoin_le_iff.mpr
      intro ζ hζ
      change σ ζ ∈ cyclotomicLevel p K n
      apply (le_sup_right : rootField p n ≤ cyclotomicLevel p K n)
      apply IntermediateField.subset_adjoin
      change (σ ζ) ^ p ^ n = 1
      rw [← map_pow, hζ, map_one]
  exact hle hx

/-- Every automorphism fixing `K` preserves the algebraic cyclotomic tower. -/
theorem cyclotomicTower_stable (K : IntermediateField ℚ_[p] (PadicAlgCl p))
    (σ : PadicAlgCl p ≃ₐ[ℚ_[p]] PadicAlgCl p) (hσ : σ ∈ K.fixingSubgroup)
    {x : PadicAlgCl p} (hx : x ∈ cyclotomicTower p K) : σ x ∈ cyclotomicTower p K := by
  obtain ⟨n, hn⟩ := (mem_cyclotomicTower_iff p K x).mp hx
  exact (mem_cyclotomicTower_iff p K (σ x)).mpr
    ⟨n, cyclotomicLevel_stable p K n σ hσ hn⟩

/-- Restriction of an automorphism fixing `K` to its stable finite level. -/
def levelAutomorphism (K : IntermediateField ℚ_[p] (PadicAlgCl p)) (n : ℕ)
    (σ : PadicAlgCl p ≃ₐ[ℚ_[p]] PadicAlgCl p) (hσ : σ ∈ K.fixingSubgroup) :
    cyclotomicLevel p K n ≃ₐ[ℚ_[p]] cyclotomicLevel p K n where
  toFun x := ⟨σ x, cyclotomicLevel_stable p K n σ hσ x.property⟩
  invFun x := ⟨σ.symm x,
    cyclotomicLevel_stable p K n σ.symm (K.fixingSubgroup.inv_mem hσ) x.property⟩
  left_inv x := Subtype.ext (σ.symm_apply_apply x)
  right_inv x := Subtype.ext (σ.apply_symm_apply x)
  map_mul' x y := Subtype.ext (map_mul σ (x : PadicAlgCl p) (y : PadicAlgCl p))
  map_add' x y := Subtype.ext (map_add σ (x : PadicAlgCl p) (y : PadicAlgCl p))
  commutes' c := Subtype.ext (σ.commutes c)

/-- The genuine normalized trace to `K(μ_{p^n})`, embedded in the algebraic closure. -/
def levelTrace (K : IntermediateField ℚ_[p] (PadicAlgCl p)) (n : ℕ) :
    PadicAlgCl p →ₗ[ℚ_[p]] PadicAlgCl p :=
  traceRetraction ℚ_[p] (PadicAlgCl p) (cyclotomicLevel p K n)

theorem levelTrace_mem (K : IntermediateField ℚ_[p] (PadicAlgCl p)) (n : ℕ)
    (x : PadicAlgCl p) : levelTrace p K n x ∈ cyclotomicLevel p K n :=
  traceRetraction_mem ℚ_[p] (PadicAlgCl p) _ x

theorem levelTrace_of_mem (K : IntermediateField ℚ_[p] (PadicAlgCl p)) (n : ℕ)
    {x : PadicAlgCl p} (hx : x ∈ cyclotomicLevel p K n) : levelTrace p K n x = x :=
  traceRetraction_of_mem ℚ_[p] (PadicAlgCl p) _ hx

/-- Exact Galois equivariance of algebraic normalized trace. -/
theorem levelTrace_equivariant (K : IntermediateField ℚ_[p] (PadicAlgCl p)) (n : ℕ)
    (σ : PadicAlgCl p ≃ₐ[ℚ_[p]] PadicAlgCl p) (hσ : σ ∈ K.fixingSubgroup)
    (x : PadicAlgCl p) : levelTrace p K n (σ x) = σ (levelTrace p K n x) :=
  traceRetraction_equivariant ℚ_[p] (PadicAlgCl p) _ σ
    (levelAutomorphism p K n σ hσ) (fun _ => rfl) x

/-- The projections commute and their composition is the lower projection. -/
theorem levelTrace_comp (K : IntermediateField ℚ_[p] (PadicAlgCl p)) {n m : ℕ}
    (h : n ≤ m) (x : PadicAlgCl p) :
    levelTrace p K n (levelTrace p K m x) = levelTrace p K n x :=
  traceRetraction_comp_of_le ℚ_[p] (PadicAlgCl p) _ _ (cyclotomicLevel_mono p K h) x

/-- On each algebraic point of the tower, the projections eventually equal the identity.
Passing this to the completion requires a UNIFORM bound; it is not a density
argument about invariant algebraic points. -/
theorem levelTrace_eventually_eq (K : IntermediateField ℚ_[p] (PadicAlgCl p))
    {x : PadicAlgCl p} (hx : x ∈ cyclotomicTower p K) :
    ∃ N : ℕ, ∀ n : ℕ, N ≤ n → levelTrace p K n x = x := by
  obtain ⟨N, hN⟩ := (mem_cyclotomicTower_iff p K x).mp hx
  exact ⟨N, fun n hn => levelTrace_of_mem p K n (cyclotomicLevel_mono p K hn hN)⟩

end ZInQ.Contrib.CloudB3W11TateTrace
