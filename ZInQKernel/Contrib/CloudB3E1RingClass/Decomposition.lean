import ZInQKernel.Contrib.CloudB3E1RingClass.Frobenius

/-!
# Stage 3 of the ring-class realization: inertia and decomposition groups of `H_f/K` away from `f`

Manuscript `diophantine_zq.tex`, tex 3681–3682 ("`H_r/K` is unramified outside `r`, so the
decomposition group of `𝔭_j` is generated by its Frobenius", [Cox, §9.A]).

At a place `v` of `K` not over `f`, with ideal `J = v`:
* `locGal_eq_one_of_mem_inertia`: the inertia subgroup `I_{K_v}` dies in `Gal(H_f/K)`. Its local
  Artin classes are those of units (Tau Ceti, `map_artinMap_unitFiltration_zero`), whose global
  Artin symbols are trivial at an unramified place. `inertiaGal_eq_bot`.
* `locGal_frobeniusLift`: EVERY arithmetic Frobenius lift `φ ∈ G_{K_v}` restricts to the Artin
  class of `J`, since two lifts differ by inertia.
* `decompGal_eq_zpowers`: the decomposition group `decompGal v` (the image of `G_{K_v}`) is the
  cyclic group generated by the Artin class of `J`. The preimage of `⟨Art(J)⟩` is an open subgroup
  of `G_{K_v}` containing a Frobenius lift and inertia, and these generate `G_{K_v}` topologically
  (`topologicalClosure_zpowers_sup_inertiaSubgroup`).

* `artinClass_mul_eq_one`: if `J J' = (p)` for an integer `p` (`𝔭 𝔭̄ = (p)`), the Artin classes
  of `J` and `J'` are inverse (tex 3683–3684, the interface's `qbar_eq`).
* `decomp_eq_zmultiples_of_identification`: for an interface identified with the genuine objects,
  the interface field `decomp_eq` (`decomp r j = ⟨q r j⟩`) holds at the active `𝔭_j`.

Kinds: PROVED.
-/

noncomputable section

namespace ZInQ.Contrib.CloudB3E1RingClass

open NumberField IsDedekindDomain
open TauCeti TauCeti.GlobalNumberFields TauCeti.GlobalNumberFields.NumberFieldOrder
  TauCeti.ClassFieldTheory
open ZInQ.Manuscript.RC.SelmerComplex
open ZInQ.Manuscript.RC.CoefModules (KS)

variable {K : Type} [Field K] [NumberField K]
variable (f : ℕ) (hf : f ≠ 0) (S : Set (HeightOneSpectrum (𝓞 K)))
  (hS : ∀ v : HeightOneSpectrum (𝓞 K), (f : 𝓞 K) ∈ v.asIdeal → v ∈ S)

/-- **Inertia away from `f` dies in `Gal(H_f/K)`** (tex 3681–3682). Kind: PROVED. -/
theorem locGal_eq_one_of_mem_inertia (v : HeightOneSpectrum (𝓞 K))
    (hvf : (f : 𝓞 K) ∉ v.asIdeal) {σ : Gloc K v}
    (hσ : σ ∈ TauCeti.inertiaSubgroup (v.adicCompletion K)) :
    locGal f hf S hS v σ = 1 := by
  classical
  have hmem : (QuotientGroup.mk σ : Field.absoluteGaloisGroupAbelianization (v.adicCompletion K)) ∈
      (unitFiltration (v.adicCompletion K) 0).map (artinMap (v.adicCompletion K)) := by
    rw [map_artinMap_unitFiltration_zero]
    exact ⟨σ, hσ, rfl⟩
  obtain ⟨u, hu, hu'⟩ := hmem
  have h1 : localArtinAt K (ringClassField (ringClassOrder (K := K) f hf)) v u =
      Abelianization.of (AlgEquiv.autCongr (ringClassFieldOfEquiv f hf S hS)
        (locGal f hf S hS v σ)) :=
    localArtinAt_eq_of_mk_eq_artinMap v σ hu'.symm (ringClassEmb f hf S hS v) _
      (ringClassEmb_locGal f hf S hS v σ)
  have hvc : ¬ v.asIdeal ∣ (ringClassOrder (K := K) f hf).conductor := fun hd =>
    hvf (mem_of_dvd_conductor_ringClassOrder f hf v hd)
  obtain ⟨Q, _, _⟩ := (inferInstance :
    Nonempty (v.asIdeal.primesOver (𝓞 (ringClassField (ringClassOrder (K := K) f hf)))))
  have : Algebra.IsUnramifiedAt (𝓞 K) Q :=
    isUnramifiedAt_ringClassField (ringClassOrder (K := K) f hf) hvc Q
  obtain ⟨τ₀, hτ₀⟩ := NumberField.exists_isArithFrobAt K Q
    (Ideal.ne_bot_of_liesOver_of_ne_bot v.ne_bot Q)
  have h2 := globalArtinMap_ofAdicCompletion_eq_of_isArithFrobAt
    (ringClassField (ringClassOrder (K := K) f hf))
    (ringClassField (ringClassOrder (K := K) f hf)).val v Q hτ₀ u
  rw [(normalizedValuation_eq_one_iff u).2 ((mem_unitFiltration_zero u).mp hu), toAdd_one,
    zpow_zero, IdeleClassGroup.ofAdicCompletion_apply, globalArtinMap_local, h1,
    ← map_one Abelianization.of] at h2
  have h3 := Abelianization.of_injective (Additive.ofMul.injective h2)
  exact (map_eq_one_iff _ (AlgEquiv.autCongr (ringClassFieldOfEquiv f hf S hS)).injective).mp h3

/-- **The genuine inertia group away from `f` is trivial.** Kind: PROVED. -/
theorem inertiaGal_eq_bot (v : HeightOneSpectrum (𝓞 K)) (hvf : (f : 𝓞 K) ∉ v.asIdeal) :
    inertiaGal f hf S hS v = ⊥ := by
  rw [eq_bot_iff]
  rintro _ ⟨σ, hσ, rfl⟩
  exact (locGal_eq_one_of_mem_inertia f hf S hS v hvf hσ)

/-- **Every arithmetic Frobenius lift at `v` restricts to the Artin class of `v`** (tex 3575–3576,
3681–3682). Kind: PROVED. -/
theorem locGal_frobeniusLift (v : HeightOneSpectrum (𝓞 K)) (hvf : (f : 𝓞 K) ∉ v.asIdeal)
    (J : integralIdealsPrimeTo (ringClassOrder (K := K) f hf).conductorModulus)
    (hJ : (J : Ideal (𝓞 K)) = v.asIdeal) {φ : Gloc K v}
    (hφ : TauCeti.IsArithFrobeniusLift (v.adicCompletion K) φ) :
    locGal f hf S hS v φ = artinClass f hf S hS J := by
  obtain ⟨τ, hτ, hτJ⟩ := exists_frobeniusLift_locGal f hf S hS v hvf J hJ
  have hmem := (hτ.isArithFrobeniusLift_iff_inv_mul_mem).mp hφ
  have h1 := locGal_eq_one_of_mem_inertia f hf S hS v hvf hmem
  rw [map_mul, map_inv, inv_mul_eq_one] at h1
  rw [← h1, hτJ]

/-- **The decomposition group away from `f` is generated by the Artin class** (tex 3681–3682,
[Cox, §9.A]). Kind: PROVED. -/
theorem decompGal_eq_zpowers (v : HeightOneSpectrum (𝓞 K)) (hvf : (f : 𝓞 K) ∉ v.asIdeal)
    (J : integralIdealsPrimeTo (ringClassOrder (K := K) f hf).conductorModulus)
    (hJ : (J : Ideal (𝓞 K)) = v.asIdeal) :
    decompGal f hf S hS v = Subgroup.zpowers (artinClass f hf S hS J) := by
  obtain ⟨φ, hφ, hφJ⟩ := exists_frobeniusLift_locGal f hf S hS v hvf J hJ
  refine le_antisymm ?_ ?_
  · -- the preimage of `⟨Art(J)⟩` is an open subgroup containing `φ` and inertia
    set A := (Subgroup.zpowers (artinClass f hf S hS J)).comap (locGal f hf S hS v)
    have hker : (ZInQ.Manuscript.RC.CoefModules.fixS K S (ringClassFieldOf f hf S hS)).comap
        (locMap K S v).toMonoidHom ≤ A := by
      intro σ hσ
      have h1 : ringClassRes f hf S hS (locMap K S v σ) = 1 := by
        apply AlgEquiv.ext
        intro x
        apply Subtype.ext
        have hx := hσ ⟨x, x.2⟩
        have h := AlgEquiv.restrictNormal_commutes
          (show KS K S ≃ₐ[K] KS K S from locMap K S v σ) (ringClassFieldOf f hf S hS) x
        exact h.trans hx
      simp only [A, Subgroup.mem_comap]
      rw [show locGal f hf S hS v σ = 1 from h1]
      exact one_mem _
    have hopen : IsOpen (A : Set (Gloc K v)) := by
      refine Subgroup.isOpen_mono hker ?_
      exact (ZInQ.Manuscript.RC.CoefModules.isOpen_fixS K S _).preimage (locMap K S v).continuous
    have hclosed : IsClosed (A : Set (Gloc K v)) := Subgroup.isClosed_of_isOpen A hopen
    have hle : Subgroup.zpowers φ ⊔ TauCeti.inertiaSubgroup (v.adicCompletion K) ≤ A := by
      refine sup_le ?_ ?_
      · rw [Subgroup.zpowers_le]
        simp only [A, Subgroup.mem_comap]
        rw [hφJ]
        exact Subgroup.mem_zpowers _
      · intro σ hσ
        simp only [A, Subgroup.mem_comap]
        rw [locGal_eq_one_of_mem_inertia f hf S hS v hvf hσ]
        exact one_mem _
    have htop : A = ⊤ := by
      rw [eq_top_iff, ← hφ.topologicalClosure_zpowers_sup_inertiaSubgroup]
      exact Subgroup.topologicalClosure_minimal _ hle hclosed
    rintro _ ⟨σ, rfl⟩
    have : σ ∈ A := htop ▸ Subgroup.mem_top σ
    exact this
  · rw [Subgroup.zpowers_le, ← hφJ]
    exact ⟨φ, rfl⟩

/-- **Conjugate Artin classes are inverse** (tex 3683–3684: "`𝔭_j 𝔭̄_j = (p)` is rational
principal, so `qbar = −q`"): if `J J' = (p)` for an integer `p`, the Artin classes of `J` and `J'`
multiply to one, since `(p)` is generated by an element of `ℤ + f𝒪_K`. Kind: PROVED. -/
theorem artinClass_mul_eq_one
    (J J' : integralIdealsPrimeTo (ringClassOrder (K := K) f hf).conductorModulus) (p : ℤ)
    (hJJ' : (J : Ideal (𝓞 K)) * (J' : Ideal (𝓞 K)) = Ideal.span {(p : 𝓞 K)}) :
    artinClass f hf S hS J * artinClass f hf S hS J' = 1 := by
  rw [artinClass, artinClass, ← map_mul, ← map_mul]
  have h1 : (ringClassOrder (K := K) f hf).picClass (J * J') = 1 :=
    ((ringClassOrder (K := K) f hf).picClass_eq_one_iff (J * J')).mpr
      ⟨(p : 𝓞 K), Subalgebra.intCast_mem _ p, hJJ'⟩
  rw [h1, map_one]

open ZInQ.Manuscript.RC.Moving in
/-- **The interface's `decomp_eq` for genuine data** (tex 3681–3682): for an interface identified
with the genuine objects of `H_r`, the decomposition group at an active `𝔭_j` is generated by
`q r j`. Kind: PROVED. -/
theorem decomp_eq_zmultiples_of_identification {T : TateImage} {n : ℕ} {M : MovingSetting T n}
    {r : ℕ} {hr : r ≠ 0} {S : Set (HeightOneSpectrum (𝓞 K))}
    {hS : ∀ v : HeightOneSpectrum (𝓞 K), (r : 𝓞 K) ∈ v.asIdeal → v ∈ S}
    {P : Set (HeightOneSpectrum (𝓞 K))} (I : RingClassIdentification M r hr S hS P)
    (j : Fin M.s) (hj : M.act j) :
    M.decomp r j = AddSubgroup.zmultiples (M.q r j) := by
  ext z
  rw [I.decomp_eq j z, decompGal_eq_zpowers r hr S hS (I.place j) (I.place_not_over j hj)
    (I.ideal j hj) (I.ideal_eq j hj), ← I.q_eq j hj, Subgroup.mem_zpowers_iff,
    AddSubgroup.mem_zmultiples_iff]
  constructor
  · rintro ⟨k, hk⟩
    refine ⟨k, I.e.injective (Additive.toMul.injective ?_)⟩
    rw [map_zsmul, toMul_zsmul, hk]
  · rintro ⟨k, rfl⟩
    exact ⟨k, by rw [map_zsmul, toMul_zsmul]⟩

end ZInQ.Contrib.CloudB3E1RingClass
