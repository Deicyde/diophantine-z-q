import ZInQKernel.Contrib.GZTheta.Eta
import Mathlib.GroupTheory.Schreier
import Mathlib.LinearAlgebra.Matrix.FixedDetMatrices
import Mathlib.NumberTheory.ModularForms.CongruenceSubgroups

/-!
# gz-theta: `η(4τ)² η(8τ)²` is invariant under `Γ₀(32)` in weight 2

For `γ = (a b; c d) ∈ Γ₀(32)`, `4 γτ = γ'(4τ)` and `8 γτ = γ''(8τ)` with
`γ' = (a, 4b; c/4, d)`, `γ'' = (a, 8b; c/8, d) ∈ SL(2, ℤ)`. By `eta_sq_mobius`,

  `f(γτ) = ζ^{E(γ)} (cτ + d)² f(τ)`,  `f(τ) = η(4τ)² η(8τ)²`,

with an explicit integer `E(γ)` (`expE`). `E(γ) ≡ 0 (mod 12)` on all of `Γ₀(32)` is proved by
Schreier's lemma: `Γ₀(32)` is generated by the 96 elements `r s ρ(r s)⁻¹` (`r` in an explicit
transversal of 48 cosets, `s ∈ {S, T}`, `ρ` the coset representative), and `E ≡ 0 (mod 12)` on
these is checked by `decide`.
-/

open Complex ModularForm Matrix.SpecialLinearGroup CongruenceSubgroup
open UpperHalfPlane hiding I
open scoped Real MatrixGroups

noncomputable section

namespace ZInQ.GZTheta

/-- **The eta quotient** `η(4τ)² η(8τ)²` (the newform of conductor 32, STANDARD). -/
def etaQuot32 (τ : ℍ) : ℂ := η (4 * (τ : ℂ)) ^ 2 * η (8 * (τ : ℂ)) ^ 2

/-- The exponent of the multiplier of `etaQuot32` at `(a b; c d)`, `32 ∣ c`. -/
def expE (a b c d : ℤ) : ℤ :=
  etaSqExp (c / 4).natAbs a (4 * b) (c / 4) d + etaSqExp (c / 8).natAbs a (8 * b) (c / 8) d

theorem coe_smul_SL (γ : SL(2, ℤ)) (τ : ℍ) :
    ((γ • τ : ℍ) : ℂ) = ((γ 0 0 : ℂ) * τ + γ 0 1) / ((γ 1 0 : ℂ) * τ + γ 1 1) := by
  rw [coe_specialLinearGroup_apply]
  simp

theorem det_SL (γ : SL(2, ℤ)) : γ 0 0 * γ 1 1 - γ 0 1 * γ 1 0 = 1 := by
  have := γ.2
  rw [Matrix.det_fin_two] at this
  exact this

theorem etaQuot32_smul (γ : SL(2, ℤ)) (hγ : (32 : ℤ) ∣ γ 1 0) (τ : ℍ) :
    etaQuot32 (γ • τ) = zeta12 ^ expE (γ 0 0) (γ 0 1) (γ 1 0) (γ 1 1) *
      ((γ 1 0 : ℂ) * τ + γ 1 1) ^ 2 * etaQuot32 τ := by
  obtain ⟨k, hk⟩ := hγ
  set a := γ 0 0
  set b := γ 0 1
  set c := γ 1 0
  set d := γ 1 1
  have hdet : a * d - b * c = 1 := det_SL γ
  have hc4 : c / 4 = 8 * k := by rw [hk]; omega
  have hc8 : c / 8 = 4 * k := by rw [hk]; omega
  have hτ : 0 < (τ : ℂ).im := τ.im_pos
  have hD : (c : ℂ) * τ + d ≠ 0 := mobius_denom_ne_zero hdet hτ
  have h4 : 0 < (4 * (τ : ℂ)).im := by simp; exact τ.im_pos
  have h8 : 0 < (8 * (τ : ℂ)).im := by simp; exact τ.im_pos
  have e4 := eta_sq_mobius (8 * k).natAbs a (4 * b) (8 * k) d le_rfl
    (by rw [hk] at hdet; linear_combination hdet) (4 * (τ : ℂ)) h4
  have e8 := eta_sq_mobius (4 * k).natAbs a (8 * b) (4 * k) d le_rfl
    (by rw [hk] at hdet; linear_combination hdet) (8 * (τ : ℂ)) h8
  have hc : (c : ℂ) = 32 * k := by rw [hk]; push_cast; ring
  have m4 : 4 * ((γ • τ : ℍ) : ℂ) = ((a : ℂ) * (4 * τ) + ((4 * b : ℤ) : ℂ)) /
      (((8 * k : ℤ) : ℂ) * (4 * τ) + d) := by
    rw [coe_smul_SL]
    have : ((8 * k : ℤ) : ℂ) * (4 * τ) + d = (c : ℂ) * τ + d := by rw [hc]; push_cast; ring
    rw [this]
    field_simp
    push_cast
    ring
  have m8 : 8 * ((γ • τ : ℍ) : ℂ) = ((a : ℂ) * (8 * τ) + ((8 * b : ℤ) : ℂ)) /
      (((4 * k : ℤ) : ℂ) * (8 * τ) + d) := by
    rw [coe_smul_SL]
    have : ((4 * k : ℤ) : ℂ) * (8 * τ) + d = (c : ℂ) * τ + d := by rw [hc]; push_cast; ring
    rw [this]
    field_simp
    push_cast
    ring
  have d4 : ((8 * k : ℤ) : ℂ) * (4 * τ) + d = (c : ℂ) * τ + d := by rw [hc]; push_cast; ring
  have d8 : ((4 * k : ℤ) : ℂ) * (8 * τ) + d = (c : ℂ) * τ + d := by rw [hc]; push_cast; ring
  unfold etaQuot32
  rw [m4, m8, e4, e8, d4, d8, expE, hc4, hc8, zpow_add₀ zeta12_ne_zero]
  ring

theorem etaQuot32_slash (γ : SL(2, ℤ)) (hγ : (32 : ℤ) ∣ γ 1 0) :
    etaQuot32 ∣[(2 : ℤ)] γ = zeta12 ^ expE (γ 0 0) (γ 0 1) (γ 1 0) (γ 1 1) • etaQuot32 := by
  ext τ
  rw [SL_slash_apply, etaQuot32_smul γ hγ τ]
  have hD : (γ 1 0 : ℂ) * τ + γ 1 1 ≠ 0 := mobius_denom_ne_zero (det_SL γ) τ.im_pos
  have hden : denom γ τ = (γ 1 0 : ℂ) * τ + γ 1 1 := by
    simp [ModularGroup.denom_apply]
  rw [hden, Pi.smul_apply, smul_eq_mul, zpow_neg, zpow_two]
  field_simp


/-! ### Integer quadruples -/

/-- Matrices `(a b; c d)` as quadruples, for kernel computation. -/
abbrev Q4 := ℤ × ℤ × ℤ × ℤ

def toQ (g : SL(2, ℤ)) : Q4 := (g 0 0, g 0 1, g 1 0, g 1 1)

def qmul : Q4 → Q4 → Q4
  | (a, b, c, d), (a', b', c', d') =>
    (a * a' + b * c', a * b' + b * d', c * a' + d * c', c * b' + d * d')

def qinv : Q4 → Q4
  | (a, b, c, d) => (d, -b, -c, a)

theorem toQ_mul (g h : SL(2, ℤ)) : toQ (g * h) = qmul (toQ g) (toQ h) := by
  simp [toQ, qmul, Matrix.mul_apply, Fin.sum_univ_two]

theorem toQ_inv (g : SL(2, ℤ)) : toQ g⁻¹ = qinv (toQ g) := by
  simp [toQ, qinv, Matrix.SpecialLinearGroup.coe_inv, Matrix.adjugate_fin_two]

/-! ### A transversal of `Γ₀(32)` in `SL(2, ℤ)` -/

/-- `(1 0; x 1)`, for the cosets with bottom row `(x : 1)`. -/
def rA (x : Fin 32) : SL(2, ℤ) := ⟨!![1, 0; (x : ℤ), 1], by simp [Matrix.det_fin_two_of]⟩

/-- `(0 −1; 1 2j)`, for the cosets with bottom row `(1 : 2j)`. -/
def rB (j : Fin 16) : SL(2, ℤ) := ⟨!![0, -1; 1, 2 * (j : ℤ)], by simp [Matrix.det_fin_two_of]⟩

/-- The 48 coset representatives. -/
def R32 : Set SL(2, ℤ) := Set.range rA ∪ Set.range rB

theorem toQ_rA (x : Fin 32) : toQ (rA x) = (1, 0, (x : ℤ), 1) := by simp [toQ, rA]

theorem toQ_rB (j : Fin 16) : toQ (rB j) = (0, -1, 1, 2 * (j : ℤ)) := by simp [toQ, rB]

def repIdxA (c d : ℤ) : ℤ := c * d ^ 7 % 32

def repIdxB (c d : ℤ) : ℤ := d * c ^ 7 % 32 / 2

theorem repIdxA_lt (c d : ℤ) : (repIdxA c d).toNat < 32 := by
  have h0 := Int.emod_nonneg (c * d ^ 7) (by norm_num : (32 : ℤ) ≠ 0)
  have h1 := Int.emod_lt_of_pos (c * d ^ 7) (by norm_num : (0 : ℤ) < 32)
  unfold repIdxA; omega

theorem repIdxB_lt (c d : ℤ) : (repIdxB c d).toNat < 16 := by
  have h0 := Int.emod_nonneg (d * c ^ 7) (by norm_num : (32 : ℤ) ≠ 0)
  have h1 := Int.emod_lt_of_pos (d * c ^ 7) (by norm_num : (0 : ℤ) < 32)
  unfold repIdxB; omega

/-- The representative of the coset `Γ₀(32) g`. -/
def repSL (g : SL(2, ℤ)) : SL(2, ℤ) :=
  if g 1 1 % 2 = 1 then rA ⟨(repIdxA (g 1 0) (g 1 1)).toNat, repIdxA_lt _ _⟩
  else rB ⟨(repIdxB (g 1 0) (g 1 1)).toNat, repIdxB_lt _ _⟩

def qrep (x : Q4) : Q4 :=
  if x.2.2.2 % 2 = 1 then (1, 0, repIdxA x.2.2.1 x.2.2.2, 1)
  else (0, -1, 1, 2 * repIdxB x.2.2.1 x.2.2.2)

theorem toQ_repSL (g : SL(2, ℤ)) : toQ (repSL g) = qrep (toQ g) := by
  have e1 : (toQ g).2.2.1 = g 1 0 := rfl
  have e2 : (toQ g).2.2.2 = g 1 1 := rfl
  unfold qrep
  rw [e1, e2]
  unfold repSL
  by_cases h : g 1 1 % 2 = 1
  · rw [if_pos h, if_pos h, toQ_rA]
    have h0 := Int.emod_nonneg (g 1 0 * g 1 1 ^ 7) (by norm_num : (32 : ℤ) ≠ 0)
    rw [Int.toNat_of_nonneg (by unfold repIdxA; exact h0)]
  · rw [if_neg h, if_neg h, toQ_rB]
    have h0 := Int.emod_nonneg (g 1 1 * g 1 0 ^ 7) (by norm_num : (32 : ℤ) ≠ 0)
    rw [Int.toNat_of_nonneg (by unfold repIdxB; omega)]

theorem repSL_mem (g : SL(2, ℤ)) : repSL g ∈ R32 := by
  unfold repSL R32
  split_ifs
  · exact Or.inl ⟨_, rfl⟩
  · exact Or.inr ⟨_, rfl⟩

theorem dvd_pow_eight_sub_one {d : ℤ} (hd : d % 2 = 1) : (32 : ℤ) ∣ d ^ 8 - 1 := by
  have h1 : d ≡ d % 32 [ZMOD 32] := (Int.mod_modEq d 32).symm
  have h2 := (h1.pow 8).sub_right 1
  rw [Int.dvd_iff_emod_eq_zero, h2]
  have hr0 : 0 ≤ d % 32 := Int.emod_nonneg _ (by norm_num)
  have hr1 : d % 32 < 32 := Int.emod_lt_of_pos _ (by norm_num)
  have hodd : (d % 32) % 2 = 1 := by omega
  generalize d % 32 = r at hr0 hr1 hodd
  interval_cases r <;> simp_all

/-- `g ρ(g)⁻¹ ∈ Γ₀(32)`. -/
theorem mul_inv_repSL_mem (g : SL(2, ℤ)) : g * (repSL g)⁻¹ ∈ Gamma0 32 := by
  rw [Gamma0_mem]
  have he : (g * (repSL g)⁻¹) 1 0 = (toQ (g * (repSL g)⁻¹)).2.2.1 := rfl
  rw [he, toQ_mul, toQ_inv, toQ_repSL, ZMod.intCast_zmod_eq_zero_iff_dvd]
  have hdet := det_SL g
  have e0 : toQ g = (g 0 0, g 0 1, g 1 0, g 1 1) := rfl
  rw [e0]
  generalize g 0 0 = a at *
  generalize g 0 1 = b at *
  generalize g 1 0 = c at *
  generalize g 1 1 = d at *
  unfold qrep
  push_cast
  by_cases h : d % 2 = 1
  · simp only [h, if_true, qinv, qmul, repIdxA]
    obtain ⟨m, hm⟩ := dvd_pow_eight_sub_one h
    refine ⟨-c * m + d * (c * d ^ 7 / 32), ?_⟩
    rw [Int.emod_def]
    linear_combination (-c) * hm
  · have hc : c % 2 = 1 := by
      by_contra hc'
      have : (2 : ℤ) ∣ a * d - b * c := by
        have hd2 : (2 : ℤ) ∣ d := by omega
        have hc2 : (2 : ℤ) ∣ c := by omega
        exact dvd_sub (dvd_mul_of_dvd_right hd2 a) (dvd_mul_of_dvd_right hc2 b)
      rw [hdet] at this
      omega
    simp only [h, if_false, qinv, qmul, repIdxB]
    obtain ⟨m, hm⟩ := dvd_pow_eight_sub_one hc
    have heven : (d * c ^ 7 % 32) % 2 = 0 := by
      have hd2 : d % 2 = 0 := by omega
      have : (d * c ^ 7) % 2 = 0 := by
        rw [Int.mul_emod, hd2, zero_mul, Int.zero_emod]
      omega
    have h2 : 2 * (d * c ^ 7 % 32 / 2) = d * c ^ 7 % 32 := by omega
    refine ⟨d * m - c * (d * c ^ 7 / 32), ?_⟩
    rw [h2, Int.emod_def]
    linear_combination d * hm

theorem rA_injective : Function.Injective rA := by
  intro x y h
  have := congrArg toQ h
  rw [toQ_rA, toQ_rA] at this
  simp only [Prod.mk.injEq] at this
  exact Fin.ext (by exact_mod_cast this.2.2.1)

theorem rB_injective : Function.Injective rB := by
  intro x y h
  have := congrArg toQ h
  rw [toQ_rB, toQ_rB] at this
  simp only [Prod.mk.injEq] at this
  exact Fin.ext (by omega)

/-- Distinct representatives lie in distinct cosets. -/
theorem R32_unique {r₁ r₂ : SL(2, ℤ)} (h₁ : r₁ ∈ R32) (h₂ : r₂ ∈ R32)
    (h : r₁ * r₂⁻¹ ∈ Gamma0 32) : r₁ = r₂ := by
  rw [Gamma0_mem] at h
  have he : (r₁ * r₂⁻¹) 1 0 = (toQ (r₁ * r₂⁻¹)).2.2.1 := rfl
  rw [he, toQ_mul, toQ_inv, ZMod.intCast_zmod_eq_zero_iff_dvd] at h
  push_cast at h
  rcases h₁ with ⟨x, rfl⟩ | ⟨x, rfl⟩ <;> rcases h₂ with ⟨y, rfl⟩ | ⟨y, rfl⟩
  · rw [toQ_rA, toQ_rA] at h
    simp only [qinv, qmul] at h
    have hx := x.2; have hy := y.2
    congr 1; ext; omega
  · rw [toQ_rA, toQ_rB] at h
    simp only [qinv, qmul] at h
    exfalso
    obtain ⟨k, hk⟩ := h
    have h2 : ((x : ℕ) : ℤ) * ((y : ℕ) : ℤ) * 2 - 1 = 32 * k := by linarith
    generalize ((x : ℕ) : ℤ) * ((y : ℕ) : ℤ) = t at h2
    omega
  · rw [toQ_rB, toQ_rA] at h
    simp only [qinv, qmul] at h
    exfalso
    obtain ⟨k, hk⟩ := h
    have h2 : 1 - ((x : ℕ) : ℤ) * ((y : ℕ) : ℤ) * 2 = 32 * k := by linarith
    generalize ((x : ℕ) : ℤ) * ((y : ℕ) : ℤ) = t at h2
    omega
  · rw [toQ_rB, toQ_rB] at h
    simp only [qinv, qmul] at h
    have hx := x.2; have hy := y.2
    congr 1; ext; omega

theorem isComplement_R32 : Subgroup.IsComplement (Gamma0 32 : Set SL(2, ℤ)) R32 := by
  rw [Subgroup.isComplement_iff_existsUnique_mul_inv_mem]
  intro g
  refine ⟨⟨repSL g, repSL_mem g⟩, mul_inv_repSL_mem g, fun t ht => ?_⟩
  apply Subtype.ext
  apply R32_unique t.2 (repSL_mem g)
  have := (Gamma0 32).mul_mem ((Gamma0 32).inv_mem ht) (mul_inv_repSL_mem g)
  simpa [mul_assoc] using this

theorem one_mem_R32 : (1 : SL(2, ℤ)) ∈ R32 := by
  refine Or.inl ⟨0, ?_⟩
  ext i j
  fin_cases i <;> fin_cases j <;> rfl


/-! ### Schreier generators, checked by `decide` -/

def qS : Q4 := (0, -1, 1, 0)

def qT : Q4 := (1, 1, 0, 1)

/-- The Schreier generator `r s ρ(r s)⁻¹`, on quadruples. -/
def schreierQ (r s : Q4) : Q4 := qmul (qmul r s) (qinv (qrep (qmul r s)))

def expEQ (x : Q4) : ℤ := expE x.1 x.2.1 x.2.2.1 x.2.2.2

theorem schreier_check_A : ∀ x : Fin 32,
    expEQ (schreierQ (1, 0, (x : ℤ), 1) qS) % 12 = 0 ∧
      expEQ (schreierQ (1, 0, (x : ℤ), 1) qT) % 12 = 0 := by
  decide

theorem schreier_check_B : ∀ j : Fin 16,
    expEQ (schreierQ (0, -1, 1, 2 * (j : ℤ)) qS) % 12 = 0 ∧
      expEQ (schreierQ (0, -1, 1, 2 * (j : ℤ)) qT) % 12 = 0 := by
  decide


/-! ### `Γ₀(32)`-invariance -/

theorem dvd_of_mem_Gamma0 {h : SL(2, ℤ)} (hmem : h ∈ Gamma0 32) : (32 : ℤ) ∣ h 1 0 := by
  rw [Gamma0_mem] at hmem
  exact_mod_cast (ZMod.intCast_zmod_eq_zero_iff_dvd _ 32).mp hmem

theorem etaQuot32_slash_of_check {h : SL(2, ℤ)} (hmem : h ∈ Gamma0 32)
    (hE : expEQ (toQ h) % 12 = 0) : etaQuot32 ∣[(2 : ℤ)] h = etaQuot32 := by
  rw [etaQuot32_slash h (dvd_of_mem_Gamma0 hmem), zeta12_zpow_emod]
  have : expE (h 0 0) (h 0 1) (h 1 0) (h 1 1) % 12 = 0 := hE
  rw [this, zpow_zero, one_smul]

theorem toQ_S : toQ ModularGroup.S = qS := by
  simp [toQ, qS, ModularGroup.S]

theorem toQ_T : toQ ModularGroup.T = qT := by
  simp [toQ, qT, ModularGroup.T]

/-- **`η(4τ)² η(8τ)²` is invariant under `Γ₀(32)` in weight 2.** -/
theorem etaQuot32_slash_eq {γ : SL(2, ℤ)} (hγ : γ ∈ Gamma0 32) :
    etaQuot32 ∣[(2 : ℤ)] γ = etaQuot32 := by
  have hgen := Subgroup.closure_mul_image_eq isComplement_R32 one_mem_R32
    _root_.SpecialLinearGroup.SL2Z_generators
  rw [← hgen] at hγ
  induction hγ using Subgroup.closure_induction with
  | mem x hx =>
    obtain ⟨g, hg, rfl⟩ := hx
    obtain ⟨r, hr, s, hs, rfl⟩ := hg
    have hrep : (isComplement_R32.toRightFun (r * s) : SL(2, ℤ)) = repSL (r * s) := by
      apply R32_unique (isComplement_R32.toRightFun (r * s)).2 (repSL_mem _)
      have := (Gamma0 32).mul_mem ((Gamma0 32).inv_mem
        (isComplement_R32.mul_inv_toRightFun_mem (r * s))) (mul_inv_repSL_mem (r * s))
      simpa [mul_assoc] using this
    show etaQuot32 ∣[(2 : ℤ)] (r * s * (isComplement_R32.toRightFun (r * s) : SL(2, ℤ))⁻¹) =
      etaQuot32
    rw [hrep]
    apply etaQuot32_slash_of_check (mul_inv_repSL_mem (r * s))
    rw [toQ_mul, toQ_inv, toQ_repSL, toQ_mul]
    change expEQ (schreierQ (toQ r) (toQ s)) % 12 = 0
    rcases hs with rfl | rfl
    · rw [toQ_S]
      rcases hr with ⟨x, rfl⟩ | ⟨j, rfl⟩
      · rw [toQ_rA]; exact (schreier_check_A x).1
      · rw [toQ_rB]; exact (schreier_check_B j).1
    · rw [toQ_T]
      rcases hr with ⟨x, rfl⟩ | ⟨j, rfl⟩
      · rw [toQ_rA]; exact (schreier_check_A x).2
      · rw [toQ_rB]; exact (schreier_check_B j).2
  | one => exact SlashAction.slash_one _ _
  | mul x y _ _ hx hy => rw [SlashAction.slash_mul, hx, hy]
  | inv x _ hx =>
    calc etaQuot32 ∣[(2 : ℤ)] x⁻¹ = (etaQuot32 ∣[(2 : ℤ)] x) ∣[(2 : ℤ)] x⁻¹ := by rw [hx]
      _ = etaQuot32 ∣[(2 : ℤ)] (x * x⁻¹) := (SlashAction.slash_mul _ _ _ _).symm
      _ = etaQuot32 := by rw [mul_inv_cancel, SlashAction.slash_one]

end ZInQ.GZTheta
