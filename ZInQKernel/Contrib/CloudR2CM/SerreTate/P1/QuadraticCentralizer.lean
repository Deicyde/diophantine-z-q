import Mathlib.LinearAlgebra.Dimension.Free
import Mathlib.LinearAlgebra.Dimension.Constructions
import Mathlib.LinearAlgebra.Dimension.Finite
import Mathlib.LinearAlgebra.FiniteDimensional.Basic
import Mathlib.LinearAlgebra.LinearIndependent.Lemmas
import Mathlib.LinearAlgebra.Basis.Basic
import Mathlib.Algebra.Module.LinearMap.End
import Mathlib.Tactic

/-!
# The commutant of a faithful quadratic algebra

A nonscalar operator in dimension two has a cyclic pair. Its commutant
is generated by that operator and the identity. For a faithful unital
action of a two-dimensional commutative algebra, this is the full algebra
image, including both factors when the algebra splits.
-/

set_option autoImplicit false

noncomputable section

namespace HDec.CMSerreTate.P1

/-- A nonscalar operator on a two-dimensional vector space has a cyclic
pair. The argument works in every characteristic. -/
theorem exists_cyclic_pair_of_nonscalar {F V : Type*} [Field F] [AddCommGroup V]
    [Module F V] [FiniteDimensional F V] (hV : Module.finrank F V = 2)
    (T : Module.End F V) (hT : ∀ c : F, T ≠ c • (1 : Module.End F V)) :
    ∃ v : V, LinearIndependent F ![v, T v] := by
  classical
  let e := Module.finBasisOfFinrankEq F V hV
  let x := e (0 : Fin 2)
  let y := e (1 : Fin 2)
  have hxy : LinearIndependent F ![x, y] := by
    have he : ![x, y] = e := by
      funext i
      fin_cases i <;> rfl
    rw [he]
    exact e.linearIndependent
  by_cases hx : ∃ c : F, c • x = T x
  · obtain ⟨a, ha⟩ := hx
    by_cases hy : ∃ c : F, c • y = T y
    · obtain ⟨b, hb⟩ := hy
      have hab : a ≠ b := by
        intro h
        apply hT a
        apply e.ext
        intro i
        fin_cases i
        · change T x = a • x
          exact ha.symm
        · change T y = a • y
          rw [h]
          exact hb.symm
      refine ⟨x + y, LinearIndependent.pair_iff.mpr ?_⟩
      intro r s hrs
      have hcoords : (r + s * a) • x + (r + s * b) • y = 0 := by
        simpa only [map_add, ← ha, ← hb, smul_add, smul_smul, add_smul,
          add_assoc, add_left_comm, add_comm] using hrs
      have hc := LinearIndependent.pair_iff.mp hxy (r + s * a) (r + s * b) hcoords
      have hsab : s * (a - b) = 0 := by
        linear_combination hc.1 - hc.2
      have hs : s = 0 := (mul_eq_zero.mp hsab).resolve_right (sub_ne_zero.mpr hab)
      have hr : r = 0 := by simpa only [hs, zero_mul, add_zero] using hc.1
      exact ⟨hr, hs⟩
    · refine ⟨y, (LinearIndependent.pair_iff' (e.ne_zero (1 : Fin 2))).mpr ?_⟩
      intro c hc
      exact hy ⟨c, hc⟩
  · refine ⟨x, (LinearIndependent.pair_iff' (e.ne_zero (0 : Fin 2))).mpr ?_⟩
    intro c hc
    exact hx ⟨c, hc⟩

/-- A commuting operator is a linear polynomial in an operator which has
an actual cyclic pair in a two-dimensional space. -/
theorem commuting_operator_of_cyclic_pair {F V : Type*} [Field F] [AddCommGroup V]
    [Module F V] [FiniteDimensional F V] (hV : Module.finrank F V = 2)
    (T : Module.End F V) (v : V) (hli : LinearIndependent F ![v, T v])
    (S : Module.End F V) (hST : Commute S T) :
    ∃ r s : F, S = r • (1 : Module.End F V) + s • T := by
  classical
  have hspan : Submodule.span F (Set.range ![v, T v]) = ⊤ :=
    Submodule.eq_top_of_finrank_eq (by
      simpa only [Fintype.card_fin, hV] using finrank_span_eq_card hli)
  let e : Module.Basis (Fin 2) F V := Module.Basis.mk hli (by rw [hspan])
  have he0 : e (0 : Fin 2) = v := by simp [e]
  have he1 : e (1 : Fin 2) = T v := by simp [e]
  let r := e.repr (S v) (0 : Fin 2)
  let s := e.repr (S v) (1 : Fin 2)
  have hSv : S v = r • v + s • T v := by
    simpa only [Fin.sum_univ_two, he0, he1, r, s] using (e.sum_repr (S v)).symm
  let Q : Module.End F V := r • (1 : Module.End F V) + s • T
  have hQv : Q v = S v := by
    change r • v + s • T v = S v
    exact hSv.symm
  have hQTv : Q (T v) = T (S v) := by
    change r • T v + s • T (T v) = T (S v)
    rw [hSv, map_add, map_smul, map_smul]
  refine ⟨r, s, ?_⟩
  change S = Q
  apply e.ext
  intro i
  fin_cases i
  · change S (e (0 : Fin 2)) = Q (e (0 : Fin 2))
    rw [he0]
    exact hQv.symm
  · change S (e (1 : Fin 2)) = Q (e (1 : Fin 2))
    rw [he1]
    calc
      S (T v) = T (S v) := congrArg (fun u : Module.End F V => u v) hST.eq
      _ = Q (T v) := hQTv.symm

/-- The complete commutant of the faithful quadratic algebra is its
complete image. A scalar action through one split projection would not
satisfy the injectivity hypothesis. -/
theorem centralizer_element_of_faithful_quadratic {F B V : Type*} [Field F]
    [CommRing B] [Algebra F B] [FiniteDimensional F B]
    [AddCommGroup V] [Module F V] [FiniteDimensional F V]
    (φ : B →ₐ[F] Module.End F V) (hφ : Function.Injective φ)
    (hB : Module.finrank F B = 2) (hV : Module.finrank F V = 2)
    (S : Module.End F V) (hS : ∀ a : B, Commute S (φ a)) :
    ∃! a : B, φ a = S := by
  classical
  let e := Module.finBasisOfFinrankEq F V hV
  have hId : (1 : Module.End F V) ≠ 0 := by
    intro h
    exact e.ne_zero (0 : Fin 2) (by
      simpa using congrArg (fun u : Module.End F V => u (e (0 : Fin 2))) h)
  have hOne : (1 : B) ≠ 0 := by
    intro h
    exact hId (by simpa only [map_one, map_zero] using congrArg φ h)
  have hNonScalar : ∃ a : B, ∀ c : F, a ≠ c • (1 : B) := by
    by_contra h
    push_neg at h
    have hOneDim : Module.finrank F B = 1 :=
      finrank_eq_one (1 : B) hOne (fun a => by
        obtain ⟨c, hc⟩ := h a
        exact ⟨c, hc.symm⟩)
    omega
  obtain ⟨a, ha⟩ := hNonScalar
  let T := φ a
  have hT : ∀ c : F, T ≠ c • (1 : Module.End F V) := by
    intro c hc
    apply ha c
    apply hφ
    simpa only [map_smul, map_one, T] using hc
  obtain ⟨v, hli⟩ := exists_cyclic_pair_of_nonscalar hV T hT
  obtain ⟨r, s, hPoly⟩ := commuting_operator_of_cyclic_pair hV T v hli S (hS a)
  have hImage : φ (r • (1 : B) + s • a) = S := by
    rw [hPoly]
    simp only [map_add, map_smul, map_one, T]
  refine ⟨r • (1 : B) + s • a, hImage, ?_⟩
  intro z hz
  apply hφ
  exact hz.trans hImage.symm

/-- Any two operators commuting with the whole faithful quadratic
algebra commute with each other, including at split primes. -/
theorem commute_of_faithful_quadratic {F B V : Type*} [Field F]
    [CommRing B] [Algebra F B] [FiniteDimensional F B]
    [AddCommGroup V] [Module F V] [FiniteDimensional F V]
    (φ : B →ₐ[F] Module.End F V) (hφ : Function.Injective φ)
    (hB : Module.finrank F B = 2) (hV : Module.finrank F V = 2)
    (S T : Module.End F V) (hS : ∀ a : B, Commute S (φ a))
    (hT : ∀ a : B, Commute T (φ a)) : Commute S T := by
  obtain ⟨s, hs, _⟩ := centralizer_element_of_faithful_quadratic φ hφ hB hV S hS
  obtain ⟨t, ht, _⟩ := centralizer_element_of_faithful_quadratic φ hφ hB hV T hT
  rw [← hs, ← ht]
  exact (Commute.all s t).map φ.toRingHom

end HDec.CMSerreTate.P1
