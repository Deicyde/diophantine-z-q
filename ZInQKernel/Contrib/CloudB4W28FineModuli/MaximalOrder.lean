import ZInQKernel.Contrib.CloudB4W28FineModuli.Vendor.AnthropicFLT.Definitions.Def_QuaternionAlgebra_EichlerOrder
import ZInQKernel.Contrib.CloudB4W28FineModuli.Vendor.AnthropicFLT.Definitions.Def_QuaternionAlgebra_ReducedNorm
import ZInQKernel.Contrib.CloudB4W28FineModuli.Vendor.AnthropicFLT.Theorems.Thm_QuaternionAlgebra_IsOrder_exists_intCast_eq_nrd_and_exists_intCast_eq_trd

/-!
# The exact N5 order: a trace-dual maximality bridge

Project source: `0e70c94e4a2d26838f0766cd69b39bd02f48fb85`.
Mathlib source: `56a005855ea17e0b0958f73ec801ae140b0a1679`; Lean 4.35.0.

This file uses the original `LeafQM.O` and `LeafQM.ofInt`, without replacing
or modifying either definition. The integer submodule below has literally
the same carrier. The already proved basis and trace-discriminant calculations
are reused from `GlueRepo.A1`, not copied.

The maximality argument is elementary. Integral reduced norm and integral
pairings against the four order vectors force membership in the order, by
an anisotropic binary quadratic form modulo 2 and then modulo 3. In particular,
this argument does not depend on a ramification theorem.

This is source-author work. Compilation and axiom checks are performed by the
parent in an isolated environment; no check is claimed merely from this source.
-/

noncomputable section

namespace ZInQ.Contrib.CloudB4W28

/-- The original subring, regarded as an integer submodule with unchanged carrier. -/
def orderLattice : Submodule ℤ LeafQM.B where
  carrier := (LeafQM.O : Set LeafQM.B)
  zero_mem' := LeafQM.O.zero_mem
  add_mem' := LeafQM.O.add_mem
  smul_mem' := fun n _ hx => LeafQM.O.toAddSubgroup.zsmul_mem hx n

@[simp] theorem mem_orderLattice {x : LeafQM.B} :
    x ∈ orderLattice ↔ x ∈ LeafQM.O := Iff.rfl

/-- The carrier equality makes the exact-object aspect of the bridge explicit. -/
theorem orderLattice_carrier :
    (orderLattice : Set LeafQM.B) = (LeafQM.O : Set LeafQM.B) := rfl

/-- The two baseline presentations use the same coordinate map. -/
theorem a1_comb_eq_ofInt (n : Fin 4 → ℤ) :
    GlueRepo.A1.comb n = LeafQM.ofInt n := rfl

/-- Reuse of the baseline order, with the orientation of its range witnesses corrected. -/
theorem leafO_eq_a1Order : LeafQM.O = GlueRepo.A1.O := by
  ext x
  constructor
  · rintro ⟨n, hn⟩
    exact ⟨n, (a1_comb_eq_ofInt n).trans hn.symm⟩
  · rintro ⟨n, hn⟩
    exact ⟨n, hn.symm.trans (a1_comb_eq_ofInt n)⟩

/-- The project's already proved N5 order vectors, without a duplicate definition. -/
abbrev orderVectors : Fin 4 → LeafQM.B := GlueRepo.A1.e

theorem orderVector_mem (k : Fin 4) : orderVectors k ∈ orderLattice := by
  rw [mem_orderLattice, leafO_eq_a1Order]
  exact GlueRepo.A1.e_mem k

/-- Reuse of the existing integer-coordinate expansion. -/
theorem ofInt_eq_sum_orderVectors (n : Fin 4 → ℤ) :
    LeafQM.ofInt n = ∑ k, (n k : ℚ) • orderVectors k := by
  rw [← a1_comb_eq_ofInt]
  exact GlueRepo.A1.comb_eq n

/-- The integer lattice is generated by precisely the original four order vectors. -/
theorem orderLattice_eq_span :
    orderLattice = Submodule.span ℤ (Set.range orderVectors) := by
  apply le_antisymm
  · rintro x ⟨n, rfl⟩
    rw [ofInt_eq_sum_orderVectors]
    apply Submodule.sum_mem
    intro k _
    rw [Int.cast_smul_eq_zsmul ℚ]
    exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨k, rfl⟩)
  · exact Submodule.span_le.mpr (by
      rintro x ⟨k, rfl⟩
      exact orderVector_mem k)

/-- An explicit rational-coordinate expansion in the same, not a substituted, basis. -/
theorem eq_sum_orderVectors (x : LeafQM.B) :
    x = ∑ k, (![x.re - x.imJ, x.imI - x.imK,
      2 * x.imJ, 2 * x.imK] : Fin 4 → ℚ) k • orderVectors k := by
  ext <;> simp [orderVectors, GlueRepo.A1.e, Fin.sum_univ_four] <;> ring

theorem orderLattice_spanTop :
    Submodule.span ℚ (orderLattice : Set LeafQM.B) = ⊤ := by
  apply top_unique
  intro x _
  rw [eq_sum_orderVectors x]
  apply Submodule.sum_mem
  intro k _
  exact Submodule.smul_mem _ _ (Submodule.subset_span (orderVector_mem k))

theorem orderLattice_fg : orderLattice.FG := by
  rw [orderLattice_eq_span]
  exact Submodule.fg_span (Set.finite_range orderVectors)

/-- Existing determinant computation, transported to the exact order vectors. -/
theorem order_trace_discriminant :
    (Matrix.of fun r s => GlueRepo.A1.trd (orderVectors r * orderVectors s)).det = -36 :=
  GlueRepo.A1.det_trace_form

/-- The trace-dual coordinate equation for the already proved reduced norm. -/
theorem trace_norm_relation (x : LeafQM.B) :
    2 * ((GlueRepo.A1.trd (x * orderVectors 0)) ^ 2 -
      GlueRepo.A1.trd (x * orderVectors 0) * GlueRepo.A1.trd (x * orderVectors 2) +
      (GlueRepo.A1.trd (x * orderVectors 2)) ^ 2) -
    ((GlueRepo.A1.trd (x * orderVectors 1)) ^ 2 -
      GlueRepo.A1.trd (x * orderVectors 1) * GlueRepo.A1.trd (x * orderVectors 3) +
      (GlueRepo.A1.trd (x * orderVectors 3)) ^ 2) = 6 * GlueRepo.A1.nrd x := by
  rw [GlueRepo.A1.nrd_eq]
  simp [orderVectors, GlueRepo.A1.e, GlueRepo.A1.trd]
  ring

/-- The finite congruence argument behind maximality. Both finite facts use kernel `decide`. -/
theorem integral_trace_norm_coordinates (t₀ t₁ t₂ t₃ N : ℤ)
    (h : 2 * (t₀ ^ 2 - t₀ * t₂ + t₂ ^ 2) -
      (t₁ ^ 2 - t₁ * t₃ + t₃ ^ 2) = 6 * N) :
    ∃ q : Fin 4 → ℤ,
      t₀ = 2 * q 0 + q 2 ∧
      t₁ = 4 * q 1 + 2 * q 3 ∧
      t₂ = q 0 - q 2 ∧
      t₃ = 2 * q 1 + 4 * q 3 := by
  have key₂ : ∀ a b : ZMod 2, a ^ 2 - a * b + b ^ 2 = 0 → a = 0 ∧ b = 0 := by
    decide
  have h₂ := congrArg (fun z : ℤ => (z : ZMod 2)) h
  push_cast at h₂
  have two_mod_two : (2 : ZMod 2) = 0 := by decide
  have six_mod_two : (6 : ZMod 2) = 0 := by decide
  have h₂' : (t₁ : ZMod 2) ^ 2 - (t₁ : ZMod 2) * (t₃ : ZMod 2) +
      (t₃ : ZMod 2) ^ 2 = 0 := by
    simpa only [two_mod_two, six_mod_two, zero_mul, zero_sub, neg_eq_zero] using h₂
  obtain ⟨ht₁, ht₃⟩ := key₂ _ _ h₂'
  rw [ZMod.intCast_zmod_eq_zero_iff_dvd] at ht₁ ht₃
  obtain ⟨a, ha⟩ := ht₁
  obtain ⟨b, hb⟩ := ht₃
  norm_num only [Nat.cast_ofNat] at ha hb
  have h' : t₀ ^ 2 - t₀ * t₂ + t₂ ^ 2 -
      2 * (a ^ 2 - a * b + b ^ 2) = 3 * N := by
    rw [ha, hb] at h
    nlinarith [h]
  have key₃ : ∀ u v w z : ZMod 3,
      u ^ 2 - u * w + w ^ 2 - 2 * (v ^ 2 - v * z + z ^ 2) = 0 →
      u + w = 0 ∧ v + z = 0 := by
    decide
  have h₃ := congrArg (fun z : ℤ => (z : ZMod 3)) h'
  push_cast at h₃
  have three_mod_three : (3 : ZMod 3) = 0 := by decide
  have h₃' : (t₀ : ZMod 3) ^ 2 - (t₀ : ZMod 3) * (t₂ : ZMod 3) +
      (t₂ : ZMod 3) ^ 2 -
      2 * ((a : ZMod 3) ^ 2 - (a : ZMod 3) * (b : ZMod 3) + (b : ZMod 3) ^ 2) = 0 := by
    simpa only [three_mod_three, zero_mul] using h₃
  obtain ⟨ht₀₂, hab⟩ := key₃ _ _ _ _ h₃'
  have hc : ((3 : ℕ) : ℤ) ∣ t₀ + t₂ := by
    rw [← ZMod.intCast_zmod_eq_zero_iff_dvd]
    push_cast
    exact ht₀₂
  have hd : ((3 : ℕ) : ℤ) ∣ a + b := by
    rw [← ZMod.intCast_zmod_eq_zero_iff_dvd]
    push_cast
    exact hab
  obtain ⟨c, hc⟩ := hc
  obtain ⟨d, hd⟩ := hd
  norm_num only [Nat.cast_ofNat] at hc hd
  refine ⟨![c, a - d, t₀ - 2 * c, -a + 2 * d], ?_, ?_, ?_, ?_⟩ <;>
    simp <;> linarith

/-- Norm-integral vectors in the trace dual of this exact order already belong to it. -/
theorem leaf_mem_of_integral_norm_traces {x : LeafQM.B}
    (hn : ∃ N : ℤ, (N : ℚ) = GlueRepo.A1.nrd x)
    (ht : ∀ k : Fin 4, ∃ t : ℤ, (t : ℚ) = GlueRepo.A1.trd (x * orderVectors k)) :
    x ∈ LeafQM.O := by
  obtain ⟨N, hN⟩ := hn
  obtain ⟨t₀, ht₀⟩ := ht 0
  obtain ⟨t₁, ht₁⟩ := ht 1
  obtain ⟨t₂, ht₂⟩ := ht 2
  obtain ⟨t₃, ht₃⟩ := ht 3
  have h := trace_norm_relation x
  rw [← ht₀, ← ht₁, ← ht₂, ← ht₃, ← hN] at h
  have hZ : 2 * (t₀ ^ 2 - t₀ * t₂ + t₂ ^ 2) -
      (t₁ ^ 2 - t₁ * t₃ + t₃ ^ 2) = 6 * N := by
    exact_mod_cast h
  obtain ⟨q, hq₀, hq₁, hq₂, hq₃⟩ :=
    integral_trace_norm_coordinates t₀ t₁ t₂ t₃ N hZ
  have hq₀' : (t₀ : ℚ) = 2 * (q 0 : ℚ) + (q 2 : ℚ) := by exact_mod_cast hq₀
  have hq₁' : (t₁ : ℚ) = 4 * (q 1 : ℚ) + 2 * (q 3 : ℚ) := by exact_mod_cast hq₁
  have hq₂' : (t₂ : ℚ) = (q 0 : ℚ) - (q 2 : ℚ) := by exact_mod_cast hq₂
  have hq₃' : (t₃ : ℚ) = 2 * (q 1 : ℚ) + 4 * (q 3 : ℚ) := by exact_mod_cast hq₃
  simp [orderVectors, GlueRepo.A1.e, GlueRepo.A1.trd] at ht₀ ht₁ ht₂ ht₃
  refine ⟨q, ?_⟩
  ext <;> simp [LeafQM.ofInt] <;>
    linarith only [ht₀, ht₁, ht₂, ht₃, hq₀', hq₁', hq₂', hq₃']

/-- Reduced trace agrees definitionally with the project's proved trace. -/
theorem flt_trd_eq_a1 (x : LeafQM.B) :
    QuaternionAlgebra.trd x = GlueRepo.A1.trd x := rfl

/-- Reduced norm agrees with the project's proved norm on the exact algebra. -/
theorem flt_nrd_eq_a1 (x : LeafQM.B) :
    QuaternionAlgebra.nrd x = GlueRepo.A1.nrd x := by
  rw [GlueRepo.A1.nrd_eq]
  simp [QuaternionAlgebra.nrd] <;> ring

/-- The baseline discriminant calculation, now stated using the FLT reduced trace. -/
theorem flt_order_trace_discriminant :
    (Matrix.of fun r s => QuaternionAlgebra.trd (orderVectors r * orderVectors s)).det = -36 := by
  simpa only [flt_trd_eq_a1] using order_trace_discriminant

/-- The FLT order predicate for a lattice whose carrier is exactly `LeafQM.O`. -/
theorem isOrder_orderLattice : QuaternionAlgebra.IsOrder orderLattice where
  one_mem := LeafQM.O.one_mem
  mul_mem := fun _ _ hx hy => LeafQM.O.mul_mem hx hy
  spanTop := orderLattice_spanTop
  fg := orderLattice_fg

/-- The exact order has integral FLT reduced trace and norm. -/
theorem orderLattice_integral_trace_norm {x : LeafQM.B} (hx : x ∈ orderLattice) :
    (∃ N : ℤ, (N : ℚ) = QuaternionAlgebra.nrd x) ∧
      ∃ t : ℤ, (t : ℚ) = QuaternionAlgebra.trd x :=
  isOrder_orderLattice.exists_intCast_eq_nrd_and_exists_intCast_eq_trd hx

/--
The original project order is a maximal order in the exact FLT sense.

The only imported arithmetic fact beyond Mathlib and the project's existing
proofs is integral reduced norm and trace for an arbitrary FLT `IsOrder`.
It is the proved theorem
`QuaternionAlgebra.IsOrder.exists_intCast_eq_nrd_and_exists_intCast_eq_trd`
from `anthropics/fermats-last-theorem` at
`6e837e75355538c7f80bab5b956861e86c4eacc2`, with proof in the exact member
`P2M/Sol/S_QuaternionAlgebra_IsOrder_exists_intCast_eq_nrd_and_exists_intCast_eq_trd.lean`.
The parent owns its minimal licensed vendor port. No ramification or maximality
hypothesis is assumed in this theorem.
-/
theorem isMaximalOrder_orderLattice : QuaternionAlgebra.IsMaximalOrder orderLattice := by
  refine ⟨isOrder_orderLattice, ?_⟩
  intro Λ hΛ hle
  refine le_antisymm ?_ hle
  intro x hx
  apply mem_orderLattice.mpr
  apply leaf_mem_of_integral_norm_traces
  · obtain ⟨hn, _⟩ := hΛ.exists_intCast_eq_nrd_and_exists_intCast_eq_trd hx
    simpa only [flt_nrd_eq_a1] using hn
  · intro k
    have hprod : x * orderVectors k ∈ Λ :=
      hΛ.mul_mem hx (hle (orderVector_mem k))
    obtain ⟨_, ht⟩ := hΛ.exists_intCast_eq_nrd_and_exists_intCast_eq_trd hprod
    simpa only [flt_trd_eq_a1] using ht

