import ZInQKernel.Contrib.CMSerreTateSupport.LeafTameGeneratorV002
import ZInQKernel.Contrib.CMSerreTateSupport.FiniteTameCyclicV001
import ZInQKernel.Contrib.CMSerreTateSupport.ProcyclicV002

/-!
# A topological generator of the actual tame-inertia quotient

Closed composition. The generic compact procyclicity lemma (`exists_dense_zpowers`) fills the
statement `ProcyclicStatement`; the finite tame-character theorem
(`tame_quotient_cyclic_of_finiteDimensional`: finite extended value group generated by a
uniformizer, tame character into residue units) fills `FiniteLayerTameCyclic` for a discrete
valuation ring `O`. With the proved compactness, closedness, normality, basis and finite-quotient
cyclicity of the actual tame quotient, this gives:

* `exists_tame_generator`: for `Ω/K` Galois, `O` a discrete valuation ring, `w` over `O`, some
  actual inertia element generates a dense subgroup of `inertiaGroup w ⧸ wildGroup w`;
* `exists_tame_generator_layers`: the same, read on every finite Galois layer;
* `leaf_tame_generator`: in the leaf's objects (`K` a number field, `Ω` an algebraic closure,
  `PkgI2.IsInertia`), an inertia element `τ` such that every inertia element agrees on every
  finite Galois layer with `τ ^ k π`, `π` a literal strict-displacement element.
-/

noncomputable section
set_option autoImplicit false

universe u v

namespace ActualTameInertia

open Topology

theorem procyclicStatement_holds : ProcyclicStatement.{u} :=
  fun _ _ _ _ _ hb hc => WildTameCharacter.exists_dense_zpowers hb hc

theorem finiteLayerTameCyclic_holds {K : Type v} {Ω : Type u} [Field K] [Field Ω] [Algebra K Ω]
    [IsGalois K Ω] (O : ValuationSubring K) [IsDiscreteValuationRing O] :
    FiniteLayerTameCyclic K Ω O := by
  intro L wL hwL G hG
  obtain ⟨π, hπ0, hcyc, hker⟩ :=
    WildTameCharacter.tame_quotient_cyclic_of_finiteDimensional O wL hwL G hG
  obtain ⟨g, hg⟩ := WildTameCharacter.genMod_nonempty _ hcyc
  exact ⟨(WildTameCharacter.tameCharacter G hG hπ0).ker, inferInstance, ⟨g, hg⟩, hker⟩

/-- **Topological generator of the actual tame quotient.** -/
theorem exists_tame_generator {K : Type v} {Ω : Type u} [Field K] [Field Ω] [Algebra K Ω]
    [IsGalois K Ω] (O : ValuationSubring K) [IsDiscreteValuationRing O]
    (w : ValuationSubring Ω) (hw : w.comap (algebraMap K Ω) = O) :
    ∃ τ : inertiaGroup (K := K) w,
      Dense ((Subgroup.zpowers (QuotientGroup.mk τ : TameQuotient (K := K) w)) :
        Set (TameQuotient (K := K) w)) :=
  exists_tame_generator_of procyclicStatement_holds O w hw (finiteLayerTameCyclic_holds O)

/-- **The generator on every finite Galois layer.** -/
theorem exists_tame_generator_layers {K : Type v} {Ω : Type u} [Field K] [Field Ω] [Algebra K Ω]
    [IsGalois K Ω] (O : ValuationSubring K) [IsDiscreteValuationRing O]
    (w : ValuationSubring Ω) (hw : w.comap (algebraMap K Ω) = O) :
    ∃ τ : inertiaGroup (K := K) w, ∀ (σ : inertiaGroup (K := K) w)
      (L : FiniteGaloisIntermediateField K Ω), ∃ k : ℤ, ∃ π ∈ wildGroup (K := K) w,
        layerRestrict w L (τ ^ k) * AlgEquiv.restrictNormalHom L.toIntermediateField π =
          layerRestrict w L σ :=
  exists_tame_generator_layers_of procyclicStatement_holds O w hw (finiteLayerTameCyclic_holds O)

/-- **Tame generator in the leaf's objects**, with no further premises. -/
theorem leaf_tame_generator (K : Type) [Field K] [NumberField K] (O : ValuationSubring K)
    [IsDiscreteValuationRing O] (Ω : Type) [Field Ω] [Algebra K Ω] [IsAlgClosure K Ω]
    (w : ValuationSubring Ω) (hw : w.comap (algebraMap K Ω) = O) :
    ∃ τ : Ω ≃ₐ[K] Ω, PkgI2.IsInertia w τ ∧ ∀ σ : Ω ≃ₐ[K] Ω, PkgI2.IsInertia w σ →
      ∀ L : FiniteGaloisIntermediateField K Ω, ∃ k : ℤ, ∃ π : Ω ≃ₐ[K] Ω,
        (∀ x : Ω, x ≠ 0 → w.valuation (π x - x) < w.valuation x) ∧
          AlgEquiv.restrictNormalHom L.toIntermediateField (τ ^ k * π) =
            AlgEquiv.restrictNormalHom L.toIntermediateField σ := by
  have : IsGalois K Ω := IsAlgClosure.isGalois K Ω
  exact leaf_tame_generator_of procyclicStatement_holds K O Ω w hw (finiteLayerTameCyclic_holds O)

/-- The leaf's tame quotient has a dense cyclic subgroup generated by an actual inertia class. -/
theorem leaf_tame_quotient_procyclic (K : Type) [Field K] [NumberField K] (O : ValuationSubring K)
    [IsDiscreteValuationRing O] (Ω : Type) [Field Ω] [Algebra K Ω] [IsAlgClosure K Ω]
    (w : ValuationSubring Ω) (hw : w.comap (algebraMap K Ω) = O) :
    ∃ τ : inertiaGroup (K := K) w,
      Dense ((Subgroup.zpowers (QuotientGroup.mk τ : TameQuotient (K := K) w)) :
        Set (TameQuotient (K := K) w)) := by
  have : IsGalois K Ω := IsAlgClosure.isGalois K Ω
  exact exists_tame_generator O w hw

end ActualTameInertia

#check @ActualTameInertia.leaf_tame_generator
#check @ActualTameInertia.exists_tame_generator
#print axioms ActualTameInertia.procyclicStatement_holds
#print axioms ActualTameInertia.finiteLayerTameCyclic_holds
#print axioms ActualTameInertia.exists_tame_generator
#print axioms ActualTameInertia.exists_tame_generator_layers
#print axioms ActualTameInertia.leaf_tame_generator
#print axioms ActualTameInertia.leaf_tame_quotient_procyclic
