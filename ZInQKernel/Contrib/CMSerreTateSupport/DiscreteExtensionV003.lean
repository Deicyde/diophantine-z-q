import ZInQKernel.Contrib.CMSerreTateSupport.ValueTorsionV002
import Mathlib.RingTheory.DiscreteValuationRing.Basic
import Mathlib.RingTheory.Valuation.ValuationSubring
import Mathlib.RingTheory.PrincipalIdealDomain
import Mathlib.Data.Int.GCD

/-!
# A valuation ring of a finite extension of a discretely valued field is discretely valued

Let `O ⊆ K` be a valuation subring which is a DVR, `M/K` finite, and `w ⊆ M` a valuation
subring with `w ∩ K = O`. Then some `π ≠ 0` in `M` has the property that every nonzero value
of `w` is an integral power of `v(π)`. Values of `K` are the powers of `v(ϖ)` (units of `O`
have value `1`); by `exists_pow_val_eq_of_finiteDimensional`, `v(x)^N` (`N = [M:K]!`) is such
a power `v(ϖ)^{e(x)}`; the exponents `e(x)` form an ideal of `ℤ`, generated by some `e(π)`; and
`N`-th powers are injective on values.
-/

noncomputable section
set_option autoImplicit false

namespace WildTameCharacter

variable {K M : Type*} [Field K] [Field M] [Algebra K M]

theorem val_unit_eq_one (O : ValuationSubring K) (w : ValuationSubring M)
    (hw : w.comap (algebraMap K M) = O) (u : Oˣ) :
    w.valuation (algebraMap K M ((u : O) : K)) = 1 := by
  have hmem : ∀ y : O, algebraMap K M (y : K) ∈ w := by
    intro y
    have : (y : K) ∈ w.comap (algebraMap K M) := by rw [hw]; exact y.2
    exact ValuationSubring.mem_comap.mp this
  have h1 : w.valuation (algebraMap K M ((u : O) : K)) ≤ 1 :=
    (ValuationSubring.valuation_le_one_iff w _).2 (hmem u)
  have h2 : w.valuation (algebraMap K M (((u⁻¹ : Oˣ) : O) : K)) ≤ 1 :=
    (ValuationSubring.valuation_le_one_iff w _).2 (hmem (u⁻¹ : Oˣ))
  have hprod : w.valuation (algebraMap K M ((u : O) : K)) *
      w.valuation (algebraMap K M (((u⁻¹ : Oˣ) : O) : K)) = 1 := by
    rw [← Valuation.map_mul, ← map_mul]
    have : ((u : O) : K) * (((u⁻¹ : Oˣ) : O) : K) = 1 := by
      rw [← Subring.coe_mul, Units.mul_inv]
      rfl
    rw [this, map_one, Valuation.map_one]
  by_contra hne
  have hlt : w.valuation (algebraMap K M ((u : O) : K)) < 1 := lt_of_le_of_ne h1 hne
  have := mul_lt_one_of_lt_of_le hlt h2
  rw [hprod] at this
  exact lt_irrefl _ this

theorem val_base_eq_zpow (O : ValuationSubring K) [IsDiscreteValuationRing O]
    (w : ValuationSubring M) (hw : w.comap (algebraMap K M) = O) {ϖ : O} (hϖ : Irreducible ϖ)
    (b : K) (hb : b ≠ 0) :
    ∃ m : ℤ, w.valuation (algebraMap K M b) = w.valuation (algebraMap K M (ϖ : K)) ^ m := by
  have hO : ∀ y : O, y ≠ 0 → ∃ n : ℕ,
      w.valuation (algebraMap K M (y : K)) = w.valuation (algebraMap K M (ϖ : K)) ^ n := by
    intro y hy
    obtain ⟨n, u, hu⟩ := IsDiscreteValuationRing.eq_unit_mul_pow_irreducible hy hϖ
    refine ⟨n, ?_⟩
    rw [hu, Subring.coe_mul, map_mul, Valuation.map_mul, val_unit_eq_one O w hw u, one_mul,
      SubmonoidClass.coe_pow, map_pow, Valuation.map_pow]
  rcases O.mem_or_inv_mem b with h | h
  · obtain ⟨n, hn⟩ := hO ⟨b, h⟩ (by
      intro h0
      exact hb (congrArg Subtype.val h0))
    exact ⟨n, by simpa using hn⟩
  · obtain ⟨n, hn⟩ := hO ⟨b⁻¹, h⟩ (by
      intro h0
      exact (inv_ne_zero hb) (congrArg Subtype.val h0))
    refine ⟨-(n : ℤ), ?_⟩
    have hn' : (w.valuation (algebraMap K M b))⁻¹ = w.valuation (algebraMap K M (ϖ : K)) ^ n := by
      rw [← Valuation.map_inv, ← map_inv₀]
      simpa using hn
    rw [zpow_neg, zpow_natCast, ← hn', inv_inv]

/-- **Discreteness of `w ∩ M`** in the form used by the tame-character lemmas. -/
theorem exists_uniformizer_of_finiteDimensional [FiniteDimensional K M]
    (O : ValuationSubring K) [IsDiscreteValuationRing O]
    (w : ValuationSubring M) (hw : w.comap (algebraMap K M) = O) :
    ∃ π : M, π ≠ 0 ∧ ∀ x : M, x ≠ 0 → ∃ k : ℤ, w.valuation x = w.valuation π ^ k := by
  classical
  obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible O
  set c : M := algebraMap K M (ϖ : K) with hc
  have hϖ0 : (ϖ : K) ≠ 0 := by
    intro h0
    exact hϖ.ne_zero (Subtype.ext h0)
  have hc0 : c ≠ 0 := (map_ne_zero (algebraMap K M)).mpr hϖ0
  set v := w.valuation with hv
  set N : ℕ := (Module.finrank K M).factorial with hN
  have hN0 : N ≠ 0 := Nat.factorial_ne_zero _
  -- every `v(x)^N` is a power of `v(c)`
  have hexp : ∀ x : M, x ≠ 0 → ∃ e : ℤ, v x ^ N = v c ^ e := by
    intro x hx
    obtain ⟨k, hk0, hkn, a, b, hb, hab⟩ := exists_pow_val_eq_of_finiteDimensional (K := K) v hx
    have hvx : v x ≠ 0 := (Valuation.ne_zero_iff v).2 hx
    have ha : a ≠ 0 := by
      intro h0
      rw [h0, map_zero, Valuation.map_zero] at hab
      exact (mul_ne_zero ((Valuation.ne_zero_iff v).2 ((map_ne_zero _).mpr hb))
        (pow_ne_zero k hvx)) hab.symm
    obtain ⟨ma, hma⟩ := val_base_eq_zpow O w hw hϖ a ha
    obtain ⟨mb, hmb⟩ := val_base_eq_zpow O w hw hϖ b hb
    rw [← hv, ← hc] at hma hmb
    have hvc : v c ≠ 0 := (Valuation.ne_zero_iff v).2 hc0
    have hvb : v (algebraMap K M b) ≠ 0 := (Valuation.ne_zero_iff v).2 ((map_ne_zero _).mpr hb)
    have hxk : v x ^ k = v c ^ (ma - mb) := by
      calc v x ^ k = v (algebraMap K M a) / v (algebraMap K M b) := by
            rw [hab, mul_div_cancel_left₀ _ hvb]
        _ = v c ^ (ma - mb) := by rw [hma, hmb, zpow_sub₀ hvc]
    obtain ⟨t, ht⟩ : k ∣ N := Nat.dvd_factorial hk0 hkn
    refine ⟨(ma - mb) * t, ?_⟩
    rw [ht, pow_mul, hxk, zpow_mul, zpow_natCast]
  -- the exponents form an ideal of `ℤ`
  let E : Ideal ℤ :=
    { carrier := {e | ∃ x : M, x ≠ 0 ∧ v x ^ N = v c ^ e}
      add_mem' := by
        rintro e f ⟨x, hx, hxe⟩ ⟨y, hy, hyf⟩
        refine ⟨x * y, mul_ne_zero hx hy, ?_⟩
        rw [Valuation.map_mul, mul_pow, hxe, hyf, zpow_add₀ ((Valuation.ne_zero_iff v).2 hc0)]
      zero_mem' := ⟨1, one_ne_zero, by simp⟩
      smul_mem' := by
        rintro r e ⟨x, hx, hxe⟩
        refine ⟨x ^ r, zpow_ne_zero r hx, ?_⟩
        rw [smul_eq_mul, map_zpow₀, ← zpow_natCast, ← zpow_mul, mul_comm (r : ℤ), zpow_mul,
          zpow_natCast, hxe, ← zpow_mul, mul_comm] }
  obtain ⟨π, hπ0, hπ⟩ := Submodule.IsPrincipal.generator_mem E
  refine ⟨π, hπ0, fun x hx => ?_⟩
  obtain ⟨e, he⟩ := hexp x hx
  have hmem : e ∈ E := ⟨x, hx, he⟩
  obtain ⟨t, ht⟩ := (Submodule.IsPrincipal.mem_iff_eq_smul_generator E).1 hmem
  refine ⟨t, ?_⟩
  have hvπ : v π ≠ 0 := (Valuation.ne_zero_iff v).2 hπ0
  have h1 : (v π ^ t) ^ N = v c ^ (Submodule.IsPrincipal.generator E * t) := by
    rw [← zpow_natCast, ← zpow_mul, mul_comm t, zpow_mul, zpow_natCast, hπ, ← zpow_mul]
  have h2 : v x ^ N = v c ^ (Submodule.IsPrincipal.generator E * t) := by
    rw [he, ht, smul_eq_mul, mul_comm]
  have hpow : v x ^ N = (v π ^ t) ^ N := h2.trans h1.symm
  exact (pow_left_inj₀ zero_le zero_le hN0).1 hpow

end WildTameCharacter
