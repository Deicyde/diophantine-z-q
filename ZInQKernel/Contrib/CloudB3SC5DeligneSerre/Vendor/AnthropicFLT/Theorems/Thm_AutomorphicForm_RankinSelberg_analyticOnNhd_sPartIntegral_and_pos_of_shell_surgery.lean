      AnalyticOnNhd ℂ (fun s : ℂ => RankinSelberg.sPartIntegral K S (productionPinsOf K D₀ (fun N => levelOne (𝓞 K) K N ⊓ finiteAdelicGL2Subgroup K) (fun v => heckeGen (𝓞 K) K v)
