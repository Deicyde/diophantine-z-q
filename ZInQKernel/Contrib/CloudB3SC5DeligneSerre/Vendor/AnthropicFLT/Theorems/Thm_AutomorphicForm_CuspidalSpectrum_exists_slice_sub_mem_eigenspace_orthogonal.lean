    {α β : ℝ} {Φ₀ : Set (AdelicGL2 (𝓞 F) F)} (hΦ₀ : IsSlabFundamentalDomain F α β Φ₀)
    (σ : ℝ) (hσ : HasModulus F ξ σ) (hxm : x ∈ cuspMemberSubmodule F Φ₀ ξ)
