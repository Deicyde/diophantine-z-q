import ZInQKernel.Contrib.CloudB3E2Norm.H20Actual
import ZInQKernel.Contrib.OneProof.RC.Moving.MovingCharacter
import ZInQKernel.Contrib.OneProof.RC.GlueSweep.TateKummer
import ZInQKernel.Contrib.OneProof.RC.Local.TamePlaceBridge

/-!
# The moving character is trivial at `2N`: from the interface to the genuine decomposition groups

Manuscript `diophantine_zq.tex`, tex 2729 ("The character `Ψ_i` is finite, trivial at `2N`"),
tex 3431 ("At `v ∣ 2N`, `Ψ_i` is trivial") and Proposition `ex:arith-moving-character`,
tex 3500–3506 ("characters `ξ : Gal(H_r/K) → ℤ/2^nℤ` that are … trivial on the local
decomposition groups at `2N`"), with the construction of tex 3507–3702.

The moving character is produced by lane RC4's `moving_character_Psi`. It is a character
`Ψ : P r → A_i^×` of the abstract ring-class group `P r` (standing for `Gal(H_r/K)`) of an interface
`MovingSetting`, and it vanishes on the abstract decomposition groups `decomp r j ⊔ decompBar r j`
of the chosen primes `𝔭_j` over `2N`. The norm-cochain chain asks instead for `PsiTrivialAt2N`:
`Ψ_i : G_{K,S₀} → A_i^×` is trivial on the genuine decomposition groups `G_{K_v}`, `v` above `2N`.

This file isolates exactly what connects the two, as one named statement, and proves the transport.

* `MovingRealization M r P` (GLUE, tex 3565–3595 and 3679–3684): the onto restriction
  `G_{K,S₀} → P r` (the genuine `Gal(H_r/K)` read in the interface's `P r`). It sends each
  decomposition group `G_{K_v}`, `v ∈ P`, into `decomp r j ⊔ decompBar r j` for a chosen prime
  `𝔭_j` over `2N`. It sends the genuine inertia at a place over `r` onto the interface's inertia,
  and an arithmetic Frobenius lift at each active `𝔭_j` to `q r j`. Over the genuine ring class
  field these are the unramifiedness of `H_r/K` at `v ∤ r` with Frobenius-generated decomposition
  groups, `K` split at `2N` (tex 2720, 3528–3531), local reciprocity at `r` (tex 3679–3681), and the
  Artin map on `𝔭_j` (tex 3575–3576).
* `movingPsiAt M r Ψ R`: the moving character `Ψ_i = Ψ ∘ res` on `G_{K,S₀}`.
* `psiTrivialAt2N_of_realization` (PROVED): if `Ψ` vanishes on the decomposition groups at `2N`
  (the conclusion of `moving_character_Psi`), then `Ψ_i` is trivial on `G_{K_v}` for `v ∈ P`, and
  `PsiTrivialAt2N` holds for `Δ = im Ψ_i`.
* `exists_psiTrivialAt2N` (PROVED from the interface and `MovingRealization`): for every finite
  avoidance set there is a good `r ∉ S` and a moving character `Ψ_i` of `G_{K,S₀}` with values in
  `A_i^×`, of the form `Ψ ∘ res` with `Ψ` taking the value `1 + t` on an inertia element and on
  every active orientation (all of `moving_character_Psi`), with `PsiTrivialAt2N`.
* `exists_psiTrivialAt2N_ecurve`: the same over the genuine Tate image and Kummer layer of `E_ℓ`
  (`movingSettingEcurveS`, from Serre's print `SerreThm3`, `CMjInteger`, `FrobeniusTrace` and the
  interface fields of `MovingDataK`).
* `movingPsiAt_inertia`, `movingPsiAt_active` (PROVED): the transported `Ψ_i` keeps the value
  `1 + t` on a genuine inertia element at `r` and on Frobenius lifts at the active orientations.
* Type-level non-vacuity of `MovingRealization` (trivial `P r`; not an arithmetic instance).

What remains (named, not proved here): `MovingRealization` itself, together with the
ring-class fields of `MovingSetting` / `MovingDataK` that it presupposes. Constructing them from the
genuine Galois groups (ring class fields `H_r`, `Gal(H_r/K) ≅ Pic(ℤ + r𝒪_K)` by global reciprocity,
inertia and decomposition groups as Artin classes) is a separate development.

Kinds: one GLUE (`MovingRealization`), definitions and PROVED.
-/

noncomputable section

namespace ZInQ.Contrib.CloudB3E1Moving

open NumberField IsDedekindDomain
open ZInQ.Manuscript.RC.SelmerComplex
open ZInQ.Manuscript.RC.Moving
open ZInQ.Contrib.CloudB3E2.NormCochain

attribute [instance] MovingSetting.pGrp

variable {T : TateImage} {n : ℕ} (M : MovingSetting T n) (r : ℕ)
variable {K : Type} [Field K] [NumberField K] {S₀ : Set (HeightOneSpectrum (𝓞 K))}

/-- **GLUE: the moving-character data realized on the genuine Galois group** (tex 3565–3595,
3679–3684, with tex 2720 and 3528–3531). The interface's `P r` stands for `Gal(H_r/K)`, `H_r` the
ring class field of conductor `r`. A realization is the restriction `res : G_{K,S₀} → P r`, written
additively in `P r`, together with the places it must match.
* `res` is onto (`G_{K,S₀} → Gal(H_r/K)` is onto, `H_r ⊆ K_{S₀}`).
* For every place `v ∈ P` (the places above `2N`), the decomposition group `G_{K_v}` lands in
  `decomp r j ⊔ decompBar r j` for a chosen prime `𝔭_j` over `2N`. Over `H_r` this holds because
  `v ∤ r`, so `H_r/K` is unramified at `v` and the image of `G_{K_v}` is generated by the Frobenius
  at `v` (`decomp_eq`, [Cox §9.A]); and because `K` is split at `2N`, so `v` is `𝔭_j` or `𝔭̄_j`.
* At a place `w` over `r`, the genuine inertia `I_{K_w}` maps onto the interface's `inertia r`
  (tex 3679–3681).
* At each active orientation, the place `place j` (the chosen prime `𝔭_j`) carries an arithmetic
  Frobenius lift mapping to `q r j` (tex 3575–3576, [Cox, (9.1)]).
These are the facts about the genuine `Gal(H_r/K)` that the manuscript uses. With them the
transported character `Ψ_i = Ψ ∘ res` keeps all three properties of `moving_character_Psi`.
Kind: GLUE (definition of the Prop). -/
structure MovingRealization (P : Set (HeightOneSpectrum (𝓞 K))) where
  /-- the restriction `G_{K,S₀} → Gal(H_r/K)` -/
  res : GKS K S₀ →* Multiplicative (M.P r)
  /-- the restriction is onto -/
  res_surj : Function.Surjective res
  /-- each decomposition group above `2N` lands in a decomposition group of the interface -/
  decomp_at : ∀ v ∈ P, ∃ j, M.over2N j ∧ ∀ σ : Gloc K v,
    Multiplicative.toAdd (res (locMap K S₀ v σ)) ∈ M.decomp r j ⊔ M.decompBar r j
  /-- a place of `K` over `r` -/
  placeR : HeightOneSpectrum (𝓞 K)
  placeR_over : ((r : ℤ) : 𝓞 K) ∈ placeR.asIdeal
  /-- the genuine inertia at `placeR` maps into the interface's inertia group -/
  inertia_into : ∀ σ ∈ TauCeti.inertiaSubgroup (placeR.adicCompletion K),
    Multiplicative.toAdd (res (locMap K S₀ placeR σ)) ∈ M.inertia r
  /-- and onto it -/
  inertia_onto : ∀ z ∈ M.inertia r, ∃ σ ∈ TauCeti.inertiaSubgroup (placeR.adicCompletion K),
    Multiplicative.toAdd (res (locMap K S₀ placeR σ)) = z
  /-- the chosen primes `𝔭_j` as places of `K` -/
  place : Fin M.s → HeightOneSpectrum (𝓞 K)
  /-- at an active orientation, an arithmetic Frobenius lift maps to `q r j` -/
  frob_act : ∀ j, M.act j → ∃ φ : Gloc K (place j),
    TauCeti.IsArithFrobeniusLift ((place j).adicCompletion K) φ ∧
      Multiplicative.toAdd (res (locMap K S₀ (place j) φ)) = M.q r j

variable {M r} {i : ℕ}

/-- **The moving character on `G_{K,S₀}`**: `Ψ_i = Ψ ∘ res` with values in `A_i^×`, for a character
`Ψ : P r → A_i^×` of the interface (written additively) and a realization. Kind: definition. -/
def movingPsiAt {P : Set (HeightOneSpectrum (𝓞 K))} (Ψ : M.P r →+ Additive (Acoef i)ˣ)
    (R : MovingRealization M r (K := K) (S₀ := S₀) P) : GKS K S₀ →* (Acoef i)ˣ :=
  (AddMonoidHom.toMultiplicativeLeft Ψ).comp R.res

/-- **The transport** (tex 2729, 3431, 3500–3506): if `Ψ` vanishes on the decomposition groups of
the chosen primes over `2N` (the conclusion of `moving_character_Psi`), then `Ψ_i = Ψ ∘ res` is
trivial on the genuine decomposition groups `G_{K_v}`, `v ∈ P`. Kind: PROVED. -/
theorem movingPsiAt_trivial {P : Set (HeightOneSpectrum (𝓞 K))}
    (Ψ : M.P r →+ Additive (Acoef i)ˣ) (R : MovingRealization M r (K := K) (S₀ := S₀) P)
    (hΨ : ∀ j, M.over2N j → ∀ z ∈ M.decomp r j ⊔ M.decompBar r j, Ψ z = 0) :
    ∀ v ∈ P, ∀ σ : Gloc K v, movingPsiAt Ψ R (locMap K S₀ v σ) = 1 := by
  intro v hv σ
  obtain ⟨j, hj, hdec⟩ := R.decomp_at v hv
  change Additive.toMul (Ψ (Multiplicative.toAdd (R.res (locMap K S₀ v σ)))) = 1
  rw [hΨ j hj _ (hdec σ)]
  rfl

/-- **`PsiTrivialAt2N` for the moving character** (tex 2729, 3431, 3500–3506): E2's ELLIOT input,
for `Δ = im Ψ_i` with `π` the corestriction and `ψ` the inclusion. Kind: PROVED (from the
realization and the interface's `2N` clause). -/
theorem psiTrivialAt2N_of_realization [NeZero i] [TopologicalSpace (Acoef i)] [DiscreteTopology (Acoef i)]
    {P : Set (HeightOneSpectrum (𝓞 K))} (Ψ : M.P r →+ Additive (Acoef i)ˣ)
    (R : MovingRealization M r (K := K) (S₀ := S₀) P)
    (hΨ : ∀ j, M.over2N j → ∀ z ∈ M.decomp r j ⊔ M.decompBar r j, Ψ z = 0) :
    PsiTrivialAt2N i (movingPi i (movingPsiAt Ψ R)) (movingPsi i (movingPsiAt Ψ R)) P :=
  (psiTrivialAt2N_moving_iff (i := i) (Ψ := movingPsiAt Ψ R) P).mpr
    (movingPsiAt_trivial Ψ R hΨ)

/-- **The transported character keeps the inertia value** (tex 3694–3701): if `Ψ` takes the
value `1 + t` on an element of the interface's inertia, then `Ψ_i` takes it on a genuine inertia
element at the place over `r`. Kind: PROVED. -/
theorem movingPsiAt_inertia {P : Set (HeightOneSpectrum (𝓞 K))}
    (Ψ : M.P r →+ Additive (Acoef i)ˣ) (R : MovingRealization M r (K := K) (S₀ := S₀) P)
    (h : ∃ z ∈ M.inertia r, ((Additive.toMul (Ψ z) : (Acoef i)ˣ) : Acoef i) = 1 + tA i) :
    ∃ σ ∈ TauCeti.inertiaSubgroup (R.placeR.adicCompletion K),
      ((movingPsiAt Ψ R (locMap K S₀ R.placeR σ) : (Acoef i)ˣ) : Acoef i) = 1 + tA i := by
  obtain ⟨z, hz, hΨz⟩ := h
  obtain ⟨σ, hσ, hσz⟩ := R.inertia_onto z hz
  refine ⟨σ, hσ, ?_⟩
  change ((Additive.toMul (Ψ (Multiplicative.toAdd (R.res (locMap K S₀ R.placeR σ)))) :
    (Acoef i)ˣ) : Acoef i) = _
  rw [hσz, hΨz]

/-- **The transported character keeps the active values** (tex 3694–3701): at each active
orientation, `Ψ_i` takes the value `1 + t` on an arithmetic Frobenius lift at `𝔭_j`.
Kind: PROVED. -/
theorem movingPsiAt_active {P : Set (HeightOneSpectrum (𝓞 K))}
    (Ψ : M.P r →+ Additive (Acoef i)ˣ) (R : MovingRealization M r (K := K) (S₀ := S₀) P)
    (h : ∀ j, M.act j → ((Additive.toMul (Ψ (M.q r j)) : (Acoef i)ˣ) : Acoef i) = 1 + tA i) :
    ∀ j, M.act j → ∃ φ : Gloc K (R.place j),
      TauCeti.IsArithFrobeniusLift ((R.place j).adicCompletion K) φ ∧
        ((movingPsiAt Ψ R (locMap K S₀ (R.place j) φ) : (Acoef i)ˣ) : Acoef i) = 1 + tA i := by
  intro j hj
  obtain ⟨φ, hφ, hφq⟩ := R.frob_act j hj
  refine ⟨φ, hφ, ?_⟩
  change ((Additive.toMul (Ψ (Multiplicative.toAdd (R.res (locMap K S₀ (R.place j) φ)))) :
    (Acoef i)ˣ) : Acoef i) = _
  rw [hφq, h j hj]

variable (M) in
/-- **The moving character `Ψ_i` on `G_{K,S₀}`, from the interface** (tex 2720–2735, 3500–3506,
3694–3701). The ramification set may depend on the prime: `Sr r` is the set of places for the
stage at `r`, which must contain the places above `r` for the genuine `H_r ⊆ K_{Sr r}` (the manuscript
adds `r_i` to the stage's support). Given a realization at every good prime, for every finite
avoidance set `S` there is a
good prime `r ∉ S`, `r ≡ 1 (mod 2^B)`, and `Ψ : P r → A_i^×` from `moving_character_Psi`, such
that `Ψ_i = Ψ ∘ res` has three properties:
* it takes the value `1 + t` on a genuine inertia element at a place over `r`;
* it takes the value `1 + t` on an arithmetic Frobenius lift at every active orientation;
* it satisfies the norm-cochain chain's `PsiTrivialAt2N` for `Δ = im Ψ_i`.
Kind: PROVED (from the interface `MovingSetting` and the GLUE `MovingRealization`). -/
theorem exists_psiTrivialAt2N [NeZero i] [TopologicalSpace (Acoef i)] [DiscreteTopology (Acoef i)]
    (hn : 2 * i ≤ n) (P : Set (HeightOneSpectrum (𝓞 K)))
    (Sr : ℕ → Set (HeightOneSpectrum (𝓞 K)))
    (R : ∀ r, M.good r → MovingRealization M r (K := K) (S₀ := Sr r) P) (B : ℕ) (S : Finset ℕ) :
    ∃ (r : ℕ) (hr : M.good r), r ∉ S ∧ r.Prime ∧ (2 : ℤ) ^ B ∣ (r : ℤ) - 1 ∧
      ∃ Ψ : M.P r →+ Additive (Acoef i)ˣ,
        (∃ σ ∈ TauCeti.inertiaSubgroup ((R r hr).placeR.adicCompletion K),
          ((movingPsiAt Ψ (R r hr) (locMap K (Sr r) (R r hr).placeR σ) : (Acoef i)ˣ) : Acoef i) =
            1 + tA i) ∧
        (∀ j, M.act j → ∃ φ : Gloc K ((R r hr).place j),
          TauCeti.IsArithFrobeniusLift (((R r hr).place j).adicCompletion K) φ ∧
            ((movingPsiAt Ψ (R r hr) (locMap K (Sr r) ((R r hr).place j) φ) : (Acoef i)ˣ) :
              Acoef i) = 1 + tA i) ∧
        PsiTrivialAt2N i (movingPi i (movingPsiAt Ψ (R r hr)))
          (movingPsi i (movingPsiAt Ψ (R r hr))) P := by
  obtain ⟨r, hrS, hrp, hgood, hr1, -, -, Ψ, hin, hact, h2N⟩ := moving_character_Psi i hn M B S
  exact ⟨r, hgood, hrS, hrp, hr1, Ψ, movingPsiAt_inertia Ψ (R r hgood) hin,
    movingPsiAt_active Ψ (R r hgood) hact, psiTrivialAt2N_of_realization Ψ (R r hgood) h2N⟩

open ZInQ.Manuscript.RC.PrintsArith ZInQ.Manuscript.RC.TateWiring
open ZInQ.Manuscript.RC.GlueSweep.Tate in
/-- **The same over the genuine Tate image and Kummer layer of `E_ℓ`** (tex 3500–3702): the
interface is lane RC17/RC27's `movingSettingEcurveS` (from `SerreThm3` (PRINT), `CMjInteger`
(GLUE), `FrobeniusTrace` and the interface fields of `MovingDataK`). Kind: PROVED (from those and
`MovingRealization`). -/
theorem exists_psiTrivialAt2N_ecurve [NeZero i] [TopologicalSpace (Acoef i)] [DiscreteTopology (Acoef i)]
    (hS : SerreThm3) (hcm : CMjInteger) {ℓ : ℕ} (hℓ : 0 < ℓ)
    (hT : FrobeniusTrace (ZInQ.Contrib.CloudB3RC53.Ecurve ℓ))
    (D : MovingDataK (ZInQ.Contrib.CloudB3RC53.Ecurve ℓ) n) (hn : 2 * i ≤ n)
    (P : Set (HeightOneSpectrum (𝓞 K))) (Sr : ℕ → Set (HeightOneSpectrum (𝓞 K)))
    (R : ∀ r, (movingSettingEcurveS hS hcm hℓ hT D).good r →
      MovingRealization (movingSettingEcurveS hS hcm hℓ hT D) r (K := K) (S₀ := Sr r) P)
    (B : ℕ) (S : Finset ℕ) :
    ∃ (r : ℕ) (hr : (movingSettingEcurveS hS hcm hℓ hT D).good r), r ∉ S ∧ r.Prime ∧
      (2 : ℤ) ^ B ∣ (r : ℤ) - 1 ∧
      ∃ Ψ : (movingSettingEcurveS hS hcm hℓ hT D).P r →+ Additive (Acoef i)ˣ,
        PsiTrivialAt2N i (movingPi i (movingPsiAt Ψ (R r hr)))
          (movingPsi i (movingPsiAt Ψ (R r hr))) P := by
  obtain ⟨r, hr, hrS, hrp, hr1, Ψ, -, -, hP⟩ :=
    exists_psiTrivialAt2N (movingSettingEcurveS hS hcm hℓ hT D) hn P Sr R B S
  exact ⟨r, hr, hrS, hrp, hr1, Ψ, hP⟩

/-! ### Non-vacuity of `MovingRealization`

Type-level non-vacuity only: the structure is inhabited when the interface's `P r` is trivial (as
in the interface's own trivial inhabitant). This shows the fields are consistent; it is not an
arithmetic instance. The genuine instance is the ring-class development named above. -/

variable (M r) in
/-- **Type-level non-vacuity**: if `P r` is trivial and the active orientations are empty, the
trivial restriction realizes `MovingRealization` at every set of places that each has some chosen
prime over `2N`. Kind: PROVED. -/
def movingRealization_subsingleton [Subsingleton (M.P r)] (P : Set (HeightOneSpectrum (𝓞 K)))
    (hP : ∀ v ∈ P, ∃ j, M.over2N j) (hact : ∀ j, ¬ M.act j) (w : HeightOneSpectrum (𝓞 K))
    (hw : ((r : ℤ) : 𝓞 K) ∈ w.asIdeal) :
    MovingRealization M r (K := K) (S₀ := S₀) P where
  res := 1
  res_surj := fun _ => ⟨1, Subsingleton.elim _ _⟩
  decomp_at v hv := by
    obtain ⟨j, hj⟩ := hP v hv
    exact ⟨j, hj, fun _ => (M.decomp r j ⊔ M.decompBar r j).zero_mem⟩
  placeR := w
  placeR_over := hw
  inertia_into _ _ := by
    rw [Subsingleton.elim (Multiplicative.toAdd _) (0 : M.P r)]
    exact (M.inertia r).zero_mem
  inertia_onto z _ := ⟨1, one_mem _, Subsingleton.elim _ _⟩
  place := fun _ => w
  frob_act j hj := absurd hj (hact j)

end ZInQ.Contrib.CloudB3E1Moving
