import ZInQKernel.Contrib.CloudB3W17bGraphScoutReverseIdeal.IdealData

/-!
Stalk-germ identification for the genuinely constructed algebraic ideal.
The ideal on the stalk is generated by actual germs of the lifted inclusion's
section images. Its equality with the affine ideal transported to the stalk is
proved by the native quasi-coherent denominator-clearing theorem.
-/

open CategoryTheory AlgebraicGeometry TopologicalSpace Opposite

set_option autoImplicit false
set_option linter.style.haveILetI false
set_option backward.isDefEq.respectTransparency false

noncomputable section
universe u

namespace ZInQ.Contrib.CloudB3W17bGraphScoutReverseIdeal

variable {X : Scheme.{u}} {M : X.Modules}

/-- The actual stalk ideal generated by germs of the section image of i. -/
def sectionImageGermIdeal (i : M ⟶ SheafOfModules.unit X.ringCatSheaf) (x : X) :
    Ideal (X.presheaf.stalk x) :=
  Ideal.span {r | ∃ (V : X.Opens) (hxV : x ∈ V) (s : Γ(M, V)),
    (X.presheaf.germ V x hxV).hom (sectionMapToRing i V s) = r}

/-- The constructed ideal has exactly the correct stalk generators, not just the same support.
No analytic ideal is substituted or reversed by fiat. -/
theorem sectionImageGermIdeal_eq_map [M.IsQuasicoherent]
    (i : M ⟶ SheafOfModules.unit X.ringCatSheaf) {U : X.Opens} (hU : IsAffineOpen U)
    (x : X) (hxU : x ∈ U) :
    sectionImageGermIdeal i x =
      (sectionImageIdeal i U).map (X.presheaf.germ U x hxU).hom := by
  apply le_antisymm
  · refine Ideal.span_le.mpr ?_
    rintro r ⟨V, hxV, s, rfl⟩
    obtain ⟨a, haV, hxa⟩ := hU.exists_basicOpen_le (V := V) ⟨x, hxV⟩ hxU
    let s' : Γ(M, X.basicOpen a) := TopCat.Presheaf.restrictOpen s _ haV
    obtain ⟨k, t, ht⟩ := exists_restrictOpen_eq_pow_smul hU M a s'
    have hd := congrArg (sectionMapToRing i (X.basicOpen a)) ht
    rw [sectionMapToRing_res, map_smul, smul_eq_mul] at hd
    dsimp only [s'] at hd
    rw [sectionMapToRing_res] at hd
    have hd' : (X.presheaf.map (homOfLE (X.basicOpen_le a)).op).hom
        (sectionMapToRing i U t) =
        (X.presheaf.map (homOfLE (X.basicOpen_le a)).op).hom a ^ k *
          (X.presheaf.map (homOfLE haV).op).hom (sectionMapToRing i V s) := hd
    have hg : (X.presheaf.germ U x hxU).hom (sectionMapToRing i U t) =
        (X.presheaf.germ U x hxU).hom a ^ k *
          (X.presheaf.germ V x hxV).hom (sectionMapToRing i V s) := by
      have hg0 := congrArg (fun r : Γ(X, X.basicOpen a) =>
        (X.presheaf.germ (X.basicOpen a) x hxa).hom r) hd'
      simpa only [map_mul, map_pow, TopCat.Presheaf.germ_res_apply] using hg0
    have hu : IsUnit ((X.presheaf.germ U x hxU).hom a ^ k) :=
      ((X.mem_basicOpen a x hxU).mp hxa).pow k
    obtain ⟨v, hv⟩ := hu
    have hmem : (v : X.presheaf.stalk x) *
        (X.presheaf.germ V x hxV).hom (sectionMapToRing i V s) ∈
        (sectionImageIdeal i U).map (X.presheaf.germ U x hxU).hom := by
      rw [hv, ← hg]
      exact Ideal.mem_map_of_mem _ ⟨t, rfl⟩
    have hi := ((sectionImageIdeal i U).map (X.presheaf.germ U x hxU).hom).mul_mem_left
      (↑v⁻¹ : X.presheaf.stalk x) hmem
    change (X.presheaf.germ V x hxV).hom (sectionMapToRing i V s) ∈
      (sectionImageIdeal i U).map (X.presheaf.germ U x hxU).hom
    simpa only [← mul_assoc, v.inv_mul, one_mul] using hi
  · refine Ideal.map_le_iff_le_comap.mpr ?_
    rintro r ⟨s, rfl⟩
    exact Ideal.subset_span ⟨U, hxU, s, rfl⟩

/-- The same identity on the actual Scheme.IdealSheafData affine component. -/
theorem idealSheafOfQuasicoherentHom_stalk_generators [M.IsQuasicoherent]
    (i : M ⟶ SheafOfModules.unit X.ringCatSheaf) (U : X.affineOpens)
    (x : X) (hxU : x ∈ U.1) :
    ((idealSheafOfQuasicoherentHom i).ideal U).map (X.presheaf.germ U.1 x hxU).hom =
      sectionImageGermIdeal i x :=
  (sectionImageGermIdeal_eq_map i U.2 x hxU).symm

end ZInQ.Contrib.CloudB3W17bGraphScoutReverseIdeal
