          ⟨Q.1 ≫ gk, by rw [Category.assoc, hgk.w, ← Category.assoc, Q.2]⟩).1)
    (hgk_act : ∀ x : ↥Λ, E.act x ≫ gk = gk ≫ E_R.act x)
