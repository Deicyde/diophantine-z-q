      Function.Bijective e ∧
      ∀ (n : ℕ) (x₀ : L₀), pr n (e ((1 : AdicCompletion (I₀.map (algebraMap B₀ B)) B) ⊗ₜ x₀)) = κ n (pr₀ n x₀) := by w03_exact_reverting @_root_.ZInQ.Contrib.CloudW03NeronSurj.FLT.P2MW.S_AdicCompletion_exists_bijective_forall_apply_tmul_eq_of_isBaseChange_of_forall_ker_eq_pow_smul_top.solution


