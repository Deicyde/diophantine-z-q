    (hfib : ∀ (s : Spec (CommRingCat.of R)) (n : ℕ), 0 < n → ¬ IsUnit ((n : GoodReductionJacobian.RelativeGroupLaw.baseResidueField s)) →
      LocallyQuasiFinite ((L.fibre s).schemeNsmul n)) :
    (∀ n : ℕ, 0 < n → Flat (L.schemeNsmul n)) ∧ (∀ n : ℕ, 0 < n → Surjective (L.schemeNsmul n)) ∧
      (∀ n : ℕ, 0 < n → LocallyQuasiFinite (L.schemeNsmul n)) := by w03_exact_reverting @_root_.ZInQ.Contrib.CloudW03NeronSurj.FLT.P2MW.S_GoodReductionJacobian_RelativeGroupLaw_nsmul_flat_surjective_locallyQuasiFinite_of_forall_locallyQuasiFinite_fibre_schemeNsmul.solution


