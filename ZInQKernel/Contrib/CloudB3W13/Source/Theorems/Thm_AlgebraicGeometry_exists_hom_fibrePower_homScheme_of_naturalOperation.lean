      ∀ (S' : Type u) [CommRing S'] (s : Spec (CommRingCat.of S') ⟶ Spec (CommRingCat.of R))
        (φ : Fin n → (pullback f s ⟶ A)) (hφ : ∀ l, φ l ≫ f = pullback.snd f s ≫ s),
