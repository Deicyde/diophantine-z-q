      coord ⟨((n : ℚ) : ℍ[ℚ, a, b]), h⟩ = ((n : Zp2 q), 0) ∧
        (ρ ⟨((n : ℚ) : ℍ[ℚ, a, b]), h⟩).toPowerSeries = F.nthSeries n) :
    ∃ X : FormalODModule q B, X.F = F ∧
