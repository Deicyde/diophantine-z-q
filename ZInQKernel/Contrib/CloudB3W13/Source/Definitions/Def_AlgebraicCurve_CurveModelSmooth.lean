  exact RingHom.locally_of RingHom.isStandardSmoothOfRelativeDimension_respectsIso
    (algebraMap K K[X])
    ((RingHom.isStandardSmoothOfRelativeDimension_algebraMap 1).mpr
      (isStandardSmoothOfRelativeDimension_polynomial K))

