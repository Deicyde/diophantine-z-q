  have e₁ : (π' ≫ ψ) ⁻¹ᵁ U = (g' ≫ π) ⁻¹ᵁ U := by rw [h₁]
  have e₂ : (π'' ≫ ψ') ⁻¹ᵁ (ψ ⁻¹ᵁ U) = (g'' ≫ π') ⁻¹ᵁ (ψ ⁻¹ᵁ U) := by rw [h₂]
