theorem primesEquiv_symm_coe (ℓ : ℕ) [Fact ℓ.Prime] :
    ((Rat.HeightOneSpectrum.primesEquiv (R := 𝓞 ℚ)).symm ⟨ℓ, Fact.out⟩ |> Rat.HeightOneSpectrum.primesEquiv (R := 𝓞 ℚ) : ℕ) = ℓ := by
