        ((fun _ _ _ : Unit => sq₃) i₁ i₂ i₃).p₂ ((fun _ _ _ : Unit => sq₃) i₁ i₂ i₃).p₃
        (ChosenPullback₃.w₂ _) (ChosenPullback₃.w₃ _) =
