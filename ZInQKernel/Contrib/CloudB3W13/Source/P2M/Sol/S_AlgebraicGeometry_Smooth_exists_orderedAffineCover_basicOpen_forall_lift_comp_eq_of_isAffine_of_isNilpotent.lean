@[reassoc]
theorem isoSpec_hom_fromSpec {X : Scheme.{u}} {U : X.Opens} (hU : IsAffineOpen U) :
    hU.isoSpec.hom ≫ hU.fromSpec = U.ι := by
  rw [IsAffineOpen.isoSpec_hom, IsAffineOpen.toSpecΓ_fromSpec]

