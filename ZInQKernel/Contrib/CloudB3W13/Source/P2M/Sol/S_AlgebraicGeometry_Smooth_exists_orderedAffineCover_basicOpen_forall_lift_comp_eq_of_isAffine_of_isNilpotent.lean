theorem solution
    {T' T : Type u} [CommRing T'] [CommRing T] (π : T' →+* T) (hπ : Function.Surjective π)
    (hker : IsNilpotent (RingHom.ker π))
    {P P₀ A : Scheme.{u}} [IsAffine P] (p : P ⟶ Spec (CommRingCat.of T')) (p₀ : P₀ ⟶ Spec (CommRingCat.of T))
    (G : P₀ ⟶ P) (hG : IsPullback G p₀ p (Spec.map (CommRingCat.ofHom π)))
    (f : A ⟶ Spec (CommRingCat.of T')) [Smooth f] (μ : P₀ ⟶ A)
    (hμ : μ ≫ f = p₀ ≫ Spec.map (CommRingCat.ofHom π)) :
    ∃ (𝒲 : P.OrderedAffineCover) (a : 𝒲.ι → Γ(P, ⊤)) (_ : ∀ i : 𝒲.ι, 𝒲.U i = P.basicOpen (a i))
      (m : ∀ i : 𝒲.ι, (↑(𝒲.U i) : Scheme.{u}) ⟶ A),
      (∀ i, m i ≫ f = (𝒲.U i).ι ≫ p) ∧ (∀ i, G ∣_ (𝒲.U i) ≫ m i = (G ⁻¹ᵁ (𝒲.U i)).ι ≫ μ) := by
  classical
  obtain ⟨ι', a, c, hc, mdata⟩ := chart_lifts π hπ hker p p₀ G hG f μ hμ (⊤ : P.Opens) (isAffineOpen_top P)
  choose m hm1 hm2 using mdata
  let I : Type u := ↥c.support
  letI : LinearOrder I := LinearOrder.lift' (Fintype.equivFin I) (Fintype.equivFin I).injective
  have hcov : ⨆ i : I, P.basicOpen (a i.1) = ⊤ := by
    have hS : Ideal.span ((fun k => a k) '' (↑c.support : Set ι')) = ⊤ := by
      rw [Ideal.eq_top_iff_one, ← hc, Finsupp.sum]
      exact Submodule.sum_mem _ fun k hk => Submodule.smul_mem _ _ (Submodule.subset_span ⟨k, hk, rfl⟩)
    have hQeq := ((isAffineOpen_top P).iSup_basicOpen_eq_self_iff).mpr hS
