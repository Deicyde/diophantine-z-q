    ∃ M : RigidifiedLineBundle f (L.one (𝟙 (Spec (CommRingCat.of S)))) (𝟙 (Spec (CommRingCat.of S))),
      ∀ (S' : Type) [CommRing S'] (φ : S →+* S') {A' : Scheme.{0}} {f' : A' ⟶ Spec (CommRingCat.of S')} (g : A' ⟶ A),
