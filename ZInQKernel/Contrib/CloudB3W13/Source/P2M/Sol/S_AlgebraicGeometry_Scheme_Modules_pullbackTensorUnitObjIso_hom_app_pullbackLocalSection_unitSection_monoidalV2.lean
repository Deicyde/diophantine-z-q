  erw [ModuleCat.restrictScalars_η]
  exact (f.c.app (op V)).hom.map_one

lemma pb₀_η_app_pb₀Section_one (V : Y.Opens) :
    (η (pullback₀ f)).app (op (f ⁻¹ᵁ V)) (pb₀Section f (𝟙_ Y.PresheafOfModules) V (1 : Γ(Y, V))) =
