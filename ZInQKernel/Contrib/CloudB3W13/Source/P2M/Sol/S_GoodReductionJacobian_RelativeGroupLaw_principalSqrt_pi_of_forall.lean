  classical
  intro L' hL'

  have hproj : ∀ i, (Pi.evalRingHom C i).comp (algebraMap S (∀ i, C i)) = algebraMap S (C i) := fun i => RingHom.ext fun _ => rfl
  have hcompat : ∀ i, ∀ (T : Scheme.{u}) (t' : T ⟶ Spec (CommRingCat.of (C i)))
