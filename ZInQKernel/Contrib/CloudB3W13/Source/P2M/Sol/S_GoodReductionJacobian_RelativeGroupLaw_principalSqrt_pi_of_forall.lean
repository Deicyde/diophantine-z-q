  have hu1 : ∀ i, u i ≫ pullback.fst f _ = pullback.fst f _ := fun i => pullback.lift_fst _ _ _
  have hu2 : ∀ i, u i ≫ pullback.snd f _ = pullback.snd f _ ≫ Spec.map (CommRingCat.ofHom (Pi.evalRingHom C i)) :=
