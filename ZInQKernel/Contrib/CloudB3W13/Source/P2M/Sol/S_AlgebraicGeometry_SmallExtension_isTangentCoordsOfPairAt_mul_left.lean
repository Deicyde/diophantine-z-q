    (ι : V →ₗ[T'] T')
    (C : Type u) [CommRing C] [Algebra T' C]
    {Y : Scheme.{u}} (qY : Y ⟶ Spec (CommRingCat.of T')) (L : RelativeGroupLaw T' qY)
