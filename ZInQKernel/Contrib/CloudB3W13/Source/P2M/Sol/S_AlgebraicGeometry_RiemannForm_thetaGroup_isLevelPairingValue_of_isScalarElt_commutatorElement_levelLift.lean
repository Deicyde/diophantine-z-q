theorem commutatorElement_hom {C : Type*} [Category C] {X : C} (x g : Aut X) :
    (⁅x, g⁆ : Aut X).asIso.hom = g.asIso.inv ≫ x.asIso.inv ≫ g.asIso.hom ≫ x.asIso.hom := by
