theorem fib_mapId_inv_app (X : A.Modules) :
    (Scheme.Modules.fibration.mapId ⟨Opposite.op A⟩).inv.toNatTrans.app X = (Scheme.Modules.pullbackId A).inv.app X := by
  simp [Scheme.Modules.fibration]

