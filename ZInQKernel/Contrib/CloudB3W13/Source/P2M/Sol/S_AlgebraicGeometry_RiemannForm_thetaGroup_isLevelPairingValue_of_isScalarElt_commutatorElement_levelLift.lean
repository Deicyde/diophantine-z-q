theorem congr_left_inv {a b : X ⟶ Y} (hab : a = b) (g : Y ⟶ Z) (M : Z.Modules)
    (pa : (Scheme.Modules.pullback (a ≫ g)).obj M = (Scheme.Modules.pullback (b ≫ g)).obj M)
    (pb : (Scheme.Modules.pullback a).obj ((Scheme.Modules.pullback g).obj M) =
