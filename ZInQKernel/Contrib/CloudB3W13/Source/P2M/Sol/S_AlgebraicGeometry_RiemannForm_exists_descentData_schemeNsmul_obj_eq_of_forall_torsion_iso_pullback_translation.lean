          k f L hc hA g hdim n hn g₁ g₂ h
      refine ⟨fun P => U ⟨P.1, P.2⟩, ?_, fun P => hUeq ⟨P.1, P.2⟩⟩
      apply le_antisymm le_top
      rw [← hU]
