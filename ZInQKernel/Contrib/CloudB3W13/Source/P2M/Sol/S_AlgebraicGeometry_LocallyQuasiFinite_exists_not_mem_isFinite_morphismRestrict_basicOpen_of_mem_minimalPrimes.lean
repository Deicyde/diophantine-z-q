theorem isFinite_ι_of_isClosed {X : Scheme.{u}} (W : X.Opens) (hW : IsClosed (W : Set X)) : IsFinite W.ι := by
  haveI : IsClosedImmersion W.ι := IsClosedImmersion.of_isPreimmersion W.ι (by rw [Scheme.Opens.range_ι]; exact hW)
  infer_instance

