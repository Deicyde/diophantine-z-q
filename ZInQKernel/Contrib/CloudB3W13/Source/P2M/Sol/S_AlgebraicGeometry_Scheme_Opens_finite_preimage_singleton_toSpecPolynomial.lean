    (U : Scheme.{u}) ⟶ Spec (CommRingCat.of k[X]) :=
  (U : Scheme.{u}).toSpecΓ ≫ Spec.map (CommRingCat.ofHom
    (Polynomial.eval₂RingHom (Scheme.Opens.baseRingHom c U) (U.topIso.inv s)))

