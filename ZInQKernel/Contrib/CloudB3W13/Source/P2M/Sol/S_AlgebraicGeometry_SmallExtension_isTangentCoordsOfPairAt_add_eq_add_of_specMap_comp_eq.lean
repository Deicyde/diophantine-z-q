  have hmap : ∀ ψ : C →ₐ[T'] C,
      (∀ c : C, Ideal.Quotient.mk (I.map (algebraMap T' C)) (ψ c) = Ideal.Quotient.mk (I.map (algebraMap T' C)) c) →
      ∀ c : Γ(Ak, Ue) → (Module.Dual (ResidueField T') V →ₗ[ResidueField T'] (ResidueField T' ⊗[T'] C)),
