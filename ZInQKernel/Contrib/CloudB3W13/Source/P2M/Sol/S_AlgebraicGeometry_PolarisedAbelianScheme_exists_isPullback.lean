theorem solution
    {g d n : ℕ} {S S' : Type} [CommRing S] [CommRing S'] (φ : S →+* S')
    (u : AlgebraicGeometry.PolarisedAbelianScheme g d n S) :
    ∃ u' : AlgebraicGeometry.PolarisedAbelianScheme g d n S',
      AlgebraicGeometry.PolarisedAbelianScheme.IsPullback φ u u' :=
