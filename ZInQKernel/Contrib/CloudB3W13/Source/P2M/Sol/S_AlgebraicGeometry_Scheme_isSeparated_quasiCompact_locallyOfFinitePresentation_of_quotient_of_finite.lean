import Mathlib
import ZInQKernel.Contrib.CloudB3W13Shared.FiniteQuotient.Vendor.AnthropicFLT.Theorems.Thm_AlgebraicGeometry_Scheme_isSeparated_and_quasiCompact_of_isIntegralHom_of_surjective
