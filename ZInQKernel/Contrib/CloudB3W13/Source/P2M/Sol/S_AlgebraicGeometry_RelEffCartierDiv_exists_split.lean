    {s s' : T' ⟶ D.I.subscheme}
    (h₁ : s ≫ D.I.subschemeι ≫ pullback.fst f g = s' ≫ D.I.subschemeι ≫ pullback.fst f g)
    (h₂ : s ≫ D.I.subschemeι ≫ pullback.snd f g = s' ≫ D.I.subschemeι ≫ pullback.snd f g) :
