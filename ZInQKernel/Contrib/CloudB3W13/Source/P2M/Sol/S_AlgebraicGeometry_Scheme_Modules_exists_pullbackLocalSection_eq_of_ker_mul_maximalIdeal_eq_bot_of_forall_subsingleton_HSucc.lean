  haveI : CompactSpace ↥X := QuasiCompact.compactSpace_of_compactSpace f
  obtain ⟨𝒰⟩ := AlgebraicGeometry.Scheme.nonempty_orderedAffineCover_of_compactSpace_univ X
  have htriv := h𝓜.exists_trivialization

