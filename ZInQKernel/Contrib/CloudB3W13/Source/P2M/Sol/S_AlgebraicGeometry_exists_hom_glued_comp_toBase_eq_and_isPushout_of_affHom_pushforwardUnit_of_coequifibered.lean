import Mathlib
import ZInQKernel.Contrib.CloudW02Connectedness.Vendor.AnthropicFLT.Definitions.Def_AlgebraicGeometry_OModulePresheafConstructions
import ZInQKernel.Contrib.CloudB3W13.Source.Theorems.Thm_AlgebraicGeometry_exists_hom_glued_comp_toBase_eq_of_affHom_pushforwardUnit_of_coequifibered
import ZInQKernel.Contrib.CloudB3W13.Source.Theorems.Thm_AlgebraicGeometry_OModulePresheaf_isPushout_app_of_affHom_pushforwardUnit_of_ker_eq_pow_smul_top
