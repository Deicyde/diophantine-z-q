import Mathlib
import ZInQKernel.Contrib.CloudW03NeronSurj.Vendor.Definitions.Def_JacJ1Iface
import ZInQKernel.Contrib.CloudB3W13Shared.R2NOS.Definitions.Def_GoodReductionJacobian_RelativeGroupLawBaseChange
