private theorem zsmul_smul_zsmul {A M : Type*} [CommRing A] [AddCommGroup M] [Module A M]
    (z z' : ℤ) (x : A) (m : M) : z • (x • (z' • m)) = (z * z') • (x • m) := by
  rw [smul_comm x z' m, smul_smul]

