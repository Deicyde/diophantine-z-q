import Mathlib
import ZInQKernel.Contrib.CloudB3W13.Source.Definitions.Def_RingTheory_AffineDilatation
import ZInQKernel.Contrib.CloudB3W13.Source.Theorems.Thm_AffineDilatation_nonempty_algHom_and_subsingleton_of_isSMulRegular
import ZInQKernel.Contrib.CloudB3W13.Source.Theorems.Thm_AffineDilatation_isSMulRegular_and_map_eq_span_singleton
import ZInQKernel.Contrib.CloudW03NeronSurj.PortUtil
