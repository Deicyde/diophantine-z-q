  haveI : IsIso e := ⟨e', by rw [← cancel_mono i, Category.assoc, fac', fac, Category.id_comp],
    by rw [← cancel_mono i.ker.subschemeι, Category.assoc, fac, fac', Category.id_comp]⟩

