variable {R : Type u} [CommRing R] (G : TwoTermComplex.{u, v} R)

private def _root_.ZInQ.Contrib.CloudW03NeronSurj.FLT.CoherentBaseChange.TwoTermComplex.fibreRank (𝔭 : PrimeSpectrum R) : ℕ :=
  Module.finrank (κ 𝔭) (LinearMap.range (G.d.baseChange (κ 𝔭)))

w03_export "CoherentBaseChange.TwoTermComplex" "fibreRank"
private theorem _root_.ZInQ.Contrib.CloudW03NeronSurj.FLT.CoherentBaseChange.TwoTermComplex.fibreH0_add_fibreRank (𝔭 : PrimeSpectrum R) :
    G.fibreH0 𝔭 + G.fibreRank 𝔭 = Module.finrank (κ 𝔭) (κ 𝔭 ⊗[R] G.C0) := by
  have h := LinearMap.finrank_range_add_finrank_ker (G.d.baseChange (κ 𝔭))
  show Module.finrank (κ 𝔭) (LinearMap.ker (G.d.baseChange (κ 𝔭)))
      + Module.finrank (κ 𝔭) (LinearMap.range (G.d.baseChange (κ 𝔭))) = _
  omega

w03_export "CoherentBaseChange.TwoTermComplex" "fibreH0_add_fibreRank"

private theorem _root_.ZInQ.Contrib.CloudW03NeronSurj.FLT.CoherentBaseChange.TwoTermComplex.setOf_le_fibreH0_eq [StrongRankCondition R] (n : ℕ) :
    {𝔭 : PrimeSpectrum R | n ≤ G.fibreH0 𝔭}
      = {𝔭 | G.fibreRank 𝔭 + n ≤ Module.finrank R G.C0} := by
  ext 𝔭
  have h := G.fibreH0_add_fibreRank 𝔭
  rw [Module.finrank_baseChange] at h
  simp only [Set.mem_setOf_eq]
  omega

w03_export "CoherentBaseChange.TwoTermComplex" "setOf_le_fibreH0_eq"

theorem isClosed_add_le_const {X : Type*} [TopologicalSpace X] {f : X → ℕ}
    (hf : ∀ r, IsClosed {x | f x ≤ r}) (n c : ℕ) :
    IsClosed {x | f x + n ≤ c} := by
  rcases le_or_gt n c with hle | hgt
  · have heq : {x | f x + n ≤ c} = {x | f x ≤ c - n} := by
      ext x; simp only [Set.mem_setOf_eq]; omega
    rw [heq]; exact hf (c - n)
  · have heq : {x | f x + n ≤ c} = (∅ : Set X) := by
      ext x; simp only [Set.mem_setOf_eq, Set.mem_empty_iff_false, iff_false]; omega
    rw [heq]; exact isClosed_empty

private abbrev _root_.ZInQ.Contrib.CloudW03NeronSurj.FLT.CoherentBaseChange.TwoTermComplex.b0 : Module.Basis (Module.Free.ChooseBasisIndex R G.C0) R G.C0 :=
  Module.Free.chooseBasis R G.C0

w03_export "CoherentBaseChange.TwoTermComplex" "b0"

private abbrev _root_.ZInQ.Contrib.CloudW03NeronSurj.FLT.CoherentBaseChange.TwoTermComplex.b1 : Module.Basis (Module.Free.ChooseBasisIndex R G.C1) R G.C1 :=
