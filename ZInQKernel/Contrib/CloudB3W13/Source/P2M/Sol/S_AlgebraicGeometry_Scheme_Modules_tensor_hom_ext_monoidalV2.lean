theorem solution
    {X : Scheme.{u}} {M P N : X.Modules} {θ θ' : M ⊗ P ⟶ N}
    (h : ∀ (U : X.Opens) (m : Γ(M, U)) (p : Γ(P, U)),
      θ.app U (AlgebraicGeometry.Scheme.Modules.tensorSections m p) =
        θ'.app U (AlgebraicGeometry.Scheme.Modules.tensorSections m p)) :
    θ = θ' := by
  exact AlgebraicGeometry.Scheme.Modules.TensorHomExtV2.tensor_hom_ext h

