attribute [local instance] MvPolynomial.gradedAlgebra

theorem solution
    {A : Type u} [CommRing A] [IsNoetherianRing A] {n : ℕ} {Z : Scheme.{u}}
    (ι : Z ⟶ Proj (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) A)) [IsClosedImmersion ι] (d : ℕ) :
    Module.Finite A ((ProjSpace.twist (ι ≫ ProjSpace.π A n) ι d).H0 (ProjSpace.stdCoverPullback ι)) ∧
    (∀ i : ℕ, Module.Finite A ((ProjSpace.twist (ι ≫ ProjSpace.π A n) ι d).HSucc (ProjSpace.stdCoverPullback ι) i)) := by
  haveI : IsProper (ι ≫ ProjSpace.π A n) := inferInstance
  haveI : IsSeparated (ι ≫ ProjSpace.π A n) := inferInstance
  exact AlgebraicGeometry.OModulePresheaf.cechFinite_of_isProper (ProjSpace.twist (ι ≫ ProjSpace.π A n) ι d)
    (AlgebraicGeometry.ProjSpace.isCoherent_twist_and_flat (ι ≫ ProjSpace.π A n) ι d).1
    (AlgebraicGeometry.ProjSpace.isQuasicoherent_twist (ι ≫ ProjSpace.π A n) ι d) (ProjSpace.stdCoverPullback ι)

end S_AlgebraicGeometry_ProjSpace_finite_H0_twist_and_finite_HSucc_twist_of_isClosedImmersion
