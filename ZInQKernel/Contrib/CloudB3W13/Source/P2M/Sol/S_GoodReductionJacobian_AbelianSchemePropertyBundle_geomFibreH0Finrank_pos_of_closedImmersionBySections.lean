theorem AlgebraicGeometry.Scheme.one_ne_zero_of_mem {X : Scheme.{0}} {U : X.Opens} {x : X} (hx : x ∈ U) :
    (1 : Γ(X, U)) ≠ 0 := by
  intro h
  have hU : U = ⊥ := by rw [← Scheme.basicOpen_one (X := X) (U := U), h, Scheme.basicOpen_zero]
  rw [hU] at hx
  exact hx

