import ZInQKernel.Contrib.CloudB3W13Shared.R2NOS.Definitions.Def_AlgebraicGeometry_ModulesTensorPowV2
import ZInQKernel.Contrib.CloudB3W13.Source.Definitions.Def_AlgebraicGeometry_ModulesSectionsTensorV2
