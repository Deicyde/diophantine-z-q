def Idx : Type u :=
  Σ V : X.affineOpens, {g : G.obj V.1 //
    ∀ (V' : X.affineOpens) (hV' : V'.1 ≤ V.1), Function.Bijective fun b : Γ(X, V'.1) => b • G.res hV' g}

