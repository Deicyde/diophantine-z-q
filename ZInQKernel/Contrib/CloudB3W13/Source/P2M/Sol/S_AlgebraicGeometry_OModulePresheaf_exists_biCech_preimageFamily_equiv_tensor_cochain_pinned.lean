    simp only [← Int.cast_smul_eq_zsmul k, TensorProduct.tmul_smul, map_smul, hEtot, hEbox]
    refine Finset.sum_congr rfl fun j _ => ?_
    congr 1
    change ((pullback πX πY).presheaf.map (homOfLE _).op).hom (_ * _) = _
