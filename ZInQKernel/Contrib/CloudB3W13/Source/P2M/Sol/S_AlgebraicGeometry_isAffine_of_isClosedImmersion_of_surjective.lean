end AlgebraicGeometry
w03_reactivate "P2MW.S_AlgebraicGeometry_isAffine_of_isClosedImmersion_of_surjective.AlgebraicGeometry.ThickAffMain.NilpIdeal P2MW.S_AlgebraicGeometry_isAffine_of_isClosedImmersion_of_surjective.AlgebraicGeometry.ThickAffMain P2MW.S_AlgebraicGeometry_isAffine_of_isClosedImmersion_of_surjective.AlgebraicGeometry"

theorem solution
    {X₀ X : Scheme.{u}} (i : X₀ ⟶ X) [IsClosedImmersion i] [Surjective i] [IsAffine X₀] :
