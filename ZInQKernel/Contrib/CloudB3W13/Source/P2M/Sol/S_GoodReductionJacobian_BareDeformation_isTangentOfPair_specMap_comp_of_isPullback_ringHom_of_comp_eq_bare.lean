  have κP_apply : ∀ (z : Γ(D₀.A, 𝒰.inter s) × Γ(D₀.A, 𝒰.inter s)) (hz : z ∈ pairRing (RingHom.ker (algebraMap B B₁)) Γ(D₀.A, 𝒰.inter s)),
