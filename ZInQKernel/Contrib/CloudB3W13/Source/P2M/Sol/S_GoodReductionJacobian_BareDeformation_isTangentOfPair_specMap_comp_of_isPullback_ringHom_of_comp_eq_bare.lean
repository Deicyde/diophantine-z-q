    (hw : letI := algebraOfHom D₀.f (𝒰.inter s)
      AlgebraicGeometry.SmallExtension.IsTangentOfPair (RingHom.ker (algebraMap B B₁)) V ι Γ(D₀.A, 𝒰.inter s)
