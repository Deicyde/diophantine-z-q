  have hU : IsAffineOpen (𝒰.inter s) := Scheme.OrderedAffineCover.isAffineOpen_inter D₀.f 𝒰 s

  obtain ⟨ϑ, hϑ, φP, hφ1, hφ2, hw⟩ := hw

  have hle : (𝒰.inter s) ≤ k₀ ⁻¹ᵁ (𝒰.inter s) := by
    intro x hx
