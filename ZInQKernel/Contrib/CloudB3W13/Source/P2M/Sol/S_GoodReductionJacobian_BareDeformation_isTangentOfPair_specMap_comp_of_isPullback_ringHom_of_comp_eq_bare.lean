  have hmemP : ∀ z : Γ(D₀.A, 𝒰.inter s) × Γ(D₀.A, 𝒰.inter s), z ∈ pairRing (RingHom.ker (algebraMap B B₁)) Γ(D₀.A, 𝒰.inter s) → (κC z.1, κC z.2) ∈ pairRing (RingHom.ker (algebraMap B B₁)) Γ(D₀.A, 𝒰.inter s) := by
