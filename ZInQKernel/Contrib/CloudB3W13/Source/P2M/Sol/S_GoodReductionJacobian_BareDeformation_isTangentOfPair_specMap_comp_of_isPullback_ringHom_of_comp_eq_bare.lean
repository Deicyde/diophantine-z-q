      rw [hϑ.1 (κC a) (hdiag_mem (κC a)), hred, Algebra.TensorProduct.map_tmul, map_one, AlgHom.coe_id, id_eq]
    have hoff : ∀ (x : Γ(D₀.A, 𝒰.inter s)) (hx : x ∈ (RingHom.ker (algebraMap B B₁)).map (algebraMap B Γ(D₀.A, 𝒰.inter s))),
