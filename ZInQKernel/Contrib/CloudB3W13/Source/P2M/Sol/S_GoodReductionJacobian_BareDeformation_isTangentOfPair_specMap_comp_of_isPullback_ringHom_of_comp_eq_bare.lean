    have h1 := IsAffineOpen.SpecMap_appLE_fromSpec D₀.f (isAffineOpen_top (Spec (CommRingCat.of B))) hU
      (show (𝒰.inter s) ≤ D₀.f ⁻¹ᵁ ⊤ from le_top)
    rw [IsAffineOpen.fromSpec_top, Scheme.isoSpec_Spec_inv, ← Spec.map_comp] at h1
    rw [← h1]
