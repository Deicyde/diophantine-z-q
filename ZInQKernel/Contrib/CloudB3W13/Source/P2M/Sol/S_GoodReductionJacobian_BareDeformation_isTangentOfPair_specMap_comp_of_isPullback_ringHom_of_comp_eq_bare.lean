        ((Scheme.OrderedAffineCover.isAffineOpen_inter D₀.f 𝒰 s).isoSpec.inv ≫ τs.hom ≫ (𝒰.inter s).ι)
        (w₀ ≫ pullback.fst D₀.f (specMap B (ResidueField B)))) :
