    rw [mem_pairRing, Ideal.Quotient.eq] at hz ⊢
    show κC z.1 - κC z.2 ∈ _
    rw [← map_sub]
    exact hκIC _ hz
  let κP : pairRing (RingHom.ker (algebraMap B B₁)) Γ(D₀.A, 𝒰.inter s) →+* pairRing (RingHom.ker (algebraMap B B₁)) Γ(D₀.A, 𝒰.inter s) :=
