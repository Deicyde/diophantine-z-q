    rw [hιI] at this; exact this
  have hoff_mem : ∀ x : Γ(D₀.A, 𝒰.inter s), x ∈ (RingHom.ker (algebraMap B B₁)).map (algebraMap B Γ(D₀.A, 𝒰.inter s)) → ((0 : Γ(D₀.A, 𝒰.inter s)), x) ∈ pairRing (RingHom.ker (algebraMap B B₁)) Γ(D₀.A, 𝒰.inter s) := by
