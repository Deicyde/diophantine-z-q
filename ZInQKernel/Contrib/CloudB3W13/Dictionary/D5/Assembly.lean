import ZInQKernel.Contrib.CloudB3W13.Dictionary.D5.Generation
import ZInQKernel.Contrib.CloudB3W13.Dictionary.D5.Transport

/-!
# D5: unconditional converse dictionary

Original dictionary proof, 2026-11-16, W13 D5 with Metamate/agentcloud assistance.
The carrier, group law, action and level point are all retained. The canonical
relative-law/Yoneda round trip is proved by equality of multiplication maps;
there is no separate isomorphism or geometric-model hypothesis. In particular,
the converse does not add D2 or D34 as final assumptions.
-/

set_option backward.isDefEq.respectTransparency.types false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false

noncomputable section

namespace ZInQ.Contrib.CloudB2Shimura.Dictionary.D5

open CategoryTheory Limits AlgebraicGeometry
open MonoidalCategory CartesianMonoidalCategory MonObj
open PkgI3 LeafQM
open ZInQ.Contrib.CloudW03NeronSurj
open FLT.NeronModelInfra FLT.GoodReductionJacobian

variable {K : Type} [Field K]

/-- The canonical relative-law/Yoneda conversion returns the actual original
kernel group object, not merely an abstractly isomorphic one. -/
theorem kernelLaw_roundtrip (A : AbVar K) :
    (kernelLaw A).grpObjOverMk =
      (show GrpObj (Over.mk A.X.hom) from A.grp) := by
  letI : GrpObj (Over.mk A.X.hom) := A.grp
  apply GrpObj.ext
  apply MonObj.ext
  change lift (fst (Over.mk A.X.hom) (Over.mk A.X.hom))
    (snd (Over.mk A.X.hom) (Over.mk A.X.hom)) ≫ μ[Over.mk A.X.hom] =
      μ[Over.mk A.X.hom]
  rw [lift_fst_snd, Category.id_comp]

/-- Exact recovery of the original kernel abelian variety, including its
original group law. The geometric property fields are proof-irrelevant. -/
theorem abVarOfKernel_eq [CharZero K] (P : AV.QML3 K)
    (h : AbVarProps (kernelFakeEC P)) :
    abVarOfFakeEC (kernelFakeEC P) h = P.A := by
  change @AbVar.mk K _ (Over.mk P.A.X.hom) (kernelLaw P.A).grpObjOverMk
    h.1 h.2.1 h.2.2 = P.A
  rw [kernelLaw_roundtrip]
  rfl

/-- **D5**, exactly the canonical obligation, without any extra final premise.
The actual full level datum has the given `eta(1)`, and all geometric points
are generated by cardinality 81 of the actual three-torsion at every field. -/
theorem d5_obligation : D5_Obligation := by
  intro P
  let u : FLTL3 AV.Qbar := kernelWithFullLevel P
  let h : AbVarProps u.1 := ⟨P.A.proper, P.A.smooth, P.A.geomInt⟩
  let B : AbVar AV.Qbar := abVarOfFakeEC u.1 h
  have hA : B = P.A := abVarOfKernel_eq P h
  refine ⟨u, h, surfaceOfEq P B hA, qmOfEq P B hA, levelOfEq P B hA, ?_, ?_, ?_⟩
  · intro a
    have hi : ((qmOfEq P B hA).iota a).hom = (P.q.iota a).hom := by
      simpa only [eqToHom_refl, Category.id_comp, Category.comp_id] using
        (qmOfEq_hom P B hA (show B.X = P.A.X from rfl) a)
    exact (congrArg CommaMorphism.left hi).trans (kernelFakeEC_act P a).symm
  · intro a
    have he : Additive.toMul ((levelOfEq P B hA).eta a) =
        Additive.toMul (P.e.eta a) := by
      simpa only [eqToHom_refl, Category.comp_id] using
        (levelOfEq_pt P B hA (show B.X = P.A.X from rfl) a)
    exact (congrArg CommaMorphism.left he).trans (kernelWithFullLevel_points P a).symm
  · exact ⟨objectOfEq_iso P B hA⟩

end ZInQ.Contrib.CloudB2Shimura.Dictionary.D5
