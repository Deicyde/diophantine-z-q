/-
H5 lane3 Step 2, B1 KEY: `HeightOneMaximalInSupport` (Kb1.lean 32e43b71) PROVED from Mathlib
heights and specialization, plus ONE small TRUE obligation. 2026-11-17. New file. SOURCE-ONLY,
UNCOMPILED. Universe u.

Small obligation (TRUE) `InvertibleSupportNeUniv`: the support of an invertible ideal on an
integral scheme is not everything. An invertible ideal is not `⊥`: locally it is generated by a
nonzerodivisor. Then Mathlib `IdealSheafData.support_eq_top_iff` on the reduced scheme gives the
claim.

Proof:
* Let `ξ` be the generic point of `Y`; it is sober.
* If `ξ ≠ η`, then `ξ ⤳ η` and `ξ ∈ U`, so `ξ = fromSpec q` with `q < p` (`fromSpec` is an open
  embedding; `PrimeSpectrum.le_iff_specializes`).
* `q ≠ ⊥`: otherwise `ξ` specializes to the generic point of the integral `A`, so `ξ` IS that
  generic point (T0). Then `Y = univ ⊆ supp D`, a contradiction.
* So `⊥ < q < p`. `Order.height_strictMono` and `PrimeSpectrum.height_eq_orderHeight` with
  `height p = 1` give `height q = 0`, and then `height ⊥ < 0`, which is impossible.
-/
import ZInQKernel.Contrib.CloudR2NOS.Step2B1.Kb1
import ZInQKernel.Contrib.CloudR2NOS.Step1.PicZeroSections

set_option autoImplicit false

noncomputable section

universe u

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry TopologicalSpace Topology
open scoped CategoryTheory.MonObj

namespace ZInQ.Contrib.CloudR2NOS.Step2B1

/-- (TRUE) The support of an invertible ideal on an integral scheme is not everything. -/
def InvertibleSupportNeUniv : Prop :=
  ∀ {X : Scheme.{u}} [IsIntegral X] (D : X.IdealSheafData), D.IsInvertible →
    (D.support : Set X) ≠ Set.univ

theorem heightOneMaximalInSupport (hNU : InvertibleSupportNeUniv.{u}) :
    HeightOneMaximalInSupport.{u} := by
  intro K _ _ A _ D hD U p hp hη Y hYirr hYcl hηY hYsub
  haveI : IsIntegral A.X.left := ZInQ.Contrib.CloudR2NOS.Step1.isIntegral_of_isAbelianVariety A
  set η := U.2.fromSpec p with hηdef
  obtain ⟨ξ, hξ⟩ := QuasiSober.sober hYirr hYcl
  by_cases hEq : ξ = η
  · rw [← hEq]
    exact hξ.def.symm
  exfalso
  have hspec : ξ ⤳ η := hξ.specializes hηY
  have hηU : η ∈ (U.1 : Set A.X.left) := by
    rw [← U.2.range_fromSpec]
    exact ⟨p, rfl⟩
  have hξU : ξ ∈ (U.1 : Set A.X.left) := hspec.mem_open U.1.isOpen hηU
  obtain ⟨q, hq⟩ : ξ ∈ Set.range U.2.fromSpec := by rw [U.2.range_fromSpec]; exact hξU
  have hind : IsInducing U.2.fromSpec := U.2.fromSpec.isOpenEmbedding.isInducing
  have hqp : q ⤳ p := hind.specializes_iff.mp (hq ▸ hspec)
  have hqp' : q < p := lt_of_le_of_ne ((PrimeSpectrum.le_iff_specializes q p).mpr hqp)
    (fun h => hEq (by rw [← hq, h]))
  haveI : Nonempty (U.1 : Set A.X.left) := ⟨⟨η, hηU⟩⟩
  -- `q ≠ ⊥`
  have hqbot : q.asIdeal ≠ ⊥ := by
    intro hbot
    -- the generic point of `A` lies in `U`
    have hgU : genericPoint A.X.left ∈ (U.1 : Set A.X.left) :=
      ((genericPoint_spec A.X.left).mem_open_set_iff U.1.isOpen).mpr ⟨η, trivial, hηU⟩
    obtain ⟨r, hr⟩ : genericPoint A.X.left ∈ Set.range U.2.fromSpec := by
      rw [U.2.range_fromSpec]; exact hgU
    have hqr : q ⤳ r := (PrimeSpectrum.le_iff_specializes q r).mp (by
      show q.asIdeal ≤ r.asIdeal
      rw [hbot]; exact bot_le)
    have h1 : ξ ⤳ genericPoint A.X.left := by
      rw [← hq, ← hr]; exact hqr.map U.2.fromSpec.continuous
    have h2 : genericPoint A.X.left ⤳ ξ := (genericPoint_spec A.X.left).specializes trivial
    have hξg : ξ = genericPoint A.X.left := h1.antisymm h2
    apply hNU D hD
    refine Set.eq_univ_of_univ_subset (fun a _ => hYsub ?_)
    rw [← hξ.def, hξg, (genericPoint_spec A.X.left).def]
    trivial
  -- the chain `⊥ < q < p` contradicts `height p = 1`
  have hp1 : Order.height p = 1 := by rw [← PrimeSpectrum.height_eq_orderHeight]; exact hp
  have hfinq : Order.height q < ⊤ := (Order.height_mono hqp'.le).trans_lt (by rw [hp1]; decide)
  have hq0 : Order.height q = 0 := by
    have := Order.height_strictMono hqp' hfinq
    rw [hp1] at this
    exact ENat.lt_one_iff_eq_zero.mp this
  let r₀ : PrimeSpectrum Γ(A.X.left, U.1) := ⟨⊥, Ideal.bot_prime⟩
  have hr₀q : r₀ < q := lt_of_le_of_ne (show r₀.asIdeal ≤ q.asIdeal from bot_le)
    (fun h => hqbot (by rw [← h]))
  have hfinr : Order.height r₀ < ⊤ := (Order.height_mono hr₀q.le).trans_lt (by rw [hq0]; decide)
  have := Order.height_strictMono hr₀q hfinr
  rw [hq0] at this
  exact (not_lt_zero this).elim

end ZInQ.Contrib.CloudR2NOS.Step2B1
