import PrincipalCuspTransport
import ZInQKernel.Contrib.TauCeti.NumberTheory.ModularForms.CharacterDecomp
import ZInQKernel.Contrib.TauCeti.NumberTheory.ModularForms.SlashActionRat

/-!
# A nonzero nebentypus component in a finite rational translate orbit

The diamond-cyclic subspace is generated by the actual diamond translates of
a given cusp form. Its invariant character decomposition yields a nonzero
component when that form is nonzero. After principal cusp transport, the
component is a finite complex sum of positive rational translates of the
original principal form. A nebentypus component is not asserted to be a newform.
-/

noncomputable section
set_option autoImplicit false

open Matrix Matrix.SpecialLinearGroup UpperHalfPlane CongruenceSubgroup
open scoped MatrixGroups ModularForm Pointwise

namespace ZInQ.Contrib.HeckePrimeRationality.PrincipalCuspTransport

/-- The cyclic submodule generated by the actual finite diamond orbit of a cusp form. -/
def diamondSpan {L : ℕ} (k : ℤ) (g : CuspForm ((Gamma1 L).map (mapGL ℝ)) k) :
    Submodule ℂ (CuspForm ((Gamma1 L).map (mapGL ℝ)) k) :=
  Submodule.span ℂ (Set.range fun u : (ZMod L)ˣ ↦ diamondOpCusp k u g)

/-- A cusp form belongs to its own diamond-cyclic submodule. -/
theorem self_mem_diamondSpan {L : ℕ} (k : ℤ)
    (g : CuspForm ((Gamma1 L).map (mapGL ℝ)) k) : g ∈ diamondSpan k g := by
  have h : diamondOpCusp k (1 : (ZMod L)ˣ) g ∈ diamondSpan k g :=
    Submodule.subset_span ⟨1, rfl⟩
  simpa only [diamondOpCusp_one, LinearMap.id_apply] using h

/-- The actual cyclic submodule is stable under every diamond operator. -/
theorem diamondSpan_invariant {L : ℕ} (k : ℤ)
    (g : CuspForm ((Gamma1 L).map (mapGL ℝ)) k) :
    ∀ d : (ZMod L)ˣ, ∀ h ∈ diamondSpan k g, diamondOpCuspHom k d h ∈ diamondSpan k g := by
  intro d h hh
  rw [diamondOpCuspHom_apply]
  induction hh using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨u, rfl⟩ := hx
    rw [← LinearMap.comp_apply, ← diamondOpCusp_mul]
    exact Submodule.subset_span ⟨d * u, rfl⟩
  | zero => simpa only [map_zero] using (diamondSpan k g).zero_mem
  | add x y _ _ ihx ihy =>
    simpa only [map_add] using (diamondSpan k g).add_mem ihx ihy
  | smul c x _ ih =>
    simpa only [map_smul] using (diamondSpan k g).smul_mem c ih

/-- A genuine nonzero character component exists inside the actual cyclic submodule. -/
theorem exists_nonzero_diamond_component {L : ℕ} (k : ℤ)
    (g : CuspForm ((Gamma1 L).map (mapGL ℝ)) k) (hg : g ≠ 0) :
    ∃ χ : (ZMod L)ˣ →* ℂˣ, ∃ h : CuspForm ((Gamma1 L).map (mapGL ℝ)) k,
      h ≠ 0 ∧ h ∈ cuspFormCharSpace k χ ∧ h ∈ diamondSpan k g := by
  obtain ⟨a, ha, heq⟩ := exists_finsupp_of_diamondOpCusp_invariant k (diamondSpan k g)
    (diamondSpan_invariant k g) (self_mem_diamondSpan k g)
  by_contra hnone
  have hz : ∀ χ, a χ = 0 := by
    intro χ
    by_contra hχ
    exact hnone ⟨χ, a χ, hχ, (ha χ).2, (ha χ).1⟩
  have hsum : a.sum (fun _ y ↦ y) = 0 := by
    classical
    simp only [Finsupp.sum]
    exact Finset.sum_eq_zero fun χ _ ↦ hz χ
  exact hg (heq.symm.trans hsum)

/-- Finite cyclic-span membership gives actual coefficients, rather than an assumed basis. -/
theorem diamondSpan_representation {L : ℕ} [NeZero L] (k : ℤ)
    (g : CuspForm ((Gamma1 L).map (mapGL ℝ)) k)
    {h : CuspForm ((Gamma1 L).map (mapGL ℝ)) k} (hh : h ∈ diamondSpan k g) :
    ∃ c : (ZMod L)ˣ → ℂ, h = ∑ u, c u • diamondOpCusp k u g := by
  classical
  induction hh using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨u, rfl⟩ := hx
    refine ⟨fun v ↦ if v = u then 1 else 0, ?_⟩
    simp
  | zero => exact ⟨0, by simp⟩
  | add x y _ _ ihx ihy =>
    obtain ⟨cx, hx⟩ := ihx
    obtain ⟨cy, hy⟩ := ihy
    refine ⟨fun u ↦ cx u + cy u, ?_⟩
    rw [hx, hy]
    simp only [add_smul, Finset.sum_add_distrib]
  | smul b x _ ih =>
    obtain ⟨c, hc⟩ := ih
    refine ⟨fun u ↦ b * c u, ?_⟩
    rw [hc, Finset.smul_sum]
    simp only [smul_smul]

/-- Each actual diamond translate of the carrier is a normalized rational translate of f. -/
theorem diamond_transport_coe (N : ℕ) [NeZero N] (k : ℤ)
    (f : CuspForm ((Gamma N).map (mapGL ℝ)) k) (u : (ZMod (N ^ 2))ˣ)
    (γ : ↥(Gamma0 (N ^ 2))) (hγ : (Gamma0Map (N ^ 2)).toHomUnits γ = u) :
    ⇑(diamondOpCusp k u (transport N k f)) = (N : ℂ) ^ (1 - k) •
      (⇑f ∣[k] (TauCeti.scaleGL N * mapGL ℝ (γ : SL(2, ℤ)))) := by
  rw [coe_diamondOpCusp k u γ hγ, transport_coe,
    _root_.ModularForm.smul_slash_of_det_pos k
      (det_pos_of_mem_slGL (MonoidHom.mem_range.mpr ⟨γ, rfl⟩)),
    ← SlashAction.slash_mul]

/-- Integral determinant-one matrices retain their exact value under rational-to-real mapping. -/
theorem map_rational_integral (γ : SL(2, ℤ)) :
    GeneralLinearGroup.map (algebraMap ℚ ℝ) (mapGL ℚ γ) = mapGL ℝ γ := by
  rw [map_mapGL]

/-- The product of the rational dilation and an integral matrix has positive determinant. -/
theorem rational_dilation_mul_det_pos (N : ℕ) [NeZero N] (γ : SL(2, ℤ)) :
    0 < ((TauCeti.scaleGLRat N * mapGL ℚ γ : GL (Fin 2) ℚ) :
      Matrix (Fin 2) (Fin 2) ℚ).det := by
  change 0 < ((TauCeti.scaleGLRat N : Matrix (Fin 2) (Fin 2) ℚ) *
    (mapGL ℚ γ : Matrix (Fin 2) (Fin 2) ℚ)).det
  rw [Matrix.det_mul]
  have hdet : ((mapGL ℚ γ : GL (Fin 2) ℚ) : Matrix (Fin 2) (Fin 2) ℚ).det = 1 := by
    rw [← GeneralLinearGroup.val_det_apply, det_mapGL]
    rfl
  rw [hdet, mul_one]
  exact rational_dilation_det_pos N

/-- Correctly reverse-oriented partial extraction: a nonzero actual character component is a
finite positive-rational translate combination of the original principal cusp form. -/
theorem exists_nonzero_nebentypus_rational_translates (N : ℕ) [NeZero N] (k : ℤ)
    (f : CuspForm ((Gamma N).map (mapGL ℝ)) k) (hf : f ≠ 0) :
    ∃ χ : (ZMod (N ^ 2))ˣ →* ℂˣ,
      ∃ h : CuspForm ((Gamma1 (N ^ 2)).map (mapGL ℝ)) k,
        h ≠ 0 ∧ h ∈ cuspFormCharSpace k χ ∧
          ∃ c : (ZMod (N ^ 2))ˣ → ℂ, ∃ α : (ZMod (N ^ 2))ˣ → GL (Fin 2) ℚ,
            (∀ u, 0 < (α u : Matrix (Fin 2) (Fin 2) ℚ).det) ∧
              ⇑h = ∑ u, c u • (⇑f ∣[k] GeneralLinearGroup.map (algebraMap ℚ ℝ) (α u)) := by
  classical
  obtain ⟨χ, h, hh0, hhχ, hhspan⟩ := exists_nonzero_diamond_component k (transport N k f)
    (transport_ne_zero N k hf)
  obtain ⟨c, hc⟩ := diamondSpan_representation k (transport N k f) hhspan
  choose γ hγ using (fun u : (ZMod (N ^ 2))ˣ ↦ Gamma0Map_toHomUnits_surjective u)
  refine ⟨χ, h, hh0, hhχ, fun u ↦ c u * (N : ℂ) ^ (1 - k),
    fun u ↦ TauCeti.scaleGLRat N * mapGL ℚ (γ u : SL(2, ℤ)),
    fun u ↦ rational_dilation_mul_det_pos N _, ?_⟩
  rw [hc, FunLike.coe_sum]
  apply Finset.sum_congr rfl
  intro u _
  rw [FunLike.coe_smul, diamond_transport_coe N k f u (γ u) (hγ u), smul_smul,
    map_mul, TauCeti.map_ratCast_scaleGLRat, map_rational_integral]

end ZInQ.Contrib.HeckePrimeRationality.PrincipalCuspTransport
