/-!
# shimura-split, Part 1: field of moduli = residue field, on a fine and on a coarse witness

leaf-qm-fp (§2.4) kept `R1rec` (object form, field of moduli) beside `R1recProps` (point form, residue
field) because "the bridge from fields of moduli to residue fields needs the uniqueness of base change up
to isomorphism of objects, which needs rigidity, and Mathlib does not have this". The kernel now proves
rigidity (`MulRigidity.isMonHom_of_geometricallyIntegral`, `ZInQKernel/Contrib/FrobChain/Rigidity.lean`).
This file proves the bridge:

* `bc_unique3` / `bc_uniquePair`: two base changes of one object along one field map are isomorphic;
* `fixing_iff`: `σ` fixes the residue image of a `ℚ̄`-point `y` iff `y ∘ Spec σ = y`;
* `fieldOfModuli3_eq_residueImage` (fine witness, `R1fpProps`) and
  `fieldOfModuliPair_eq_residueImage` (coarse witness, `X6Props`).
-/

set_option linter.all false

noncomputable section

namespace ShimuraSplit

open CategoryTheory AlgebraicGeometry Limits MonoidalCategory CartesianMonoidalCategory MonObj
open LeafQM LeafQM.AV PkgI3

/-! ## §1 The identity point -/

theorem pt_one_left {L : Type} [Field L] (A : AbVar L) :
    (1 : A.Pt L).left = η[A.X].left := by
  rw [Hom.one_def]
  simp [AbVar.ptObj]


/-! ## §2 Uniqueness of base change up to isomorphism (rigidity) -/

section BC

variable {K L : Type} [Field K] [Field L]

theorem over_ext_pb {A : AbVar K} {B' : AbVar L} {f : K →+* L} {g' : B'.X.left ⟶ A.X.left}
    (pb' : IsPullback g' B'.X.hom A.X.hom (Spec.map (CommRingCat.ofHom f)))
    {T : Over (Spec (CommRingCat.of L))} {u v : T ⟶ B'.X} (hg : u.left ≫ g' = v.left ≫ g') : u = v :=
  Over.OverMorphism.ext (pb'.hom_ext hg (by rw [Over.w u, Over.w v]))

/-- **Core.** Two pullbacks `B, B'` of `A` along `Spec f`, whose identity sections lie over the identity
section of `A`, are isomorphic over `A` by mutually inverse homomorphisms (rigidity). -/
theorem bc_core (f : K →+* L) (A : AbVar K) (B B' : AbVar L)
    (g : B.X.left ⟶ A.X.left) (g' : B'.X.left ⟶ A.X.left)
    (pb : IsPullback g B.X.hom A.X.hom (Spec.map (CommRingCat.ofHom f)))
    (pb' : IsPullback g' B'.X.hom A.X.hom (Spec.map (CommRingCat.ofHom f)))
    (h1 : η[B.X].left ≫ g = Spec.map (CommRingCat.ofHom f) ≫ η[A.X].left)
    (h1' : η[B'.X].left ≫ g' = Spec.map (CommRingCat.ofHom f) ≫ η[A.X].left) :
    ∃ (E : B.X ⟶ B'.X) (F : B'.X ⟶ B.X), IsMonHom E ∧ IsMonHom F ∧ E ≫ F = 𝟙 _ ∧ F ≫ E = 𝟙 _ ∧
      E.left ≫ g' = g ∧ F.left ≫ g = g' := by
  let e := pb.isoIsPullback _ _ pb'
  let E : B.X ⟶ B'.X := Over.homMk e.hom (by simp [e])
  let F : B'.X ⟶ B.X := Over.homMk e.inv (by simp [e])
  have hEg : E.left ≫ g' = g := by simp [E, e]
  have hFg : F.left ≫ g = g' := by simp [F, e]
  have hE : η[B.X] ≫ E = η[B'.X] := by
    apply over_ext_pb pb'
    simp only [Over.comp_left, Category.assoc, hEg, h1, h1']
  have hF : η[B'.X] ≫ F = η[B.X] := by
    apply over_ext_pb pb
    simp only [Over.comp_left, Category.assoc, hFg, h1, h1']
  refine ⟨E, F, MulRigidity.isMonHom_of_geometricallyIntegral _ _ E hE,
    MulRigidity.isMonHom_of_geometricallyIntegral _ _ F hF, ?_, ?_, hEg, hFg⟩
  · ext1; simp [E, F, e]
  · ext1; simp [E, F, e]


/-- **Two base changes of one level-3 object along one field map are isomorphic.** -/
theorem bc_unique3 {f : K →+* L} {P : QML3 K} {Q Q' : QML3 L} (h : IsBaseChangeOf f P Q)
    (h' : IsBaseChangeOf f P Q') : Nonempty (Q.Iso Q') := by
  obtain ⟨g, pb, hι, hη⟩ := h
  obtain ⟨g', pb', hι', hη'⟩ := h'
  have h1 : η[Q.A.X].left ≫ g = Spec.map (CommRingCat.ofHom f) ≫ η[P.A.X].left := by
    have := hη 0
    simp only [map_zero, toMul_zero] at this
    rwa [pt_one_left, pt_one_left] at this
  have h1' : η[Q'.A.X].left ≫ g' = Spec.map (CommRingCat.ofHom f) ≫ η[P.A.X].left := by
    have := hη' 0
    simp only [map_zero, toMul_zero] at this
    rwa [pt_one_left, pt_one_left] at this
  obtain ⟨E, F, hE, hF, hEF, hFE, hEg, hFg⟩ := bc_core f P.A Q.A Q'.A g g' pb pb' h1 h1'
  refine ⟨⟨AbVar.Hom.mk' E, AbVar.Hom.mk' F, hEF, hFE, fun a => ?_, fun a => ?_⟩⟩
  · simp only [AbVar.Hom.hom_mk']
    apply over_ext_pb pb'
    simp only [Over.comp_left, Category.assoc, hEg, hι', reassoc_of% hEg, hι]
  · apply Additive.toMul.injective
    simp only [toMul_ofMul, AbVar.Hom.hom_mk']
    apply over_ext_pb pb'
    simp only [Over.comp_left, Category.assoc, hEg, hη, hη']
    try rfl

/-- **Base change is transported along an isomorphism of the target.** -/
theorem bc_transport3 {f : K →+* L} {P : QML3 K} {Q Q' : QML3 L} (h : IsBaseChangeOf f P Q)
    (i : Q'.Iso Q) : IsBaseChangeOf f P Q' := by
  obtain ⟨g, pb, hι, hη⟩ := h
  have hφψ : i.φ.hom.left ≫ i.ψ.hom.left = 𝟙 _ := by rw [← Over.comp_left, i.left]; rfl
  have hψφ : i.ψ.hom.left ≫ i.φ.hom.left = 𝟙 _ := by rw [← Over.comp_left, i.right]; rfl
  let e : Q'.A.X.left ≅ Q.A.X.left := ⟨i.φ.hom.left, i.ψ.hom.left, hφψ, hψφ⟩
  refine ⟨i.φ.hom.left ≫ g, ?_, fun a => ?_, fun a => ?_⟩
  · refine pb.of_iso e.symm (Iso.refl _) (Iso.refl _) (Iso.refl _) ?_ ?_ ?_ ?_
    · simp [e, reassoc_of% hψφ]
    · simp only [Iso.symm_hom, Iso.refl_hom, Category.comp_id, e]
      rw [Over.w i.ψ.hom]
    · simp
    · simp
  · rw [← Category.assoc, ← Over.comp_left, i.equivariant a, Over.comp_left, Category.assoc, hι,
      Category.assoc]
  · have hl := congrArg (fun z => (Additive.toMul z).left) (i.level a)
    simp only [toMul_ofMul, Over.comp_left] at hl
    rw [← Category.assoc, hl, hη]

/-- **Two base changes of one QM pair along one field map are isomorphic.** -/
theorem bc_uniquePair {f : K →+* L} {P : QMPair K} {Q Q' : QMPair L} (h : IsBaseChangeOfPair f P Q)
    (h' : IsBaseChangeOfPair f P Q') : Nonempty (QMIso Q.q Q'.q) := by
  obtain ⟨g, pb, hι, hη⟩ := h
  obtain ⟨g', pb', hι', hη'⟩ := h'
  rw [pt_one_left, pt_one_left] at hη hη'
  obtain ⟨E, F, hE, hF, hEF, hFE, hEg, hFg⟩ := bc_core f P.A Q.A Q'.A g g' pb pb' hη hη'
  refine ⟨⟨AbVar.Hom.mk' E, AbVar.Hom.mk' F, hEF, hFE, fun a => ?_⟩⟩
  simp only [AbVar.Hom.hom_mk']
  apply over_ext_pb pb'
  simp only [Over.comp_left, Category.assoc, hEg, hι', reassoc_of% hEg, hι]

/-- **Base change of QM pairs is transported along an isomorphism of the target.** -/
theorem bc_transportPair {f : K →+* L} {P : QMPair K} {Q Q' : QMPair L}
    (h : IsBaseChangeOfPair f P Q) (i : QMIso Q'.q Q.q) : IsBaseChangeOfPair f P Q' := by
  obtain ⟨g, pb, hι, hη⟩ := h
  have hφψ : i.φ.hom.left ≫ i.ψ.hom.left = 𝟙 _ := by rw [← Over.comp_left, i.left]; rfl
  have hψφ : i.ψ.hom.left ≫ i.φ.hom.left = 𝟙 _ := by rw [← Over.comp_left, i.right]; rfl
  let e : Q'.A.X.left ≅ Q.A.X.left := ⟨i.φ.hom.left, i.ψ.hom.left, hφψ, hψφ⟩
  refine ⟨i.φ.hom.left ≫ g, ?_, fun a => ?_, ?_⟩
  · refine pb.of_iso e.symm (Iso.refl _) (Iso.refl _) (Iso.refl _) ?_ ?_ ?_ ?_
    · simp [e, reassoc_of% hψφ]
    · simp only [Iso.symm_hom, Iso.refl_hom, Category.comp_id, e]
      rw [Over.w i.ψ.hom]
    · simp
    · simp
  · rw [← Category.assoc, ← Over.comp_left, i.equivariant a, Over.comp_left, Category.assoc, hι,
      Category.assoc]
  · rw [← Category.assoc, ← Over.comp_left, MonObj.one_comp, hη]

end BC


/-! ## §3 The Galois correspondence for residue images -/

section Galois

/-- **`σ` fixes the residue image of a `ℚ̄`-point `y` iff `y ∘ Spec σ = y`.** -/
theorem fixing_iff {X : Scheme.{0}} (y : Spec (CommRingCat.of Qbar) ⟶ X) (σ : Qbar ≃ₐ[ℚ] Qbar) :
    Spec.map (CommRingCat.ofHom (σ : Qbar →+* Qbar)) ≫ y = y ↔
      σ ∈ (residueImage y).fixingSubgroup := by
  rw [IntermediateField.mem_fixingSubgroup_iff]
  unfold residueImage
  generalize hp : Scheme.SpecToEquivOfField Qbar X y = p
  have hfix : (∀ t, σ (p.2 t) = p.2 t) ↔
      ∀ z ∈ IntermediateField.adjoin ℚ (Set.range p.2), σ z = z := by
    constructor
    · intro h z hz
      induction hz using IntermediateField.adjoin_induction with
      | mem x hx => obtain ⟨t, rfl⟩ := hx; exact h t
      | algebraMap r => exact σ.commutes r
      | add x y _ _ hx hy => rw [map_add, hx, hy]
      | inv x _ hx => rw [map_inv₀, hx]
      | mul x y _ _ hx hy => rw [map_mul, hx, hy]
    · intro h t
      exact h _ (IntermediateField.subset_adjoin _ _ ⟨t, rfl⟩)
  rw [← hfix]
  constructor
  · intro h t
    have h2 := congrArg (Scheme.SpecToEquivOfField Qbar X) h
    rw [specToEquivOfField_comp, hp] at h2
    have h3 : p.2 ≫ CommRingCat.ofHom (σ : Qbar →+* Qbar) = p.2 :=
      eq_of_heq (Sigma.mk.inj_iff.mp h2).2
    exact congrArg (fun φ => φ t) (congrArg CommRingCat.Hom.hom h3)
  · intro h
    apply (Scheme.SpecToEquivOfField Qbar X).injective
    rw [specToEquivOfField_comp, hp]
    have h3 : p.2 ≫ CommRingCat.ofHom (σ : Qbar →+* Qbar) = p.2 := by
      ext t; exact h t
    rw [h3]

end Galois

/-! ## §4 Field of moduli = residue field -/

section Bridge

/-- **On a fine witness, the field of moduli of the object at a `ℚ̄`-point is the residue image of the
point.** -/
theorem fieldOfModuli3_eq_residueImage {Y : Over (Spec (CommRingCat.of ℚ))} {Φ : PtEquiv Y}
    (h1 : R1fpProps Y Φ) (y : fieldPt Qbar ⟶ Y) (P : QML3 Qbar) (hP : Φ Qbar y = M3.mk P) :
    fieldOfModuli3 P = residueImage y.left := by
  have hstab : stab3 P = ((residueImage y.left).fixingSubgroup : Set (Qbar ≃ₐ[ℚ] Qbar)) := by
    ext σ
    rw [SetLike.mem_coe]
    refine Iff.trans ?_ (fixing_iff (X := Y.left) y.left σ)
    obtain ⟨-, -, -, hnat, -, -⟩ := h1
    obtain ⟨Q, hQ, hbc⟩ := hnat Qbar Qbar (σ : Qbar →ₐ[ℚ] Qbar) y P hP
    constructor
    · intro hσ
      obtain ⟨i⟩ := bc_unique3 hbc hσ
      have e : Φ Qbar (fieldMap (σ : Qbar →ₐ[ℚ] Qbar) ≫ y) = Φ Qbar y := by
        rw [hQ, hP]; exact Quotient.sound ⟨i⟩
      have e2 := congrArg Over.Hom.left ((Φ Qbar).injective e)
      rw [Over.comp_left] at e2; exact e2
    · intro hy
      have e : fieldMap (σ : Qbar →ₐ[ℚ] Qbar) ≫ y = y := by
        apply Over.OverMorphism.ext
        rw [Over.comp_left]; exact hy
      rw [e, hP] at hQ
      obtain ⟨i⟩ := Quotient.exact hQ
      exact bc_transport3 hbc i
  unfold fieldOfModuli3
  rw [hstab, Subgroup.closure_eq, InfiniteGalois.fixedField_fixingSubgroup]

/-- **On a coarse witness (`X6Props`), the field of moduli of the QM pair at a `ℚ̄`-point is the residue
image of the point.** -/
theorem fieldOfModuliPair_eq_residueImage {Y : Over (Spec (CommRingCat.of ℚ))} {Φ : PtEquiv Y}
    {X : Over (Spec (CommRingCat.of ℚ))} {Ψ : (fieldPt Qbar ⟶ X) ≃ Quotient (pairSetoid Qbar)}
    {fY : Y ⟶ X} (h6 : X6Props Y Φ X Ψ fY) (x : fieldPt Qbar ⟶ X) (P : QMPair Qbar)
    (hP : Ψ x = Quotient.mk _ P) :
    fieldOfModuliPair P = residueImage x.left := by
  have hstab : stabPair P = ((residueImage x.left).fixingSubgroup : Set (Qbar ≃ₐ[ℚ] Qbar)) := by
    ext σ
    rw [SetLike.mem_coe]
    refine Iff.trans ?_ (fixing_iff (X := X.left) x.left σ)
    obtain ⟨-, -, -, hgal, -, -⟩ := h6
    obtain ⟨Q, hQ, hbc⟩ := hgal σ x P hP
    constructor
    · intro hσ
      obtain ⟨i⟩ := bc_uniquePair hbc hσ
      have e : Ψ (fieldMap (σ : Qbar →ₐ[ℚ] Qbar) ≫ x) = Ψ x := by
        rw [hQ, hP]; exact Quotient.sound ⟨i⟩
      have e2 := congrArg Over.Hom.left (Ψ.injective e)
      rw [Over.comp_left] at e2; exact e2
    · intro hy
      have e : fieldMap (σ : Qbar →ₐ[ℚ] Qbar) ≫ x = x := by
        apply Over.OverMorphism.ext
        rw [Over.comp_left]; exact hy
      rw [e, hP] at hQ
      obtain ⟨i⟩ := Quotient.exact hQ
      exact bc_transportPair hbc i
  unfold fieldOfModuliPair
  rw [hstab, Subgroup.closure_eq, InfiniteGalois.fixedField_fixingSubgroup]


/-! ## §5 The object forms `R1rec`, `R5fp` from the point forms on one witness -/

/-- **`R1rec` (object form) from the point form `R1recProps` on one fine witness.** -/
theorem r1rec_of_point (h : ∃ (Y : Over (Spec (CommRingCat.of ℚ))) (Φ : PtEquiv Y),
    R1fpProps Y Φ ∧ R1recProps Y Φ) : R1rec := by
  obtain ⟨Y, Φ, h1, hr⟩ := h
  intro P hcm
  obtain ⟨y, hy⟩ := (Φ Qbar).surjective (M3.mk P)
  rw [fieldOfModuli3_eq_residueImage h1 y P hy]
  exact hr y P hy hcm

/-- Conversely, on a fine witness the object form gives the point form. -/
theorem point_of_r1rec (h : R1rec) {Y : Over (Spec (CommRingCat.of ℚ))} {Φ : PtEquiv Y}
    (h1 : R1fpProps Y Φ) : R1recProps Y Φ := by
  intro y P hy hcm
  rw [← fieldOfModuli3_eq_residueImage h1 y P hy]
  exact h P hcm

/-- **`R5fp` (object form) from the point form `R5ptProps` on one coarse witness.** -/
theorem r5fp_of_point (h : ∃ (Y : Over (Spec (CommRingCat.of ℚ))) (Φ : PtEquiv Y)
    (X : Over (Spec (CommRingCat.of ℚ))) (Ψ : (fieldPt Qbar ⟶ X) ≃ Quotient (pairSetoid Qbar))
    (fY : Y ⟶ X), X6Props Y Φ X Ψ fY ∧ R5ptProps X Ψ) : R5fp := by
  obtain ⟨Y, Φ, X, Ψ, fY, h6, h5⟩ := h
  intro k _ _ _ hk R hR hc P hP
  have hx : Ψ (Ψ.symm (Quotient.mk _ P)) = Quotient.mk _ P := Ψ.apply_symm_apply _
  have key : ∀ A B : IntermediateField ℚ Qbar, A = B →
      (Module.finrank ℚ A = (if inertCount6 k = 0 then 1 else 2) * Nat.card (CommRing.Pic R) ∧
        (inertCount6 k ≠ 0 → Nonempty (k →ₐ[ℚ] A))) →
      (Module.finrank ℚ B = (if inertCount6 k = 0 then 1 else 2) * Nat.card (CommRing.Pic R) ∧
        (inertCount6 k ≠ 0 → Nonempty (k →ₐ[ℚ] B))) := by
    rintro A B rfl h; exact h
  exact key _ _ (fieldOfModuliPair_eq_residueImage h6 _ P hx).symm (h5 k hk R hR hc _ P hx hP)

/-- Conversely, on a coarse witness the object form gives the point form. -/
theorem point_of_r5fp (h : R5fp) {Y : Over (Spec (CommRingCat.of ℚ))} {Φ : PtEquiv Y}
    {X : Over (Spec (CommRingCat.of ℚ))} {Ψ : (fieldPt Qbar ⟶ X) ≃ Quotient (pairSetoid Qbar)}
    {fY : Y ⟶ X} (h6 : X6Props Y Φ X Ψ fY) : R5ptProps X Ψ := by
  intro k _ _ _ hk R hR hc x P hx hP
  have key : ∀ A B : IntermediateField ℚ Qbar, A = B →
      (Module.finrank ℚ A = (if inertCount6 k = 0 then 1 else 2) * Nat.card (CommRing.Pic R) ∧
        (inertCount6 k ≠ 0 → Nonempty (k →ₐ[ℚ] A))) →
      (Module.finrank ℚ B = (if inertCount6 k = 0 then 1 else 2) * Nat.card (CommRing.Pic R) ∧
        (inertCount6 k ≠ 0 → Nonempty (k →ₐ[ℚ] B))) := by
    rintro A B rfl h; exact h
  exact key _ _ (fieldOfModuliPair_eq_residueImage h6 x P hx) (h k hk R hR hc P hP)

end Bridge

end ShimuraSplit

#print axioms ShimuraSplit.fieldOfModuli3_eq_residueImage
#print axioms ShimuraSplit.fieldOfModuliPair_eq_residueImage
#print axioms ShimuraSplit.r1rec_of_point
#print axioms ShimuraSplit.r5fp_of_point
#print axioms ShimuraSplit.point_of_r1rec
#print axioms ShimuraSplit.point_of_r5fp


/-!
# shimura-split, Part 2: the orbit computation for `Y3Connected` (row H-59)

The row `TSHecke.Y3Connected` (`∃ (Y, Φ), R1fpProps Y Φ ∧ ConnectedSpace Y.left`) is a composite: Deligne's
description of the geometric components of a Shimura variety with the Galois action on them (Deligne,
*Travaux de Shimura*, Sém. Bourbaki 389 (1971), §§2-3; *Variétés de Shimura*, PSPM 33 (1979), 2.1, 2.6.3),
specialized to `K₃`, **plus** an orbit computation (the Galois group acts transitively on the components,
hence `Y₃` is connected over `ℚ`). This file states the first as a leaf over genuine definitions (the
connected components of the base change `Y ×_ℚ Spec ℚ̄`, the action of `Aut(ℚ̄/ℚ)` on it, and the mod-3
cyclotomic character) and proves the row from it in Lean.
-/

set_option linter.all false

noncomputable section

namespace ShimuraSplit

open CategoryTheory AlgebraicGeometry Limits
open LeafQM LeafQM.AV

/-- `Spec ℚ̄ → Spec ℚ`. -/
abbrev sQbar : Spec (CommRingCat.of Qbar) ⟶ Spec (CommRingCat.of ℚ) :=
  Spec.map (CommRingCat.ofHom (algebraMap ℚ Qbar))

/-- The base change `Y_ℚ̄ = Y ×_{Spec ℚ} Spec ℚ̄` of a `ℚ`-scheme. -/
abbrev baseQbar (Y : Over (Spec (CommRingCat.of ℚ))) : Scheme := pullback Y.hom sQbar

theorem specMap_sigma_comp (σ : Qbar ≃ₐ[ℚ] Qbar) :
    Spec.map (CommRingCat.ofHom (σ : Qbar →+* Qbar)) ≫ sQbar = sQbar := by
  rw [sQbar, ← Spec.map_comp, ← CommRingCat.ofHom_comp]
  congr 2
  exact (σ : Qbar →ₐ[ℚ] Qbar).comp_algebraMap

/-- **The action of `σ ∈ Aut(ℚ̄/ℚ)` on `Y_ℚ̄`**: `id_Y × Spec σ`. -/
def galAct (Y : Over (Spec (CommRingCat.of ℚ))) (σ : Qbar ≃ₐ[ℚ] Qbar) : baseQbar Y ⟶ baseQbar Y :=
  pullback.map _ _ _ _ (𝟙 _) (Spec.map (CommRingCat.ofHom (σ : Qbar →+* Qbar))) (𝟙 _)
    (by simp) (by rw [Category.comp_id, specMap_sigma_comp])

theorem galAct_fst (Y : Over (Spec (CommRingCat.of ℚ))) (σ : Qbar ≃ₐ[ℚ] Qbar) :
    galAct Y σ ≫ pullback.fst _ _ = pullback.fst _ _ := by
  simp [galAct]

/-- The induced map on the connected components of `Y_ℚ̄`. -/
def galActπ₀ (Y : Over (Spec (CommRingCat.of ℚ))) (σ : Qbar ≃ₐ[ℚ] Qbar) :
    _root_.ConnectedComponents (baseQbar Y) → _root_.ConnectedComponents (baseQbar Y) :=
  (galAct Y σ).continuous.connectedComponentsMap

theorem exists_primitive3 : ∃ ω : Qbar, IsPrimitiveRoot ω 3 := by
  obtain ⟨ω, hω⟩ := IsAlgClosed.exists_root (Polynomial.cyclotomic 3 Qbar)
    (by rw [Polynomial.degree_cyclotomic]; norm_num)
  exact ⟨ω, (Polynomial.isRoot_cyclotomic_iff).1 hω⟩

/-- `ℚ̄` contains exactly three cube roots of unity. -/
theorem card_mu3 : Nat.card {x // x ∈ rootsOfUnity 3 Qbar} = 3 :=
  exists_primitive3.choose_spec.card_rootsOfUnity

/-- **The mod-3 cyclotomic character** `χ₃ : Aut(ℚ̄/ℚ) → (ℤ/3)^×` (Mathlib's
`modularCyclotomicCharacter`: `σ(ζ) = ζ^{χ₃(σ)}` for every cube root of unity `ζ`). -/
def chi3 (σ : Qbar ≃ₐ[ℚ] Qbar) : (ZMod 3)ˣ :=
  modularCyclotomicCharacter Qbar card_mu3 σ.toRingEquiv

/-- **LEAF (Deligne's components of `Sh_{K₃}` with the Galois action; specialization).**

*Published statement* (Deligne, *Travaux de Shimura*, Sém. Bourbaki 389 (1971), §§2-3; *Variétés de
Shimura*, PSPM 33 (1979), 2.1 and Thm 2.6.3; Milne, *Introduction to Shimura varieties* (2005), Thm 5.17
and §13; locators UNVERIFIED, no network): for `G = B^×` the set of connected components of
`Sh_K(G, X)_ℚ̄` is `π₀ = ℚ^×_{>0} \ 𝔸_f^× / nrd(K)`, and `σ ∈ Gal(ℚ̄/ℚ)` acts on it by multiplication by
`art⁻¹(σ|ℚ^ab) ∈ ℤ̂^×` (up to the sign convention of the reciprocity map).

*Lean form*: some fine witness `(Y, Φ)` (the canonical model `Y₃ = Sh_{K₃}`, as in `CanonicalModelY3`) has
a bijection `c : π₀(Y_ℚ̄) ≃ (ℤ/3)^×` under which `σ` acts by multiplication by `χ₃(σ)`.

*Why a specialization of the display (with one computation)*: for `K₃ = ker(𝒪̂^× → (𝒪/3𝒪)^×)`,
`nrd(K₃) = ∏_{ℓ≠3} ℤ_ℓ^× × (1 + 3ℤ_3)` (`nrd(𝒪_ℓ^×) = ℤ_ℓ^×` for every `ℓ`, and `nrd(1 + 3𝒪_3) = 1 + 3ℤ_3`),
and `𝔸_f^× = ℚ^×_{>0} · ℤ̂^×` with `ℚ^×_{>0} ∩ ℤ̂^× = 1`, so `π₀ = ℤ̂^×/nrd(K₃) = (ℤ/3)^×`; the image of
`art⁻¹(σ)` there is `χ₃(σ)^{±1} = χ₃(σ)` (`χ₃` has order 2, so the sign convention does not matter).
The computation of `nrd(K₃)` is not formalized (no local quaternion algebras in Mathlib); ts-hecke's
`pi0_check.py` checks the two orbits in Shimura's uniformization `𝒪^× \ (ℍ^± × (𝒪/3𝒪)^×)`.
So this leaf is a **consequence of one theorem** (Deligne's `π₀`), not its printed form. -/
def DeligneComponentsY3 : Prop :=
  ∃ (Y : Over (Spec (CommRingCat.of ℚ))) (Φ : PtEquiv Y), R1fpProps Y Φ ∧
    ∃ c : _root_.ConnectedComponents (baseQbar Y) ≃ (ZMod 3)ˣ,
      ∀ (σ : Qbar ≃ₐ[ℚ] Qbar) (z : _root_.ConnectedComponents (baseQbar Y)),
        c (galActπ₀ Y σ z) = chi3 σ * c z

/-! ## The orbit computation -/

/-- Some `σ ∈ Aut(ℚ̄/ℚ)` has `χ₃(σ) = −1` (it sends a primitive cube root of unity `ω` to `ω²`). -/
theorem exists_chi3_neg : ∃ σ : Qbar ≃ₐ[ℚ] Qbar, chi3 σ = -1 := by
  obtain ⟨ω, hprim⟩ := exists_primitive3
  have hprim2 : IsPrimitiveRoot (ω ^ 2) 3 := hprim.pow_of_coprime 2 (by norm_num)
  have hmin : minpoly ℚ (ω ^ 2) = minpoly ℚ ω := by
    rw [← Polynomial.cyclotomic_eq_minpoly_rat hprim2 (by norm_num),
      ← Polynomial.cyclotomic_eq_minpoly_rat hprim (by norm_num)]
  obtain ⟨σ, hσ⟩ := (Normal.minpoly_eq_iff_mem_orbit (F := ℚ) (E := Qbar)).1 hmin
  change σ • ω = ω ^ 2 at hσ
  rw [AlgEquiv.smul_def] at hσ
  refine ⟨σ, ?_⟩
  set u : Qbarˣ := (hprim.isUnit (by norm_num)).unit with hu
  have hu1 : (u : Qbar) = ω := rfl
  have hmem : u ∈ rootsOfUnity 3 Qbar := by
    rw [mem_rootsOfUnity]; ext; simp [hu1, hprim.pow_eq_one]
  have hspec := modularCyclotomicCharacter.spec Qbar card_mu3 σ.toRingEquiv hmem
  change σ (u : Qbar) = (u : Qbar) ^ _ at hspec
  rw [hu1, hσ] at hspec
  have hval : ((chi3 σ : (ZMod 3)ˣ) : ZMod 3).val = 2 :=
    (hprim.pow_inj (by norm_num) (ZMod.val_lt _) hspec).symm
  apply Units.ext
  apply ZMod.val_injective
  rw [hval]
  rfl

theorem units_zmod3 (t u : (ZMod 3)ˣ) : u = t ∨ u = -1 * t := by
  revert t u; decide

instance : AlgebraicGeometry.Surjective sQbar := by
  constructor
  intro x
  obtain ⟨y⟩ := (inferInstance : Nonempty (Spec (CommRingCat.of Qbar)))
  exact ⟨y, Subsingleton.elim _ _⟩

/-- **The orbit computation (row H-59 from the leaf)**: if `Aut(ℚ̄/ℚ)` acts on `π₀(Y_ℚ̄) ≃ (ℤ/3)^×` by
`χ₃`, then `Y` is connected (a clopen `U ⊆ Y` pulls back to a Galois-stable clopen of `Y_ℚ̄`, a union of
components whose labels form a `χ₃`-stable subset of `(ℤ/3)^×`, hence `∅` or everything). -/
theorem y3Connected_of_deligne (h : DeligneComponentsY3) :
    ∃ (Y : Over (Spec (CommRingCat.of ℚ))) (Φ : PtEquiv Y), R1fpProps Y Φ ∧ ConnectedSpace Y.left := by
  obtain ⟨Y, Φ, h1, c, hc⟩ := h
  refine ⟨Y, Φ, h1, ?_⟩
  obtain ⟨-, -, ⟨y₀⟩, -, -, -⟩ := h1
  rw [connectedSpace_iff_clopen]
  refine ⟨⟨y₀.left (IsLocalRing.closedPoint _)⟩, fun U hU => ?_⟩
  let p : baseQbar Y ⟶ Y.left := pullback.fst _ _
  have hpsurj : Function.Surjective p := p.surjective
  let V : Set (baseQbar Y) := p ⁻¹' U
  have hV : IsClopen V := hU.preimage p.continuous
  by_contra hne
  rw [not_or] at hne
  obtain ⟨hne0, hne1⟩ := hne
  obtain ⟨u, hu⟩ := Set.nonempty_iff_ne_empty.2 hne0
  obtain ⟨u', hu'⟩ : ∃ u', u' ∉ U := by
    by_contra hall
    exact hne1 (Set.eq_univ_of_forall fun a => by by_contra ha; exact hall ⟨a, ha⟩)
  obtain ⟨z, hz⟩ := hpsurj u
  obtain ⟨z', hz'⟩ := hpsurj u'
  have hzV : z ∈ V := by show p z ∈ U; rw [hz]; exact hu
  have hz'V : z' ∉ V := by show p z' ∉ U; rw [hz']; exact hu'
  -- labels of components inside `V`
  let T : Set (ZMod 3)ˣ := {t | ∃ w ∈ V, c (ConnectedComponents.mk w) = t}
  have hT : ∀ σ : Qbar ≃ₐ[ℚ] Qbar, ∀ t ∈ T, chi3 σ * t ∈ T := by
    rintro σ t ⟨w, hw, rfl⟩
    refine ⟨galAct Y σ w, ?_, ?_⟩
    · show p (galAct Y σ w) ∈ U
      change (pullback.fst Y.hom sQbar) (galAct Y σ w) ∈ U
      rw [← Scheme.Hom.comp_apply, galAct_fst]; exact hw
    · rw [← hc σ]; rfl
  obtain ⟨σ, hσ⟩ := exists_chi3_neg
  have hzT : c (ConnectedComponents.mk z) ∈ T := ⟨z, hzV, rfl⟩
  rcases units_zmod3 (c (ConnectedComponents.mk z)) (c (ConnectedComponents.mk z')) with e | e
  · -- same component as `z`
    have hmk : ConnectedComponents.mk z' = ConnectedComponents.mk z := c.injective e
    rw [ConnectedComponents.coe_eq_coe'] at hmk
    exact hz'V (hV.connectedComponent_subset hzV hmk)
  · obtain ⟨w, hw, hwe⟩ := hT σ _ hzT
    rw [hσ, ← e] at hwe
    have hmk : ConnectedComponents.mk z' = ConnectedComponents.mk w := c.injective hwe.symm
    rw [ConnectedComponents.coe_eq_coe'] at hmk
    exact hz'V (hV.connectedComponent_subset hw hmk)

end ShimuraSplit

#print axioms ShimuraSplit.y3Connected_of_deligne


/-!
# shimura-split, Part 3: `R5fpCount` (row r5count) from González–Rotger's count on the points of `X₆`

`R5fpCount` counts isomorphism classes of QM pairs over `ℚ̄` with `End_𝒪(A) ≅ R`. González–Rotger
Prop. 5.6 counts CM points by `R` on the curve `X₀(6,1)`. The two agree through the moduli interpretation
of `X₆` (`X6Props`: `Ψ : X(ℚ̄) ≃ {QM pairs over ℚ̄}/≅`). This file states the count on the points of one
coarse witness (the canonical model, as `CanonicalCoarseX6`/`GonzalezRotgerX6` do for the other clauses) and
proves the row from it.
-/

set_option linter.all false

noncomputable section

namespace ShimuraSplit

open CategoryTheory AlgebraicGeometry Limits
open LeafQM LeafQM.AV

/-- **LEAF-form (González–Rotger Prop. 5.6 on the points of the canonical `X₆ = X₀(6,1)`).**

*Published statement* (González–Rotger, J. Math. Soc. Japan 58 (2006), Prop. 5.6, p. 943, read by the
locator audit in arXiv v1/v2 and the journal): for an order `R` of conductor prime to `DN` in an imaginary
quadratic field `k` that embeds optimally in the Eichler order of level `N` of the quaternion algebra of
discriminant `D`, the number of CM points by `R` on `X₀(D,N)` is `#CM(R) = 2^{#{p | D(R)N(R)}} h(R)`.
At `D = 6`, `N = 1`: `D(R)` is the product of the primes `p | 6` inert in `k` (rv-nocm §3.1), so
`#CM(R) = 2^{b(k)} h(R)` with `b(k) = inertCount6 k` and `h(R) = #Pic(R)`.

*Lean form*: some witness `(Y, Φ, X, Ψ, fY)` of the clause lists `R1fpProps`, `X6Props` (the canonical models
`Y₃`, `X₆` with the moduli interpretation of `X₆(ℚ̄)`) has, for every such `R` occurring as some
`End_𝒪(A)`, exactly `2^{b(k)} #Pic(R)` points `x ∈ X(ℚ̄)` whose QM pair has `End_𝒪(A) ≅ R` ("CM by `R`").

*Why faithful*: the printed count specialized to `(D, N) = (6, 1)`; "CM point by `R`" is a point whose QM pair
has `End_𝒪(A) = com ι ≅ R`. The hypotheses "conductor prime to 6" and "`R` occurs" are the printed ones
(optimal embedding). Lemma QP (polarizations) as for `R1fp`. Locators: the audit read Prop. 5.6. -/
def GonzalezRotgerCountX6 : Prop :=
  ∃ (Y : Over (Spec (CommRingCat.of ℚ))) (Φ : PtEquiv Y) (X : Over (Spec (CommRingCat.of ℚ)))
    (Ψ : (fieldPt Qbar ⟶ X) ≃ Quotient (pairSetoid Qbar)) (fY : Y ⟶ X),
    R1fpProps Y Φ ∧ X6Props Y Φ X Ψ fY ∧
    ∀ (k : Type) [Field k] [NumberField k] [NumberField.IsTotallyComplex k],
      Module.finrank ℚ k = 2 →
      ∀ R : Subring k, R ≤ (integralClosure ℤ k).toSubring → Nat.Coprime (conductor R) 6 →
        (∃ P : QMPair Qbar, Nonempty (com P.q ≃+* R)) →
          Nat.card {x : fieldPt Qbar ⟶ X //
              ∃ P : QMPair Qbar, Ψ x = Quotient.mk _ P ∧ Nonempty (com P.q ≃+* R)} =
            2 ^ inertCount6 k * Nat.card (CommRing.Pic R)

/-- **Row r5count from the count on points** (transport through the moduli bijection `Ψ`). -/
theorem r5fpCount_of_points (h : GonzalezRotgerCountX6) : R5fpCount := by
  obtain ⟨Y, Φ, X, Ψ, fY, -, -, hc⟩ := h
  intro k _ _ _ hk R hR hcond hocc
  rw [← hc k hk R hR hcond hocc]
  exact Nat.card_congr (Equiv.subtypeEquiv Ψ.symm (fun c => by
    constructor
    · rintro ⟨P, hP, hR'⟩; exact ⟨P, by rw [Equiv.apply_symm_apply]; exact hP.symm, hR'⟩
    · rintro ⟨P, hP, hR'⟩; exact ⟨P, by rw [Equiv.apply_symm_apply] at hP; exact hP.symm, hR'⟩))

/-- Conversely, the row and any witness give the count on its points (so the leaf-form is equivalent to the
row given `CanonicalModelY3`-type witnesses). -/
theorem points_of_r5fpCount (h : R5fpCount) {Y : Over (Spec (CommRingCat.of ℚ))} {Φ : PtEquiv Y}
    {X : Over (Spec (CommRingCat.of ℚ))} {Ψ : (fieldPt Qbar ⟶ X) ≃ Quotient (pairSetoid Qbar)}
    {fY : Y ⟶ X} (h1 : R1fpProps Y Φ) (h6 : X6Props Y Φ X Ψ fY) : GonzalezRotgerCountX6 := by
  refine ⟨Y, Φ, X, Ψ, fY, h1, h6, fun k _ _ _ hk R hR hcond hocc => ?_⟩
  rw [← h k hk R hR hcond hocc]
  exact Nat.card_congr (Equiv.subtypeEquiv Ψ (fun x => by
    constructor
    · rintro ⟨P, hP, hR'⟩; exact ⟨P, hP.symm, hR'⟩
    · rintro ⟨P, hP, hR'⟩; exact ⟨P, hP.symm, hR'⟩))

end ShimuraSplit

#print axioms ShimuraSplit.r5fpCount_of_points
#print axioms ShimuraSplit.points_of_r5fpCount


/-!
# shimura-split, Part 5: the surjectivity clause of `BabaGranathX6` is a theorem

qm-glue's leaf-form `BabaGranathX6` asks for `π₆ : X₆ → P¹` with the fibre and CM clauses of
`R2X6PropsIff` **and** `π₆` onto `P¹(ℚ̄)`. The second clause follows from the first: the fibres of `π₆` on
`ℚ̄`-points are the `Aut(𝒪)`-twist classes, which are finite (`Aut(𝒪)` is finite modulo inner automorphisms
by units, the kernel's `Pin.autOInnerFinite`, and inner twists are isomorphic, `Pin.conjUnitIso`), and a map
with finite fibres from a proper smooth curve over `ℚ` with a `ℚ̄`-point to `P¹` is onto `P¹(ℚ̄)` (the
kernel's `Pin.curveFacts.2 : CurveSurj`, proved by image-plane).
-/

set_option linter.all false

noncomputable section

namespace ShimuraSplit

open CategoryTheory AlgebraicGeometry Limits
open LeafQM LeafQM.AV LeafQM.AV.Pin

/-- **Finite twist classes of QM pairs over `ℚ̄`.** -/
theorem pairTwistClass_finite (P : QMPair Qbar) :
    {c : Quotient (pairSetoid Qbar) | ∃ Q : QMPair Qbar, c = Quotient.mk _ Q ∧
      ∃ α : O ≃+* O, Nonempty (QMIso (P.q.twist α) Q.q)}.Finite := by
  obtain ⟨T, hTfin, hTα⟩ := autOInnerFinite
  refine (hTfin.image fun t => (Quotient.mk (pairSetoid Qbar) ⟨P.A, P.surface, P.q.twist t⟩)).subset ?_
  rintro c ⟨Q, rfl, α, ⟨f⟩⟩
  obtain ⟨t, ht, v, hv⟩ := hTα α
  exact ⟨t, ht, Quotient.sound ⟨(conjUnitIso P.q t α v hv).trans f⟩⟩

/-- **`π₆` is onto `P¹(ℚ̄)`** for any coarse witness and any `π₆` with the fibre clause of `R2X6Props`. -/
theorem surj_of_fibre {Y : Over (Spec (CommRingCat.of ℚ))} {Φ : PtEquiv Y}
    {X : Over (Spec (CommRingCat.of ℚ))} {Ψ : (fieldPt Qbar ⟶ X) ≃ Quotient (pairSetoid Qbar)}
    {fY : Y ⟶ X} (h6 : X6Props Y Φ X Ψ fY) (π₆ : ToP1 X.left)
    (hfib : ∀ (x x' : fieldPt Qbar ⟶ X) (P Q : QMPair Qbar),
      Ψ x = Quotient.mk _ P → Ψ x' = Quotient.mk _ Q →
        (π₆.val (K := Qbar) x.left = π₆.val (K := Qbar) x'.left ↔
          ∃ α : O ≃+* O, Nonempty (QMIso (P.q.twist α) Q.q))) :
    ∀ t : OnePoint Qbar, ∃ x : fieldPt Qbar ⟶ X, π₆.val (K := Qbar) x.left = t := by
  obtain ⟨hp, hs, hne, -, -, -⟩ := h6
  refine curveFacts.2 X hp hs hne π₆ fun x => ?_
  obtain ⟨P, hP⟩ := Quotient.exists_rep (Ψ x)
  refine ((pairTwistClass_finite P).preimage Ψ.injective.injOn).subset ?_
  intro x' hx'
  obtain ⟨Q, hQ⟩ := Quotient.exists_rep (Ψ x')
  refine ⟨Q, hQ.symm, (hfib x x' P Q hP.symm hQ.symm).1 hx'.symm⟩

end ShimuraSplit

#print axioms ShimuraSplit.surj_of_fibre


/-! # shimura-split additions over the chain: rows r1rec, r5 from r1r2; H-1 from four inputs -/

namespace HDec.QMSplit.Moduli

open CategoryTheory AlgebraicGeometry Limits
open LeafQM LeafQM.AV

/-- **Row `r1rec` (`R1rec`) from row `r1r2` (`R1R2fpRep`)**: the bundle's `R1R2fpRep` carries the point
form `R1recProps` on its fine witness; field of moduli = residue field (`ShimuraSplit.fieldOfModuli3_eq_residueImage`,
from the kernel's rigidity) gives the object form. -/
theorem r1rec_of_r1r2 (h : LeafAdopt.R1R2fpRep) : LeafQM.AV.R1rec := by
  obtain ⟨Y, Φ, X, Ψ, fY, π₆, h1, -, h6, -, hr, -, h5, -⟩ := h
  exact ShimuraSplit.r1rec_of_point ⟨Y, Φ, h1, hr⟩

/-- **Row `r5` (`R5fp`) from row `r1r2` (`R1R2fpRep`)**: the point form `R5ptProps` on the coarse witness
and field of moduli = residue field (`ShimuraSplit.fieldOfModuliPair_eq_residueImage`). -/
theorem r5fp_of_r1r2 (h : LeafAdopt.R1R2fpRep) : LeafQM.AV.R5fp := by
  obtain ⟨Y, Φ, X, Ψ, fY, π₆, h1, -, h6, -, hr, -, h5, -⟩ := h
  exact ShimuraSplit.r5fp_of_point ⟨Y, Φ, X, Ψ, fY, h6, h5⟩

/-- `ReciprocityOfFine` (qm-split's universal glue) from the object form `R1rec`. -/
theorem reciprocityOfFine_of_r1rec (h : LeafQM.AV.R1rec) : ReciprocityOfFine :=
  fun _ _ h1 => ShimuraSplit.point_of_r1rec h h1

/-- `ResidueOfX6` (qm-split's universal glue) from the object form `R5fp`. -/
theorem residueOfX6_of_r5fp (h : LeafQM.AV.R5fp) : ResidueOfX6 :=
  fun _ _ _ _ _ _ h6 => ShimuraSplit.point_of_r5fp h h6

/-- `CanonicalModelY3` is implied by `CanonicalCoarseX6` (so it is not a separate input). -/
theorem canonicalModelY3_of_coarse (hC : CanonicalCoarseX6) : CanonicalModelY3 := by
  obtain ⟨Y, Φ, -, -, -, h1, -⟩ := hC
  exact ⟨Y, Φ, h1⟩

/-- `ReciprocityOfFine` from the existential point form on one fine witness (the form of Shimura
reciprocity closest to print: a statement about points of the canonical model). -/
def ReciprocityCanonical : Prop :=
  ∃ (Y : Over (Spec (CommRingCat.of ℚ))) (Φ : PtEquiv Y), R1fpProps Y Φ ∧ R1recProps Y Φ

theorem r1rec_of_reciprocityCanonical (h : ReciprocityCanonical) : LeafQM.AV.R1rec :=
  ShimuraSplit.r1rec_of_point h

/-- **Row H-1 (`r1r2`) from two existential moduli statements and the two object forms**:
`CanonicalCoarseX6` (Shimura/Deligne canonical model with its coarse quotient), `BabaGranathX6`
(Baba–Granath's Hauptmodul on it), `R1rec` (Shimura reciprocity, field-of-moduli form) and `R5fp`
(González–Rotger Thm 5.12, field-of-moduli form). `HeckeOfFine`, `CoarseFactor`, `CurveBijIso` are
theorems (qm-split, coarse-factor, curve-split); `ReciprocityOfFine`, `ResidueOfX6` follow from the object
forms by the bridge. -/
theorem r1r2fpRep_of_split (hC : CanonicalCoarseX6) (hB : BabaGranathX6) (hR : LeafQM.AV.R1rec)
    (h5 : LeafQM.AV.R5fp) : LeafAdopt.R1R2fpRep :=
  r1r2fpRep_of' (canonicalModelY3_of_coarse hC) (coarseX6OfFine_of hC)
    (hauptmodulOfX6_of hB (coarseCompare_of_canonical hC)) (reciprocityOfFine_of_r1rec hR)
    (residueOfX6_of_r5fp h5)

/-- The same with `GonzalezRotgerX6` (the point form on the canonical `X₆`) for `R5fp`, and the
reciprocity point form `ReciprocityCanonical` for `R1rec`. -/
theorem r1r2fpRep_of_split' (hC : CanonicalCoarseX6) (hB : BabaGranathX6) (hR : ReciprocityCanonical)
    (hG : GonzalezRotgerX6) : LeafAdopt.R1R2fpRep := by
  refine r1r2fpRep_of_split hC hB (r1rec_of_reciprocityCanonical hR) ?_
  obtain ⟨Y, Φ, X, Ψ, fY, -, h6, h5⟩ := hG
  exact ShimuraSplit.r5fp_of_point ⟨Y, Φ, X, Ψ, fY, h6, h5⟩

/-- **Finding (VERIFIED by `Iff.rfl`)**: qm-glue's LEAF-form `ConicCanonical` is the row
`X6Kummer.X6ConicModel` itself, so `x6ConicModel_of_canonical'(')` does not reduce H-43. -/
theorem conicCanonical_iff : ConicCanonical ↔ X6Kummer.X6ConicModel := Iff.rfl

/-- **Finding (VERIFIED by `Iff.rfl`)**: qm-glue's LEAF-form `ConnectedCanonical` is the row
`TSHecke.Y3Connected` itself (qm-glue says so). -/
theorem connectedCanonical_iff : ConnectedCanonical ↔ TSHecke.Y3Connected := Iff.rfl

end HDec.QMSplit.Moduli

