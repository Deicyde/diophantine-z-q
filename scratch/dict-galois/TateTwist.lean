import ZInQKernel.OneProof.H.TailS
import ZInQKernel.Contrib.TauCeti.NumberTheory.ClassFieldTheory.Local.ExplicitCyclotomicSymbol.ArtinMap
import ZInQKernel.Contrib.TauCeti.NumberTheory.ClassFieldTheory.Local.Unramified

/-!
# dict-galois (2): `tateTwistInvariants` from the disjunction of the two wordings of Tate 1967 §3.3 Thm 2

The chain's field `tateTwistInvariants : ZInQ.Contrib.HodgeSplit.TateTwistInvariants` (`TailS.lean`) states
`ℂ_p(i)^{G_K} = 0` for `i ≠ 0` (cyclotomic twists). Tate's print (*p-divisible groups*, 1967, §3.3, Thm 2) may
instead be worded for a continuous character `ψ : G_K → ℤ_p^×` whose restriction to inertia has infinite image.
The new leaf `TateTwistInvariantsPrinted` is the disjunction of the two wordings, so either print gives it by
or-introduction. The field follows: in the second case from `χ^i(I_K)` infinite for `i ≠ 0` (Serre, *Local
Fields*, IV §4), proved here from Tau Ceti's local class field theory (`χ(Art(u)) = u⁻¹` on units, Artin symbols
of units lie in inertia).
-/

set_option linter.style.longLine false
set_option linter.style.haveILetI false

namespace TateTwistDict

open ZInQ.Contrib.G9.PkgI4 TauCeti TauCeti.ClassFieldTheory ValuativeRel

noncomputable section

/-- **LEAF (Tate 1967, §3.3, Theorem 2, general-character wording; locator UNVERIFIED).** Tate, *p-divisible
groups*, Proc. Conf. Local Fields (Driebergen 1966), Springer 1967, pp. 158-183, §3.3: for a complete discretely
valued field `K` of characteristic `0` with perfect residue field of characteristic `p`, `ℂ` the completion of
`K̄`, `G = Gal(K̄/K)`, `I ⊆ G` the inertia group, and a continuous character `ψ : G → ℤ_p^×` with `ψ(I)` infinite,
`H⁰(G, ℂ(ψ)) = 0`. Specialization: `K` finite over `ℚ_p` inside `ℚ̄_p = PadicAlgCl p` (so `ℂ = ℂ_p` and
`G = G_K = K.fixingSubgroup`), and `I` is read as `G_K ∩ I_{ℚ_p}`, `I_{ℚ_p}` Tau Ceti's
`inertiaSubgroup ℚ_[p] = Gal(ℚ̄_p/ℚ_p^ur)`. `G_K ∩ I_{ℚ_p} ⊆ I_K` (an element fixing `ℚ_p^ur` and `K` acts
trivially on the residue field of `ℚ̄_p`, which is generated by the prime-to-`p` roots of unity; equality holds,
`K^ur = K ℚ_p^ur`), so the hypothesis "`ψ(G_K ∩ I_{ℚ_p})` infinite" implies Tate's "`ψ(I_K)` infinite": this
statement is a consequence of the print. -/
def TateTwistInvariantsChar : Prop :=
  ∀ (p : ℕ) [Fact p.Prime] (K : IntermediateField ℚ_[p] (PadicAlgCl p)) [FiniteDimensional ℚ_[p] K]
    (ψ : K.fixingSubgroup →* ℤ_[p]ˣ), Continuous ψ →
    (ψ '' {σ | σ.1 ∈ inertiaSubgroup ℚ_[p]}).Infinite →
    ∀ x : ℂ_[p], (∀ σ : K.fixingSubgroup, (((ψ σ : ℤ_[p]) : ℚ_[p])) • cpAct p σ x = x) → x = 0

/-- **LEAF (Tate 1967, §3.3, Theorem 2, as printed in either wording; locator UNVERIFIED).** The disjunction of
the cyclotomic wording (the chain's `TateTwistInvariants`: `ℂ_p(i)^{G_K} = 0` for `i ≠ 0`) and the
general-character wording `TateTwistInvariantsChar`. Whichever wording the print has, this statement follows
from it by or-introduction (the lead's 11-16 ruling). -/
def TateTwistInvariantsPrinted : Prop :=
  ZInQ.Contrib.HodgeSplit.TateTwistInvariants ∨ TateTwistInvariantsChar

/-! ## `χ^i(G_K ∩ I_{ℚ_p})` is infinite for `i ≠ 0` -/

variable (p : ℕ) [Fact p.Prime]

/-- `ℤ_p^×` is infinite: `x ↦ 1 + p x` is injective from `ℤ_p`. -/
theorem infinite_units_padicInt : Infinite ℤ_[p]ˣ := by
  have hp : (p : ℤ_[p]) ≠ 0 := Nat.cast_ne_zero.mpr (Fact.out : p.Prime).ne_zero
  have hu : ∀ x : ℤ_[p], IsUnit (1 + (p : ℤ_[p]) * x) := by
    intro x
    rw [PadicInt.isUnit_iff]
    have h1 : ‖(p : ℤ_[p]) * x‖ < 1 := by
      rw [norm_mul]
      calc ‖(p : ℤ_[p])‖ * ‖x‖ ≤ ‖(p : ℤ_[p])‖ * 1 :=
            mul_le_mul_of_nonneg_left (PadicInt.norm_le_one x) (norm_nonneg _)
        _ < 1 := by rw [mul_one]; rw [PadicInt.norm_p]; exact inv_lt_one_of_one_lt₀ (by exact_mod_cast (Fact.out : p.Prime).one_lt)
    have h2 : ‖(1 : ℤ_[p])‖ = 1 := norm_one
    rw [add_comm]
    exact (PadicInt.norm_add_eq_max_of_ne (by rw [h2]; exact h1.ne)).trans (by rw [h2]; exact max_eq_right h1.le)
  have hinj : Function.Injective fun x : ℤ_[p] => (hu x).unit := by
    intro x y hxy
    have h := congrArg (fun u : ℤ_[p]ˣ => (u : ℤ_[p])) hxy
    simp only [IsUnit.unit_spec, add_right_inj] at h
    exact mul_left_cancel₀ hp h
  haveI : Infinite ℤ_[p] := Infinite.of_injective (Nat.cast : ℕ → ℤ_[p]) Nat.cast_injective
  exact Infinite.of_injective _ hinj

/-- For `k ≠ 0`, the fibres of `u ↦ u^k` on `ℤ_p^×` are finite. -/
theorem finite_zpow_fibre {k : ℤ} (hk : k ≠ 0) (b : ℤ_[p]ˣ) :
    ((fun u : ℤ_[p]ˣ => u ^ k) ⁻¹' {b}).Finite := by
  rcases ((fun u : ℤ_[p]ˣ => u ^ k) ⁻¹' {b}).eq_empty_or_nonempty with h | ⟨x0, hx0⟩
  · rw [h]; exact Set.finite_empty
  have hn : k.natAbs ≠ 0 := Int.natAbs_ne_zero.mpr hk
  haveI : NeZero k.natAbs := ⟨hn⟩
  have hroot : ∀ y : ℤ_[p]ˣ, y ^ k = 1 → y ∈ rootsOfUnity k.natAbs ℤ_[p] := by
    intro y hy
    rw [mem_rootsOfUnity]
    rcases Int.natAbs_eq k with h | h
    · rw [h] at hy; exact_mod_cast hy
    · rw [h, zpow_neg, inv_eq_one] at hy; exact_mod_cast hy
  have hfin : (rootsOfUnity k.natAbs ℤ_[p] : Set ℤ_[p]ˣ).Finite :=
    Set.finite_coe_iff.mp (inferInstanceAs (Finite (rootsOfUnity k.natAbs ℤ_[p])))
  refine (hfin.image fun y => y * x0).subset ?_
  intro x hx
  refine ⟨x * x0⁻¹, hroot _ ?_, by simp⟩
  simp only [Set.mem_preimage, Set.mem_singleton_iff] at hx hx0
  rw [mul_zpow, inv_zpow, hx, hx0, mul_inv_cancel]

/-- The image of an infinite set under `u ↦ u^k`, `k ≠ 0`, is infinite. -/
theorem infinite_image_zpow {k : ℤ} (hk : k ≠ 0) {S : Set ℤ_[p]ˣ} (hS : S.Infinite) :
    ((fun u : ℤ_[p]ˣ => u ^ k) '' S).Infinite := by
  intro hfin
  apply hS
  refine (hfin.preimage' fun b _ => finite_zpow_fibre p hk b).subset ?_
  intro u hu
  exact ⟨u, hu, rfl⟩

/-- `χ` on `G_{ℚ_p}` (Tau Ceti's `localCyclotomicCharacter`; by definition the chain's `cyc`). -/
abbrev chi : Field.absoluteGaloisGroup ℚ_[p] →* ℤ_[p]ˣ := localCyclotomicCharacter p ℚ_[p]

theorem chi_eq_cyc (σ : GQp p) : chi p σ = cyc p σ := rfl

/-- A unit of `ℤ_p` has valuation `1` in `ℚ_p`. -/
theorem valuation_unit_eq_one (u : ℤ_[p]ˣ) :
    ValuativeRel.valuation ℚ_[p] (((Units.map (algebraMap ℤ_[p] ℚ_[p]).toMonoidHom u : ℚ_[p]ˣ)) : ℚ_[p]) = 1 := by
  set v := ValuativeRel.valuation ℚ_[p]
  have hmem : ∀ y : ℤ_[p], v (y : ℚ_[p]) ≤ 1 := by
    intro y
    have : (y : ℚ_[p]) ∈ (𝒪[ℚ_[p]] : Set ℚ_[p]) := by
      rw [Padic.integerRing_eq_subring]
      exact (PadicInt.mem_subring_iff p).mpr (PadicInt.norm_le_one y)
    exact (Valuation.mem_integer_iff _ _).mp this
  have h1 : v ((u : ℤ_[p]) : ℚ_[p]) ≤ 1 := hmem u
  have h2 : v (((u⁻¹ : ℤ_[p]ˣ) : ℤ_[p]) : ℚ_[p]) ≤ 1 := hmem _
  have h3 : v ((u : ℤ_[p]) : ℚ_[p]) * v (((u⁻¹ : ℤ_[p]ˣ) : ℤ_[p]) : ℚ_[p]) = 1 := by
    rw [← map_mul, ← PadicInt.coe_mul, Units.mul_inv, PadicInt.coe_one, map_one]
  change v ((u : ℤ_[p]) : ℚ_[p]) = 1
  refine le_antisymm h1 ?_
  calc (1 : _) = v ((u : ℤ_[p]) : ℚ_[p]) * v (((u⁻¹ : ℤ_[p]ˣ) : ℤ_[p]) : ℚ_[p]) := h3.symm
    _ ≤ v ((u : ℤ_[p]) : ℚ_[p]) * 1 := mul_le_mul' le_rfl h2
    _ = _ := mul_one _

/-- **`χ(I_{ℚ_p}) = ℤ_p^×`** (local class field theory, Tau Ceti): a lift of `Art(u⁻¹)` lies in inertia and has
cyclotomic character `u`. -/
theorem exists_inertia_chi_eq (u : ℤ_[p]ˣ) :
    ∃ σ : Field.absoluteGaloisGroup ℚ_[p], σ ∈ inertiaSubgroup ℚ_[p] ∧ chi p σ = u := by
  set w : ℚ_[p]ˣ := Units.map (algebraMap ℤ_[p] ℚ_[p]).toMonoidHom u⁻¹
  obtain ⟨τ, hτ⟩ := QuotientGroup.mk_surjective (artinMap ℚ_[p] w)
  refine ⟨τ, mem_inertiaSubgroup_of_mk_eq_artinMap ℚ_[p] w (valuation_unit_eq_one p u⁻¹) τ hτ, ?_⟩
  rw [chi, localCyclotomicCharacter_artinMap_padic p u⁻¹ τ hτ, inv_inv]

/-- `IsGalois ℚ_p ℚ̄_p`. -/
theorem isGalois_padicAlgCl : IsGalois ℚ_[p] (PadicAlgCl p) := by
  haveI : PerfectField ℚ_[p] := PerfectField.ofCharZero
  haveI : Normal ℚ_[p] (PadicAlgCl p) := IsAlgClosure.normal ℚ_[p] (PadicAlgCl p)
  haveI : Algebra.IsSeparable ℚ_[p] (PadicAlgCl p) := Algebra.IsSeparable.of_integral _ _
  exact IsGalois.mk

/-- The `i`-th power of `χ`, restricted to `G_K`. -/
def chiPowK (K : IntermediateField ℚ_[p] (PadicAlgCl p)) (i : ℤ) : K.fixingSubgroup →* ℤ_[p]ˣ :=
  (zpowGroupHom i).comp ((chi p).comp K.fixingSubgroup.subtype)

theorem continuous_chiPowK (K : IntermediateField ℚ_[p] (PadicAlgCl p)) (i : ℤ) :
    Continuous (chiPowK p K i) := by
  have hc : Continuous (chi p) := localCyclotomicCharacter_continuous p ℚ_[p]
  exact (continuous_zpow i).comp (hc.comp continuous_subtype_val)

/-- **`χ^i(G_K ∩ I_{ℚ_p})` is infinite for `i ≠ 0`** (Serre, *Local Fields*, IV §4: `χ(I_K)` is open in
`ℤ_p^×`). `G_K` has finite index in `G_{ℚ_p}`, so its normal core `N` does; `σ^{[G:N]} ∈ N ⊆ G_K` for every
`σ`, and `χ(I_{ℚ_p}) = ℤ_p^×`, so the image contains every `u^{[G:N] i}`; `u ↦ u^k` has finite fibres. -/
theorem infinite_chiPowK_inertia (K : IntermediateField ℚ_[p] (PadicAlgCl p)) [FiniteDimensional ℚ_[p] K]
    {i : ℤ} (hi : i ≠ 0) :
    (chiPowK p K i '' {σ | σ.1 ∈ inertiaSubgroup ℚ_[p]}).Infinite := by
  haveI := isGalois_padicAlgCl p
  have hidx : K.fixingSubgroup.index ≠ 0 := by
    rw [← IntermediateField.finrank_eq_fixingSubgroup_index]
    exact Module.finrank_pos.ne'
  haveI : K.fixingSubgroup.FiniteIndex := ⟨hidx⟩
  set N := K.fixingSubgroup.normalCore
  have hNle : N ≤ K.fixingSubgroup := Subgroup.normalCore_le _
  set m := N.index
  have hm : m ≠ 0 := Subgroup.FiniteIndex.index_ne_zero
  have hk : (m : ℤ) * i ≠ 0 := mul_ne_zero (Nat.cast_ne_zero.mpr hm) hi
  haveI := infinite_units_padicInt p
  have hsub : (fun u : ℤ_[p]ˣ => u ^ ((m : ℤ) * i)) '' Set.univ ⊆
      chiPowK p K i '' {σ | σ.1 ∈ inertiaSubgroup ℚ_[p]} := by
    rintro _ ⟨u, -, rfl⟩
    obtain ⟨σ, hσI, hσ⟩ := exists_inertia_chi_eq p u
    have hσN : σ ^ m ∈ N := Subgroup.pow_index_mem N σ
    refine ⟨⟨σ ^ m, hNle hσN⟩, (inertiaSubgroup ℚ_[p]).pow_mem hσI m, ?_⟩
    change (chi p (σ ^ m)) ^ i = u ^ ((m : ℤ) * i)
    rw [map_pow, hσ, zpow_mul, zpow_natCast]
  exact (infinite_image_zpow p hk Set.infinite_univ).mono hsub

/-- **The chain's field from the disjunction leaf.** -/
theorem tateTwistInvariants_of_printed (h : TateTwistInvariantsPrinted) :
    ZInQ.Contrib.HodgeSplit.TateTwistInvariants := by
  rcases h with h | h
  · exact h
  intro p _ K _ i hi x hx
  refine h p K (chiPowK p K i) (continuous_chiPowK p K i) (infinite_chiPowK_inertia p K hi) x
    fun σ => ?_
  exact hx σ σ.2

end

end TateTwistDict
