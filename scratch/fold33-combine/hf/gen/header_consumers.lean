import ZInQKernel.OneProof.H.TailZ47
import ZInQKernel.Contrib.OneProof.HomFreeFiniteAlgClosed

/-! # homfree-noemb, part 1: the consumers of T6 over fields that embed into `ℂ`

Copies (verbatim up to the renaming `X ↦ X_hf` / `XHF`) of the 37 lemmas through which `TextbookLeaves.t6 :
PkgI3.HomFreeFinite` (Mumford §19 Thm 3 over every field) enters `sixContactMin_of_open38`, with the hypothesis
replaced by homfree-proof's `HomFreeFiniteC` (the same statement over fields `k` with a ring homomorphism
`σ : k →+* ℂ`). A `σ` binder is added to the generic lemmas and Props (`EndDivisionOfEnd0Division`,
`CentralizerOfMatrixEnd0`, `QMSplitCaseRank`, `com_int_of_end0_quat`, `tateHom_injective`, `four_le_finrank`,
`finrank_le_baseChange`, `finrank_end0`); `σ` is supplied at `ℚ̄` (`HFReroute.sigmaQbar`), at number fields
(`HFReroute.sigmaNF`) and at `AlgebraicClosure L'` (`HFReroute.sigmaAlgClosure`). Every concrete use of T6 on the
route is at one of these fields. Generated by `scratch/homfree-noemb/gen/gen.py` (task homfree-noemb). -/

namespace HFReroute

/-- An embedding `ℚ̄ → ℂ` (`IsAlgClosed.lift`). -/
noncomputable def sigmaQbar : AlgebraicClosure ℚ →+* ℂ :=
  (IsAlgClosed.lift : AlgebraicClosure ℚ →ₐ[ℚ] ℂ).toRingHom

/-- An embedding of a number field into `ℂ` (`IsAlgClosed.lift`). -/
noncomputable def sigmaNF (K : Type) [Field K] [NumberField K] : K →+* ℂ :=
  (IsAlgClosed.lift : K →ₐ[ℚ] ℂ).toRingHom

/-- `σ : K → ℂ` extended to `K̄ → ℂ` (`IsAlgClosed.lift`). -/
noncomputable def sigmaAlgClosure {K : Type} [Field K] (σ : K →+* ℂ) : AlgebraicClosure K →+* ℂ :=
  letI : Algebra K ℂ := σ.toAlgebra
  (IsAlgClosed.lift : AlgebraicClosure K →ₐ[K] ℂ).toRingHom

end HFReroute
