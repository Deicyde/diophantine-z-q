namespace CompositeOutTab

abbrev C3 := Fin 4 → ZMod 3
def e1C : C3 := ![1, 0, 0, 0]
def mulC (a b : C3) : C3 := ShimuraGlue.mulCoordR a b
def pwC (a : C3) : ℕ → C3
  | 0 => e1C
  | n + 1 => mulC (pwC a n) a
def cbarC : C3 := ![1, 1, 2, 0]
def wbarC : C3 := ![1, 0, 2, 0]
def inv3 (a : C3) : C3 := fun i => ShimuraGlue.N4 a * (![a 0 + a 2, -a 1, -a 2, -a 3] : C3) i
