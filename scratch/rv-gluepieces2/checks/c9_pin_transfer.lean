/-! ## rv-gluepieces2 check (i): over the pinned `R1fpProps`, each of the six pin-dependent fields
of `GluePieces2` (4 `FibreComTrivial`, 10 `FibreQMPeriod`, 12 `FibreCoverExists`, 13 `KernelFieldExists`,
27 `ModelG3G6`, 28 `LinkedTateData`) follows from its statement for ONE triple `(Y₀, Φ₀, π₀)`
satisfying the clauses (for example the leaf's own), given pin-apply's named glue `MobiusGlue` and
the leaf bundle's `R1R2fp`. The `…At` forms are generated by `gen_at.py` from the fields' own text
(the binders `Y Φ π` dropped and `Y Φ π` replaced by `Y₀ Φ₀ π₀`). -/

section RvPinTransfer
noncomputable section
open CategoryTheory AlgebraicGeometry Limits MonoidalCategory CartesianMonoidalCategory MonObj
open ZInQ ZInQ.JHeight LeafQM.AV ZInQ.DefFaltings

namespace RvGP2.Pin

/-- `FibreCtx` moves along the comparison morphism `g : Y → Y₀`. -/
theorem fibreCtx_transfer (hM : LeafQM.AV.Pin.MobiusGlue) (hQM : LeafQM.AV.R1R2fp)
    {Y₀ : Over (Spec (CommRingCat.of ℚ))} {Φ₀ : LeafQM.AV.PtEquiv Y₀} {π₀ : LeafQM.AV.ToP1 Y₀.left}
    (h1 : LeafQM.AV.R1fpProps Y₀ Φ₀) (h2 : LeafQM.AV.R2fpProps Y₀ Φ₀ π₀)
    {Y : Over (Spec (CommRingCat.of ℚ))} {Φ : PtEquiv Y} {π : ToP1 Y.left} {u : ℚ} {P : QML3 Qbar}
    (hC : G0ModField.FibreCtx Y Φ π u P) : G0ModField.FibreCtx Y₀ Φ₀ π₀ u P := by
  obtain ⟨h1', h2', hu, y, hP, hy⟩ := hC
  obtain ⟨g, hΦ, hπ⟩ := HSyn.G0Split.sameTripleMor_of_leaves hM hQM h1 h2 h1' h2'
  exact ⟨h1, h2, hu, y ≫ g, (hΦ Qbar y).symm.trans hP, (hπ y).symm.trans hy⟩

/-- The comparison morphism `Y → Y₀`, from any second triple. -/
theorem fibreCtx_mor (hM : LeafQM.AV.Pin.MobiusGlue) (hQM : LeafQM.AV.R1R2fp)
    {Y₀ : Over (Spec (CommRingCat.of ℚ))} {Φ₀ : LeafQM.AV.PtEquiv Y₀} {π₀ : LeafQM.AV.ToP1 Y₀.left}
    (h1 : LeafQM.AV.R1fpProps Y₀ Φ₀) (h2 : LeafQM.AV.R2fpProps Y₀ Φ₀ π₀)
    {Y : Over (Spec (CommRingCat.of ℚ))} {Φ : PtEquiv Y} {π : ToP1 Y.left} {u : ℚ} {P : QML3 Qbar}
    (hC : G0ModField.FibreCtx Y Φ π u P) : LeafQM.AV.Pin.SameTripleMor Y₀ Y Φ₀ Φ π₀ π ∧
      LeafQM.AV.Pin.SameTripleMor Y Y₀ Φ Φ₀ π π₀ :=
  ⟨HSyn.G0Split.sameTripleMor_of_leaves hM hQM h1 h2 hC.1 hC.2.1,
    HSyn.G0Split.sameTripleMor_of_leaves hM hQM hC.1 hC.2.1 h1 h2⟩

/-- `RationalFibre` moves along a comparison morphism. -/
theorem rationalFibre_transfer {Y Y' : Over (Spec (CommRingCat.of ℚ))} {Φ : PtEquiv Y}
    {Φ' : PtEquiv Y'} {π : ToP1 Y.left} {π' : ToP1 Y'.left}
    (hS : LeafQM.AV.Pin.SameTripleMor Y Y' Φ Φ' π π') {P : QML3 Qbar} {K : G0ModField.IF}
    {PK : QML3 K} (h : G0ModField.RationalFibre Y' Φ' P K PK) : G0ModField.RationalFibre Y Φ P K PK := by
  obtain ⟨g, hΦ, -⟩ := hS
  obtain ⟨⟨yK, h1, h2⟩, hm⟩ := h
  refine ⟨⟨yK ≫ g, (hΦ K yK).symm.trans h1, ?_⟩, hm⟩
  rw [← Category.assoc, ← hΦ]; exact h2

end RvGP2.Pin

namespace G0FibreSimple
open HSyn HSyn.G0Split
def FibreComTrivialAt (Y₀ : Over (Spec (CommRingCat.of ℚ))) (Φ₀ : PtEquiv Y₀) (π₀ : ToP1 Y₀.left) : Prop :=
  ∀ u : ℚ, u ∉ contactSet →
    ∀ (y : fieldPt LeafQM.AV.Qbar ⟶ Y₀) (P : QML3 LeafQM.AV.Qbar), Φ₀ LeafQM.AV.Qbar y = M3.mk P →
      π₀.val (K := LeafQM.AV.Qbar) y.left = OnePoint.some (algebraMap ℚ LeafQM.AV.Qbar (Jmap u)) →
      ∀ φ ∈ com P.q, ∃ n : ℤ, φ = (n : PkgI3.AbVar.End P.A)

theorem fibreComTrivial_of_at (hM : LeafQM.AV.Pin.MobiusGlue) (hQM : LeafQM.AV.R1R2fp)
    {Y₀ : Over (Spec (CommRingCat.of ℚ))} {Φ₀ : LeafQM.AV.PtEquiv Y₀} {π₀ : LeafQM.AV.ToP1 Y₀.left}
    (h1 : LeafQM.AV.R1fpProps Y₀ Φ₀) (h2 : LeafQM.AV.R2fpProps Y₀ Φ₀ π₀) (h : FibreComTrivialAt Y₀ Φ₀ π₀) : FibreComTrivial := by
  intro Y Φ π h1' h2' u hu y P hP hy
  obtain ⟨g, hΦ, hπ⟩ := HSyn.G0Split.sameTripleMor_of_leaves hM hQM h1 h2 h1' h2'
  exact h u hu (y ≫ g) P ((hΦ _ y).symm.trans hP) ((hπ y).symm.trans hy)
end G0FibreSimple

namespace HSyn.G0Split.ThetaPt
open ZInQ.LeafPush2 (CPts cptObj IsUniformization IsSiegel IsPeriodMatrix Char2 thetaConst absLogHeight)
open Complex
def FibreQMPeriodAt (Y₀ : Over (Spec (CommRingCat.of ℚ))) (Φ₀ : PtEquiv Y₀) (π₀ : ToP1 Y₀.left) : Prop :=
  ∀ u : ℚ, u ∉ contactSet →
    ∀ (K : GlueAssembly.NF) (A : ZInQ.DefFaltings.AbVar K.K), FibreOver Y₀ Φ₀ π₀ u K A →
    ∃ (σ : K.K →+* ℂ) (Λ : Submodule ℤ (Fin 2 → ℂ))
      (Φu : (Fin 2 → ℂ) → CPts (LeafAdopt.abVarEquiv K.K A) σ), IsUniformization σ Λ Φu ∧
    ∃ (τ : ℂ) (hτ : 0 < τ.im) (F : (Fin 2 → ℂ) ≃ₗ[ℂ] (Fin 2 → ℂ)),
      Λ.map (F.toLinearMap.restrictScalars ℤ) = BPAnalytic.QM.qmLattice hτ.ne' ∧
      PkgI1.jNum (PkgI1.Omega τ) / PkgI1.jDen (PkgI1.Omega τ) = ((Jmap u : ℚ) : ℂ)

theorem fibreQMPeriod_of_at (hM : LeafQM.AV.Pin.MobiusGlue) (hQM : LeafQM.AV.R1R2fp)
    {Y₀ : Over (Spec (CommRingCat.of ℚ))} {Φ₀ : LeafQM.AV.PtEquiv Y₀} {π₀ : LeafQM.AV.ToP1 Y₀.left}
    (h1 : LeafQM.AV.R1fpProps Y₀ Φ₀) (h2 : LeafQM.AV.R2fpProps Y₀ Φ₀ π₀) (h : FibreQMPeriodAt Y₀ Φ₀ π₀) : FibreQMPeriod :=
  fun _ _ _ h1' h2' u hu K A hF =>
    h u hu K A (HSyn.G0Split.fibreOver_of_sameTripleMor
      (HSyn.G0Split.sameTripleMor_of_leaves hM hQM h1 h2 h1' h2') hF)
end HSyn.G0Split.ThetaPt

namespace G0ModField
open GlueDescent GlueDescent.B2 GlueDescent.B2Q GlueDescent.B3Q
def KernelFieldExistsAt (Y₀ : Over (Spec (CommRingCat.of ℚ))) (Φ₀ : PtEquiv Y₀) (π₀ : ToP1 Y₀.left) : Prop :=
  ∀ (u : ℚ)
    (P : QML3 Qbar), FibreCtx Y₀ Φ₀ π₀ u P →
    ∀ (K : IF) [FiniteDimensional ℚ K] [IsGalois ℚ K], Module.finrank ℚ K ≤ heightF0 →
      (∀ p : Nat.Primes, (p : ℕ) ∉ T u → UnramifiedAt K p) →
      ∀ PK : QML3 K, RationalFibre Y₀ Φ₀ P K PK → KernelFieldOut u P K PK.A

def FibreCoverExistsAt (Y₀ : Over (Spec (CommRingCat.of ℚ))) (Φ₀ : PtEquiv Y₀) (π₀ : ToP1 Y₀.left) : Prop :=
  ∀ (u : ℚ)
    (P : QML3 Qbar), FibreCtx Y₀ Φ₀ π₀ u P → FibreCoverOut Y₀ Φ₀ u P

theorem kernelFieldExists_of_at (hM : LeafQM.AV.Pin.MobiusGlue) (hQM : LeafQM.AV.R1R2fp)
    {Y₀ : Over (Spec (CommRingCat.of ℚ))} {Φ₀ : LeafQM.AV.PtEquiv Y₀} {π₀ : LeafQM.AV.ToP1 Y₀.left}
    (h1 : LeafQM.AV.R1fpProps Y₀ Φ₀) (h2 : LeafQM.AV.R2fpProps Y₀ Φ₀ π₀) (h : KernelFieldExistsAt Y₀ Φ₀ π₀) :
    KernelFieldExists := by
  intro Y Φ π u P hC K _ _ hK hram PK hR
  exact h u P (RvGP2.Pin.fibreCtx_transfer hM hQM h1 h2 hC) K hK hram PK
    (RvGP2.Pin.rationalFibre_transfer (RvGP2.Pin.fibreCtx_mor hM hQM h1 h2 hC).1 hR)

theorem fibreCoverExists_of_at (hM : LeafQM.AV.Pin.MobiusGlue) (hQM : LeafQM.AV.R1R2fp)
    {Y₀ : Over (Spec (CommRingCat.of ℚ))} {Φ₀ : LeafQM.AV.PtEquiv Y₀} {π₀ : LeafQM.AV.ToP1 Y₀.left}
    (h1 : LeafQM.AV.R1fpProps Y₀ Φ₀) (h2 : LeafQM.AV.R2fpProps Y₀ Φ₀ π₀) (h : FibreCoverExistsAt Y₀ Φ₀ π₀) :
    FibreCoverExists := by
  intro Y Φ π u P hC
  obtain ⟨f, hs, hd, hram, PK, hR⟩ := h u P (RvGP2.Pin.fibreCtx_transfer hM hQM h1 h2 hC)
  exact ⟨f, hs, hd, hram, PK,
    RvGP2.Pin.rationalFibre_transfer (RvGP2.Pin.fibreCtx_mor hM hQM h1 h2 hC).2 hR⟩
end G0ModField

namespace HSyn.G0AssembleMod
open G0ModField
def ModelG3G6At (Y₀ : Over (Spec (CommRingCat.of ℚ))) (Φ₀ : LeafQM.AV.PtEquiv Y₀) (π₀ : LeafQM.AV.ToP1 Y₀.left) : Prop :=
  ∀ (u : ℚ) (P : LeafQM.AV.QML3 Qbar), FibreCtx Y₀ Φ₀ π₀ u P →
  ∀ (L : IF) [FiniteDimensional ℚ L] [IsGalois ℚ L] (A : PkgI3.AbVar L) (ε : GQ → GQ → ℂˣ)
    (N : ℕ) [NeZero N] (χ : DirichletCharacter ℂ N) (β : GQ → ℂˣ) (L' : IF)
    [FiniteDimensional ℚ L'] [IsGalois ℚ L'] (hLL' : L ≤ L'),
    G7Data u P L A ε N χ β L' hLL' →
    letI : NumberField L' := numberField_of_fd L'
    G0Galois.G6Out (@PkgI3.AbVar.baseChange L _ A L' _ (incAlg hLL')) ∧
    G0Galois.G3Out (@PkgI3.AbVar.baseChange L _ A L' _ (incAlg hLL')) 5 (T u) ∧
    G0Galois.G3Out (@PkgI3.AbVar.baseChange L _ A L' _ (incAlg hLL')) 3 (T u)

def LinkedTateDataAt (Y₀ : Over (Spec (CommRingCat.of ℚ))) (Φ₀ : LeafQM.AV.PtEquiv Y₀) (π₀ : LeafQM.AV.ToP1 Y₀.left) : Prop :=
  ∀ (u : ℚ) (P : LeafQM.AV.QML3 Qbar), FibreCtx Y₀ Φ₀ π₀ u P →
  ∀ (L : IF) [FiniteDimensional ℚ L] [IsGalois ℚ L] (A : PkgI3.AbVar L) (ε : GQ → GQ → ℂˣ)
    (N : ℕ) [NeZero N] (χ : DirichletCharacter ℂ N) (β : GQ → ℂˣ) (L' : IF)
    [FiniteDimensional ℚ L'] [IsGalois ℚ L'] (hLL' : L ≤ L'),
    G7Data u P L A ε N χ β L' hLL' →
    letI : NumberField L' := numberField_of_fd L'
    ∃ (Tm₅ : PkgI4.GQ → Module.End (PadicAlgCl 5)
        (G0Galois.Vb (@PkgI3.AbVar.baseChange L _ A L' _ (incAlg hLL')) 5))
      (c₅ ε₅ : PkgI4.GQ → PkgI4.GQ → PadicAlgCl 5) (a₅ β₅ : PkgI4.GQ → PadicAlgCl 5)
      (u₅ : GlueDescent.MatrixUnits2 (PadicAlgCl 5)
        (G0Galois.Vb (@PkgI3.AbVar.baseChange L _ A L' _ (incAlg hLL')) 5))
      (Tm₃ : PkgI4.GQ → Module.End (PadicAlgCl 3)
        (G0Galois.Vb (@PkgI3.AbVar.baseChange L _ A L' _ (incAlg hLL')) 3))
      (c₃ ε₃ : PkgI4.GQ → PkgI4.GQ → PadicAlgCl 3) (a₃ β₃ : PkgI4.GQ → PadicAlgCl 3)
      (u₃ : GlueDescent.MatrixUnits2 (PadicAlgCl 3)
        (G0Galois.Vb (@PkgI3.AbVar.baseChange L _ A L' _ (incAlg hLL')) 3)),
      G0Galois.G7Out (@PkgI3.AbVar.baseChange L _ A L' _ (incAlg hLL')) 5 Tm₅ c₅ ε₅ a₅ β₅ u₅ ∧
      G0Galois.G7Out (@PkgI3.AbVar.baseChange L _ A L' _ (incAlg hLL')) 3 Tm₃ c₃ ε₃ a₃ β₃ u₃ ∧
      ∀ (r₅ : PkgI4.GaloisRep 5 2) (r₃ : PkgI4.GaloisRep 3 2),
        G0Galois.G8Out (@PkgI3.AbVar.baseChange L _ A L' _ (incAlg hLL')) 5
          (GlueDescent.rho Tm₅ a₅ β₅) r₅ →
        G0Galois.G8Out (@PkgI3.AbVar.baseChange L _ A L' _ (incAlg hLL')) 3
          (GlueDescent.rho Tm₃ a₃ β₃) r₃ →
        ∀ (i : AlgebraicClosure ℚ →ₐ[ℚ] AlgebraicClosure L') (ιC : PkgI4.Qbar →ₐ[ℚ] ℂ)
          (ι5 : PkgI4.Qbar →ₐ[ℚ] PadicAlgCl 5), ∃ ι3 : PkgI4.Qbar →ₐ[ℚ] PadicAlgCl 3,
          G0ModNewform.G14TraceCompat
            (⟨i, ιC, ι5, ι3, r₅, r₃⟩ : G0ModNewform.ModData L'
              (@PkgI3.AbVar.baseChange L _ A L' _ (incAlg hLL'))) ∧
          G15RamWild
            (⟨i, ιC, ι5, ι3, r₅, r₃⟩ : G0ModNewform.ModData L'
              (@PkgI3.AbVar.baseChange L _ A L' _ (incAlg hLL')))

theorem modelG3G6_of_at (hM : LeafQM.AV.Pin.MobiusGlue) (hQM : LeafQM.AV.R1R2fp)
    {Y₀ : Over (Spec (CommRingCat.of ℚ))} {Φ₀ : LeafQM.AV.PtEquiv Y₀} {π₀ : LeafQM.AV.ToP1 Y₀.left}
    (h1 : LeafQM.AV.R1fpProps Y₀ Φ₀) (h2 : LeafQM.AV.R2fpProps Y₀ Φ₀ π₀) (h : ModelG3G6At Y₀ Φ₀ π₀) : ModelG3G6 :=
  fun _ _ _ u P hC => h u P (RvGP2.Pin.fibreCtx_transfer hM hQM h1 h2 hC)

theorem linkedTateData_of_at (hM : LeafQM.AV.Pin.MobiusGlue) (hQM : LeafQM.AV.R1R2fp)
    {Y₀ : Over (Spec (CommRingCat.of ℚ))} {Φ₀ : LeafQM.AV.PtEquiv Y₀} {π₀ : LeafQM.AV.ToP1 Y₀.left}
    (h1 : LeafQM.AV.R1fpProps Y₀ Φ₀) (h2 : LeafQM.AV.R2fpProps Y₀ Φ₀ π₀) (h : LinkedTateDataAt Y₀ Φ₀ π₀) : LinkedTateData :=
  fun _ _ _ u P hC => h u P (RvGP2.Pin.fibreCtx_transfer hM hQM h1 h2 hC)
end HSyn.G0AssembleMod

