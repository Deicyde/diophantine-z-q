import Mathlib

/-!
# glue-vigneras, global part: the normalizer of N5's order `𝒪` in `B^×`, `B = (2,-3)` over `ℚ`

Main theorem `nrd_dvd_six`: if `x = comb n ∈ 𝒪` is primitive (`∑ sₖ nₖ = 1`) and normalizes `𝒪`,
then `nrd x ∣ 6`. So every element of `N_B(𝒪)` is `r·x₀` with `r ∈ ℚ^×`, `x₀ ∈ 𝒪` and
`nrd x₀ ∈ {±1, ±2, ±3, ±6}`; this is the finite computation behind `[N_B(𝒪) : ℚ^×𝒪^×] ≤ 4`.
`B`, `comb`, `𝒪` are copied from `scratch/glue-repo/A1Quaternion.lean` (scratch files cannot import
each other). The certificate section is generated by `gen_global.py`.
-/

open Quaternion

attribute [local simp] QuaternionAlgebra.re_ofNat QuaternionAlgebra.imI_ofNat QuaternionAlgebra.imJ_ofNat QuaternionAlgebra.imK_ofNat

namespace GlueVigneras.Global

abbrev B := ℍ[ℚ, 2, 0, -3]

def comb (n : Fin 4 → ℤ) : B :=
  ⟨n 0 + n 2 / 2, n 1 + n 3 / 2, n 2 / 2, n 3 / 2⟩

/-- `𝒪 = ℤ⟨1, i, (1+j)/2, (i+ij)/2⟩` (as a set; glue-repo proves it is a subring). -/
def O : Set B := Set.range comb

/-- Coordinates in N5's basis. -/
def coordQ (x : B) : Fin 4 → ℚ := ![x.re - x.imJ, x.imI - x.imK, 2 * x.imJ, 2 * x.imK]

theorem coordQ_comb (n : Fin 4 → ℤ) (l : Fin 4) : coordQ (comb n) l = n l := by
  fin_cases l <;> simp [coordQ, comb] <;> ring

def nrd (x : B) : ℚ := (x * star x).re

theorem mul_star_eq (x : B) : x * star x = algebraMap ℚ B (nrd x) := by
  ext <;> simp [nrd] <;> ring

/-- `nrd (comb n)` as an integer form: `N(n₀,n₂) − 2N(n₁,n₃)`, `N = x² + xy + y²`. -/
def nrdInt (n : Fin 4 → ℤ) : ℤ := (n 0 ^ 2 + n 0 * n 2 + n 2 ^ 2) - 2 * (n 1 ^ 2 + n 1 * n 3 + n 3 ^ 2)

theorem nrd_comb (n : Fin 4 → ℤ) : nrd (comb n) = nrdInt n := by
  simp [nrd, comb, nrdInt]; ring

/-- N5's basis. -/
def eQ (k : Fin 4) : B := comb (fun l => if l = k then 1 else 0)

/-- `Eint n k l`: coordinate `l` (N5's basis) of `x eₖ x̄` for `x = comb n` (generated by `gen_global.py`). -/

def Eint (n : Fin 4 → ℤ) : Fin 4 → Fin 4 → ℤ := ![

  ![(-2)*n 3^2 + (1)*n 2^2 + (-2)*n 1*n 3 + (-2)*n 1^2 + (1)*n 0*n 2 + (1)*n 0^2, 0, 0, 0],
  ![(2)*n 2*n 3 + (2)*n 1*n 2 + (2)*n 0*n 3, (2)*n 3^2 + (-2)*n 1^2 + (2)*n 0*n 2 + (1)*n 0^2, (-4)*n 2*n 3 + (-4)*n 1*n 2 + (-4)*n 0*n 3, (-2)*n 3^2 + (-1)*n 2^2 + (-4)*n 1*n 3 + (-2)*n 0*n 2],
  ![(-2)*n 3^2 + (-2)*n 1*n 3 + (-2)*n 1^2, (-1)*n 2*n 3 + (1)*n 1*n 2 + (-2)*n 0*n 3 + (-1)*n 0*n 1, (2)*n 3^2 + (1)*n 2^2 + (2)*n 1*n 3 + (2)*n 1^2 + (1)*n 0*n 2 + (1)*n 0^2, (2)*n 2*n 3 + (1)*n 1*n 2 + (1)*n 0*n 3 + (2)*n 0*n 1],
  ![(2)*n 2*n 3 + (-2)*n 0*n 1, (1)*n 2^2 + (-4)*n 1*n 3 + (-2)*n 1^2 + (2)*n 0*n 2, (-4)*n 2*n 3 + (4)*n 0*n 1, (-2)*n 3^2 + (-1)*n 2^2 + (2)*n 1^2 + (1)*n 0^2]]

theorem cert_00 (n : Fin 4 → ℤ) : 6 * (n 0 * n 0) = (4) * Eint n 0 0 + (2) * Eint n 1 1 + (2) * Eint n 1 3 + (-4) * Eint n 2 0 + (-2) * Eint n 3 1 := by
  simp [Eint]; ring

theorem cert_01 (n : Fin 4 → ℤ) : 6 * (n 0 * n 1) = (-1) * Eint n 1 0 + (2) * Eint n 2 3 + (-1) * Eint n 3 0 := by
  simp [Eint]; ring

theorem cert_02 (n : Fin 4 → ℤ) : 6 * (n 0 * n 2) = (-2) * Eint n 0 0 + (-2) * Eint n 1 3 + (2) * Eint n 2 0 + (2) * Eint n 3 1 + (2) * Eint n 3 3 := by
  simp [Eint]; ring

theorem cert_03 (n : Fin 4 → ℤ) : 6 * (n 0 * n 3) = (2) * Eint n 1 0 + (-2) * Eint n 2 1 + (-2) * Eint n 2 3 + (-1) * Eint n 3 0 := by
  simp [Eint]; ring

theorem cert_11 (n : Fin 4 → ℤ) : 6 * (n 1 * n 1) = (-1) * Eint n 1 1 + (-2) * Eint n 2 0 + (1) * Eint n 3 1 + (1) * Eint n 3 3 := by
  simp [Eint]; ring

theorem cert_12 (n : Fin 4 → ℤ) : 6 * (n 1 * n 2) = (2) * Eint n 1 0 + (2) * Eint n 2 1 + (-1) * Eint n 3 0 := by
  simp [Eint]; ring

theorem cert_13 (n : Fin 4 → ℤ) : 6 * (n 1 * n 3) = (-1) * Eint n 1 3 + (1) * Eint n 2 0 + (-1) * Eint n 3 1 := by
  simp [Eint]; ring

theorem cert_22 (n : Fin 4 → ℤ) : 6 * (n 2 * n 2) = (4) * Eint n 0 0 + (-2) * Eint n 1 1 + (-4) * Eint n 2 0 + (-2) * Eint n 3 3 := by
  simp [Eint]; ring

theorem cert_23 (n : Fin 4 → ℤ) : 6 * (n 2 * n 3) = (-1) * Eint n 1 0 + (2) * Eint n 2 3 + (2) * Eint n 3 0 := by
  simp [Eint]; ring

theorem cert_33 (n : Fin 4 → ℤ) : 6 * (n 3 * n 3) = (1) * Eint n 1 1 + (1) * Eint n 1 3 + (-2) * Eint n 2 0 + (-1) * Eint n 3 3 := by
  simp [Eint]; ring

theorem Eint_eq (n : Fin 4 → ℤ) (k l : Fin 4) :
    coordQ (comb n * eQ k * star (comb n)) l = Eint n k l := by
  fin_cases k <;> fin_cases l <;> simp [coordQ, comb, eQ, Eint] <;> ring

/-- If `x = comb n` normalizes `𝒪`, then `nrd x` divides every `E_kl`. -/
theorem nrd_dvd_Eint (x : Bˣ) (n : Fin 4 → ℤ) (hxn : (x : B) = comb n)
    (hx : ∀ y ∈ O, (x : B) * y * ((x⁻¹ : Bˣ) : B) ∈ O) (k l : Fin 4) : nrdInt n ∣ Eint n k l := by
  obtain ⟨m, hm⟩ := hx (eQ k) ⟨_, rfl⟩
  have hstar : star (x : B) = nrd (x : B) • ((x⁻¹ : Bˣ) : B) := by
    have : ((x⁻¹ : Bˣ) : B) * ((x : B) * star (x : B)) = star (x : B) := by
      rw [← mul_assoc, Units.inv_mul, one_mul]
    rw [← this, mul_star_eq, Algebra.smul_def, ← Algebra.commutes]
  have e : (Eint n k l : ℚ) = nrdInt n * m l := by
    rw [← Eint_eq, ← hxn, hstar, mul_smul_comm, ← hm]
    have : ∀ (c : ℚ) (y : B), coordQ (c • y) l = c * coordQ y l := by
      intro c y; fin_cases l <;> simp [coordQ] <;> ring
    rw [this, coordQ_comb, hxn, nrd_comb]
  exact ⟨m l, by exact_mod_cast e⟩

/-- **Global finite computation.** A primitive element of `𝒪` normalizing `𝒪` has `nrd ∣ 6`. -/
theorem nrd_dvd_six (x : Bˣ) (n : Fin 4 → ℤ) (hxn : (x : B) = comb n)
    (hprim : ∃ s : Fin 4 → ℤ, s 0 * n 0 + s 1 * n 1 + s 2 * n 2 + s 3 * n 3 = 1)
    (hx : ∀ y ∈ O, (x : B) * y * ((x⁻¹ : Bˣ) : B) ∈ O) : nrdInt n ∣ 6 := by
  obtain ⟨s, hs⟩ := hprim
  have d := nrd_dvd_Eint x n hxn hx
  have h00 : nrdInt n ∣ 6 * (n 0 * n 0) := by
    rw [cert_00]; repeat' apply dvd_add
    all_goals exact dvd_mul_of_dvd_right (d _ _) _
  have h01 : nrdInt n ∣ 6 * (n 0 * n 1) := by
    rw [cert_01]; repeat' apply dvd_add
    all_goals exact dvd_mul_of_dvd_right (d _ _) _
  have h02 : nrdInt n ∣ 6 * (n 0 * n 2) := by
    rw [cert_02]; repeat' apply dvd_add
    all_goals exact dvd_mul_of_dvd_right (d _ _) _
  have h03 : nrdInt n ∣ 6 * (n 0 * n 3) := by
    rw [cert_03]; repeat' apply dvd_add
    all_goals exact dvd_mul_of_dvd_right (d _ _) _
  have h11 : nrdInt n ∣ 6 * (n 1 * n 1) := by
    rw [cert_11]; repeat' apply dvd_add
    all_goals exact dvd_mul_of_dvd_right (d _ _) _
  have h12 : nrdInt n ∣ 6 * (n 1 * n 2) := by
    rw [cert_12]; repeat' apply dvd_add
    all_goals exact dvd_mul_of_dvd_right (d _ _) _
  have h13 : nrdInt n ∣ 6 * (n 1 * n 3) := by
    rw [cert_13]; repeat' apply dvd_add
    all_goals exact dvd_mul_of_dvd_right (d _ _) _
  have h22 : nrdInt n ∣ 6 * (n 2 * n 2) := by
    rw [cert_22]; repeat' apply dvd_add
    all_goals exact dvd_mul_of_dvd_right (d _ _) _
  have h23 : nrdInt n ∣ 6 * (n 2 * n 3) := by
    rw [cert_23]; repeat' apply dvd_add
    all_goals exact dvd_mul_of_dvd_right (d _ _) _
  have h33 : nrdInt n ∣ 6 * (n 3 * n 3) := by
    rw [cert_33]; repeat' apply dvd_add
    all_goals exact dvd_mul_of_dvd_right (d _ _) _
  have e : (6 : ℤ) = s 0 ^ 2 * (6 * (n 0 * n 0)) + 2 * s 0 * s 1 * (6 * (n 0 * n 1))
      + 2 * s 0 * s 2 * (6 * (n 0 * n 2)) + 2 * s 0 * s 3 * (6 * (n 0 * n 3))
      + s 1 ^ 2 * (6 * (n 1 * n 1)) + 2 * s 1 * s 2 * (6 * (n 1 * n 2)) + 2 * s 1 * s 3 * (6 * (n 1 * n 3))
      + s 2 ^ 2 * (6 * (n 2 * n 2)) + 2 * s 2 * s 3 * (6 * (n 2 * n 3)) + s 3 ^ 2 * (6 * (n 3 * n 3)) := by
    linear_combination (-6) * (s 0 * n 0 + s 1 * n 1 + s 2 * n 2 + s 3 * n 3 + 1) * hs
  rw [e]
  repeat' apply dvd_add
  all_goals first
    | exact dvd_mul_of_dvd_right h00 _
    | exact dvd_mul_of_dvd_right h01 _
    | exact dvd_mul_of_dvd_right h02 _
    | exact dvd_mul_of_dvd_right h03 _
    | exact dvd_mul_of_dvd_right h11 _
    | exact dvd_mul_of_dvd_right h12 _
    | exact dvd_mul_of_dvd_right h13 _
    | exact dvd_mul_of_dvd_right h22 _
    | exact dvd_mul_of_dvd_right h23 _
    | exact dvd_mul_of_dvd_right h33 _
end GlueVigneras.Global
