import Mathlib

/-!
# glue-vigneras, global part: the normalizer of N5's order `𝒪` in `B^×`, `B = (2,-3)` over `ℚ`

Main theorem `nrd_dvd_six`: if `x = comb n ∈ 𝒪` is primitive (`∑ sₖ nₖ = 1`) and normalizes `𝒪`,
then `nrd x ∣ 6`. So every element of `N_B(𝒪)` is `r·x₀` with `r ∈ ℚ^×`, `x₀ ∈ 𝒪` and
`nrd x₀ ∈ {±1, ±2, ±3, ±6}`; this is the finite computation behind `[N_B(𝒪) : ℚ^×𝒪^×] ≤ 4`.
`B`, `comb`, `𝒪` are copied from `scratch/glue-repo/A1Quaternion.lean` (scratch files cannot import
each other). The certificate section is generated by `gen_global.py`.
-/

open Quaternion

attribute [local simp] QuaternionAlgebra.re_ofNat QuaternionAlgebra.imI_ofNat QuaternionAlgebra.imJ_ofNat QuaternionAlgebra.imK_ofNat

namespace GlueVigneras.Global

abbrev B := ℍ[ℚ, 2, 0, -3]

def comb (n : Fin 4 → ℤ) : B :=
  ⟨n 0 + n 2 / 2, n 1 + n 3 / 2, n 2 / 2, n 3 / 2⟩

/-- `𝒪 = ℤ⟨1, i, (1+j)/2, (i+ij)/2⟩` (as a set; glue-repo proves it is a subring). -/
def O : Set B := Set.range comb

/-- Coordinates in N5's basis. -/
def coordQ (x : B) : Fin 4 → ℚ := ![x.re - x.imJ, x.imI - x.imK, 2 * x.imJ, 2 * x.imK]

theorem coordQ_comb (n : Fin 4 → ℤ) (l : Fin 4) : coordQ (comb n) l = n l := by
  fin_cases l <;> simp [coordQ, comb] <;> ring

def nrd (x : B) : ℚ := (x * star x).re

theorem mul_star_eq (x : B) : x * star x = algebraMap ℚ B (nrd x) := by
  ext <;> simp [nrd] <;> ring

/-- `nrd (comb n)` as an integer form: `N(n₀,n₂) − 2N(n₁,n₃)`, `N = x² + xy + y²`. -/
def nrdInt (n : Fin 4 → ℤ) : ℤ := (n 0 ^ 2 + n 0 * n 2 + n 2 ^ 2) - 2 * (n 1 ^ 2 + n 1 * n 3 + n 3 ^ 2)

theorem nrd_comb (n : Fin 4 → ℤ) : nrd (comb n) = nrdInt n := by
  simp [nrd, comb, nrdInt]; ring

/-- N5's basis. -/
def eQ (k : Fin 4) : B := comb (fun l => if l = k then 1 else 0)

/-- `Eint n k l`: coordinate `l` (N5's basis) of `x eₖ x̄` for `x = comb n` (generated by `gen_global.py`). -/

def Eint (n : Fin 4 → ℤ) : Fin 4 → Fin 4 → ℤ := ![

  ![(-2)*n 3^2 + (1)*n 2^2 + (-2)*n 1*n 3 + (-2)*n 1^2 + (1)*n 0*n 2 + (1)*n 0^2, 0, 0, 0],
  ![(2)*n 2*n 3 + (2)*n 1*n 2 + (2)*n 0*n 3, (2)*n 3^2 + (-2)*n 1^2 + (2)*n 0*n 2 + (1)*n 0^2, (-4)*n 2*n 3 + (-4)*n 1*n 2 + (-4)*n 0*n 3, (-2)*n 3^2 + (-1)*n 2^2 + (-4)*n 1*n 3 + (-2)*n 0*n 2],
  ![(-2)*n 3^2 + (-2)*n 1*n 3 + (-2)*n 1^2, (-1)*n 2*n 3 + (1)*n 1*n 2 + (-2)*n 0*n 3 + (-1)*n 0*n 1, (2)*n 3^2 + (1)*n 2^2 + (2)*n 1*n 3 + (2)*n 1^2 + (1)*n 0*n 2 + (1)*n 0^2, (2)*n 2*n 3 + (1)*n 1*n 2 + (1)*n 0*n 3 + (2)*n 0*n 1],
  ![(2)*n 2*n 3 + (-2)*n 0*n 1, (1)*n 2^2 + (-4)*n 1*n 3 + (-2)*n 1^2 + (2)*n 0*n 2, (-4)*n 2*n 3 + (4)*n 0*n 1, (-2)*n 3^2 + (-1)*n 2^2 + (2)*n 1^2 + (1)*n 0^2]]

theorem cert_00 (n : Fin 4 → ℤ) : 6 * (n 0 * n 0) = (4) * Eint n 0 0 + (2) * Eint n 1 1 + (2) * Eint n 1 3 + (-4) * Eint n 2 0 + (-2) * Eint n 3 1 := by
  simp [Eint]; ring

theorem cert_01 (n : Fin 4 → ℤ) : 6 * (n 0 * n 1) = (-1) * Eint n 1 0 + (2) * Eint n 2 3 + (-1) * Eint n 3 0 := by
  simp [Eint]; ring

theorem cert_02 (n : Fin 4 → ℤ) : 6 * (n 0 * n 2) = (-2) * Eint n 0 0 + (-2) * Eint n 1 3 + (2) * Eint n 2 0 + (2) * Eint n 3 1 + (2) * Eint n 3 3 := by
  simp [Eint]; ring

theorem cert_03 (n : Fin 4 → ℤ) : 6 * (n 0 * n 3) = (2) * Eint n 1 0 + (-2) * Eint n 2 1 + (-2) * Eint n 2 3 + (-1) * Eint n 3 0 := by
  simp [Eint]; ring

theorem cert_11 (n : Fin 4 → ℤ) : 6 * (n 1 * n 1) = (-1) * Eint n 1 1 + (-2) * Eint n 2 0 + (1) * Eint n 3 1 + (1) * Eint n 3 3 := by
  simp [Eint]; ring

theorem cert_12 (n : Fin 4 → ℤ) : 6 * (n 1 * n 2) = (2) * Eint n 1 0 + (2) * Eint n 2 1 + (-1) * Eint n 3 0 := by
  simp [Eint]; ring

theorem cert_13 (n : Fin 4 → ℤ) : 6 * (n 1 * n 3) = (-1) * Eint n 1 3 + (1) * Eint n 2 0 + (-1) * Eint n 3 1 := by
  simp [Eint]; ring

theorem cert_22 (n : Fin 4 → ℤ) : 6 * (n 2 * n 2) = (4) * Eint n 0 0 + (-2) * Eint n 1 1 + (-4) * Eint n 2 0 + (-2) * Eint n 3 3 := by
  simp [Eint]; ring

theorem cert_23 (n : Fin 4 → ℤ) : 6 * (n 2 * n 3) = (-1) * Eint n 1 0 + (2) * Eint n 2 3 + (2) * Eint n 3 0 := by
  simp [Eint]; ring

theorem cert_33 (n : Fin 4 → ℤ) : 6 * (n 3 * n 3) = (1) * Eint n 1 1 + (1) * Eint n 1 3 + (-2) * Eint n 2 0 + (-1) * Eint n 3 3 := by
  simp [Eint]; ring

theorem Eint_eq (n : Fin 4 → ℤ) (k l : Fin 4) :
    coordQ (comb n * eQ k * star (comb n)) l = Eint n k l := by
  fin_cases k <;> fin_cases l <;> simp [coordQ, comb, eQ, Eint] <;> ring

/-- If `x = comb n` normalizes `𝒪`, then `nrd x` divides every `E_kl`. -/
theorem nrd_dvd_Eint (x : Bˣ) (n : Fin 4 → ℤ) (hxn : (x : B) = comb n)
    (hx : ∀ y ∈ O, (x : B) * y * ((x⁻¹ : Bˣ) : B) ∈ O) (k l : Fin 4) : nrdInt n ∣ Eint n k l := by
  obtain ⟨m, hm⟩ := hx (eQ k) ⟨_, rfl⟩
  have hstar : star (x : B) = nrd (x : B) • ((x⁻¹ : Bˣ) : B) := by
    have : ((x⁻¹ : Bˣ) : B) * ((x : B) * star (x : B)) = star (x : B) := by
      rw [← mul_assoc, Units.inv_mul, one_mul]
    rw [← this, mul_star_eq, Algebra.smul_def, ← Algebra.commutes]
  have e : (Eint n k l : ℚ) = nrdInt n * m l := by
    rw [← Eint_eq, ← hxn, hstar, mul_smul_comm, ← hm]
    have : ∀ (c : ℚ) (y : B), coordQ (c • y) l = c * coordQ y l := by
      intro c y; fin_cases l <;> simp [coordQ] <;> ring
    rw [this, coordQ_comb, hxn, nrd_comb]
  exact ⟨m l, by exact_mod_cast e⟩

/-- **Global finite computation.** A primitive element of `𝒪` normalizing `𝒪` has `nrd ∣ 6`. -/
theorem nrd_dvd_six (x : Bˣ) (n : Fin 4 → ℤ) (hxn : (x : B) = comb n)
    (hprim : ∃ s : Fin 4 → ℤ, s 0 * n 0 + s 1 * n 1 + s 2 * n 2 + s 3 * n 3 = 1)
    (hx : ∀ y ∈ O, (x : B) * y * ((x⁻¹ : Bˣ) : B) ∈ O) : nrdInt n ∣ 6 := by
  obtain ⟨s, hs⟩ := hprim
  have d := nrd_dvd_Eint x n hxn hx
  have h00 : nrdInt n ∣ 6 * (n 0 * n 0) := by
    rw [cert_00]; repeat' apply dvd_add
    all_goals exact dvd_mul_of_dvd_right (d _ _) _
  have h01 : nrdInt n ∣ 6 * (n 0 * n 1) := by
    rw [cert_01]; repeat' apply dvd_add
    all_goals exact dvd_mul_of_dvd_right (d _ _) _
  have h02 : nrdInt n ∣ 6 * (n 0 * n 2) := by
    rw [cert_02]; repeat' apply dvd_add
    all_goals exact dvd_mul_of_dvd_right (d _ _) _
  have h03 : nrdInt n ∣ 6 * (n 0 * n 3) := by
    rw [cert_03]; repeat' apply dvd_add
    all_goals exact dvd_mul_of_dvd_right (d _ _) _
  have h11 : nrdInt n ∣ 6 * (n 1 * n 1) := by
    rw [cert_11]; repeat' apply dvd_add
    all_goals exact dvd_mul_of_dvd_right (d _ _) _
  have h12 : nrdInt n ∣ 6 * (n 1 * n 2) := by
    rw [cert_12]; repeat' apply dvd_add
    all_goals exact dvd_mul_of_dvd_right (d _ _) _
  have h13 : nrdInt n ∣ 6 * (n 1 * n 3) := by
    rw [cert_13]; repeat' apply dvd_add
    all_goals exact dvd_mul_of_dvd_right (d _ _) _
  have h22 : nrdInt n ∣ 6 * (n 2 * n 2) := by
    rw [cert_22]; repeat' apply dvd_add
    all_goals exact dvd_mul_of_dvd_right (d _ _) _
  have h23 : nrdInt n ∣ 6 * (n 2 * n 3) := by
    rw [cert_23]; repeat' apply dvd_add
    all_goals exact dvd_mul_of_dvd_right (d _ _) _
  have h33 : nrdInt n ∣ 6 * (n 3 * n 3) := by
    rw [cert_33]; repeat' apply dvd_add
    all_goals exact dvd_mul_of_dvd_right (d _ _) _
  have e : (6 : ℤ) = s 0 ^ 2 * (6 * (n 0 * n 0)) + 2 * s 0 * s 1 * (6 * (n 0 * n 1))
      + 2 * s 0 * s 2 * (6 * (n 0 * n 2)) + 2 * s 0 * s 3 * (6 * (n 0 * n 3))
      + s 1 ^ 2 * (6 * (n 1 * n 1)) + 2 * s 1 * s 2 * (6 * (n 1 * n 2)) + 2 * s 1 * s 3 * (6 * (n 1 * n 3))
      + s 2 ^ 2 * (6 * (n 2 * n 2)) + 2 * s 2 * s 3 * (6 * (n 2 * n 3)) + s 3 ^ 2 * (6 * (n 3 * n 3)) := by
    linear_combination (-6) * (s 0 * n 0 + s 1 * n 1 + s 2 * n 2 + s 3 * n 3 + 1) * hs
  rw [e]
  repeat' apply dvd_add
  all_goals first
    | exact dvd_mul_of_dvd_right h00 _
    | exact dvd_mul_of_dvd_right h01 _
    | exact dvd_mul_of_dvd_right h02 _
    | exact dvd_mul_of_dvd_right h03 _
    | exact dvd_mul_of_dvd_right h11 _
    | exact dvd_mul_of_dvd_right h12 _
    | exact dvd_mul_of_dvd_right h13 _
    | exact dvd_mul_of_dvd_right h22 _
    | exact dvd_mul_of_dvd_right h23 _
    | exact dvd_mul_of_dvd_right h33 _

/-! ## The global index `[N_B(𝒪) : ℚ^×𝒪^×] = 4` -/

/-- Structure constants of `𝒪` (copied from glue-repo). -/
def combMul (n m : Fin 4 → ℤ) : Fin 4 → ℤ :=
  ![m 0 * n 0 + 2 * m 1 * n 1 + 2 * m 1 * n 3 - m 2 * n 2 + 2 * m 3 * n 3,
    m 0 * n 1 + m 1 * n 0 + m 1 * n 2 - m 2 * n 3 + m 3 * n 2,
    m 0 * n 2 - 2 * m 1 * n 3 + m 2 * n 0 + m 2 * n 2 + 2 * m 3 * n 1,
    m 0 * n 3 - m 1 * n 2 + m 2 * n 1 + m 2 * n 3 + m 3 * n 0]

theorem comb_mul (n m : Fin 4 → ℤ) : comb n * comb m = comb (combMul n m) := by
  ext <;> simp [comb, combMul] <;> push_cast <;> ring

theorem O_mul {x y : B} (hx : x ∈ O) (hy : y ∈ O) : x * y ∈ O := by
  obtain ⟨n, rfl⟩ := hx; obtain ⟨m, rfl⟩ := hy; exact ⟨_, (comb_mul n m).symm⟩

theorem star_comb (n : Fin 4 → ℤ) : star (comb n) = comb ![n 0 + n 2, -n 1, -n 2, -n 3] := by
  ext <;> simp [comb] <;> ring

theorem O_star {x : B} (hx : x ∈ O) : star x ∈ O := by
  obtain ⟨n, rfl⟩ := hx; exact ⟨_, (star_comb n).symm⟩

theorem O_smul_int {x : B} (hx : x ∈ O) (c : ℤ) : (c : ℚ) • x ∈ O := by
  obtain ⟨n, rfl⟩ := hx; exact ⟨c • n, by ext <;> simp [comb] <;> ring⟩

theorem nrd_mul (x y : B) : nrd (x * y) = nrd x * nrd y := by
  simp [nrd]; ring

theorem nrd_one : nrd 1 = 1 := by simp [nrd]

theorem nrd_smul (c : ℚ) (x : B) : nrd (c • x) = c ^ 2 * nrd x := by
  simp [nrd]; ring

/-- `nrd` as a monoid hom. -/
def nrdHom : B →* ℚ where
  toFun := nrd
  map_one' := nrd_one
  map_mul' := nrd_mul

/-- The normalizer `N_B(𝒪) = {x ∈ B^× : x 𝒪 x⁻¹ = 𝒪}`. -/
def N : Subgroup Bˣ where
  carrier := {x | ∀ y : B, y ∈ O ↔ (x : B) * y * ((x⁻¹ : Bˣ) : B) ∈ O}
  one_mem' := by intro y; simp
  mul_mem' := by
    intro a b ha hb y
    rw [hb y, ha]
    simp only [Units.val_mul, mul_inv_rev, mul_assoc]
  inv_mem' := by
    intro a ha y
    rw [ha ((((a⁻¹ : Bˣ) : B) * y * (((a⁻¹)⁻¹ : Bˣ) : B)))]
    simp only [inv_inv, mul_assoc, Units.mul_inv_cancel_left]
    simp [mul_assoc]

/-- `𝒪^×`. -/
def OUnits : Set Bˣ := {u | (u : B) ∈ O ∧ ((u⁻¹ : Bˣ) : B) ∈ O}

/-- `ℚ^× 𝒪^×`. -/
def S : Set Bˣ := {x | ∃ c : ℚˣ, ∃ u ∈ OUnits, (x : B) = (c : ℚ) • (u : B)}

def iU : Bˣ := ⟨⟨0, 1, 0, 0⟩, ⟨0, 1/2, 0, 0⟩, by ext <;> simp <;> norm_num, by ext <;> simp <;> norm_num⟩
def jU : Bˣ := ⟨⟨0, 0, 1, 0⟩, ⟨0, 0, -1/3, 0⟩, by ext <;> simp <;> norm_num, by ext <;> simp <;> norm_num⟩

theorem conj_mem_N (x : Bˣ) (L : (Fin 4 → ℤ) → (Fin 4 → ℤ))
    (h1 : ∀ n, (x : B) * comb n * ((x⁻¹ : Bˣ) : B) = comb (L n))
    (h2 : ∀ n, ((x⁻¹ : Bˣ) : B) * comb n * (x : B) = comb (L n)) : x ∈ N := by
  intro y
  constructor
  · rintro ⟨n, rfl⟩; exact ⟨_, (h1 n).symm⟩
  · rintro ⟨m, hm⟩
    have : y = ((x⁻¹ : Bˣ) : B) * ((x : B) * y * ((x⁻¹ : Bˣ) : B)) * (x : B) := by
      simp [mul_assoc]
    rw [this, ← hm, h2]; exact ⟨_, rfl⟩

theorem iU_mem : iU ∈ N := by
  apply conj_mem_N iU (fun n => ![n 0 + n 2, n 1 + n 3, -n 2, -n 3])
  · intro n; ext <;> simp [iU, comb] <;> ring
  · intro n; ext <;> simp [iU, comb] <;> ring

theorem jU_mem : jU ∈ N := by
  apply conj_mem_N jU (fun n => ![n 0, -n 1, n 2, -n 3])
  · intro n; ext <;> simp [jU, comb] <;> ring
  · intro n; ext <;> simp [jU, comb] <;> ring

theorem nrd_iU : nrd (iU : B) = -2 := by simp [nrd, iU]
theorem nrd_jU : nrd (jU : B) = 3 := by simp [nrd, jU]


theorem eq_of_coordQ {x y : B} (h : ∀ k, coordQ x k = coordQ y k) : x = y := by
  have h0 := h 0; have h1 := h 1; have h2 := h 2; have h3 := h 3
  simp [coordQ] at h0 h1 h2 h3
  ext <;> linarith

theorem coordQ_smul (c : ℚ) (x : B) (k : Fin 4) : coordQ (c • x) k = c * coordQ x k := by
  fin_cases k <;> simp [coordQ] <;> ring

/-- **Primitive scaling.** Every nonzero `x ∈ B` is `c · comb a` with `c ∈ ℚ^×` and `a` primitive. -/
theorem primitive_scaling (x : B) (hx : x ≠ 0) : ∃ c : ℚ, c ≠ 0 ∧ ∃ a : Fin 4 → ℤ,
    (∃ s0 s1 s2 s3 : ℤ, s0 * a 0 + s1 * a 1 + s2 * a 2 + s3 * a 3 = 1) ∧ x = c • comb a := by
  set q := coordQ x
  set D : ℤ := (q 0).den * (q 1).den * (q 2).den * (q 3).den with hD
  have hDpos : (D : ℚ) ≠ 0 := by
    simp only [hD]; push_cast; positivity
  let m : Fin 4 → ℤ := ![(q 0).num * ((q 1).den * (q 2).den * (q 3).den),
    (q 1).num * ((q 0).den * (q 2).den * (q 3).den), (q 2).num * ((q 0).den * (q 1).den * (q 3).den),
    (q 3).num * ((q 0).den * (q 1).den * (q 2).den)]
  have hm0 : (D : ℚ) * q 0 = m 0 := by
    show (D : ℚ) * q 0 = (((q 0).num * ((q 1).den * (q 2).den * (q 3).den) : ℤ) : ℚ)
    rw [hD]; push_cast; rw [← Rat.mul_den_eq_num (q 0)]; ring
  have hm1 : (D : ℚ) * q 1 = m 1 := by
    show (D : ℚ) * q 1 = (((q 1).num * ((q 0).den * (q 2).den * (q 3).den) : ℤ) : ℚ)
    rw [hD]; push_cast; rw [← Rat.mul_den_eq_num (q 1)]; ring
  have hm2 : (D : ℚ) * q 2 = m 2 := by
    show (D : ℚ) * q 2 = (((q 2).num * ((q 0).den * (q 1).den * (q 3).den) : ℤ) : ℚ)
    rw [hD]; push_cast; rw [← Rat.mul_den_eq_num (q 2)]; ring
  have hm3 : (D : ℚ) * q 3 = m 3 := by
    show (D : ℚ) * q 3 = (((q 3).num * ((q 0).den * (q 1).den * (q 2).den) : ℤ) : ℚ)
    rw [hD]; push_cast; rw [← Rat.mul_den_eq_num (q 3)]; ring
  have hm : ∀ k, (D : ℚ) * q k = m k := by
    intro k; fin_cases k
    · exact hm0
    · exact hm1
    · exact hm2
    · exact hm3
  set g1 := Int.gcd (m 0) (m 1)
  set g2 := Int.gcd (m 2) (m 3)
  set g := Int.gcd g1 g2
  have hg0 : (g : ℤ) ≠ 0 := by
    intro h0
    have : g = 0 := by exact_mod_cast h0
    simp only [g, g1, g2, Int.gcd_eq_zero_iff, Int.natCast_eq_zero] at this
    obtain ⟨⟨a0, a1⟩, a2, a3⟩ := this
    apply hx
    have hq : ∀ k, q k = 0 := by
      intro k
      have := hm k
      have hmk : m k = 0 := by fin_cases k <;> assumption
      rw [hmk, Int.cast_zero] at this
      exact (mul_eq_zero.mp this).resolve_left hDpos
    apply eq_of_coordQ; intro k; show q k = coordQ 0 k; rw [hq k]; fin_cases k <;> simp [coordQ]
  have hdvd : ∀ k, (g : ℤ) ∣ m k := by
    intro k
    have d1 : (g : ℤ) ∣ g1 := Int.gcd_dvd_left _ _
    have d2 : (g : ℤ) ∣ g2 := Int.gcd_dvd_right _ _
    fin_cases k
    · exact d1.trans (Int.gcd_dvd_left _ _)
    · exact d1.trans (Int.gcd_dvd_right _ _)
    · exact d2.trans (Int.gcd_dvd_left _ _)
    · exact d2.trans (Int.gcd_dvd_right _ _)
  let a : Fin 4 → ℤ := fun k => m k / g
  have ha : ∀ k, m k = g * a k := fun k => (Int.mul_ediv_cancel' (hdvd k)).symm
  refine ⟨(g : ℚ) / D, div_ne_zero (by exact_mod_cast hg0) hDpos, a, ?_, ?_⟩
  · have b : (g : ℤ) = (g1 : ℤ) * Int.gcdA g1 g2 + (g2 : ℤ) * Int.gcdB g1 g2 :=
      Int.gcd_eq_gcd_ab _ _
    have b1 : (g1 : ℤ) = m 0 * Int.gcdA (m 0) (m 1) + m 1 * Int.gcdB (m 0) (m 1) :=
      Int.gcd_eq_gcd_ab _ _
    have b2 : (g2 : ℤ) = m 2 * Int.gcdA (m 2) (m 3) + m 3 * Int.gcdB (m 2) (m 3) :=
      Int.gcd_eq_gcd_ab _ _
    refine ⟨Int.gcdA (m 0) (m 1) * Int.gcdA g1 g2, Int.gcdB (m 0) (m 1) * Int.gcdA g1 g2,
      Int.gcdA (m 2) (m 3) * Int.gcdB g1 g2, Int.gcdB (m 2) (m 3) * Int.gcdB g1 g2, ?_⟩
    apply mul_left_cancel₀ hg0
    linear_combination (-(Int.gcdA (m 0) (m 1) * Int.gcdA g1 g2)) * ha 0
      - (Int.gcdB (m 0) (m 1) * Int.gcdA g1 g2) * ha 1
      - (Int.gcdA (m 2) (m 3) * Int.gcdB g1 g2) * ha 2
      - (Int.gcdB (m 2) (m 3) * Int.gcdB g1 g2) * ha 3
      - Int.gcdA g1 g2 * b1 - Int.gcdB g1 g2 * b2 - b
  · apply eq_of_coordQ; intro k
    rw [coordQ_smul, coordQ_comb]
    have e1 := hm k
    rw [ha k] at e1
    push_cast at e1
    field_simp
    linarith

end GlueVigneras.Global
