/-! # infra-hodge, part 4b: `ProductHodgeLattice`

**`productHodgeLattice_of : TrivialPointsCotangent → ProductHodgeLattice`.** -/

namespace ZInQ.InfraHodge

open CategoryTheory AlgebraicGeometry Limits MonoidalCategory CartesianMonoidalCategory MonObj
open NumberField ZInQ.DefFaltings ZInQ.Metrization Module
open scoped TensorProduct

section Main

variable {K : Type} [Field K] {A B C : AbVar K} {L : Type} [Field L] [NumberField L] [Algebra K L]


/-- **`ProductHodgeLattice` from `TrivialPointsCotangent`** (the latter is used only when one
of the factors has `g = 0`). -/
theorem productHodgeLattice_of (h0 : TrivialPointsCotangent) : ProductHodgeLattice := by
  intro K _ A B C L _ _ _ 𝒢P g₁ g₂ M₁ M₂ e hfst hsnd
  haveI := hfst
  haveI := hsnd
  letI := cotL M₁.model
  letI := cotL M₂.model
  letI := cotL 𝒢P
  haveI := cotL_isScalarTower M₁.model
  haveI := cotL_isScalarTower M₂.model
  haveI := cotL_isScalarTower 𝒢P
  have hz : ∀ {g : ℕ} {X : AbVar K} (M : MetrizedModel X L g), g = 0 →
      Subsingleton M.model.cotangent := by
    intro g X M hg; subst hg; exact subsingleton_of_dim_zero h0 M
  obtain ⟨u, hu⟩ := exists_omega_basis M₁ (hz M₁)
  obtain ⟨w, hw⟩ := exists_omega_basis M₂ (hz M₂)
  set P1 := cotGL (e.hom ≫ fst _ _) (hp1 e)
  set P2 := cotGL (e.hom ≫ snd _ _) (hp2 e)
  set I1 := cotGL (incl1 e) (hi1 e)
  set I2 := cotGL (incl2 e) (hi2 e)
  let Ψ : (M₁.model.cotangent × M₂.model.cotangent) ≃ₗ[L] 𝒢P.cotangent :=
    LinearEquiv.ofLinearMap (P1.coprod P2) (I1.prod I2)
      (LinearMap.ext fun v => (cot_split e v).symm)
      (LinearMap.ext fun v => by
        refine Prod.ext ?_ ?_
        · show I1 (P1 v.1 + P2 v.2) = v.1
          rw [map_add]
          exact (congrArg₂ (· + ·) (cot_i1_p1 e v.1) (cot_i1_p2 e v.2)).trans (add_zero _)
        · show I2 (P1 v.1 + P2 v.2) = v.2
          rw [map_add]
          exact (congrArg₂ (· + ·) (cot_i2_p1 e v.1) (cot_i2_p2 e v.2)).trans (zero_add _))
  have hΨ : ∀ x y, Ψ (x, y) = P1 x + P2 y := fun x y => rfl
  have hΨs : ∀ v, Ψ.symm v = (I1 v, I2 v) := fun v => rfl
  set B : Basis (Fin (g₁ + g₂)) L 𝒢P.cotangent := ((u.prod w).map Ψ).reindex finSumFinEquiv
    with hBdef
  have hB1 : ∀ i, B (Fin.castAdd g₂ i) = P1 (u i) := by
    intro i
    rw [hBdef, Basis.reindex_apply, Basis.map_apply, finSumFinEquiv_symm_apply_castAdd,
      Basis.prod_apply]
    show Ψ (u i, 0) = _
    rw [hΨ, map_zero, add_zero]
  have hB2 : ∀ j, B (Fin.natAdd g₁ j) = P2 (w j) := by
    intro j
    rw [hBdef, Basis.reindex_apply, Basis.map_apply, finSumFinEquiv_symm_apply_natAdd,
      Basis.prod_apply]
    show Ψ (0, w j) = _
    rw [hΨ, map_zero, zero_add]
  have hPω1 : ∀ x ∈ M₁.model.omega, P1 x ∈ 𝒢P.omega :=
    fun x hx => cotG_omega _ (IsMonHom.one_hom _) (hp1 e) hx
  have hPω2 : ∀ x ∈ M₂.model.omega, P2 x ∈ 𝒢P.omega :=
    fun x hx => cotG_omega _ (IsMonHom.one_hom _) (hp2 e) hx
  have hIω1 : ∀ v ∈ 𝒢P.omega, I1 v ∈ M₁.model.omega :=
    fun v hv => cotG_omega _ (one_comp_incl1 e) (hi1 e) hv
  have hIω2 : ∀ v ∈ 𝒢P.omega, I2 v ∈ M₂.model.omega :=
    fun v hv => cotG_omega _ (one_comp_incl2 e) (hi2 e) hv
  have hBω : ∀ k, B k ∈ 𝒢P.omega := by
    intro k
    refine Fin.addCases (fun i => ?_) (fun j => ?_) k
    · rw [hB1]; exact hPω1 _ (hu i)
    · rw [hB2]; exact hPω2 _ (hw j)
  have hdet : detIdeal B 𝒢P.omega =
      detIdeal (u.prod w) (M₁.model.omega.prod M₂.model.omega) := by
    apply le_antisymm
    · rw [detIdeal, Submodule.span_le]
      rintro _ ⟨v, rfl⟩
      refine Submodule.subset_span ⟨fun k => ⟨Ψ.symm (v (finSumFinEquiv k)),
        Submodule.mem_prod.mpr ⟨hIω1 _ (v _).2, hIω2 _ (v _).2⟩⟩, ?_⟩
      show (u.prod w).det (fun k => Ψ.symm (v (finSumFinEquiv k))) = B.det (fun k => (v k : _))
      rw [hBdef, Basis.det_reindex, Basis.det_map]
      rfl
    · rw [detIdeal, Submodule.span_le]
      rintro _ ⟨x, rfl⟩
      refine Submodule.subset_span ⟨fun k => ⟨Ψ (x (finSumFinEquiv.symm k)), ?_⟩, ?_⟩
      · obtain ⟨h1, h2⟩ := Submodule.mem_prod.mp (x (finSumFinEquiv.symm k)).2
        rw [show Ψ (x (finSumFinEquiv.symm k)) =
          P1 ((x (finSumFinEquiv.symm k) : M₁.model.cotangent × M₂.model.cotangent).1) +
          P2 ((x (finSumFinEquiv.symm k) : M₁.model.cotangent × M₂.model.cotangent).2) from rfl]
        exact add_mem (hPω1 _ h1) (hPω2 _ h2)
      · show B.det (fun k => Ψ (x (finSumFinEquiv.symm k))) = (u.prod w).det (fun k => (x k : _))
        rw [hBdef, Basis.det_reindex, Basis.det_map]
        congr 1
        funext k
        simp
  choose f₁ hf₁ using fun i =>
    (IsLocalRing.maximalIdeal M₁.model.genStalk).toCotangent_surjective (u i)
  choose f₂ hf₂ using fun j =>
    (IsLocalRing.maximalIdeal M₂.model.genStalk).toCotangent_surjective (w j)
  let f : Fin (g₁ + g₂) → IsLocalRing.maximalIdeal 𝒢P.genStalk := Fin.append
    (fun i => ⟨((e.hom ≫ fst _ _).left.stalkMapAt (hp1 e)).hom (f₁ i),
      map_nonunit ((e.hom ≫ fst _ _).left.stalkMapAt (hp1 e)).hom _ (f₁ i).2⟩)
    (fun j => ⟨((e.hom ≫ snd _ _).left.stalkMapAt (hp2 e)).hom (f₂ j),
      map_nonunit ((e.hom ≫ snd _ _).left.stalkMapAt (hp2 e)).hom _ (f₂ j).2⟩)
  have hf1 : ∀ i, (f (Fin.castAdd g₂ i) : 𝒢P.genStalk) =
      (pullGerm (e.hom ≫ fst _ _)).hom (f₁ i) := by
    intro i; simp only [f, Fin.append_left]; rfl
  have hf2 : ∀ j, (f (Fin.natAdd g₁ j) : 𝒢P.genStalk) =
      (pullGerm (e.hom ≫ snd _ _)).hom (f₂ j) := by
    intro j; simp only [f, Fin.append_right]; rfl
  have hdf : (fun k => 𝒢P.dCls (f k)) = fun k => B k := by
    funext k
    refine Fin.addCases (fun i => ?_) (fun j => ?_) k
    · rw [hB1]
      simp only [f, Fin.append_left]
      show (IsLocalRing.maximalIdeal _).toCotangent _ = cotMapAt (e.hom ≫ fst _ _).left (hp1 e) (u i)
      rw [← hf₁ i, cotMapAt_toCotangent]
    · rw [hB2]
      simp only [f, Fin.append_right]
      show (IsLocalRing.maximalIdeal _).toCotangent _ = cotMapAt (e.hom ≫ snd _ _).left (hp2 e) (w j)
      rw [← hf₂ j, cotMapAt_toCotangent]
  have hwP : 𝒢P.wedge f = (1 : L) ⊗ₜ[𝓞 L] exteriorPower.ιMulti (𝓞 L) (g₁ + g₂) B := by
    unfold GroupModel.wedge
    rw [hdf]
  have hw1 : M₁.model.wedge f₁ = (1 : L) ⊗ₜ[𝓞 L] exteriorPower.ιMulti (𝓞 L) g₁ u := by
    unfold GroupModel.wedge
    congr 2
    funext i
    exact hf₁ i
  have hw2 : M₂.model.wedge f₂ = (1 : L) ⊗ₜ[𝓞 L] exteriorPower.ιMulti (𝓞 L) g₂ w := by
    unfold GroupModel.wedge
    congr 2
    funext j
    exact hf₂ j
  have hne : ∀ {V : Type} [AddCommGroup V] [Module L V] [Module (𝓞 L) V]
      [IsScalarTower (𝓞 L) L V] {n : ℕ} (b : Basis (Fin n) L V),
      (1 : L) ⊗ₜ[𝓞 L] exteriorPower.ιMulti (𝓞 L) n b ≠ 0 := by
    intro V _ _ _ _ n b h
    have := congrArg (delta b) h
    rw [delta_tmul_one, b.det_self, map_zero] at this
    exact one_ne_zero this
  have hone : ∀ {V : Type} [AddCommGroup V] [Module L V] [Module (𝓞 L) V]
      [IsScalarTower (𝓞 L) L V] {n : ℕ} (b : Basis (Fin n) L V) (W : Submodule (𝓞 L) V),
      (∀ k, b k ∈ W) → (1 : L) ∈ detIdeal b W := by
    intro V _ _ _ _ n b W hb
    exact Submodule.subset_span ⟨fun k => ⟨b k, hb k⟩, b.det_self⟩
  have eP : (Submodule.span (𝓞 L) {(1 : L) ⊗ₜ[𝓞 L] exteriorPower.ιMulti (𝓞 L) (g₁ + g₂) B}).toAddSubgroup.relIndex
      (𝒢P.detLattice (g₁ + g₂)).toAddSubgroup = idx (detIdeal B 𝒢P.omega) :=
    relIndex_detLat B 𝒢P.omega
  have e1 : (Submodule.span (𝓞 L) {(1 : L) ⊗ₜ[𝓞 L] exteriorPower.ιMulti (𝓞 L) g₁ u}).toAddSubgroup.relIndex
      (M₁.model.detLattice g₁).toAddSubgroup = idx (detIdeal u M₁.model.omega) :=
    relIndex_detLat u M₁.model.omega
  have e2 : (Submodule.span (𝓞 L) {(1 : L) ⊗ₜ[𝓞 L] exteriorPower.ιMulti (𝓞 L) g₂ w}).toAddSubgroup.relIndex
      (M₂.model.detLattice g₂).toAddSubgroup = idx (detIdeal w M₂.model.omega) :=
    relIndex_detLat w M₂.model.omega
  refine ⟨finrank_hodge B, f₁, f₂, f, 1, 1, hf1, hf2, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · rw [one_smul, M₁.lattice_eq, hw1]
    exact Submodule.subset_span ⟨fun k => ⟨u k, hu k⟩, rfl⟩
  · rw [one_smul, hw1]; exact hne u
  · rw [one_smul, M₂.lattice_eq, hw2]
    exact Submodule.subset_span ⟨fun k => ⟨w k, hw k⟩, rfl⟩
  · rw [one_smul, hw2]; exact hne w
  · rw [_root_.mul_one, one_smul, hwP]
    exact Submodule.subset_span ⟨fun k => ⟨B k, hBω k⟩, rfl⟩
  · rw [_root_.mul_one, one_smul, hwP]; exact hne B
  · rw [_root_.mul_one, one_smul, one_smul, one_smul, M₁.lattice_eq, M₂.lattice_eq, hwP, hw1, hw2,
      secIndex_eq_relIndex, secIndex_eq_relIndex, secIndex_eq_relIndex, eP, e1, e2, hdet,
      detIdeal_prod, idx_mul (hone u _ hu) (hone w _ hw)]

end Main

end ZInQ.InfraHodge
