/-! # infra-hodge S-alg, part 6: `ProductMetrizationOfProductUnif` proved -/

namespace ZInQ.InfraHodge

open ZInQ.ProductHeight

/-- **product-height's glue S-alg `ProductMetrizationOfProductUnif` holds** (statement verbatim). -/
theorem productMetrizationOfProductUnif : ProductMetrizationOfProductUnif :=
  productMetrizationOfProductUnif_of prodUnifDeriv

/-- product-height's route S with S-alg discharged: `ProductModelHeight` (P2) from the single
analytic glue Prop `ProductUnifSplits` (S-an). -/
theorem productModelHeight_of_unifSplits (hS : ProductUnifSplits) :
    ZInQ.H5Neron.ProductModelHeight :=
  productModelHeight_of_splits hS productMetrizationOfProductUnif

end ZInQ.InfraHodge

