/-! # infra-hodge, part 1: cotangent maps of group models

* `cotMapAt f h`: the map `𝔪_y/𝔪_y² → 𝔪_x/𝔪_x²` induced by a morphism of schemes `f` with
  `f x = y`; functorial (`cotMapAt_comp`, `cotMapAt_id`); zero when it factors through a point
  whose local ring is a field (`cotMapAt_comp_eq_zero`).
* The `L`-structure `cotL` on `ω_{A_L} = 𝔪_ξ/𝔪_ξ²` (copied from hodge-bc2's `hbc_proof.lean.part`,
  with the infra-stalks/height-bc lemmas it uses).
* For a morphism of group models over `𝓞_L` the cotangent map is `𝓞_L`- and `L`-linear
  (`cotMapAt_smul_ring`, `cotMapAt_smulL`). -/

namespace ZInQ.InfraHodge

open CategoryTheory AlgebraicGeometry Limits MonoidalCategory CartesianMonoidalCategory MonObj
open NumberField ZInQ.DefFaltings
open PkgI3 (AbVar)
open scoped TensorProduct

section CotMap

theorem le_comap_stalkMapAt {X Y : Scheme.{0}} (f : X ⟶ Y) {x : X} {y : Y} (h : f x = y) :
    IsLocalRing.maximalIdeal (Y.presheaf.stalk y) ≤
      (IsLocalRing.maximalIdeal (X.presheaf.stalk x)).comap (f.stalkMapAt h).hom.toIntAlgHom :=
  fun t ht => map_nonunit (f.stalkMapAt h).hom t ht

/-- The cotangent map of `f : X ⟶ Y` between named points (`f x = y`). -/
noncomputable def cotMapAt {X Y : Scheme.{0}} (f : X ⟶ Y) {x : X} {y : Y} (h : f x = y) :
    IsLocalRing.CotangentSpace (Y.presheaf.stalk y) →ₗ[ℤ]
      IsLocalRing.CotangentSpace (X.presheaf.stalk x) :=
  Ideal.mapCotangent (IsLocalRing.maximalIdeal _) (IsLocalRing.maximalIdeal _)
    (f.stalkMapAt h).hom.toIntAlgHom (le_comap_stalkMapAt f h)

theorem cotMapAt_toCotangent {X Y : Scheme.{0}} (f : X ⟶ Y) {x : X} {y : Y} (h : f x = y)
    (t : IsLocalRing.maximalIdeal (Y.presheaf.stalk y)) :
    cotMapAt f h ((IsLocalRing.maximalIdeal _).toCotangent t) =
      (IsLocalRing.maximalIdeal _).toCotangent
        ⟨(f.stalkMapAt h).hom t, map_nonunit (f.stalkMapAt h).hom _ t.2⟩ := by
  unfold cotMapAt
  rw [Ideal.mapCotangent_toCotangent]
  rfl

theorem cotMapAt_smul {X Y : Scheme.{0}} (f : X ⟶ Y) {x : X} {y : Y} (h : f x = y)
    (r : Y.presheaf.stalk y) (v : IsLocalRing.CotangentSpace (Y.presheaf.stalk y)) :
    cotMapAt f h (r • v) = (f.stalkMapAt h).hom r • cotMapAt f h v := by
  obtain ⟨m, rfl⟩ := (IsLocalRing.maximalIdeal _).toCotangent_surjective v
  rw [← map_smul, cotMapAt_toCotangent, cotMapAt_toCotangent, ← map_smul]
  congr 1
  apply Subtype.ext
  simp only [SetLike.val_smul, smul_eq_mul, map_mul]

theorem cotMapAt_comp {X Y Z : Scheme.{0}} (f : X ⟶ Y) (g : Y ⟶ Z) {x : X} {y : Y} {z : Z}
    (hf : f x = y) (hg : g y = z) (hfg : (f ≫ g) x = z)
    (v : IsLocalRing.CotangentSpace (Z.presheaf.stalk z)) :
    cotMapAt (f ≫ g) hfg v = cotMapAt f hf (cotMapAt g hg v) := by
  obtain ⟨m, rfl⟩ := (IsLocalRing.maximalIdeal _).toCotangent_surjective v
  rw [cotMapAt_toCotangent, cotMapAt_toCotangent, cotMapAt_toCotangent]
  congr 2
  rw [Scheme.Hom.stalkMapAt_comp f g hf hg hfg]
  rfl

theorem cotMapAt_congr {X Y : Scheme.{0}} {f g : X ⟶ Y} (e : f = g) {x : X} {y : Y}
    (hf : f x = y) (hg : g x = y) (v : IsLocalRing.CotangentSpace (Y.presheaf.stalk y)) :
    cotMapAt f hf v = cotMapAt g hg v := by
  subst e; rfl

theorem cotMapAt_id {X : Scheme.{0}} (x : X) (h : (𝟙 X) x = x)
    (v : IsLocalRing.CotangentSpace (X.presheaf.stalk x)) : cotMapAt (𝟙 X) h v = v := by
  obtain ⟨m, rfl⟩ := (IsLocalRing.maximalIdeal _).toCotangent_surjective v
  rw [cotMapAt_toCotangent]
  congr 2
  rw [Scheme.Hom.stalkMapAt_id]
  rfl

/-- A cotangent map through a point whose local ring is a field vanishes. -/
theorem cotMapAt_comp_eq_zero {X Y Z : Scheme.{0}} (f : X ⟶ Y) (g : Y ⟶ Z) {x : X} {y : Y}
    {z : Z} (hf : f x = y) (hg : g y = z) (hfg : (f ≫ g) x = z)
    (hy : IsLocalRing.maximalIdeal (Y.presheaf.stalk y) = ⊥)
    (v : IsLocalRing.CotangentSpace (Z.presheaf.stalk z)) : cotMapAt (f ≫ g) hfg v = 0 := by
  rw [cotMapAt_comp f g hf hg hfg]
  obtain ⟨m, hm'⟩ := (IsLocalRing.maximalIdeal _).toCotangent_surjective (cotMapAt g hg v)
  rw [← hm']
  have hm : (m : Y.presheaf.stalk y) = 0 := by
    have h2 : (m : Y.presheaf.stalk y) ∈ (⊥ : Ideal (Y.presheaf.stalk y)) := hy ▸ m.2
    exact (Ideal.mem_bot).mp h2
  have : m = 0 := Subtype.ext hm
  rw [this, map_zero, map_zero]

end CotMap

section Basics

variable {K : Type} [Field K] {A : AbVar K}

/-! Copied from height-bc/infra-stalks (via hodge-bc2's `HBCPrefix.lean`, section `InfraStalks`)
and hodge-bc2's `hbc_proof.lean.part`, unchanged except for the namespace. -/

theorem unitSection_comp_hom {L : Type} [Field L] [NumberField L] [Algebra K L]
    (𝒢 : GroupModel A L) : 𝒢.unitSection ≫ 𝒢.G.hom = 𝟙 _ := by
  unfold GroupModel.unitSection
  simp

theorem hom_genericUnit {L : Type} [Field L] [NumberField L] [Algebra K L]
    (𝒢 : GroupModel A L) : 𝒢.G.hom 𝒢.genericUnit = genericPt L := by
  unfold GroupModel.genericUnit
  rw [← Scheme.Hom.comp_apply, unitSection_comp_hom]
  rfl

theorem genericPt_eq_genericPoint (L : Type) [Field L] [NumberField L] :
    genericPt L = genericPoint (Spec (CommRingCat.of (𝓞 L))) := by
  rw [genericPoint_eq_bot_of_affine]; rfl

theorem isField_stalk_genericPt (L : Type) [Field L] [NumberField L]
    (y : Spec (CommRingCat.of (𝓞 L))) (hy : y = genericPt L) :
    IsField ((Spec (CommRingCat.of (𝓞 L))).presheaf.stalk y) := by
  rw [hy, genericPt_eq_genericPoint]
  exact Field.toIsField (Spec (CommRingCat.of (𝓞 L))).functionField

theorem maximalIdeal_stalk_genericPt (L : Type) [Field L] [NumberField L]
    (y : Spec (CommRingCat.of (𝓞 L))) (hy : y = genericPt L) :
    IsLocalRing.maximalIdeal ((Spec (CommRingCat.of (𝓞 L))).presheaf.stalk y) = ⊥ :=
  (IsLocalRing.isField_iff_maximalIdeal_eq).mp (isField_stalk_genericPt L y hy)

theorem structMap_eq_stalkMap {L : Type} [Field L] [NumberField L] [Algebra K L]
    (𝒢 : GroupModel A L) (a : 𝓞 L) :
    𝒢.structMap a = 𝒢.G.hom.stalkMap 𝒢.genericUnit
      ((Spec (CommRingCat.of (𝓞 L))).presheaf.germ ⊤ (𝒢.G.hom 𝒢.genericUnit) trivial
        ((Scheme.ΓSpecIso (CommRingCat.of (𝓞 L))).inv a)) := by
  erw [Scheme.Hom.germ_stalkMap_apply 𝒢.G.hom ⊤ 𝒢.genericUnit (by trivial)]
  rfl

/-- The stalk map at named points on germs. -/
theorem stalkMapAt_germ' {X Y : Scheme.{0}} (f : X ⟶ Y) {x : X} {y : Y} (h : f x = y)
    (U : Y.Opens) (hy : y ∈ U) (hy' : f x ∈ U) (s : Γ(Y, U)) :
    f.stalkMapAt h (Y.presheaf.germ U y hy s) = f.stalkMap x (Y.presheaf.germ U (f x) hy' s) := by
  subst h; rw [Scheme.Hom.stalkMapAt_rfl]

/-- The function field of `Spec 𝓞_L`. -/
noncomputable abbrev FF (L : Type) [Field L] [NumberField L] : CommRingCat :=
  (Spec (CommRingCat.of (𝓞 L))).functionField

noncomputable instance (L : Type) [Field L] [NumberField L] : Algebra (𝓞 L) (FF L) :=
  ((Scheme.ΓSpecIso (CommRingCat.of (𝓞 L))).inv ≫ (Spec (CommRingCat.of (𝓞 L))).presheaf.germ ⊤
      (genericPoint (Spec (CommRingCat.of (𝓞 L)))) trivial).hom.toAlgebra

instance (L : Type) [Field L] [NumberField L] : IsFractionRing (𝓞 L) (FF L) := by
  have := functionField_isFractionRing_of_affine (CommRingCat.of (𝓞 L))
  exact this

theorem algebraMap_FF (L : Type) [Field L] [NumberField L] (a : 𝓞 L) :
    algebraMap (𝓞 L) (FF L) a = (Spec (CommRingCat.of (𝓞 L))).presheaf.germ ⊤
      (genericPoint (Spec (CommRingCat.of (𝓞 L)))) trivial
      ((Scheme.ΓSpecIso (CommRingCat.of (𝓞 L))).inv a) := rfl

/-- `L ≅ κ(η)`. -/
noncomputable def σFF (L : Type) [Field L] [NumberField L] : L ≃ₐ[𝓞 L] FF L :=
  IsLocalization.algEquiv (nonZeroDivisors (𝓞 L)) L (FF L)

theorem hom_genericUnit' {L : Type} [Field L] [NumberField L] [Algebra K L]
    (𝒢 : GroupModel A L) :
    𝒢.G.hom 𝒢.genericUnit = genericPoint (Spec (CommRingCat.of (𝓞 L))) :=
  (hom_genericUnit 𝒢).trans (genericPt_eq_genericPoint L)

/-- `φ : L → 𝒪_{𝒢,ξ}` (through `κ(η)`). -/
noncomputable def φL {L : Type} [Field L] [NumberField L] [Algebra K L] (𝒢 : GroupModel A L) :
    L →+* 𝒢.genStalk :=
  (𝒢.G.hom.stalkMapAt (hom_genericUnit' 𝒢)).hom.comp (σFF L).toRingEquiv.toRingHom

theorem φL_algebraMap {L : Type} [Field L] [NumberField L] [Algebra K L] (𝒢 : GroupModel A L)
    (a : 𝓞 L) : φL 𝒢 (algebraMap (𝓞 L) L a) = 𝒢.structMap a := by
  unfold φL
  rw [RingHom.comp_apply]
  change (𝒢.G.hom.stalkMapAt (hom_genericUnit' 𝒢)).hom ((σFF L) (algebraMap (𝓞 L) L a)) = _
  rw [AlgEquiv.commutes, algebraMap_FF, structMap_eq_stalkMap]
  exact stalkMapAt_germ' _ _ ⊤ trivial trivial _

/-- **The `L`-vector space structure on `ω_{A_L}`.** -/
noncomputable abbrev cotL {L : Type} [Field L] [NumberField L] [Algebra K L]
    (𝒢 : GroupModel A L) : Module L 𝒢.cotangent :=
  Module.compHom _ (φL 𝒢)

theorem cotL_smul {L : Type} [Field L] [NumberField L] [Algebra K L] (𝒢 : GroupModel A L)
    (c : L) (v : 𝒢.cotangent) :
    (letI := cotL 𝒢; c • v) = φL 𝒢 c • v := rfl

theorem cotL_isScalarTower {L : Type} [Field L] [NumberField L] [Algebra K L]
    (𝒢 : GroupModel A L) : letI := cotL 𝒢; IsScalarTower (𝓞 L) L 𝒢.cotangent := by
  letI := cotL 𝒢
  refine ⟨fun r c v => ?_⟩
  rw [cotL_smul, cotL_smul, Algebra.smul_def, map_mul, φL_algebraMap, mul_smul]
  rfl

end Basics

section GroupModelMaps

variable {K : Type} [Field K] {A B : AbVar K} {L : Type} [Field L] [NumberField L] [Algebra K L]

/-- For a morphism `φ` of schemes over `𝓞_L` with `φ ξ = ξ'`, the stalk map at `ξ` commutes
with the structure stalk maps. -/
theorem stalkMapAt_hom_comp (𝒢 : GroupModel A L) (ℋ : GroupModel B L) (φ : 𝒢.G ⟶ ℋ.G)
    (h : φ.left 𝒢.genericUnit = ℋ.genericUnit) {y : Spec (CommRingCat.of (𝓞 L))}
    (hy : ℋ.G.hom ℋ.genericUnit = y) (hy' : 𝒢.G.hom 𝒢.genericUnit = y)
    (t : (Spec (CommRingCat.of (𝓞 L))).presheaf.stalk y) :
    (φ.left.stalkMapAt h).hom ((ℋ.G.hom.stalkMapAt hy).hom t) = (𝒢.G.hom.stalkMapAt hy').hom t := by
  have hw : φ.left ≫ ℋ.G.hom = 𝒢.G.hom := Over.w φ
  have hpt : (φ.left ≫ ℋ.G.hom) 𝒢.genericUnit = y := by rw [hw]; exact hy'
  have := Scheme.Hom.stalkMapAt_comp φ.left ℋ.G.hom h hy hpt
  rw [Scheme.Hom.stalkMapAt_congr hw hpt hy'] at this
  rw [this]
  rfl

theorem stalkMapAt_structMap (𝒢 : GroupModel A L) (ℋ : GroupModel B L) (φ : 𝒢.G ⟶ ℋ.G)
    (h : φ.left 𝒢.genericUnit = ℋ.genericUnit) (a : 𝓞 L) :
    (φ.left.stalkMapAt h).hom (ℋ.structMap a) = 𝒢.structMap a := by
  rw [structMap_eq_stalkMap, structMap_eq_stalkMap,
    ← stalkMapAt_germ' ℋ.G.hom (hom_genericUnit ℋ) ⊤ trivial trivial,
    ← stalkMapAt_germ' 𝒢.G.hom (hom_genericUnit 𝒢) ⊤ trivial trivial]
  exact stalkMapAt_hom_comp 𝒢 ℋ φ h _ _ _

theorem stalkMapAt_φL (𝒢 : GroupModel A L) (ℋ : GroupModel B L) (φ : 𝒢.G ⟶ ℋ.G)
    (h : φ.left 𝒢.genericUnit = ℋ.genericUnit) (c : L) :
    (φ.left.stalkMapAt h).hom (φL ℋ c) = φL 𝒢 c := by
  unfold φL
  simp only [RingHom.comp_apply]
  exact stalkMapAt_hom_comp 𝒢 ℋ φ h _ _ _

/-- The cotangent map of a morphism of group models (at the generic units). -/
noncomputable abbrev cotG {𝒢 : GroupModel A L} {ℋ : GroupModel B L} (φ : 𝒢.G ⟶ ℋ.G)
    (h : φ.left 𝒢.genericUnit = ℋ.genericUnit) : ℋ.cotangent →ₗ[ℤ] 𝒢.cotangent :=
  cotMapAt φ.left h

theorem cotG_smul_ring {𝒢 : GroupModel A L} {ℋ : GroupModel B L} (φ : 𝒢.G ⟶ ℋ.G)
    (h : φ.left 𝒢.genericUnit = ℋ.genericUnit) (a : 𝓞 L) (v : ℋ.cotangent) :
    cotG φ h (a • v) = a • cotG φ h v := by
  have := cotMapAt_smul φ.left h (ℋ.structMap a) v
  rw [stalkMapAt_structMap] at this
  exact this

theorem cotG_smulL {𝒢 : GroupModel A L} {ℋ : GroupModel B L} (φ : 𝒢.G ⟶ ℋ.G)
    (h : φ.left 𝒢.genericUnit = ℋ.genericUnit) (c : L) (v : ℋ.cotangent) :
    cotG φ h (letI := cotL ℋ; c • v) = (letI := cotL 𝒢; c • cotG φ h v) := by
  rw [cotL_smul, cotL_smul]
  have := cotMapAt_smul φ.left h (φL ℋ c) v
  rw [stalkMapAt_φL] at this
  exact this

/-- The cotangent map as an `L`-linear map. -/
noncomputable def cotGL {𝒢 : GroupModel A L} {ℋ : GroupModel B L} (φ : 𝒢.G ⟶ ℋ.G)
    (h : φ.left 𝒢.genericUnit = ℋ.genericUnit) :
    letI := cotL 𝒢; letI := cotL ℋ; ℋ.cotangent →ₗ[L] 𝒢.cotangent :=
  letI := cotL 𝒢; letI := cotL ℋ
  { toFun := cotG φ h
    map_add' := map_add _
    map_smul' := fun c v => cotG_smulL φ h c v }

theorem cotGL_apply {𝒢 : GroupModel A L} {ℋ : GroupModel B L} (φ : 𝒢.G ⟶ ℋ.G)
    (h : φ.left 𝒢.genericUnit = ℋ.genericUnit) (v : ℋ.cotangent) :
    (letI := cotL 𝒢; letI := cotL ℋ; cotGL φ h v) = cotG φ h v := rfl

end GroupModelMaps

end ZInQ.InfraHodge


/-! # infra-hodge, part 2: the cotangent space and `ω` of a product of group models

For `e : 𝒢P ≅ 𝒢₁ ⊗ 𝒢₂` with homomorphic projections `pᵢ`, let `i₁ = (id, 1) ≫ e⁻¹`,
`i₂ = (1, id) ≫ e⁻¹` (`incl1`, `incl2`). Then on cotangent spaces at the generic units
* `i₁^* p₁^* = id`, `i₂^* p₂^* = id`, `i₁^* p₂^* = 0`, `i₂^* p₁^* = 0` (`cot_i1_p1`, ...);
* `v = p₁^*(i₁^* v) + p₂^*(i₂^* v)` (`cot_split`, from infra-stalks' `sub_mem_sq_pairPt`);
* a morphism preserving the unit section maps `ω` into `ω` (`cotG_omega`), so
  `v ∈ ω_P ↔ i₁^* v ∈ ω₁ ∧ i₂^* v ∈ ω₂`. -/

namespace ZInQ.InfraHodge

open CategoryTheory AlgebraicGeometry Limits MonoidalCategory CartesianMonoidalCategory MonObj
open NumberField ZInQ.DefFaltings
open PkgI3 (AbVar)
open scoped TensorProduct

section Omega

variable {K : Type} [Field K] {A B : AbVar K} {L : Type} [Field L] [NumberField L] [Algebra K L]

theorem left_genericUnit_of {𝒢 : GroupModel A L} {ℋ : GroupModel B L} (φ : 𝒢.G ⟶ ℋ.G)
    (hη : η[𝒢.G] ≫ φ = η[ℋ.G]) : φ.left 𝒢.genericUnit = ℋ.genericUnit := by
  have h2 : (η[𝒢.G]).left ≫ φ.left = (η[ℋ.G]).left := by rw [← Over.comp_left, hη]
  show φ.left ((η[𝒢.G]).left (genericPt L)) = (η[ℋ.G]).left (genericPt L)
  rw [← h2]
  rfl

theorem unitSection_comp_left {𝒢 : GroupModel A L} {ℋ : GroupModel B L} (φ : 𝒢.G ⟶ ℋ.G)
    (hη : η[𝒢.G] ≫ φ = η[ℋ.G]) : 𝒢.unitSection ≫ φ.left = ℋ.unitSection := by
  unfold GroupModel.unitSection
  rw [← Over.comp_left, hη]

/-- Naturality of specialization maps for stalk maps between named points. -/
theorem stalkSpec_stalkMapAt {X Y : Scheme.{0}} (f : X ⟶ Y) {x x' : X} (h : x ⤳ x') {y y' : Y}
    (hy : f x = y) (hy' : f x' = y') (hyy : y ⤳ y') (t : Y.presheaf.stalk y') :
    (X.presheaf.stalkSpecializes h).hom ((f.stalkMapAt hy').hom t) =
      (f.stalkMapAt hy).hom ((Y.presheaf.stalkSpecializes hyy).hom t) := by
  subst hy hy'
  rw [Scheme.Hom.stalkMapAt_rfl, Scheme.Hom.stalkMapAt_rfl]
  exact (Scheme.Hom.stalkSpecializes_stalkMap_apply f x x' h t).symm

/-- `𝒢.unitSection.stalkMap s ∘ φ^♯ = ℋ.unitSection.stalkMap s`. -/
theorem unitSection_stalkMap_stalkMapAt {𝒢 : GroupModel A L} {ℋ : GroupModel B L}
    (φ : 𝒢.G ⟶ ℋ.G) (hη : η[𝒢.G] ≫ φ = η[ℋ.G]) (s : Spec (CommRingCat.of (𝓞 L)))
    (hs : φ.left (𝒢.unitSection s) = ℋ.unitSection s)
    (t : ℋ.G.left.presheaf.stalk (ℋ.unitSection s)) :
    (𝒢.unitSection.stalkMap s).hom ((φ.left.stalkMapAt hs).hom t) =
      (ℋ.unitSection.stalkMap s).hom t := by
  have hc := unitSection_comp_left φ hη
  have hpt : (𝒢.unitSection ≫ φ.left) s = ℋ.unitSection s := by rw [hc]
  have h1 := Scheme.Hom.stalkMapAt_comp 𝒢.unitSection φ.left (rfl : 𝒢.unitSection s = _) hs hpt
  rw [Scheme.Hom.stalkMapAt_congr hc hpt rfl, Scheme.Hom.stalkMapAt_rfl,
    Scheme.Hom.stalkMapAt_rfl] at h1
  rw [h1]
  rfl

/-- **A morphism of group models preserving the unit section maps `ω_s` into `ω_s`.** -/
theorem cotG_omegaAt {𝒢 : GroupModel A L} {ℋ : GroupModel B L} (φ : 𝒢.G ⟶ ℋ.G)
    (hη : η[𝒢.G] ≫ φ = η[ℋ.G]) (h : φ.left 𝒢.genericUnit = ℋ.genericUnit)
    (s : Spec (CommRingCat.of (𝓞 L))) {v : ℋ.cotangent} (hv : v ∈ ℋ.omegaAt s) :
    cotG φ h v ∈ 𝒢.omegaAt s := by
  let F : ℋ.cotangent →ₗ[𝓞 L] 𝒢.cotangent :=
    { toFun := cotG φ h, map_add' := map_add _, map_smul' := fun a v => cotG_smul_ring φ h a v }
  suffices H : ℋ.omegaAt s ≤ (𝒢.omegaAt s).comap F from H hv
  unfold GroupModel.omegaAt
  rw [Submodule.span_le]
  rintro m ⟨t, ht, hmem, rfl⟩
  have hs : φ.left (𝒢.unitSection s) = ℋ.unitSection s := by
    rw [← Scheme.Hom.comp_apply, unitSection_comp_left φ hη]
  set T := (φ.left.stalkMapAt hs).hom t with hT
  have hTker : T ∈ RingHom.ker (𝒢.unitSection.stalkMap s).hom := by
    rw [RingHom.mem_ker, hT, unitSection_stalkMap_stalkMapAt φ hη s hs]
    exact ht
  have hnat : (𝒢.G.left.presheaf.stalkSpecializes (𝒢.specializes_genericUnit s)).hom T =
      (φ.left.stalkMapAt h).hom
        ((ℋ.G.left.presheaf.stalkSpecializes (ℋ.specializes_genericUnit s)).hom t) :=
    stalkSpec_stalkMapAt φ.left _ h hs _ t
  have hmem' : (𝒢.G.left.presheaf.stalkSpecializes (𝒢.specializes_genericUnit s)).hom T ∈
      IsLocalRing.maximalIdeal 𝒢.genStalk := by
    rw [hnat]; exact map_nonunit _ _ hmem
  apply Submodule.subset_span
  refine ⟨T, hTker, hmem', ?_⟩
  show cotMapAt φ.left h ((IsLocalRing.maximalIdeal _).toCotangent ⟨_, hmem⟩) = _
  rw [cotMapAt_toCotangent]
  unfold GroupModel.dCls
  congr 1
  exact Subtype.ext hnat.symm

theorem cotG_omega {𝒢 : GroupModel A L} {ℋ : GroupModel B L} (φ : 𝒢.G ⟶ ℋ.G)
    (hη : η[𝒢.G] ≫ φ = η[ℋ.G]) (h : φ.left 𝒢.genericUnit = ℋ.genericUnit)
    {v : ℋ.cotangent} (hv : v ∈ ℋ.omega) : cotG φ h v ∈ 𝒢.omega := by
  unfold GroupModel.omega at hv ⊢
  rw [Submodule.mem_iInf] at hv ⊢
  exact fun s => cotG_omegaAt φ hη h s (hv s)

end Omega

section Product

variable {K : Type} [Field K] {A B C : AbVar K} {L : Type} [Field L] [NumberField L] [Algebra K L]
variable {𝒢P : GroupModel C L} {𝒢₁ : GroupModel A L} {𝒢₂ : GroupModel B L}

theorem one_comp_e (e : 𝒢P.G ≅ 𝒢₁.G ⊗ 𝒢₂.G) [IsMonHom (e.hom ≫ fst _ _)]
    [IsMonHom (e.hom ≫ snd _ _)] : η[𝒢P.G] ≫ e.hom = lift η[𝒢₁.G] η[𝒢₂.G] := by
  apply CartesianMonoidalCategory.hom_ext
  · rw [lift_fst, Category.assoc, IsMonHom.one_hom]
  · rw [lift_snd, Category.assoc, IsMonHom.one_hom]

/-- `i₁ = (id, 1) ≫ e⁻¹ : 𝒢₁ → 𝒢P`. -/
noncomputable def incl1 (e : 𝒢P.G ≅ 𝒢₁.G ⊗ 𝒢₂.G) : 𝒢₁.G ⟶ 𝒢P.G :=
  lift (𝟙 _) (toUnit _ ≫ η[𝒢₂.G]) ≫ e.inv

/-- `i₂ = (1, id) ≫ e⁻¹ : 𝒢₂ → 𝒢P`. -/
noncomputable def incl2 (e : 𝒢P.G ≅ 𝒢₁.G ⊗ 𝒢₂.G) : 𝒢₂.G ⟶ 𝒢P.G :=
  lift (toUnit _ ≫ η[𝒢₁.G]) (𝟙 _) ≫ e.inv

theorem one_comp_incl1 (e : 𝒢P.G ≅ 𝒢₁.G ⊗ 𝒢₂.G) [IsMonHom (e.hom ≫ fst _ _)]
    [IsMonHom (e.hom ≫ snd _ _)] : η[𝒢₁.G] ≫ incl1 e = η[𝒢P.G] := by
  rw [incl1, ← Category.assoc, Iso.comp_inv_eq, one_comp_e]
  apply CartesianMonoidalCategory.hom_ext <;> simp

theorem one_comp_incl2 (e : 𝒢P.G ≅ 𝒢₁.G ⊗ 𝒢₂.G) [IsMonHom (e.hom ≫ fst _ _)]
    [IsMonHom (e.hom ≫ snd _ _)] : η[𝒢₂.G] ≫ incl2 e = η[𝒢P.G] := by
  rw [incl2, ← Category.assoc, Iso.comp_inv_eq, one_comp_e]
  apply CartesianMonoidalCategory.hom_ext <;> simp

theorem incl1_fst (e : 𝒢P.G ≅ 𝒢₁.G ⊗ 𝒢₂.G) : incl1 e ≫ e.hom ≫ fst _ _ = 𝟙 _ := by
  simp [incl1]

theorem incl1_snd (e : 𝒢P.G ≅ 𝒢₁.G ⊗ 𝒢₂.G) :
    (incl1 e ≫ e.hom ≫ snd _ _).left = 𝒢₁.G.hom ≫ 𝒢₂.unitSection := by
  have : incl1 e ≫ e.hom ≫ snd _ _ = toUnit _ ≫ η[𝒢₂.G] := by simp [incl1]
  rw [this, Over.comp_left]
  rfl

theorem incl2_snd (e : 𝒢P.G ≅ 𝒢₁.G ⊗ 𝒢₂.G) : incl2 e ≫ e.hom ≫ snd _ _ = 𝟙 _ := by
  simp [incl2]

theorem incl2_fst (e : 𝒢P.G ≅ 𝒢₁.G ⊗ 𝒢₂.G) :
    (incl2 e ≫ e.hom ≫ fst _ _).left = 𝒢₂.G.hom ≫ 𝒢₁.unitSection := by
  have : incl2 e ≫ e.hom ≫ fst _ _ = toUnit _ ≫ η[𝒢₁.G] := by simp [incl2]
  rw [this, Over.comp_left]
  rfl

variable (e : 𝒢P.G ≅ 𝒢₁.G ⊗ 𝒢₂.G) [IsMonHom (e.hom ≫ fst _ _)] [IsMonHom (e.hom ≫ snd _ _)]

theorem hp1 : (e.hom ≫ fst _ _).left 𝒢P.genericUnit = 𝒢₁.genericUnit :=
  left_genericUnit_of _ (IsMonHom.one_hom _)
theorem hp2 : (e.hom ≫ snd _ _).left 𝒢P.genericUnit = 𝒢₂.genericUnit :=
  left_genericUnit_of _ (IsMonHom.one_hom _)
theorem hi1 : (incl1 e).left 𝒢₁.genericUnit = 𝒢P.genericUnit :=
  left_genericUnit_of _ (one_comp_incl1 e)
theorem hi2 : (incl2 e).left 𝒢₂.genericUnit = 𝒢P.genericUnit :=
  left_genericUnit_of _ (one_comp_incl2 e)

theorem cot_i1_p1 (v : 𝒢₁.cotangent) :
    cotG (incl1 e) (hi1 e) (cotG (e.hom ≫ fst _ _) (hp1 e) v) = v := by
  have hc : (incl1 e).left ≫ (e.hom ≫ fst _ _).left = 𝟙 _ := by
    rw [← Over.comp_left, incl1_fst]; rfl
  have hpt : ((incl1 e).left ≫ (e.hom ≫ fst _ _).left) 𝒢₁.genericUnit = 𝒢₁.genericUnit := by
    rw [hc]; rfl
  exact (cotMapAt_comp _ _ (hi1 e) (hp1 e) hpt v).symm.trans
    ((cotMapAt_congr hc hpt rfl v).trans (cotMapAt_id _ rfl v))

theorem cot_i2_p2 (v : 𝒢₂.cotangent) :
    cotG (incl2 e) (hi2 e) (cotG (e.hom ≫ snd _ _) (hp2 e) v) = v := by
  have hc : (incl2 e).left ≫ (e.hom ≫ snd _ _).left = 𝟙 _ := by
    rw [← Over.comp_left, incl2_snd]; rfl
  have hpt : ((incl2 e).left ≫ (e.hom ≫ snd _ _).left) 𝒢₂.genericUnit = 𝒢₂.genericUnit := by
    rw [hc]; rfl
  exact (cotMapAt_comp _ _ (hi2 e) (hp2 e) hpt v).symm.trans
    ((cotMapAt_congr hc hpt rfl v).trans (cotMapAt_id _ rfl v))

theorem cot_i1_p2 (v : 𝒢₂.cotangent) :
    cotG (incl1 e) (hi1 e) (cotG (e.hom ≫ snd _ _) (hp2 e) v) = 0 := by
  have hc : (incl1 e).left ≫ (e.hom ≫ snd _ _).left = 𝒢₁.G.hom ≫ 𝒢₂.unitSection := by
    rw [← Over.comp_left, incl1_snd]
  have hpt' : (𝒢₁.G.hom ≫ 𝒢₂.unitSection) 𝒢₁.genericUnit = 𝒢₂.genericUnit := by
    rw [Scheme.Hom.comp_apply, hom_genericUnit]; rfl
  have hpt : ((incl1 e).left ≫ (e.hom ≫ snd _ _).left) 𝒢₁.genericUnit = 𝒢₂.genericUnit := by
    rw [hc]; exact hpt'
  exact (cotMapAt_comp _ _ (hi1 e) (hp2 e) hpt v).symm.trans
    ((cotMapAt_congr hc hpt hpt' v).trans (cotMapAt_comp_eq_zero 𝒢₁.G.hom 𝒢₂.unitSection
      (hom_genericUnit 𝒢₁) rfl hpt' (maximalIdeal_stalk_genericPt L _ rfl) v))

theorem cot_i2_p1 (v : 𝒢₁.cotangent) :
    cotG (incl2 e) (hi2 e) (cotG (e.hom ≫ fst _ _) (hp1 e) v) = 0 := by
  have hc : (incl2 e).left ≫ (e.hom ≫ fst _ _).left = 𝒢₂.G.hom ≫ 𝒢₁.unitSection := by
    rw [← Over.comp_left, incl2_fst]
  have hpt' : (𝒢₂.G.hom ≫ 𝒢₁.unitSection) 𝒢₂.genericUnit = 𝒢₁.genericUnit := by
    rw [Scheme.Hom.comp_apply, hom_genericUnit]; rfl
  have hpt : ((incl2 e).left ≫ (e.hom ≫ fst _ _).left) 𝒢₂.genericUnit = 𝒢₁.genericUnit := by
    rw [hc]; exact hpt'
  exact (cotMapAt_comp _ _ (hi2 e) (hp1 e) hpt v).symm.trans
    ((cotMapAt_congr hc hpt hpt' v).trans (cotMapAt_comp_eq_zero 𝒢₂.G.hom 𝒢₁.unitSection
      (hom_genericUnit 𝒢₂) rfl hpt' (maximalIdeal_stalk_genericPt L _ rfl) v))

/-- `𝒢P.unitSection ≫ e.hom.left = (e₁, e₂)`. -/
theorem unitSection_e (e : 𝒢P.G ≅ 𝒢₁.G ⊗ 𝒢₂.G) [IsMonHom (e.hom ≫ fst _ _)]
    [IsMonHom (e.hom ≫ snd _ _)] :
    𝒢P.unitSection ≫ e.hom.left = pullback.lift 𝒢₁.unitSection 𝒢₂.unitSection
      (by rw [unitSection_comp_hom, unitSection_comp_hom]) := by
  show (η[𝒢P.G] ≫ e.hom).left = _
  rw [one_comp_e]
  rfl

/-- **The cotangent space of a product splits:** `v = p₁^*(i₁^* v) + p₂^*(i₂^* v)`. -/
theorem cot_split (v : 𝒢P.cotangent) :
    v = cotG (e.hom ≫ fst _ _) (hp1 e) (cotG (incl1 e) (hi1 e) v) +
      cotG (e.hom ≫ snd _ _) (hp2 e) (cotG (incl2 e) (hi2 e) v) := by
  obtain ⟨v, rfl⟩ : ∃ v' : IsLocalRing.CotangentSpace (𝒢P.G.left.presheaf.stalk 𝒢P.genericUnit),
      v' = v := ⟨v, rfl⟩
  set f := 𝒢₁.G.hom
  set g := 𝒢₂.G.hom
  have hX := unitSection_comp_hom 𝒢₁
  have hY := unitSection_comp_hom 𝒢₂
  set z := pairPt f g 𝒢₁.unitSection 𝒢₂.unitSection hX hY (genericPt L) with hz
  set E : 𝒢P.G.left ⟶ pullback f g := e.hom.left
  set E' : pullback f g ⟶ 𝒢P.G.left := e.inv.left
  have hEE' : E ≫ E' = 𝟙 _ := by
    show (e.hom ≫ e.inv).left = _
    rw [e.hom_inv_id]; rfl
  have hEξ : E 𝒢P.genericUnit = z := by
    show E (𝒢P.unitSection (genericPt L)) = _
    rw [← Scheme.Hom.comp_apply, unitSection_e e]
    rfl
  have hE'z : E' z = 𝒢P.genericUnit := by
    rw [← hEξ, ← Scheme.Hom.comp_apply, hEE']; rfl
  have hid : (E' ≫ E) z = z := by rw [Scheme.Hom.comp_apply, hE'z, hEξ]
  have hpt1 : (E ≫ pullback.fst f g) 𝒢P.genericUnit = 𝒢₁.genericUnit := hp1 e
  have hpt2 : (E ≫ pullback.snd f g) 𝒢P.genericUnit = 𝒢₂.genericUnit := hp2 e
  have hq1 : (incl₁ f g 𝒢₂.unitSection hY ≫ E') 𝒢₁.genericUnit = 𝒢P.genericUnit := hi1 e
  have hq2 : (incl₂ f g 𝒢₁.unitSection hX ≫ E') 𝒢₂.genericUnit = 𝒢P.genericUnit := hi2 e
  -- the identity on `T*_z`
  have key : ∀ w : IsLocalRing.CotangentSpace ((pullback f g).presheaf.stalk z),
      w = cotMapAt (pullback.fst f g) (fst_pairPt f g _ _ hX hY _)
          (cotMapAt (incl₁ f g 𝒢₂.unitSection hY) (incl₁_apply f g _ _ hX hY _) w) +
        cotMapAt (pullback.snd f g) (snd_pairPt f g _ _ hX hY _)
          (cotMapAt (incl₂ f g 𝒢₁.unitSection hX) (incl₂_apply f g _ _ hX hY _) w) := by
    intro w
    obtain ⟨c, rfl⟩ := (IsLocalRing.maximalIdeal _).toCotangent_surjective w
    rw [cotMapAt_toCotangent, cotMapAt_toCotangent, cotMapAt_toCotangent, cotMapAt_toCotangent,
      ← map_add, Ideal.toCotangent_eq]
    have := sub_mem_sq_pairPt f g 𝒢₁.unitSection 𝒢₂.unitSection hX hY (genericPt L)
      (maximalIdeal_stalk_genericPt L _ rfl) c c.2
    rw [sub_sub] at this
    exact this
  have h1 : cotMapAt E hEξ (cotMapAt E' hE'z v) = v := by
    have hpt : (E ≫ E') 𝒢P.genericUnit = 𝒢P.genericUnit := by rw [hEE']; rfl
    exact (cotMapAt_comp E E' hEξ hE'z hpt v).symm.trans
      ((cotMapAt_congr hEE' hpt rfl v).trans (cotMapAt_id _ rfl v))
  have k := congrArg (cotMapAt E hEξ) (key (cotMapAt E' hE'z v))
  rw [h1, map_add] at k
  refine k.trans ?_
  congr 1
  · exact (cotMapAt_comp E _ hEξ _ hpt1 _).symm.trans
      (congrArg _ (cotMapAt_comp _ E' (incl₁_apply f g _ _ hX hY _) hE'z hq1 v).symm)
  · exact (cotMapAt_comp E _ hEξ _ hpt2 _).symm.trans
      (congrArg _ (cotMapAt_comp _ E' (incl₂_apply f g _ _ hX hY _) hE'z hq2 v).symm)

end Product

end ZInQ.InfraHodge


/-! # infra-hodge, part 3: determinant ideals and indices (pure algebra)

* `detIdeal b W = span_R {b.det v | v ∈ W^ι} ⊆ L`;
  `detIdeal (u.prod w) (W₁ × W₂) = detIdeal u W₁ * detIdeal w W₂` (`detIdeal_prod`: expand
  `det(a + b)` multilinearly; a term is `0` unless exactly `g₁` columns come from `W₁`, and then
  it is `± det_u · det_w` after sorting the columns).
* `idx I = [I : 𝓞_L·1]` is multiplicative on `𝓞_L`-submodules of `L` containing `1`
  (`idx_mul`: via integral ideals `J` with `𝓞_L J = n I` and `Ideal.absNorm`).
* `delta b : L ⊗_{𝓞_L} ⋀^n_{𝓞_L} V → L`, `1 ⊗ ιMulti v ↦ b.det v`, is injective
  (`delta_injective`, via hodge-bc2's `extFracEquiv`), so indices of lattices in the Hodge line
  are indices of determinant ideals (`relIndex_detLat`). -/

namespace ZInQ.InfraHodge

open scoped TensorProduct
open Module NumberField

section DetIdeal

variable {R L : Type*} [CommRing R] [Field L] [Algebra R L]

/-- The `R`-submodule of `L` spanned by the determinants `b.det v` of families in `W`. -/
noncomputable def detIdeal {V : Type*} [AddCommGroup V] [Module L V] [Module R V]
    {ι : Type*} [Fintype ι] [DecidableEq ι] (b : Basis ι L V) (W : Submodule R V) :
    Submodule R L :=
  Submodule.span R (Set.range fun v : ι → W => b.det (fun i => (v i : V)))

variable {V₁ V₂ : Type*} [AddCommGroup V₁] [Module L V₁] [AddCommGroup V₂] [Module L V₂]

theorem det_prod_block {ι₁ ι₂ : Type*} [Fintype ι₁] [DecidableEq ι₁] [Fintype ι₂]
    [DecidableEq ι₂] (u : Basis ι₁ L V₁) (w : Basis ι₂ L V₂) (x : ι₁ → V₁) (y : ι₂ → V₂) :
    (u.prod w).det (Sum.elim (fun i => (x i, (0 : V₂))) (fun j => ((0 : V₁), y j))) =
      u.det x * w.det y := by
  rw [Basis.det_apply, Basis.det_apply, Basis.det_apply]
  have : (u.prod w).toMatrix (Sum.elim (fun i => (x i, (0 : V₂))) (fun j => ((0 : V₁), y j))) =
      Matrix.fromBlocks (u.toMatrix x) 0 0 (w.toMatrix y) := by
    ext (a | a) (b | b) <;>
      simp [Basis.toMatrix_apply, Basis.prod_repr_inl, Basis.prod_repr_inr]
  rw [this, Matrix.det_fromBlocks_zero₂₁]

variable [Module R V₁] [IsScalarTower R L V₁] [Module R V₂] [IsScalarTower R L V₂]

theorem detIdeal_prod {g₁ g₂ : ℕ} (u : Basis (Fin g₁) L V₁) (w : Basis (Fin g₂) L V₂)
    (W₁ : Submodule R V₁) (W₂ : Submodule R V₂) :
    detIdeal (u.prod w) (W₁.prod W₂) = detIdeal u W₁ * detIdeal w W₂ := by
  classical
  haveI := Module.Finite.of_basis u
  haveI := Module.Finite.of_basis w
  apply le_antisymm
  · rw [detIdeal, Submodule.span_le]
    rintro _ ⟨v, rfl⟩
    have hv1 : ∀ k, (v k : V₁ × V₂).1 ∈ W₁ := fun k => ((Submodule.mem_prod).mp (v k).2).1
    have hv2 : ∀ k, (v k : V₁ × V₂).2 ∈ W₂ := fun k => ((Submodule.mem_prod).mp (v k).2).2
    set a : (Fin g₁ ⊕ Fin g₂) → V₁ × V₂ := fun k => ((v k : V₁ × V₂).1, 0) with ha
    set b : (Fin g₁ ⊕ Fin g₂) → V₁ × V₂ := fun k => (0, (v k : V₁ × V₂).2) with hb
    have hvab : (fun k => (v k : V₁ × V₂)) = a + b := by
      funext k; ext <;> simp [a, b]
    show (u.prod w).det (fun k => (v k : V₁ × V₂)) ∈ _
    rw [hvab, show (u.prod w).det (a + b) = (u.prod w).det.toMultilinearMap (a + b) from rfl,
      MultilinearMap.map_add_univ]
    refine Submodule.sum_mem _ fun S _ => ?_
    by_cases h0 : (u.prod w).det.toMultilinearMap (S.piecewise a b) = 0
    · rw [h0]; exact zero_mem _
    have hli : LinearIndependent L (S.piecewise a b) :=
      ((u.prod w).is_basis_iff_det.mpr (isUnit_iff_ne_zero.mpr h0)).1
    have hS1 : S.card ≤ g₁ := by
      have h1 : LinearIndependent L (fun k : S => (v k : V₁ × V₂).1) := by
        refine LinearIndependent.of_comp (LinearMap.inl L V₁ V₂) ?_
        have h2 := hli.comp (fun k : S => (k : Fin g₁ ⊕ Fin g₂)) Subtype.val_injective
        convert h2 using 1
        funext k
        simp [Finset.piecewise_eq_of_mem _ _ _ k.2, a]
      have := h1.fintype_card_le_finrank
      rwa [Module.finrank_eq_card_basis u, Fintype.card_coe, Fintype.card_fin] at this
    have hS2 : Sᶜ.card ≤ g₂ := by
      have h1 : LinearIndependent L (fun k : (Sᶜ : Finset _) => (v k : V₁ × V₂).2) := by
        refine LinearIndependent.of_comp (LinearMap.inr L V₁ V₂) ?_
        have h2 := hli.comp (fun k : (Sᶜ : Finset _) => (k : Fin g₁ ⊕ Fin g₂))
          Subtype.val_injective
        convert h2 using 1
        funext k
        have hk : (k : Fin g₁ ⊕ Fin g₂) ∉ S := Finset.mem_compl.mp k.2
        simp [Finset.piecewise_eq_of_notMem _ _ _ hk, b]
      have := h1.fintype_card_le_finrank
      rwa [Module.finrank_eq_card_basis w, Fintype.card_coe, Fintype.card_fin] at this
    have hcard : S.card + Sᶜ.card = g₁ + g₂ := by
      rw [Finset.card_add_card_compl, Fintype.card_sum, Fintype.card_fin, Fintype.card_fin]
    have hS : S.card = g₁ := by omega
    have e₁ : {k // k ∈ S} ≃ Fin g₁ := Fintype.equivFinOfCardEq (by rw [Fintype.card_coe, hS])
    have e₂ : {k // k ∉ S} ≃ Fin g₂ := Fintype.equivFinOfCardEq (by
      rw [Fintype.card_subtype_compl, Fintype.card_coe, Fintype.card_sum, Fintype.card_fin,
        Fintype.card_fin]
      omega)
    let σ : Equiv.Perm (Fin g₁ ⊕ Fin g₂) :=
      (Equiv.sumCongr e₁.symm e₂.symm).trans (Equiv.sumCompl (fun k => k ∈ S))
    set x' : Fin g₁ → V₁ := fun i => (v (e₁.symm i) : V₁ × V₂).1
    set y' : Fin g₂ → V₂ := fun j => (v (e₂.symm j) : V₁ × V₂).2
    have hcomp : S.piecewise a b ∘ σ =
        Sum.elim (fun i => (x' i, (0 : V₂))) (fun j => ((0 : V₁), y' j)) := by
      funext k
      rcases k with i | j
      · show S.piecewise a b ((e₁.symm i : {k // k ∈ S}) : Fin g₁ ⊕ Fin g₂) = (x' i, 0)
        rw [Finset.piecewise_eq_of_mem _ _ _ (e₁.symm i).2]
      · show S.piecewise a b ((e₂.symm j : {k // k ∉ S}) : Fin g₁ ⊕ Fin g₂) = (0, y' j)
        rw [Finset.piecewise_eq_of_notMem _ _ _ (e₂.symm j).2]
    have hperm := (u.prod w).det.map_perm (S.piecewise a b) σ
    rw [hcomp, det_prod_block] at hperm
    have hmem : u.det x' * w.det y' ∈ detIdeal u W₁ * detIdeal w W₂ :=
      Submodule.mul_mem_mul (Submodule.subset_span ⟨fun i => ⟨x' i, hv1 _⟩, rfl⟩)
        (Submodule.subset_span ⟨fun j => ⟨y' j, hv2 _⟩, rfl⟩)
    have : (u.prod w).det.toMultilinearMap (S.piecewise a b) =
        Equiv.Perm.sign σ • (u.det x' * w.det y') := by
      rw [hperm, smul_smul, Int.units_mul_self, one_smul]
      rfl
    rw [this, Units.smul_def]
    exact zsmul_mem hmem _
  · rw [detIdeal, detIdeal, Submodule.span_mul_span, Submodule.span_le]
    rintro _ ⟨_, ⟨x, rfl⟩, _, ⟨y, rfl⟩, rfl⟩
    refine Submodule.subset_span ⟨Sum.elim (fun i => ⟨((x i : V₁), 0),
      Submodule.mem_prod.mpr ⟨(x i).2, zero_mem _⟩⟩) (fun j => ⟨(0, (y j : V₂)),
      Submodule.mem_prod.mpr ⟨zero_mem _, (y j).2⟩⟩), ?_⟩
    show (u.prod w).det (fun k => ((Sum.elim (fun i => (⟨((x i : V₁), 0), _⟩ : W₁.prod W₂))
      (fun j => ⟨(0, (y j : V₂)), _⟩) k : W₁.prod W₂) : V₁ × V₂)) =
        u.det (fun i => (x i : V₁)) * w.det (fun j => (y j : V₂))
    rw [← det_prod_block u w (fun i => (x i : V₁)) (fun j => (y j : V₂))]
    congr 1
    funext k
    rcases k with i | j <;> rfl

end DetIdeal

section Index

variable {L : Type*} [Field L] [NumberField L]

/-- `idx I = [I : 𝓞_L · 1]` (`0` if infinite). -/
noncomputable def idx (I : Submodule (𝓞 L) L) : ℕ :=
  (Submodule.span (𝓞 L) {(1 : L)}).toAddSubgroup.relIndex I.toAddSubgroup

theorem index_toAddSubgroup_ideal (J : Ideal (𝓞 L)) : J.toAddSubgroup.index = Ideal.absNorm J := by
  rw [Ideal.absNorm_apply, Submodule.cardQuot_apply]
  rfl

theorem map_linearMap_span_singleton (n : 𝓞 L) :
    Submodule.map (Algebra.linearMap (𝓞 L) L) (Ideal.span {n}) = Submodule.span (𝓞 L) {(n : L)} := by
  rw [Ideal.span, Submodule.map_span, Set.image_singleton]
  rfl

/-- `idx I · N(J) = N(n)` when `𝓞_L J = n I` and `1 ∈ I`. -/
theorem idx_mul_absNorm (I : Submodule (𝓞 L) L) (J : Ideal (𝓞 L)) (n : 𝓞 L) (hn : n ≠ 0)
    (h1 : (1 : L) ∈ I) (hJ : Submodule.map (Algebra.linearMap (𝓞 L) L) J = Submodule.span (𝓞 L) {(n : L)} * I) :
    idx I * Ideal.absNorm J = Ideal.absNorm (Ideal.span {n}) := by
  have hnL : (n : L) ≠ 0 := by
    intro h; exact hn (RingOfIntegers.coe_eq_zero_iff.mp h)
  let μ : L →+ L := AddMonoidHom.mulLeft (n : L)
  have hμ : Function.Injective μ := fun x y h => mul_left_cancel₀ hnL h
  let μl : L →ₗ[𝓞 L] L := LinearMap.mulLeft (𝓞 L) (n : L)
  have hmap : ∀ N : Submodule (𝓞 L) L, N.toAddSubgroup.map μ = (N.map μl).toAddSubgroup := by
    intro N; rw [Submodule.map_toAddSubgroup]; rfl
  have hmulI : I.map μl = Submodule.span (𝓞 L) {(n : L)} * I := by
    rw [Submodule.span_singleton_mul]
    rfl
  have hmul1 : (Submodule.span (𝓞 L) {(1 : L)}).map μl = Submodule.span (𝓞 L) {(n : L)} := by
    rw [Submodule.map_span, Set.image_singleton]
    simp [μl]
  let alg : 𝓞 L →+ L := (algebraMap (𝓞 L) L).toAddMonoidHom
  have halg : Function.Injective alg := RingOfIntegers.coe_injective
  have hmapA : ∀ N : Ideal (𝓞 L), N.toAddSubgroup.map alg =
      (Submodule.map (Algebra.linearMap (𝓞 L) L) N).toAddSubgroup := by
    intro N; rw [Submodule.map_toAddSubgroup]; rfl
  have hnJ : Ideal.span {n} ≤ J := by
    rw [Ideal.span_le, Set.singleton_subset_iff]
    have : (n : L) ∈ Submodule.map (Algebra.linearMap (𝓞 L) L) J := by
      rw [hJ]; exact Submodule.mem_span_singleton_mul.mpr ⟨1, h1, mul_one _⟩
    obtain ⟨m, hm, hmn⟩ := Submodule.mem_map.mp this
    rwa [RingOfIntegers.coe_injective hmn] at hm
  unfold idx
  rw [← AddSubgroup.relIndex_map_map_of_injective _ _ hμ, hmap, hmap, hmulI, hmul1, ← hJ,
    ← map_linearMap_span_singleton, ← hmapA, ← hmapA,
    AddSubgroup.relIndex_map_map_of_injective _ _ halg, ← index_toAddSubgroup_ideal,
    ← index_toAddSubgroup_ideal, ← AddSubgroup.relIndex_top_right, ← AddSubgroup.relIndex_top_right,
    AddSubgroup.relIndex_mul_relIndex _ _ _ (Submodule.toAddSubgroup_mono hnJ) le_top]

theorem idx_le_mul {I₁ I₂ : Submodule (𝓞 L) L} (h1 : (1 : L) ∈ I₂) : I₁ ≤ I₁ * I₂ :=
  fun x hx => by simpa using Submodule.mul_mem_mul hx h1

theorem one_le_span {I : Submodule (𝓞 L) L} (h1 : (1 : L) ∈ I) :
    Submodule.span (𝓞 L) {(1 : L)} ≤ I := by
  rw [Submodule.span_le, Set.singleton_subset_iff]; exact h1

/-- **Indices multiply**: `[I₁I₂ : 𝓞] = [I₁ : 𝓞][I₂ : 𝓞]` for `1 ∈ I₁, I₂`. -/
theorem idx_mul {I₁ I₂ : Submodule (𝓞 L) L} (h₁ : (1 : L) ∈ I₁) (h₂ : (1 : L) ∈ I₂) :
    idx (I₁ * I₂) = idx I₁ * idx I₂ := by
  have tower : ∀ {I I' : Submodule (𝓞 L) L}, (1 : L) ∈ I → I ≤ I' →
      idx I' = idx I * I.toAddSubgroup.relIndex I'.toAddSubgroup := by
    intro I I' hI hII'
    unfold idx
    rw [AddSubgroup.relIndex_mul_relIndex _ _ _ (Submodule.toAddSubgroup_mono (one_le_span hI))
      (Submodule.toAddSubgroup_mono hII')]
  by_cases hz₁ : idx I₁ = 0
  · rw [hz₁, zero_mul, tower h₁ (idx_le_mul h₂), hz₁, zero_mul]
  by_cases hz₂ : idx I₂ = 0
  · rw [hz₂, mul_zero, mul_comm I₁, tower h₂ (idx_le_mul h₁), hz₂, zero_mul]
  -- both indices finite
  have hint : ∀ {I : Submodule (𝓞 L) L}, idx I ≠ 0 →
      Submodule.span (𝓞 L) {(((idx I).factorial : 𝓞 L) : L)} * I ≤
        Submodule.span (𝓞 L) {(1 : L)} := by
    intro I hI y hy
    obtain ⟨x, hx, rfl⟩ := Submodule.mem_span_singleton_mul.mp hy
    have := AddSubgroup.nsmul_mem_of_relIndex_ne_zero_of_dvd hI (a := x) hx
      (n := (idx I).factorial) (fun m hm hm' => Nat.dvd_factorial hm hm')
    have h' := (AddSubgroup.mem_inf.mp this).1
    rw [nsmul_eq_mul] at h'
    simpa using h'
  have hrange : Submodule.span (𝓞 L) {(1 : L)} ≤ LinearMap.range (Algebra.linearMap (𝓞 L) L) := by
    rw [Submodule.span_le, Set.singleton_subset_iff]
    exact ⟨1, by simp⟩
  have hfac : ∀ I : Submodule (𝓞 L) L, ((idx I).factorial : 𝓞 L) ≠ 0 :=
    fun I => Nat.cast_ne_zero.mpr (Nat.factorial_ne_zero _)
  set n₁ : 𝓞 L := ((idx I₁).factorial : 𝓞 L)
  set n₂ : 𝓞 L := ((idx I₂).factorial : 𝓞 L)
  set J₁ : Ideal (𝓞 L) := Submodule.comap (Algebra.linearMap (𝓞 L) L)
    (Submodule.span (𝓞 L) {(n₁ : L)} * I₁)
  set J₂ : Ideal (𝓞 L) := Submodule.comap (Algebra.linearMap (𝓞 L) L)
    (Submodule.span (𝓞 L) {(n₂ : L)} * I₂)
  have hJ₁ : Submodule.map (Algebra.linearMap (𝓞 L) L) J₁ =
      Submodule.span (𝓞 L) {(n₁ : L)} * I₁ := by
    rw [Submodule.map_comap_eq, inf_eq_right]
    exact (hint hz₁).trans hrange
  have hJ₂ : Submodule.map (Algebra.linearMap (𝓞 L) L) J₂ =
      Submodule.span (𝓞 L) {(n₂ : L)} * I₂ := by
    rw [Submodule.map_comap_eq, inf_eq_right]
    exact (hint hz₂).trans hrange
  have hJ : Submodule.map (Algebra.linearMap (𝓞 L) L) (J₁ * J₂) =
      Submodule.span (𝓞 L) {((n₁ * n₂ : 𝓞 L) : L)} * (I₁ * I₂) := by
    rw [show Submodule.map (Algebra.linearMap (𝓞 L) L) (J₁ * J₂) =
      Submodule.map (Algebra.ofId (𝓞 L) L).toLinearMap ((J₁ : Submodule (𝓞 L) (𝓞 L)) * J₂) from rfl,
      Submodule.map_mul]
    erw [hJ₁, hJ₂]
    have hc : ((n₁ * n₂ : 𝓞 L) : L) = (n₁ : L) * (n₂ : L) := by simp
    rw [hc, ← Set.singleton_mul_singleton, ← Submodule.span_mul_span]
    ring
  have e₁ := idx_mul_absNorm I₁ J₁ n₁ (hfac I₁) h₁ hJ₁
  have e₂ := idx_mul_absNorm I₂ J₂ n₂ (hfac I₂) h₂ hJ₂
  have e₁₂ := idx_mul_absNorm (I₁ * I₂) (J₁ * J₂) (n₁ * n₂) (mul_ne_zero (hfac I₁) (hfac I₂))
    (by simpa using Submodule.mul_mem_mul h₁ h₂) hJ
  rw [map_mul, ← Ideal.span_singleton_mul_span_singleton, map_mul, ← e₁, ← e₂] at e₁₂
  have hne : Ideal.absNorm J₁ * Ideal.absNorm J₂ ≠ 0 := by
    refine mul_ne_zero (fun h => ?_) (fun h => ?_)
    · rw [h, mul_zero, eq_comm, Ideal.absNorm_eq_zero_iff, Ideal.span_singleton_eq_bot] at e₁
      exact hfac I₁ e₁
    · rw [h, mul_zero, eq_comm, Ideal.absNorm_eq_zero_iff, Ideal.span_singleton_eq_bot] at e₂
      exact hfac I₂ e₂
  apply Nat.eq_of_mul_eq_mul_right (Nat.pos_of_ne_zero hne)
  rw [e₁₂]
  ring

end Index

section Delta

variable {L : Type*} [Field L] [NumberField L]
variable {V : Type*} [AddCommGroup V] [Module L V] [Module (𝓞 L) V] [IsScalarTower (𝓞 L) L V]

/-- `δ_b : L ⊗ ⋀^n V → L`, `1 ⊗ ιMulti v ↦ b.det v`. -/
noncomputable def delta {n : ℕ} (b : Basis (Fin n) L V) : L ⊗[𝓞 L] ⋀[𝓞 L]^n V →ₗ[L] L :=
  (exteriorPower.alternatingMapLinearEquiv b.det) ∘ₗ
    (ZInQ.HodgeBC2.extFracEquiv (R := 𝓞 L) (K := L) (M := V) n).symm.toLinearMap

theorem delta_tmul_one {n : ℕ} (b : Basis (Fin n) L V) (v : Fin n → V) :
    delta b ((1 : L) ⊗ₜ[𝓞 L] exteriorPower.ιMulti (𝓞 L) n v) = b.det v := by
  rw [delta, LinearMap.comp_apply, LinearEquiv.coe_coe, ← ZInQ.HodgeBC2.extFracEquiv_ιMulti,
    LinearEquiv.symm_apply_apply, exteriorPower.alternatingMapLinearEquiv_apply_ιMulti]

theorem finrank_hodge {n : ℕ} (b : Basis (Fin n) L V) :
    finrank L (L ⊗[𝓞 L] ⋀[𝓞 L]^n V) = 1 := by
  haveI := Module.Finite.of_basis b
  rw [← (ZInQ.HodgeBC2.extFracEquiv (R := 𝓞 L) (K := L) (M := V) n).finrank_eq,
    exteriorPower.finrank_eq, Module.finrank_eq_card_basis b, Fintype.card_fin, Nat.choose_self]

theorem delta_injective {n : ℕ} (b : Basis (Fin n) L V) : Function.Injective (delta b) := by
  haveI : FiniteDimensional L (L ⊗[𝓞 L] ⋀[𝓞 L]^n V) :=
    Module.finite_of_finrank_pos (by rw [finrank_hodge b]; exact one_pos)
  rw [LinearMap.injective_iff_surjective_of_finrank_eq_finrank
    (by rw [finrank_hodge b, Module.finrank_self])]
  intro c
  refine ⟨c ⊗ₜ[𝓞 L] exteriorPower.ιMulti (𝓞 L) n b, ?_⟩
  rw [show c ⊗ₜ[𝓞 L] exteriorPower.ιMulti (𝓞 L) n ⇑b =
      c • ((1 : L) ⊗ₜ[𝓞 L] exteriorPower.ιMulti (𝓞 L) n b) from by
    rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one],
    map_smul, delta_tmul_one, b.det_self, smul_eq_mul, mul_one]

/-- `⋀^n W ⊆ L ⊗ ⋀^n V`. -/
noncomputable def detLat (n : ℕ) (W : Submodule (𝓞 L) V) :
    Submodule (𝓞 L) (L ⊗[𝓞 L] ⋀[𝓞 L]^n V) :=
  Submodule.span (𝓞 L) (Set.range fun v : Fin n → W =>
    (1 : L) ⊗ₜ[𝓞 L] exteriorPower.ιMulti (𝓞 L) n (fun i => (v i : V)))

theorem map_detLat {n : ℕ} (b : Basis (Fin n) L V) (W : Submodule (𝓞 L) V) :
    (detLat n W).map ((delta b).restrictScalars (𝓞 L)) = detIdeal b W := by
  rw [detLat, Submodule.map_span, detIdeal, ← Set.range_comp]
  congr 1
  congr 1
  funext v
  exact delta_tmul_one b _

theorem relIndex_detLat {n : ℕ} (b : Basis (Fin n) L V) (W : Submodule (𝓞 L) V) :
    (Submodule.span (𝓞 L) {(1 : L) ⊗ₜ[𝓞 L] exteriorPower.ιMulti (𝓞 L) n b}).toAddSubgroup.relIndex
      (detLat n W).toAddSubgroup = idx (detIdeal b W) := by
  have hmap : ∀ N : Submodule (𝓞 L) (L ⊗[𝓞 L] ⋀[𝓞 L]^n V),
      N.toAddSubgroup.map ((delta b).restrictScalars (𝓞 L)).toAddMonoidHom =
        (N.map ((delta b).restrictScalars (𝓞 L))).toAddSubgroup := by
    intro N; rw [Submodule.map_toAddSubgroup]; rfl
  rw [← map_detLat b W, idx, ← AddSubgroup.relIndex_map_map_of_injective _ _
    (f := ((delta b).restrictScalars (𝓞 L)).toAddMonoidHom) (delta_injective b),
    hmap, hmap, Submodule.map_span, Set.image_singleton]
  have h1 : ((delta b).restrictScalars (𝓞 L)) ((1 : L) ⊗ₜ[𝓞 L] exteriorPower.ιMulti (𝓞 L) n b) = 1 := by
    show delta b _ = 1
    rw [delta_tmul_one, b.det_self]
  rw [h1]

end Delta

end ZInQ.InfraHodge


/-! # infra-hodge, part 4a: bases of `ω` inside the lattice (generic)

* `basis_of_wedge_ne_zero`: if `L ⊗ ⋀^g V` is a line (`g ≥ 1`) and `1 ⊗ ιMulti v ≠ 0`, then `v` is
  an `L`-basis of `V`.
* `exists_omega_basis`: a metrized model of dimension `g` has an `L`-basis of `ω_{A_L}` inside
  `ω_𝒢` (for `g = 0` assuming the cotangent space is `0`).
* `TrivialPointsCotangent` (new named Prop, only for the case `g = 0`): a group model with a single
  complex point has zero cotangent space. -/

namespace ZInQ.InfraHodge

open CategoryTheory AlgebraicGeometry Limits MonoidalCategory CartesianMonoidalCategory MonObj
open NumberField ZInQ.DefFaltings Module
open PkgI3 (AbVar)
open scoped TensorProduct

section Wedge

variable {L : Type*} [Field L] [NumberField L]
variable {V : Type*} [AddCommGroup V] [Module L V] [Module (𝓞 L) V] [IsScalarTower (𝓞 L) L V]

theorem basis_of_wedge_ne_zero {g : ℕ} (hg : 0 < g)
    (hfr : finrank L (L ⊗[𝓞 L] ⋀[𝓞 L]^g V) = 1) (v : Fin g → V)
    (hv : (1 : L) ⊗ₜ[𝓞 L] exteriorPower.ιMulti (𝓞 L) g v ≠ 0) :
    ∃ b : Basis (Fin g) L V, ∀ k, b k = v k := by
  have hL : exteriorPower.ιMulti L g v ≠ 0 := fun h => hv (by
    rw [← ZInQ.HodgeBC2.extFracEquiv_ιMulti (R := 𝓞 L), h, map_zero])
  have hli : LinearIndependent L v := by
    by_contra h
    exact hL ((exteriorPower.ιMulti L g).map_linearDependent v h)
  have hfr' : finrank L (⋀[L]^g V) = 1 := by
    rw [(ZInQ.HodgeBC2.extFracEquiv (R := 𝓞 L) (K := L) (M := V) g).finrank_eq]; exact hfr
  haveI : FiniteDimensional L (⋀[L]^g V) := Module.finite_of_finrank_pos (by omega)
  have hsp : ⊤ ≤ Submodule.span L (Set.range v) := by
    intro x _
    by_contra hx
    have hli' : LinearIndependent L (Fin.snoc v x : Fin (g + 1) → V) :=
      linearIndependent_fin_snoc.mpr ⟨hli, hx⟩
    have h2 := exteriorPower.ιMulti_family_linearIndependent_field (n := g) hli'
    have h3 := h2.fintype_card_le_finrank
    rw [hfr'] at h3
    have : Fintype.card (Set.powersetCard (Fin (g + 1)) g) = g + 1 := by
      rw [Fintype.card_eq_nat_card, Set.powersetCard.card, Nat.card_eq_fintype_card,
        Fintype.card_fin, Nat.choose_succ_self_right]
    omega
  exact ⟨Basis.mk hli hsp, fun k => Basis.mk_apply _ _ _⟩

end Wedge

section Factor

variable {K : Type} [Field K] {A : AbVar K} {L : Type} [Field L] [NumberField L] [Algebra K L]

theorem exists_omega_basis {g : ℕ} (M : MetrizedModel A L g)
    (h0 : g = 0 → Subsingleton M.model.cotangent) :
    letI := cotL M.model; ∃ u : Basis (Fin g) L M.model.cotangent, ∀ k, u k ∈ M.model.omega := by
  letI := cotL M.model
  haveI := cotL_isScalarTower M.model
  rcases Nat.eq_zero_or_pos g with rfl | hg
  · haveI := h0 rfl
    exact ⟨Basis.empty _, fun k => k.elim0⟩
  obtain ⟨s, hs, hs0, -⟩ := M.hodge.isLattice
  rw [M.lattice_eq] at hs
  have : ∃ v : Fin g → M.model.omega, (1 : L) ⊗ₜ[𝓞 L]
      exteriorPower.ιMulti (𝓞 L) g (fun i => (v i : M.model.cotangent)) ≠ 0 := by
    by_contra hcon
    push_neg at hcon
    apply hs0
    have hbot : M.model.detLattice g = ⊥ := by
      unfold GroupModel.detLattice
      rw [Submodule.span_eq_bot]
      rintro _ ⟨v, rfl⟩
      exact hcon v
    rw [hbot] at hs
    exact (Submodule.mem_bot _).mp hs
  obtain ⟨v, hv⟩ := this
  obtain ⟨b, hb⟩ := basis_of_wedge_ne_zero hg M.hodge.finrank_eq_one _ hv
  exact ⟨b, fun k => by rw [hb]; exact (v k).2⟩

/-- **Named Prop (used only for metrized models of dimension `0`).** A smooth group model `𝒢` of
`A_L` over `𝓞_L` whose complex points at some `τ : L → ℂ` reduce to the identity has zero cotangent
space `𝔪_ξ/𝔪_ξ² = ω_{A_L}`. Why true (STANDARD, unproved here): `𝒢(ℂ)_τ = A_τ(ℂ)`; a group scheme
of finite type over `ℂ` with one `ℂ`-point is, by the Nullstellensatz (Jacobson), topologically a
point, so `A_τ` is smooth of dimension `0`, i.e. étale over `ℂ`, and its cotangent space at the
origin, which is `ℂ ⊗_{L,τ} ω_{A_L}` (cotangent spaces commute with field extension, infra-stalks'
`cotangent_baseChange_injective`), vanishes. Glue (geometry of smooth varieties). -/
def TrivialPointsCotangent : Prop :=
  ∀ (K : Type) [Field K] (A : AbVar K) (L : Type) [Field L] [NumberField L] [Algebra K L]
    (𝒢 : GroupModel A L) (τ : L →+* ℂ), (∀ p : 𝒢.Pts τ, p = 1) → Subsingleton 𝒢.cotangent

theorem subsingleton_of_dim_zero (h0 : TrivialPointsCotangent) (M : MetrizedModel A L 0) :
    Subsingleton M.model.cotangent := by
  obtain ⟨τ⟩ := (inferInstance : Nonempty (L →+* ℂ))
  obtain ⟨Φ, hΦ, -⟩ := M.arch τ
  refine h0 K A L M.model τ fun p => ?_
  obtain ⟨z, rfl⟩ := hΦ.2.2.1 p
  have hz : z = 0 := Subsingleton.elim _ _
  subst hz
  have h := hΦ.1 0 0
  rw [add_zero] at h
  exact (_root_.mul_eq_left.mp h.symm)

omit [Algebra K L] in
theorem secIndex_eq_relIndex {V : Type*} [AddCommGroup V] [Module L V] [Module (𝓞 L) V]
    (M : Submodule (𝓞 L) V) (s : V) :
    secIndex M s = (Submodule.span (𝓞 L) {s}).toAddSubgroup.relIndex M.toAddSubgroup := rfl

end Factor

end ZInQ.InfraHodge


/-! # infra-hodge S-alg, part 1: tools

* `exists_basis_in`: a spanning family inside an `R`-submodule `W` contains an `L`-basis.
* `det_eq_zero_of_rows_supported`: if `|S| > |T|` rows of a square matrix vanish outside the
  columns `T`, the determinant is `0`.
* `coeffOf`, `mkMetrized`: a metrized model from a trivialization `δ` of the Hodge line, a
  lattice section, uniformizations, and constants `c τ` with `jacDet = τ(δ(wedge f)) · c τ`. -/

namespace ZInQ.InfraHodge

open CategoryTheory AlgebraicGeometry Limits MonoidalCategory CartesianMonoidalCategory MonObj
open NumberField ZInQ.DefFaltings Module
open PkgI3 (AbVar)
open scoped TensorProduct

theorem exists_basis_in {L V R : Type*} [Field L] [AddCommGroup V] [Module L V] [CommRing R]
    [Module R V] [FiniteDimensional L V] (W : Submodule R V) {J : Type*} [Finite J] (v : J → V)
    (hv : ∀ i, v i ∈ W) (hsp : Submodule.span L (Set.range v) = ⊤) :
    ∃ u : Basis (Fin (finrank L V)) L V, ∀ k, u k ∈ W := by
  obtain ⟨s, hs, hspan, hli⟩ := exists_linearIndependent L (Set.range v)
  have hfin : s.Finite := (Set.finite_range v).subset hs
  haveI := hfin.fintype
  let bs : Basis s L V := Basis.mk hli (by rw [Subtype.range_coe, hspan, hsp])
  let u := bs.reindex (Fintype.equivFinOfCardEq (Module.finrank_eq_card_basis bs).symm)
  refine ⟨u, fun k => ?_⟩
  simp only [u, Basis.reindex_apply, bs, Basis.mk_apply]
  obtain ⟨i, hi⟩ := hs (Subtype.mem ((Fintype.equivFinOfCardEq
    (Module.finrank_eq_card_basis bs).symm).symm k))
  rw [← hi]
  exact hv i

theorem det_eq_zero_of_rows_supported {n : ℕ} (M : Matrix (Fin n) (Fin n) ℂ)
    (S T : Finset (Fin n)) (hM : ∀ k ∈ S, ∀ j ∉ T, M k j = 0) (hST : T.card < S.card) :
    M.det = 0 := by
  by_contra h
  have hli := Matrix.linearIndependent_rows_of_det_ne_zero h
  have h2 : LinearIndependent ℂ (fun k : S => fun j : T => M k j) := by
    rw [Fintype.linearIndependent_iff]
    intro c hc
    have h3 := Fintype.linearIndependent_iff.mp
      (hli.comp (fun k : S => (k : Fin n)) Subtype.val_injective) c
    apply h3
    funext j
    by_cases hj : j ∈ T
    · have := congrFun hc ⟨j, hj⟩
      simpa using this
    · simp only [Finset.sum_apply, Pi.smul_apply, Function.comp_apply, smul_eq_mul,
        Pi.zero_apply]
      exact Finset.sum_eq_zero fun k _ => by rw [hM k k.2 j hj, mul_zero]
  have := h2.fintype_card_le_finrank
  simp only [Fintype.card_coe, Module.finrank_fintype_fun_eq_card] at this
  omega

section Mk

variable {K : Type} [Field K] {A : AbVar K} {L : Type} [Field L] [NumberField L] [Algebra K L]

/-- `x ↦ τ(δ x) · c`, a `τ`-semilinear map. -/
noncomputable def coeffOf {V : Type*} [AddCommGroup V] [Module L V] (δ : V ≃ₗ[L] L)
    (τ : L →+* ℂ) (c : ℂ) : V →ₛₗ[τ] ℂ where
  toFun x := τ (δ x) * c
  map_add' x y := by simp [add_mul]
  map_smul' a x := by simp [_root_.mul_assoc]

theorem coeffOf_apply {V : Type*} [AddCommGroup V] [Module L V] (δ : V ≃ₗ[L] L)
    (τ : L →+* ℂ) (c : ℂ) (x : V) : coeffOf δ τ c x = τ (δ x) * c := rfl

theorem coeffOf_ne_zero {V : Type*} [AddCommGroup V] [Module L V] (δ : V ≃ₗ[L] L)
    (τ : L →+* ℂ) {c : ℂ} (hc : c ≠ 0) : coeffOf δ τ c ≠ 0 := by
  intro h
  have := LinearMap.congr_fun h (δ.symm 1)
  rw [coeffOf_apply, LinearEquiv.apply_symm_apply, map_one, _root_.one_mul,
    LinearMap.zero_apply] at this
  exact hc this

/-- A metrized model from the data listed in the header. -/
noncomputable def mkMetrized (𝒢 : GroupModel A L) (d : ℕ) (δ : 𝒢.hodgeSpace d ≃ₗ[L] L)
    (s : 𝒢.hodgeSpace d) (hs : s ∈ 𝒢.detLattice d) (hs0 : s ≠ 0)
    (hsi : secIndex (𝒢.detLattice d) s ≠ 0) (Λ : (L →+* ℂ) → Submodule ℤ (Fin d → ℂ))
    (hΛd : ∀ τ, DiscreteTopology (Λ τ)) (hΛz : ∀ τ, IsZLattice ℝ (Λ τ))
    (Φ : ∀ τ : L →+* ℂ, (Fin d → ℂ) → 𝒢.Pts τ)
    (hΦ : ∀ τ, 𝒢.IsAnalyticUniformization τ (Λ τ) (Φ τ)) (c : (L →+* ℂ) → ℂ)
    (hc : ∀ τ, c τ ≠ 0) (hjac : ∀ τ f, 𝒢.jacDet (Φ τ) f = τ (δ (𝒢.wedge f)) * c τ) :
    MetrizedModel A L d where
  model := 𝒢
  hodge :=
    { lattice := 𝒢.detLattice d
      finrank_eq_one := by rw [δ.finrank_eq, Module.finrank_self]
      isLattice := ⟨s, hs, hs0, hsi⟩
      periods := Λ
      periods_discrete := hΛd
      periods_isZLattice := hΛz
      coeff := fun τ => coeffOf δ τ (c τ)
      coeff_ne_zero := fun τ => coeffOf_ne_zero δ τ (hc τ) }
  lattice_eq := rfl
  arch τ := ⟨Φ τ, hΦ τ, fun f => (hjac τ f).symm⟩

theorem mkMetrized_model (𝒢 : GroupModel A L) (d : ℕ) (δ : 𝒢.hodgeSpace d ≃ₗ[L] L) (s hs hs0 hsi Λ
    hΛd hΛz Φ hΦ c hc hjac) :
    (mkMetrized 𝒢 d δ s hs hs0 hsi Λ hΛd hΛz Φ hΦ c hc hjac).model = 𝒢 := rfl

end Mk

end ZInQ.InfraHodge


/-! # infra-hodge S-alg, part 2: the analytic input and the shape of the Jacobian

* `ProdUnifDeriv` (new named Prop, analysis): the derivative at `0` of `p₁^* t` along the product
  uniformization `prodUnif e Φ₁ Φ₂` is the derivative of `t` along `Φ₁` on the first block of
  coordinates (and the same for `p₂`).
* `jacDet_prodUnif`: the Jacobian of `(p₁^* f₁, p₂^* f₂)` along `prodUnif` is block diagonal:
  `jacDet Φ₁ f₁ · jacDet Φ₂ f₂`.
* `dims_le_of_jacDet_ne_zero`: if a family with `d₁` germs from `𝒢₁` and `d₂` from `𝒢₂` has nonzero
  Jacobian along `prodUnif` composed with `ℂ^{d₁+d₂} ≅ ℂ^{g₁+g₂}`, then `d₁ ≤ g₁` and `d₂ ≤ g₂`. -/

namespace ZInQ.InfraHodge

open CategoryTheory AlgebraicGeometry Limits MonoidalCategory CartesianMonoidalCategory MonObj
open NumberField ZInQ.DefFaltings Module ZInQ.ProductHeight
open PkgI3 (AbVar)
open scoped TensorProduct

/-- **Named Prop (analysis: derivative of a pulled-back germ along the product uniformization).**
Let `e : 𝒢P ≅ 𝒢₁ ⊗ 𝒢₂` have homomorphic projections `p₁, p₂`, and let `Φ₁`, `Φ₂` be analytic
uniformizations of `𝒢₁(ℂ)_τ`, `𝒢₂(ℂ)_τ`. For a germ `t` at the origin of `𝒢₁`, the function
`z ↦ (p₁^* t)(prodUnif e Φ₁ Φ₂ z)` (through the chosen representatives, `germAlong`) has at `0` the
derivative of `z₁ ↦ t(Φ₁ z₁)` precomposed with the projection to the first block of coordinates;
likewise for `p₂`. Why true (STANDARD): `p₁ ∘ prodUnif = Φ₁ ∘ (first block)` (definition of
`prodUnif`), and near `0` the germ `p₁^* t` is represented by `p₁^* s` for a representative `s` of
`t`, by any two representatives agreeing on an open `W ∋ ξ` whose preimage `dom (prodUnif) W` is
open (the first clause of product-height's `ProductUnifAnalytic`, cf. infra-stalks'
`productLocalStructure`); `evalAt (q ≫ p₁) U s = evalAt q (p₁⁻¹U) (p₁^* s)` (product-height's
`evalAt_comp`). Glue (elementary analysis). -/
def ProdUnifDeriv : Prop :=
  ∀ (K : Type) [Field K] (A B C : AbVar K) (L : Type) [Field L] [NumberField L] [Algebra K L]
    (𝒢P : GroupModel C L) (𝒢₁ : GroupModel A L) (𝒢₂ : GroupModel B L)
    (e : 𝒢P.G ≅ 𝒢₁.G ⊗ 𝒢₂.G) [IsMonHom (e.hom ≫ fst _ _)] [IsMonHom (e.hom ≫ snd _ _)]
    (τ : L →+* ℂ) (g₁ g₂ : ℕ) (Λ₁ : Submodule ℤ (Fin g₁ → ℂ)) (Λ₂ : Submodule ℤ (Fin g₂ → ℂ))
    (Φ₁ : (Fin g₁ → ℂ) → 𝒢₁.Pts τ) (Φ₂ : (Fin g₂ → ℂ) → 𝒢₂.Pts τ),
    𝒢₁.IsAnalyticUniformization τ Λ₁ Φ₁ → 𝒢₂.IsAnalyticUniformization τ Λ₂ Φ₂ →
    (∀ (t : 𝒢₁.genStalk) (v : Fin (g₁ + g₂) → ℂ),
      fderiv ℂ (𝒢P.germAlong (prodUnif e Φ₁ Φ₂)
          (((e.hom ≫ fst _ _).left.stalkMapAt (hp1 e)).hom t)) 0 v =
        fderiv ℂ (𝒢₁.germAlong Φ₁ t) 0 (fun i => v (Fin.castAdd g₂ i))) ∧
    (∀ (t : 𝒢₂.genStalk) (v : Fin (g₁ + g₂) → ℂ),
      fderiv ℂ (𝒢P.germAlong (prodUnif e Φ₁ Φ₂)
          (((e.hom ≫ snd _ _).left.stalkMapAt (hp2 e)).hom t)) 0 v =
        fderiv ℂ (𝒢₂.germAlong Φ₂ t) 0 (fun j => v (Fin.natAdd g₁ j)))

section Shape

variable {K : Type} [Field K] {A B C : AbVar K} {L : Type} [Field L] [NumberField L] [Algebra K L]
variable {𝒢P : GroupModel C L} {𝒢₁ : GroupModel A L} {𝒢₂ : GroupModel B L}
variable (e : 𝒢P.G ≅ 𝒢₁.G ⊗ 𝒢₂.G) [IsMonHom (e.hom ≫ fst _ _)] [IsMonHom (e.hom ≫ snd _ _)]

theorem single_castAdd_comp {g₁ g₂ : ℕ} (a : Fin g₁) :
    (fun i => (Pi.single (Fin.castAdd g₂ a) (1 : ℂ) : Fin (g₁ + g₂) → ℂ) (Fin.castAdd g₂ i)) =
      Pi.single a 1 := by
  funext i
  by_cases h : i = a
  · subst h; simp
  · rw [Pi.single_eq_of_ne (fun h' => h (Fin.castAdd_inj.mp h')), Pi.single_eq_of_ne h]

theorem single_natAdd_comp {g₁ g₂ : ℕ} (a : Fin g₂) :
    (fun j => (Pi.single (Fin.natAdd g₁ a) (1 : ℂ) : Fin (g₁ + g₂) → ℂ) (Fin.natAdd g₁ j)) =
      Pi.single a 1 := by
  funext j
  by_cases h : j = a
  · subst h; simp
  · rw [Pi.single_eq_of_ne (fun h' => h (Fin.ext (by have := congrArg Fin.val h'; simp at this; omega))),
      Pi.single_eq_of_ne h]

theorem single_natAdd_comp_castAdd {g₁ g₂ : ℕ} (a : Fin g₂) :
    (fun i => (Pi.single (Fin.natAdd g₁ a) (1 : ℂ) : Fin (g₁ + g₂) → ℂ) (Fin.castAdd g₂ i)) = 0 := by
  funext i
  refine Pi.single_eq_of_ne (fun h => ?_) _
  have := congrArg Fin.val h
  simp at this
  omega

theorem single_castAdd_comp_natAdd {g₁ g₂ : ℕ} (a : Fin g₁) :
    (fun j => (Pi.single (Fin.castAdd g₂ a) (1 : ℂ) : Fin (g₁ + g₂) → ℂ) (Fin.natAdd g₁ j)) = 0 := by
  funext j
  refine Pi.single_eq_of_ne (fun h => ?_) _
  have := congrArg Fin.val h
  simp at this
  omega

/-- **The Jacobian along a product uniformization is block diagonal** (from `ProdUnifDeriv`). -/
theorem jacDet_prodUnif (hD : ProdUnifDeriv) {τ : L →+* ℂ} {g₁ g₂ : ℕ}
    {Λ₁ : Submodule ℤ (Fin g₁ → ℂ)} {Λ₂ : Submodule ℤ (Fin g₂ → ℂ)}
    {Φ₁ : (Fin g₁ → ℂ) → 𝒢₁.Pts τ} {Φ₂ : (Fin g₂ → ℂ) → 𝒢₂.Pts τ}
    (h₁ : 𝒢₁.IsAnalyticUniformization τ Λ₁ Φ₁) (h₂ : 𝒢₂.IsAnalyticUniformization τ Λ₂ Φ₂)
    (f₁ : Fin g₁ → IsLocalRing.maximalIdeal 𝒢₁.genStalk)
    (f₂ : Fin g₂ → IsLocalRing.maximalIdeal 𝒢₂.genStalk)
    (F : Fin (g₁ + g₂) → IsLocalRing.maximalIdeal 𝒢P.genStalk)
    (hF1 : ∀ i, (F (Fin.castAdd g₂ i) : 𝒢P.genStalk) =
      ((e.hom ≫ fst _ _).left.stalkMapAt (hp1 e)).hom (f₁ i))
    (hF2 : ∀ j, (F (Fin.natAdd g₁ j) : 𝒢P.genStalk) =
      ((e.hom ≫ snd _ _).left.stalkMapAt (hp2 e)).hom (f₂ j)) :
    𝒢P.jacDet (prodUnif e Φ₁ Φ₂) F = 𝒢₁.jacDet Φ₁ f₁ * 𝒢₂.jacDet Φ₂ f₂ := by
  obtain ⟨hd1, hd2⟩ := hD K A B C L 𝒢P 𝒢₁ 𝒢₂ e τ g₁ g₂ Λ₁ Λ₂ Φ₁ Φ₂ h₁ h₂
  unfold GroupModel.jacDet
  rw [← Matrix.det_fromBlocks_zero₂₁ (B := 0), ← Matrix.det_reindex_self finSumFinEquiv]
  congr 1
  ext k j
  refine Fin.addCases (fun i => ?_) (fun i => ?_) k <;>
    refine Fin.addCases (fun a => ?_) (fun a => ?_) j <;>
    simp only [Matrix.reindex_apply, Matrix.submatrix_apply, finSumFinEquiv_symm_apply_castAdd,
      finSumFinEquiv_symm_apply_natAdd, Matrix.fromBlocks_apply₁₁, Matrix.fromBlocks_apply₁₂,
      Matrix.fromBlocks_apply₂₁, Matrix.fromBlocks_apply₂₂, Matrix.of_apply, Matrix.zero_apply]
  · rw [hF1, hd1, single_castAdd_comp]
  · rw [hF1, hd1, single_natAdd_comp_castAdd, map_zero]
  · rw [hF2, hd2, single_castAdd_comp_natAdd, map_zero]
  · rw [hF2, hd2, single_natAdd_comp]

/-- `ℂ^{d} ≅ ℂ^{g}` for `g = d`, `v ↦ v ∘ cast`. -/
noncomputable def castCLE {d g : ℕ} (hg : g = d) : (Fin d → ℂ) ≃L[ℂ] (Fin g → ℂ) :=
  (LinearEquiv.funCongrLeft ℂ ℂ (finCongr hg)).toContinuousLinearEquiv

theorem castCLE_apply {d g : ℕ} (hg : g = d) (v : Fin d → ℂ) :
    castCLE hg v = fun i => v (Fin.cast hg i) := rfl

/-- **Dimension count**: a family of `d₁` germs from `𝒢₁` and `d₂` germs from `𝒢₂` with nonzero
Jacobian along `z ↦ prodUnif e Φ₁ Φ₂ (z ∘ cast)` forces `d₁ ≤ g₁` and `d₂ ≤ g₂`. -/
theorem dims_le_of_jacDet_ne_zero (hD : ProdUnifDeriv) {τ : L →+* ℂ} {g₁ g₂ d₁ d₂ : ℕ}
    (hg : g₁ + g₂ = d₁ + d₂)
    {Λ₁ : Submodule ℤ (Fin g₁ → ℂ)} {Λ₂ : Submodule ℤ (Fin g₂ → ℂ)}
    {Φ₁ : (Fin g₁ → ℂ) → 𝒢₁.Pts τ} {Φ₂ : (Fin g₂ → ℂ) → 𝒢₂.Pts τ}
    (h₁ : 𝒢₁.IsAnalyticUniformization τ Λ₁ Φ₁) (h₂ : 𝒢₂.IsAnalyticUniformization τ Λ₂ Φ₂)
    (f₁ : Fin d₁ → IsLocalRing.maximalIdeal 𝒢₁.genStalk)
    (f₂ : Fin d₂ → IsLocalRing.maximalIdeal 𝒢₂.genStalk)
    (F : Fin (d₁ + d₂) → IsLocalRing.maximalIdeal 𝒢P.genStalk)
    (hF1 : ∀ i, (F (Fin.castAdd d₂ i) : 𝒢P.genStalk) =
      ((e.hom ≫ fst _ _).left.stalkMapAt (hp1 e)).hom (f₁ i))
    (hF2 : ∀ j, (F (Fin.natAdd d₁ j) : 𝒢P.genStalk) =
      ((e.hom ≫ snd _ _).left.stalkMapAt (hp2 e)).hom (f₂ j))
    (hne : 𝒢P.jacDet (fun z => prodUnif e Φ₁ Φ₂ (fun i => z (Fin.cast hg i))) F ≠ 0) :
    d₁ ≤ g₁ ∧ d₂ ≤ g₂ := by
  obtain ⟨hd1, hd2⟩ := hD K A B C L 𝒢P 𝒢₁ 𝒢₂ e τ g₁ g₂ Λ₁ Λ₂ Φ₁ Φ₂ h₁ h₂
  set M := Matrix.of fun k j : Fin (d₁ + d₂) =>
    fderiv ℂ (𝒢P.germAlong (fun z => prodUnif e Φ₁ Φ₂ (fun i => z (Fin.cast hg i)))
      (F k : 𝒢P.genStalk)) 0 (Pi.single j 1) with hM
  have hentry : ∀ k j, M k j = fderiv ℂ (𝒢P.germAlong (prodUnif e Φ₁ Φ₂) (F k : 𝒢P.genStalk)) 0
      (castCLE hg (Pi.single j 1)) := by
    intro k j
    rw [hM, Matrix.of_apply]
    have : 𝒢P.germAlong (fun z => prodUnif e Φ₁ Φ₂ (fun i => z (Fin.cast hg i)))
        (F k : 𝒢P.genStalk) = 𝒢P.germAlong (prodUnif e Φ₁ Φ₂) (F k : 𝒢P.genStalk) ∘ castCLE hg :=
      rfl
    rw [this, ContinuousLinearEquiv.comp_right_fderiv, map_zero]
    rfl
  have hdet : M.det ≠ 0 := hne
  constructor
  · by_contra hlt
    push Not at hlt
    apply hdet
    refine det_eq_zero_of_rows_supported M (Finset.univ.image (Fin.castAdd d₂))
      (Finset.univ.image fun a : Fin g₁ => Fin.cast hg (Fin.castAdd g₂ a)) ?_ ?_
    · intro k hk j hj
      obtain ⟨i, -, rfl⟩ := Finset.mem_image.mp hk
      rw [hentry, hF1, hd1]
      have : (fun a => castCLE hg (Pi.single j (1 : ℂ)) (Fin.castAdd g₂ a)) = 0 := by
        funext a
        rw [castCLE_apply]
        refine Pi.single_eq_of_ne (fun h => hj ?_) _
        exact Finset.mem_image.mpr ⟨a, Finset.mem_univ _, h⟩
      rw [this, map_zero]
    · calc (Finset.univ.image fun a : Fin g₁ => Fin.cast hg (Fin.castAdd g₂ a)).card
          ≤ (Finset.univ : Finset (Fin g₁)).card := Finset.card_image_le
        _ = g₁ := by simp
        _ < d₁ := hlt
        _ = (Finset.univ.image (Fin.castAdd d₂ : Fin d₁ → Fin (d₁ + d₂))).card := by
          rw [Finset.card_image_of_injective _ (Fin.castAdd_injective d₁ d₂)]; simp
  · by_contra hlt
    push Not at hlt
    apply hdet
    refine det_eq_zero_of_rows_supported M (Finset.univ.image (Fin.natAdd d₁))
      (Finset.univ.image fun a : Fin g₂ => Fin.cast hg (Fin.natAdd g₁ a)) ?_ ?_
    · intro k hk j hj
      obtain ⟨i, -, rfl⟩ := Finset.mem_image.mp hk
      rw [hentry, hF2, hd2]
      have : (fun a => castCLE hg (Pi.single j (1 : ℂ)) (Fin.natAdd g₁ a)) = 0 := by
        funext a
        rw [castCLE_apply]
        refine Pi.single_eq_of_ne (fun h => hj ?_) _
        exact Finset.mem_image.mpr ⟨a, Finset.mem_univ _, h⟩
      rw [this, map_zero]
    · calc (Finset.univ.image fun a : Fin g₂ => Fin.cast hg (Fin.natAdd g₁ a)).card
          ≤ (Finset.univ : Finset (Fin g₂)).card := Finset.card_image_le
        _ = g₂ := by simp
        _ < d₂ := hlt
        _ = (Finset.univ.image (Fin.natAdd d₁ : Fin d₂ → Fin (d₁ + d₂))).card := by
          rw [Finset.card_image_of_injective _ (Fin.natAdd_injective d₂ d₁)]; simp

end Shape

end ZInQ.InfraHodge


/-! # infra-hodge S-alg, part 3: `ProductMetrizationOfProductUnif` from `ProdUnifDeriv`

`g = 0`: the factors get metrizations of dimension `0` (height `0`). `g ≥ 1`: an `L`-basis of
`ω_{A_L}` of the product inside `ω_{𝒢P}` (`exists_omega_basis`) splits along
`ω ≅ ω₁ × ω₂` (part 2), so `dim ωᵢ = dᵢ` with `d₁ + d₂ = g`; bases `u ⊆ ω₁`, `w ⊆ ω₂`; the dimension
count (part 2) gives `gᵢ(τ) = dᵢ` at every `τ`; the coefficient of `MP` on
`(p₁^* f, p₂^* h)` is `jacDet Φ₁ f · jacDet Φ₂ h` (block Jacobian) and, the Hodge line being a
line, `τ(det_u(df)) τ(det_w(dh)) · c₁ c₂`, so `jacDet Φ₁ f = τ(det_u(df)) · c₁` (descent); indices
multiply (part 3 of ProductHodgeLattice), coefficients and covolumes multiply, and
product-height's `modelHeight_add_of` gives `h(M₁) + h(M₂) = h(MP)`. -/

namespace ZInQ.InfraHodge

open CategoryTheory AlgebraicGeometry Limits MonoidalCategory CartesianMonoidalCategory MonObj
open NumberField ZInQ.DefFaltings Module ZInQ.ProductHeight
open PkgI3 (AbVar)
open scoped TensorProduct

section DeltaEquiv

variable {L : Type*} [Field L] [NumberField L]
variable {V : Type*} [AddCommGroup V] [Module L V] [Module (𝓞 L) V] [IsScalarTower (𝓞 L) L V]

theorem delta_surjective {n : ℕ} (b : Basis (Fin n) L V) : Function.Surjective (delta b) := by
  intro c
  refine ⟨c ⊗ₜ[𝓞 L] exteriorPower.ιMulti (𝓞 L) n b, ?_⟩
  rw [show c ⊗ₜ[𝓞 L] exteriorPower.ιMulti (𝓞 L) n ⇑b =
      c • ((1 : L) ⊗ₜ[𝓞 L] exteriorPower.ιMulti (𝓞 L) n b) from by
    rw [TensorProduct.smul_tmul', smul_eq_mul, _root_.mul_one],
    map_smul, delta_tmul_one, b.det_self, smul_eq_mul, _root_.mul_one]

/-- `δ_b` as a linear equivalence. -/
noncomputable def deltaEquiv {n : ℕ} (b : Basis (Fin n) L V) : L ⊗[𝓞 L] ⋀[𝓞 L]^n V ≃ₗ[L] L :=
  LinearEquiv.ofBijective (delta b) ⟨delta_injective b, delta_surjective b⟩

theorem deltaEquiv_apply {n : ℕ} (b : Basis (Fin n) L V) (x : L ⊗[𝓞 L] ⋀[𝓞 L]^n V) :
    deltaEquiv b x = delta b x := rfl

end DeltaEquiv

theorem covolume_congr {n : ℕ} {Λ Λ' : Submodule ℤ (Fin n → ℂ)}
    (h : Λ = Λ') [DiscreteTopology Λ] [IsZLattice ℝ Λ] [DiscreteTopology Λ'] [IsZLattice ℝ Λ'] :
    ZLattice.covolume Λ = ZLattice.covolume Λ' := by
  subst h; rfl

section Split

variable {K : Type} [Field K] {A B C : AbVar K} {L : Type} [Field L] [NumberField L] [Algebra K L]

/-- A metrized model of dimension `0` from `0`-dimensional uniformizations. -/
noncomputable def metrizedZero (𝒢 : GroupModel A L) (Λ : (L →+* ℂ) → Submodule ℤ (Fin 0 → ℂ))
    (hΛd : ∀ τ, DiscreteTopology (Λ τ)) (hΛz : ∀ τ, IsZLattice ℝ (Λ τ))
    (Φ : ∀ τ : L →+* ℂ, (Fin 0 → ℂ) → 𝒢.Pts τ)
    (hΦ : ∀ τ, 𝒢.IsAnalyticUniformization τ (Λ τ) (Φ τ)) : MetrizedModel A L 0 :=
  mkMetrized 𝒢 0 (ZInQ.H5Neron.hodgeZeroEquiv 𝒢) (ZInQ.H5Neron.wedge0 𝒢)
    (by rw [ZInQ.H5Neron.detLattice_zero]; exact Submodule.mem_span_singleton_self _)
    (ZInQ.H5Neron.wedge0_ne_zero 𝒢)
    (by rw [ZInQ.H5Neron.detLattice_zero, secIndex_eq_relIndex, AddSubgroup.relIndex_self]
        exact one_ne_zero)
    Λ hΛd hΛz Φ hΦ (fun _ => 1) (fun _ => one_ne_zero)
    (fun τ f => by
      rw [ZInQ.H5Neron.wedge_eq_wedge0, ZInQ.H5Neron.hodgeZeroEquiv_wedge0, map_one,
        _root_.mul_one]
      simp [GroupModel.jacDet])

/-- **`ProductMetrizationOfProductUnif` from `ProdUnifDeriv`.** -/
theorem productMetrizationOfProductUnif_of (hD : ProdUnifDeriv) :
    ProductMetrizationOfProductUnif := by
  intro K _ A B C L _ _ _ 𝒢₁ 𝒢₂ g MP e _ _ H
  rcases Nat.eq_zero_or_pos g with rfl | hg0
  · -- dimension `0`
    have key : ∀ τ : L →+* ℂ, ∃ (Λ₁ : Submodule ℤ (Fin 0 → ℂ)) (Λ₂ : Submodule ℤ (Fin 0 → ℂ))
        (Φ₁ : (Fin 0 → ℂ) → 𝒢₁.Pts τ) (Φ₂ : (Fin 0 → ℂ) → 𝒢₂.Pts τ),
        (∃ _ : DiscreteTopology Λ₁, IsZLattice ℝ Λ₁) ∧
        (∃ _ : DiscreteTopology Λ₂, IsZLattice ℝ Λ₂) ∧
        𝒢₁.IsAnalyticUniformization τ Λ₁ Φ₁ ∧ 𝒢₂.IsAnalyticUniformization τ Λ₂ Φ₂ := by
      intro τ
      obtain ⟨g₁, g₂, hg, Λ₁, Λ₂, Φ₁, Φ₂, hl₁, hl₂, hu₁, hu₂, -, -⟩ := H τ
      obtain ⟨rfl, rfl⟩ : g₁ = 0 ∧ g₂ = 0 := ⟨by omega, by omega⟩
      exact ⟨Λ₁, Λ₂, Φ₁, Φ₂, hl₁, hl₂, hu₁, hu₂⟩
    choose Λ₁ Λ₂ Φ₁ Φ₂ hl₁ hl₂ hu₁ hu₂ using key
    refine ⟨0, 0, metrizedZero 𝒢₁ Λ₁ (fun τ => (hl₁ τ).1) (fun τ => (hl₁ τ).2) Φ₁ hu₁,
      metrizedZero 𝒢₂ Λ₂ (fun τ => (hl₂ τ).1) (fun τ => (hl₂ τ).2) Φ₂ hu₂, rfl, rfl, ?_⟩
    rw [ZInQ.H5Neron.modelHeight_dim_zero, ZInQ.H5Neron.modelHeight_dim_zero,
      ZInQ.H5Neron.modelHeight_dim_zero, add_zero]
  -- dimension `g ≥ 1`
  letI := cotL 𝒢₁
  letI := cotL 𝒢₂
  letI := cotL MP.model
  haveI := cotL_isScalarTower 𝒢₁
  haveI := cotL_isScalarTower 𝒢₂
  haveI := cotL_isScalarTower MP.model
  obtain ⟨b, hb⟩ := exists_omega_basis MP (fun h => absurd h (by omega))
  set P1 := cotGL (e.hom ≫ fst _ _) (hp1 e)
  set P2 := cotGL (e.hom ≫ snd _ _) (hp2 e)
  set I1 := cotGL (incl1 e) (hi1 e)
  set I2 := cotGL (incl2 e) (hi2 e)
  let Ψ : (𝒢₁.cotangent × 𝒢₂.cotangent) ≃ₗ[L] MP.model.cotangent :=
    LinearEquiv.ofLinearMap (P1.coprod P2) (I1.prod I2)
      (LinearMap.ext fun v => (cot_split e v).symm)
      (LinearMap.ext fun v => by
        refine Prod.ext ?_ ?_
        · show I1 (P1 v.1 + P2 v.2) = v.1
          rw [map_add]
          exact (congrArg₂ (· + ·) (cot_i1_p1 e v.1) (cot_i1_p2 e v.2)).trans (add_zero _)
        · show I2 (P1 v.1 + P2 v.2) = v.2
          rw [map_add]
          exact (congrArg₂ (· + ·) (cot_i2_p1 e v.1) (cot_i2_p2 e v.2)).trans (zero_add _))
  have hΨ : ∀ x y, Ψ (x, y) = P1 x + P2 y := fun x y => rfl
  have hΨs1 : ∀ x, Ψ.symm (P1 x) = (x, 0) := fun x =>
    Prod.ext (cot_i1_p1 e x) (cot_i2_p1 e x)
  have hΨs2 : ∀ y, Ψ.symm (P2 y) = (0, y) := fun y =>
    Prod.ext (cot_i1_p2 e y) (cot_i2_p2 e y)
  have hPω1 : ∀ x ∈ 𝒢₁.omega, P1 x ∈ MP.model.omega :=
    fun x hx => cotG_omega _ (IsMonHom.one_hom _) (hp1 e) hx
  have hPω2 : ∀ x ∈ 𝒢₂.omega, P2 x ∈ MP.model.omega :=
    fun x hx => cotG_omega _ (IsMonHom.one_hom _) (hp2 e) hx
  have hIω1 : ∀ v ∈ MP.model.omega, I1 v ∈ 𝒢₁.omega :=
    fun v hv => cotG_omega _ (one_comp_incl1 e) (hi1 e) hv
  have hIω2 : ∀ v ∈ MP.model.omega, I2 v ∈ 𝒢₂.omega :=
    fun v hv => cotG_omega _ (one_comp_incl2 e) (hi2 e) hv
  haveI : FiniteDimensional L MP.model.cotangent := Module.Finite.of_basis b
  haveI : FiniteDimensional L (𝒢₁.cotangent × 𝒢₂.cotangent) := Module.Finite.equiv Ψ.symm
  haveI : FiniteDimensional L 𝒢₁.cotangent :=
    Module.Finite.of_surjective (LinearMap.fst L 𝒢₁.cotangent 𝒢₂.cotangent)
      LinearMap.fst_surjective
  haveI : FiniteDimensional L 𝒢₂.cotangent :=
    Module.Finite.of_surjective (LinearMap.snd L 𝒢₁.cotangent 𝒢₂.cotangent)
      LinearMap.snd_surjective
  have hdim : finrank L 𝒢₁.cotangent + finrank L 𝒢₂.cotangent = g := by
    rw [← Module.finrank_prod, Ψ.finrank_eq, Module.finrank_eq_card_basis b, Fintype.card_fin]
  have hsp1 : Submodule.span L (Set.range fun k => I1 (b k)) = ⊤ := by
    rw [show (Set.range fun k => I1 (b k)) = I1 '' Set.range b from (Set.range_comp _ _),
      Submodule.span_image, b.span_eq, Submodule.map_top, LinearMap.range_eq_top]
    exact fun x => ⟨P1 x, cot_i1_p1 e x⟩
  have hsp2 : Submodule.span L (Set.range fun k => I2 (b k)) = ⊤ := by
    rw [show (Set.range fun k => I2 (b k)) = I2 '' Set.range b from (Set.range_comp _ _),
      Submodule.span_image, b.span_eq, Submodule.map_top, LinearMap.range_eq_top]
    exact fun x => ⟨P2 x, cot_i2_p2 e x⟩
  obtain ⟨u, hu⟩ := exists_basis_in 𝒢₁.omega (fun k => I1 (b k)) (fun k => hIω1 _ (hb k)) hsp1
  obtain ⟨w, hw⟩ := exists_basis_in 𝒢₂.omega (fun k => I2 (b k)) (fun k => hIω2 _ (hb k)) hsp2
  generalize hd₁ : finrank L 𝒢₁.cotangent = d₁ at u hdim
  generalize hd₂ : finrank L 𝒢₂.cotangent = d₂ at w hdim
  subst hdim
  set B : Basis (Fin (d₁ + d₂)) L MP.model.cotangent := ((u.prod w).map Ψ).reindex finSumFinEquiv
    with hBdef
  have hB1 : ∀ i, B (Fin.castAdd d₂ i) = P1 (u i) := by
    intro i
    rw [hBdef, Basis.reindex_apply, Basis.map_apply, finSumFinEquiv_symm_apply_castAdd,
      Basis.prod_apply]
    show Ψ (u i, 0) = _
    rw [hΨ, map_zero, add_zero]
  have hB2 : ∀ j, B (Fin.natAdd d₁ j) = P2 (w j) := by
    intro j
    rw [hBdef, Basis.reindex_apply, Basis.map_apply, finSumFinEquiv_symm_apply_natAdd,
      Basis.prod_apply]
    show Ψ (0, w j) = _
    rw [hΨ, map_zero, zero_add]
  have hBω : ∀ k, B k ∈ MP.model.omega := by
    intro k
    refine Fin.addCases (fun i => ?_) (fun j => ?_) k
    · rw [hB1]; exact hPω1 _ (hu i)
    · rw [hB2]; exact hPω2 _ (hw j)
  have hdet : detIdeal B MP.model.omega = detIdeal (u.prod w) (𝒢₁.omega.prod 𝒢₂.omega) := by
    apply le_antisymm
    · rw [detIdeal, Submodule.span_le]
      rintro _ ⟨v, rfl⟩
      refine Submodule.subset_span ⟨fun k => ⟨Ψ.symm (v (finSumFinEquiv k)),
        Submodule.mem_prod.mpr ⟨hIω1 _ (v _).2, hIω2 _ (v _).2⟩⟩, ?_⟩
      show (u.prod w).det (fun k => Ψ.symm (v (finSumFinEquiv k))) = B.det (fun k => (v k : _))
      rw [hBdef, Basis.det_reindex, Basis.det_map]
      rfl
    · rw [detIdeal, Submodule.span_le]
      rintro _ ⟨x, rfl⟩
      refine Submodule.subset_span ⟨fun k => ⟨Ψ (x (finSumFinEquiv.symm k)), ?_⟩, ?_⟩
      · obtain ⟨h1, h2⟩ := Submodule.mem_prod.mp (x (finSumFinEquiv.symm k)).2
        rw [show Ψ (x (finSumFinEquiv.symm k)) =
          P1 ((x (finSumFinEquiv.symm k) : 𝒢₁.cotangent × 𝒢₂.cotangent).1) +
          P2 ((x (finSumFinEquiv.symm k) : 𝒢₁.cotangent × 𝒢₂.cotangent).2) from rfl]
        exact add_mem (hPω1 _ h1) (hPω2 _ h2)
      · show B.det (fun k => Ψ (x (finSumFinEquiv.symm k))) = (u.prod w).det (fun k => (x k : _))
        rw [hBdef, Basis.det_reindex, Basis.det_map]
        congr 1
        funext k
        simp
  -- germ families `(p₁^* f, p₂^* h)`
  let F' : (Fin d₁ → IsLocalRing.maximalIdeal 𝒢₁.genStalk) →
      (Fin d₂ → IsLocalRing.maximalIdeal 𝒢₂.genStalk) →
      Fin (d₁ + d₂) → IsLocalRing.maximalIdeal MP.model.genStalk := fun f h =>
    Fin.append
      (fun i => ⟨((e.hom ≫ fst _ _).left.stalkMapAt (hp1 e)).hom (f i),
        map_nonunit ((e.hom ≫ fst _ _).left.stalkMapAt (hp1 e)).hom _ (f i).2⟩)
      (fun j => ⟨((e.hom ≫ snd _ _).left.stalkMapAt (hp2 e)).hom (h j),
        map_nonunit ((e.hom ≫ snd _ _).left.stalkMapAt (hp2 e)).hom _ (h j).2⟩)
  have hF'1 : ∀ f h i, (F' f h (Fin.castAdd d₂ i) : MP.model.genStalk) =
      ((e.hom ≫ fst _ _).left.stalkMapAt (hp1 e)).hom (f i) := by
    intro f h i; simp only [F', Fin.append_left]
  have hF'2 : ∀ f h j, (F' f h (Fin.natAdd d₁ j) : MP.model.genStalk) =
      ((e.hom ≫ snd _ _).left.stalkMapAt (hp2 e)).hom (h j) := by
    intro f h j; simp only [F', Fin.append_right]
  have hdF1 : ∀ f h i, MP.model.dCls (F' f h (Fin.castAdd d₂ i)) = P1 (𝒢₁.dCls (f i)) := by
    intro f h i
    simp only [F', Fin.append_left]
    show (IsLocalRing.maximalIdeal _).toCotangent _ =
      cotMapAt (e.hom ≫ fst _ _).left (hp1 e) ((IsLocalRing.maximalIdeal _).toCotangent (f i))
    rw [cotMapAt_toCotangent]
  have hdF2 : ∀ f h j, MP.model.dCls (F' f h (Fin.natAdd d₁ j)) = P2 (𝒢₂.dCls (h j)) := by
    intro f h j
    simp only [F', Fin.append_right]
    show (IsLocalRing.maximalIdeal _).toCotangent _ =
      cotMapAt (e.hom ≫ snd _ _).left (hp2 e) ((IsLocalRing.maximalIdeal _).toCotangent (h j))
    rw [cotMapAt_toCotangent]
  have hCL : ∀ f h, delta B (MP.model.wedge (F' f h)) =
      u.det (fun i => 𝒢₁.dCls (f i)) * w.det (fun j => 𝒢₂.dCls (h j)) := by
    intro f h
    unfold GroupModel.wedge
    rw [delta_tmul_one, hBdef, Basis.det_reindex, Basis.det_map, ← det_prod_block]
    congr 1
    funext k
    rcases k with i | j
    · simp only [Function.comp_apply, finSumFinEquiv_apply_left, Sum.elim_inl]
      rw [hdF1, hΨs1]
    · simp only [Function.comp_apply, finSumFinEquiv_apply_right, Sum.elim_inr]
      rw [hdF2, hΨs2]
  choose f₁ hf₁ using fun i => (IsLocalRing.maximalIdeal 𝒢₁.genStalk).toCotangent_surjective (u i)
  choose f₂ hf₂ using fun j => (IsLocalRing.maximalIdeal 𝒢₂.genStalk).toCotangent_surjective (w j)
  have hdu : (fun i => 𝒢₁.dCls (f₁ i)) = ⇑u := funext hf₁
  have hdw : (fun j => 𝒢₂.dCls (f₂ j)) = ⇑w := funext hf₂
  have hδF : delta B (MP.model.wedge (F' f₁ f₂)) = 1 := by
    rw [hCL, hdu, hdw, u.det_self, w.det_self, _root_.mul_one]
  have hwF0 : MP.model.wedge (F' f₁ f₂) ≠ 0 := fun h => by
    rw [h, map_zero] at hδF; exact zero_ne_one hδF
  have hdf : (fun k => MP.model.dCls (F' f₁ f₂ k)) = fun k => B k := by
    funext k
    refine Fin.addCases (fun i => ?_) (fun j => ?_) k
    · rw [hdF1, hB1]; exact congrArg P1 (hf₁ i)
    · rw [hdF2, hB2]; exact congrArg P2 (hf₂ j)
  have hwP : MP.model.wedge (F' f₁ f₂) =
      (1 : L) ⊗ₜ[𝓞 L] exteriorPower.ιMulti (𝓞 L) (d₁ + d₂) B := by
    unfold GroupModel.wedge
    rw [hdf]
  have hw1 : 𝒢₁.wedge f₁ = (1 : L) ⊗ₜ[𝓞 L] exteriorPower.ιMulti (𝓞 L) d₁ u := by
    unfold GroupModel.wedge; rw [hdu]
  have hw2 : 𝒢₂.wedge f₂ = (1 : L) ⊗ₜ[𝓞 L] exteriorPower.ιMulti (𝓞 L) d₂ w := by
    unfold GroupModel.wedge; rw [hdw]
  -- at each `τ`, `gᵢ(τ) = dᵢ`
  have key : ∀ τ : L →+* ℂ, ∃ (Λ₁ : Submodule ℤ (Fin d₁ → ℂ)) (Λ₂ : Submodule ℤ (Fin d₂ → ℂ))
      (Φ₁ : (Fin d₁ → ℂ) → 𝒢₁.Pts τ) (Φ₂ : (Fin d₂ → ℂ) → 𝒢₂.Pts τ),
      (∃ _ : DiscreteTopology Λ₁, IsZLattice ℝ Λ₁) ∧
      (∃ _ : DiscreteTopology Λ₂, IsZLattice ℝ Λ₂) ∧
      𝒢₁.IsAnalyticUniformization τ Λ₁ Φ₁ ∧ 𝒢₂.IsAnalyticUniformization τ Λ₂ Φ₂ ∧
      MP.hodge.periods τ = prodLattice Λ₁ Λ₂ ∧
      ∀ f, MP.hodge.coeff τ (MP.model.wedge f) = MP.model.jacDet (prodUnif e Φ₁ Φ₂) f := by
    intro τ
    obtain ⟨g₁, g₂, hg, Λ₁, Λ₂, Φ₁, Φ₂, hl₁, hl₂, hu₁, hu₂, hper, hco⟩ := H τ
    have hne : MP.model.jacDet (fun z => prodUnif e Φ₁ Φ₂ (fun i => z (Fin.cast hg i)))
        (F' f₁ f₂) ≠ 0 := by
      rw [← hco (F' f₁ f₂)]; exact MP.hodge.coeff_apply_ne_zero τ hwF0
    obtain ⟨h1, h2⟩ := dims_le_of_jacDet_ne_zero e hD hg hu₁ hu₂ f₁ f₂ (F' f₁ f₂)
      (hF'1 f₁ f₂) (hF'2 f₁ f₂) hne
    obtain ⟨rfl, rfl⟩ : g₁ = d₁ ∧ g₂ = d₂ := ⟨by omega, by omega⟩
    exact ⟨Λ₁, Λ₂, Φ₁, Φ₂, hl₁, hl₂, hu₁, hu₂, Submodule.ext fun z => hper z, fun f => hco f⟩
  choose Λ₁ Λ₂ Φ₁ Φ₂ hl₁ hl₂ hu₁ hu₂ hper hco using key
  have hcoF : ∀ τ f h, MP.hodge.coeff τ (MP.model.wedge (F' f h)) =
      𝒢₁.jacDet (Φ₁ τ) f * 𝒢₂.jacDet (Φ₂ τ) h := fun τ f h =>
    (hco τ _).trans (jacDet_prodUnif e hD (hu₁ τ) (hu₂ τ) f h (F' f h) (hF'1 f h) (hF'2 f h))
  have hline : ∀ τ x, MP.hodge.coeff τ x =
      τ (delta B x) * MP.hodge.coeff τ (MP.model.wedge (F' f₁ f₂)) := by
    intro τ x
    have hx : x = delta B x • MP.model.wedge (F' f₁ f₂) :=
      delta_injective B (by rw [map_smul, hδF, smul_eq_mul, _root_.mul_one])
    conv_lhs => rw [hx]
    rw [map_smulₛₗ, smul_eq_mul]
  have hc12 : ∀ τ, 𝒢₁.jacDet (Φ₁ τ) f₁ * 𝒢₂.jacDet (Φ₂ τ) f₂ ≠ 0 := fun τ => by
    rw [← hcoF τ f₁ f₂]; exact MP.hodge.coeff_apply_ne_zero τ hwF0
  have hjac₁ : ∀ τ f, 𝒢₁.jacDet (Φ₁ τ) f =
      τ (deltaEquiv u (𝒢₁.wedge f)) * 𝒢₁.jacDet (Φ₁ τ) f₁ := by
    intro τ f
    have h1 := hcoF τ f f₂
    rw [hline, hCL, hcoF τ f₁ f₂, hdw, w.det_self, _root_.mul_one] at h1
    have hc2 : 𝒢₂.jacDet (Φ₂ τ) f₂ ≠ 0 := right_ne_zero_of_mul (hc12 τ)
    rw [deltaEquiv_apply]
    unfold GroupModel.wedge
    rw [delta_tmul_one]
    apply mul_right_cancel₀ hc2
    linear_combination -h1
  have hjac₂ : ∀ τ h, 𝒢₂.jacDet (Φ₂ τ) h =
      τ (deltaEquiv w (𝒢₂.wedge h)) * 𝒢₂.jacDet (Φ₂ τ) f₂ := by
    intro τ h
    have h1 := hcoF τ f₁ h
    rw [hline, hCL, hcoF τ f₁ f₂, hdu, u.det_self, _root_.one_mul] at h1
    have hc1 : 𝒢₁.jacDet (Φ₁ τ) f₁ ≠ 0 := left_ne_zero_of_mul (hc12 τ)
    rw [deltaEquiv_apply]
    unfold GroupModel.wedge
    rw [delta_tmul_one]
    apply mul_left_cancel₀ hc1
    linear_combination -h1
  -- indices
  have hone : ∀ {V : Type} [AddCommGroup V] [Module L V] [Module (𝓞 L) V]
      [IsScalarTower (𝓞 L) L V] {n : ℕ} (b : Basis (Fin n) L V) (W : Submodule (𝓞 L) V),
      (∀ k, b k ∈ W) → (1 : L) ∈ detIdeal b W := by
    intro V _ _ _ _ n b W hb
    exact Submodule.subset_span ⟨fun k => ⟨b k, hb k⟩, b.det_self⟩
  have eP : (Submodule.span (𝓞 L) {(1 : L) ⊗ₜ[𝓞 L] exteriorPower.ιMulti (𝓞 L) (d₁ + d₂) B}).toAddSubgroup.relIndex
      (MP.model.detLattice (d₁ + d₂)).toAddSubgroup = idx (detIdeal B MP.model.omega) :=
    relIndex_detLat B MP.model.omega
  have e1 : (Submodule.span (𝓞 L) {(1 : L) ⊗ₜ[𝓞 L] exteriorPower.ιMulti (𝓞 L) d₁ u}).toAddSubgroup.relIndex
      (𝒢₁.detLattice d₁).toAddSubgroup = idx (detIdeal u 𝒢₁.omega) :=
    relIndex_detLat u 𝒢₁.omega
  have e2 : (Submodule.span (𝓞 L) {(1 : L) ⊗ₜ[𝓞 L] exteriorPower.ιMulti (𝓞 L) d₂ w}).toAddSubgroup.relIndex
      (𝒢₂.detLattice d₂).toAddSubgroup = idx (detIdeal w 𝒢₂.omega) :=
    relIndex_detLat w 𝒢₂.omega
  have hidxP : secIndex (MP.model.detLattice (d₁ + d₂)) (MP.model.wedge (F' f₁ f₂)) =
      idx (detIdeal u 𝒢₁.omega) * idx (detIdeal w 𝒢₂.omega) := by
    rw [hwP, secIndex_eq_relIndex, eP, hdet, detIdeal_prod, idx_mul (hone u _ hu) (hone w _ hw)]
  have hsi1 : secIndex (𝒢₁.detLattice d₁) (𝒢₁.wedge f₁) = idx (detIdeal u 𝒢₁.omega) := by
    rw [hw1, secIndex_eq_relIndex, e1]
  have hsi2 : secIndex (𝒢₂.detLattice d₂) (𝒢₂.wedge f₂) = idx (detIdeal w 𝒢₂.omega) := by
    rw [hw2, secIndex_eq_relIndex, e2]
  have hsP : MP.model.wedge (F' f₁ f₂) ∈ MP.hodge.lattice := by
    rw [MP.lattice_eq, hwP]
    exact Submodule.subset_span ⟨fun k => ⟨B k, hBω k⟩, rfl⟩
  have hsiP := MP.hodge.hodgeBundle.secIndex_ne_zero hsP hwF0
  have hsiP' : idx (detIdeal u 𝒢₁.omega) * idx (detIdeal w 𝒢₂.omega) ≠ 0 := by
    rw [← hidxP, ← MP.lattice_eq]; exact hsiP
  have hs1 : 𝒢₁.wedge f₁ ∈ 𝒢₁.detLattice d₁ := by
    rw [hw1]; exact Submodule.subset_span ⟨fun k => ⟨u k, hu k⟩, rfl⟩
  have hs2 : 𝒢₂.wedge f₂ ∈ 𝒢₂.detLattice d₂ := by
    rw [hw2]; exact Submodule.subset_span ⟨fun k => ⟨w k, hw k⟩, rfl⟩
  have hne : ∀ {V : Type} [AddCommGroup V] [Module L V] [Module (𝓞 L) V]
      [IsScalarTower (𝓞 L) L V] {n : ℕ} (b : Basis (Fin n) L V),
      (1 : L) ⊗ₜ[𝓞 L] exteriorPower.ιMulti (𝓞 L) n b ≠ 0 := by
    intro V _ _ _ _ n b h
    have := congrArg (delta b) h
    rw [delta_tmul_one, b.det_self, map_zero] at this
    exact one_ne_zero this
  have hs10 : 𝒢₁.wedge f₁ ≠ 0 := by rw [hw1]; exact hne u
  have hs20 : 𝒢₂.wedge f₂ ≠ 0 := by rw [hw2]; exact hne w
  let M₁ := mkMetrized 𝒢₁ d₁ (deltaEquiv u) (𝒢₁.wedge f₁) hs1 hs10
    (by rw [hsi1]; exact left_ne_zero_of_mul hsiP') Λ₁ (fun τ => (hl₁ τ).1)
    (fun τ => (hl₁ τ).2) Φ₁ hu₁ (fun τ => 𝒢₁.jacDet (Φ₁ τ) f₁)
    (fun τ => left_ne_zero_of_mul (hc12 τ)) hjac₁
  let M₂ := mkMetrized 𝒢₂ d₂ (deltaEquiv w) (𝒢₂.wedge f₂) hs2 hs20
    (by rw [hsi2]; exact right_ne_zero_of_mul hsiP') Λ₂ (fun τ => (hl₂ τ).1)
    (fun τ => (hl₂ τ).2) Φ₂ hu₂ (fun τ => 𝒢₂.jacDet (Φ₂ τ) f₂)
    (fun τ => right_ne_zero_of_mul (hc12 τ)) hjac₂
  refine ⟨d₁, d₂, M₁, M₂, rfl, rfl, le_of_eq ?_⟩
  refine (modelHeight_add_of MP.hodge M₁.hodge M₂.hodge hsP hwF0 hs1 hs10 hs2 hs20 ?_ ?_ ?_).symm
  · rw [MP.lattice_eq, hidxP]
    show _ = secIndex (𝒢₁.detLattice d₁) _ * secIndex (𝒢₂.detLattice d₂) _
    rw [hsi1, hsi2]
  · intro σ
    show _ = coeffOf (deltaEquiv u) σ (𝒢₁.jacDet (Φ₁ σ) f₁) (𝒢₁.wedge f₁) *
      coeffOf (deltaEquiv w) σ (𝒢₂.jacDet (Φ₂ σ) f₂) (𝒢₂.wedge f₂)
    rw [coeffOf_apply, coeffOf_apply, deltaEquiv_apply, deltaEquiv_apply, hw1, hw2,
      delta_tmul_one, delta_tmul_one, u.det_self, w.det_self, map_one, _root_.one_mul,
      _root_.one_mul]
    exact hcoF σ f₁ f₂
  · intro σ
    haveI := (hl₁ σ).1
    haveI := (hl₁ σ).2
    haveI := (hl₂ σ).1
    haveI := (hl₂ σ).2
    obtain ⟨hd, hz, hc⟩ := prodLattice_facts (Λ₁ σ) (Λ₂ σ)
    haveI := MP.hodge.periods_discrete σ
    haveI := MP.hodge.periods_isZLattice σ
    rw [covolume_congr (hper σ)]
    exact hc

end Split

end ZInQ.InfraHodge


