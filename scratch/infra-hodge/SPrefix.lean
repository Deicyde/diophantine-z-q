universe u

open CategoryTheory Limits

namespace AlgebraicGeometry

/-- The stalk of `T` at `t` is *generated* by the stalk maps of `p : T ⟶ X` and `q : T ⟶ Y`:
every element is `c / w` with `c, w` in the subring generated by the two images and `w` a unit. -/
def StalkGen {T X Y : Scheme.{u}} (p : T ⟶ X) (q : T ⟶ Y) (t : T) : Prop :=
  ∀ r : T.presheaf.stalk t, ∃ c ∈ (p.stalkMap t).hom.range ⊔ (q.stalkMap t).hom.range,
    ∃ w ∈ (p.stalkMap t).hom.range ⊔ (q.stalkMap t).hom.range, IsUnit w ∧ r * w = c

theorem stalkMap_comp_apply' {T X X' : Scheme.{u}} (p : T ⟶ X) (j : X ⟶ X') (t : T)
    (y : X'.presheaf.stalk ((p ≫ j) t)) :
    (p ≫ j).stalkMap t y = p.stalkMap t (j.stalkMap (p t) y) := by
  rw [Scheme.Hom.stalkMap_comp]; rfl

theorem range_stalkMap_comp {T X X' : Scheme.{u}} (p : T ⟶ X) (j : X ⟶ X') (t : T) :
    ((p ≫ j).stalkMap t).hom.range = (j.stalkMap (p t)).hom.range.map (p.stalkMap t).hom := by
  ext x
  constructor
  · rintro ⟨y, rfl⟩
    exact ⟨j.stalkMap (p t) y, ⟨y, rfl⟩, (stalkMap_comp_apply' p j t y).symm⟩
  · rintro ⟨_, ⟨y, rfl⟩, rfl⟩
    exact ⟨y, stalkMap_comp_apply' p j t y⟩

/-- Post-composing with a morphism whose stalk map is an isomorphism (e.g. an open immersion)
does not change the image of the stalk map. -/
theorem range_stalkMap_comp_of_isIso {T X X' : Scheme.{u}} (p : T ⟶ X) (j : X ⟶ X') (t : T)
    [IsIso (j.stalkMap (p t))] :
    ((p ≫ j).stalkMap t).hom.range = (p.stalkMap t).hom.range := by
  rw [range_stalkMap_comp]
  have hs : Function.Surjective (j.stalkMap (p t)).hom :=
    (ConcreteCategory.bijective_of_isIso (j.stalkMap (p t))).2
  rw [RingHom.range_eq_top.mpr hs, ← RingHom.range_eq_map]

theorem StalkGen.comp_openImmersion {T X Y X' Y' : Scheme.{u}} {p : T ⟶ X} {q : T ⟶ Y} {t : T}
    (h : StalkGen p q t) (jX : X ⟶ X') (jY : Y ⟶ Y') [IsOpenImmersion jX] [IsOpenImmersion jY] :
    StalkGen (p ≫ jX) (q ≫ jY) t := by
  unfold StalkGen
  rw [range_stalkMap_comp_of_isIso, range_stalkMap_comp_of_isIso]
  exact h

/-- Transport of `StalkGen` along a morphism `m : T ⟶ Q` whose stalk map at `t` is an isomorphism
(e.g. an open immersion). -/
theorem StalkGen.of_comp {T Q X Y : Scheme.{u}} (m : T ⟶ Q) (p : Q ⟶ X) (q : Q ⟶ Y) (t : T)
    [IsIso (m.stalkMap t)] (h : StalkGen (m ≫ p) (m ≫ q) t) : StalkGen p q (m t) := by
  intro r
  set α := m.stalkMap t
  have hα : Function.Bijective α.hom := ConcreteCategory.bijective_of_isIso α
  have hrange : ∀ φ : Q ⟶ X, ((m ≫ φ).stalkMap t).hom.range =
      (φ.stalkMap (m t)).hom.range.map α.hom := fun φ => range_stalkMap_comp m φ t
  have hrange' : ∀ φ : Q ⟶ Y, ((m ≫ φ).stalkMap t).hom.range =
      (φ.stalkMap (m t)).hom.range.map α.hom := fun φ => range_stalkMap_comp m φ t
  obtain ⟨c, hc, w, hw, hwu, hrw⟩ := h (α r)
  rw [hrange, hrange', ← Subring.map_sup] at hc hw
  obtain ⟨c', hc', rfl⟩ := hc
  obtain ⟨w', hw', rfl⟩ := hw
  refine ⟨c', hc', w', hw', ?_, ?_⟩
  · have := hwu.map (inv α).hom
    rwa [← CommRingCat.comp_apply, IsIso.hom_inv_id, CommRingCat.id_apply] at this
  · apply hα.1
    rw [map_mul, hrw]

/-- Germs at `t` of global sections of `Spec S` coming from `R` along `φ : R ⟶ S` are images under
the stalk map of `Spec.map φ`. -/
theorem germ_ΓSpecIso_inv_map {R S : CommRingCat.{u}} (φ : R ⟶ S) (t : Spec S) (a : R) :
    (Spec S).presheaf.germ ⊤ t trivial ((Scheme.ΓSpecIso S).inv (φ a)) =
      (Spec.map φ).stalkMap t
        ((Spec R).presheaf.germ ⊤ (Spec.map φ t) trivial ((Scheme.ΓSpecIso R).inv a)) := by
  erw [Scheme.Hom.germ_stalkMap_apply (Spec.map φ) ⊤ t (by trivial)]
  have h := Scheme.ΓSpecIso_inv_naturality φ
  have h2 : (Scheme.ΓSpecIso S).inv (φ a) = (Spec.map φ).appTop ((Scheme.ΓSpecIso R).inv a) := by
    rw [← CommRingCat.comp_apply, h, CommRingCat.comp_apply]
  rw [h2]
  rfl

open TensorProduct in
/-- **The affine case.** The stalk of `Spec (A ⊗[R] B)` is generated by the images of the stalks
of `Spec A` and `Spec B`. -/
theorem stalkGen_spec_tensor (R A B : CommRingCat.{u}) [Algebra R A] [Algebra R B]
    (t : Spec (CommRingCat.of (A ⊗[R] B))) :
    StalkGen (Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.includeLeftRingHom :
        A →+* A ⊗[R] B)))
      (Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.includeRight :
        B →ₐ[R] A ⊗[R] B).toRingHom)) t := by
  let T := Spec (CommRingCat.of (A ⊗[R] B))
  set iL : T ⟶ Spec A := Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.includeLeftRingHom :
        A →+* A ⊗[R] B))
  set iR : T ⟶ Spec B := Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.includeRight :
        B →ₐ[R] A ⊗[R] B).toRingHom)
  set S' := (iL.stalkMap t).hom.range ⊔ (iR.stalkMap t).hom.range
  let γ : A ⊗[R] B →+* T.presheaf.stalk t :=
    (T.presheaf.germ ⊤ t trivial).hom.comp
      (Scheme.ΓSpecIso (CommRingCat.of (A ⊗[R] B))).inv.hom
  have hγ : ∀ a, γ a ∈ S' := by
    intro a
    induction a using TensorProduct.induction_on with
    | zero => rw [map_zero]; exact S'.zero_mem
    | add x y hx hy => rw [map_add]; exact S'.add_mem hx hy
    | tmul a b =>
      have e : a ⊗ₜ[R] b = (a ⊗ₜ[R] (1 : B)) * ((1 : A) ⊗ₜ[R] b) := by
        simp [Algebra.TensorProduct.tmul_mul_tmul]
      rw [e, map_mul]
      refine S'.mul_mem ((le_sup_left : _ ≤ S') ⟨_, (germ_ΓSpecIso_inv_map
        (CommRingCat.ofHom (Algebra.TensorProduct.includeLeftRingHom : A →+* A ⊗[R] B)) t a).symm⟩)
        ((le_sup_right : _ ≤ S') ⟨_, (germ_ΓSpecIso_inv_map
        (CommRingCat.ofHom (Algebra.TensorProduct.includeRight :
          B →ₐ[R] A ⊗[R] B).toRingHom) t b).symm⟩)
  intro r
  letI : Algebra Γ(T, ⊤) (T.presheaf.stalk t) := (T.presheaf.germ ⊤ t trivial).hom.toAlgebra
  have hL : IsLocalization.AtPrime (T.presheaf.stalk t)
      ((isAffineOpen_top T).primeIdealOf ⟨t, trivial⟩).asIdeal :=
    (isAffineOpen_top T).isLocalization_stalk ⟨t, trivial⟩
  obtain ⟨⟨a, s⟩, hrs⟩ := @IsLocalization.surj _ _ _ _ _ _ hL r
  refine ⟨_, ?_, _, ?_, @IsLocalization.map_units _ _ _ _ _ _ hL s, hrs⟩
  · have := hγ ((Scheme.ΓSpecIso (CommRingCat.of (A ⊗[R] B))).hom a)
    convert this using 1
    exact (congrArg (T.presheaf.germ ⊤ t trivial).hom
      (Iso.hom_inv_id_apply (Scheme.ΓSpecIso (CommRingCat.of (A ⊗[R] B))) a)).symm
  · have := hγ ((Scheme.ΓSpecIso (CommRingCat.of (A ⊗[R] B))).hom s.1)
    convert this using 1
    exact (congrArg (T.presheaf.germ ⊤ t trivial).hom
      (Iso.hom_inv_id_apply (Scheme.ΓSpecIso (CommRingCat.of (A ⊗[R] B))) s.1)).symm

/-- An affine chart of `X` through `x`, lying over a given affine chart `jV : Spec R ⟶ S` of `S`. -/
theorem exists_affine_chart_over {X S : Scheme.{u}} (f : X ⟶ S) {R : CommRingCat.{u}}
    (jV : Spec R ⟶ S) [IsOpenImmersion jV] (x : X) (hx : f x ∈ Set.range jV) :
    ∃ (A : CommRingCat.{u}) (jU : Spec A ⟶ X) (_ : IsOpenImmersion jU) (φ : R ⟶ A),
      x ∈ Set.range jU ∧ Spec.map φ ≫ jV = jU ≫ f := by
  obtain ⟨x', hx'⟩ : x ∈ Set.range (pullback.fst f jV) := by
    rw [Scheme.Pullback.range_fst]; exact hx
  let 𝒰 := (pullback f jV).affineOpenCover
  obtain ⟨y, hy⟩ := 𝒰.covers x'
  refine ⟨𝒰.X (𝒰.idx x'), 𝒰.f _ ≫ pullback.fst f jV, inferInstance,
    Spec.preimage (𝒰.f _ ≫ pullback.snd f jV), ⟨y, ?_⟩, ?_⟩
  · rw [Scheme.Hom.comp_apply, hy, hx']
  · rw [Spec.map_preimage]
    simp only [Category.assoc, pullback.condition]

/-- **Stalks of a fibre product are generated by the stalks of the factors.** For `f : X ⟶ S`,
`g : Y ⟶ S` and `z ∈ X ×_S Y`, every element of `𝒪_{X ×_S Y, z}` is `c / w` with `c, w` in the
subring generated by the images of `𝒪_{X, fst z}` and `𝒪_{Y, snd z}` and `w` a unit. -/
theorem pullback_stalkGen {X Y S : Scheme.{u}} (f : X ⟶ S) (g : Y ⟶ S) (z : ↥(pullback f g)) :
    StalkGen (pullback.fst f g) (pullback.snd f g) z := by
  let 𝒱 := S.affineOpenCover
  let R := 𝒱.X (𝒱.idx (f (pullback.fst f g z)))
  let jV : Spec R ⟶ S := 𝒱.f (𝒱.idx (f (pullback.fst f g z)))
  have hs : f (pullback.fst f g z) ∈ Set.range jV := 𝒱.covers _
  obtain ⟨A, jU, _, φ, hxU, eU⟩ := exists_affine_chart_over f jV (pullback.fst f g z) hs
  have hs' : g (pullback.snd f g z) ∈ Set.range jV := by
    rw [← Scheme.Hom.comp_apply, ← pullback.condition, Scheme.Hom.comp_apply]; exact hs
  obtain ⟨B, jW, _, ψ, hyW, eW⟩ := exists_affine_chart_over g jV (pullback.snd f g z) hs'
  let _ : Algebra R A := φ.hom.toAlgebra
  let _ : Algebra R B := ψ.hom.toAlgebra
  let m := pullback.map (Spec.map φ) (Spec.map ψ) f g jU jW jV eU eW
  have hz : z ∈ Set.range m := by
    rw [Scheme.Pullback.range_map]; exact ⟨hxU, hyW⟩
  obtain ⟨t0, ht0⟩ := hz
  let e := pullbackSpecIso R A B
  let m' : Spec (CommRingCat.of (TensorProduct R A B)) ⟶ pullback f g := e.inv ≫ m
  have h1 : m' ≫ pullback.fst f g = Spec.map (CommRingCat.ofHom
      (Algebra.TensorProduct.includeLeftRingHom : A →+* TensorProduct R A B)) ≫ jU := by
    simp only [m', m, e, Category.assoc, pullback.lift_fst]
    rw [← Category.assoc]
    exact congrArg (· ≫ jU) (pullbackSpecIso_inv_fst R A B)
  have h2 : m' ≫ pullback.snd f g = Spec.map (CommRingCat.ofHom
      (Algebra.TensorProduct.includeRight : B →ₐ[R] TensorProduct R A B).toRingHom) ≫ jW := by
    simp only [m', m, e, Category.assoc, pullback.lift_snd]
    rw [← Category.assoc]
    exact congrArg (· ≫ jW) (pullbackSpecIso_inv_snd R A B)
  have key := StalkGen.of_comp m' (pullback.fst f g) (pullback.snd f g) (e.hom t0)
    (by rw [h1, h2]; exact (stalkGen_spec_tensor R A B _).comp_openImmersion jU jW)
  have hpt : m' (e.hom t0) = m t0 := by
    have he : e.inv (e.hom t0) = t0 := by
      rw [← Scheme.Hom.comp_apply, Iso.hom_inv_id]; rfl
    simp only [m']
    rw [Scheme.Hom.comp_apply, he]
  rw [hpt, ht0] at key
  exact key

/-! ### Maximal ideals and residue fields -/

/-- `x` is *rational over* `f x`: every element of `𝒪_{X,x}` is congruent modulo `𝔪_x` to the
image of an element of `𝒪_{S, f x}` (the residue field extension `κ(f x) → κ(x)` is onto). -/
def RationalOver {X S : Scheme.{u}} (f : X ⟶ S) (x : X) : Prop :=
  ∀ a : X.presheaf.stalk x, ∃ c : S.presheaf.stalk (f x),
    a - f.stalkMap x c ∈ IsLocalRing.maximalIdeal (X.presheaf.stalk x)

theorem StalkGen.comp_of_isIso {T Q X Y : Scheme.{u}} (m : T ⟶ Q) (p : Q ⟶ X) (q : Q ⟶ Y)
    (t : T) [IsIso (m.stalkMap t)] (h : StalkGen p q (m t)) : StalkGen (m ≫ p) (m ≫ q) t := by
  intro r
  set α := m.stalkMap t
  have hα : Function.Bijective α.hom := ConcreteCategory.bijective_of_isIso α
  obtain ⟨r', rfl⟩ := hα.2 r
  obtain ⟨c, hc, w, hw, hwu, hrw⟩ := h r'
  refine ⟨α c, ?_, α w, ?_, hwu.map α.hom, by rw [← map_mul, hrw]⟩
  · rw [range_stalkMap_comp, range_stalkMap_comp, ← Subring.map_sup]; exact ⟨c, hc, rfl⟩
  · rw [range_stalkMap_comp, range_stalkMap_comp, ← Subring.map_sup]; exact ⟨w, hw, rfl⟩

/-- The two composite stalk maps `𝒪_{S} → 𝒪_{T,t}` of a commutative square agree. -/
theorem exists_stalkMap_comp_eq {T X Y S : Scheme.{u}} (p : T ⟶ X) (q : T ⟶ Y) (f : X ⟶ S)
    (g : Y ⟶ S) (w : p ≫ f = q ≫ g) (t : T) (c : S.presheaf.stalk (f (p t))) :
    ∃ c' : S.presheaf.stalk (g (q t)),
      p.stalkMap t (f.stalkMap (p t) c) = q.stalkMap t (g.stalkMap (q t) c') := by
  have hpt : (p ≫ f) t = (q ≫ g) t := by rw [w]
  refine ⟨(S.presheaf.stalkCongr (.of_eq hpt)).hom c, ?_⟩
  calc p.stalkMap t (f.stalkMap (p t) c) = (p ≫ f).stalkMap t c :=
        (stalkMap_comp_apply' p f t c).symm
    _ = (q ≫ g).stalkMap t ((S.presheaf.stalkCongr (.of_eq hpt)).hom c) := by
        rw [Scheme.Hom.stalkMap_congr_hom (p ≫ f) (q ≫ g) w t]; rfl
    _ = _ := stalkMap_comp_apply' q g t _

section MaximalIdeal

variable {T X Y S : Scheme.{u}} {p : T ⟶ X} {q : T ⟶ Y} {f : X ⟶ S} {g : Y ⟶ S}

/-- The ideal `𝔪_x 𝒪_t + 𝔪_y 𝒪_t`. -/
noncomputable abbrev stalkIdeal (p : T ⟶ X) (q : T ⟶ Y) (t : T) : Ideal (T.presheaf.stalk t) :=
  (IsLocalRing.maximalIdeal _).map (p.stalkMap t).hom ⊔
    (IsLocalRing.maximalIdeal _).map (q.stalkMap t).hom

theorem stalkIdeal_le (t : T) : stalkIdeal p q t ≤ IsLocalRing.maximalIdeal _ := by
  refine sup_le (Ideal.map_le_iff_le_comap.mpr fun a ha => ?_)
    (Ideal.map_le_iff_le_comap.mpr fun a ha => ?_)
  · exact map_nonunit (p.stalkMap t).hom a ha
  · exact map_nonunit (q.stalkMap t).hom a ha

/-- Every element of the subring generated by the two images is congruent modulo
`𝔪_x 𝒪_t + 𝔪_y 𝒪_t` to an element coming from `𝒪_{Y,y}`, when `x` is rational over `s`. -/
theorem exists_sub_mem_stalkIdeal (w : p ≫ f = q ≫ g) {t : T} (hrat : RationalOver f (p t))
    {u : T.presheaf.stalk t} (hu : u ∈ (p.stalkMap t).hom.range ⊔ (q.stalkMap t).hom.range) :
    ∃ b : Y.presheaf.stalk (q t), u - q.stalkMap t b ∈ stalkIdeal p q t := by
  have hR : (p.stalkMap t).hom.range ⊔ (q.stalkMap t).hom.range ≤
      Subring.closure (Set.range (p.stalkMap t).hom ∪ Set.range (q.stalkMap t).hom) :=
    sup_le (fun x hx => Subring.subset_closure (Or.inl (RingHom.mem_range.mp hx)))
      (fun x hx => Subring.subset_closure (Or.inr (RingHom.mem_range.mp hx)))
  set I := stalkIdeal p q t
  suffices H : ∀ u' (hu' : u' ∈ Subring.closure
      (Set.range (p.stalkMap t).hom ∪ Set.range (q.stalkMap t).hom)),
      ∃ b : Y.presheaf.stalk (q t), u' - q.stalkMap t b ∈ I from H u (hR hu)
  intro u' hu'
  induction hu' using Subring.closure_induction with
  | mem x hx =>
    rcases hx with ⟨a, rfl⟩ | ⟨b, rfl⟩
    · obtain ⟨c, hc⟩ := hrat a
      obtain ⟨c', hc'⟩ := exists_stalkMap_comp_eq p q f g w t c
      refine ⟨g.stalkMap (q t) c', ?_⟩
      rw [← hc', ← map_sub]
      exact Ideal.mem_sup_left (Ideal.mem_map_of_mem _ hc)
    · exact ⟨b, by rw [sub_self]; exact I.zero_mem⟩
  | zero => exact ⟨0, by rw [map_zero, sub_self]; exact I.zero_mem⟩
  | one => exact ⟨1, by rw [map_one, sub_self]; exact I.zero_mem⟩
  | add x y _ _ hx hy =>
    obtain ⟨b1, h1⟩ := hx
    obtain ⟨b2, h2⟩ := hy
    refine ⟨b1 + b2, ?_⟩
    have : x + y - q.stalkMap t (b1 + b2) =
        (x - q.stalkMap t b1) + (y - q.stalkMap t b2) := by rw [map_add]; ring
    rw [this]; exact I.add_mem h1 h2
  | neg x _ hx =>
    obtain ⟨b1, h1⟩ := hx
    refine ⟨-b1, ?_⟩
    have : -x - q.stalkMap t (-b1) = -(x - q.stalkMap t b1) := by rw [map_neg]; ring
    rw [this]; exact I.neg_mem h1
  | mul x y _ _ hx hy =>
    obtain ⟨b1, h1⟩ := hx
    obtain ⟨b2, h2⟩ := hy
    refine ⟨b1 * b2, ?_⟩
    have : x * y - q.stalkMap t (b1 * b2) =
        (x - q.stalkMap t b1) * y + q.stalkMap t b1 * (y - q.stalkMap t b2) := by
      rw [map_mul]; ring
    rw [this]
    exact I.add_mem (I.mul_mem_right _ h1) (I.mul_mem_left _ h2)

/-- **Maximal ideal of a stalk generated by two stalks.** If `𝒪_{T,t}` is generated by the stalks
at `x = p t` and `y = q t` (`StalkGen`, e.g. `T = X ×_S Y`) and `x` is rational over `s`, then
`𝔪_t = 𝔪_x 𝒪_t + 𝔪_y 𝒪_t`. -/
theorem maximalIdeal_eq_of_stalkGen (w : p ≫ f = q ≫ g) {t : T} (h : StalkGen p q t)
    (hrat : RationalOver f (p t)) :
    IsLocalRing.maximalIdeal (T.presheaf.stalk t) = stalkIdeal p q t := by
  refine le_antisymm (fun r hr => ?_) (stalkIdeal_le t)
  obtain ⟨c, hc, w', hw', hwu, hrw⟩ := h r
  obtain ⟨b, hb⟩ := exists_sub_mem_stalkIdeal w hrat hc
  have hcm : c ∈ IsLocalRing.maximalIdeal _ := hrw ▸ Ideal.mul_mem_right _ _ hr
  have hqb : q.stalkMap t b ∈ IsLocalRing.maximalIdeal _ := by
    have := Ideal.sub_mem _ hcm (stalkIdeal_le t hb)
    rwa [sub_sub_cancel] at this
  have hbm : b ∈ IsLocalRing.maximalIdeal _ := by
    intro hbu
    exact hqb (hbu.map (q.stalkMap t).hom)
  have hcI : c ∈ stalkIdeal p q t := by
    have := Ideal.add_mem _ hb (Ideal.mem_sup_right (Ideal.mem_map_of_mem _ hbm))
    rwa [sub_add_cancel] at this
  obtain ⟨v, rfl⟩ := hwu
  have : r = c * ↑v⁻¹ := by rw [← hrw, mul_assoc, Units.mul_inv, mul_one]
  rw [this]
  exact Ideal.mul_mem_right _ _ hcI

/-- **Residue field of a stalk generated by two stalks.** Under the hypotheses of
`maximalIdeal_eq_of_stalkGen`, every element of `𝒪_{T,t}` is congruent modulo `𝔪_t` to the image of
an element of `𝒪_{Y,y}`. -/
theorem exists_sub_mem_maximalIdeal_of_stalkGen (w : p ≫ f = q ≫ g) {t : T} (h : StalkGen p q t)
    (hrat : RationalOver f (p t)) (r : T.presheaf.stalk t) :
    ∃ b : Y.presheaf.stalk (q t), r - q.stalkMap t b ∈ IsLocalRing.maximalIdeal _ := by
  obtain ⟨c, hc, w', hw', hwu, hrw⟩ := h r
  obtain ⟨b1, hb1⟩ := exists_sub_mem_stalkIdeal w hrat hc
  obtain ⟨b2, hb2⟩ := exists_sub_mem_stalkIdeal w hrat hw'
  have e1 : IsLocalRing.residue _ c = IsLocalRing.residue _ (q.stalkMap t b1) := by
    rw [← sub_eq_zero, ← map_sub, IsLocalRing.residue_eq_zero_iff]; exact stalkIdeal_le t hb1
  have e2 : IsLocalRing.residue _ w' = IsLocalRing.residue _ (q.stalkMap t b2) := by
    rw [← sub_eq_zero, ← map_sub, IsLocalRing.residue_eq_zero_iff]; exact stalkIdeal_le t hb2
  have hw0 : IsLocalRing.residue _ w' ≠ 0 := (IsLocalRing.residue_ne_zero_iff_isUnit _).mpr hwu
  have hb2u : IsUnit b2 := by
    rw [e2, IsLocalRing.residue_ne_zero_iff_isUnit] at hw0
    exact isUnit_of_map_unit (q.stalkMap t).hom _ hw0
  obtain ⟨v, rfl⟩ := hb2u
  refine ⟨b1 * ↑v⁻¹, ?_⟩
  rw [← IsLocalRing.residue_eq_zero_iff, map_sub, sub_eq_zero]
  apply mul_right_cancel₀ hw0
  rw [← map_mul, hrw, e1, e2, ← map_mul, ← map_mul, mul_assoc, Units.inv_mul, mul_one]

end MaximalIdeal

/-- **A point on a section is rational.** If `e` is a section of `f` (`e ≫ f = 𝟙`), the point
`e s` is rational over `f (e s)`. -/
theorem rationalOver_of_section {X S : Scheme.{u}} (f : X ⟶ S) (e : S ⟶ X) (he : e ≫ f = 𝟙 S)
    (s : S) : RationalOver f (e s) := by
  intro a
  have hs : f (e s) = s := by rw [← Scheme.Hom.comp_apply, he]; rfl
  refine ⟨(S.presheaf.stalkCongr (.of_eq hs)).inv (e.stalkMap s a), ?_⟩
  have key : e.stalkMap s (f.stalkMap (e s) ((S.presheaf.stalkCongr (.of_eq hs)).inv
      (e.stalkMap s a))) = e.stalkMap s a := by
    have h3 : ∀ y, (S.presheaf.stalkCongr (.of_eq hs)).hom
        ((S.presheaf.stalkCongr (.of_eq hs)).inv y) = y := fun y => Iso.inv_hom_id_apply _ y
    refine (stalkMap_comp_apply' e f s _).symm.trans ?_
    rw [Scheme.Hom.stalkMap_congr_hom (e ≫ f) (𝟙 S) he s, Scheme.Hom.stalkMap_id]
    exact h3 _
  intro hu
  apply hu.map (e.stalkMap s).hom |> fun h' => ?_
  rw [map_sub, key, sub_self] at h'
  exact not_isUnit_zero h'

/-! ### Sections and points with field stalks -/

theorem StalkGen.symm {T X Y : Scheme.{u}} {p : T ⟶ X} {q : T ⟶ Y} {t : T}
    (h : StalkGen p q t) : StalkGen q p t := by
  intro r
  obtain ⟨c, hc, w, hw, hu, h'⟩ := h r
  rw [sup_comm] at hc hw
  exact ⟨c, hc, w, hw, hu, h'⟩

/-- A morphism with a retraction is rational at every point (it is surjective on stalks). -/
theorem rationalOver_of_retraction {X S : Scheme.{u}} (f : X ⟶ S) (r : S ⟶ X)
    (hr : f ≫ r = 𝟙 X) (x : X) : RationalOver f x := by
  intro a
  have hx : r (f x) = x := by rw [← Scheme.Hom.comp_apply, hr]; rfl
  refine ⟨r.stalkMap (f x) ((X.presheaf.stalkCongr (.of_eq hx)).inv a), ?_⟩
  have key : f.stalkMap x (r.stalkMap (f x) ((X.presheaf.stalkCongr (.of_eq hx)).inv a)) = a := by
    have h3 : ∀ y, (X.presheaf.stalkCongr (.of_eq hx)).hom
        ((X.presheaf.stalkCongr (.of_eq hx)).inv y) = y := fun y => Iso.inv_hom_id_apply _ y
    refine (stalkMap_comp_apply' f r x _).symm.trans ?_
    rw [Scheme.Hom.stalkMap_congr_hom (f ≫ r) (𝟙 X) hr x, Scheme.Hom.stalkMap_id]
    exact h3 _
  rw [key, sub_self]
  exact Ideal.zero_mem _

/-- The stalks of the spectrum of a field are fields. -/
theorem maximalIdeal_stalk_spec_field (k : Type u) [Field k] (x : Spec (CommRingCat.of k)) :
    IsLocalRing.maximalIdeal ((Spec (CommRingCat.of k)).presheaf.stalk x) = ⊥ := by
  have h : x = genericPoint (Spec (CommRingCat.of k)) := Subsingleton.elim _ _
  rw [← IsLocalRing.isField_iff_maximalIdeal_eq, h]
  exact Field.toIsField (Spec (CommRingCat.of k)).functionField

theorem mem_maximalIdeal_of_iso {R S : CommRingCat.{u}} [IsLocalRing R] [IsLocalRing S]
    (φ : R ≅ S) {a : R} (ha : a ∈ IsLocalRing.maximalIdeal R) :
    φ.hom a ∈ IsLocalRing.maximalIdeal S := by
  intro hu
  apply ha
  have := hu.map φ.inv.hom
  rwa [Iso.hom_inv_id_apply] at this

/-- In a commutative square `p ≫ f = q ≫ g`, if the stalk of `Y` at `q t` is a field, the
composite `𝒪_{S, f(p t)} → 𝒪_{X, p t} → 𝒪_{T, t}` kills the maximal ideal. -/
theorem stalkMap_comp_eq_zero_of_maximalIdeal_eq_bot {T X Y S : Scheme.{u}} (p : T ⟶ X)
    (q : T ⟶ Y) (f : X ⟶ S) (g : Y ⟶ S) (w : p ≫ f = q ≫ g) (t : T)
    (hY : IsLocalRing.maximalIdeal (Y.presheaf.stalk (q t)) = ⊥)
    (c : S.presheaf.stalk (f (p t))) (hc : c ∈ IsLocalRing.maximalIdeal _) :
    p.stalkMap t (f.stalkMap (p t) c) = 0 := by
  have hpt : (p ≫ f) t = (q ≫ g) t := by rw [w]
  have e : p.stalkMap t (f.stalkMap (p t) c) =
      q.stalkMap t (g.stalkMap (q t) ((S.presheaf.stalkCongr (.of_eq hpt)).hom c)) := by
    calc p.stalkMap t (f.stalkMap (p t) c) = (p ≫ f).stalkMap t c :=
          (stalkMap_comp_apply' p f t c).symm
      _ = (q ≫ g).stalkMap t ((S.presheaf.stalkCongr (.of_eq hpt)).hom c) := by
          rw [Scheme.Hom.stalkMap_congr_hom (p ≫ f) (q ≫ g) w t]; rfl
      _ = _ := stalkMap_comp_apply' q g t _
  have hc' := mem_maximalIdeal_of_iso (S.presheaf.stalkCongr (.of_eq hpt)) hc
  have h0 : g.stalkMap (q t) ((S.presheaf.stalkCongr (.of_eq hpt)).hom c) ∈
      IsLocalRing.maximalIdeal (Y.presheaf.stalk (q t)) := map_nonunit _ _ hc'
  rw [hY, Ideal.mem_bot] at h0
  rw [e, h0, map_zero]

/-- **A section through a point with field stalk is an open immersion.** Let `q : P ⟶ Spec k` be
locally of finite type over a field `k` and `u` a section of `q`. If the stalk of `P` at the
point `u pt` is a field, then `u` is an open immersion. -/
theorem isOpenImmersion_of_section_of_maximalIdeal_eq_bot {k : Type u} [Field k] {P : Scheme.{u}}
    (q : P ⟶ Spec (CommRingCat.of k)) [LocallyOfFiniteType q] (u : Spec (CommRingCat.of k) ⟶ P)
    (hu : u ≫ q = 𝟙 _) (pt : Spec (CommRingCat.of k))
    (hm : IsLocalRing.maximalIdeal (P.presheaf.stalk (u pt)) = ⊥) : IsOpenImmersion u := by
  have hcl : IsClosedImmersion u := isClosedImmersion_of_comp_eq_id q u hu
  have hF : IsField (P.presheaf.stalk (u pt)) := IsLocalRing.isField_iff_maximalIdeal_eq.mpr hm
  have hinj : Function.Injective (u.stalkMap pt).hom := by
    letI := hF.toField
    exact RingHom.injective _
  have hsurj : Function.Surjective (u.stalkMap pt).hom := u.stalkMap_surjective pt
  have hqs : Function.Surjective (q.stalkMap (u pt)).hom := by
    intro y
    have hpt : (u ≫ q) pt = (𝟙 (Spec (CommRingCat.of k))) pt := by rw [hu]
    let c := ((Spec (CommRingCat.of k)).presheaf.stalkCongr (.of_eq hpt)).inv (u.stalkMap pt y)
    have hc : (u ≫ q).stalkMap pt c = u.stalkMap pt y := by
      rw [Scheme.Hom.stalkMap_congr_hom (u ≫ q) (𝟙 _) hu pt, Scheme.Hom.stalkMap_id]
      exact Iso.inv_hom_id_apply ((Spec (CommRingCat.of k)).presheaf.stalkCongr (.of_eq hpt))
        (u.stalkMap pt y)
    refine ⟨c, hinj ?_⟩
    rw [← hc]
    exact (stalkMap_comp_apply' u q pt c).symm
  have hqf : q.QuasiFiniteAt (u pt) :=
    RingHom.QuasiFinite.of_finite (RingHom.Finite.of_surjective _ hqs)
  have h1 : IsOpen {q.asFiber (u pt)} := Scheme.Hom.quasiFiniteAt_iff_isOpen_singleton_asFiber.mp hqf
  have h2 : IsOpen ((q.fiberHomeo (q (u pt))) '' {q.asFiber (u pt)}) :=
    (q.fiberHomeo _).isOpenMap _ h1
  rw [Set.image_singleton, Scheme.Hom.asFiber, Homeomorph.apply_symm_apply] at h2
  have hopen : IsOpen (q.base ⁻¹' {q (u pt)}) := by
    convert isOpen_univ
    ext y
    simp only [Set.mem_preimage, Set.mem_singleton_iff, Set.mem_univ, iff_true]
    exact Subsingleton.elim _ _
  have h3 : IsOpen ({u pt} : Set P) := by
    have := hopen.isOpenMap_subtype_val _ h2
    simpa using this
  have hrange : Set.range u = {u pt} := by
    ext y
    constructor
    · rintro ⟨x, rfl⟩
      rw [Subsingleton.elim x pt]
      rfl
    · rintro rfl
      exact ⟨pt, rfl⟩
  have hemb : Topology.IsOpenEmbedding u :=
    ⟨u.isClosedEmbedding.isEmbedding, by rw [hrange]; exact h3⟩
  haveI : ∀ x, IsIso (u.stalkMap x) := by
    intro x
    obtain rfl : x = pt := Subsingleton.elim x pt
    exact (ConcreteCategory.isIso_iff_bijective _).mpr ⟨hinj, hsurj⟩
  exact IsOpenImmersion.of_isIso_stalkMap u hemb

theorem stalkMap_congr_point_apply {X Y : Scheme.{u}} (f : X ⟶ Y) {x x' : X} (h : x = x')
    (z : Y.presheaf.stalk (f x)) :
    (X.presheaf.stalkCongr (.of_eq h)).hom (f.stalkMap x z) =
      f.stalkMap x' ((Y.presheaf.stalkCongr (.of_eq (congrArg f h))).hom z) :=
  ConcreteCategory.congr_hom (Scheme.Hom.stalkMap_congr_point f x x' h) z

/-! ### Stalk maps between given points -/

/-- The stalk map of `f` from `y` to `x`, for `f x = y`. -/
noncomputable def Scheme.Hom.stalkMapAt {X Y : Scheme.{u}} (f : X ⟶ Y) {x : X} {y : Y}
    (h : f x = y) : Y.presheaf.stalk y ⟶ X.presheaf.stalk x :=
  (Y.presheaf.stalkCongr (.of_eq h.symm)).hom ≫ f.stalkMap x

instance {X Y : Scheme.{u}} (f : X ⟶ Y) {x : X} {y : Y} (h : f x = y) :
    IsLocalHom (f.stalkMapAt h).hom := by
  unfold Scheme.Hom.stalkMapAt
  rw [CommRingCat.hom_comp]
  infer_instance

theorem Scheme.Hom.stalkMapAt_rfl {X Y : Scheme.{u}} (f : X ⟶ Y) (x : X) :
    f.stalkMapAt (rfl : f x = f x) = f.stalkMap x := by
  unfold Scheme.Hom.stalkMapAt
  have : (Y.presheaf.stalkCongr (.of_eq (rfl : f x = f x).symm)).hom = 𝟙 _ :=
    Y.presheaf.stalkSpecializes_refl _
  rw [this, Category.id_comp]

theorem Scheme.Hom.stalkMapAt_comp {X Y Z : Scheme.{u}} (f : X ⟶ Y) (g : Y ⟶ Z) {x : X} {y : Y}
    {z : Z} (hf : f x = y) (hg : g y = z) (hfg : (f ≫ g) x = z) :
    (f ≫ g).stalkMapAt hfg = g.stalkMapAt hg ≫ f.stalkMapAt hf := by
  subst hf hg
  rw [Scheme.Hom.stalkMapAt_rfl, Scheme.Hom.stalkMapAt_rfl]
  unfold Scheme.Hom.stalkMapAt
  have : (Z.presheaf.stalkCongr (.of_eq hfg.symm)).hom = 𝟙 _ :=
    Z.presheaf.stalkSpecializes_refl _
  rw [this]
  exact (Category.id_comp _).trans (Scheme.Hom.stalkMap_comp f g x)

theorem Scheme.Hom.stalkMapAt_congr {X Y : Scheme.{u}} {f g : X ⟶ Y} (e : f = g) {x : X} {y : Y}
    (hf : f x = y) (hg : g x = y) : f.stalkMapAt hf = g.stalkMapAt hg := by
  subst e; rfl

theorem Scheme.Hom.stalkMapAt_id {X : Scheme.{u}} (x : X) (h : (𝟙 X) x = x) :
    Scheme.Hom.stalkMapAt (𝟙 X) h = 𝟙 _ := by
  unfold Scheme.Hom.stalkMapAt
  rw [Scheme.Hom.stalkMap_id]
  exact (Category.comp_id _).trans (X.presheaf.stalkSpecializes_refl _)

theorem Scheme.Hom.map_stalkMapAt_maximalIdeal {X Y : Scheme.{u}} (f : X ⟶ Y) {x : X} {y : Y}
    (h : f x = y) :
    Ideal.map (f.stalkMapAt h).hom (IsLocalRing.maximalIdeal (Y.presheaf.stalk y)) =
      Ideal.map (f.stalkMap x).hom (IsLocalRing.maximalIdeal (Y.presheaf.stalk (f x))) := by
  subst h; rw [Scheme.Hom.stalkMapAt_rfl]

theorem Scheme.Hom.exists_stalkMapAt_eq {X Y : Scheme.{u}} (f : X ⟶ Y) {x : X} {y : Y}
    (h : f x = y) (b : Y.presheaf.stalk (f x)) :
    ∃ c : Y.presheaf.stalk y, f.stalkMapAt h c = f.stalkMap x b := by
  subst h; exact ⟨b, by rw [Scheme.Hom.stalkMapAt_rfl]⟩

end AlgebraicGeometry


namespace IsLocalRing

open Ideal

variable {R O : Type*} [CommRing R] [IsLocalRing R] [CommRing O] [IsLocalRing O]

theorem map_mem_sq_of_le {S T : Type*} [CommRing S] [CommRing T] (φ : S →+* T) {I : Ideal S}
    {J : Ideal T} (h : I.map φ ≤ J) {x : S} (hx : x ∈ I ^ 2) : φ x ∈ J ^ 2 := by
  have h2 : (I ^ 2).map φ ≤ J ^ 2 := by
    rw [pow_two, pow_two, Ideal.map_mul]
    exact Ideal.mul_mono h h
  exact h2 (Ideal.mem_map_of_mem _ hx)

theorem map_maximalIdeal_le_of_local (ψ : R →+* O) [IsLocalHom ψ] :
    (maximalIdeal R).map ψ ≤ maximalIdeal O :=
  Ideal.map_le_iff_le_comap.mpr fun a ha => map_nonunit ψ a ha

/-- Elements of `φ(𝔪_O) 𝒪_R` are congruent mod `𝔪_R²` to an element `φ a`, `a ∈ 𝔪_O`, if the
residue field of `R` is generated by `φ(O)`. -/
theorem exists_sub_mem_sq_of_mem_map (φ : O →+* R) (hle : (maximalIdeal O).map φ ≤ maximalIdeal R)
    (hr : ∀ r : R, ∃ c, r - φ c ∈ maximalIdeal R) {y : R} (hy : y ∈ (maximalIdeal O).map φ) :
    ∃ a ∈ maximalIdeal O, y - φ a ∈ maximalIdeal R ^ 2 := by
  induction hy using Submodule.span_induction with
  | mem z hz =>
    obtain ⟨a, ha, rfl⟩ := hz
    exact ⟨a, ha, by rw [sub_self]; exact Ideal.zero_mem _⟩
  | zero => exact ⟨0, Ideal.zero_mem _, by rw [map_zero, sub_self]; exact Ideal.zero_mem _⟩
  | add y₁ y₂ _ _ h₁ h₂ =>
    obtain ⟨a₁, ha₁, e₁⟩ := h₁
    obtain ⟨a₂, ha₂, e₂⟩ := h₂
    refine ⟨a₁ + a₂, Ideal.add_mem _ ha₁ ha₂, ?_⟩
    have : y₁ + y₂ - φ (a₁ + a₂) = (y₁ - φ a₁) + (y₂ - φ a₂) := by rw [map_add]; ring
    rw [this]
    exact Ideal.add_mem _ e₁ e₂
  | smul r y hy' h =>
    obtain ⟨a, ha, e⟩ := h
    obtain ⟨c, hc⟩ := hr r
    refine ⟨c * a, Ideal.mul_mem_left _ _ ha, ?_⟩
    have : r • y - φ (c * a) = (r - φ c) * y + φ c * (y - φ a) := by
      rw [smul_eq_mul, map_mul]; ring
    rw [this]
    refine Ideal.add_mem _ ?_ (Ideal.mul_mem_left _ _ e)
    rw [pow_two]
    exact Ideal.mul_mem_mul hc (hle hy')

/-- **Cotangent space of a product.** See the module docstring. The two factors may be different
local rings `O₁`, `O₂`. -/
theorem sub_mem_maximalIdeal_sq_of_product {O₁ O₂ : Type*} [CommRing O₁] [IsLocalRing O₁]
    [CommRing O₂] [IsLocalRing O₂] (φ₁ : O₁ →+* R) (φ₂ : O₂ →+* R) (ψ₁ : R →+* O₁)
    (ψ₂ : R →+* O₂) [IsLocalHom ψ₁] [IsLocalHom ψ₂]
    (h₁ : ∀ a, ψ₁ (φ₁ a) = a) (h₂ : ∀ a, ψ₂ (φ₂ a) = a)
    (h₁₂ : ∀ a ∈ maximalIdeal O₂, ψ₁ (φ₂ a) ∈ maximalIdeal O₁ ^ 2)
    (h₂₁ : ∀ a ∈ maximalIdeal O₁, ψ₂ (φ₁ a) ∈ maximalIdeal O₂ ^ 2)
    (hm : maximalIdeal R = (maximalIdeal O₁).map φ₁ ⊔ (maximalIdeal O₂).map φ₂)
    (hr₁ : ∀ r : R, ∃ c, r - φ₁ c ∈ maximalIdeal R)
    (hr₂ : ∀ r : R, ∃ c, r - φ₂ c ∈ maximalIdeal R)
    {x : R} (hx : x ∈ maximalIdeal R) :
    x - φ₁ (ψ₁ x) - φ₂ (ψ₂ x) ∈ maximalIdeal R ^ 2 := by
  have hle₁ : (maximalIdeal O₁).map φ₁ ≤ maximalIdeal R := hm ▸ le_sup_left
  have hle₂ : (maximalIdeal O₂).map φ₂ ≤ maximalIdeal R := hm ▸ le_sup_right
  rw [hm] at hx
  obtain ⟨y, hy, z, hz, rfl⟩ := Submodule.mem_sup.mp hx
  obtain ⟨a, ha, ea⟩ := exists_sub_mem_sq_of_mem_map φ₁ hle₁ hr₁ hy
  obtain ⟨b, hb, eb⟩ := exists_sub_mem_sq_of_mem_map φ₂ hle₂ hr₂ hz
  -- `x ≡ φ₁ a + φ₂ b`
  have ex : y + z - φ₁ a - φ₂ b ∈ maximalIdeal R ^ 2 := by
    have : y + z - φ₁ a - φ₂ b = (y - φ₁ a) + (z - φ₂ b) := by ring
    rw [this]; exact Ideal.add_mem _ ea eb
  have hψ₁ := map_mem_sq_of_le ψ₁ (map_maximalIdeal_le_of_local ψ₁) ex
  have hψ₂ := map_mem_sq_of_le ψ₂ (map_maximalIdeal_le_of_local ψ₂) ex
  rw [map_sub, map_sub, h₁] at hψ₁
  rw [map_sub, map_sub, h₂] at hψ₂
  -- `ψ₁ x - a ∈ 𝔪²` and `ψ₂ x - b ∈ 𝔪²`
  have ea' : ψ₁ (y + z) - a ∈ maximalIdeal O₁ ^ 2 := by
    have : ψ₁ (y + z) - a = (ψ₁ (y + z) - a - ψ₁ (φ₂ b)) + ψ₁ (φ₂ b) := by ring
    rw [this]; exact Ideal.add_mem _ hψ₁ (h₁₂ b hb)
  have eb' : ψ₂ (y + z) - b ∈ maximalIdeal O₂ ^ 2 := by
    have : ψ₂ (y + z) - b = (ψ₂ (y + z) - ψ₂ (φ₁ a) - b) + ψ₂ (φ₁ a) := by ring
    rw [this]; exact Ideal.add_mem _ hψ₂ (h₂₁ a ha)
  have fa := map_mem_sq_of_le φ₁ hle₁ ea'
  have fb := map_mem_sq_of_le φ₂ hle₂ eb'
  rw [map_sub] at fa fb
  have : y + z - φ₁ (ψ₁ (y + z)) - φ₂ (ψ₂ (y + z)) =
      (y + z - φ₁ a - φ₂ b) - (φ₁ (ψ₁ (y + z)) - φ₁ a) - (φ₂ (ψ₂ (y + z)) - φ₂ b) := by ring
  rw [this]
  exact Ideal.sub_mem _ (Ideal.sub_mem _ ex fa) fb

end IsLocalRing



/-! # Cotangent spaces of fibre products (geometric statements) -/

namespace AlgebraicGeometry

open CategoryTheory Limits

universe w

/-- Elements of the maximal ideal act by zero on the cotangent space. -/
theorem smul_cotangentSpace_eq_of_sub_mem {R : Type*} [CommRing R] [IsLocalRing R] {r r' : R}
    (h : r - r' ∈ IsLocalRing.maximalIdeal R) (v : IsLocalRing.CotangentSpace R) :
    r • v = r' • v := by
  obtain ⟨x, rfl⟩ := (IsLocalRing.maximalIdeal R).toCotangent_surjective v
  rw [← sub_eq_zero, ← sub_smul, ← map_smul, Ideal.toCotangent_eq_zero, pow_two]
  exact Ideal.mul_mem_mul h x.2

/-- **Cotangent space of a base change (spanning half).** Let `z ∈ X ×_S Y` with `x = fst z`
rational over `s` and `𝒪_{Y, snd z}` a field (e.g. `Y = Spec L'` for a field extension `L'` of
`κ(s)`). Then `𝔪_z/𝔪_z²` is spanned over `𝒪_z` by the classes of `fst^♯ 𝔪_x`, and every element of
`𝒪_z` acts on it as an element of `𝒪_{Y, snd z}`. -/
theorem cotangent_span_pullback {X Y S : Scheme.{u}} (f : X ⟶ S) (g : Y ⟶ S)
    (z : ↥(pullback f g)) (hrat : RationalOver f (pullback.fst f g z))
    (hY : IsLocalRing.maximalIdeal (Y.presheaf.stalk (pullback.snd f g z)) = ⊥) :
    Submodule.span ((pullback f g).presheaf.stalk z)
      (Set.range fun a : IsLocalRing.maximalIdeal (X.presheaf.stalk (pullback.fst f g z)) =>
        (IsLocalRing.maximalIdeal _).toCotangent
          ⟨(pullback.fst f g).stalkMap z a, map_nonunit _ _ a.2⟩) = ⊤ ∧
    ∀ r : (pullback f g).presheaf.stalk z, ∃ b : Y.presheaf.stalk (pullback.snd f g z),
      ∀ v : IsLocalRing.CotangentSpace ((pullback f g).presheaf.stalk z),
        r • v = (pullback.snd f g).stalkMap z b • v := by
  have hgen := pullback_stalkGen f g z
  have hm := maximalIdeal_eq_of_stalkGen pullback.condition hgen hrat
  dsimp only [stalkIdeal] at hm
  rw [hY, Ideal.map_bot, sup_bot_eq] at hm
  refine ⟨?_, fun r => ?_⟩
  · set N := Submodule.span ((pullback f g).presheaf.stalk z)
      (Set.range fun a : IsLocalRing.maximalIdeal (X.presheaf.stalk (pullback.fst f g z)) =>
        (IsLocalRing.maximalIdeal _).toCotangent
          ⟨(pullback.fst f g).stalkMap z a, map_nonunit _ _ a.2⟩)
    rw [eq_top_iff]
    rintro v -
    obtain ⟨⟨x, hx⟩, rfl⟩ := (IsLocalRing.maximalIdeal _).toCotangent_surjective v
    have hmem : ∀ y, y ∈ Ideal.map ((pullback.fst f g).stalkMap z).hom
        (IsLocalRing.maximalIdeal _) → y ∈ IsLocalRing.maximalIdeal _ := fun y hy => hm ▸ hy
    suffices H : ∀ y (hy : y ∈ Ideal.map ((pullback.fst f g).stalkMap z).hom
        (IsLocalRing.maximalIdeal _)),
        (IsLocalRing.maximalIdeal _).toCotangent ⟨y, hmem y hy⟩ ∈ N from H x (hm ▸ hx)
    intro y hy
    induction hy using Submodule.span_induction with
    | mem w hw =>
      obtain ⟨a, ha, rfl⟩ := hw
      exact Submodule.subset_span ⟨⟨a, ha⟩, rfl⟩
    | zero =>
      have : (⟨0, hmem 0 (Submodule.zero_mem _)⟩ : IsLocalRing.maximalIdeal _) = 0 := rfl
      rw [this, map_zero]; exact N.zero_mem
    | add w w' hw hw' h h' =>
      have : (⟨w + w', hmem _ (Submodule.add_mem _ hw hw')⟩ : IsLocalRing.maximalIdeal _) =
          ⟨w, hmem w hw⟩ + ⟨w', hmem w' hw'⟩ := rfl
      rw [this, map_add]; exact N.add_mem h h'
    | smul c w hw h =>
      have : (⟨c • w, hmem _ (Submodule.smul_mem _ c hw)⟩ : IsLocalRing.maximalIdeal _) =
          c • ⟨w, hmem w hw⟩ := rfl
      rw [this, map_smul]; exact N.smul_mem c h
  · obtain ⟨b, hb⟩ := exists_sub_mem_maximalIdeal_of_stalkGen pullback.condition hgen hrat r
    exact ⟨b, fun v => smul_cotangentSpace_eq_of_sub_mem hb v⟩

section Product

variable {X Y S : Scheme.{u}} (f : X ⟶ S) (g : Y ⟶ S) (eX : S ⟶ X) (eY : S ⟶ Y)
  (hX : eX ≫ f = 𝟙 S) (hY : eY ≫ g = 𝟙 S)

/-- `x ↦ (x, eY (f x))`. -/
noncomputable def incl₁ : X ⟶ pullback f g :=
  pullback.lift (𝟙 X) (f ≫ eY) (by rw [Category.id_comp, Category.assoc, hY, Category.comp_id])

/-- `y ↦ (eX (g y), y)`. -/
noncomputable def incl₂ : Y ⟶ pullback f g :=
  pullback.lift (g ≫ eX) (𝟙 Y) (by rw [Category.id_comp, Category.assoc, hX, Category.comp_id])

/-- The point `(eX s, eY s)`. -/
noncomputable def pairPt (s : S) : ↥(pullback f g) :=
  pullback.lift eX eY (by rw [hX, hY]) s

theorem fst_pairPt (s : S) : pullback.fst f g (pairPt f g eX eY hX hY s) = eX s := by
  rw [pairPt, ← Scheme.Hom.comp_apply, pullback.lift_fst]

theorem snd_pairPt (s : S) : pullback.snd f g (pairPt f g eX eY hX hY s) = eY s := by
  rw [pairPt, ← Scheme.Hom.comp_apply, pullback.lift_snd]

theorem incl₁_apply (s : S) : incl₁ f g eY hY (eX s) = pairPt f g eX eY hX hY s := by
  have e : eX ≫ incl₁ f g eY hY = pullback.lift eX eY (by rw [hX, hY]) := by
    apply pullback.hom_ext
    · simp [incl₁]
    · simp only [incl₁, Category.assoc, pullback.lift_snd]
      rw [← Category.assoc, hX, Category.id_comp]
  rw [← Scheme.Hom.comp_apply, e]
  rfl

theorem incl₂_apply (s : S) : incl₂ f g eX hX (eY s) = pairPt f g eX eY hX hY s := by
  have e : eY ≫ incl₂ f g eX hX = pullback.lift eX eY (by rw [hX, hY]) := by
    apply pullback.hom_ext
    · simp only [incl₂, Category.assoc, pullback.lift_fst]
      rw [← Category.assoc, hY, Category.id_comp]
    · simp [incl₂]
  rw [← Scheme.Hom.comp_apply, e]
  rfl

/-- **Cotangent space of a fibre product at a pair of section points.** Let `eX`, `eY` be sections
of `f : X ⟶ S`, `g : Y ⟶ S` and `s ∈ S` a point whose local ring is a field (e.g. `S = Spec k`,
or the generic point of an integral `S`). At `z = (eX s, eY s)`, with `p₁, p₂` the projections and
`i₁ = (id, eY ∘ f)`, `i₂ = (eX ∘ g, id)`, every `c ∈ 𝔪_z` satisfies
`c ≡ p₁^♯(i₁^♯ c) + p₂^♯(i₂^♯ c) (mod 𝔪_z²)`. Together with `i₁^♯ ∘ p₁^♯ = id`,
`i₂^♯ ∘ p₂^♯ = id` and `i₁^♯ ∘ p₂^♯ = 0 = i₂^♯ ∘ p₁^♯` on `𝔪`, this says
`𝔪_z/𝔪_z² ≅ 𝔪_x/𝔪_x² ⊕ 𝔪_y/𝔪_y²`. -/
theorem sub_mem_sq_pairPt (s : S) (hs : IsLocalRing.maximalIdeal (S.presheaf.stalk s) = ⊥)
    (c : (pullback f g).presheaf.stalk (pairPt f g eX eY hX hY s))
    (hc : c ∈ IsLocalRing.maximalIdeal _) :
    c - ((pullback.fst f g).stalkMapAt (fst_pairPt f g eX eY hX hY s)).hom
          (((incl₁ f g eY hY).stalkMapAt (incl₁_apply f g eX eY hX hY s)).hom c) -
        ((pullback.snd f g).stalkMapAt (snd_pairPt f g eX eY hX hY s)).hom
          (((incl₂ f g eX hX).stalkMapAt (incl₂_apply f g eX eY hX hY s)).hom c) ∈
      IsLocalRing.maximalIdeal _ ^ 2 := by
  set z := pairPt f g eX eY hX hY s
  have hgen := pullback_stalkGen f g z
  have hrat1 : RationalOver f (pullback.fst f g z) := by
    rw [fst_pairPt]; exact rationalOver_of_section f eX hX s
  have hrat2 : RationalOver g (pullback.snd f g z) := by
    rw [snd_pairPt]; exact rationalOver_of_section g eY hY s
  have hw : pullback.fst f g ≫ f = pullback.snd f g ≫ g := pullback.condition
  have hm : IsLocalRing.maximalIdeal ((pullback f g).presheaf.stalk z) =
      (IsLocalRing.maximalIdeal _).map ((pullback.fst f g).stalkMapAt (fst_pairPt f g eX eY hX hY s)).hom ⊔ (IsLocalRing.maximalIdeal _).map ((pullback.snd f g).stalkMapAt (snd_pairPt f g eX eY hX hY s)).hom := by
    refine (maximalIdeal_eq_of_stalkGen hw hgen hrat1).trans ?_
    dsimp only [stalkIdeal]
    rw [Scheme.Hom.map_stalkMapAt_maximalIdeal, Scheme.Hom.map_stalkMapAt_maximalIdeal]
  have hr₂ : ∀ r, ∃ c, r - ((pullback.snd f g).stalkMapAt (snd_pairPt f g eX eY hX hY s)).hom c ∈
      IsLocalRing.maximalIdeal ((pullback f g).presheaf.stalk z) := by
    intro r
    obtain ⟨b, hb⟩ := exists_sub_mem_maximalIdeal_of_stalkGen hw hgen hrat1 r
    obtain ⟨c, hc⟩ := Scheme.Hom.exists_stalkMapAt_eq (pullback.snd f g)
      (snd_pairPt f g eX eY hX hY s) b
    exact ⟨c, by rw [hc]; exact hb⟩
  have hr₁ : ∀ r, ∃ c, r - ((pullback.fst f g).stalkMapAt (fst_pairPt f g eX eY hX hY s)).hom c ∈
      IsLocalRing.maximalIdeal ((pullback f g).presheaf.stalk z) := by
    intro r
    obtain ⟨b, hb⟩ := exists_sub_mem_maximalIdeal_of_stalkGen hw.symm hgen.symm hrat2 r
    obtain ⟨c, hc⟩ := Scheme.Hom.exists_stalkMapAt_eq (pullback.fst f g)
      (fst_pairPt f g eX eY hX hY s) b
    exact ⟨c, by rw [hc]; exact hb⟩
  have e11 : incl₁ f g eY hY ≫ pullback.fst f g = 𝟙 X := pullback.lift_fst _ _ _
  have e22 : incl₂ f g eX hX ≫ pullback.snd f g = 𝟙 Y := pullback.lift_snd _ _ _
  have e12 : incl₁ f g eY hY ≫ pullback.snd f g = f ≫ eY := pullback.lift_snd _ _ _
  have e21 : incl₂ f g eX hX ≫ pullback.fst f g = g ≫ eX := pullback.lift_fst _ _ _
  have hfs : f (eX s) = s := by rw [← Scheme.Hom.comp_apply, hX]; rfl
  have hgs : g (eY s) = s := by rw [← Scheme.Hom.comp_apply, hY]; rfl
  have hcomp : ∀ {A B C : Scheme.{u}} (a : A ⟶ B) (b : B ⟶ C) {p : A} {q : B} {r : C}
      (ha : a p = q) (hb : b q = r) (hab : (a ≫ b) p = r) (t : C.presheaf.stalk r),
      (a.stalkMapAt ha).hom ((b.stalkMapAt hb).hom t) = ((a ≫ b).stalkMapAt hab).hom t := by
    intro A B C a b p q r ha hb hab t
    rw [Scheme.Hom.stalkMapAt_comp a b ha hb hab]
    rfl
  have h₁ : ∀ a, ((incl₁ f g eY hY).stalkMapAt (incl₁_apply f g eX eY hX hY s)).hom (((pullback.fst f g).stalkMapAt (fst_pairPt f g eX eY hX hY s)).hom a) = a := by
    intro a
    have hpt : (incl₁ f g eY hY ≫ pullback.fst f g) (eX s) = eX s := by rw [e11]; rfl
    rw [hcomp (incl₁ f g eY hY) (pullback.fst f g) (incl₁_apply f g eX eY hX hY s)
      (fst_pairPt f g eX eY hX hY s) hpt a,
      Scheme.Hom.stalkMapAt_congr e11 hpt (show (𝟙 X) (eX s) = eX s from rfl),
      Scheme.Hom.stalkMapAt_id]
    rfl
  have h₂ : ∀ a, ((incl₂ f g eX hX).stalkMapAt (incl₂_apply f g eX eY hX hY s)).hom (((pullback.snd f g).stalkMapAt (snd_pairPt f g eX eY hX hY s)).hom a) = a := by
    intro a
    have hpt : (incl₂ f g eX hX ≫ pullback.snd f g) (eY s) = eY s := by rw [e22]; rfl
    rw [hcomp (incl₂ f g eX hX) (pullback.snd f g) (incl₂_apply f g eX eY hX hY s)
      (snd_pairPt f g eX eY hX hY s) hpt a,
      Scheme.Hom.stalkMapAt_congr e22 hpt (show (𝟙 Y) (eY s) = eY s from rfl),
      Scheme.Hom.stalkMapAt_id]
    rfl
  have h₁₂ : ∀ a ∈ IsLocalRing.maximalIdeal (Y.presheaf.stalk (eY s)),
      ((incl₁ f g eY hY).stalkMapAt (incl₁_apply f g eX eY hX hY s)).hom (((pullback.snd f g).stalkMapAt (snd_pairPt f g eX eY hX hY s)).hom a) ∈ IsLocalRing.maximalIdeal (X.presheaf.stalk (eX s)) ^ 2 := by
    intro a ha
    have hpt' : (f ≫ eY) (eX s) = eY s := by rw [Scheme.Hom.comp_apply, hfs]
    have hpt : (incl₁ f g eY hY ≫ pullback.snd f g) (eX s) = eY s := by rw [e12]; exact hpt'
    rw [hcomp (incl₁ f g eY hY) (pullback.snd f g) (incl₁_apply f g eX eY hX hY s)
      (snd_pairPt f g eX eY hX hY s) hpt a, Scheme.Hom.stalkMapAt_congr e12 hpt hpt',
      ← hcomp f eY hfs rfl hpt' a]
    have h0 : (eY.stalkMapAt (rfl : eY s = eY s)).hom a ∈
        IsLocalRing.maximalIdeal (S.presheaf.stalk s) := map_nonunit _ _ ha
    rw [hs, Ideal.mem_bot] at h0
    rw [h0, map_zero]
    exact Ideal.zero_mem _
  have h₂₁ : ∀ a ∈ IsLocalRing.maximalIdeal (X.presheaf.stalk (eX s)),
      ((incl₂ f g eX hX).stalkMapAt (incl₂_apply f g eX eY hX hY s)).hom (((pullback.fst f g).stalkMapAt (fst_pairPt f g eX eY hX hY s)).hom a) ∈ IsLocalRing.maximalIdeal (Y.presheaf.stalk (eY s)) ^ 2 := by
    intro a ha
    have hpt' : (g ≫ eX) (eY s) = eX s := by rw [Scheme.Hom.comp_apply, hgs]
    have hpt : (incl₂ f g eX hX ≫ pullback.fst f g) (eY s) = eX s := by rw [e21]; exact hpt'
    rw [hcomp (incl₂ f g eX hX) (pullback.fst f g) (incl₂_apply f g eX eY hX hY s)
      (fst_pairPt f g eX eY hX hY s) hpt a, Scheme.Hom.stalkMapAt_congr e21 hpt hpt',
      ← hcomp g eX hgs rfl hpt' a]
    have h0 : (eX.stalkMapAt (rfl : eX s = eX s)).hom a ∈
        IsLocalRing.maximalIdeal (S.presheaf.stalk s) := map_nonunit _ _ ha
    rw [hs, Ideal.mem_bot] at h0
    rw [h0, map_zero]
    exact Ideal.zero_mem _
  exact IsLocalRing.sub_mem_maximalIdeal_sq_of_product _ _ _ _ h₁ h₂ h₁₂ h₂₁ hm hr₁ hr₂ hc

end Product

end AlgebraicGeometry



/-! # Local structure of a fibre product at points with values in a field

For `f : X ⟶ Spec R`, `g : Y ⟶ Spec R` and points `p₁ : Spec F ⟶ X`, `p₂ : Spec F ⟶ Y` over
`Spec R` (`F` a field), a regular function on an open of `X ×_R Y` (pulled back along any
`W : X ×_R Y ⟶ P`) is, near `(p₁, p₂)`, a quotient of sums of products of regular functions on
opens `V₁ ∋ p₁`, `V₂ ∋ p₂`, uniformly for all `F`-points of `V₁ × V₂` where the denominator does
not vanish (`exists_localStructure_pullback`). Proof: affine charts `Spec A → X`, `Spec B → Y`,
the open chart `Spec (A ⊗[R] B) → X ×_R Y`, a basic open `D(h)` around the point inside the open,
`s = a / h^n` on `D(h)`, and pure tensors evaluate to products. -/

namespace AlgebraicGeometry

open CategoryTheory Limits TensorProduct

/-- The value `s(p) ∈ F` of a section at an `F`-point (and `0` if `p ∉ V`); the same formula as
`GroupModel.evalAt`. -/
noncomputable def evalPt {F : Type u} [Field F] {X : Scheme.{u}}
    (p : Spec (CommRingCat.of F) ⟶ X) (V : X.Opens) (s : Γ(X, V)) : F := by
  classical
  exact if h : ⊤ ≤ p ⁻¹ᵁ V then (Scheme.ΓSpecIso (CommRingCat.of F)).hom (p.appLE V ⊤ h s) else 0

/-- The section on `j(Spec A)` corresponding to `α ∈ A`, for an open immersion `j`. -/
noncomputable def secOf {X : Scheme.{u}} {A : CommRingCat.{u}} (j : Spec A ⟶ X) [IsOpenImmersion j]
    (α : A) : Γ(X, j ''ᵁ ⊤) :=
  (j.appIso ⊤).inv ((Scheme.ΓSpecIso A).inv α)

theorem appLE_secOf {X : Scheme.{u}} {A : CommRingCat.{u}} (j : Spec A ⟶ X) [IsOpenImmersion j]
    (α : A) (e : ⊤ ≤ j ⁻¹ᵁ (j ''ᵁ ⊤)) :
    j.appLE (j ''ᵁ ⊤) ⊤ e (secOf j α) = (Scheme.ΓSpecIso A).inv α := by
  unfold secOf
  rw [← CommRingCat.comp_apply, Scheme.Hom.appIso_inv_appLE]
  have : (homOfLE (by rwa [Scheme.Hom.preimage_image_eq] at e) :
      (⊤ : (Spec A).Opens) ⟶ ⊤) = 𝟙 _ := Subsingleton.elim _ _
  rw [this, op_id, CategoryTheory.Functor.map_id]
  rfl

theorem ΓSpecIso_hom_appLE_top {R S : CommRingCat.{u}} (φ : R ⟶ S)
    (e : (⊤ : (Spec S).Opens) ≤ Spec.map φ ⁻¹ᵁ ⊤) (x : Γ(Spec R, ⊤)) :
    (Scheme.ΓSpecIso S).hom ((Spec.map φ).appLE ⊤ ⊤ e x) = φ ((Scheme.ΓSpecIso R).hom x) := by
  have h : (Spec.map φ).appLE ⊤ ⊤ e = (Spec.map φ).appTop :=
    (Scheme.Hom.app_eq_appLE (f := Spec.map φ) (U := ⊤)).symm
  rw [h, ← CommRingCat.comp_apply, Scheme.ΓSpecIso_naturality]
  rfl

theorem evalPt_secOf {F : Type u} [Field F] {X : Scheme.{u}} {A : CommRingCat.{u}}
    (j : Spec A ⟶ X) [IsOpenImmersion j] (χ : A ⟶ CommRingCat.of F) (α : A) :
    evalPt (Spec.map χ ≫ j) (j ''ᵁ ⊤) (secOf j α) = χ α := by
  have hle : ⊤ ≤ (Spec.map χ ≫ j) ⁻¹ᵁ (j ''ᵁ ⊤) := by
    intro x _
    exact ⟨Spec.map χ x, trivial, rfl⟩
  unfold evalPt
  rw [dif_pos hle, ← Scheme.Hom.appLE_comp_appLE (Spec.map χ) j (j ''ᵁ ⊤) ⊤ ⊤
    (Scheme.Hom.preimage_image_eq j ⊤).ge (fun _ _ => trivial), CommRingCat.comp_apply,
    appLE_secOf]
  exact (ΓSpecIso_hom_appLE_top χ _ _).trans (by rw [Iso.inv_hom_id_apply])

/-- Every element of `A ⊗[R] B` is a finite sum of pure tensors. -/
theorem exists_fin_sum_tmul {R A B : Type*} [CommRing R] [CommRing A] [CommRing B] [Algebra R A]
    [Algebra R B] (x : A ⊗[R] B) :
    ∃ (n : ℕ) (a : Fin n → A) (b : Fin n → B), x = ∑ k, a k ⊗ₜ[R] b k := by
  induction x using TensorProduct.induction_on with
  | zero => exact ⟨0, Fin.elim0, Fin.elim0, by simp⟩
  | tmul a b => exact ⟨1, fun _ => a, fun _ => b, by simp⟩
  | add x y hx hy =>
    obtain ⟨n, a, b, rfl⟩ := hx
    obtain ⟨m, a', b', rfl⟩ := hy
    refine ⟨n + m, Fin.append a a', Fin.append b b', ?_⟩
    rw [Fin.sum_univ_add]
    simp [Fin.append_left, Fin.append_right]

/-- Two finite families of pure tensors with a common index type. -/
theorem exists_fin_sum_tmul₂ {R A B : Type*} [CommRing R] [CommRing A] [CommRing B] [Algebra R A]
    [Algebra R B] (x y : A ⊗[R] B) :
    ∃ (n : ℕ) (a c : Fin n → A) (b d : Fin n → B),
      x = ∑ k, a k ⊗ₜ[R] b k ∧ y = ∑ k, c k ⊗ₜ[R] d k := by
  obtain ⟨n, a, b, rfl⟩ := exists_fin_sum_tmul x
  obtain ⟨m, c, d, rfl⟩ := exists_fin_sum_tmul y
  refine ⟨n + m, Fin.append a 0, Fin.append 0 c, Fin.append b 0, Fin.append 0 d, ?_, ?_⟩
  · rw [Fin.sum_univ_add]; simp [Fin.append_left, Fin.append_right]
  · rw [Fin.sum_univ_add]; simp [Fin.append_left, Fin.append_right]

/-- An `F`-point lies in the basic open `D(h)` of `Spec T` iff `h` does not vanish at it. -/
theorem SpecMap_mem_basicOpen_iff {F : Type u} [Field F] {T : CommRingCat.{u}}
    (χ : T ⟶ CommRingCat.of F) (h : Γ(Spec T, ⊤)) (x : Spec (CommRingCat.of F)) :
    Spec.map χ x ∈ (Spec T).basicOpen h ↔ χ ((Scheme.ΓSpecIso T).hom h) ≠ 0 := by
  rw [basicOpen_eq_of_affine']
  change x ∈ Spec.map χ ⁻¹ᵁ PrimeSpectrum.basicOpen _ ↔ _
  rw [SpecMap_preimage_basicOpen]
  change χ ((Scheme.ΓSpecIso T).hom h) ∉ x.asIdeal ↔ _
  have hx : x.asIdeal = ⊥ := @Ideal.eq_bot_of_prime _ _ x.asIdeal x.isPrime
  rw [hx, Ideal.mem_bot]

/-- **Points of the product chart.** If `F`-points `p₁'`, `p₂'` lie in the charts `jU`, `jW`,
then `(p₁', p₂')` factors through `Spec (A ⊗[R] B)` via a ring map `χ` with `χ (α ⊗ 1) = p₁'(α)`
and `χ (1 ⊗ β) = p₂'(β)`. -/
theorem exists_chart_point {F : Type u} [Field F] {R A B : CommRingCat.{u}} {X Y : Scheme.{u}}
    (f : X ⟶ Spec R) (g : Y ⟶ Spec R) (jU : Spec A ⟶ X) [IsOpenImmersion jU] (jW : Spec B ⟶ Y)
    [IsOpenImmersion jW] (φ : R ⟶ A) (ψ : R ⟶ B) (eU : Spec.map φ = jU ≫ f)
    (eW : Spec.map ψ = jW ≫ g)
    (p₁' : Spec (CommRingCat.of F) ⟶ X) (p₂' : Spec (CommRingCat.of F) ⟶ Y)
    (hp' : p₁' ≫ f = p₂' ≫ g) (h1' : ⊤ ≤ p₁' ⁻¹ᵁ (jU ''ᵁ ⊤)) (h2' : ⊤ ≤ p₂' ⁻¹ᵁ (jW ''ᵁ ⊤)) :
    letI : Algebra R A := φ.hom.toAlgebra
    letI : Algebra R B := ψ.hom.toAlgebra
    ∃ χ : CommRingCat.of (A ⊗[R] B) ⟶ CommRingCat.of F,
      p₁' = Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.includeLeftRingHom :
          A →+* A ⊗[R] B) ≫ χ) ≫ jU ∧
      p₂' = Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.includeRight :
          B →ₐ[R] A ⊗[R] B).toRingHom ≫ χ) ≫ jW := by
  letI : Algebra R A := φ.hom.toAlgebra
  letI : Algebra R B := ψ.hom.toAlgebra
  have hr1 : Set.range p₁' ⊆ Set.range jU := by
    rintro _ ⟨x, rfl⟩
    obtain ⟨y, -, hy⟩ := h1' (Set.mem_univ x)
    exact ⟨y, hy⟩
  have hr2 : Set.range p₂' ⊆ Set.range jW := by
    rintro _ ⟨x, rfl⟩
    obtain ⟨y, -, hy⟩ := h2' (Set.mem_univ x)
    exact ⟨y, hy⟩
  set l₁ := IsOpenImmersion.lift jU p₁' hr1
  set l₂ := IsOpenImmersion.lift jW p₂' hr2
  have hl₁ : l₁ ≫ jU = p₁' := IsOpenImmersion.lift_fac _ _ _
  have hl₂ : l₂ ≫ jW = p₂' := IsOpenImmersion.lift_fac _ _ _
  set χ₁ := Spec.preimage l₁
  set χ₂ := Spec.preimage l₂
  have hχ₁ : Spec.map χ₁ = l₁ := Spec.map_preimage _
  have hχ₂ : Spec.map χ₂ = l₂ := Spec.map_preimage _
  have hcompat : φ ≫ χ₁ = ψ ≫ χ₂ := by
    apply Spec.map_injective
    rw [Spec.map_comp, Spec.map_comp, hχ₁, hχ₂, eU, eW, ← Category.assoc, ← Category.assoc, hl₁,
      hl₂, hp']
  letI : Algebra R F := (φ ≫ χ₁).hom.toAlgebra
  let χ1a : A →ₐ[R] F := { χ₁.hom with commutes' := fun r => rfl }
  let χ2a : B →ₐ[R] F :=
    { χ₂.hom with
      commutes' := fun r => (congrArg (fun k : R ⟶ CommRingCat.of F => k.hom r) hcompat).symm }
  have hfg : ∀ x y, Commute (χ1a x) (χ2a y) := fun x y => Commute.all _ _
  let χ : CommRingCat.of (A ⊗[R] B) ⟶ CommRingCat.of F :=
    CommRingCat.ofHom (Algebra.TensorProduct.lift χ1a χ2a hfg).toRingHom
  refine ⟨χ, ?_, ?_⟩
  · have : CommRingCat.ofHom (Algebra.TensorProduct.includeLeftRingHom : A →+* A ⊗[R] B) ≫ χ =
        χ₁ := by
      ext a
      change Algebra.TensorProduct.lift χ1a χ2a hfg (a ⊗ₜ[R] 1) = χ₁ a
      rw [Algebra.TensorProduct.lift_tmul, map_one, mul_one]
      rfl
    rw [this, hχ₁, hl₁]
  · have : CommRingCat.ofHom (Algebra.TensorProduct.includeRight :
        B →ₐ[R] A ⊗[R] B).toRingHom ≫ χ = χ₂ := by
      ext b
      change Algebra.TensorProduct.lift χ1a χ2a hfg ((1 : A) ⊗ₜ[R] b) = χ₂ b
      rw [Algebra.TensorProduct.lift_tmul, map_one, one_mul]
      rfl
    rw [this, hχ₂, hl₂]

/-- **Local structure of a fibre product at `F`-points.** See the module docstring. -/
theorem exists_localStructure_pullback {F : Type u} [Field F] {R : CommRingCat.{u}}
    {X Y P : Scheme.{u}} (f : X ⟶ Spec R) (g : Y ⟶ Spec R) (W : pullback f g ⟶ P)
    (U : P.Opens) (s : Γ(P, U)) (p₁ : Spec (CommRingCat.of F) ⟶ X)
    (p₂ : Spec (CommRingCat.of F) ⟶ Y) (hp : p₁ ≫ f = p₂ ≫ g)
    (hU : ⊤ ≤ (pullback.lift p₁ p₂ hp ≫ W) ⁻¹ᵁ U) :
    ∃ (V₁ : X.Opens) (V₂ : Y.Opens) (n : ℕ) (a c : Fin n → Γ(X, V₁)) (b d : Fin n → Γ(Y, V₂)),
      ⊤ ≤ p₁ ⁻¹ᵁ V₁ ∧ ⊤ ≤ p₂ ⁻¹ᵁ V₂ ∧
      (∑ k, evalPt p₁ V₁ (c k) * evalPt p₂ V₂ (d k)) ≠ 0 ∧
      ∀ (p₁' : Spec (CommRingCat.of F) ⟶ X) (p₂' : Spec (CommRingCat.of F) ⟶ Y)
        (hp' : p₁' ≫ f = p₂' ≫ g), ⊤ ≤ p₁' ⁻¹ᵁ V₁ → ⊤ ≤ p₂' ⁻¹ᵁ V₂ →
        (∑ k, evalPt p₁' V₁ (c k) * evalPt p₂' V₂ (d k)) ≠ 0 →
        ⊤ ≤ (pullback.lift p₁' p₂' hp' ≫ W) ⁻¹ᵁ U ∧
        evalPt (pullback.lift p₁' p₂' hp' ≫ W) U s *
            (∑ k, evalPt p₁' V₁ (c k) * evalPt p₂' V₂ (d k)) =
          ∑ k, evalPt p₁' V₁ (a k) * evalPt p₂' V₂ (b k) := by
  classical
  let pt : Spec (CommRingCat.of F) := default
  have hall : ∀ x : Spec (CommRingCat.of F), x = pt := fun x => Subsingleton.elim _ _
  obtain ⟨A, jU, _, φ, hxU, eU⟩ := exists_affine_chart_over f (𝟙 (Spec R)) (p₁ pt) ⟨_, rfl⟩
  obtain ⟨B, jW, _, ψ, hyW, eW⟩ := exists_affine_chart_over g (𝟙 (Spec R)) (p₂ pt) ⟨_, rfl⟩
  have eU' : Spec.map φ = jU ≫ f := by rw [← eU, Category.comp_id]
  have eW' : Spec.map ψ = jW ≫ g := by rw [← eW, Category.comp_id]
  letI : Algebra R A := φ.hom.toAlgebra
  letI : Algebra R B := ψ.hom.toAlgebra
  let m := pullback.map (Spec.map φ) (Spec.map ψ) f g jU jW (𝟙 _) eU eW
  let e := pullbackSpecIso R A B
  let m' : Spec (CommRingCat.of (TensorProduct R A B)) ⟶ pullback f g := e.inv ≫ m
  have h1 : m' ≫ pullback.fst f g = Spec.map (CommRingCat.ofHom
      (Algebra.TensorProduct.includeLeftRingHom : A →+* TensorProduct R A B)) ≫ jU := by
    simp only [m', m, e, Category.assoc, pullback.lift_fst]
    rw [← Category.assoc]
    exact congrArg (· ≫ jU) (pullbackSpecIso_inv_fst R A B)
  have h2 : m' ≫ pullback.snd f g = Spec.map (CommRingCat.ofHom
      (Algebra.TensorProduct.includeRight : B →ₐ[R] TensorProduct R A B).toRingHom) ≫ jW := by
    simp only [m', m, e, Category.assoc, pullback.lift_snd]
    rw [← Category.assoc]
    exact congrArg (· ≫ jW) (pullbackSpecIso_inv_snd R A B)
  have hmi : IsOpenImmersion m' := by infer_instance
  -- the chart point of `(p₁', p₂')`
  have hlift : ∀ (p₁' : Spec (CommRingCat.of F) ⟶ X) (p₂' : Spec (CommRingCat.of F) ⟶ Y)
      (hp' : p₁' ≫ f = p₂' ≫ g), ⊤ ≤ p₁' ⁻¹ᵁ (jU ''ᵁ ⊤) → ⊤ ≤ p₂' ⁻¹ᵁ (jW ''ᵁ ⊤) →
      ∃ χ : CommRingCat.of (A ⊗[R] B) ⟶ CommRingCat.of F,
        pullback.lift p₁' p₂' hp' = Spec.map χ ≫ m' ∧
        (∀ α, evalPt p₁' (jU ''ᵁ ⊤) (secOf jU α) = χ (α ⊗ₜ[R] 1)) ∧
        (∀ β, evalPt p₂' (jW ''ᵁ ⊤) (secOf jW β) = χ ((1 : A) ⊗ₜ[R] β)) := by
    intro p₁' p₂' hp' h1' h2'
    obtain ⟨χ, e1, e2⟩ := exists_chart_point f g jU jW φ ψ eU' eW' p₁' p₂' hp' h1' h2'
    refine ⟨χ, ?_, ?_, ?_⟩
    · apply pullback.hom_ext
      · rw [pullback.lift_fst, Category.assoc, h1, ← Category.assoc, ← Spec.map_comp, e1]
      · rw [pullback.lift_snd, Category.assoc, h2, ← Category.assoc, ← Spec.map_comp, e2]
    · intro α
      rw [e1, evalPt_secOf]
      rfl
    · intro β
      rw [e2, evalPt_secOf]
      rfl
  -- the open, the basic open and the fraction
  let q := pullback.lift p₁ p₂ hp
  have hz : q pt ∈ Set.range m := by
    rw [Scheme.Pullback.range_map]
    refine ⟨?_, ?_⟩
    · show pullback.fst f g (q pt) ∈ Set.range jU
      rw [← Scheme.Hom.comp_apply, pullback.lift_fst]; exact hxU
    · show pullback.snd f g (q pt) ∈ Set.range jW
      rw [← Scheme.Hom.comp_apply, pullback.lift_snd]; exact hyW
  obtain ⟨t0', ht0'⟩ := hz
  let t0 := e.hom t0'
  have hmt0 : m' t0 = q pt := by
    have he : e.inv (e.hom t0') = t0' := by
      rw [← Scheme.Hom.comp_apply, Iso.hom_inv_id]; rfl
    simp only [m', t0]
    rw [Scheme.Hom.comp_apply, he, ht0']
  let U' : (Spec (CommRingCat.of (A ⊗[R] B))).Opens := (m' ≫ W) ⁻¹ᵁ U
  have ht0 : t0 ∈ U' := by
    show (m' ≫ W) t0 ∈ U
    rw [Scheme.Hom.comp_apply, hmt0, ← Scheme.Hom.comp_apply]
    exact hU (Set.mem_univ pt)
  obtain ⟨h, hDU, ht0D⟩ := (isAffineOpen_top (Spec (CommRingCat.of (A ⊗[R] B)))).exists_basicOpen_le
    (⟨t0, ht0⟩ : U') (Set.mem_univ _)
  let s' := (m' ≫ W).appLE U _ hDU s
  haveI := (isAffineOpen_top (Spec (CommRingCat.of (A ⊗[R] B)))).isLocalization_basicOpen h
  obtain ⟨k0, a0, hs'⟩ := IsLocalization.Away.surj h s'
  let h0 := (Scheme.ΓSpecIso (CommRingCat.of (A ⊗[R] B))).hom h
  let a0' := (Scheme.ΓSpecIso (CommRingCat.of (A ⊗[R] B))).hom a0
  obtain ⟨n, a, c, b, d, hN, hH⟩ := exists_fin_sum_tmul₂ (a0' * h0) (h0 ^ (k0 + 1))
  -- evaluation of the sums
  have hsum : ∀ (p₁' : Spec (CommRingCat.of F) ⟶ X) (p₂' : Spec (CommRingCat.of F) ⟶ Y)
      (χ : CommRingCat.of (A ⊗[R] B) ⟶ CommRingCat.of F),
      (∀ α, evalPt p₁' (jU ''ᵁ ⊤) (secOf jU α) = χ (α ⊗ₜ[R] 1)) →
      (∀ β, evalPt p₂' (jW ''ᵁ ⊤) (secOf jW β) = χ ((1 : A) ⊗ₜ[R] β)) →
      (∑ k, evalPt p₁' (jU ''ᵁ ⊤) (secOf jU (c k)) * evalPt p₂' (jW ''ᵁ ⊤) (secOf jW (d k)) =
        χ (h0 ^ (k0 + 1))) ∧
      (∑ k, evalPt p₁' (jU ''ᵁ ⊤) (secOf jU (a k)) * evalPt p₂' (jW ''ᵁ ⊤) (secOf jW (b k)) =
        χ (a0' * h0)) := by
    intro p₁' p₂' χ e1 e2
    constructor
    · rw [hH, map_sum]
      refine Finset.sum_congr rfl fun k _ => ?_
      rw [e1, e2, ← map_mul, Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
    · rw [hN, map_sum]
      refine Finset.sum_congr rfl fun k _ => ?_
      rw [e1, e2, ← map_mul, Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
  -- evaluation of `s` at a chart point in `D(h)`
  have hval : ∀ χ : CommRingCat.of (A ⊗[R] B) ⟶ CommRingCat.of F, χ h0 ≠ 0 →
      ⊤ ≤ (Spec.map χ ≫ m' ≫ W) ⁻¹ᵁ U ∧
      evalPt (Spec.map χ ≫ m' ≫ W) U s * χ (h0 ^ (k0 + 1)) = χ (a0' * h0) := by
    intro χ hχ
    have hD : ⊤ ≤ Spec.map χ ⁻¹ᵁ (Spec (CommRingCat.of (A ⊗[R] B))).basicOpen h := by
      intro x _
      exact (SpecMap_mem_basicOpen_iff χ h x).mpr hχ
    have hT : ⊤ ≤ (Spec.map χ ≫ m' ≫ W) ⁻¹ᵁ U := fun x hx => hDU (hD hx)
    refine ⟨hT, ?_⟩
    unfold evalPt
    rw [dif_pos hT]
    rw [← Scheme.Hom.appLE_comp_appLE (Spec.map χ) (m' ≫ W) U _ ⊤ hDU hD]
    let ev : Γ(Spec (CommRingCat.of (A ⊗[R] B)), (Spec (CommRingCat.of (A ⊗[R] B))).basicOpen h)
        →+* F := (Scheme.ΓSpecIso (CommRingCat.of F)).hom.hom.comp
        ((Spec.map χ).appLE _ ⊤ hD).hom
    have hev : ∀ x : Γ(Spec (CommRingCat.of (A ⊗[R] B)), ⊤),
        ev (algebraMap _ _ x) = χ ((Scheme.ΓSpecIso _).hom x) := by
      intro x
      change (Scheme.ΓSpecIso (CommRingCat.of F)).hom (((Spec (CommRingCat.of (A ⊗[R] B))).presheaf.map
        (homOfLE ((Spec (CommRingCat.of (A ⊗[R] B))).basicOpen_le h)).op ≫
          (Spec.map χ).appLE _ ⊤ hD) x) = _
      rw [Scheme.Hom.map_appLE]
      exact ΓSpecIso_hom_appLE_top χ _ x
    have key := congrArg ev hs'
    rw [map_mul, map_pow, hev, hev] at key
    change ev s' * χ (h0 ^ (k0 + 1)) = χ (a0' * h0)
    rw [map_pow, pow_succ, ← mul_assoc, key, map_mul]
  refine ⟨jU ''ᵁ ⊤, jW ''ᵁ ⊤, n, fun k => secOf jU (a k), fun k => secOf jU (c k),
    fun k => secOf jW (b k), fun k => secOf jW (d k), ?_, ?_, ?_, ?_⟩
  · intro x _
    rw [hall x]
    obtain ⟨y, hy⟩ := hxU
    exact ⟨y, trivial, hy⟩
  · intro x _
    rw [hall x]
    obtain ⟨y, hy⟩ := hyW
    exact ⟨y, trivial, hy⟩
  · have h1p : ⊤ ≤ p₁ ⁻¹ᵁ (jU ''ᵁ ⊤) := by
      intro x _; rw [hall x]; obtain ⟨y, hy⟩ := hxU; exact ⟨y, trivial, hy⟩
    have h2p : ⊤ ≤ p₂ ⁻¹ᵁ (jW ''ᵁ ⊤) := by
      intro x _; rw [hall x]; obtain ⟨y, hy⟩ := hyW; exact ⟨y, trivial, hy⟩
    obtain ⟨χ, hq, e1, e2⟩ := hlift p₁ p₂ hp h1p h2p
    rw [(hsum p₁ p₂ χ e1 e2).1, map_pow]
    refine pow_ne_zero _ ?_
    rw [← SpecMap_mem_basicOpen_iff χ h pt]
    have : Spec.map χ pt = t0 := by
      apply m'.isOpenEmbedding.injective
      rw [hmt0, ← Scheme.Hom.comp_apply, ← hq]
    rw [this]
    exact ht0D
  · intro p₁' p₂' hp' h1' h2' hne
    obtain ⟨χ, hq, e1, e2⟩ := hlift p₁' p₂' hp' h1' h2'
    obtain ⟨hs1, hs2⟩ := hsum p₁' p₂' χ e1 e2
    rw [hs1] at hne ⊢
    rw [hs2]
    have hχ : χ h0 ≠ 0 := by
      intro h0z
      apply hne
      rw [map_pow, h0z, zero_pow (Nat.succ_ne_zero _)]
    obtain ⟨hT, hv⟩ := hval χ hχ
    rw [hq, Category.assoc]
    exact ⟨hT, hv⟩

end AlgebraicGeometry




/-! # Exterior powers commute with passage to the fraction field (Mathlib-only)

Task hodge-bc2 (used by `HodgeBCInjective`, scratch/hodge-bc2/; same text as
scratch/hodge-bc2/ExtFrac.lean).

For a domain `R` with fraction field `K` and an `R`-module `M` that is a `K`-vector space
(compatibly), `K ⊗_R ⋀^n_R M ≅ ⋀^n_K M` (`extFracEquiv`), `1 ⊗ ιMulti_R v ↔ ιMulti_K v`.
Hence a `K`-basis `b` of `M` gives the `K`-basis `1 ⊗ ιMulti_family R n b` of `K ⊗_R ⋀^n_R M`
(`extFracBasis`). -/

namespace ZInQ.HodgeBC2

open TensorProduct

variable {R K M : Type*} [CommRing R] [IsDomain R] [Field K] [Algebra R K] [IsFractionRing R K]
  [AddCommGroup M] [Module R M] [Module K M] [IsScalarTower R K M] (n : ℕ)

/-- `v ↦ 1 ⊗ ιMulti_R v`, `R`-multilinear. -/
noncomputable def extFracAltR : M [⋀^Fin n]→ₗ[R] K ⊗[R] ⋀[R]^n M :=
  (TensorProduct.mk R K (⋀[R]^n M) 1).compAlternatingMap (exteriorPower.ιMulti R n)

omit [IsDomain R] [IsFractionRing R K] [Module K M] [IsScalarTower R K M] in
theorem extFracAltR_apply (v : Fin n → M) :
    extFracAltR (K := K) n v = (1 : K) ⊗ₜ[R] exteriorPower.ιMulti R n v := rfl

include R in
/-- `K`-homogeneity of an `R`-linear map into a `K`-module, from that of its restriction to `R`. -/
theorem smul_eq_of_frac {N P : Type*} [AddCommGroup N] [Module R N] [Module K N]
    [IsScalarTower R K N] [AddCommGroup P] [Module R P] [Module K P] [IsScalarTower R K P]
    (F : N → P) (hF : ∀ (r : R) x, F (r • x) = r • F x) (c : K) (x : N) :
    F (c • x) = c • F x := by
  obtain ⟨⟨a, s⟩, rfl⟩ := IsLocalization.mk'_surjective (nonZeroDivisors R) c
  have hs : (algebraMap R K (s : R)) ≠ 0 :=
    IsFractionRing.to_map_ne_zero_of_mem_nonZeroDivisors s.2
  have key : (s : R) • F (IsLocalization.mk' K a s • x) = (a : R) • F x := by
    rw [← hF, ← algebraMap_smul K, smul_smul, IsLocalization.mk'_spec', algebraMap_smul, hF]
  have key' : algebraMap R K (s : R) • F (IsLocalization.mk' K a s • x) =
      algebraMap R K (s : R) • (IsLocalization.mk' K a s • F x) := by
    rw [algebraMap_smul, key, smul_smul, IsLocalization.mk'_spec', algebraMap_smul]
  exact smul_right_injective P hs key'

/-- `v ↦ 1 ⊗ ιMulti_R v` is `K`-multilinear. -/
noncomputable def extFracAlt : M [⋀^Fin n]→ₗ[K] K ⊗[R] ⋀[R]^n M where
  toFun v := (1 : K) ⊗ₜ[R] exteriorPower.ιMulti R n v
  map_update_add' v i x y := (extFracAltR (K := K) n).map_update_add v i x y
  map_update_smul' v i c x := by
    classical
    have := smul_eq_of_frac (R := R) (K := K)
      (fun y : M => (1 : K) ⊗ₜ[R] exteriorPower.ιMulti R n (Function.update v i y))
      (fun r y => (extFracAltR (K := K) n).map_update_smul v i r y) c x
    convert this using 2
  map_eq_zero_of_eq' v i j h hij := (extFracAltR (K := K) n).map_eq_zero_of_eq v h hij

/-- `⋀^n_K M → K ⊗_R ⋀^n_R M`. -/
noncomputable def extFracTo : ⋀[K]^n M →ₗ[K] K ⊗[R] ⋀[R]^n M :=
  exteriorPower.alternatingMapLinearEquiv (extFracAlt (R := R) n)

theorem extFracTo_ιMulti (v : Fin n → M) :
    extFracTo (R := R) (K := K) n (exteriorPower.ιMulti K n v) =
      (1 : K) ⊗ₜ[R] exteriorPower.ιMulti R n v :=
  exteriorPower.alternatingMapLinearEquiv_apply_ιMulti _ v

/-- `⋀^n_R M → ⋀^n_K M`, induced by `ιMulti_K`. -/
noncomputable def extFracJ : ⋀[R]^n M →ₗ[R] ⋀[K]^n M :=
  exteriorPower.alternatingMapLinearEquiv
    { ((exteriorPower.ιMulti K n (M := M)).toMultilinearMap.restrictScalars R) with
      map_eq_zero_of_eq' := fun v _ _ h hij => (exteriorPower.ιMulti K n).map_eq_zero_of_eq v h hij }

/-- `K ⊗_R ⋀^n_R M → ⋀^n_K M`. -/
noncomputable def extFracFrom : K ⊗[R] ⋀[R]^n M →ₗ[K] ⋀[K]^n M :=
  (extFracJ (R := R) (K := K) n).liftBaseChange K

theorem extFracFrom_tmul (c : K) (v : Fin n → M) :
    extFracFrom (R := R) (K := K) n (c ⊗ₜ[R] exteriorPower.ιMulti R n v) =
      c • exteriorPower.ιMulti K n v := by
  rw [extFracFrom, LinearMap.liftBaseChange_tmul]
  congr 1
  exact exteriorPower.alternatingMapLinearEquiv_apply_ιMulti _ v

/-- **`K ⊗_R ⋀^n_R M ≅ ⋀^n_K M`.** -/
noncomputable def extFracEquiv : ⋀[K]^n M ≃ₗ[K] K ⊗[R] ⋀[R]^n M :=
  LinearEquiv.ofLinearMap (extFracTo (R := R) n) (extFracFrom (R := R) n)
    (by
      apply TensorProduct.AlgebraTensorModule.curry_injective
      apply LinearMap.ext_ring
      apply exteriorPower.linearMap_ext
      ext v
      simp only [AlternatingMap.compLinearMap_apply, LinearMap.compAlternatingMap_apply,
        TensorProduct.AlgebraTensorModule.curry_apply, LinearMap.coe_comp,
        Function.comp_apply, LinearMap.restrictScalars_apply, LinearMap.id_apply,
        TensorProduct.curry_apply]
      rw [extFracFrom_tmul, one_smul, extFracTo_ιMulti])
    (by
      apply exteriorPower.linearMap_ext
      ext v
      simp only [LinearMap.compAlternatingMap_apply, LinearMap.coe_comp, Function.comp_apply,
        LinearMap.id_apply]
      rw [extFracTo_ιMulti, extFracFrom_tmul, one_smul])

theorem extFracEquiv_ιMulti (v : Fin n → M) :
    extFracEquiv (R := R) (K := K) n (exteriorPower.ιMulti K n v) =
      (1 : K) ⊗ₜ[R] exteriorPower.ιMulti R n v :=
  extFracTo_ιMulti n v

/-- **The basis `1 ⊗ ιMulti_family R n b` of `K ⊗_R ⋀^n_R M`** for a `K`-basis `b` of `M`. -/
noncomputable def extFracBasis {I : Type*} [LinearOrder I] (b : Module.Basis I K M) :
    Module.Basis (Set.powersetCard I n) K (K ⊗[R] ⋀[R]^n M) :=
  (b.exteriorPower n).map (extFracEquiv (R := R) n)

theorem extFracBasis_apply {I : Type*} [LinearOrder I] (b : Module.Basis I K M)
    (s : Set.powersetCard I n) :
    extFracBasis (R := R) n b s = (1 : K) ⊗ₜ[R] exteriorPower.ιMulti_family R n b s := by
  rw [extFracBasis, Module.Basis.map_apply, exteriorPower.basis_apply]
  exact extFracEquiv_ιMulti n _

end ZInQ.HodgeBC2



/-! # product-height: the glue Prop `ProductModelHeight` (P2)

Task product-height. Imports only the kernel module `ZInQKernel.HDecomp.Faltings.H5Neron`
(no scratch import). No `sorry`, no `axiom`. See `docs/research/product-height.md`.

Contents.
* §0 A verbatim copy of `ProductModelHeight` (from `scratch/h5-neron/H5Neron.lean`, identical to
  `scratch/h5-glue/H5Final.lean` and to the kernel's `ZInQ.H5Neron.ProductModelHeight`) with the
  definitions it uses, and `copy_iff : Copy.ProductModelHeight ↔ H5Neron.ProductModelHeight`
  (`Iff.rfl`), so that everything below is about the same Prop.
* §1 Route S (new, no `AnalyticUniformizationUnique`): `ProductModelHeight` from one glue Prop
  `ProductMetrizationSplit` (every metrization of a product model splits into metrizations of the
  factors whose heights add up to at most its height).
* §2 Route U (g0-heightadd's reduction, ported to the kernel's types): `ProductModelHeight` from
  `AnalyticUniformizationUnique`, `MetrizationDimUnique`, `MetrizationExists`,
  `ProductMetrizationGeo`; and the sharper form with the single Prop `MetrizationHeightUnique`
  in place of the first two.
* §3 Route U implies route S (`productMetrizationSplit_of`): the two routes are consistent, and S
  is no stronger than the inputs of U.
* §4 What `ProductModelHeight` forces: `metrizable_left/right_of_productModelHeight`,
  `analyticUnif_left_of_productModelHeight` (a metrization of the product forces metrizations,
  hence uniformizations, of the factors) and `le_of_productModelHeight`.
* §5 Complex points of a product model (`ptsEquiv`) and the product uniformization (`prodUnif`,
  algebraic clauses proved; analytic clauses = glue `ProductUnifAnalytic`).
* §6 **Main result.** `productModelHeight_of_splits : ProductUnifSplits →
  ProductMetrizationOfProductUnif → ProductModelHeight`. Neither glue Prop involves AN3: the first
  splits the product's *own* uniformization by elementary analysis, the second is Hodge theory
  with the uniformizations given. The change of coordinates (`recoordM`) is proved.

Correction (run 1). An earlier version of this header and of §4 claimed that P2 needs analytic
input of AN3 type. An independent model review refuted this (log). The splitting is elementary
(§6), and the §4 lemmas show only that P2 forces descent of uniformizations to the factors, which
§6's `ProductUnifSplits` provides without AN3. -/

namespace ZInQ.ProductHeight

open CategoryTheory AlgebraicGeometry Limits MonoidalCategory CartesianMonoidalCategory MonObj
open NumberField MeasureTheory DefFaltings
open PkgI3 (AbVar)

/-! ## §0. Verbatim copy (from `scratch/h5-neron/H5Neron.lean`) -/

namespace Copy

section General

variable {S S' : Scheme.{0}} (j : S' ⟶ S) (P : Over S → Prop)

variable {j P}

/-- The identification of the generic fibre of `N₁ ⊗ N₂` with `A₁ ⊗ A₂`. -/
noncomputable def tensorGen {N₁ N₂ : Over S} {A₁ A₂ : Over S'}
    (e₁ : (Over.pullback j).obj N₁ ≅ A₁) (e₂ : (Over.pullback j).obj N₂ ≅ A₂) :
    (Over.pullback j).obj (N₁ ⊗ N₂) ≅ A₁ ⊗ A₂ :=
  prodComparisonIso (Over.pullback j) N₁ N₂ ≪≫ tensorIso e₁ e₂

end General

/-- `Spec L → Spec 𝓞_L`. -/
noncomputable abbrev jL (L : Type) [Field L] [NumberField L] :
    Spec (CommRingCat.of L) ⟶ Spec (CommRingCat.of (𝓞 L)) :=
  Spec.map (CommRingCat.ofHom (algebraMap (𝓞 L) L))

variable {K : Type} [Field K]

/-- `C_L ≅ A_L ⊗ B_L`. -/
noncomputable def bcProd {A B C : AbVar K} (L : Type) [Field L] [Algebra K L]
    (eC : C.X ≅ A.X ⊗ B.X) : (C.baseChange L).X ≅ (A.baseChange L).X ⊗ (B.baseChange L).X :=
  (Over.pullback (Spec.map (CommRingCat.ofHom (algebraMap K L)))).mapIso eC ≪≫
    prodComparisonIso (Over.pullback (Spec.map (CommRingCat.ofHom (algebraMap K L)))) A.X B.X

/-- `𝒢P ≅ 𝒢₁ × 𝒢₂` as group models of `C_L ≅ A_L × B_L`. -/
def IsProductModel {A B C : AbVar K} {L : Type} [Field L] [NumberField L] [Algebra K L]
    (eC : C.X ≅ A.X ⊗ B.X) (𝒢P : GroupModel C L) (𝒢₁ : GroupModel A L) (𝒢₂ : GroupModel B L) :
    Prop :=
  ∃ e : 𝒢P.G ≅ 𝒢₁.G ⊗ 𝒢₂.G, IsMonHom (e.hom ≫ fst _ _) ∧ IsMonHom (e.hom ≫ snd _ _) ∧
    (Over.pullback (jL L)).map e.hom ≫ (tensorGen 𝒢₁.gen 𝒢₂.gen).hom =
      𝒢P.gen.hom ≫ (bcProd L eC).hom

/-- **Glue P2** (the direction used). The height of a product model is at least the sum of the
heights: `ω_{𝒢₁×𝒢₂} = ω_{𝒢₁} ⊕ ω_{𝒢₂}`, `det(ω₁ ⊕ ω₂) = det ω₁ ⊗ det ω₂`, the Arakelov degree is
additive, and a product of uniformizations is a uniformization of the product (equality holds). -/
def ProductModelHeight : Prop :=
  ∀ (K : Type) [Field K] (A B C : AbVar K) (eC : C.X ≅ A.X ⊗ B.X) (L : Type) [Field L]
    [NumberField L] [Algebra K L] (𝒢P : GroupModel C L) (𝒢₁ : GroupModel A L)
    (𝒢₂ : GroupModel B L), IsProductModel eC 𝒢P 𝒢₁ 𝒢₂ → 𝒢₁.height + 𝒢₂.height ≤ 𝒢P.height

end Copy

/-- The copy is the kernel's Prop (definitional equality). -/
theorem copy_iff : Copy.ProductModelHeight ↔ H5Neron.ProductModelHeight := Iff.rfl

open H5Neron

/-! ## Basic facts about `GroupModel.height` -/

section Basic

variable {K : Type} [Field K] {A : AbVar K} {L : Type} [Field L] [NumberField L] [Algebra K L]

/-- A metrization bounds the height of its model from above. -/
theorem height_le_of_model {g : ℕ} (M : MetrizedModel A L g) {𝒢 : GroupModel A L}
    (h : M.model = 𝒢) : 𝒢.height ≤ (M.hodge.modelHeight : EReal) :=
  iInf_le_of_le g (iInf_le_of_le M (iInf_le_of_le h le_rfl))

/-- A group model without metrization has height `⊤`. -/
theorem height_eq_top_of_not_metrizable {𝒢 : GroupModel A L}
    (h : ¬ ∃ (g : ℕ) (M : MetrizedModel A L g), M.model = 𝒢) : 𝒢.height = ⊤ := by
  refine eq_top_iff.mpr (le_iInf fun g => le_iInf fun M => le_iInf fun hM => ?_)
  exact absurd ⟨g, M, hM⟩ h

/-- A metrizable group model has height `< ⊤`. -/
theorem height_ne_top_of_model {g : ℕ} (M : MetrizedModel A L g) {𝒢 : GroupModel A L}
    (h : M.model = 𝒢) : 𝒢.height ≠ ⊤ :=
  ne_top_of_le_ne_top (EReal.coe_ne_top _) (height_le_of_model M h)

end Basic

/-! ## §1. Route S: `ProductModelHeight` from the splitting of metrizations (no AN3) -/

/-- **Glue S (splitting of a metrization of a product model).** If `𝒢P ≅ 𝒢₁ × 𝒢₂`
(`IsProductModel`), then every metrization `MP` of `𝒢P` (of any dimension `g`) yields metrizations
`M₁` of `𝒢₁` and `M₂` of `𝒢₂` with `h(M₁) + h(M₂) ≤ h(MP)`.

Why true (STANDARD; elementary analysis, no AN3; reduced in §6 to `ProductUnifSplits` and
`ProductMetrizationOfProductUnif`): a holomorphic surjective homomorphism
`Φ : ℂ^g → 𝒢₁(ℂ)_τ × 𝒢₂(ℂ)_τ` with lattice kernel splits, after a `ℂ`-linear change of
coordinates `T`, as `Φ₁ × Φ₂` (restrict `Φ` to the identity components of `ker(p₂ ∘ Φ)` and
`ker(p₁ ∘ Φ)`, which are complementary complex subspaces). Then `g = g₁ + g₂`,
`⋀^{g}ω_{𝒢P} = ⋀^{g₁}ω_{𝒢₁} ⊗ ⋀^{g₂}ω_{𝒢₂}`, the Jacobian is block diagonal and
`covol(Λ₁ × Λ₂) = covol Λ₁ · covol Λ₂`, so equality holds (`modelHeight_add_of`). The
algebraic half is the same as in `ProductMetrizationGeo`. Unproved. -/
def ProductMetrizationSplit : Prop :=
  ∀ (K : Type) [Field K] (A B C : AbVar K) (eC : C.X ≅ A.X ⊗ B.X) (L : Type) [Field L]
    [NumberField L] [Algebra K L] (𝒢P : GroupModel C L) (𝒢₁ : GroupModel A L)
    (𝒢₂ : GroupModel B L), IsProductModel eC 𝒢P 𝒢₁ 𝒢₂ →
    ∀ (g : ℕ) (MP : MetrizedModel C L g), MP.model = 𝒢P →
      ∃ (g₁ g₂ : ℕ) (M₁ : MetrizedModel A L g₁) (M₂ : MetrizedModel B L g₂),
        M₁.model = 𝒢₁ ∧ M₂.model = 𝒢₂ ∧
        M₁.hodge.modelHeight + M₂.hodge.modelHeight ≤ MP.hodge.modelHeight

/-- **`ProductModelHeight` from `ProductMetrizationSplit` alone (proved).** No uniqueness of
uniformizations, no existence of metrizations and no dimension statement is used. -/
theorem productModelHeight_of_split (h : ProductMetrizationSplit) : ProductModelHeight := by
  intro K _ A B C eC L _ _ _ 𝒢P 𝒢₁ 𝒢₂ hPM
  refine le_iInf fun g => le_iInf fun MP => le_iInf fun hMP => ?_
  obtain ⟨g₁, g₂, M₁, M₂, h₁, h₂, hle⟩ := h K A B C eC L 𝒢P 𝒢₁ 𝒢₂ hPM g MP hMP
  calc 𝒢₁.height + 𝒢₂.height
      ≤ (M₁.hodge.modelHeight : EReal) + (M₂.hodge.modelHeight : EReal) :=
        add_le_add (height_le_of_model M₁ h₁) (height_le_of_model M₂ h₂)
    _ = ((M₁.hodge.modelHeight + M₂.hodge.modelHeight : ℝ) : EReal) := (EReal.coe_add _ _).symm
    _ ≤ (MP.hodge.modelHeight : EReal) := EReal.coe_le_coe_iff.mpr hle

/-! ## §2. Route U (g0-heightadd's reduction, on the kernel's types)

The four Props `ProductMetrization`, `MetrizationExists`, `MetrizationDimUnique`,
`ProductMetrizationGeo` and the lemmas `modelHeight_add_of`, `productModelHeight_of`,
`productMetrization_of_geo` are copied from `scratch/g0-heightadd/part_heightadd.lean` and
`part_prod.lean` (there over the def-faltings copy `Prefix.lean`); here they are over the kernel's
`PkgI3.AbVar`, `DefFaltings.GroupModel` and `H5Neron.IsProductModel`. Statements unchanged. -/

/-- **Glue P2a (product of metrized models).** If `𝒢P ≅ 𝒢₁ × 𝒢₂` (`IsProductModel`) and `M₁`, `M₂`
are metrizations of `𝒢₁`, `𝒢₂` of dimensions `g₁`, `g₂`, then `𝒢P` has a metrization of
dimension `g₁ + g₂` whose model height is the sum. (Copied from g0-heightadd; STANDARD, unproved:
`ω_{𝒢P} = ω₁ ⊕ ω₂`, `Φ₁ × Φ₂` is a uniformization with lattice `Λ₁ × Λ₂`.) -/
def ProductMetrization : Prop :=
  ∀ (K : Type) [Field K] (A B C : AbVar K) (eC : C.X ≅ A.X ⊗ B.X) (L : Type) [Field L]
    [NumberField L] [Algebra K L] (𝒢P : GroupModel C L) (𝒢₁ : GroupModel A L)
    (𝒢₂ : GroupModel B L), IsProductModel eC 𝒢P 𝒢₁ 𝒢₂ →
    ∀ (g₁ g₂ : ℕ) (M₁ : MetrizedModel A L g₁) (M₂ : MetrizedModel B L g₂),
      M₁.model = 𝒢₁ → M₂.model = 𝒢₂ →
      ∃ MP : MetrizedModel C L (g₁ + g₂), MP.model = 𝒢P ∧
        MP.hodge.modelHeight = M₁.hodge.modelHeight + M₂.hodge.modelHeight

/-- **Glue (existence of metrizations; correctness of def-faltings' definition).** Every smooth
group model `𝒢` of `A_L` carries a metrization (copied from g0-heightadd; from
`HodgeLatticeTheorem` and `AnalyticUniformizationExists`, AN3-existence; unproved). -/
def MetrizationExists : Prop :=
  ∀ (K : Type) [Field K] (A : AbVar K) (L : Type) [Field L] [NumberField L] [Algebra K L]
    (𝒢 : GroupModel A L), ∃ (g : ℕ) (M : MetrizedModel A L g), M.model = 𝒢

/-- **Glue (the dimension of a metrization).** Two metrizations of the same group model have
the same dimension (copied from g0-heightadd; both equal `dim A`; unproved). -/
def MetrizationDimUnique : Prop :=
  ∀ (K : Type) [Field K] (A : AbVar K) (L : Type) [Field L] [NumberField L] [Algebra K L]
    (g g' : ℕ) (M : MetrizedModel A L g) (M' : MetrizedModel A L g'), M.model = M'.model → g = g'

/-- **Glue H (new; what U and `MetrizationDimUnique` are used for).** Two metrizations of the
same group model (of any dimensions) have the same model height: the height of a group model
does not depend on the choice of analytic uniformization. Follows from
`AnalyticUniformizationUnique` and `MetrizationDimUnique` (`metrizationHeightUnique_of`). -/
def MetrizationHeightUnique : Prop :=
  ∀ (K : Type) [Field K] (A : AbVar K) (L : Type) [Field L] [NumberField L] [Algebra K L]
    (g g' : ℕ) (M : MetrizedModel A L g) (M' : MetrizedModel A L g'), M.model = M'.model →
      M.hodge.modelHeight = M'.hodge.modelHeight

/-- `MetrizationHeightUnique` from U and `MetrizationDimUnique` (proved). -/
theorem metrizationHeightUnique_of (hU : AnalyticUniformizationUnique)
    (hD : MetrizationDimUnique) : MetrizationHeightUnique := by
  intro K _ A L _ _ _ g g' M M' h
  obtain rfl := hD K A L g g' M M' h
  exact MetrizedModel.modelHeight_eq_of_model_eq hU M M' h

section HeightOf

variable {K : Type} [Field K] {A : AbVar K} {L : Type} [Field L] [NumberField L] [Algebra K L]

/-- Under `MetrizationHeightUnique`, a metrization computes the height of its model. -/
theorem height_eq_of_model (hH : MetrizationHeightUnique) {g : ℕ} (M : MetrizedModel A L g)
    {𝒢 : GroupModel A L} (h : M.model = 𝒢) : 𝒢.height = (M.hodge.modelHeight : EReal) := by
  refine le_antisymm (height_le_of_model M h) ?_
  refine le_iInf fun g' => le_iInf fun M' => le_iInf fun hM' => ?_
  rw [hH K A L g g' M M' (h.trans hM'.symm)]

/-- Given AN3-uniqueness and `MetrizationDimUnique`, a metrization computes the height of its
model from below (g0-heightadd's lemma). -/
theorem le_height_of_model (hU : AnalyticUniformizationUnique) (hD : MetrizationDimUnique)
    {g : ℕ} (M : MetrizedModel A L g) {𝒢 : GroupModel A L} (h : M.model = 𝒢) :
    (M.hodge.modelHeight : EReal) ≤ 𝒢.height :=
  (height_eq_of_model (metrizationHeightUnique_of hU hD) M h).ge

end HeightOf

/-- **`ProductModelHeight` from `MetrizationHeightUnique`, `MetrizationExists` and
`ProductMetrization` (proved).** -/
theorem productModelHeight_of_unique (hH : MetrizationHeightUnique) (hE : MetrizationExists)
    (hP : ProductMetrization) : ProductModelHeight := by
  intro K _ A B C eC L _ _ _ 𝒢P 𝒢₁ 𝒢₂ hPM
  obtain ⟨g₁, M₁, h₁⟩ := hE K A L 𝒢₁
  obtain ⟨g₂, M₂, h₂⟩ := hE K B L 𝒢₂
  obtain ⟨MP, hMP, hh⟩ := hP K A B C eC L 𝒢P 𝒢₁ 𝒢₂ hPM g₁ g₂ M₁ M₂ h₁ h₂
  rw [height_eq_of_model hH M₁ h₁, height_eq_of_model hH M₂ h₂, height_eq_of_model hH MP hMP,
    hh, EReal.coe_add]

/-- **g0-heightadd's `productModelHeight_of`, on the kernel's types (proved).** -/
theorem productModelHeight_of (hU : AnalyticUniformizationUnique) (hD : MetrizationDimUnique)
    (hE : MetrizationExists) (hP : ProductMetrization) : ProductModelHeight :=
  productModelHeight_of_unique (metrizationHeightUnique_of hU hD) hE hP

section HodgeAdd

variable {K : Type*} [Field K] [NumberField K]
variable {V V₁ V₂ : Type*} [AddCommGroup V] [Module K V] [Module (𝓞 K) V] [IsScalarTower (𝓞 K) K V]
  [AddCommGroup V₁] [Module K V₁] [Module (𝓞 K) V₁] [IsScalarTower (𝓞 K) K V₁]
  [AddCommGroup V₂] [Module K V₂] [Module (𝓞 K) V₂] [IsScalarTower (𝓞 K) K V₂]

/-- **Additivity of the model height (copied from g0-heightadd, proved).** If the Hodge data `D`
(dimension `g₁ + g₂`) has a nonzero section `s` whose lattice index, coefficients and period
covolumes are the products of those of nonzero sections `s₁`, `s₂` of `D₁`, `D₂`, then
`h(D) = h(D₁) + h(D₂)`. -/
theorem modelHeight_add_of {g₁ g₂ : ℕ} (D : HodgeData K (g₁ + g₂) V) (D₁ : HodgeData K g₁ V₁)
    (D₂ : HodgeData K g₂ V₂) {s : V} {s₁ : V₁} {s₂ : V₂} (hs : s ∈ D.lattice) (hs0 : s ≠ 0)
    (hs₁ : s₁ ∈ D₁.lattice) (hs₁0 : s₁ ≠ 0) (hs₂ : s₂ ∈ D₂.lattice) (hs₂0 : s₂ ≠ 0)
    (hidx : secIndex D.lattice s = secIndex D₁.lattice s₁ * secIndex D₂.lattice s₂)
    (hcoeff : ∀ σ, D.coeff σ s = D₁.coeff σ s₁ * D₂.coeff σ s₂)
    (hcov : ∀ σ, ZLattice.covolume (D.periods σ) =
      ZLattice.covolume (D₁.periods σ) * ZLattice.covolume (D₂.periods σ)) :
    D.modelHeight = D₁.modelHeight + D₂.modelHeight := by
  rw [D.modelHeight_eq hs hs0, D₁.modelHeight_eq hs₁ hs₁0, D₂.modelHeight_eq hs₂ hs₂0]
  have ht : ∀ σ : K →+* ℂ, torusMetricSq (D.periods σ) (D.coeff σ s) =
      torusMetricSq (D₁.periods σ) (D₁.coeff σ s₁) *
        torusMetricSq (D₂.periods σ) (D₂.coeff σ s₂) := by
    intro σ
    simp only [torusMetricSq, hcoeff σ, hcov σ, norm_mul]
    ring
  have hlog : ∀ σ : K →+* ℂ, Real.log (torusMetricSq (D.periods σ) (D.coeff σ s)) =
      Real.log (torusMetricSq (D₁.periods σ) (D₁.coeff σ s₁)) +
        Real.log (torusMetricSq (D₂.periods σ) (D₂.coeff σ s₂)) := by
    intro σ
    rw [ht σ]
    have := D₁.periods_discrete σ
    have := D₁.periods_isZLattice σ
    have := D₂.periods_discrete σ
    have := D₂.periods_isZLattice σ
    exact Real.log_mul (torusMetricSq_pos _ (D₁.coeff_apply_ne_zero σ hs₁0)).ne'
      (torusMetricSq_pos _ (D₂.coeff_apply_ne_zero σ hs₂0)).ne'
  have hi₁ : (secIndex D₁.lattice s₁ : ℝ) ≠ 0 :=
    Nat.cast_ne_zero.mpr (D₁.hodgeBundle.secIndex_ne_zero hs₁ hs₁0)
  have hi₂ : (secIndex D₂.lattice s₂ : ℝ) ≠ 0 :=
    Nat.cast_ne_zero.mpr (D₂.hodgeBundle.secIndex_ne_zero hs₂ hs₂0)
  rw [hidx, Nat.cast_mul, Real.log_mul hi₁ hi₂, Finset.sum_congr rfl (fun σ _ => hlog σ),
    Finset.sum_add_distrib]
  ring

end HodgeAdd

/-- **Glue P2a-geo (copied from g0-heightadd).** For `𝒢P ≅ 𝒢₁ × 𝒢₂` and metrizations `M₁`, `M₂`,
there is a metrization `MP` of `𝒢P` of dimension `g₁ + g₂` and nonzero sections
`s ∈ ⋀^{g₁+g₂}ω_{𝒢P}`, `sᵢ ∈ ⋀^{gᵢ}ω_{𝒢ᵢ}` whose lattice index, coefficients and period
covolumes multiply (`s = p₁*s₁ ∧ p₂*s₂`, `Φ₁ × Φ₂` with lattice `Λ₁ × Λ₂`; STANDARD, unproved). -/
def ProductMetrizationGeo : Prop :=
  ∀ (K : Type) [Field K] (A B C : AbVar K) (eC : C.X ≅ A.X ⊗ B.X) (L : Type) [Field L]
    [NumberField L] [Algebra K L] (𝒢P : GroupModel C L) (𝒢₁ : GroupModel A L)
    (𝒢₂ : GroupModel B L), IsProductModel eC 𝒢P 𝒢₁ 𝒢₂ →
    ∀ (g₁ g₂ : ℕ) (M₁ : MetrizedModel A L g₁) (M₂ : MetrizedModel B L g₂),
      M₁.model = 𝒢₁ → M₂.model = 𝒢₂ →
      ∃ (MP : MetrizedModel C L (g₁ + g₂)) (s : MP.model.hodgeSpace (g₁ + g₂))
        (s₁ : M₁.model.hodgeSpace g₁) (s₂ : M₂.model.hodgeSpace g₂),
        MP.model = 𝒢P ∧ s ∈ MP.hodge.lattice ∧ s ≠ 0 ∧ s₁ ∈ M₁.hodge.lattice ∧ s₁ ≠ 0 ∧
        s₂ ∈ M₂.hodge.lattice ∧ s₂ ≠ 0 ∧
        secIndex MP.hodge.lattice s = secIndex M₁.hodge.lattice s₁ * secIndex M₂.hodge.lattice s₂ ∧
        (∀ σ, MP.hodge.coeff σ s = M₁.hodge.coeff σ s₁ * M₂.hodge.coeff σ s₂) ∧
        (∀ σ, ZLattice.covolume (MP.hodge.periods σ) =
          ZLattice.covolume (M₁.hodge.periods σ) * ZLattice.covolume (M₂.hodge.periods σ))

/-- **P2a from P2a-geo (copied from g0-heightadd, proved).** -/
theorem productMetrization_of_geo (h : ProductMetrizationGeo) : ProductMetrization := by
  intro K _ A B C eC L _ _ _ 𝒢P 𝒢₁ 𝒢₂ hP g₁ g₂ M₁ M₂ h₁ h₂
  obtain ⟨MP, s, s₁, s₂, hMP, hs, hs0, hs₁, hs₁0, hs₂, hs₂0, hidx, hc, hcov⟩ :=
    h K A B C eC L 𝒢P 𝒢₁ 𝒢₂ hP g₁ g₂ M₁ M₂ h₁ h₂
  exact ⟨MP, hMP,
    modelHeight_add_of MP.hodge M₁.hodge M₂.hodge hs hs0 hs₁ hs₁0 hs₂ hs₂0 hidx hc hcov⟩

/-- **`ProductModelHeight` from U, `MetrizationDimUnique`, `MetrizationExists` and
`ProductMetrizationGeo` (proved).** -/
theorem productModelHeight_of_geo (hU : AnalyticUniformizationUnique) (hD : MetrizationDimUnique)
    (hE : MetrizationExists) (hG : ProductMetrizationGeo) : ProductModelHeight :=
  productModelHeight_of hU hD hE (productMetrization_of_geo hG)

/-! ## §3. Route U implies route S -/

/-- **`ProductMetrizationSplit` from `MetrizationHeightUnique`, `MetrizationExists` and
`ProductMetrization` (proved).** So S is implied by the inputs of route U. -/
theorem productMetrizationSplit_of (hH : MetrizationHeightUnique) (hE : MetrizationExists)
    (hP : ProductMetrization) : ProductMetrizationSplit := by
  intro K _ A B C eC L _ _ _ 𝒢P 𝒢₁ 𝒢₂ hPM g MP hMP
  obtain ⟨g₁, M₁, h₁⟩ := hE K A L 𝒢₁
  obtain ⟨g₂, M₂, h₂⟩ := hE K B L 𝒢₂
  obtain ⟨MP', hMP', hh⟩ := hP K A B C eC L 𝒢P 𝒢₁ 𝒢₂ hPM g₁ g₂ M₁ M₂ h₁ h₂
  refine ⟨g₁, g₂, M₁, M₂, h₁, h₂, ?_⟩
  rw [← hh, hH K C L _ g MP' MP (hMP'.trans hMP.symm)]

/-! ## §4. What `ProductModelHeight` forces

`ProductModelHeight` forces, from a single metrization of the product (an analytic
uniformization `Φ` of `(𝒢₁ × 𝒢₂)(ℂ)_τ` at every `τ`, with its Hodge data), the existence of
metrizations of each factor, i.e. of analytic uniformizations of `𝒢₁(ℂ)_τ` with a *discrete*
kernel. The composite `p₁ ∘ Φ` is onto but has a non-discrete kernel. A discrete one is obtained
by restricting `Φ` to the identity component of `ker(p₂ ∘ Φ)`, an elementary step (§6,
`ProductUnifSplits`); this is *not* AN3. (An earlier version of this text called it AN3-type; that
was wrong.) P2 also bounds every single metrization of the product from below. -/

section Forces

variable {K : Type} [Field K] {A B C : AbVar K} {eC : C.X ≅ A.X ⊗ B.X} {L : Type} [Field L]
  [NumberField L] [Algebra K L] {𝒢P : GroupModel C L} {𝒢₁ : GroupModel A L} {𝒢₂ : GroupModel B L}

/-- `ProductModelHeight` bounds every single metrization of the product from below. -/
theorem le_of_productModelHeight (h : ProductModelHeight) (hPM : IsProductModel eC 𝒢P 𝒢₁ 𝒢₂)
    {g : ℕ} (MP : MetrizedModel C L g) (hMP : MP.model = 𝒢P) :
    𝒢₁.height + 𝒢₂.height ≤ (MP.hodge.modelHeight : EReal) :=
  (h K A B C eC L 𝒢P 𝒢₁ 𝒢₂ hPM).trans (height_le_of_model MP hMP)

/-- **`ProductModelHeight` forces metrizations of the left factor** (proved): if the product
model has a metrization and `h(𝒢₂) ≠ ⊥`, then `𝒢₁` has a metrization. -/
theorem metrizable_left_of_productModelHeight (h : ProductModelHeight)
    (hPM : IsProductModel eC 𝒢P 𝒢₁ 𝒢₂) {g : ℕ} (MP : MetrizedModel C L g) (hMP : MP.model = 𝒢P)
    (h₂ : 𝒢₂.height ≠ ⊥) : ∃ (g₁ : ℕ) (M₁ : MetrizedModel A L g₁), M₁.model = 𝒢₁ := by
  by_contra hn
  have h1 := height_eq_top_of_not_metrizable hn
  have key := le_of_productModelHeight h hPM MP hMP
  rw [h1, EReal.top_add_of_ne_bot h₂, top_le_iff] at key
  exact EReal.coe_ne_top _ key

/-- **`ProductModelHeight` forces metrizations of the right factor** (proved). -/
theorem metrizable_right_of_productModelHeight (h : ProductModelHeight)
    (hPM : IsProductModel eC 𝒢P 𝒢₁ 𝒢₂) {g : ℕ} (MP : MetrizedModel C L g) (hMP : MP.model = 𝒢P)
    (h₁ : 𝒢₁.height ≠ ⊥) : ∃ (g₂ : ℕ) (M₂ : MetrizedModel B L g₂), M₂.model = 𝒢₂ := by
  by_contra hn
  have h2 := height_eq_top_of_not_metrizable hn
  have key := le_of_productModelHeight h hPM MP hMP
  rw [h2, EReal.add_top_of_ne_bot h₁, top_le_iff] at key
  exact EReal.coe_ne_top _ key

end Forces

/-- **`ProductModelHeight` forces uniformizations of the left factor** (proved): if the product
model has a metrization and `h(𝒢₂) ≠ ⊥`, then at every `τ` the complex points `𝒢₁(ℂ)_τ` have an
analytic uniformization with a full discrete lattice as kernel (the conclusion of
`AnalyticUniformizationExists` for `𝒢₁`, obtained from the product's; elementary, see §6). -/
theorem analyticUnif_left_of_productModelHeight (h : ProductModelHeight)
    {K : Type} [Field K] {A B C : AbVar K} {eC : C.X ≅ A.X ⊗ B.X} {L : Type} [Field L]
    [NumberField L] [Algebra K L] {𝒢P : GroupModel C L} {𝒢₁ : GroupModel A L}
    {𝒢₂ : GroupModel B L} (hPM : IsProductModel eC 𝒢P 𝒢₁ 𝒢₂) {g : ℕ}
    (MP : MetrizedModel C L g) (hMP : MP.model = 𝒢P) (h₂ : 𝒢₂.height ≠ ⊥) (τ : L →+* ℂ) :
    ∃ (g₁ : ℕ) (Λ : Submodule ℤ (Fin g₁ → ℂ)) (Φ : (Fin g₁ → ℂ) → 𝒢₁.Pts τ),
      ∃ _ : DiscreteTopology Λ, IsZLattice ℝ Λ ∧ 𝒢₁.IsAnalyticUniformization τ Λ Φ := by
  obtain ⟨g₁, M₁, rfl⟩ := metrizable_left_of_productModelHeight h hPM MP hMP h₂
  obtain ⟨Φ, hΦ, -⟩ := M₁.arch τ
  exact ⟨g₁, _, Φ, M₁.hodge.periods_discrete τ, M₁.hodge.periods_isZLattice τ, hΦ⟩

/-! ## §5. Complex points of a product model, and the product uniformization (algebraic half)

For `e : 𝒢P ≅ 𝒢₁ ⊗ 𝒢₂` with homomorphic components, `𝒢P(ℂ)_τ ≅ 𝒢₁(ℂ)_τ × 𝒢₂(ℂ)_τ` as groups
(`ptsEquiv`, proved). For uniformizations `Φ₁`, `Φ₂` of the factors, the product
`Φ(z) = (Φ₁(z₁), Φ₂(z₂))` (`z = Fin.append z₁ z₂`) satisfies the three algebraic clauses of
`IsAnalyticUniformization` with kernel `Λ₁ × Λ₂` (`prodUnif_clauses`, proved); the two analytic
clauses (openness of `Φ⁻¹(U(ℂ))`, holomorphy of regular functions along `Φ`) are the glue Prop
`ProductUnifAnalytic`. This is the "easy" direction (products of uniformizations), used by
`ProductMetrizationGeo`; it is not the splitting of §1. -/

section Points

variable {K : Type} [Field K] {A B C : AbVar K} {L : Type} [Field L] [NumberField L] [Algebra K L]
  {𝒢P : GroupModel C L} {𝒢₁ : GroupModel A L} {𝒢₂ : GroupModel B L}

/-- The two projections on complex points, as one homomorphism. -/
noncomputable def ptsProj (e : 𝒢P.G ≅ 𝒢₁.G ⊗ 𝒢₂.G) [IsMonHom (e.hom ≫ fst _ _)]
    [IsMonHom (e.hom ≫ snd _ _)] (τ : L →+* ℂ) : 𝒢P.Pts τ →* 𝒢₁.Pts τ × 𝒢₂.Pts τ :=
  (IsMonHom.monoidHom (e.hom ≫ fst _ _) (GroupModel.ptC τ)).prod
    (IsMonHom.monoidHom (e.hom ≫ snd _ _) (GroupModel.ptC τ))

theorem ptsProj_bijective (e : 𝒢P.G ≅ 𝒢₁.G ⊗ 𝒢₂.G) [IsMonHom (e.hom ≫ fst _ _)]
    [IsMonHom (e.hom ≫ snd _ _)] (τ : L →+* ℂ) : Function.Bijective (ptsProj e τ) := by
  constructor
  · intro p q hpq
    simp only [ptsProj, MonoidHom.prod_apply, IsMonHom.monoidHom_apply, Prod.mk.injEq] at hpq
    rw [← cancel_mono e.hom]
    apply CartesianMonoidalCategory.hom_ext
    · simpa only [Category.assoc] using hpq.1
    · simpa only [Category.assoc] using hpq.2
  · rintro ⟨a, b⟩
    refine ⟨lift a b ≫ e.inv, ?_⟩
    simp only [ptsProj, MonoidHom.prod_apply, IsMonHom.monoidHom_apply, Category.assoc,
      Iso.inv_hom_id_assoc, lift_fst, lift_snd]

/-- **`𝒢P(ℂ)_τ ≅ 𝒢₁(ℂ)_τ × 𝒢₂(ℂ)_τ` as groups (proved).** -/
noncomputable def ptsEquiv (e : 𝒢P.G ≅ 𝒢₁.G ⊗ 𝒢₂.G) [IsMonHom (e.hom ≫ fst _ _)]
    [IsMonHom (e.hom ≫ snd _ _)] (τ : L →+* ℂ) : 𝒢P.Pts τ ≃* 𝒢₁.Pts τ × 𝒢₂.Pts τ :=
  MulEquiv.ofBijective (ptsProj e τ) (ptsProj_bijective e τ)

/-- The lattice `Λ₁ × Λ₂ ⊂ ℂ^{g₁+g₂}` (coordinates `Fin.append`). -/
def prodLattice {g₁ g₂ : ℕ} (Λ₁ : Submodule ℤ (Fin g₁ → ℂ)) (Λ₂ : Submodule ℤ (Fin g₂ → ℂ)) :
    Submodule ℤ (Fin (g₁ + g₂) → ℂ) :=
  Λ₁.comap (LinearMap.funLeft ℤ ℂ (Fin.castAdd g₂)) ⊓
    Λ₂.comap (LinearMap.funLeft ℤ ℂ (Fin.natAdd g₁))

/-- The product uniformization `z ↦ (Φ₁(z₁), Φ₂(z₂))`. -/
noncomputable def prodUnif (e : 𝒢P.G ≅ 𝒢₁.G ⊗ 𝒢₂.G) [IsMonHom (e.hom ≫ fst _ _)]
    [IsMonHom (e.hom ≫ snd _ _)] {τ : L →+* ℂ} {g₁ g₂ : ℕ} (Φ₁ : (Fin g₁ → ℂ) → 𝒢₁.Pts τ)
    (Φ₂ : (Fin g₂ → ℂ) → 𝒢₂.Pts τ) : (Fin (g₁ + g₂) → ℂ) → 𝒢P.Pts τ := fun z =>
  (ptsEquiv e τ).symm (Φ₁ fun i => z (Fin.castAdd g₂ i), Φ₂ fun i => z (Fin.natAdd g₁ i))

/-- **The algebraic clauses of `IsAnalyticUniformization` for the product (proved).** -/
theorem prodUnif_clauses (e : 𝒢P.G ≅ 𝒢₁.G ⊗ 𝒢₂.G) [IsMonHom (e.hom ≫ fst _ _)]
    [IsMonHom (e.hom ≫ snd _ _)] {τ : L →+* ℂ} {g₁ g₂ : ℕ} {Λ₁ : Submodule ℤ (Fin g₁ → ℂ)}
    {Λ₂ : Submodule ℤ (Fin g₂ → ℂ)} {Φ₁ : (Fin g₁ → ℂ) → 𝒢₁.Pts τ}
    {Φ₂ : (Fin g₂ → ℂ) → 𝒢₂.Pts τ} (h₁ : 𝒢₁.IsAnalyticUniformization τ Λ₁ Φ₁)
    (h₂ : 𝒢₂.IsAnalyticUniformization τ Λ₂ Φ₂) :
    (∀ z w, prodUnif e Φ₁ Φ₂ (z + w) = prodUnif e Φ₁ Φ₂ z * prodUnif e Φ₁ Φ₂ w) ∧
    (∀ z, prodUnif e Φ₁ Φ₂ z = 1 ↔ z ∈ prodLattice Λ₁ Λ₂) ∧
    Function.Surjective (prodUnif e Φ₁ Φ₂) := by
  obtain ⟨m₁, k₁, s₁, -, -⟩ := h₁
  obtain ⟨m₂, k₂, s₂, -, -⟩ := h₂
  refine ⟨fun z w => ?_, fun z => ?_, fun p => ?_⟩
  · simp only [prodUnif, ← map_mul, Prod.mk_mul_mk]
    congr 2
    · exact m₁ _ _
    · exact m₂ _ _
  · simp only [prodUnif, MulEquiv.map_eq_one_iff, Prod.mk_eq_one, k₁, k₂, prodLattice,
      Submodule.mem_inf, Submodule.mem_comap]
    rfl
  · obtain ⟨z₁, hz₁⟩ := s₁ (ptsEquiv e τ p).1
    obtain ⟨z₂, hz₂⟩ := s₂ (ptsEquiv e τ p).2
    refine ⟨Fin.append z₁ z₂, ?_⟩
    simp only [prodUnif, Fin.append_left, Fin.append_right, hz₁, hz₂, Prod.mk.eta,
      MulEquiv.symm_apply_apply]

/-- **Glue (analytic half of the product uniformization).** For analytic uniformizations `Φ₁`,
`Φ₂` of the factors, the product uniformization satisfies the two analytic clauses of
`IsAnalyticUniformization`: each `Φ⁻¹(U(ℂ))` is open and each regular function on an open of
`𝒢P` is holomorphic along `Φ` there. Why true (STANDARD): the affine products
`U₁ ×_{𝓞_L} U₂ = Spec(R₁ ⊗ R₂)` cover `𝒢₁ ×_{𝓞_L} 𝒢₂`, and their basic opens `D(f)`,
`f = Σ aᵢ ⊗ bᵢ`, form a basis (products of opens alone do not: the Zariski topology of a product
is finer than the product topology). On `U₁ × U₂` the preimage under `Φ` is
`Φ₁⁻¹(U₁) × Φ₂⁻¹(U₂)` (open), the value of `a ⊗ b` at `Φ z` is `a(Φ₁ z₁) b(Φ₂ z₂)` (holomorphic),
so `Φ⁻¹(D(f))` is open and the sections `h / fⁿ` of `D(f)` are holomorphic along `Φ`; both
properties are local (EGA I 3.2.2 / Stacks 01JR for the affine product, UNVERIFIED). Needs
Mathlib's affine fibre products (`pullbackSpecIso`) and the comparison of evaluations; unproved.
No AN3 input. -/
def ProductUnifAnalytic : Prop :=
  ∀ (K : Type) [Field K] (A B C : AbVar K) (L : Type) [Field L] [NumberField L] [Algebra K L]
    (𝒢P : GroupModel C L) (𝒢₁ : GroupModel A L) (𝒢₂ : GroupModel B L)
    (e : 𝒢P.G ≅ 𝒢₁.G ⊗ 𝒢₂.G) [IsMonHom (e.hom ≫ fst _ _)] [IsMonHom (e.hom ≫ snd _ _)]
    (τ : L →+* ℂ) (g₁ g₂ : ℕ) (Λ₁ : Submodule ℤ (Fin g₁ → ℂ)) (Λ₂ : Submodule ℤ (Fin g₂ → ℂ))
    (Φ₁ : (Fin g₁ → ℂ) → 𝒢₁.Pts τ) (Φ₂ : (Fin g₂ → ℂ) → 𝒢₂.Pts τ),
    𝒢₁.IsAnalyticUniformization τ Λ₁ Φ₁ → 𝒢₂.IsAnalyticUniformization τ Λ₂ Φ₂ →
      (∀ U, IsOpen (𝒢P.dom (prodUnif e Φ₁ Φ₂) U)) ∧
      (∀ U (s : Γ(𝒢P.G.left, U)),
        DifferentiableOn ℂ (fun z => 𝒢P.evalAt (prodUnif e Φ₁ Φ₂ z) U s)
          (𝒢P.dom (prodUnif e Φ₁ Φ₂) U))

/-- **The product of analytic uniformizations is an analytic uniformization of the product
model, with lattice `Λ₁ × Λ₂`** (proved from `ProductUnifAnalytic`). -/
theorem prodUnif_isAnalyticUniformization (hA : ProductUnifAnalytic)
    (e : 𝒢P.G ≅ 𝒢₁.G ⊗ 𝒢₂.G) [IsMonHom (e.hom ≫ fst _ _)]
    [IsMonHom (e.hom ≫ snd _ _)] {τ : L →+* ℂ} {g₁ g₂ : ℕ} {Λ₁ : Submodule ℤ (Fin g₁ → ℂ)}
    {Λ₂ : Submodule ℤ (Fin g₂ → ℂ)} {Φ₁ : (Fin g₁ → ℂ) → 𝒢₁.Pts τ}
    {Φ₂ : (Fin g₂ → ℂ) → 𝒢₂.Pts τ} (h₁ : 𝒢₁.IsAnalyticUniformization τ Λ₁ Φ₁)
    (h₂ : 𝒢₂.IsAnalyticUniformization τ Λ₂ Φ₂) :
    𝒢P.IsAnalyticUniformization τ (prodLattice Λ₁ Λ₂) (prodUnif e Φ₁ Φ₂) := by
  obtain ⟨hm, hk, hs⟩ := prodUnif_clauses e h₁ h₂
  obtain ⟨ho, hd⟩ := hA K A B C L 𝒢P 𝒢₁ 𝒢₂ e τ g₁ g₂ Λ₁ Λ₂ Φ₁ Φ₂ h₁ h₂
  exact ⟨hm, hk, hs, ho, hd⟩

/-- The splitting direction, formal part: for any uniformization `Φ` of the product, `p₁ ∘ Φ`
is a surjective homomorphism `ℂ^g → 𝒢₁(ℂ)_τ` (proved). Its kernel `Φ⁻¹(1 × 𝒢₂(ℂ)_τ)` is not
discrete when `𝒢₂(ℂ)_τ` is infinite; a uniformization of `𝒢₁` is extracted by restricting `Φ`
to the identity component of `ker(p₂ ∘ Φ)` (§6, `ProductUnifSplits`; elementary). -/
theorem proj_comp_unif (e : 𝒢P.G ≅ 𝒢₁.G ⊗ 𝒢₂.G) [IsMonHom (e.hom ≫ fst _ _)]
    [IsMonHom (e.hom ≫ snd _ _)] {τ : L →+* ℂ} {g : ℕ} {Λ : Submodule ℤ (Fin g → ℂ)}
    {Φ : (Fin g → ℂ) → 𝒢P.Pts τ} (hΦ : 𝒢P.IsAnalyticUniformization τ Λ Φ) :
    (∀ z w, (ptsEquiv e τ (Φ (z + w))).1 = (ptsEquiv e τ (Φ z)).1 * (ptsEquiv e τ (Φ w)).1) ∧
    Function.Surjective fun z => (ptsEquiv e τ (Φ z)).1 := by
  obtain ⟨m, -, s, -, -⟩ := hΦ
  refine ⟨fun z w => by rw [m, map_mul, Prod.fst_mul], fun a => ?_⟩
  obtain ⟨z, hz⟩ := s ((ptsEquiv e τ).symm (a, 1))
  exact ⟨z, by simp only [hz, MulEquiv.apply_symm_apply]⟩

end Points


/-! ## §5b. The product lattice (copied from `Lattice.lean`, which compiles standalone)

`Λ₁ × Λ₂` is a full discrete lattice with `covol(Λ₁ × Λ₂) = covol Λ₁ · covol Λ₂`
(`prodLattice_facts`, proved): the covolume clause of `ProductMetrizationGeo` and of S-alg for
the product lattice. -/

section LatticeProd

open Module ZSpan

section LatticeGeneral

variable {E₁ E₂ : Type*}
  [NormedAddCommGroup E₁] [NormedSpace ℝ E₁] [FiniteDimensional ℝ E₁] [MeasurableSpace E₁]
  [BorelSpace E₁]
  [NormedAddCommGroup E₂] [NormedSpace ℝ E₂] [FiniteDimensional ℝ E₂] [MeasurableSpace E₂]
  [BorelSpace E₂]
  (Λ₁ : Submodule ℤ E₁) (Λ₂ : Submodule ℤ E₂)

omit [NormedSpace ℝ E₁] [FiniteDimensional ℝ E₁] [MeasurableSpace E₁] [BorelSpace E₁]
  [NormedSpace ℝ E₂] [FiniteDimensional ℝ E₂] [MeasurableSpace E₂] [BorelSpace E₂] in
theorem discreteTopology_prod [DiscreteTopology Λ₁] [DiscreteTopology Λ₂] :
    DiscreteTopology (Λ₁.prod Λ₂) := by
  let f : Λ₁.prod Λ₂ → Λ₁ × Λ₂ := fun x =>
    (⟨x.1.1, (Submodule.mem_prod.mp x.2).1⟩, ⟨x.1.2, (Submodule.mem_prod.mp x.2).2⟩)
  have hf : Continuous f := by
    refine Continuous.prodMk ?_ ?_
    · exact (continuous_fst.comp continuous_subtype_val).subtype_mk _
    · exact (continuous_snd.comp continuous_subtype_val).subtype_mk _
  have hinj : Function.Injective f := by
    intro x y h
    simp only [f, Prod.mk.injEq, Subtype.mk.injEq] at h
    exact Subtype.ext (Prod.ext h.1 h.2)
  rw [discreteTopology_iff_isOpen_singleton]
  intro x
  have : ({x} : Set (Λ₁.prod Λ₂)) = f ⁻¹' {f x} := by
    ext y
    simp only [Set.mem_singleton_iff, Set.mem_preimage, hinj.eq_iff]
  rw [this]
  exact (isOpen_discrete _).preimage hf

instance instDiscreteTopologyProd [DiscreteTopology Λ₁] [DiscreteTopology Λ₂] :
    DiscreteTopology (Λ₁.prod Λ₂) :=
  discreteTopology_prod Λ₁ Λ₂

instance instIsZLatticeProd [DiscreteTopology Λ₁] [DiscreteTopology Λ₂] [IsZLattice ℝ Λ₁]
    [IsZLattice ℝ Λ₂] : IsZLattice ℝ (Λ₁.prod Λ₂) := by
  refine ⟨?_⟩
  rw [eq_top_iff]
  rintro ⟨x, y⟩ -
  have hx : x ∈ Submodule.span ℝ (Λ₁ : Set E₁) := by rw [IsZLattice.span_top]; trivial
  have hy : y ∈ Submodule.span ℝ (Λ₂ : Set E₂) := by rw [IsZLattice.span_top]; trivial
  have h1 : Submodule.map (LinearMap.inl ℝ E₁ E₂) (Submodule.span ℝ (Λ₁ : Set E₁)) ≤
      Submodule.span ℝ ((Λ₁.prod Λ₂ : Submodule ℤ (E₁ × E₂)) : Set (E₁ × E₂)) := by
    rw [Submodule.map_span]
    apply Submodule.span_mono
    rintro _ ⟨a, ha, rfl⟩
    exact Submodule.mem_prod.mpr ⟨ha, Λ₂.zero_mem⟩
  have h2 : Submodule.map (LinearMap.inr ℝ E₁ E₂) (Submodule.span ℝ (Λ₂ : Set E₂)) ≤
      Submodule.span ℝ ((Λ₁.prod Λ₂ : Submodule ℤ (E₁ × E₂)) : Set (E₁ × E₂)) := by
    rw [Submodule.map_span]
    apply Submodule.span_mono
    rintro _ ⟨a, ha, rfl⟩
    exact Submodule.mem_prod.mpr ⟨Λ₁.zero_mem, ha⟩
  have : ((x, y) : E₁ × E₂) = LinearMap.inl ℝ E₁ E₂ x + LinearMap.inr ℝ E₁ E₂ y := by simp
  rw [this]
  exact Submodule.add_mem _ (h1 ⟨x, hx, rfl⟩) (h2 ⟨y, hy, rfl⟩)

/-- Unique translates into the fundamental domain of a basis, for the lattice itself. -/
theorem exists_unique_add_mem {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    [FiniteDimensional ℝ E] (L : Submodule ℤ E) [DiscreteTopology L] [IsZLattice ℝ L]
    {κ : Type*} [Fintype κ] (b : Basis κ ℤ L) (x : E) :
    ∃! l : L, (l : E) + x ∈ fundamentalDomain (b.ofZLatticeBasis ℝ) := by
  have hs := b.ofZLatticeBasis_span ℝ
  obtain ⟨v, hv, hu⟩ := exist_unique_vadd_mem_fundamentalDomain (b.ofZLatticeBasis ℝ) x
  refine ⟨⟨v, hs.le v.2⟩, hv, fun l hl => ?_⟩
  have := hu ⟨l, hs.ge l.2⟩ hl
  have h : ((⟨(l : E), hs.ge l.2⟩ : Submodule.span ℤ (Set.range (b.ofZLatticeBasis ℝ))) : E) =
      (v : E) := congrArg Subtype.val this
  exact Subtype.ext h

theorem isAddFundamentalDomain_prod [DiscreteTopology Λ₁] [DiscreteTopology Λ₂]
    [IsZLattice ℝ Λ₁] [IsZLattice ℝ Λ₂] {κ₁ κ₂ : Type*} [Fintype κ₁] [Fintype κ₂]
    (b₁ : Basis κ₁ ℤ Λ₁) (b₂ : Basis κ₂ ℤ Λ₂) (μ₁ : Measure E₁) (μ₂ : Measure E₂) :
    IsAddFundamentalDomain (Λ₁.prod Λ₂)
      (fundamentalDomain (b₁.ofZLatticeBasis ℝ) ×ˢ fundamentalDomain (b₂.ofZLatticeBasis ℝ))
      (μ₁.prod μ₂) := by
  refine IsAddFundamentalDomain.mk' (((fundamentalDomain_measurableSet _).prod
    (fundamentalDomain_measurableSet _)).nullMeasurableSet) fun x => ?_
  obtain ⟨l₁, h₁, u₁⟩ := exists_unique_add_mem Λ₁ b₁ x.1
  obtain ⟨l₂, h₂, u₂⟩ := exists_unique_add_mem Λ₂ b₂ x.2
  refine ⟨⟨((l₁ : E₁), (l₂ : E₂)), Submodule.mem_prod.mpr ⟨l₁.2, l₂.2⟩⟩, ⟨h₁, h₂⟩, ?_⟩
  rintro ⟨⟨y₁, y₂⟩, hy⟩ hm
  obtain ⟨hm₁, hm₂⟩ := hm
  have e1 := u₁ ⟨y₁, (Submodule.mem_prod.mp hy).1⟩ hm₁
  have e2 := u₂ ⟨y₂, (Submodule.mem_prod.mp hy).2⟩ hm₂
  apply Subtype.ext
  exact Prod.ext (congrArg Subtype.val e1) (congrArg Subtype.val e2)

/-- **`covol(Λ₁ × Λ₂) = covol Λ₁ · covol Λ₂`** (proved). -/
theorem covolume_prod [DiscreteTopology Λ₁] [DiscreteTopology Λ₂] [IsZLattice ℝ Λ₁]
    [IsZLattice ℝ Λ₂] (μ₁ : Measure E₁) (μ₂ : Measure E₂) [μ₁.IsAddHaarMeasure]
    [μ₂.IsAddHaarMeasure] :
    ZLattice.covolume (Λ₁.prod Λ₂) (μ₁.prod μ₂) =
      ZLattice.covolume Λ₁ μ₁ * ZLattice.covolume Λ₂ μ₂ := by
  let b₁ := Free.chooseBasis ℤ Λ₁
  let b₂ := Free.chooseBasis ℤ Λ₂
  rw [ZLattice.covolume_eq_measure_fundamentalDomain (Λ₁.prod Λ₂) (μ₁.prod μ₂)
      (isAddFundamentalDomain_prod Λ₁ Λ₂ b₁ b₂ μ₁ μ₂),
    ZLattice.covolume_eq_measure_fundamentalDomain Λ₁ μ₁ (ZLattice.isAddFundamentalDomain b₁ μ₁),
    ZLattice.covolume_eq_measure_fundamentalDomain Λ₂ μ₂ (ZLattice.isAddFundamentalDomain b₂ μ₂),
    measureReal_def, measureReal_def, measureReal_def, Measure.prod_prod, ENNReal.toReal_mul]

end LatticeGeneral

section LatticeSplit

/-- `ℂ^{g₁+g₂} ≅ ℂ^{g₁} × ℂ^{g₂}`, `z ↦ (z ∘ castAdd, z ∘ natAdd)`. -/
def splitLE (g₁ g₂ : ℕ) : (Fin (g₁ + g₂) → ℂ) ≃ₗ[ℝ] (Fin g₁ → ℂ) × (Fin g₂ → ℂ) where
  toFun z := (fun i => z (Fin.castAdd g₂ i), fun i => z (Fin.natAdd g₁ i))
  invFun p := Fin.append p.1 p.2
  map_add' _ _ := rfl
  map_smul' _ _ := rfl
  left_inv _ := Fin.append_castAdd_natAdd
  right_inv p := by ext i <;> simp

/-- The continuous version. -/
noncomputable def splitCL (g₁ g₂ : ℕ) : (Fin (g₁ + g₂) → ℂ) ≃L[ℝ] (Fin g₁ → ℂ) × (Fin g₂ → ℂ) :=
  (splitLE g₁ g₂).toContinuousLinearEquiv

theorem splitCL_apply (g₁ g₂ : ℕ) (z : Fin (g₁ + g₂) → ℂ) :
    splitCL g₁ g₂ z = (fun i => z (Fin.castAdd g₂ i), fun i => z (Fin.natAdd g₁ i)) := rfl

theorem splitCL_measurePreserving (g₁ g₂ : ℕ) :
    MeasurePreserving (splitCL g₁ g₂) volume volume := by
  have h1 := MeasurePreserving.symm _
    (volume_measurePreserving_piCongrLeft (fun _ : Fin (g₁ + g₂) => ℂ) finSumFinEquiv)
  have h2 := volume_measurePreserving_sumPiEquivProdPi (fun _ : Fin g₁ ⊕ Fin g₂ => ℂ)
  have h := h2.comp h1
  convert h using 1
  funext z
  rw [splitCL_apply]
  ext i
  · simp only [Function.comp_apply, MeasurableEquiv.coe_sumPiEquivProdPi,
      Equiv.sumPiEquivProdPi_apply]
    show z _ = (Equiv.piCongrLeft (fun _ => ℂ) finSumFinEquiv).symm z (Sum.inl i)
    rw [Equiv.piCongrLeft_symm_apply, finSumFinEquiv_apply_left]
  · simp only [Function.comp_apply, MeasurableEquiv.coe_sumPiEquivProdPi,
      Equiv.sumPiEquivProdPi_apply]
    show z _ = (Equiv.piCongrLeft (fun _ => ℂ) finSumFinEquiv).symm z (Sum.inr i)
    rw [Equiv.piCongrLeft_symm_apply, finSumFinEquiv_apply_right]

theorem prodLattice_eq_comap {g₁ g₂ : ℕ} (Λ₁ : Submodule ℤ (Fin g₁ → ℂ))
    (Λ₂ : Submodule ℤ (Fin g₂ → ℂ)) :
    prodLattice Λ₁ Λ₂ = ZLattice.comap ℝ (Λ₁.prod Λ₂) (splitCL g₁ g₂).toLinearMap := by
  ext z
  simp only [prodLattice, Submodule.mem_inf, Submodule.mem_comap]
  rfl

/-- **The product lattice is a full discrete lattice with `covol = covol Λ₁ · covol Λ₂`**
(proved). -/
theorem prodLattice_facts {g₁ g₂ : ℕ} (Λ₁ : Submodule ℤ (Fin g₁ → ℂ))
    (Λ₂ : Submodule ℤ (Fin g₂ → ℂ)) [DiscreteTopology Λ₁] [IsZLattice ℝ Λ₁]
    [DiscreteTopology Λ₂] [IsZLattice ℝ Λ₂] :
    ∃ _ : DiscreteTopology (prodLattice Λ₁ Λ₂), IsZLattice ℝ (prodLattice Λ₁ Λ₂) ∧
      ZLattice.covolume (prodLattice Λ₁ Λ₂) = ZLattice.covolume Λ₁ * ZLattice.covolume Λ₂ := by
  have h01 : (volume : Measure (Fin g₁ → ℂ)).IsAddHaarMeasure := inferInstance
  have h02 : (volume : Measure (Fin g₂ → ℂ)).IsAddHaarMeasure := inferInstance
  have : (volume : Measure ((Fin g₁ → ℂ) × (Fin g₂ → ℂ))).IsAddHaarMeasure :=
    Measure.prod.instIsAddHaarMeasure (volume : Measure (Fin g₁ → ℂ))
      (volume : Measure (Fin g₂ → ℂ))
  rw [prodLattice_eq_comap]
  refine ⟨inferInstance, inferInstance, ?_⟩
  rw [ZLattice.covolume_comap (Λ₁.prod Λ₂) volume volume (splitCL_measurePreserving g₁ g₂)]
  exact covolume_prod Λ₁ Λ₂ volume volume

end LatticeSplit

/-- **A product of full-lattice uniformizations is a full-lattice uniformization of the product**
(proved from `ProductUnifAnalytic`): the conclusion of `AnalyticUniformizationExists` for the
product model, from the factors'. -/
theorem prodUnif_fullLattice (hA : ProductUnifAnalytic) {K : Type} [Field K] {A B C : AbVar K}
    {L : Type} [Field L] [NumberField L] [Algebra K L] {𝒢P : GroupModel C L}
    {𝒢₁ : GroupModel A L} {𝒢₂ : GroupModel B L} (e : 𝒢P.G ≅ 𝒢₁.G ⊗ 𝒢₂.G)
    [IsMonHom (e.hom ≫ fst _ _)] [IsMonHom (e.hom ≫ snd _ _)] {τ : L →+* ℂ} {g₁ g₂ : ℕ}
    {Λ₁ : Submodule ℤ (Fin g₁ → ℂ)} {Λ₂ : Submodule ℤ (Fin g₂ → ℂ)} [DiscreteTopology Λ₁]
    [DiscreteTopology Λ₂] (hl₁ : IsZLattice ℝ Λ₁) (hl₂ : IsZLattice ℝ Λ₂)
    {Φ₁ : (Fin g₁ → ℂ) → 𝒢₁.Pts τ} {Φ₂ : (Fin g₂ → ℂ) → 𝒢₂.Pts τ}
    (h₁ : 𝒢₁.IsAnalyticUniformization τ Λ₁ Φ₁) (h₂ : 𝒢₂.IsAnalyticUniformization τ Λ₂ Φ₂) :
    ∃ _ : DiscreteTopology (prodLattice Λ₁ Λ₂), IsZLattice ℝ (prodLattice Λ₁ Λ₂) ∧
      ZLattice.covolume (prodLattice Λ₁ Λ₂) = ZLattice.covolume Λ₁ * ZLattice.covolume Λ₂ ∧
      𝒢P.IsAnalyticUniformization τ (prodLattice Λ₁ Λ₂) (prodUnif e Φ₁ Φ₂) := by
  obtain ⟨hd, hz, hc⟩ := prodLattice_facts Λ₁ Λ₂
  exact ⟨hd, hz, hc, prodUnif_isAnalyticUniformization hA e h₁ h₂⟩

end LatticeProd

/-! ## §6. Route S refined: the splitting is elementary (no AN3)

An independent model review (log) pointed out that the splitting needed by route S uses only the
product's own uniformization, so neither half of AN3 is needed (the author re-checked each
step). Let `Φ` uniformize
`𝒢P(ℂ)_τ = 𝒢₁(ℂ)_τ × 𝒢₂(ℂ)_τ` with full discrete kernel `Λ`, and let `Kᵢ = ker(pᵢ ∘ Φ)`.
- `K₁` is closed: the complement `U` of the closure of `p₁⁻¹(unit section)` is Zariski open, and
  among the `τ`-points only those with `p₁ x = 1` meet that closure (the unit section of the
  separated `𝒢₁` is a closed immersion, and `Spec ℂ → Spec 𝓞_L` over `τ` is unique); so
  `{z | p₁Φ(z) ≠ 1} = dom Φ U` is open (clause 4).
- The identity component `W₂` of `K₁` is a real subspace (closed subgroups of `ℝ^{2g}`), and it
  is complex: `t ↦ f(p₁ Φ(t w))` is holomorphic (clause 5) and constant on `ℝ`, hence constant
  near `0`; a `τ`-point of an affine open is determined by its function values, so `t w ∈ K₁`
  for small complex `t`, and `ℂ w ⊆ W₂`.
- `K₁ + K₂ = ℂ^g` (surjectivity), so `W₁ + W₂ = ℂ^g` (Baire). `W₁ ∩ W₂ ⊆ Λ` is discrete, hence
  `0`.
- So `Φ` restricted to `Wᵢ` gives uniformizations `Φᵢ` of the factors, and `Φ ∘ T = Φ₁ × Φ₂` for
  a linear `T`.

This analytic step is the glue Prop `ProductUnifSplits`. The rest is the Hodge-theoretic glue
`ProductMetrizationOfProductUnif`, mirror image of `ProductMetrizationGeo`. The change of
coordinates is proved here (`recoordM`, from def-faltings' `HodgeData.recoord`,
`GroupModel.jacDet_comp` and `HodgeData.modelHeight_recoord`). -/

section Recoord

variable {K : Type} [Field K] {A : AbVar K} {L : Type} [Field L] [NumberField L] [Algebra K L]

/-- **Precomposing an analytic uniformization with a `ℂ`-linear automorphism `T`** gives an
analytic uniformization with lattice `T⁻¹ Λ` (proved). -/
theorem isAnalyticUniformization_comp {𝒢 : GroupModel A L} {τ : L →+* ℂ} {g : ℕ}
    {Λ : Submodule ℤ (Fin g → ℂ)} {Φ : (Fin g → ℂ) → 𝒢.Pts τ}
    (h : 𝒢.IsAnalyticUniformization τ Λ Φ) (T : (Fin g → ℂ) ≃ₗ[ℂ] (Fin g → ℂ)) :
    𝒢.IsAnalyticUniformization τ (ZLattice.comap ℝ Λ (realify T).toLinearMap)
      (fun z => Φ (T z)) := by
  obtain ⟨hm, hk, hs, ho, hd⟩ := h
  have hTc : Continuous (T : (Fin g → ℂ) → (Fin g → ℂ)) := (realify T).continuous
  refine ⟨fun z w => by simp only [map_add, hm], fun z => ?_, fun p => ?_, fun U => ?_,
    fun U s => ?_⟩
  · rw [hk]; rfl
  · obtain ⟨w, rfl⟩ := hs p
    exact ⟨T.symm w, by simp⟩
  · exact (ho U).preimage hTc
  · let T' : (Fin g → ℂ) →L[ℂ] (Fin g → ℂ) :=
      LinearMap.toContinuousLinearMap (T : (Fin g → ℂ) →ₗ[ℂ] (Fin g → ℂ))
    exact (hd U s).comp T'.differentiableOn (fun z hz => hz)

/-- **Change of linear coordinates of a metrized model** (proved): same group model, Hodge data
`hodge.recoord T`, uniformizations `Φ ∘ T_τ`. -/
noncomputable def recoordM {g : ℕ} (M : MetrizedModel A L g)
    (T : (L →+* ℂ) → ((Fin g → ℂ) ≃ₗ[ℂ] (Fin g → ℂ))) : MetrizedModel A L g where
  model := M.model
  hodge := M.hodge.recoord T
  lattice_eq := M.lattice_eq
  arch τ := by
    obtain ⟨Φ, hΦ, hc⟩ := M.arch τ
    refine ⟨fun z => Φ (T τ z), isAnalyticUniformization_comp hΦ (T τ), fun f => ?_⟩
    show (LinearMap.det (T τ : (Fin g → ℂ) →ₗ[ℂ] (Fin g → ℂ)) • M.hodge.coeff τ)
      (M.model.wedge f) = _
    rw [GroupModel.jacDet_comp, LinearMap.smul_apply, hc, smul_eq_mul, mul_comm]

theorem recoordM_model {g : ℕ} (M : MetrizedModel A L g)
    (T : (L →+* ℂ) → ((Fin g → ℂ) ≃ₗ[ℂ] (Fin g → ℂ))) : (recoordM M T).model = M.model := rfl

theorem recoordM_modelHeight {g : ℕ} (M : MetrizedModel A L g)
    (T : (L →+* ℂ) → ((Fin g → ℂ) ≃ₗ[ℂ] (Fin g → ℂ))) :
    (recoordM M T).hodge.modelHeight = M.hodge.modelHeight :=
  HodgeData.modelHeight_recoord _ _

end Recoord

/-! ## §6b. Clauses 4 and 5 transport along morphisms and linear maps (pieces of S-an)

In S-an the factor uniformizations are `Φᵢ = pᵢ ∘ Φ ∘ ℓᵢ` for linear embeddings `ℓᵢ`. Their
analytic clauses (openness of `dom`, holomorphy of regular functions) follow formally from those
of `Φ`: `analyticClauses_comp` (along any morphism of `𝓞_L`-schemes, via `evalAt_comp`) and
`analyticClauses_precomp` (along any `ℂ`-linear map). Proved. -/

section MorphComp

variable {K : Type} [Field K] {A B : AbVar K} {L : Type} [Field L] [NumberField L] [Algebra K L]

theorem dom_comp (𝒢 : GroupModel A L) (𝒢' : GroupModel B L) (f : 𝒢.G ⟶ 𝒢'.G) {τ : L →+* ℂ}
    {g : ℕ} (Φ : (Fin g → ℂ) → 𝒢.Pts τ) (U : 𝒢'.G.left.Opens) :
    𝒢'.dom (fun z => Φ z ≫ f) U = 𝒢.dom Φ (f.left ⁻¹ᵁ U) := rfl

/-- **Values of regular functions along a morphism** (proved):
`s(f ∘ p) = (f* s)(p)`. -/
theorem evalAt_comp (𝒢 : GroupModel A L) (𝒢' : GroupModel B L) (f : 𝒢.G ⟶ 𝒢'.G)
    {τ : L →+* ℂ} (p : 𝒢.Pts τ) (U : 𝒢'.G.left.Opens) (s : Γ(𝒢'.G.left, U)) :
    𝒢'.evalAt (p ≫ f) U s = 𝒢.evalAt p (f.left ⁻¹ᵁ U) (f.left.app U s) := by
  unfold GroupModel.evalAt
  by_cases h : ⊤ ≤ p.left ⁻¹ᵁ (f.left ⁻¹ᵁ U)
  · rw [dif_pos (show ⊤ ≤ (p ≫ f).left ⁻¹ᵁ U from h), dif_pos h]
    congr 1
  · rw [dif_neg (show ¬ ⊤ ≤ (p ≫ f).left ⁻¹ᵁ U from h), dif_neg h]

/-- **Clauses 4 and 5 transport along a morphism of `𝓞_L`-schemes** (proved). -/
theorem analyticClauses_comp (𝒢 : GroupModel A L) (𝒢' : GroupModel B L) (f : 𝒢.G ⟶ 𝒢'.G)
    {τ : L →+* ℂ} {g : ℕ} {Φ : (Fin g → ℂ) → 𝒢.Pts τ} (ho : ∀ U, IsOpen (𝒢.dom Φ U))
    (hd : ∀ U (s : Γ(𝒢.G.left, U)),
      DifferentiableOn ℂ (fun z => 𝒢.evalAt (Φ z) U s) (𝒢.dom Φ U)) :
    (∀ U, IsOpen (𝒢'.dom (fun z => Φ z ≫ f) U)) ∧
    (∀ U (s : Γ(𝒢'.G.left, U)), DifferentiableOn ℂ (fun z => 𝒢'.evalAt (Φ z ≫ f) U s)
      (𝒢'.dom (fun z => Φ z ≫ f) U)) := by
  refine ⟨fun U => ?_, fun U s => ?_⟩
  · rw [dom_comp]; exact ho _
  · rw [dom_comp]
    simp only [evalAt_comp]
    exact hd _ _

/-- **Clauses 4 and 5 transport along a `ℂ`-linear map** `ℓ : ℂ^{g'} → ℂ^g` (proved). -/
theorem analyticClauses_precomp (𝒢 : GroupModel A L) {τ : L →+* ℂ} {g g' : ℕ}
    {Φ : (Fin g → ℂ) → 𝒢.Pts τ} (ℓ : (Fin g' → ℂ) →ₗ[ℂ] (Fin g → ℂ))
    (ho : ∀ U, IsOpen (𝒢.dom Φ U))
    (hd : ∀ U (s : Γ(𝒢.G.left, U)),
      DifferentiableOn ℂ (fun z => 𝒢.evalAt (Φ z) U s) (𝒢.dom Φ U)) :
    (∀ U, IsOpen (𝒢.dom (fun z => Φ (ℓ z)) U)) ∧
    (∀ U (s : Γ(𝒢.G.left, U)), DifferentiableOn ℂ (fun z => 𝒢.evalAt (Φ (ℓ z)) U s)
      (𝒢.dom (fun z => Φ (ℓ z)) U)) := by
  let ℓ' : (Fin g' → ℂ) →L[ℂ] (Fin g → ℂ) := LinearMap.toContinuousLinearMap ℓ
  refine ⟨fun U => (ho U).preimage ℓ'.continuous, fun U s => ?_⟩
  exact (hd U s).comp ℓ'.differentiableOn (fun z hz => hz)

/-- **The analytic clauses of the factor uniformizations in S-an** (proved): for `e : 𝒢P ≅ 𝒢₁ ⊗ 𝒢₂`,
an analytic uniformization `Φ` of the product and any `ℂ`-linear `ℓ : ℂ^{g₁} → ℂ^g`, the map
`z ↦ p₁(Φ(ℓ z))` satisfies clauses 4 and 5 for `𝒢₁`. -/
theorem proj_analyticClauses {C : AbVar K} {𝒢P : GroupModel C L} {𝒢₁ : GroupModel A L}
    {𝒢₂ : GroupModel B L} (e : 𝒢P.G ≅ 𝒢₁.G ⊗ 𝒢₂.G) [IsMonHom (e.hom ≫ fst _ _)]
    [IsMonHom (e.hom ≫ snd _ _)] {τ : L →+* ℂ} {g g₁ : ℕ} {Λ : Submodule ℤ (Fin g → ℂ)}
    {Φ : (Fin g → ℂ) → 𝒢P.Pts τ} (hΦ : 𝒢P.IsAnalyticUniformization τ Λ Φ)
    (ℓ : (Fin g₁ → ℂ) →ₗ[ℂ] (Fin g → ℂ)) :
    (∀ U, IsOpen (𝒢₁.dom (fun z => (ptsEquiv e τ (Φ (ℓ z))).1) U)) ∧
    (∀ U (s : Γ(𝒢₁.G.left, U)),
      DifferentiableOn ℂ (fun z => 𝒢₁.evalAt (ptsEquiv e τ (Φ (ℓ z))).1 U s)
        (𝒢₁.dom (fun z => (ptsEquiv e τ (Φ (ℓ z))).1) U)) := by
  obtain ⟨-, -, -, ho, hd⟩ := hΦ
  obtain ⟨ho', hd'⟩ := analyticClauses_precomp 𝒢P ℓ ho hd
  exact analyticClauses_comp 𝒢P 𝒢₁ (e.hom ≫ fst _ _) ho' hd'

end MorphComp

/-- **Glue S-an (splitting of a uniformization of a product; elementary analysis, no AN3).**
Let `e : 𝒢P ≅ 𝒢₁ ⊗ 𝒢₂` have homomorphic components. Every analytic uniformization `Φ` of
`𝒢P(ℂ)_τ` with a full discrete lattice `Λ ⊂ ℂ^g` as kernel splits: for some `g₁ + g₂ = g`, full
discrete lattices `Λᵢ ⊂ ℂ^{gᵢ}`, analytic uniformizations `Φᵢ` of `𝒢ᵢ(ℂ)_τ` with kernels `Λᵢ` and a
`ℂ`-linear automorphism `T`, we have `Φ ∘ T = Φ₁ × Φ₂` (`prodUnif`, coordinates `Fin.append`).

Why true (STANDARD, argued in the section header; no uniformization theorem is used). The
ingredients are the structure of closed subgroups of `ℝⁿ` (Bourbaki, *Topologie générale* VII §1,
UNVERIFIED; small elements of a closed subgroup lie in its identity component), the identity
theorem in one complex variable, Baire's theorem, the fact that a `τ`-point of an affine open is
determined by its function values, and the compatibility of `evalAt` with the projections.
Then `Φᵢ = pᵢ ∘ Φ|_{Wᵢ}` with
`Wᵢ = ker(p_{3-i} ∘ Φ)⁰`, `Λᵢ = Λ ∩ Wᵢ`. Unproved. -/
def ProductUnifSplits : Prop :=
  ∀ (K : Type) [Field K] (A B C : AbVar K) (L : Type) [Field L] [NumberField L] [Algebra K L]
    (𝒢P : GroupModel C L) (𝒢₁ : GroupModel A L) (𝒢₂ : GroupModel B L)
    (e : 𝒢P.G ≅ 𝒢₁.G ⊗ 𝒢₂.G) [IsMonHom (e.hom ≫ fst _ _)] [IsMonHom (e.hom ≫ snd _ _)]
    (τ : L →+* ℂ) (g : ℕ) (Λ : Submodule ℤ (Fin g → ℂ)) [DiscreteTopology Λ]
    (Φ : (Fin g → ℂ) → 𝒢P.Pts τ), IsZLattice ℝ Λ → 𝒢P.IsAnalyticUniformization τ Λ Φ →
    ∃ (g₁ g₂ : ℕ) (hg : g₁ + g₂ = g) (Λ₁ : Submodule ℤ (Fin g₁ → ℂ))
      (Λ₂ : Submodule ℤ (Fin g₂ → ℂ)) (Φ₁ : (Fin g₁ → ℂ) → 𝒢₁.Pts τ)
      (Φ₂ : (Fin g₂ → ℂ) → 𝒢₂.Pts τ) (T : (Fin g → ℂ) ≃ₗ[ℂ] (Fin g → ℂ)),
      (∃ _ : DiscreteTopology Λ₁, IsZLattice ℝ Λ₁) ∧ (∃ _ : DiscreteTopology Λ₂, IsZLattice ℝ Λ₂) ∧
      𝒢₁.IsAnalyticUniformization τ Λ₁ Φ₁ ∧ 𝒢₂.IsAnalyticUniformization τ Λ₂ Φ₂ ∧
      ∀ z, Φ (T z) = prodUnif e Φ₁ Φ₂ (fun i => z (Fin.cast hg i))

/-- **Glue S-alg (metrizations of the factors from a product-form metrization; Hodge theory, no
AN3).** Let `e : MP.model ≅ 𝒢₁ ⊗ 𝒢₂` have homomorphic components. Suppose that at every `τ` the
metrization `MP` of the product model is in product form: its period lattice is `Λ₁ × Λ₂` and its
coefficient map is computed by `Φ₁ × Φ₂`, for full discrete lattices `Λᵢ ⊂ ℂ^{gᵢ(τ)}` and analytic
uniformizations `Φᵢ` of the factors. Then the factors have metrizations `M₁`, `M₂` with
`h(M₁) + h(M₂) ≤ h(MP)`.

Why true (STANDARD; mirror image of `ProductMetrizationGeo`).
- `gᵢ(τ) = dim 𝒢ᵢ`: `MP.hodge.finrank_eq_one` gives `g ∈ {0, d₁ + d₂}` (if `g = 0`, the factors'
  complex points are trivial and `dᵢ = 0`); otherwise, with the algebraic splitting
  `cotangent_P = cotangent₁ ⊕ cotangent₂`, the wedge of `p₁*f, p₂*h` (bases) is nonzero, so
  `coeff ≠ 0` makes the block-shaped Jacobian of `Φ₁ × Φ₂` at `0` nonsingular.
- `ω_{MP} = ω₁ ⊕ ω₂` and `⋀^{top}ω_{MP} = ⋀ω₁ ⊗ ⋀ω₂`.
- `jacDet Φᵢ` descends to a semilinear map on `⋀^{gᵢ}`.
- Indices, coefficients and covolumes multiply (`modelHeight_add_of`); equality holds.

Unproved. -/
def ProductMetrizationOfProductUnif : Prop :=
  ∀ (K : Type) [Field K] (A B C : AbVar K) (L : Type) [Field L] [NumberField L] [Algebra K L]
    (𝒢₁ : GroupModel A L) (𝒢₂ : GroupModel B L) (g : ℕ) (MP : MetrizedModel C L g)
    (e : MP.model.G ≅ 𝒢₁.G ⊗ 𝒢₂.G) [IsMonHom (e.hom ≫ fst _ _)] [IsMonHom (e.hom ≫ snd _ _)],
    (∀ τ : L →+* ℂ, ∃ (g₁ g₂ : ℕ) (hg : g₁ + g₂ = g) (Λ₁ : Submodule ℤ (Fin g₁ → ℂ))
        (Λ₂ : Submodule ℤ (Fin g₂ → ℂ)) (Φ₁ : (Fin g₁ → ℂ) → 𝒢₁.Pts τ)
        (Φ₂ : (Fin g₂ → ℂ) → 𝒢₂.Pts τ),
        (∃ _ : DiscreteTopology Λ₁, IsZLattice ℝ Λ₁) ∧
        (∃ _ : DiscreteTopology Λ₂, IsZLattice ℝ Λ₂) ∧
        𝒢₁.IsAnalyticUniformization τ Λ₁ Φ₁ ∧ 𝒢₂.IsAnalyticUniformization τ Λ₂ Φ₂ ∧
        (∀ z, z ∈ MP.hodge.periods τ ↔ (fun i => z (Fin.cast hg i)) ∈ prodLattice Λ₁ Λ₂) ∧
        ∀ f, MP.hodge.coeff τ (MP.model.wedge f) =
          MP.model.jacDet (fun z => prodUnif e Φ₁ Φ₂ (fun i => z (Fin.cast hg i))) f) →
    ∃ (g₁ g₂ : ℕ) (M₁ : MetrizedModel A L g₁) (M₂ : MetrizedModel B L g₂),
      M₁.model = 𝒢₁ ∧ M₂.model = 𝒢₂ ∧
      M₁.hodge.modelHeight + M₂.hodge.modelHeight ≤ MP.hodge.modelHeight

/-- **`ProductMetrizationSplit` from S-an and S-alg (proved).** The change of coordinates
`Φ ↦ Φ ∘ T_τ` is done by `recoordM`, which does not change the height. -/
theorem productMetrizationSplit_of_splits (hS : ProductUnifSplits)
    (hA : ProductMetrizationOfProductUnif) : ProductMetrizationSplit := by
  intro K _ A B C eC L _ _ _ 𝒢P 𝒢₁ 𝒢₂ hPM g MP hMP
  obtain ⟨e, he₁, he₂, -⟩ := hPM
  subst hMP
  have key : ∀ τ : L →+* ℂ, ∃ T : (Fin g → ℂ) ≃ₗ[ℂ] (Fin g → ℂ),
      ∃ (g₁ g₂ : ℕ) (hg : g₁ + g₂ = g) (Λ₁ : Submodule ℤ (Fin g₁ → ℂ))
        (Λ₂ : Submodule ℤ (Fin g₂ → ℂ)) (Φ₁ : (Fin g₁ → ℂ) → 𝒢₁.Pts τ)
        (Φ₂ : (Fin g₂ → ℂ) → 𝒢₂.Pts τ),
        (∃ _ : DiscreteTopology Λ₁, IsZLattice ℝ Λ₁) ∧
        (∃ _ : DiscreteTopology Λ₂, IsZLattice ℝ Λ₂) ∧
        𝒢₁.IsAnalyticUniformization τ Λ₁ Φ₁ ∧ 𝒢₂.IsAnalyticUniformization τ Λ₂ Φ₂ ∧
        (∀ z, T z ∈ MP.hodge.periods τ ↔ (fun i => z (Fin.cast hg i)) ∈ prodLattice Λ₁ Λ₂) ∧
        ∀ f, LinearMap.det (T : (Fin g → ℂ) →ₗ[ℂ] (Fin g → ℂ)) *
            MP.hodge.coeff τ (MP.model.wedge f) =
          MP.model.jacDet (fun z => prodUnif e Φ₁ Φ₂ (fun i => z (Fin.cast hg i))) f := by
    intro τ
    obtain ⟨Φ, hΦ, hc⟩ := MP.arch τ
    have := MP.hodge.periods_discrete τ
    obtain ⟨g₁, g₂, hg, Λ₁, Λ₂, Φ₁, Φ₂, T, hl₁, hl₂, hu₁, hu₂, hT⟩ :=
      hS K A B C L MP.model 𝒢₁ 𝒢₂ e τ g (MP.hodge.periods τ) Φ
        (MP.hodge.periods_isZLattice τ) hΦ
    refine ⟨T, g₁, g₂, hg, Λ₁, Λ₂, Φ₁, Φ₂, hl₁, hl₂, hu₁, hu₂, fun z => ?_, fun f => ?_⟩
    · rw [← hΦ.2.1, hT, (prodUnif_clauses e hu₁ hu₂).2.1]
    · have hfun : (fun z => prodUnif e Φ₁ Φ₂ (fun i => z (Fin.cast hg i))) =
          fun z => Φ (T z) := funext fun z => (hT z).symm
      rw [hfun, GroupModel.jacDet_comp, hc, mul_comm]
  choose T g₁ g₂ hg Λ₁ Λ₂ Φ₁ Φ₂ hl₁ hl₂ hu₁ hu₂ hper hco using key
  obtain ⟨h₁, h₂, M₁, M₂, hM₁, hM₂, hle⟩ := @hA K _ A B C L _ _ _ 𝒢₁ 𝒢₂ g (recoordM MP T) e he₁ he₂
    (fun τ => ⟨g₁ τ, g₂ τ, hg τ, Λ₁ τ, Λ₂ τ, Φ₁ τ, Φ₂ τ, hl₁ τ, hl₂ τ, hu₁ τ, hu₂ τ,
      fun z => hper τ z, fun f => by
        show (LinearMap.det (T τ : (Fin g → ℂ) →ₗ[ℂ] (Fin g → ℂ)) • MP.hodge.coeff τ)
          (MP.model.wedge f) = _
        rw [LinearMap.smul_apply, smul_eq_mul]
        exact hco τ f⟩)
  exact ⟨h₁, h₂, M₁, M₂, hM₁, hM₂, hle.trans_eq (recoordM_modelHeight MP T)⟩

/-- **`ProductModelHeight` from S-an and S-alg (proved).** Neither half of AN3 is used: no
`AnalyticUniformizationExists`, no `AnalyticUniformizationUnique`, no `MetrizationExists`. -/
theorem productModelHeight_of_splits (hS : ProductUnifSplits)
    (hA : ProductMetrizationOfProductUnif) : ProductModelHeight :=
  productModelHeight_of_split (productMetrizationSplit_of_splits hS hA)

