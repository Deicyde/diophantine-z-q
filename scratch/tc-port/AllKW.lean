/-! Imports every vendored Tau Ceti module (1118) and the backport, then audits the axioms of
every constant declared in a module under `ZInQKernel.Contrib.TauCeti`. -/

open Lean Elab Command in
elab "#audit_tc_axioms" : command => do
  let env ← getEnv
  let std : List Name := [`propext, `Classical.choice, `Quot.sound]
  let mut n : Nat := 0
  let mut mods : NameSet := {}
  let mut union : NameSet := {}
  let mut bad : Array (Name × Array Name) := #[]
  for (c, _) in env.constants.map₁.toList do
    if let some idx := env.getModuleIdxFor? c then
      let m := env.header.moduleNames[idx.toNat]!
      if (`ZInQKernel.Contrib.TauCeti).isPrefixOf m then
        n := n + 1
        mods := mods.insert m
        let axs ← collectAxioms c
        for a in axs do union := union.insert a
        if axs.any (fun a => !std.contains a) then bad := bad.push (c, axs)
  logInfo m!"modules: {mods.size}; constants audited: {n}; axioms used (union): {union.toList}"
  logInfo m!"constants with a nonstandard axiom: {bad.size}: {bad.toList.take 30}"

#audit_tc_axioms
