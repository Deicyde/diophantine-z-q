/-! ## §1 The quaternion datum (N5 L410-420) -/

/-- `B = (2,-3)`: Mathlib's `QuaternionAlgebra R c₁ c₂ c₃` has `i² = c₁ + c₂ i`, `j² = c₃`. -/
abbrev B := QuaternionAlgebra ℚ 2 0 (-3)

/-- `i`, `j`, `k = ij` in `B`. -/
def qi : B := ⟨0, 1, 0, 0⟩
def qj : B := ⟨0, 0, 1, 0⟩
def qk : B := ⟨0, 0, 0, 1⟩

/-- N5's ordered basis `(1, i, (1+j)/2, (i+ij)/2)` of the maximal order `𝒪`. -/
def oBasis : Fin 4 → B := ![⟨1, 0, 0, 0⟩, ⟨0, 1, 0, 0⟩, ⟨1/2, 0, 1/2, 0⟩, ⟨0, 1/2, 0, 1/2⟩]

/-- Membership in `𝒪 = ℤ⟨1, i, (1+j)/2, (i+ij)/2⟩`. -/
def InO (x : B) : Prop := ∃ n : Fin 4 → ℤ, x = ∑ k, (n k : ℚ) • oBasis k

/-- `μ = 2j + ij`. -/
def mu : B := ⟨0, 0, 2, 1⟩

/-- `μ⁻¹ = -μ/6`, since `μ² = -6`. -/
def muInv : B := ⟨0, 0, -1/3, -1/6⟩

/-- Reduced trace. -/
def trd (x : B) : ℚ := 2 * x.re

theorem mu_sq : mu * mu = (⟨-6, 0, 0, 0⟩ : B) := by
  ext <;> simp [mu]; norm_num

theorem mu_mul_muInv : mu * muInv = 1 := by
  ext <;> simp [mu, muInv] <;> norm_num

/-- N5's Gram matrix (L413-415). -/
def gram : Matrix (Fin 4) (Fin 4) ℚ := !![0, 0, -1, 1; 0, 0, 1, -2; 1, -1, 0, 0; -1, 2, 0, 0]

/-- **A1 (glue, proved).** `Trd(μ⁻¹ x ȳ)` has N5's Gram matrix in N5's basis. -/
theorem gram_eq (r s : Fin 4) : trd (muInv * oBasis r * star (oBasis s)) = gram r s := by
  fin_cases r <;> fin_cases s <;> simp [trd, muInv, oBasis, gram] <;> norm_num

theorem gram_det : gram.det = 1 := by
  simp [gram, Matrix.det_succ_row_zero, Fin.sum_univ_succ]
  rw [show Fin.succAbove (2 : Fin 4) (2 : Fin 3) = 3 from rfl,
    show Fin.succAbove (3 : Fin 4) (2 : Fin 3) = 2 from rfl]
  norm_num

/-! ## §2 The real embedding and `Γ*` -/

/-- `ι(i) = [[√2,0],[0,-√2]]`. -/
def Mi : Matrix (Fin 2) (Fin 2) ℝ := !![√2, 0; 0, -√2]
/-- `ι(j) = [[0,-3],[1,0]]`. -/
def Mj : Matrix (Fin 2) (Fin 2) ℝ := !![0, -3; 1, 0]

/-- The real embedding `ι : B → M₂(ℝ)` (a ring homomorphism: `qm_embed.py` checks it on the
basis; `Mi² = 2`, `Mj² = -3`, `Mi Mj = -Mj Mi`). -/
def iota (x : B) : Matrix (Fin 2) (Fin 2) ℝ :=
  (x.re : ℝ) • 1 + (x.imI : ℝ) • Mi + (x.imJ : ℝ) • Mj + (x.imK : ℝ) • (Mi * Mj)

/-- `x ∈ B` is invertible and normalizes `𝒪`. -/
def NormalizesO (x : B) : Prop :=
  ∃ y : B, x * y = 1 ∧ y * x = 1 ∧ ∀ z : B, InO z → InO (x * z * y) ∧ InO (y * z * x)

/-- `Γ* = ι(N_B(𝒪)⁺)` acting on `ℍ`; modulo scalars this is the group of the Atkin–Lehner
quotient `X₆/W` (positive reduced norm = positive determinant). -/
def GammaStar : Set (GL (Fin 2) ℝ) :=
  {γ | ∃ x : B, NormalizesO x ∧ (γ : Matrix (Fin 2) (Fin 2) ℝ) = iota x ∧
    0 < (γ : Matrix (Fin 2) (Fin 2) ℝ).det}

end PkgI1

namespace HSyn.G0Split.FibreQM.PeriodGlue

/-- `x₄ = 1 + i + j` (reduced norm 2; `ι(x₄)` is elliptic of order 4 in `PSL₂(ℝ)`, fixing
`√2 + i`). -/
def x4 : PkgI1.B := ⟨1, 1, 1, 0⟩
/-- `x₆ = (j − 3)/2 = j(1+j)/2` (reduced norm 3; `ι(x₆)` is elliptic of order 6, fixing `i√3`). -/
def x6 : PkgI1.B := ⟨-3 / 2, 0, 1 / 2, 0⟩

/-- **LEAF candidate (generation of `Γ*`; flagged for a human check).** Every `γ ∈ Γ*` lies in
the subgroup of `GL₂(ℝ)` generated by `ι(1 + i + j)`, `ι((j − 3)/2)` and the rational scalars.

Source and derivation: `Γ*/ℚ^× = N_B(𝒪)⁺/ℚ^×` (image in `PSL₂(ℝ)`) is a Fuchsian group of
signature `(0; 2, 4, 6)`, i.e. the `(2, 4, 6)` triangle group, of covolume
`2π(−2 + 1/2 + 3/4 + 5/6) = π/6` (Takeuchi, *Commensurability classes of arithmetic triangle
groups*, J. Fac. Sci. Univ. Tokyo 24 (1977), the class of `(2, 4, 6)` with quaternion algebra of
discriminant 6; Elkies, *Shimura curve computations*, ANTS 1998, §3 (`X*(6)` and the `(2,4,6)`
group); locators UNVERIFIED). Derivation of the stated form (model argument, numerics VERIFIED in
`py/triangle.py`): `g₄ = ι(1+i+j)` and `g₆ = ι((j−3)/2)` are elliptic of orders 4 and 6 in
`PSL₂(ℝ)` (`trd² / nrd = 2, 3`), fixing `√2 + i` and `i√3`; `x₂ = 2x₆x₄⁻¹ = (3/2)i + 2j + (1/2)ij`
has `trd = 0`, so `g₆g₄⁻¹` has order 2; the hyperbolic distance `d` of the two fixed points has
`cosh d = 1 + ((√2)² + (√3 − 1)²)/(2·√3) = √3 = cot(π/4)cot(π/6)`, which is the side of the
hyperbolic triangle with angles `π/4, π/6, π/2`. By Poincaré's polygon theorem (Beardon, *The
geometry of discrete groups*, §9.8 and §10.6, UNVERIFIED) `⟨g₄, g₆⟩` is the `(2,4,6)` triangle group
of that triangle, covolume `π/6`, so it has index 1 in `Γ*/ℚ^×`; an element of `N_B(𝒪)⁺` that is
a real multiple of a word in `x₄, x₆` is a rational multiple (the center of `B` is `ℚ`). -/
def GammaStarGen : Prop :=
  ∀ γ ∈ PkgI1.GammaStar, γ ∈ Subgroup.closure
    ({γ : GL (Fin 2) ℝ | (γ : Matrix (Fin 2) (Fin 2) ℝ) = PkgI1.iota x4} ∪
      {γ : GL (Fin 2) ℝ | (γ : Matrix (Fin 2) (Fin 2) ℝ) = PkgI1.iota x6} ∪
      {γ : GL (Fin 2) ℝ | ∃ q : ℚ, q ≠ 0 ∧ (γ : Matrix (Fin 2) (Fin 2) ℝ) = (q : ℝ) • 1})

end HSyn.G0Split.FibreQM.PeriodGlue

end HDec

