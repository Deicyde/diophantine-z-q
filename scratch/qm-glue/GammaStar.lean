/-! ## The proof of `GammaStarGen` (leafq-check)

Idea (all numerics in `scratch/leafq-check/py/`). `y = i + j ∈ 𝒪` has `y² = −1`; it is the pure
quaternion of the fixed point `√2 + i` of `ι(x₄)`. For `x ∈ N(𝒪)` with `nrd x > 0` the conjugate
`v = x y x⁻¹` is again a pure element of `𝒪` with `v² = −1`, and `pairY v = −2b + 3c` (for
`v = bi + cj + dk`) is `cosh` of the hyperbolic distance between the fixed points of `v` and `y`; it
is a positive integer. If `pairY v ≥ 2`, conjugating by one of `x₆`, `x₆⁻¹`, `x₆x₄`, `(x₄x₆)⁻¹`
lowers it (the four lowerings are `b + 3d`, `b − 3d`, `−5b + 6c + 3d`, `−5b + 6c − 3d`, and
`3·nrd v − (pairY v)²` is a sum of two products of them). If `pairY v = 1` then `v = y`, so `x`
commutes with `y`, `x = a + by`, and the integrality of `x j x⁻¹` forces `x ∈ ℚ^× ⟨x₄⟩`. -/

open PkgI1

theorem sqrt2_sq' : (√2 : ℝ) * √2 = 2 := Real.mul_self_sqrt (by norm_num)

theorem iota_apply (x : PkgI1.B) : PkgI1.iota x =
    !![(x.re : ℝ) + x.imI * √2, -3 * (x.imJ : ℝ) - 3 * √2 * x.imK;
       (x.imJ : ℝ) - √2 * x.imK, (x.re : ℝ) - x.imI * √2] := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [PkgI1.iota, PkgI1.Mi, PkgI1.Mj, Matrix.mul_apply, Fin.sum_univ_two] <;> ring

theorem iota_mul (x y : PkgI1.B) : PkgI1.iota (x * y) = PkgI1.iota x * PkgI1.iota y := by
  rw [iota_apply, iota_apply, iota_apply]
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [Matrix.mul_apply, Fin.sum_univ_two] <;> ring_nf <;>
    (try simp only [Real.sq_sqrt (show (0 : ℝ) ≤ 2 by norm_num)]) <;> (try ring_nf)

/-- The reduced norm. -/
def nrd (x : PkgI1.B) : ℚ := x.re ^ 2 - 2 * x.imI ^ 2 + 3 * x.imJ ^ 2 - 6 * x.imK ^ 2

theorem det_iota_eq (x : PkgI1.B) : (PkgI1.iota x).det = (nrd x : ℝ) := by
  rw [iota_apply, Matrix.det_fin_two_of, nrd]
  push_cast
  linear_combination (-(x.imI : ℝ) ^ 2 - 3 * (x.imK : ℝ) ^ 2) * sqrt2_sq'

theorem nrd_mul (x y : PkgI1.B) : nrd (x * y) = nrd x * nrd y := by
  simp [nrd]; ring

theorem iota_ratCast (q : ℚ) : PkgI1.iota (q : PkgI1.B) = (q : ℝ) • 1 := by
  rw [iota_apply]; ext i j; fin_cases i <;> fin_cases j <;> simp

/-- `y = i + j`. -/
def yq : PkgI1.B := ⟨0, 1, 1, 0⟩
/-- `⟨v, y⟩` for the bilinear form of `nrd` on pure quaternions (`= cosh d` on the hyperboloid). -/
def pairY (v : PkgI1.B) : ℚ := -2 * v.imI + 3 * v.imJ
/-- `x₄⁻¹`. -/
def x4i : PkgI1.B := ⟨1 / 2, -1 / 2, -1 / 2, 0⟩
/-- `x₆⁻¹`. -/
def x6i : PkgI1.B := ⟨-1 / 2, 0, -1 / 6, 0⟩

theorem yq_sq : yq * yq = -1 := by ext <;> simp [yq] <;> norm_num

/-! ### Membership in `𝒪` by coordinates -/

theorem inO_iff (v : PkgI1.B) : PkgI1.InO v ↔ ∃ n0 n1 n2 n3 : ℤ,
    v = ⟨n0 + n2 / 2, n1 + n3 / 2, n2 / 2, n3 / 2⟩ := by
  constructor
  · rintro ⟨n, rfl⟩
    refine ⟨n 0, n 1, n 2, n 3, ?_⟩
    ext <;> simp [PkgI1.oBasis, Fin.sum_univ_four] <;> ring
  · rintro ⟨n0, n1, n2, n3, rfl⟩
    refine ⟨![n0, n1, n2, n3], ?_⟩
    ext <;> simp [PkgI1.oBasis, Fin.sum_univ_four] <;> ring

theorem inO_yq : PkgI1.InO yq := (inO_iff _).2 ⟨-1, 1, 2, 0, by ext <;> simp [yq] <;> norm_num⟩
theorem inO_qj : PkgI1.InO PkgI1.qj :=
  (inO_iff _).2 ⟨-1, 0, 2, 0, by ext <;> simp [PkgI1.qj] <;> norm_num⟩

/-! ### `x₄`, `x₆` normalize `𝒪` -/

theorem conj_x4 : ∀ w, PkgI1.InO w → PkgI1.InO (x4 * w * x4i) ∧ PkgI1.InO (x4i * w * x4) := by
  intro w hw
  obtain ⟨n0, n1, n2, n3, rfl⟩ := (inO_iff w).1 hw
  constructor
  · refine (inO_iff _).2 ⟨n0 + 2*n1 - n2, -n1 + n2 + n3, -4*n1 + 3*n2, -2*n1 + n2 - n3, ?_⟩
    ext <;> simp [x4, x4i] <;> ring
  · refine (inO_iff _).2 ⟨n0 + 2*n1 - n2 + 2*n3, -3*n1 + 2*n2 - 3*n3, -4*n1 + 3*n2 - 4*n3,
      2*n1 - n2 + n3, ?_⟩
    ext <;> simp [x4, x4i] <;> ring

theorem conj_x6 : ∀ w, PkgI1.InO w → PkgI1.InO (x6 * w * x6i) ∧ PkgI1.InO (x6i * w * x6) := by
  intro w hw
  obtain ⟨n0, n1, n2, n3, rfl⟩ := (inO_iff w).1 hw
  constructor
  · refine (inO_iff _).2 ⟨n0, -n3, n2, n1 + n3, ?_⟩
    ext <;> simp [x6, x6i] <;> ring
  · refine (inO_iff _).2 ⟨n0, n1 + n3, n2, -n1, ?_⟩
    ext <;> simp [x6, x6i] <;> ring

theorem x4_x4i : x4 * x4i = 1 := by ext <;> simp [x4, x4i] <;> norm_num
theorem x4i_x4 : x4i * x4 = 1 := by ext <;> simp [x4, x4i] <;> norm_num
theorem x6_x6i : x6 * x6i = 1 := by ext <;> simp [x6, x6i] <;> norm_num
theorem x6i_x6 : x6i * x6 = 1 := by ext <;> simp [x6, x6i] <;> norm_num

/-! ### Elementary quaternion facts -/

theorem pure_of_sq {v : PkgI1.B} (h : v * v = -1) :
    v.re = 0 ∧ -2 * v.imI ^ 2 + 3 * v.imJ ^ 2 - 6 * v.imK ^ 2 = 1 := by
  have h1 : v.re ^ 2 + 2 * v.imI ^ 2 - 3 * v.imJ ^ 2 + 6 * v.imK ^ 2 = -1 := by
    have := congrArg QuaternionAlgebra.re h; simp at this; linear_combination this
  have h2 : v.re * v.imI = 0 := by
    have := congrArg QuaternionAlgebra.imI h; simp at this; linear_combination this / 2
  have h3 : v.re * v.imJ = 0 := by
    have := congrArg QuaternionAlgebra.imJ h; simp at this; linear_combination this / 2
  have h4 : v.re * v.imK = 0 := by
    have := congrArg QuaternionAlgebra.imK h; simp at this; linear_combination this / 2
  have key : v.re ^ 2 * (v.re ^ 2 + 1) = 0 := by
    linear_combination v.re ^ 2 * h1 - 2 * (v.re * v.imI) * h2 + 3 * (v.re * v.imJ) * h3
      - 6 * (v.re * v.imK) * h4
  have hre : v.re = 0 := by
    rcases mul_eq_zero.1 key with h | h
    · exact pow_eq_zero_iff (n := 2) (by norm_num) |>.1 h
    · nlinarith [sq_nonneg v.re]
  refine ⟨hre, ?_⟩
  rw [hre] at h1; linear_combination -h1

theorem inv_eq {x z : PkgI1.B} (hxz : x * z = 1) (hN : nrd x ≠ 0) :
    z = ⟨x.re / nrd x, -x.imI / nrd x, -x.imJ / nrd x, -x.imK / nrd x⟩ := by
  set w : PkgI1.B := ⟨x.re / nrd x, -x.imI / nrd x, -x.imJ / nrd x, -x.imK / nrd x⟩ with hw_def
  have hN' : x.re ^ 2 - 2 * x.imI ^ 2 + 3 * x.imJ ^ 2 - 6 * x.imK ^ 2 ≠ 0 := hN
  have hw : w * x = 1 := by
    ext <;> simp [w, nrd] <;> field_simp <;> ring
  calc z = (w * x) * z := by rw [hw, one_mul]
    _ = w * (x * z) := mul_assoc _ _ _
    _ = w := by rw [hxz, mul_one]

theorem pairY_ge {x z : PkgI1.B} (hxz : x * z = 1) (hpos : 0 < nrd x) :
    1 ≤ pairY (x * yq * z) := by
  rw [inv_eq hxz hpos.ne']
  have hN' : 0 < x.re ^ 2 - 2 * x.imI ^ 2 + 3 * x.imJ ^ 2 - 6 * x.imK ^ 2 := hpos
  have e : pairY (x * yq * ⟨x.re / nrd x, -x.imI / nrd x, -x.imJ / nrd x, -x.imK / nrd x⟩) =
      1 + 12 * ((x.imI - x.imJ) ^ 2 + x.imK ^ 2) /
        (x.re ^ 2 - 2 * x.imI ^ 2 + 3 * x.imJ ^ 2 - 6 * x.imK ^ 2) := by
    simp [pairY, yq, nrd]; field_simp; ring
  rw [e]
  have : 0 ≤ 12 * ((x.imI - x.imJ) ^ 2 + x.imK ^ 2) /
      (x.re ^ 2 - 2 * x.imI ^ 2 + 3 * x.imJ ^ 2 - 6 * x.imK ^ 2) := by positivity
  linarith

theorem conj_sq {x z : PkgI1.B} (hxz : x * z = 1) (hzx : z * x = 1) :
    (x * yq * z) * (x * yq * z) = -1 := by
  calc (x * yq * z) * (x * yq * z) = x * (yq * ((z * x) * (yq * z))) := by
        simp only [mul_assoc]
    _ = -(x * z) := by rw [hzx, one_mul, ← mul_assoc yq yq z, yq_sq]; simp
    _ = -1 := by rw [hxz]

theorem pairY_int {v : PkgI1.B} (hv : PkgI1.InO v) (hre : v.re = 0) : ∃ m : ℤ, pairY v = m := by
  obtain ⟨n0, n1, n2, n3, rfl⟩ := (inO_iff v).1 hv
  have h : (n2 : ℚ) = -2 * n0 := by
    have := hre; simp only at this; linarith
  refine ⟨-2 * n1 - n3 - 3 * n0, ?_⟩
  simp only [pairY]; push_cast; rw [h]; ring

theorem eq_yq {v : PkgI1.B} (hre : v.re = 0) (hn : -2 * v.imI ^ 2 + 3 * v.imJ ^ 2 - 6 * v.imK ^ 2 = 1)
    (h1 : pairY v = 1) : v = yq := by
  have h3 : 3 * v.imJ = 1 + 2 * v.imI := by simp only [pairY] at h1; linarith
  have key : (v.imI - 1) ^ 2 + 9 * v.imK ^ 2 = 0 := by
    linear_combination (-3 / 2) * hn + (1 / 2) * (3 * v.imJ + 1 + 2 * v.imI) * h3
  have hb : v.imI = 1 := by nlinarith [sq_nonneg (v.imI - 1), sq_nonneg v.imK]
  have hd : v.imK = 0 := by nlinarith [sq_nonneg (v.imI - 1), sq_nonneg v.imK]
  have hc : v.imJ = 1 := by linarith
  ext <;> simp [yq, hre, hb, hc, hd]

/-! ### The subgroup and the predicate `P` -/

/-- The subgroup of the statement. -/
def Hgen : Subgroup (GL (Fin 2) ℝ) := Subgroup.closure
    ({γ : GL (Fin 2) ℝ | (γ : Matrix (Fin 2) (Fin 2) ℝ) = PkgI1.iota x4} ∪
      {γ : GL (Fin 2) ℝ | (γ : Matrix (Fin 2) (Fin 2) ℝ) = PkgI1.iota x6} ∪
      {γ : GL (Fin 2) ℝ | ∃ q : ℚ, q ≠ 0 ∧ (γ : Matrix (Fin 2) (Fin 2) ℝ) = (q : ℝ) • 1})

/-- Every element of `GL₂(ℝ)` with matrix `ι(x)` lies in the subgroup. -/
def P (x : PkgI1.B) : Prop :=
  ∀ γ : GL (Fin 2) ℝ, (γ : Matrix (Fin 2) (Fin 2) ℝ) = PkgI1.iota x → γ ∈ Hgen

theorem det_ne {x : PkgI1.B} (h : nrd x ≠ 0) : (PkgI1.iota x).det ≠ 0 := by
  rw [det_iota_eq]; exact_mod_cast h

/-- The element of `GL₂(ℝ)` with matrix `ι(x)`. -/
noncomputable def glOf (x : PkgI1.B) (h : nrd x ≠ 0) : GL (Fin 2) ℝ :=
  Matrix.GeneralLinearGroup.mkOfDetNeZero (PkgI1.iota x) (det_ne h)

theorem coe_glOf (x : PkgI1.B) (h : nrd x ≠ 0) :
    (glOf x h : Matrix (Fin 2) (Fin 2) ℝ) = PkgI1.iota x := rfl

theorem P_x4 : P x4 := fun _ h => Subgroup.subset_closure (Or.inl (Or.inl h))
theorem P_x6 : P x6 := fun _ h => Subgroup.subset_closure (Or.inl (Or.inr h))
theorem P_rat (q : ℚ) (hq : q ≠ 0) : P (q : PkgI1.B) := fun _ h =>
  Subgroup.subset_closure (Or.inr ⟨q, hq, h.trans (iota_ratCast q)⟩)

theorem P_mul {s x : PkgI1.B} (hs : P s) (hx : P x) (ds : nrd s ≠ 0) (dx : nrd x ≠ 0) :
    P (s * x) := by
  intro γ hγ
  have : γ = glOf s ds * glOf x dx := by
    ext1; rw [Units.val_mul, coe_glOf, coe_glOf, hγ, iota_mul]
  rw [this]; exact Hgen.mul_mem (hs _ rfl) (hx _ rfl)

theorem P_cancel {s x : PkgI1.B} (hs : P s) (hsx : P (s * x)) (ds : nrd s ≠ 0) : P x := by
  intro γ hγ
  have h1 : glOf s ds * γ ∈ Hgen := hsx _ (by rw [Units.val_mul, coe_glOf, hγ, iota_mul])
  have : γ = (glOf s ds)⁻¹ * (glOf s ds * γ) := by group
  rw [this]; exact Hgen.mul_mem (Hgen.inv_mem (hs _ rfl)) h1

theorem P_x4i : P x4i := by
  refine P_cancel P_x4 ?_ (by norm_num [nrd, x4])
  rw [x4_x4i]; simpa using P_rat 1 one_ne_zero

theorem P_x6i : P x6i := by
  refine P_cancel P_x6 ?_ (by norm_num [nrd, x6])
  rw [x6_x6i]; simpa using P_rat 1 one_ne_zero

/-! ### The descent step -/

theorem descent {v : PkgI1.B} (hre : v.re = 0)
    (hn : -2 * v.imI ^ 2 + 3 * v.imJ ^ 2 - 6 * v.imK ^ 2 = 1) (h2 : 2 ≤ pairY v) :
    pairY (x6 * v * x6i) < pairY v ∨ pairY (x6i * v * x6) < pairY v ∨
      pairY (x6 * x4 * v * (x4i * x6i)) < pairY v ∨
      pairY (x6i * x4i * v * (x4 * x6)) < pairY v := by
  have e1 : pairY (x6 * v * x6i) = -v.imI + 3 * v.imJ + 3 * v.imK := by
    simp [pairY, x6, x6i, hre]; ring
  have e2 : pairY (x6i * v * x6) = -v.imI + 3 * v.imJ - 3 * v.imK := by
    simp [pairY, x6, x6i, hre]; ring
  have e3 : pairY (x6 * x4 * v * (x4i * x6i)) = -7 * v.imI + 9 * v.imJ + 3 * v.imK := by
    simp [pairY, x6, x6i, x4, x4i, hre]; ring
  have e4 : pairY (x6i * x4i * v * (x4 * x6)) = -7 * v.imI + 9 * v.imJ - 3 * v.imK := by
    simp [pairY, x6, x6i, x4, x4i, hre]; ring
  rw [e1, e2, e3, e4]
  by_contra hc
  push_neg at hc
  obtain ⟨c1, c2, c3, c4⟩ := hc
  simp only [pairY] at h2 c1 c2 c3 c4
  nlinarith [mul_nonneg (sub_nonneg.2 c1) (sub_nonneg.2 c4),
    mul_nonneg (sub_nonneg.2 c2) (sub_nonneg.2 c3)]

/-! ### The base case: `x` commutes with `y` -/

theorem nrd_ratCast (q : ℚ) : nrd (q : PkgI1.B) = q ^ 2 := by simp [nrd]

theorem P_base {x z : PkgI1.B} (hxz : x * z = 1) (hzx : z * x = 1)
    (hN : ∀ w, PkgI1.InO w → PkgI1.InO (x * w * z) ∧ PkgI1.InO (z * w * x))
    (hpos : 0 < nrd x) (hv : x * yq * z = yq) : P x := by
  have hcomm : x * yq = yq * x := by
    calc x * yq = x * yq * (z * x) := by rw [hzx, mul_one]
      _ = (x * yq * z) * x := by simp only [mul_assoc]
      _ = yq * x := by rw [hv]
  have hd : x.imK = 0 := by
    have := congrArg QuaternionAlgebra.imI hcomm; simp [yq] at this; linarith
  have hc : x.imJ = x.imI := by
    have := congrArg QuaternionAlgebra.imK hcomm; simp [yq] at this; linarith
  obtain ⟨a, b, hx⟩ : ∃ a b : ℚ, x = ⟨a, b, b, 0⟩ :=
    ⟨x.re, x.imI, by ext <;> simp [hc, hd]⟩
  have hNx : nrd x = a ^ 2 + b ^ 2 := by rw [hx]; simp only [nrd]; ring
  have hN' : 0 < a ^ 2 + b ^ 2 := hNx ▸ hpos
  have hu_eq : x * PkgI1.qj * z =
      ⟨0, 6 * b ^ 2 / (a ^ 2 + b ^ 2), (a ^ 2 + 5 * b ^ 2) / (a ^ 2 + b ^ 2),
        2 * a * b / (a ^ 2 + b ^ 2)⟩ := by
    rw [inv_eq hxz hpos.ne', hNx, hx]
    ext <;> simp [PkgI1.qj] <;> field_simp <;> ring
  obtain ⟨n0, n1, n2, n3, hu'⟩ := (inO_iff _).1 (hN _ inO_qj).1
  rw [hu_eq] at hu'
  have eJ : (a ^ 2 + 5 * b ^ 2) / (a ^ 2 + b ^ 2) = (n2 : ℚ) / 2 :=
    congrArg QuaternionAlgebra.imJ hu'
  have eK : 2 * a * b / (a ^ 2 + b ^ 2) = (n3 : ℚ) / 2 := congrArg QuaternionAlgebra.imK hu'
  have hn2 : (n2 : ℚ) = 2 * (a ^ 2 + 5 * b ^ 2) / (a ^ 2 + b ^ 2) := by
    rw [mul_div_assoc, eJ]; ring
  have hn3 : (n3 : ℚ) = 4 * a * b / (a ^ 2 + b ^ 2) := by
    rw [show 4 * a * b / (a ^ 2 + b ^ 2) = 2 * (2 * a * b / (a ^ 2 + b ^ 2)) by ring, eK]; ring
  have hq : ((n2 : ℚ) - 6) ^ 2 + 4 * (n3 : ℚ) ^ 2 = 16 := by
    rw [hn2, hn3]; field_simp; ring
  have hz : (n2 - 6) ^ 2 + 4 * n3 ^ 2 = 16 := by exact_mod_cast hq
  have hn3b : -2 ≤ n3 ∧ n3 ≤ 2 := by constructor <;> nlinarith [sq_nonneg (n2 - 6)]
  have hn2b : 2 ≤ n2 ∧ n2 ≤ 10 := by constructor <;> nlinarith [sq_nonneg n3]
  have hcase : n2 = 2 ∨ n2 = 6 ∨ n2 = 10 := by
    obtain ⟨l3, u3⟩ := hn3b; obtain ⟨l2, u2⟩ := hn2b
    interval_cases n3 <;> interval_cases n2 <;> first | omega | (exfalso; revert hz; norm_num)
  have hb2 : (n2 : ℚ) * (a ^ 2 + b ^ 2) = 2 * (a ^ 2 + 5 * b ^ 2) := by
    rw [hn2]; field_simp
  have nx4 : nrd x4 ≠ 0 := by norm_num [nrd, x4]
  have nx4i : nrd x4i ≠ 0 := by norm_num [nrd, x4i]
  rcases hcase with h | h | h
  · -- `b = 0`: `x = a`
    rw [h] at hb2; push_cast at hb2
    have hb0 : b = 0 := by nlinarith [sq_nonneg b]
    have ha0 : a ≠ 0 := by intro h0; rw [hb0, h0] at hN'; norm_num at hN'
    have : x = ((a : ℚ) : PkgI1.B) := by rw [hx, hb0]; ext <;> simp
    rw [this]; exact P_rat a ha0
  · -- `a = ± b`
    rw [h] at hb2; push_cast at hb2
    have hab : (b - a) * (b + a) = 0 := by linear_combination (-1 / 4) * hb2
    have ha0 : a ≠ 0 := by
      intro h0; rw [h0] at hab; have : b = 0 := by nlinarith [sq_nonneg b]
      rw [h0, this] at hN'; norm_num at hN'
    rcases mul_eq_zero.1 hab with h' | h'
    · have : x = ((a : ℚ) : PkgI1.B) * x4 := by
        rw [hx, show b = a by linarith]; ext <;> simp [x4]
      rw [this]
      exact P_mul (P_rat a ha0) P_x4 (by rw [nrd_ratCast]; exact pow_ne_zero 2 ha0) nx4
    · have : x = ((2 * a : ℚ) : PkgI1.B) * x4i := by
        rw [hx, show b = -a by linarith]
        ext <;> simp [x4i, QuaternionAlgebra.re_ofNat, QuaternionAlgebra.imI_ofNat,
          QuaternionAlgebra.imJ_ofNat, QuaternionAlgebra.imK_ofNat] <;> ring
      have h2a : (2 * a : ℚ) ≠ 0 := mul_ne_zero two_ne_zero ha0
      rw [this]
      exact P_mul (P_rat (2 * a) h2a) P_x4i (by rw [nrd_ratCast]; exact pow_ne_zero 2 h2a) nx4i
  · -- `a = 0`: `x = b y = (b/2) x₄²`
    rw [h] at hb2; push_cast at hb2
    have ha0 : a = 0 := by nlinarith [sq_nonneg a]
    have hb0 : b ≠ 0 := by intro h0; rw [ha0, h0] at hN'; norm_num at hN'
    have : x = ((b / 2 : ℚ) : PkgI1.B) * (x4 * x4) := by
      have h44 : x4 * x4 = ⟨0, 2, 2, 0⟩ := by ext <;> simp [x4] <;> norm_num
      rw [hx, ha0, h44]; ext <;> simp <;> ring
    have hb2' : (b / 2 : ℚ) ≠ 0 := div_ne_zero hb0 two_ne_zero
    rw [this]
    have h44 : nrd (x4 * x4) ≠ 0 := by rw [nrd_mul]; exact mul_ne_zero nx4 nx4
    exact P_mul (P_rat (b / 2) hb2') (P_mul P_x4 P_x4 nx4 nx4)
      (by rw [nrd_ratCast]; exact pow_ne_zero 2 hb2') h44

/-! ### The induction -/

theorem nrd_x6 : nrd x6 = 3 := by norm_num [nrd, x6]
theorem nrd_x6i : nrd x6i = 1 / 3 := by norm_num [nrd, x6i]
theorem nrd_x4 : nrd x4 = 2 := by norm_num [nrd, x4]
theorem nrd_x4i : nrd x4i = 1 / 2 := by norm_num [nrd, x4i]

/-- One step: if `(s, si)` is a pair of mutually inverse normalizers of `𝒪` with `P s`, `nrd s > 0`,
the claim for `s * x` gives the claim for `x`. -/
theorem key (n : ℕ) : ∀ x z : PkgI1.B, x * z = 1 → z * x = 1 →
    (∀ w, PkgI1.InO w → PkgI1.InO (x * w * z) ∧ PkgI1.InO (z * w * x)) → 0 < nrd x →
    pairY (x * yq * z) ≤ n → P x := by
  induction n with
  | zero =>
    intro x z hxz _ _ hpos hle
    have := pairY_ge hxz hpos
    push_cast at hle; linarith
  | succ n ih =>
    intro x z hxz hzx hN hpos hle
    have hvO : PkgI1.InO (x * yq * z) := (hN _ inO_yq).1
    obtain ⟨hre, hn⟩ := pure_of_sq (conj_sq hxz hzx)
    obtain ⟨m, hm⟩ := pairY_int hvO hre
    have hge := pairY_ge hxz hpos
    -- a step by a pair `(s, si)`
    have step : ∀ s si : PkgI1.B, s * si = 1 → si * s = 1 →
        (∀ w, PkgI1.InO w → PkgI1.InO (s * w * si) ∧ PkgI1.InO (si * w * s)) →
        P s → 0 < nrd s → pairY (s * (x * yq * z) * si) < pairY (x * yq * z) → P x := by
      intro s si hs1 hs2 hsN hPs hspos hlt
      have hx' : P (s * x) := by
        refine ih (s * x) (z * si) ?_ ?_ ?_ ?_ ?_
        · calc s * x * (z * si) = s * (x * z) * si := by simp only [mul_assoc]
            _ = 1 := by rw [hxz, mul_one, hs1]
        · calc z * si * (s * x) = z * (si * s) * x := by simp only [mul_assoc]
            _ = 1 := by rw [hs2, mul_one, hzx]
        · intro w hw
          constructor
          · have := (hsN _ (hN w hw).1).1
            have e : s * x * w * (z * si) = s * (x * w * z) * si := by simp only [mul_assoc]
            rw [e]; exact this
          · have := (hN _ (hsN w hw).2).2
            have e : z * si * w * (s * x) = z * (si * w * s) * x := by simp only [mul_assoc]
            rw [e]; exact this
        · rw [nrd_mul]; exact mul_pos hspos hpos
        · have hvO' : PkgI1.InO (s * (x * yq * z) * si) := (hsN _ hvO).1
          have hsq : (s * (x * yq * z) * si) * (s * (x * yq * z) * si) = -1 := by
            calc (s * (x * yq * z) * si) * (s * (x * yq * z) * si)
                = s * ((x * yq * z) * ((si * s) * (x * yq * z))) * si := by
                  simp only [mul_assoc]
              _ = -1 := by
                  rw [hs2, one_mul, conj_sq hxz hzx]; simp [hs1]
          obtain ⟨hre', _⟩ := pure_of_sq hsq
          obtain ⟨m', hm'⟩ := pairY_int hvO' hre'
          have e : s * x * yq * (z * si) = s * (x * yq * z) * si := by simp only [mul_assoc]
          rw [e, hm']
          rw [hm, hm'] at hlt
          have hlt' : m' < m := by exact_mod_cast hlt
          have hle' : (m : ℚ) ≤ (n + 1 : ℕ) := hm ▸ hle
          have : m ≤ (n + 1 : ℤ) := by exact_mod_cast hle'
          have : (m' : ℚ) ≤ (n : ℤ) := by exact_mod_cast (by omega : m' ≤ (n : ℤ))
          exact_mod_cast this
      exact P_cancel hPs hx' hspos.ne'
    by_cases h1 : pairY (x * yq * z) = 1
    · exact P_base hxz hzx hN hpos (eq_yq hre hn h1)
    · have h2 : 2 ≤ pairY (x * yq * z) := by
        rw [hm] at h1 hge ⊢
        have : (1 : ℤ) ≤ m := by exact_mod_cast hge
        have : m ≠ 1 := by intro h; apply h1; rw [h]; norm_num
        have : (2 : ℤ) ≤ m := by omega
        exact_mod_cast this
      have hN6 := conj_x6
      have hN4 := conj_x4
      rcases descent hre hn h2 with h | h | h | h
      · exact step x6 x6i x6_x6i x6i_x6 conj_x6 P_x6 (by rw [nrd_x6]; norm_num) h
      · exact step x6i x6 x6i_x6 x6_x6i (fun w hw => ⟨(conj_x6 w hw).2, (conj_x6 w hw).1⟩)
          P_x6i (by rw [nrd_x6i]; norm_num) h
      · refine step (x6 * x4) (x4i * x6i) ?_ ?_ ?_
          (P_mul P_x6 P_x4 (by rw [nrd_x6]; norm_num) (by rw [nrd_x4]; norm_num))
          (by rw [nrd_mul, nrd_x6, nrd_x4]; norm_num) ?_
        · calc x6 * x4 * (x4i * x6i) = x6 * (x4 * x4i) * x6i := by simp only [mul_assoc]
            _ = 1 := by rw [x4_x4i, mul_one, x6_x6i]
        · calc x4i * x6i * (x6 * x4) = x4i * (x6i * x6) * x4 := by simp only [mul_assoc]
            _ = 1 := by rw [x6i_x6, mul_one, x4i_x4]
        · intro w hw
          constructor
          · have := (conj_x6 _ (conj_x4 w hw).1).1
            have e : x6 * x4 * w * (x4i * x6i) = x6 * (x4 * w * x4i) * x6i := by simp only [mul_assoc]
            rw [e]; exact this
          · have := (conj_x4 _ (conj_x6 w hw).2).2
            have e : x4i * x6i * w * (x6 * x4) = x4i * (x6i * w * x6) * x4 := by simp only [mul_assoc]
            rw [e]; exact this
        · simpa only [mul_assoc] using h
      · refine step (x6i * x4i) (x4 * x6) ?_ ?_ ?_
          (P_mul P_x6i P_x4i (by rw [nrd_x6i]; norm_num) (by rw [nrd_x4i]; norm_num))
          (by rw [nrd_mul, nrd_x6i, nrd_x4i]; norm_num) ?_
        · calc x6i * x4i * (x4 * x6) = x6i * (x4i * x4) * x6 := by simp only [mul_assoc]
            _ = 1 := by rw [x4i_x4, mul_one, x6i_x6]
        · calc x4 * x6 * (x6i * x4i) = x4 * (x6 * x6i) * x4i := by simp only [mul_assoc]
            _ = 1 := by rw [x6_x6i, mul_one, x4_x4i]
        · intro w hw
          constructor
          · have := (conj_x6 _ (conj_x4 w hw).2).2
            have e : x6i * x4i * w * (x4 * x6) = x6i * (x4i * w * x4) * x6 := by simp only [mul_assoc]
            rw [e]; exact this
          · have := (conj_x4 _ (conj_x6 w hw).1).1
            have e : x4 * x6 * w * (x6i * x4i) = x4 * (x6 * w * x6i) * x4i := by simp only [mul_assoc]
            rw [e]; exact this
        · simpa only [mul_assoc] using h

/-! ### `GammaStarGen` -/

/-- **`GammaStarGen` is a theorem** (leafq-check; from Mathlib only, no leaf). -/
theorem gammaStarGen_proof : HSyn.G0Split.FibreQM.PeriodGlue.GammaStarGen := by
  intro γ hγ
  obtain ⟨x, ⟨z, hxz, hzx, hN⟩, hγx, hdet⟩ := hγ
  have hpos : 0 < nrd x := by
    rw [hγx, det_iota_eq] at hdet; exact_mod_cast hdet
  exact key ⌈pairY (x * yq * z)⌉₊ x z hxz hzx hN hpos (Nat.le_ceil _) γ hγx



end HDec.LeafQCheck

/-! ## The statements, copied verbatim from `scratch/qm-split/Valence.lean` (l.76-95, 119-132, 157-177) -/

namespace HDec.LeafQCheck

open PkgI1

namespace QMSplitVB

open UpperHalfPlane (num denom denom_ne_zero)

open scoped ENNReal

/-- **`Γ` acts on `ℍ` as a cocompact Fuchsian group**: a group of matrices of positive determinant whose
Möbius action is properly discontinuous (only finitely many Möbius maps of `Γ` move a compact set to meet
itself) with a compact set meeting every orbit. (Scalars are allowed in `Γ`: they act trivially.) -/
structure IsCocompactFuchsian (Γ : Set (GL (Fin 2) ℝ)) : Prop where
  one_mem : 1 ∈ Γ
  mul_mem : ∀ a ∈ Γ, ∀ b ∈ Γ, a * b ∈ Γ
  inv_mem : ∀ a ∈ Γ, a⁻¹ ∈ Γ
  det_pos : ∀ a ∈ Γ, 0 < (a : Matrix (Fin 2) (Fin 2) ℝ).det
  properlyDiscontinuous : ∀ K : Set UpperHalfPlane, IsCompact K →
    {f : UpperHalfPlane → UpperHalfPlane | ∃ γ ∈ Γ, f = (fun z => γ • z) ∧ (f '' K ∩ K).Nonempty}.Finite
  cocompact : ∃ C : Set UpperHalfPlane, IsCompact C ∧ ∀ z, ∃ γ ∈ Γ, γ • z ∈ C

/-- **A fundamental domain of `Γ` on `ℍ`**: measurable, meets every orbit, and almost disjoint from its
translates by the Möbius maps of `Γ` other than the identity (measure: Mathlib's `GL(2, ℝ)`-invariant
measure `dx dy / y²` on `ℍ`, `UpperHalfPlane.volume_def`). -/
def IsFundDomain (Γ : Set (GL (Fin 2) ℝ)) (s : Set UpperHalfPlane) : Prop :=
  MeasurableSet s ∧ (∀ z, ∃ γ ∈ Γ, γ • z ∈ s) ∧
    ∀ γ ∈ Γ, (fun z : UpperHalfPlane => γ • z) ≠ id →
      MeasureTheory.volume (s ∩ (fun z : UpperHalfPlane => γ • z) ⁻¹' s) = 0


/-- **GLUE (`Γ*` is a cocompact Fuchsian group with covolume `π/6`).** `Γ* = ι(N_B(𝒪)⁺)` acts on `ℍ` as a
cocompact Fuchsian group and has a fundamental domain of hyperbolic area `π/6`.

What it needs (published; locators UNVERIFIED): `𝒪¹` (norm-one units of the maximal order of the indefinite
division algebra `B`) is a cocompact Fuchsian group (Shimura 1971, §9.2, Prop. 9.2 / Thm. 9.3); Shimizu's
volume formula `vol(𝒪¹\ℍ) = (π/3) ∏_{p | 6} (p − 1) = 2π/3` (Shimizu, Ann. of Math. 81 (1965); Vignéras,
*Arithmétique des algèbres de quaternions*, IV §1; Voight, *Quaternion algebras*, Thm. 39.1.13); the index
`[Γ* : ℚ^× 𝒪¹] = 4` modulo scalars (`N_B(𝒪)⁺/ℚ^×𝒪¹ ≅ W ≅ (ℤ/2)²`, the Atkin–Lehner group; the chain's
`tt` representatives and pkg-I1's `x4`, `x6`); and the comparison of fundamental domains under a subgroup of
finite index. Equivalently: `Γ*/ℚ^×` is the triangle group `(2, 4, 6)` (Takeuchi, J. Fac. Sci. Univ. Tokyo 24
(1977)) and Gauss–Bonnet gives area `2(π − π/2 − π/4 − π/6) = π/6`. -/
def GammaStarCocompactArea : Prop :=
  IsCocompactFuchsian PkgI1.GammaStar ∧
    ∃ s, IsFundDomain PkgI1.GammaStar s ∧ MeasureTheory.volume s = ENNReal.ofReal (Real.pi / 6)

/-- `Γ¹ = ι(𝒪¹)`: the images of the norm-one units of `𝒪` (`det ι(x) = nrd(x)`). -/
def Gamma1 : Set (GL (Fin 2) ℝ) :=
  {γ | ∃ x : PkgI1.B, PkgI1.InO x ∧ (γ : Matrix (Fin 2) (Fin 2) ℝ) = PkgI1.iota x ∧
    (γ : Matrix (Fin 2) (Fin 2) ℝ).det = 1}

/-- **LEAF (Shimura; Shimizu's volume formula).** `Γ¹ = ι(𝒪¹)`, for the maximal order `𝒪` of the indefinite
division algebra `B` of discriminant `6`, is a cocompact Fuchsian group, with a fundamental domain of
hyperbolic area `(π/3) ∏_{p | 6} (p − 1) = 2π/3`. Shimura, *Introduction to the arithmetic theory of
automorphic functions*, 1971, Prop. 9.2 (cocompactness); H. Shimizu, *On zeta functions of quaternion
algebras*, Ann. of Math. 81 (1965) (volume); Vignéras, *Arithmétique des algèbres de quaternions*, LNM 800,
IV §1; Voight, *Quaternion algebras*, Thm 39.1.13; locators UNVERIFIED. -/
def ShimizuCovolumeO1 : Prop :=
  IsCocompactFuchsian Gamma1 ∧
    ∃ s, IsFundDomain Gamma1 s ∧ MeasureTheory.volume s = ENNReal.ofReal (2 * Real.pi / 3)

/-- **GLUE (from `𝒪¹` to `Γ*`).** Shimizu's statement for `Γ¹` gives `GammaStarCocompactArea`. What it needs:
`Γ¹ ⊆ Γ*`, the index `[Γ* : ℚ^×Γ¹] = 4` of the Möbius groups (`N_B(𝒪)⁺/ℚ^×𝒪^×₊ ≅ W`, representatives
`1, x₄, x₆, x₄x₆` up to `𝒪¹`; `GammaStarGen` and the chain's `tt` representatives), proper discontinuity and
cocompactness of a finite-index supergroup, and the comparison of fundamental domains (area divided by the
index). Project glue (measure theory and an index computation). -/
def GammaStarFromO1 : Prop := ShimizuCovolumeO1 → GammaStarCocompactArea

end QMSplitVB

end HDec.LeafQCheck

/-! ## §1 Algebra: the four cosets of `ℚ^×Γ¹` in `Γ*` -/

namespace HDec.LeafQCheck.QMglue

open PkgI1 QMSplitVB
open HSyn.G0Split.FibreQM.PeriodGlue (x4 x6 GammaStarGen)

abbrev Γs : Set (GL (Fin 2) ℝ) := PkgI1.GammaStar

theorem iota_one : PkgI1.iota 1 = 1 := by
  rw [iota_apply]; ext i j; fin_cases i <;> fin_cases j <;> simp

theorem inO_mul {x y : PkgI1.B} (hx : PkgI1.InO x) (hy : PkgI1.InO y) : PkgI1.InO (x * y) := by
  obtain ⟨a0, a1, a2, a3, rfl⟩ := (inO_iff x).1 hx
  obtain ⟨b0, b1, b2, b3, rfl⟩ := (inO_iff y).1 hy
  refine (inO_iff _).2 ⟨a0 * b0 + 2 * a1 * b1 - a2 * b2 + 2 * a3 * b1 + 2 * a3 * b3,
    a0 * b1 + a1 * b0 + a2 * b1 + a2 * b3 - a3 * b2,
    a0 * b2 + 2 * a1 * b3 + a2 * b0 + a2 * b2 - 2 * a3 * b1,
    a0 * b3 + a1 * b2 - a2 * b1 + a3 * b0 + a3 * b2, ?_⟩
  ext <;> simp <;> push_cast <;> ring

/-- An element of `GL₂(ℝ)` with matrix `ι(a)`, `a b = 1`: its inverse has matrix `ι(b)`. -/
theorem inv_coe {γ : GL (Fin 2) ℝ} {a b : PkgI1.B} (hγ : (γ : Matrix (Fin 2) (Fin 2) ℝ) = PkgI1.iota a)
    (hab : a * b = 1) : ((γ⁻¹ : GL (Fin 2) ℝ) : Matrix (Fin 2) (Fin 2) ℝ) = PkgI1.iota b := by
  have h1 : (γ : Matrix (Fin 2) (Fin 2) ℝ) * PkgI1.iota b = 1 := by
    rw [hγ, ← iota_mul, hab, iota_one]
  rw [Matrix.GeneralLinearGroup.coe_inv]
  exact Matrix.inv_eq_right_inv h1

/-- The coset representatives `1, x₄, x₆, x₄x₆` (reduced norms `1, 2, 3, 6`) and their inverses. -/
def rep : Fin 4 → PkgI1.B := ![1, x4, x6, x4 * x6]
def repi : Fin 4 → PkgI1.B := ![1, x4i, x6i, x6i * x4i]

theorem rep_repi (i : Fin 4) : rep i * repi i = 1 := by
  fin_cases i <;> simp [rep, repi, x4_x4i, x6_x6i]
  calc x4 * x6 * (x6i * x4i) = x4 * (x6 * x6i) * x4i := by simp only [mul_assoc]
    _ = 1 := by rw [x6_x6i, mul_one, x4_x4i]

theorem repi_rep (i : Fin 4) : repi i * rep i = 1 := by
  fin_cases i <;> simp [rep, repi, x4i_x4, x6i_x6]
  calc x6i * x4i * (x4 * x6) = x6i * (x4i * x4) * x6 := by simp only [mul_assoc]
    _ = 1 := by rw [x4i_x4, mul_one, x6i_x6]

theorem rep_conj (i : Fin 4) (w : PkgI1.B) (hw : PkgI1.InO w) :
    PkgI1.InO (rep i * w * repi i) ∧ PkgI1.InO (repi i * w * rep i) := by
  fin_cases i
  · simpa [rep, repi] using hw
  · exact conj_x4 w hw
  · exact conj_x6 w hw
  · constructor
    · have := (conj_x4 _ (conj_x6 w hw).1).1
      have e : x4 * x6 * w * (x6i * x4i) = x4 * (x6 * w * x6i) * x4i := by simp only [mul_assoc]
      simpa [rep, repi, e] using this
    · have := (conj_x6 _ (conj_x4 w hw).2).2
      have e : x6i * x4i * w * (x4 * x6) = x6i * (x4i * w * x4) * x6 := by simp only [mul_assoc]
      simpa [rep, repi, e] using this

theorem nrd_rep (i : Fin 4) : nrd (rep i) = ((![1, 2, 3, 6] : Fin 4 → ℤ) i : ℚ) := by
  fin_cases i <;> simp [rep, nrd_mul, nrd, x4, x6] <;> norm_num

theorem nrd_rep_pos (i : Fin 4) : 0 < nrd (rep i) := by
  rw [nrd_rep]; fin_cases i <;> norm_num

theorem tab_x4 (i : Fin 4) : ∃ (k : Fin 4) (r : ℚ) (u : PkgI1.B), r ≠ 0 ∧ PkgI1.InO u ∧ nrd u = 1 ∧
    x4 * rep i = ((r : ℚ) : PkgI1.B) * rep k * u := by
  fin_cases i
  · refine ⟨1, (1), ⟨(1), (0), (0), (0)⟩, by norm_num, (inO_iff _).2 ⟨1, 0, 0, 0, by ext <;> norm_num⟩,
      by norm_num [nrd], ?_⟩
    ext <;> simp [rep, x4, x6, x4i, x6i, QuaternionAlgebra.re_ofNat, QuaternionAlgebra.imI_ofNat,
      QuaternionAlgebra.imJ_ofNat, QuaternionAlgebra.imK_ofNat] <;> norm_num
  · refine ⟨0, (2), ⟨(0), (1), (1), (0)⟩, by norm_num, (inO_iff _).2 ⟨-1, 1, 2, 0, by ext <;> norm_num⟩,
      by norm_num [nrd], ?_⟩
    ext <;> simp [rep, x4, x6, x4i, x6i, QuaternionAlgebra.re_ofNat, QuaternionAlgebra.imI_ofNat,
      QuaternionAlgebra.imJ_ofNat, QuaternionAlgebra.imK_ofNat] <;> norm_num
  · refine ⟨3, (1), ⟨(1), (0), (0), (0)⟩, by norm_num, (inO_iff _).2 ⟨1, 0, 0, 0, by ext <;> norm_num⟩,
      by norm_num [nrd], ?_⟩
    ext <;> simp [rep, x4, x6, x4i, x6i, QuaternionAlgebra.re_ofNat, QuaternionAlgebra.imI_ofNat,
      QuaternionAlgebra.imJ_ofNat, QuaternionAlgebra.imK_ofNat] <;> norm_num
  · refine ⟨2, (2), ⟨(0), (1 / 2), (1), (-1 / 2)⟩, by norm_num, (inO_iff _).2 ⟨-1, 1, 2, -1, by ext <;> norm_num⟩,
      by norm_num [nrd], ?_⟩
    ext <;> simp [rep, x4, x6, x4i, x6i, QuaternionAlgebra.re_ofNat, QuaternionAlgebra.imI_ofNat,
      QuaternionAlgebra.imJ_ofNat, QuaternionAlgebra.imK_ofNat] <;> norm_num

theorem tab_x6 (i : Fin 4) : ∃ (k : Fin 4) (r : ℚ) (u : PkgI1.B), r ≠ 0 ∧ PkgI1.InO u ∧ nrd u = 1 ∧
    x6 * rep i = ((r : ℚ) : PkgI1.B) * rep k * u := by
  fin_cases i
  · refine ⟨2, (1), ⟨(1), (0), (0), (0)⟩, by norm_num, (inO_iff _).2 ⟨1, 0, 0, 0, by ext <;> norm_num⟩,
      by norm_num [nrd], ?_⟩
    ext <;> simp [rep, x4, x6, x4i, x6i, QuaternionAlgebra.re_ofNat, QuaternionAlgebra.imI_ofNat,
      QuaternionAlgebra.imJ_ofNat, QuaternionAlgebra.imK_ofNat] <;> norm_num
  · refine ⟨3, (1), ⟨(3 / 2), (-1 / 2), (-1 / 2), (1 / 2)⟩, by norm_num, (inO_iff _).2 ⟨2, -1, -1, 1, by ext <;> norm_num⟩,
      by norm_num [nrd], ?_⟩
    ext <;> simp [rep, x4, x6, x4i, x6i, QuaternionAlgebra.re_ofNat, QuaternionAlgebra.imI_ofNat,
      QuaternionAlgebra.imJ_ofNat, QuaternionAlgebra.imK_ofNat] <;> norm_num
  · refine ⟨0, (3), ⟨(1 / 2), (0), (-1 / 2), (0)⟩, by norm_num, (inO_iff _).2 ⟨1, 0, -1, 0, by ext <;> norm_num⟩,
      by norm_num [nrd], ?_⟩
    ext <;> simp [rep, x4, x6, x4i, x6i, QuaternionAlgebra.re_ofNat, QuaternionAlgebra.imI_ofNat,
      QuaternionAlgebra.imJ_ofNat, QuaternionAlgebra.imK_ofNat] <;> norm_num
  · refine ⟨1, (3), ⟨(0), (-1 / 2), (-1), (1 / 2)⟩, by norm_num, (inO_iff _).2 ⟨1, -1, -2, 1, by ext <;> norm_num⟩,
      by norm_num [nrd], ?_⟩
    ext <;> simp [rep, x4, x6, x4i, x6i, QuaternionAlgebra.re_ofNat, QuaternionAlgebra.imI_ofNat,
      QuaternionAlgebra.imJ_ofNat, QuaternionAlgebra.imK_ofNat] <;> norm_num

theorem tab_x4i (i : Fin 4) : ∃ (k : Fin 4) (r : ℚ) (u : PkgI1.B), r ≠ 0 ∧ PkgI1.InO u ∧ nrd u = 1 ∧
    x4i * rep i = ((r : ℚ) : PkgI1.B) * rep k * u := by
  fin_cases i
  · refine ⟨1, (1 / 2), ⟨(0), (-1), (-1), (0)⟩, by norm_num, (inO_iff _).2 ⟨1, -1, -2, 0, by ext <;> norm_num⟩,
      by norm_num [nrd], ?_⟩
    ext <;> simp [rep, x4, x6, x4i, x6i, QuaternionAlgebra.re_ofNat, QuaternionAlgebra.imI_ofNat,
      QuaternionAlgebra.imJ_ofNat, QuaternionAlgebra.imK_ofNat] <;> norm_num
  · refine ⟨0, (1), ⟨(1), (0), (0), (0)⟩, by norm_num, (inO_iff _).2 ⟨1, 0, 0, 0, by ext <;> norm_num⟩,
      by norm_num [nrd], ?_⟩
    ext <;> simp [rep, x4, x6, x4i, x6i, QuaternionAlgebra.re_ofNat, QuaternionAlgebra.imI_ofNat,
      QuaternionAlgebra.imJ_ofNat, QuaternionAlgebra.imK_ofNat] <;> norm_num
  · refine ⟨3, (1 / 2), ⟨(0), (-1 / 2), (-1), (1 / 2)⟩, by norm_num, (inO_iff _).2 ⟨1, -1, -2, 1, by ext <;> norm_num⟩,
      by norm_num [nrd], ?_⟩
    ext <;> simp [rep, x4, x6, x4i, x6i, QuaternionAlgebra.re_ofNat, QuaternionAlgebra.imI_ofNat,
      QuaternionAlgebra.imJ_ofNat, QuaternionAlgebra.imK_ofNat] <;> norm_num
  · refine ⟨2, (1), ⟨(1), (0), (0), (0)⟩, by norm_num, (inO_iff _).2 ⟨1, 0, 0, 0, by ext <;> norm_num⟩,
      by norm_num [nrd], ?_⟩
    ext <;> simp [rep, x4, x6, x4i, x6i, QuaternionAlgebra.re_ofNat, QuaternionAlgebra.imI_ofNat,
      QuaternionAlgebra.imJ_ofNat, QuaternionAlgebra.imK_ofNat] <;> norm_num

theorem tab_x6i (i : Fin 4) : ∃ (k : Fin 4) (r : ℚ) (u : PkgI1.B), r ≠ 0 ∧ PkgI1.InO u ∧ nrd u = 1 ∧
    x6i * rep i = ((r : ℚ) : PkgI1.B) * rep k * u := by
  fin_cases i
  · refine ⟨2, (1 / 3), ⟨(1 / 2), (0), (1 / 2), (0)⟩, by norm_num, (inO_iff _).2 ⟨0, 0, 1, 0, by ext <;> norm_num⟩,
      by norm_num [nrd], ?_⟩
    ext <;> simp [rep, x4, x6, x4i, x6i, QuaternionAlgebra.re_ofNat, QuaternionAlgebra.imI_ofNat,
      QuaternionAlgebra.imJ_ofNat, QuaternionAlgebra.imK_ofNat] <;> norm_num
  · refine ⟨3, (1 / 3), ⟨(0), (1 / 2), (1), (-1 / 2)⟩, by norm_num, (inO_iff _).2 ⟨-1, 1, 2, -1, by ext <;> norm_num⟩,
      by norm_num [nrd], ?_⟩
    ext <;> simp [rep, x4, x6, x4i, x6i, QuaternionAlgebra.re_ofNat, QuaternionAlgebra.imI_ofNat,
      QuaternionAlgebra.imJ_ofNat, QuaternionAlgebra.imK_ofNat] <;> norm_num
  · refine ⟨0, (1), ⟨(1), (0), (0), (0)⟩, by norm_num, (inO_iff _).2 ⟨1, 0, 0, 0, by ext <;> norm_num⟩,
      by norm_num [nrd], ?_⟩
    ext <;> simp [rep, x4, x6, x4i, x6i, QuaternionAlgebra.re_ofNat, QuaternionAlgebra.imI_ofNat,
      QuaternionAlgebra.imJ_ofNat, QuaternionAlgebra.imK_ofNat] <;> norm_num
  · refine ⟨1, (1), ⟨(3 / 2), (1 / 2), (1 / 2), (-1 / 2)⟩, by norm_num, (inO_iff _).2 ⟨1, 1, 1, -1, by ext <;> norm_num⟩,
      by norm_num [nrd], ?_⟩
    ext <;> simp [rep, x4, x6, x4i, x6i, QuaternionAlgebra.re_ofNat, QuaternionAlgebra.imI_ofNat,
      QuaternionAlgebra.imJ_ofNat, QuaternionAlgebra.imK_ofNat] <;> norm_num

/-- The cover predicate: `γ = q·ι(rep i)·ι(u)`, `q ∈ ℚ^×`, `u ∈ 𝒪¹`. -/
def Pm (γ : GL (Fin 2) ℝ) : Prop :=
  ∃ i : Fin 4, ∃ q : ℚ, q ≠ 0 ∧ ∃ u : PkgI1.B, PkgI1.InO u ∧ nrd u = 1 ∧
    (γ : Matrix (Fin 2) (Fin 2) ℝ) = PkgI1.iota ((q : PkgI1.B) * rep i * u)

theorem Pm_one : Pm 1 :=
  ⟨0, 1, one_ne_zero, 1, (inO_iff _).2 ⟨1, 0, 0, 0, by ext <;> norm_num⟩, by norm_num [nrd],
    by simp [rep, iota_one]⟩

theorem Pm_step {g : PkgI1.B}
    (htab : ∀ i : Fin 4, ∃ (k : Fin 4) (r : ℚ) (u : PkgI1.B), r ≠ 0 ∧ PkgI1.InO u ∧ nrd u = 1 ∧
      g * rep i = ((r : ℚ) : PkgI1.B) * rep k * u)
    {x γ : GL (Fin 2) ℝ} (hx : (x : Matrix (Fin 2) (Fin 2) ℝ) = PkgI1.iota g) (hγ : Pm γ) :
    Pm (x * γ) := by
  obtain ⟨i, q, hq, u, hu, hnu, hγm⟩ := hγ
  obtain ⟨k, r, u', hr, hu', hnu', he⟩ := htab i
  refine ⟨k, q * r, mul_ne_zero hq hr, u' * u, inO_mul hu' hu, by rw [nrd_mul, hnu', hnu, one_mul], ?_⟩
  rw [Units.val_mul, hx, hγm, ← iota_mul]
  congr 1
  calc g * ((q : PkgI1.B) * rep i * u) = (g * (q : PkgI1.B)) * rep i * u := by simp only [mul_assoc]
    _ = (q : PkgI1.B) * (g * rep i) * u := by rw [← QuaternionAlgebra.coe_commutes]; simp only [mul_assoc]
    _ = ((q * r : ℚ) : PkgI1.B) * rep k * (u' * u) := by
      rw [he, QuaternionAlgebra.coe_mul]; simp only [mul_assoc]

theorem Pm_scal {q' : ℚ} (hq' : q' ≠ 0) {x γ : GL (Fin 2) ℝ}
    (hx : (x : Matrix (Fin 2) (Fin 2) ℝ) = PkgI1.iota (q' : PkgI1.B)) (hγ : Pm γ) : Pm (x * γ) := by
  obtain ⟨i, q, hq, u, hu, hnu, hγm⟩ := hγ
  refine ⟨i, q' * q, mul_ne_zero hq' hq, u, hu, hnu, ?_⟩
  rw [Units.val_mul, hx, hγm, ← iota_mul, QuaternionAlgebra.coe_mul]; simp only [mul_assoc]

/-- **Cover**: every `γ ∈ Γ*` is `q·ι(rep i)·ι(u)` with `q ∈ ℚ^×`, `u ∈ 𝒪¹`. -/
theorem cover {γ : GL (Fin 2) ℝ} (hγ : γ ∈ Γs) : Pm γ := by
  have hcl := gammaStarGen_proof γ hγ
  clear hγ
  induction hcl using Subgroup.closure_induction_left with
  | one => exact Pm_one
  | mul_left x hx y _ ih =>
    rcases hx with (hx | hx) | ⟨q', hq', hx⟩
    · exact Pm_step tab_x4 hx ih
    · exact Pm_step tab_x6 hx ih
    · exact Pm_scal hq' (by rw [hx, iota_ratCast]) ih
  | inv_mul_cancel x hx y _ ih =>
    rcases hx with (hx | hx) | ⟨q', hq', hx⟩
    · exact Pm_step tab_x4i (inv_coe hx x4_x4i) ih
    · exact Pm_step tab_x6i (inv_coe hx x6_x6i) ih
    · refine Pm_scal (inv_ne_zero hq') (inv_coe (b := ((q'⁻¹ : ℚ) : PkgI1.B))
        (by rw [hx, iota_ratCast]) ?_) ih
      rw [← QuaternionAlgebra.coe_mul, mul_inv_cancel₀ hq']; rfl

/-! ### Möbius maps -/

open UpperHalfPlane (denom denom_ne_zero)

-- From qm-split `Haupt.lean` l.3380-3421 (verbatim).
/-- A matrix of positive determinant acting trivially on `ℍ` is scalar. -/
theorem scalar_of_trivial {γ : GL (Fin 2) ℝ} (hd : 0 < (γ : Matrix (Fin 2) (Fin 2) ℝ).det)
    (h : ∀ z : UpperHalfPlane, γ • z = z) :
    (γ : Matrix (Fin 2) (Fin 2) ℝ) 1 0 = 0 ∧ (γ : Matrix (Fin 2) (Fin 2) ℝ) 0 1 = 0 ∧
      (γ : Matrix (Fin 2) (Fin 2) ℝ) 0 0 = (γ : Matrix (Fin 2) (Fin 2) ℝ) 1 1 := by
  have hd' : 0 < γ.det.val := by rwa [Matrix.GeneralLinearGroup.val_det_apply]
  have key : ∀ z : UpperHalfPlane,
      ((γ : Matrix (Fin 2) (Fin 2) ℝ) 0 0 : ℂ) * z + ((γ : Matrix (Fin 2) (Fin 2) ℝ) 0 1 : ℂ) =
        (z : ℂ) * (((γ : Matrix (Fin 2) (Fin 2) ℝ) 1 0 : ℂ) * z + ((γ : Matrix (Fin 2) (Fin 2) ℝ) 1 1 : ℂ)) := by
    intro z
    have e : ((γ • z : UpperHalfPlane) : ℂ) = (z : ℂ) := congrArg (fun w : UpperHalfPlane => (w : ℂ)) (h z)
    rw [UpperHalfPlane.coe_smul_of_det_pos hd', div_eq_iff (denom_ne_zero γ z)] at e
    simpa [UpperHalfPlane.num, UpperHalfPlane.denom, mul_comm] using e
  have k1 := key UpperHalfPlane.I
  have k2 := key ⟨2 * Complex.I, by simp⟩
  simp only [UpperHalfPlane.coe_I] at k1
  simp only [UpperHalfPlane.coe_mk] at k2
  have r1 := congrArg Complex.re k1; have i1 := congrArg Complex.im k1
  have r2 := congrArg Complex.re k2
  simp at r1 i1 r2
  refine ⟨by linarith, by linarith, by linarith⟩

theorem rat_of_scalar {u : PkgI1.B} (h10 : PkgI1.iota u 1 0 = 0) (h01 : PkgI1.iota u 0 1 = 0)
    (h00 : PkgI1.iota u 0 0 = PkgI1.iota u 1 1) : u.imI = 0 ∧ u.imJ = 0 ∧ u.imK = 0 := by
  rw [iota_apply] at h10 h01 h00
  simp at h10 h01 h00
  have hs : (0 : ℝ) < √2 := Real.sqrt_pos.2 (by norm_num)
  have hK : (u.imK : ℝ) = 0 := by
    have : (u.imK : ℝ) * √2 = 0 := by linarith
    exact (mul_eq_zero.1 this).resolve_right hs.ne'
  have hJ : (u.imJ : ℝ) = 0 := by rw [hK] at h10; linarith
  have hI : (u.imI : ℝ) = 0 := by
    have : (u.imI : ℝ) * √2 = 0 := by linarith
    exact (mul_eq_zero.1 this).resolve_right hs.ne'
  exact ⟨by exact_mod_cast hI, by exact_mod_cast hJ, by exact_mod_cast hK⟩

theorem not_sq_q (q : ℚ) (c : ℤ) (hc : ¬ IsSquare c) (h : q * q = c) : False := by
  have h1 : IsSquare (c : ℚ) := ⟨q, by rw [← h]⟩
  rw [Rat.isSquare_iff] at h1
  simp at h1
  exact hc h1


theorem inO_star {x : PkgI1.B} (hx : PkgI1.InO x) : PkgI1.InO (star x) := by
  obtain ⟨n0, n1, n2, n3, rfl⟩ := (inO_iff x).1 hx
  exact (inO_iff _).2 ⟨n0 + n2, -n1, -n2, -n3, by ext <;> simp <;> push_cast <;> ring⟩

theorem mul_star_eq (x : PkgI1.B) : x * star x = ((nrd x : ℚ) : PkgI1.B) := by
  rw [QuaternionAlgebra.mul_star_eq_coe]; congr 1; simp [nrd]; ring

theorem star_mul_eq (x : PkgI1.B) : star x * x = ((nrd x : ℚ) : PkgI1.B) := by
  rw [QuaternionAlgebra.star_mul_eq_coe]; congr 1; simp [nrd]; ring

theorem nrd_star (x : PkgI1.B) : nrd (star x) = nrd x := by simp [nrd]

theorem nrd_ratCast' (q : ℚ) : nrd (q : PkgI1.B) = q ^ 2 := by simp [nrd]

theorem nrd_one : nrd (1 : PkgI1.B) = 1 := by simp [nrd]

/-- The element of `Γ*` for a representative. -/
def g4 (i : Fin 4) : GL (Fin 2) ℝ := glOf (rep i) (nrd_rep_pos i).ne'

theorem g4_coe (i : Fin 4) : (g4 i : Matrix (Fin 2) (Fin 2) ℝ) = PkgI1.iota (rep i) := rfl

theorem g4_mem (i : Fin 4) : g4 i ∈ Γs :=
  ⟨rep i, ⟨repi i, rep_repi i, repi_rep i, rep_conj i⟩, rfl, by
    rw [g4_coe, det_iota_eq]; exact_mod_cast nrd_rep_pos i⟩

theorem gamma1_iff {h : GL (Fin 2) ℝ} : h ∈ Gamma1 ↔ ∃ u : PkgI1.B, PkgI1.InO u ∧
    (h : Matrix (Fin 2) (Fin 2) ℝ) = PkgI1.iota u ∧ nrd u = 1 := by
  constructor
  · rintro ⟨u, hu, hhu, hd⟩
    refine ⟨u, hu, hhu, ?_⟩
    rw [hhu, det_iota_eq] at hd; exact_mod_cast hd
  · rintro ⟨u, hu, hhu, hn⟩
    exact ⟨u, hu, hhu, by rw [hhu, det_iota_eq, hn]; norm_num⟩

theorem one_mem_gamma1 : (1 : GL (Fin 2) ℝ) ∈ Gamma1 :=
  gamma1_iff.2 ⟨1, (inO_iff _).2 ⟨1, 0, 0, 0, by ext <;> norm_num⟩, by simp [iota_one], nrd_one⟩

theorem mul_mem_gamma1 {a b : GL (Fin 2) ℝ} (ha : a ∈ Gamma1) (hb : b ∈ Gamma1) : a * b ∈ Gamma1 := by
  obtain ⟨x, hx, hax, hnx⟩ := gamma1_iff.1 ha
  obtain ⟨y, hy, hby, hny⟩ := gamma1_iff.1 hb
  exact gamma1_iff.2 ⟨x * y, inO_mul hx hy, by rw [Units.val_mul, hax, hby, iota_mul],
    by rw [nrd_mul, hnx, hny, one_mul]⟩

theorem inv_mem_gamma1 {a : GL (Fin 2) ℝ} (ha : a ∈ Gamma1) : a⁻¹ ∈ Gamma1 := by
  obtain ⟨x, hx, hax, hnx⟩ := gamma1_iff.1 ha
  exact gamma1_iff.2 ⟨star x, inO_star hx, inv_coe hax (by rw [mul_star_eq, hnx]; rfl),
    by rw [nrd_star, hnx]⟩

theorem gamma1_sub {h : GL (Fin 2) ℝ} (hh : h ∈ Gamma1) : h ∈ Γs := by
  obtain ⟨x, hx, hhx, hnx⟩ := gamma1_iff.1 hh
  refine ⟨x, ⟨star x, by rw [mul_star_eq, hnx]; rfl, by rw [star_mul_eq, hnx]; rfl,
    fun w hw => ⟨inO_mul (inO_mul hx hw) (inO_star hx), inO_mul (inO_mul (inO_star hx) hw) hx⟩⟩,
    hhx, by rw [hhx, det_iota_eq, hnx]; norm_num⟩

theorem det_pos_of_mem {γ : GL (Fin 2) ℝ} (hγ : γ ∈ Γs) : 0 < (γ : Matrix (Fin 2) (Fin 2) ℝ).det := by
  obtain ⟨_, _, _, hd⟩ := hγ; exact hd

theorem conj_g4 (i : Fin 4) {h : GL (Fin 2) ℝ} (hh : h ∈ Gamma1) : g4 i * h * (g4 i)⁻¹ ∈ Gamma1 := by
  obtain ⟨u, hu, hhu, hnu⟩ := gamma1_iff.1 hh
  refine gamma1_iff.2 ⟨rep i * u * repi i, (rep_conj i u hu).1, ?_, ?_⟩
  · rw [Units.val_mul, Units.val_mul, g4_coe, hhu, inv_coe (g4_coe i) (rep_repi i), iota_mul, iota_mul]
  · have h1 : nrd (rep i) * nrd (repi i) = 1 := by rw [← nrd_mul, rep_repi, nrd_one]
    rw [nrd_mul, nrd_mul, hnu, mul_one, h1]

/-- Scalars act trivially. -/
theorem scal_smul {q : ℚ} (hq : q ≠ 0) (z : UpperHalfPlane) :
    Matrix.GeneralLinearGroup.scalar (Fin 2) (Units.mk0 (q : ℝ) (by exact_mod_cast hq)) • z = z :=
  UpperHalfPlane.glScalar_smul _ z

/-- **Cover, Möbius form**: `γ z = rᵢ (h z)` with `h ∈ Γ¹`. -/
theorem cover_mob {γ : GL (Fin 2) ℝ} (hγ : γ ∈ Γs) :
    ∃ i : Fin 4, ∃ h ∈ Gamma1, ∀ z : UpperHalfPlane, γ • z = g4 i • (h • z) := by
  obtain ⟨i, q, hq, u, hu, hnu, hγm⟩ := cover hγ
  have hu0 : nrd u ≠ 0 := by rw [hnu]; norm_num
  refine ⟨i, glOf u hu0, gamma1_iff.2 ⟨u, hu, rfl, hnu⟩, fun z => ?_⟩
  have e : γ = Matrix.GeneralLinearGroup.scalar (Fin 2) (Units.mk0 (q : ℝ) (by exact_mod_cast hq)) *
      (g4 i * glOf u hu0) := by
    ext1
    rw [hγm, Units.val_mul, Units.val_mul, Matrix.GeneralLinearGroup.coe_scalar, g4_coe, coe_glOf,
      iota_mul, iota_mul, iota_ratCast]
    simp [Matrix.scalar_apply, Matrix.smul_eq_diagonal_mul, mul_assoc]
  rw [e, mul_smul, scal_smul hq, mul_smul]

/-! ### `Γ*` is a group -/

theorem gs_one : (1 : GL (Fin 2) ℝ) ∈ Γs :=
  ⟨1, ⟨1, one_mul 1, one_mul 1, fun w hw => by simpa using hw⟩, by simp [iota_one], by simp⟩

theorem gs_mul {a b : GL (Fin 2) ℝ} (ha : a ∈ Γs) (hb : b ∈ Γs) : a * b ∈ Γs := by
  obtain ⟨x, ⟨y, hxy, hyx, hN⟩, hax, hda⟩ := ha
  obtain ⟨x', ⟨y', hxy', hyx', hN'⟩, hbx, hdb⟩ := hb
  refine ⟨x * x', ⟨y' * y, ?_, ?_, fun w hw => ⟨?_, ?_⟩⟩, by rw [Units.val_mul, hax, hbx, iota_mul], ?_⟩
  · calc x * x' * (y' * y) = x * (x' * y') * y := by simp only [mul_assoc]
      _ = 1 := by rw [hxy', mul_one, hxy]
  · calc y' * y * (x * x') = y' * (y * x) * x' := by simp only [mul_assoc]
      _ = 1 := by rw [hyx, mul_one, hyx']
  · have := (hN _ (hN' w hw).1).1
    have e : x * x' * w * (y' * y) = x * (x' * w * y') * y := by simp only [mul_assoc]
    rw [e]; exact this
  · have := (hN' _ (hN w hw).2).2
    have e : y' * y * w * (x * x') = y' * (y * w * x) * x' := by simp only [mul_assoc]
    rw [e]; exact this
  · rw [Units.val_mul, Matrix.det_mul]; exact mul_pos hda hdb

theorem gs_inv {a : GL (Fin 2) ℝ} (ha : a ∈ Γs) : a⁻¹ ∈ Γs := by
  obtain ⟨x, ⟨y, hxy, hyx, hN⟩, hax, hda⟩ := ha
  have hinv := inv_coe hax hxy
  refine ⟨y, ⟨x, hyx, hxy, fun w hw => ⟨(hN w hw).2, (hN w hw).1⟩⟩, hinv, ?_⟩
  have h1 : (a : Matrix (Fin 2) (Fin 2) ℝ) * ((a⁻¹ : GL (Fin 2) ℝ) : Matrix (Fin 2) (Fin 2) ℝ) = 1 := by
    rw [← Units.val_mul, mul_inv_cancel, Units.val_one]
  have h2 := congrArg Matrix.det h1
  rw [Matrix.det_mul, Matrix.det_one] at h2
  rcases lt_or_ge 0 ((a⁻¹ : GL (Fin 2) ℝ) : Matrix (Fin 2) (Fin 2) ℝ).det with h | h
  · exact h
  · nlinarith

/-! ### The four cosets are distinct -/

theorem nrd_repi_mul (i : Fin 4) : nrd (repi i) * nrd (rep i) = 1 := by
  rw [← nrd_mul, repi_rep, nrd_one]

/-- **Distinct cosets**: if `r_j z = r_i (h z)` for all `z` with `h ∈ Γ¹`, then `i = j`
(reduced norms `1, 2, 3, 6` are distinct modulo squares). -/
theorem coset_eq {i j : Fin 4} {h : GL (Fin 2) ℝ} (hh : h ∈ Gamma1)
    (hz : ∀ z : UpperHalfPlane, g4 j • z = g4 i • (h • z)) : i = j := by
  by_contra hij
  obtain ⟨u, hu, hhu, hnu⟩ := gamma1_iff.1 hh
  set γ := (g4 i * h)⁻¹ * g4 j with hγ
  have htriv : ∀ z : UpperHalfPlane, γ • z = z := fun z => by
    rw [hγ, mul_smul, hz, ← mul_smul (g4 i) h z, inv_smul_smul]
  have hab : rep i * u * (star u * repi i) = 1 := by
    calc rep i * u * (star u * repi i) = rep i * (u * star u) * repi i := by simp only [mul_assoc]
      _ = 1 := by rw [mul_star_eq, hnu]; simp [rep_repi]
  set w := star u * repi i * rep j with hw
  have hγw : (γ : Matrix (Fin 2) (Fin 2) ℝ) = PkgI1.iota w := by
    rw [hγ, Units.val_mul, inv_coe (a := rep i * u) (by rw [Units.val_mul, g4_coe, hhu, iota_mul]) hab,
      g4_coe, hw]
    simp only [iota_mul]
  have hnw : nrd w = nrd (repi i) * nrd (rep j) := by
    rw [hw, nrd_mul, nrd_mul, nrd_star, hnu, one_mul]
  have hpos : 0 < nrd (repi i) := by
    have := nrd_repi_mul i; have := nrd_rep_pos i
    by_contra hneg; push Not at hneg; nlinarith
  have hdγ : 0 < (γ : Matrix (Fin 2) (Fin 2) ℝ).det := by
    rw [hγw, det_iota_eq, hnw]; exact_mod_cast mul_pos hpos (nrd_rep_pos j)
  obtain ⟨s10, s01, s00⟩ := scalar_of_trivial hdγ htriv
  rw [hγw] at s10 s01 s00
  obtain ⟨hI, hJ, hK⟩ := rat_of_scalar s10 s01 s00
  have hnu' : nrd w = w.re * w.re := by simp [nrd, hI, hJ, hK]; ring
  have hprod : nrd (rep i) * nrd (rep j) = (w.re * nrd (rep i)) * (w.re * nrd (rep i)) := by
    have e : nrd (rep j) = nrd (rep i) * (nrd (repi i) * nrd (rep j)) := by
      rw [← mul_assoc, mul_comm (nrd (rep i)), nrd_repi_mul, one_mul]
    rw [e, ← hnw, hnu']; ring
  rw [nrd_rep i, nrd_rep j] at hprod
  have hsq : ∀ a b : Fin 4, a ≠ b →
      ¬ IsSquare ((![1, 2, 3, 6] : Fin 4 → ℤ) a * (![1, 2, 3, 6] : Fin 4 → ℤ) b) := by decide +kernel
  exact not_sq_q (w.re * ((![1, 2, 3, 6] : Fin 4 → ℤ) i : ℚ)) _ (hsq i j hij)
    (by push_cast; linarith)

/-! ## §2 `Γ*` is a cocompact Fuchsian group -/

theorem gs_fuchsian (hS : IsCocompactFuchsian Gamma1) : IsCocompactFuchsian Γs where
  one_mem := gs_one
  mul_mem := fun a ha b hb => gs_mul ha hb
  inv_mem := fun a ha => gs_inv ha
  det_pos := fun a ha => det_pos_of_mem ha
  properlyDiscontinuous := by
    intro K hK
    let K' : Fin 4 → Set UpperHalfPlane := fun i => K ∪ (fun z => (g4 i)⁻¹ • z) '' K
    have hK' : ∀ i, IsCompact (K' i) := fun i => hK.union (hK.image (continuous_const_smul _))
    have hfin : ∀ i, {f : UpperHalfPlane → UpperHalfPlane | ∃ γ ∈ Gamma1, f = (fun z => γ • z) ∧
        (f '' K' i ∩ K' i).Nonempty}.Finite := fun i => hS.properlyDiscontinuous _ (hK' i)
    refine (Set.finite_iUnion fun i => (hfin i).image (fun f => (fun z => g4 i • z) ∘ f)).subset ?_
    rintro f ⟨γ, hγ, rfl, ⟨_, ⟨k, hk, rfl⟩, hk'⟩⟩
    obtain ⟨i, h, hh, hz⟩ := cover_mob hγ
    refine Set.mem_iUnion.2 ⟨i, (fun z => h • z), ⟨h, hh, rfl, ⟨h • k, ⟨k, Or.inl hk, rfl⟩,
      Or.inr ⟨γ • k, hk', ?_⟩⟩⟩, ?_⟩
    · show (g4 i)⁻¹ • (γ • k) = h • k
      rw [hz, inv_smul_smul]
    · funext z; simp [hz]
  cocompact := by
    obtain ⟨C, hC, hcov⟩ := hS.cocompact
    exact ⟨C, hC, fun z => by obtain ⟨γ, hγ, h⟩ := hcov z; exact ⟨γ, gamma1_sub hγ, h⟩⟩

/-! ## §3 A fundamental domain for `Γ*` -/

open MeasureTheory

instance : Countable PkgI1.B := by
  have : Function.Injective (fun x : PkgI1.B => (x.re, x.imI, x.imJ, x.imK)) := by
    intro x y h
    simp only [Prod.mk.injEq] at h
    obtain ⟨h1, h2, h3, h4⟩ := h
    ext <;> assumption
  exact this.countable

theorem gs_countable : (Γs : Set (GL (Fin 2) ℝ)).Countable := by
  classical
  have : Γs ⊆ Set.range (fun x : PkgI1.B => if h : nrd x ≠ 0 then glOf x h else 1) := by
    rintro γ ⟨x, -, hγx, hd⟩
    have hx : nrd x ≠ 0 := by
      rw [hγx, det_iota_eq] at hd; exact_mod_cast hd.ne'
    exact ⟨x, by show (if h : nrd x ≠ 0 then glOf x h else 1) = γ; rw [dif_pos hx]; ext1; rw [coe_glOf, hγx]⟩
  exact (Set.countable_range _).mono this

theorem g1_countable : (Gamma1).Countable := gs_countable.mono (fun h hh => gamma1_sub hh)

/-- The lexicographic order on `ℍ` (by real, then imaginary part). -/
def lexle (z w : UpperHalfPlane) : Prop := z.re < w.re ∨ (z.re = w.re ∧ z.im ≤ w.im)

theorem lexle_iff (z w : UpperHalfPlane) : lexle z w ↔ toLex (z.re, z.im) ≤ toLex (w.re, w.im) := by
  rw [Prod.Lex.toLex_le_toLex]; rfl

theorem lexle_antisymm {z w : UpperHalfPlane} (h1 : lexle z w) (h2 : lexle w z) : z = w := by
  have hre : z.re = w.re := by
    rcases h1 with h1 | ⟨h1, -⟩ <;> rcases h2 with h2 | ⟨h2, -⟩ <;> linarith
  have him : z.im = w.im := by
    rcases h1 with h1 | ⟨-, h1⟩ <;> rcases h2 with h2 | ⟨-, h2⟩ <;> linarith
  exact UpperHalfPlane.ext (Complex.ext hre him)

theorem measurableSet_lexle (γ : GL (Fin 2) ℝ) :
    MeasurableSet {z : UpperHalfPlane | lexle z (γ • z)} := by
  have hr : Measurable fun z : UpperHalfPlane => z.re := UpperHalfPlane.continuous_re.measurable
  have hi : Measurable fun z : UpperHalfPlane => z.im := UpperHalfPlane.continuous_im.measurable
  have hg : Measurable fun z : UpperHalfPlane => γ • z := (continuous_const_smul γ).measurable
  have e : {z : UpperHalfPlane | lexle z (γ • z)} =
      {z | z.re < (γ • z).re} ∪ ({z | z.re = (γ • z).re} ∩ {z | z.im ≤ (γ • z).im}) := rfl
  rw [e]
  exact (measurableSet_lt hr (hr.comp hg)).union
    ((measurableSet_eq_fun hr (hr.comp hg)).inter (measurableSet_le hi (hi.comp hg)))

/-- Points have measure zero in `ℍ`. -/
instance : NullSingletonClass (volume : Measure UpperHalfPlane) :=
  ⟨fun z => by
    rw [UpperHalfPlane.volume_eq_lintegral, Set.image_singleton]
    exact setLIntegral_measure_zero _ _ (measure_singleton _)⟩

/-- A Möbius map of positive determinant other than the identity has finitely many fixed points. -/
theorem fix_finite {γ : GL (Fin 2) ℝ} (hd : 0 < (γ : Matrix (Fin 2) (Fin 2) ℝ).det)
    (hne : (fun z : UpperHalfPlane => γ • z) ≠ id) : {z : UpperHalfPlane | γ • z = z}.Finite := by
  have hd' : 0 < γ.det.val := by rwa [Matrix.GeneralLinearGroup.val_det_apply]
  set a := (γ : Matrix (Fin 2) (Fin 2) ℝ) 0 0
  set b := (γ : Matrix (Fin 2) (Fin 2) ℝ) 0 1
  set c := (γ : Matrix (Fin 2) (Fin 2) ℝ) 1 0
  set d := (γ : Matrix (Fin 2) (Fin 2) ℝ) 1 1
  have key : ∀ z : UpperHalfPlane, γ • z = z ↔
      (c : ℂ) * (z : ℂ) ^ 2 + ((d - a : ℝ) : ℂ) * z - (b : ℂ) = 0 := by
    intro z
    rw [UpperHalfPlane.ext_iff, UpperHalfPlane.coe_smul_of_det_pos hd',
      div_eq_iff (denom_ne_zero γ z)]
    simp only [UpperHalfPlane.num, UpperHalfPlane.denom]
    constructor
    · intro h; push_cast; linear_combination -h
    · intro h; push_cast at h; linear_combination -h
  let p : Polynomial ℂ := Polynomial.C (c : ℂ) * Polynomial.X ^ 2 +
    Polynomial.C ((d - a : ℝ) : ℂ) * Polynomial.X - Polynomial.C (b : ℂ)
  have hp : p ≠ 0 := by
    intro hp0
    have h2 : p.coeff 2 = 0 := by rw [hp0]; simp
    have h1 : p.coeff 1 = 0 := by rw [hp0]; simp
    have h0 : p.coeff 0 = 0 := by rw [hp0]; simp
    simp [p, Polynomial.coeff_X, Polynomial.coeff_C] at h2 h1 h0
    apply hne
    funext z
    have : (c : ℂ) * (z : ℂ) ^ 2 + ((d - a : ℝ) : ℂ) * z - (b : ℂ) = 0 := by
      have hc : (c : ℂ) = 0 := by exact_mod_cast h2
      have hb : (b : ℂ) = 0 := by exact_mod_cast h0
      have hda : ((d - a : ℝ) : ℂ) = 0 := by push_cast; exact h1
      rw [hc, hb, hda]; ring
    exact (key z).2 this
  refine ((Polynomial.finite_setOfPred_isRoot hp).preimage
    (UpperHalfPlane.coe_injective.injOn)).subset ?_
  intro z hz
  simp only [Set.mem_preimage, Set.mem_setOf_eq, Polynomial.IsRoot, p, Polynomial.eval_sub,
    Polynomial.eval_add, Polynomial.eval_mul, Polynomial.eval_C, Polynomial.eval_pow, Polynomial.eval_X]
  exact (key z).1 hz

theorem fix_null {γ : GL (Fin 2) ℝ} (hd : 0 < (γ : Matrix (Fin 2) (Fin 2) ℝ).det)
    (hne : (fun z : UpperHalfPlane => γ • z) ≠ id) : volume {z : UpperHalfPlane | γ • z = z} = 0 :=
  (fix_finite hd hne).measure_zero _

section Domain

variable (s : Set UpperHalfPlane)

/-- `t₀`: the points of `s` that are lexicographically minimal among their `Γ*`-translates in `s`. -/
def t0 : Set UpperHalfPlane := s ∩ ⋂ γ ∈ Γs, {z | γ • z ∈ s → lexle z (γ • z)}

/-- `N`: the points whose `Γ*`-orbit misses `t₀` (a null set). -/
def Nset : Set UpperHalfPlane := ⋂ γ ∈ Γs, {z | γ • z ∉ t0 s}

/-- The fundamental domain of `Γ*`. -/
def tdom : Set UpperHalfPlane := t0 s ∪ Nset s

/-- Points with two distinct `Γ¹`-equivalent translates in `s` (a null set). -/
def Bad : Set UpperHalfPlane :=
  ⋃ γ ∈ Γs, ⋃ h ∈ {h : GL (Fin 2) ℝ | h ∈ Gamma1 ∧ (fun z : UpperHalfPlane => h • z) ≠ id},
    (fun z : UpperHalfPlane => γ • z) ⁻¹' (s ∩ (fun z : UpperHalfPlane => h • z) ⁻¹' s)

variable {s}

theorem t0_measurable (hs : MeasurableSet s) : MeasurableSet (t0 s) := by
  refine hs.inter (MeasurableSet.biInter gs_countable fun γ _ => ?_)
  have e : {z : UpperHalfPlane | γ • z ∈ s → lexle z (γ • z)} =
      ((fun z : UpperHalfPlane => γ • z) ⁻¹' s)ᶜ ∪ {z | lexle z (γ • z)} := by
    ext z; simp only [Set.mem_setOf_eq, Set.mem_union, Set.mem_compl_iff, Set.mem_preimage]; tauto
  rw [e]
  exact (((continuous_const_smul γ).measurable hs).compl).union (measurableSet_lexle γ)

theorem Nset_measurable (hs : MeasurableSet s) : MeasurableSet (Nset s) :=
  MeasurableSet.biInter gs_countable fun γ _ =>
    ((continuous_const_smul γ).measurable (t0_measurable hs)).compl

theorem bad_null (hsd : ∀ γ ∈ Gamma1, (fun z : UpperHalfPlane => γ • z) ≠ id →
    volume (s ∩ (fun z : UpperHalfPlane => γ • z) ⁻¹' s) = 0) : volume (Bad s) = 0 := by
  refine (measure_biUnion_null_iff gs_countable).2 fun γ _ => ?_
  refine (measure_biUnion_null_iff (g1_countable.mono fun h hh => hh.1)).2 fun h hh => ?_
  rw [measure_preimage_smul]
  exact hsd h hh.1 hh.2

/-- `N ⊆ Bad`: if no point of the orbit of `z` lies in `Bad`, then the orbit meets `s` in at most four
points (one per coset), and its lexicographic minimum lies in `t₀`. -/
theorem Nset_sub_bad (hcov : ∀ z, ∃ γ ∈ Gamma1, γ • z ∈ s) : Nset s ⊆ Bad s := by
  intro z hzN
  by_contra hzB
  set S := {w : UpperHalfPlane | w ∈ s ∧ ∃ γ ∈ Γs, w = γ • z} with hS
  have hsub : S ⊆ ⋃ i : Fin 4, {w : UpperHalfPlane | w ∈ s ∧ ∃ h ∈ Gamma1, w = h • (g4 i • z)} := by
    rintro w ⟨hw, γ, hγ, rfl⟩
    obtain ⟨i, h, hh, hz⟩ := cover_mob hγ
    refine Set.mem_iUnion.2 ⟨i, hw, g4 i * h * (g4 i)⁻¹, conj_g4 i hh, ?_⟩
    rw [hz, mul_smul, mul_smul, inv_smul_smul]
  have hsing : ∀ i : Fin 4,
      {w : UpperHalfPlane | w ∈ s ∧ ∃ h ∈ Gamma1, w = h • (g4 i • z)}.Subsingleton := by
    rintro i w1 ⟨hw1, h1, hh1, rfl⟩ w2 ⟨hw2, h2, hh2, rfl⟩
    by_contra hne
    apply hzB
    refine Set.mem_iUnion₂.2 ⟨h1 * g4 i, gs_mul (gamma1_sub hh1) (g4_mem i),
      Set.mem_iUnion₂.2 ⟨h2 * h1⁻¹, ⟨mul_mem_gamma1 hh2 (inv_mem_gamma1 hh1), ?_⟩, ?_⟩⟩
    · intro hid
      apply hne
      have := congrFun hid (h1 • g4 i • z)
      simp only [id, mul_smul, inv_smul_smul] at this
      exact this.symm
    · show (h1 * g4 i) • z ∈ s ∧ (h2 * h1⁻¹) • ((h1 * g4 i) • z) ∈ s
      simp only [mul_smul, inv_smul_smul]
      exact ⟨hw1, hw2⟩
  have hfin : S.Finite := (Set.finite_iUnion fun i => (hsing i).finite).subset hsub
  have hSne : S.Nonempty := by
    obtain ⟨h, hh, hhz⟩ := hcov z
    exact ⟨h • z, hhz, h, gamma1_sub hh, rfl⟩
  obtain ⟨w, ⟨hw, γ0, hγ0, rfl⟩, hmin⟩ :=
    Set.exists_min_image S (fun w : UpperHalfPlane => toLex (w.re, w.im)) hfin hSne
  have hmem : γ0 • z ∈ t0 s := by
    refine ⟨hw, Set.mem_iInter₂.2 fun γ hγ => ?_⟩
    intro hγs
    rw [lexle_iff]
    exact hmin _ ⟨hγs, γ * γ0, gs_mul hγ hγ0, by rw [mul_smul]⟩
  exact (Set.mem_iInter₂.1 hzN γ0 hγ0) hmem

/-- **`tdom s` is a fundamental domain of `Γ*`.** -/
theorem tdom_fund (hS : IsFundDomain Gamma1 s) : IsFundDomain Γs (tdom s) := by
  obtain ⟨hsm, hcov, hsd⟩ := hS
  have hN0 : volume (Nset s) = 0 := measure_mono_null (Nset_sub_bad hcov) (bad_null hsd)
  refine ⟨(t0_measurable hsm).union (Nset_measurable hsm), fun z => ?_, fun γ hγ hne => ?_⟩
  · by_cases hz : z ∈ Nset s
    · exact ⟨1, gs_one, by rw [one_smul]; exact Or.inr hz⟩
    · simp only [Nset, Set.mem_iInter₂, Set.mem_setOf_eq, not_forall, not_not] at hz
      obtain ⟨γ, hγ, h⟩ := hz
      exact ⟨γ, hγ, Or.inl h⟩
  · refine measure_mono_null (t := ({z | γ • z = z} ∪ Nset s) ∪
      (fun z : UpperHalfPlane => γ • z) ⁻¹' Nset s) ?_ ?_
    · rintro z ⟨hz1 | hz1, hz2 | hz2⟩
      · left; left
        have h1 : lexle z (γ • z) := Set.mem_iInter₂.1 hz1.2 γ hγ hz2.1
        have h2 : lexle (γ • z) z := by
          have := Set.mem_iInter₂.1 hz2.2 γ⁻¹ (gs_inv hγ)
          simp only [Set.mem_setOf_eq, inv_smul_smul] at this
          exact this hz1.1
        exact (lexle_antisymm h1 h2).symm
      · right; exact hz2
      · left; right; exact hz1
      · left; right; exact hz1
    · exact measure_union_null (measure_union_null (fix_null (det_pos_of_mem hγ) hne) hN0)
        (by rw [measure_preimage_smul]; exact hN0)

theorem tdom_ae (hS : IsFundDomain Gamma1 s) : volume (tdom s) = volume (t0 s) := by
  obtain ⟨hsm, hcov, hsd⟩ := hS
  have hN0 : volume (Nset s) = 0 := measure_mono_null (Nset_sub_bad hcov) (bad_null hsd)
  exact le_antisymm ((measure_union_le _ _).trans (by rw [hN0, add_zero]))
    (measure_mono Set.subset_union_left)

end Domain

/-! ## §4 The area: `vol s = 4 vol t` -/

open scoped Pointwise

/-- `Γ¹` as a subgroup of `GL₂(ℝ)`. -/
def G1sub : Subgroup (GL (Fin 2) ℝ) where
  carrier := Gamma1
  one_mem' := one_mem_gamma1
  mul_mem' := mul_mem_gamma1
  inv_mem' := inv_mem_gamma1

/-- The Möbius action as permutations. -/
abbrev mob : GL (Fin 2) ℝ →* Equiv.Perm UpperHalfPlane := MulAction.toPermHom _ _

/-- The Möbius group of `Γ¹`. -/
def Mone : Subgroup (Equiv.Perm UpperHalfPlane) := G1sub.map mob

theorem Mone_smul (σ : Mone) : ∃ h ∈ Gamma1, ∀ z : UpperHalfPlane, σ • z = h • z := by
  obtain ⟨h, hh, hσ⟩ := σ.2
  exact ⟨h, hh, fun z => by show (σ : Equiv.Perm UpperHalfPlane) z = h • z; rw [← hσ]; rfl⟩

instance : MeasurableConstSMul Mone UpperHalfPlane :=
  ⟨fun σ => by
    obtain ⟨h, -, hσ⟩ := Mone_smul σ
    have : (fun z : UpperHalfPlane => σ • z) = fun z => h • z := funext hσ
    rw [this]; exact (continuous_const_smul h).measurable⟩

instance : SMulInvariantMeasure Mone UpperHalfPlane volume :=
  ⟨fun σ A _ => by
    obtain ⟨h, -, hσ⟩ := Mone_smul σ
    have : (fun z : UpperHalfPlane => σ • z) = fun z => h • z := funext hσ
    rw [this]; exact measure_preimage_smul volume h A⟩

instance : Countable Mone := by
  have : (Mone : Set (Equiv.Perm UpperHalfPlane)).Countable := by
    have e : (Mone : Set (Equiv.Perm UpperHalfPlane)) = mob '' Gamma1 := rfl
    rw [e]; exact g1_countable.image _
  exact this.to_subtype

/-- A project fundamental domain of `Γ¹` is a Mathlib fundamental domain of its Möbius group. -/
theorem isFundamentalDomain_of {F : Set UpperHalfPlane} (hm : NullMeasurableSet F volume)
    (hcov : ∀ z, ∃ h ∈ Gamma1, h • z ∈ F)
    (hd : ∀ h ∈ Gamma1, (fun z : UpperHalfPlane => h • z) ≠ id →
      volume (F ∩ (fun z : UpperHalfPlane => h • z) ⁻¹' F) = 0) :
    IsFundamentalDomain Mone F volume := by
  refine IsFundamentalDomain.mk'' hm (Filter.Eventually.of_forall fun z => ?_) (fun σ hσ => ?_)
    (fun σ => (measurePreserving_smul σ volume).quasiMeasurePreserving)
  · obtain ⟨h, hh, hz⟩ := hcov z
    exact ⟨⟨mob h, h, hh, rfl⟩, hz⟩
  · obtain ⟨h, hh, hσh⟩ := Mone_smul σ
    have hne : (fun z : UpperHalfPlane => h⁻¹ • z) ≠ id := by
      intro hid; apply hσ
      apply Subtype.ext; apply Equiv.ext; intro z
      have := congrFun hid (h • z)
      simp only [id, inv_smul_smul] at this
      show σ • z = z
      rw [hσh]; exact this.symm
    have e : σ • F = (fun z : UpperHalfPlane => h⁻¹ • z) ⁻¹' F := by
      rw [← Set.preimage_smul_inv]
      ext z
      simp only [Set.mem_preimage]
      have : σ⁻¹ • z = h⁻¹ • z := by
        have e1 : σ • (σ⁻¹ • z) = z := smul_inv_smul σ z
        rw [hσh] at e1
        calc σ⁻¹ • z = h⁻¹ • (h • (σ⁻¹ • z)) := (inv_smul_smul h _).symm
          _ = h⁻¹ • z := by rw [e1]
      rw [this]
    show volume (σ • F ∩ F) = 0
    rw [e, Set.inter_comm]
    exact hd h⁻¹ (inv_mem_gamma1 hh) hne

/-- Disjointness of the translates of a `Γ*`-domain by a nontrivial Möbius map of `Γ*`, pulled back. -/
theorem piece_null {t : Set UpperHalfPlane} (ht : IsFundDomain Γs t) {γ : GL (Fin 2) ℝ} (hγ : γ ∈ Γs)
    (hne : (fun z : UpperHalfPlane => γ • z) ≠ id) (g : GL (Fin 2) ℝ) :
    volume ((fun z : UpperHalfPlane => g • z) ⁻¹' (t ∩ (fun z : UpperHalfPlane => γ • z) ⁻¹' t)) = 0 := by
  rw [measure_preimage_smul]; exact ht.2.2 γ hγ hne

/-- `rᵢ⁻¹ t`, `i = 0, …, 3`: a fundamental domain of `Γ¹`. -/
def Fdom (t : Set UpperHalfPlane) : Set UpperHalfPlane :=
  ⋃ i : Fin 4, (fun z : UpperHalfPlane => g4 i • z) ⁻¹' t

theorem g4_ne {i j : Fin 4} (hij : i ≠ j) :
    (fun z : UpperHalfPlane => (g4 j * (g4 i)⁻¹) • z) ≠ id := by
  intro hid
  apply hij
  refine coset_eq one_mem_gamma1 fun z => ?_
  have := congrFun hid (g4 i • z)
  simp only [id, mul_smul, inv_smul_smul] at this
  rw [one_smul]; exact this

theorem Fdom_fund {t : Set UpperHalfPlane} (ht : IsFundDomain Γs t) :
    IsFundamentalDomain Mone (Fdom t) volume := by
  obtain ⟨htm, htc, htd⟩ := ht
  refine isFundamentalDomain_of
    (MeasurableSet.iUnion fun i => (continuous_const_smul (g4 i)).measurable htm).nullMeasurableSet
    (fun z => ?_) (fun h hh hne => ?_)
  · obtain ⟨γ, hγ, hz⟩ := htc z
    obtain ⟨i, h, hh, hγz⟩ := cover_mob hγ
    exact ⟨h, hh, Set.mem_iUnion.2 ⟨i, by show g4 i • h • z ∈ t; rw [← hγz]; exact hz⟩⟩
  · -- `z ∈ Fdom ∩ h⁻¹ Fdom`: `rⱼ z ∈ t` and `rᵢ h z ∈ t`
    have hsub : Fdom t ∩ (fun z : UpperHalfPlane => h • z) ⁻¹' Fdom t ⊆
        ⋃ i : Fin 4, ⋃ j : Fin 4, (fun z : UpperHalfPlane => g4 j • z) ⁻¹'
          (t ∩ (fun z : UpperHalfPlane => (g4 i * h * (g4 j)⁻¹) • z) ⁻¹' t) := by
      rintro z ⟨hz1, hz2⟩
      obtain ⟨j, hj⟩ := Set.mem_iUnion.1 hz1
      obtain ⟨i, hi⟩ := Set.mem_iUnion.1 hz2
      refine Set.mem_iUnion₂.2 ⟨i, j, hj, ?_⟩
      show (g4 i * h * (g4 j)⁻¹) • g4 j • z ∈ t
      rw [mul_smul, inv_smul_smul, mul_smul]; exact hi
    refine measure_mono_null hsub (measure_iUnion_null fun i => measure_iUnion_null fun j => ?_)
    by_cases hij : (fun z : UpperHalfPlane => (g4 i * h * (g4 j)⁻¹) • z) = id
    · exfalso
      have hji : i = j := by
        refine coset_eq hh fun z => ?_
        have := congrFun hij (g4 j • z)
        simp only [id, mul_smul, inv_smul_smul] at this
        exact this.symm
      subst hji
      apply hne
      funext z
      have := congrFun hij (g4 i • z)
      simp only [id, mul_smul, inv_smul_smul] at this
      exact (smul_left_cancel_iff (g4 i)).1 this
    · exact piece_null ⟨htm, htc, htd⟩
        (gs_mul (gs_mul (g4_mem i) (gamma1_sub hh)) (gs_inv (g4_mem j))) hij _

theorem Fdom_volume {t : Set UpperHalfPlane} (ht : IsFundDomain Γs t) :
    volume (Fdom t) = 4 * volume t := by
  have hm : ∀ i : Fin 4, MeasurableSet ((fun z : UpperHalfPlane => g4 i • z) ⁻¹' t) :=
    fun i => (continuous_const_smul (g4 i)).measurable ht.1
  rw [Fdom, measure_iUnion₀ ?_ (fun i => (hm i).nullMeasurableSet), tsum_fintype]
  · simp only [measure_preimage_smul, Finset.sum_const, Finset.card_univ, Fintype.card_fin,
      nsmul_eq_mul]
    norm_num
  · intro i j hij
    show volume ((fun z : UpperHalfPlane => g4 i • z) ⁻¹' t ∩
      (fun z : UpperHalfPlane => g4 j • z) ⁻¹' t) = 0
    have e : (fun z : UpperHalfPlane => g4 i • z) ⁻¹' t ∩ (fun z : UpperHalfPlane => g4 j • z) ⁻¹' t =
        (fun z : UpperHalfPlane => g4 i • z) ⁻¹'
          (t ∩ (fun z : UpperHalfPlane => (g4 j * (g4 i)⁻¹) • z) ⁻¹' t) := by
      ext z; simp only [Set.mem_inter_iff, Set.mem_preimage, mul_smul, inv_smul_smul]
    rw [e]
    exact piece_null ht (gs_mul (g4_mem j) (gs_inv (g4_mem i))) (g4_ne hij) _

/-! ## §5 The glue -/

theorem ennreal_arith {x : ENNReal} (h : ENNReal.ofReal (2 * Real.pi / 3) = 4 * x) :
    x = ENNReal.ofReal (Real.pi / 6) := by
  have e : ENNReal.ofReal (2 * Real.pi / 3) = 4 * ENNReal.ofReal (Real.pi / 6) := by
    rw [show 2 * Real.pi / 3 = 4 * (Real.pi / 6) by ring, ENNReal.ofReal_mul (by norm_num)]
    norm_num
  rw [e] at h
  exact ((ENNReal.mul_right_inj (by norm_num) (by norm_num)).1 h).symm

/-- **`GammaStarFromO1` (qm-split's project glue) is a theorem.** -/
theorem gammaStarFromO1_proof : GammaStarFromO1 := by
  rintro ⟨hF, s, hs, hvol⟩
  refine ⟨gs_fuchsian hF, tdom s, tdom_fund hs, ?_⟩
  have h1 : volume s = volume (Fdom (tdom s)) :=
    (isFundamentalDomain_of hs.1.nullMeasurableSet hs.2.1 hs.2.2).measure_eq (Fdom_fund (tdom_fund hs))
  rw [Fdom_volume (tdom_fund hs), hvol] at h1
  exact ennreal_arith h1

end HDec.LeafQCheck.QMglue

#print axioms HDec.LeafQCheck.QMglue.gammaStarFromO1_proof

example : HDec.LeafQCheck.QMSplitVB.GammaStarFromO1 := HDec.LeafQCheck.QMglue.gammaStarFromO1_proof

/-! ## The same glue in `Haupt.lean`'s namespace (`HDec.LeafQCheck.HM.QMSplit`, l.2213-2263, 3175-3195;
the definitions are textually identical to `Valence.lean`'s, only docstrings differ) -/

namespace HDec.LeafQCheck.HM.QMSplit

open PkgI1


/-- `Γ` acts on `ℍ` as a cocompact Fuchsian group (see `Valence.lean`). -/
structure IsCocompactFuchsian (Γ : Set (GL (Fin 2) ℝ)) : Prop where
  one_mem : 1 ∈ Γ
  mul_mem : ∀ a ∈ Γ, ∀ b ∈ Γ, a * b ∈ Γ
  inv_mem : ∀ a ∈ Γ, a⁻¹ ∈ Γ
  det_pos : ∀ a ∈ Γ, 0 < (a : Matrix (Fin 2) (Fin 2) ℝ).det
  properlyDiscontinuous : ∀ K : Set UpperHalfPlane, IsCompact K →
    {f : UpperHalfPlane → UpperHalfPlane | ∃ γ ∈ Γ, f = (fun z => γ • z) ∧ (f '' K ∩ K).Nonempty}.Finite
  cocompact : ∃ C : Set UpperHalfPlane, IsCompact C ∧ ∀ z, ∃ γ ∈ Γ, γ • z ∈ C

/-- A fundamental domain of `Γ` on `ℍ` (see `Valence.lean`). -/
def IsFundDomain (Γ : Set (GL (Fin 2) ℝ)) (s : Set UpperHalfPlane) : Prop :=
  MeasurableSet s ∧ (∀ z, ∃ γ ∈ Γ, γ • z ∈ s) ∧
    ∀ γ ∈ Γ, (fun z : UpperHalfPlane => γ • z) ≠ id →
      MeasureTheory.volume (s ∩ (fun z : UpperHalfPlane => γ • z) ⁻¹' s) = 0



/-- **GLUE (`Γ*` is a cocompact Fuchsian group with covolume `π/6`)**, as in `Valence.lean` (row H-87). -/
def GammaStarCocompactArea : Prop :=
  IsCocompactFuchsian PkgI1.GammaStar ∧
    ∃ s, IsFundDomain PkgI1.GammaStar s ∧ MeasureTheory.volume s = ENNReal.ofReal (Real.pi / 6)

/-- `Γ¹ = ι(𝒪¹)`: the images of the norm-one units of `𝒪` (`det ι(x) = nrd(x)`). -/
def Gamma1 : Set (GL (Fin 2) ℝ) :=
  {γ | ∃ x : PkgI1.B, PkgI1.InO x ∧ (γ : Matrix (Fin 2) (Fin 2) ℝ) = PkgI1.iota x ∧
    (γ : Matrix (Fin 2) (Fin 2) ℝ).det = 1}

/-- **LEAF (Shimura; Shimizu's volume formula).** `Γ¹ = ι(𝒪¹)`, for the maximal order `𝒪` of the indefinite
division algebra `B` of discriminant `6`, is a cocompact Fuchsian group, with a fundamental domain of
hyperbolic area `(π/3) ∏_{p | 6} (p − 1) = 2π/3`. Shimura, *Introduction to the arithmetic theory of
automorphic functions*, 1971, Prop. 9.2 (cocompactness); H. Shimizu, *On zeta functions of quaternion
algebras*, Ann. of Math. 81 (1965) (volume); Vignéras, *Arithmétique des algèbres de quaternions*, LNM 800,
IV §1; Voight, *Quaternion algebras*, Thm 39.1.13; locators UNVERIFIED. -/
def ShimizuCovolumeO1 : Prop :=
  IsCocompactFuchsian Gamma1 ∧
    ∃ s, IsFundDomain Gamma1 s ∧ MeasureTheory.volume s = ENNReal.ofReal (2 * Real.pi / 3)

/-- **GLUE (from `𝒪¹` to `Γ*`).** Shimizu's statement for `Γ¹` gives `GammaStarCocompactArea`. What it needs:
`Γ¹ ⊆ Γ*`, the index `[Γ* : ℚ^×Γ¹] = 4` of the Möbius groups (`N_B(𝒪)⁺/ℚ^×𝒪^×₊ ≅ W`, representatives
`1, x₄, x₆, x₄x₆` up to `𝒪¹`; `GammaStarGen` and the chain's `tt` representatives), proper discontinuity and
cocompactness of a finite-index supergroup, and the comparison of fundamental domains (area divided by the
index). Project glue (measure theory and an index computation). -/
def GammaStarFromO1 : Prop := ShimizuCovolumeO1 → GammaStarCocompactArea

/-- **`GammaStarFromO1` of `Haupt.lean` (row H-88) is a theorem**, by transport from `Valence.lean`'s copy. -/
theorem gammaStarFromO1_proof : GammaStarFromO1 := by
  rintro ⟨⟨h1, h2, h3, h4, h5, h6⟩, s, hs, hvol⟩
  obtain ⟨⟨k1, k2, k3, k4, k5, k6⟩, t, ht, htv⟩ :=
    HDec.LeafQCheck.QMglue.gammaStarFromO1_proof ⟨⟨h1, h2, h3, h4, h5, h6⟩, s, hs, hvol⟩
  exact ⟨⟨k1, k2, k3, k4, k5, k6⟩, t, ht, htv⟩

end HDec.LeafQCheck.HM.QMSplit

#print axioms HDec.LeafQCheck.HM.QMSplit.gammaStarFromO1_proof
