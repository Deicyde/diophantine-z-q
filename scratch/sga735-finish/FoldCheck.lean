`m = 3` for `p ≠ 13`, `m = 7` for `p = 13` (`raynaudPlace_of_R6Nil`, `tateWildK_of_raynaud`). -/
theorem tateWildK_of_R6_nl (hR6 : _root_.SGA735Nil.RaynaudCriterionNFNil) (hTors : ObjBridge.TorsionStructure)
    {A : PkgI3.AbVar K} (hdim : A.dim = 2) {ℓ : ℕ} [Fact ℓ.Prime] (hℓp : ℓ ≠ p) (h7 : 7 ≤ p) :
    TateWildK (p := p) A ℓ := by
