    (by norm_num) ?_) (fun h13 => raynaudPlace_of_R6Nil hR6 hTors A hdim (by norm_num) ?_)
  · intro h
    have := Nat.le_of_dvd (by norm_num) h
    omega
  · intro h
    rw [h13] at h
    norm_num at h
