theorem s6_sq : s6 ^ 2 = -6 := by
  have hz := IsCyclotomicExtension.zeta_spec 24 ℚ (CyclotomicField 24 ℚ)
  have h3 : IsPrimitiveRoot (z24 ^ 8) 3 := hz.pow_of_dvd (by norm_num) (by norm_num)
