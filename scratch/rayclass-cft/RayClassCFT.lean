    have h2 : ((z24 ^ 3) ^ 4) ^ 2 = 1 := by rw [← pow_mul]; exact h8.pow_eq_one
    have hne : (z24 ^ 3) ^ 4 ≠ 1 := h8.pow_ne_one_of_pos_of_lt (by norm_num) (by norm_num)
