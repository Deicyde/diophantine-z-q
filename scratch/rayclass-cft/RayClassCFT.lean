/-! # rayclass-cft, Part P2: the Props (leaves and glue) and the core argument -/

set_option linter.all false

noncomputable section

namespace RayClassCFT

open CategoryTheory AlgebraicGeometry Limits
open LeafQM LeafQM.AV NumberField IsDedekindDomain
open ShimuraCFT
open TauCeti.ClassFieldTheory TauCeti.GlobalNumberFields
open ZInQ.LeafPush2 (CPts IsUniformization)

/-! ## P2a. Copies (t5-glue `Field.lean`, Mathlib only): extension of automorphisms of `ℚ̄` to `ℂ` -/

open MvPolynomial in
/-- An automorphism of the polynomial ring on a transcendence basis extends to `K`
(verbatim from `scratch/t5-glue/Field.lean`). -/
theorem exists_aut_extend {k K : Type*} [Field k] [Field K] [IsAlgClosed K] [Algebra k K]
    {ιT : Type*} {v : ιT → K} (hv : IsTranscendenceBasis k v)
    (ψ : MvPolynomial ιT k ≃+* MvPolynomial ιT k) :
    ∃ σ : K ≃+* K, ∀ p : MvPolynomial ιT k, σ (aeval v p) = aeval v (ψ p) := by
  let e := hv.1.aevalEquiv
  let φ : Algebra.adjoin k (Set.range v) ≃+* Algebra.adjoin k (Set.range v) :=
    e.symm.toRingEquiv.trans (ψ.trans e.toRingEquiv)
  have : Algebra.IsAlgebraic (Algebra.adjoin k (Set.range v)) K := hv.isAlgebraic
  have : IsAlgClosure (Algebra.adjoin k (Set.range v)) K := ⟨inferInstance, inferInstance⟩
  refine ⟨IsAlgClosure.equivOfEquiv K K φ, fun p => ?_⟩
  rw [← hv.1.algebraMap_aevalEquiv, IsAlgClosure.equivOfEquiv_algebraMap,
    ← hv.1.algebraMap_aevalEquiv]
  congr 1
  simp [φ, e]

open MvPolynomial in
/-- **Extension of automorphisms** (verbatim from `scratch/t5-glue/Field.lean`). -/
theorem exists_ringEquiv_extend {k K : Type*} [Field k] [Field K] [IsAlgClosed K]
    (ι : k →+* K) (ρ : k ≃+* k) : ∃ σ : K ≃+* K, ∀ a : k, σ (ι a) = ι (ρ a) := by
  let _ : Algebra k K := ι.toAlgebra
  have : FaithfulSMul k K := (faithfulSMul_iff_algebraMap_injective k K).2 ι.injective
  obtain ⟨T, hT⟩ := exists_isTranscendenceBasis k K
  obtain ⟨σ, hσ⟩ := exists_aut_extend hT (MvPolynomial.mapEquiv T ρ)
  refine ⟨σ, fun a => ?_⟩
  have h := hσ (C a)
  simp only [aeval_C, mapEquiv_apply, map_C] at h
  exact h

/-! ## P2b. The Props -/

/-- `𝒪̂^× ⊆ (B ⊗ 𝔸_f)^×` (the kernel's `ShimuraGlue.Kfull`, with `𝓞 ℚ` in place of `ℤ`). -/
def OhatU : Set BAQˣ := {u | (u : BAQ) ∈ OhatQ ∧ ((u⁻¹ : BAQˣ) : BAQ) ∈ OhatQ}

/-- The body of shimura-cft's `ShimuraDeligneBody` with the map `Ψ` as an argument (its text after
`∃ Ψ, `, verbatim). -/
def DeligneBodyAt (Y : Over (Spec (CommRingCat.of ℚ))) (Φ : PtEquiv Y)
    (Ψ : UpperHalfPlane → BAQˣ → (fieldPt ℂ ⟶ Y)) : Prop :=
    (∀ y : fieldPt ℂ ⟶ Y, ∃ τ g, Ψ τ g = y) ∧
    (∀ τ g τ' g', Ψ τ g = Ψ τ' g' ↔ DCRel τ g τ' g') ∧
    (∀ g, ShimuraSplit.IsHolFamily (X := Y.left) (fun τ => (Ψ τ g).left)) ∧
    HDec.HSyn.G0Split.FibreQM.IsShimuraHolFamily Y Φ (fun τ => Ψ τ 1) ∧
    ∃ (ε : ℤˣ) (δ : Bool),
      ∀ (K : Type) [Field K] [NumberField K] [IsTotallyComplex K], Module.finrank ℚ K = 2 →
      ∀ (κ : K →+* ℂ) (q : K →ₐ[ℚ] LeafQM.B) (z : UpperHalfPlane),
        IsCMPoint q (if δ then κ else (starRingEnd ℂ).comp κ) z →
      ∀ (σ : ℂ ≃+* ℂ) (s : IdeleGroup (𝓞 K) K), ArtinCondC κ σ s →
      ∀ g : BAQˣ, galPt σ (Ψ z g) = Ψ z (qHatU q s ^ (ε : ℤ) * g)

theorem shimuraDeligneBody_iff (Y : Over (Spec (CommRingCat.of ℚ))) (Φ : PtEquiv Y) :
    ShimuraDeligneBody Y Φ ↔ ∃ Ψ, DeligneBodyAt Y Φ Ψ := Iff.rfl

/-- **The moduli clause at every `u ∈ 𝒪̂^×`**: the object at `Ψ(τ, u)` is, as a QM pair, the torus
`ℂ²/ι(𝒪)(τ, 1)ᵀ` with its `ι` (the moduli part of `IsShimuraHolFamily`, verbatim, at `Ψ(τ, u)` in
place of `Ψ(τ, 1)`). In the moduli description of `Sh_{K₃}` the point `[τ, g]` is the torus
`ℂ²/ι(B ∩ 𝒪̂g⁻¹)(τ,1)ᵀ` with the level structure induced by `g`; for `g = u ∈ 𝒪̂^×` the lattice is
`ι(𝒪)(τ,1)ᵀ` and only the level structure changes. -/
def ModuliAtUnits (Y : Over (Spec (CommRingCat.of ℚ))) (Φ : PtEquiv Y)
    (Ψ : UpperHalfPlane → BAQˣ → (fieldPt ℂ ⟶ Y)) : Prop :=
  ∀ u ∈ OhatU, ∀ τ : UpperHalfPlane, ∃ P : QML3 ℂ, Φ ℂ (Ψ τ u) = M3.mk P ∧
    ∃ Φu : (Fin 2 → ℂ) → CPts P.A (RingHom.id ℂ),
      IsUniformization (RingHom.id ℂ) (BPAnalytic.QM.qmLattice τ.im_pos.ne') Φu ∧
      HDec.HSyn.G0Split.FibreQM.IotaCompatible P Φu

/-- **LEAF `ShimuraMainThmIDeligneY3AbU`**: shimura-cft's leaf `ShimuraMainThmIDeligneY3Ab` with its
moduli clause stated at every `u ∈ 𝒪̂^×` instead of `u = 1` (`ModuliAtUnits`).

*Published statements* (locators recalled, UNVERIFIED; no network): as for
`ShimuraMainThmIDeligneY3Ab` (Shimura, Ann. of Math. 85 (1967), Main Theorem I and §§2-3;
Deligne, Sém. Bourbaki 389 (1971), §§3-4; Milne, *Introduction to Shimura varieties*, §§12-14). In the
moduli interpretation of `Sh_K(B^×, ℍ^±)` for a quaternion algebra over `ℚ` (Deligne §4; Milne Ex. 14),
`[τ, g]` is the class of `(ℂ²/ι(L_g)(τ,1)ᵀ, ι, η_g)` with `L_g = B ∩ 𝒪̂g⁻¹`; for `g ∈ 𝒪̂^×`,
`L_g = 𝒪`. *Form*: a consequence (the moduli clause is kept for `g ∈ 𝒪̂^×` only, and only the QM pair,
not the level structure, is described). -/
def ShimuraMainThmIDeligneY3AbU : Prop :=
  ∃ (Y : Over (Spec (CommRingCat.of ℚ))) (Φ : PtEquiv Y),
    LeafQM.AV.R1UnivRigid.R1fpPropsAb Y Φ ∧ ∃ Ψ, DeligneBodyAt Y Φ Ψ ∧ ModuliAtUnits Y Φ Ψ

/-- The new leaf implies shimura-cft's (drop `ModuliAtUnits`). -/
theorem mainThmI_of_U (h : ShimuraMainThmIDeligneY3AbU) : ShimuraMainThmIDeligneY3Ab := by
  obtain ⟨Y, Φ, h1, Ψ, hb, -⟩ := h
  exact ⟨Y, Φ, h1, Ψ, hb⟩

/-- **LEAF `ClassNumberOneB` (Eichler)**: `(B ⊗ 𝔸_f)^× = B^× · 𝒪̂^×`, i.e. the maximal order
`𝒪 = ℤ⟨1, i, (1+j)/2, (i+k)/2⟩` of the indefinite algebra `B = (2, −3 | ℚ)` has one class of locally
principal left ideals.

*Published statement* (locators recalled, UNVERIFIED): Eichler's class number theorem: an Eichler
order (in particular a maximal order) in an indefinite quaternion algebra over `ℚ` has class number one
(Eichler, J. reine angew. Math. 195 (1955); Vignéras, *Arithmétique des algèbres de quaternions*,
LNM 800, Cor. III.5.7; Voight, *Quaternion algebras*, GTM 288, Cor. 28.5.17), read adelically:
`Cls 𝒪 = B^× \ (B ⊗ 𝔸_f)^× / 𝒪̂^×` (Voight 27.6). *Form*: the printed statement (adelic form). -/
def ClassNumberOneB : Prop :=
  ∀ g : BAQˣ, ∃ γ : LeafQM.B, ShimuraGlue.nrdQ ℚ γ ≠ 0 ∧
    ∃ u ∈ OhatU, (g : BAQ) = bEmb γ * (u : BAQ)

/-- **GLUE `QHatIntegral k`** (adelic algebra): if `q(𝒪_k) ⊆ 𝒪`, then `q̂` maps the ideles of the
congruence subgroup of the modulus `3·𝒪_k` (units at every finite place, `≡ 1 mod 3` above 3) into
`K₃`. True: `q̂(𝒪̂_k) ⊆ 𝒪̂` because `𝒪̂_k = ℤ̂ ⊗ 𝒪_k` under Tau Ceti's base change
`𝔸_{ℚ,f} ⊗_ℚ k ≅ 𝔸_{k,f}`, and `q̂(1 + 3x) = 1 + 3 q̂(x)`. -/
def QHatIntegral (k : Type) [Field k] [NumberField k] : Prop :=
  ∀ q : k →ₐ[ℚ] LeafQM.B, (∀ x : 𝓞 k, InO (q x)) →
    ∀ s ∈ ideleCongruenceSubgroup (ShimuraGlue.Ray.mod3 k), qHatU q s ∈ K3Q

/-- **GLUE `CMBaseChange`**: the CM relations of `P/ℚ̄` pass to an object `Q/ℂ` that is a base change
of `P` (the kernel's relation `IsBaseChangeOf`). True: the endomorphism `φ` of `P.A` gives
`φ_ℂ = pullback.lift (g ≫ φ) Q.A.hom`, a pointed morphism of abelian varieties, hence a homomorphism
(rigidity), commuting with `ι_Q` and satisfying the same polynomial identity. -/
def CMBaseChange : Prop :=
  ∀ (ιe : Qbar →+* ℂ) (P : QML3 Qbar) (Q : QML3 ℂ), IsBaseChangeOf ιe P Q →
    (HasCM4 P.q → HasCM4 Q.q) ∧ (HasCM3 P.q → HasCM3 Q.q) ∧ (HasCM24 P.q → HasCM24 Q.q)

/-- **GLUE `CMAnalytic`**: for a QM surface `Q/ℂ` uniformized `ι`-compatibly by
`Λ_τ = ι(𝒪)(τ, 1)ᵀ`, the analytic representation is a ring map `End_𝒪(Q) → 𝒪` whose values have
`(τ, 1)ᵀ` as an eigenvector. True: every endomorphism `f` lifts to a `ℂ`-linear `M` with `M Λ_τ ⊆ Λ_τ`
(the kernel's textbook leaf `T11a_RiemannEnd`); `f ∈ End_𝒪` makes `M` commute with `ι(𝒪)`, hence
`M = λ`; `λ(τ, 1)ᵀ ∈ Λ_τ` gives `β ∈ 𝒪` with `ι(β)(τ, 1)ᵀ = λ(τ, 1)ᵀ`; `f ↦ β` is a ring map
because lifts are unique. -/
def CMAnalytic : Prop :=
  ∀ (τ : UpperHalfPlane) (Q : QML3 ℂ) (Φu : (Fin 2 → ℂ) → CPts Q.A (RingHom.id ℂ)),
    IsUniformization (RingHom.id ℂ) (BPAnalytic.QM.qmLattice τ.im_pos.ne') Φu →
    HDec.HSyn.G0Split.FibreQM.IotaCompatible Q Φu →
    ∃ ρ : com Q.q →+* LeafQM.B, ∀ φ : com Q.q, InO (ρ φ) ∧ ∃ lam : ℂ,
      Matrix.mulVec ((BPAnalytic.QM.iota (ρ φ)).map (algebraMap ℝ ℂ)) ![(τ : ℂ), 1] =
        lam • ![(τ : ℂ), 1]

/-! ## P2c. Units of `B` and of `𝒪̂` -/

theorem nrd_ne_zero_of_mul {x y : LeafQM.B} (h : x * y = 1) : ShimuraGlue.nrdQ ℚ x ≠ 0 := by
  intro h0
  have := congrArg (ShimuraGlue.nrdQ ℚ) h
  rw [map_mul, h0, zero_mul, map_one] at this
  exact zero_ne_one this

/-- `γ⁻¹ = nrd(γ)⁻¹ γ̄`. -/
def binv (γ : LeafQM.B) : LeafQM.B := (ShimuraGlue.nrdQ ℚ γ)⁻¹ • star γ

theorem mul_binv {γ : LeafQM.B} (h : ShimuraGlue.nrdQ ℚ γ ≠ 0) : γ * binv γ = 1 := by
  rw [binv, mul_smul_comm, ← nrd_coe_eq]
  rw [QuaternionAlgebra.coe_algebraMap.symm, Algebra.smul_def, ← map_mul, inv_mul_cancel₀ h, map_one]

theorem binv_mul {γ : LeafQM.B} (h : ShimuraGlue.nrdQ ℚ γ ≠ 0) : binv γ * γ = 1 := by
  rw [binv, smul_mul_assoc, star_mul_eq, ← nrd_coe_eq]
  rw [QuaternionAlgebra.coe_algebraMap.symm, Algebra.smul_def, ← map_mul, inv_mul_cancel₀ h, map_one]

theorem nrd_binv_pos {γ : LeafQM.B} (h : 0 < ShimuraGlue.nrdQ ℚ γ) : 0 < ShimuraGlue.nrdQ ℚ (binv γ) := by
  have h1 := congrArg (ShimuraGlue.nrdQ ℚ) (mul_binv h.ne')
  rw [map_mul, map_one] at h1
  by_contra hn
  push Not at hn
  nlinarith

theorem OhatQ_mul {x y : BAQ} (hx : x ∈ OhatQ) (hy : y ∈ OhatQ) : x * y ∈ OhatQ := by
  obtain ⟨n, hn, rfl⟩ := hx
  obtain ⟨m, hm, rfl⟩ := hy
  refine ⟨ShimuraGlue.mulCoordR n m, fun j => ?_, ShimuraGlue.ofQ_mul n m⟩
  have e : ShimuraGlue.mulCoordR (fun i => ZhatS.subtype ⟨n i, hn i⟩)
      (fun i => ZhatS.subtype ⟨m i, hm i⟩) j =
      ZhatS.subtype (ShimuraGlue.mulCoordR (fun i => (⟨n i, hn i⟩ : ZhatS)) (fun i => ⟨m i, hm i⟩) j) := by
    fin_cases j <;> simp [ShimuraGlue.mulCoordR]
  exact e ▸ (ShimuraGlue.mulCoordR (fun i => (⟨n i, hn i⟩ : ZhatS)) (fun i => ⟨m i, hm i⟩) j).2

theorem OhatQ_one : (1 : BAQ) ∈ OhatQ := by
  simpa using bEmb_mem_of_inO (x := 1) ⟨![1, 0, 0, 0], by ext <;> simp [LeafQM.ofInt]⟩

theorem OhatQ_add {x y : BAQ} (hx : x ∈ OhatQ) (hy : y ∈ OhatQ) : x + y ∈ OhatQ := by
  obtain ⟨n, hn, rfl⟩ := hx
  obtain ⟨m, hm, rfl⟩ := hy
  exact ⟨n + m, fun i => ZhatS.add_mem (hn i) (hm i), ShimuraGlue.ofQ_add n m⟩

theorem OhatQ_natCast (n : ℕ) : (n : BAQ) ∈ OhatQ := by
  induction n with
  | zero => exact ⟨0, fun i => ZhatS.zero_mem, by simp [ShimuraGlue.ofQ_zero]⟩
  | succ n ih => push_cast; exact OhatQ_add ih OhatQ_one

/-- `K₃` is normalized by `𝒪̂^×`. -/
theorem conj_mem_K3Q {u k : BAQˣ} (hu : u ∈ OhatU) (hk : k ∈ K3Q) : u⁻¹ * k * u ∈ K3Q := by
  obtain ⟨hu1, hu2⟩ := hu
  obtain ⟨hk1, hk2, y, hy, hky⟩ := hk
  refine ⟨?_, ?_, ((u⁻¹ : BAQˣ) : BAQ) * y * u, OhatQ_mul (OhatQ_mul hu2 hy) hu1, ?_⟩
  · simp only [Units.val_mul]; exact OhatQ_mul (OhatQ_mul hu2 hk1) hu1
  · rw [mul_inv_rev, mul_inv_rev, inv_inv]
    simp only [Units.val_mul]
    first | exact OhatQ_mul (OhatQ_mul hu2 hk2) hu1 | exact OhatQ_mul hu2 (OhatQ_mul hk2 hu1)
  · simp only [Units.val_mul, hky]
    have h3 : ((u⁻¹ : BAQˣ) : BAQ) * 3 = 3 * ((u⁻¹ : BAQˣ) : BAQ) := (Commute.ofNat_right _ 3).eq
    have h1 : ((u⁻¹ : BAQˣ) : BAQ) * (u : BAQ) = 1 := by simp
    calc ((u⁻¹ : BAQˣ) : BAQ) * (1 + 3 * y) * u
        = ((u⁻¹ : BAQˣ) : BAQ) * u + (((u⁻¹ : BAQˣ) : BAQ) * 3) * y * u := by noncomm_ring
      _ = 1 + 3 * (((u⁻¹ : BAQˣ) : BAQ) * y * u) := by rw [h1, h3]; noncomm_ring

/-- `bEmb` of a unit of `B` with explicit inverse, as a unit. -/
def bUnit (x y : LeafQM.B) (h1 : x * y = 1) (h2 : y * x = 1) : BAQˣ where
  val := bEmb x
  inv := bEmb y
  val_inv := by rw [← map_mul, h1, map_one]
  inv_val := by rw [← map_mul, h2, map_one]

/-- `1 + i ∈ 𝒪^×`, of reduced norm `−1`. -/
def mu : LeafQM.B := ⟨1, 1, 0, 0⟩
def muInv : LeafQM.B := ⟨-1, 1, 0, 0⟩

theorem mu_mul : mu * muInv = 1 := by ext <;> simp [mu, muInv] <;> norm_num
theorem mul_mu : muInv * mu = 1 := by ext <;> simp [mu, muInv] <;> norm_num
theorem nrd_mu : ShimuraGlue.nrdQ ℚ mu = -1 := by simp [ShimuraGlue.nrdQ_apply, mu]; norm_num
theorem inO_mu : InO mu := ⟨![1, 1, 0, 0], by ext <;> simp [mu, LeafQM.ofInt]⟩
theorem inO_muInv : InO muInv := ⟨![-1, 1, 0, 0], by ext <;> simp [muInv, LeafQM.ofInt]⟩

/-- **Class number one with `nrd γ > 0`** (from `ClassNumberOneB`, with `1 + i` of norm `−1`). -/
theorem exists_pos_decomp (hCN : ClassNumberOneB) (g : BAQˣ) :
    ∃ γ : LeafQM.B, 0 < ShimuraGlue.nrdQ ℚ γ ∧ ∃ u ∈ OhatU, (g : BAQ) = bEmb γ * (u : BAQ) := by
  obtain ⟨γ, hγ, u, hu, hg⟩ := hCN g
  rcases lt_or_gt_of_ne hγ with hneg | hpos
  · refine ⟨γ * mu, by rw [map_mul, nrd_mu]; linarith, bUnit muInv mu mul_mu mu_mul * u, ?_, ?_⟩
    · refine ⟨?_, ?_⟩
      · simp only [Units.val_mul]
        exact OhatQ_mul (bEmb_mem_of_inO inO_muInv) hu.1
      · rw [mul_inv_rev]; simp only [Units.val_mul]
        exact OhatQ_mul hu.2 (bEmb_mem_of_inO inO_mu)
    · rw [hg, Units.val_mul, map_mul]
      show bEmb γ * (u : BAQ) = bEmb γ * bEmb mu * (bEmb muInv * (u : BAQ))
      rw [mul_assoc, ← mul_assoc (bEmb mu), ← map_mul, mu_mul, map_one, one_mul]
  · exact ⟨γ, hpos, u, hu, hg⟩

/-! ## P2d. The relation `DCRel` -/

/-- `ι(γ)` as an element of `GL₂(ℝ)` (for `nrd γ ≠ 0`). -/
def iotaGL (γ : LeafQM.B) (h : ShimuraGlue.nrdQ ℚ γ ≠ 0) : GL (Fin 2) ℝ :=
  Matrix.GeneralLinearGroup.mkOfDetNeZero (BPAnalytic.QM.iota γ)
    (by rw [det_iota]; exact_mod_cast h)

theorem iotaGL_coe (γ : LeafQM.B) (h : ShimuraGlue.nrdQ ℚ γ ≠ 0) :
    ((iotaGL γ h : GL (Fin 2) ℝ) : Matrix (Fin 2) (Fin 2) ℝ) = BPAnalytic.QM.iota γ := rfl

theorem K3Q_one : (1 : BAQˣ) ∈ K3Q :=
  ⟨by simpa using OhatQ_one, by simpa using OhatQ_one, 0, ⟨0, fun i => ZhatS.zero_mem, by
    simp [ShimuraGlue.ofQ_zero]⟩, by simp⟩

/-- Move `γ ∈ B^×_+` from `g = γu` to the half plane. -/
theorem dcRel_of_decomp {γ : LeafQM.B} (hγ : 0 < ShimuraGlue.nrdQ ℚ γ) (τ : UpperHalfPlane)
    {g u : BAQˣ} (hg : (g : BAQ) = bEmb γ * (u : BAQ)) :
    DCRel τ g ((iotaGL (binv γ) (nrd_binv_pos hγ).ne') • τ) u := by
  refine ⟨binv γ, nrd_binv_pos hγ, ⟨_, iotaGL_coe _ _, rfl⟩, 1, K3Q_one, ?_⟩
  rw [hg, Units.val_one, mul_one, ← mul_assoc, ← map_mul, binv_mul hγ.ne', map_one, one_mul]

/-- A CM point is fixed: `DCRel τ u τ (γ u k)` for `γ` with eigenvector `(τ, 1)ᵀ` and `nrd γ > 0`. -/
theorem dcRel_fix {γ : LeafQM.B} (hγ : 0 < ShimuraGlue.nrdQ ℚ γ) (τ : UpperHalfPlane) {lam : ℂ}
    (heig : Matrix.mulVec ((BPAnalytic.QM.iota γ).map (algebraMap ℝ ℂ)) ![(τ : ℂ), 1] =
      lam • ![(τ : ℂ), 1]) (u k g' : BAQˣ) (hk : k ∈ K3Q)
    (hg' : (g' : BAQ) = bEmb γ * (u : BAQ) * (k : BAQ)) : DCRel τ u τ g' := by
  refine ⟨γ, hγ, ⟨iotaGL γ hγ.ne', iotaGL_coe _ _, ?_⟩, k, hk, hg'⟩
  exact smul_eq_of_eig _ τ (by rw [iotaGL_coe]; exact heig)

end RayClassCFT


/-! ===== part: scratch/rayclass-cft/RayProof3.lean ===== -/

/-! # rayclass-cft, Part P3: the core argument (one imaginary quadratic field `k`) -/

set_option linter.all false

noncomputable section

namespace RayClassCFT

open CategoryTheory AlgebraicGeometry Limits
open LeafQM LeafQM.AV NumberField IsDedekindDomain
open ShimuraCFT
open TauCeti.ClassFieldTheory TauCeti.GlobalNumberFields

variable {k : Type} [Field k] [NumberField k]

/-- `q̂` on principal ideles is `q`. -/
theorem qHatU_unitEmbedding (q : k →ₐ[ℚ] LeafQM.B) (c : kˣ) :
    ((qHatU q (IdeleGroup.unitEmbedding (𝓞 k) k c) : BAQˣ) : BAQ) = bEmb (q c) := by
  show qHat q ((IdeleGroup.toFiniteIdele (𝓞 k) k (IdeleGroup.unitEmbedding (𝓞 k) k c) :
    FiniteAdeleRing (𝓞 k) k)) = bEmb (q c)
  rw [IdeleGroup.toFiniteIdele_unitEmbedding, FiniteAdeleRing.unitEmbedding_apply, qHat_algebraMap]

/-- `nrd q(c) > 0` at a CM point (`ι(q(c))` is a real matrix with a non-real eigenvector). -/
theorem nrd_pos_of_cm (q : k →ₐ[ℚ] LeafQM.B) (κ : k →+* ℂ) (τ : UpperHalfPlane)
    (h : IsCMPoint q κ τ) (c : kˣ) : 0 < ShimuraGlue.nrdQ ℚ (q c) := by
  have hne : ShimuraGlue.nrdQ ℚ (q c) ≠ 0 :=
    nrd_ne_zero_of_mul (x := q c) (y := q ↑c⁻¹) (by rw [← map_mul, Units.mul_inv, map_one])
  have hdet := det_pos_of_eig τ.im_pos.ne' (h c) (by rw [det_iota]; exact_mod_cast hne)
  rw [det_iota] at hdet
  exact_mod_cast hdet

/-- **The core argument.** Let `Ψ` satisfy the Deligne body, `𝒪̂^×` have class number one, `k` be
imaginary quadratic with `QHatIntegral k`, and `y` a `ℚ̄`-point such that at every representative
`(τ, u)`, `u ∈ 𝒪̂^×`, of `ιC^* y` there is an embedding `q : k → B` with `q(𝒪_k) ⊆ 𝒪` and CM point `τ`.
Then `ℚ(y)` embeds into the ray class field of `k` of conductor `3`. -/
theorem embed_core {Y : Over (Spec (CommRingCat.of ℚ))} {Φ : PtEquiv Y}
    {Ψ : UpperHalfPlane → BAQˣ → (fieldPt ℂ ⟶ Y)} (hb : DeligneBodyAt Y Φ Ψ)
    (hCN : ClassNumberOneB) (k : Type) [Field k] [NumberField k] [IsTotallyComplex k]
    (hk : Module.finrank ℚ k = 2) (hI : QHatIntegral k) (y : fieldPt Qbar ⟶ Y)
    (hcm : ∀ (τ : UpperHalfPlane) (u : BAQˣ), u ∈ OhatU → Ψ τ u = fieldMap ιC ≫ y →
      ∃ (q : k →ₐ[ℚ] LeafQM.B) (κ₀ : k →+* ℂ), (∀ x : 𝓞 k, InO (q x)) ∧ IsCMPoint q κ₀ τ) :
    Nonempty (residueImage (X := Y.left) y.left →+* rayClassField (ShimuraGlue.Ray.mod3 k)) := by
  obtain ⟨hsurj, hfib, -, -, ε, δ, hrec⟩ := hb
  -- (a) a representative `(τ, u)` of `ιC^* y` with `u ∈ 𝒪̂^×` (class number one)
  obtain ⟨τ₀, g, hτ₀⟩ := hsurj (fieldMap ιC ≫ y)
  obtain ⟨γ, hγ, u, hu, hg⟩ := exists_pos_decomp hCN g
  let τ := (iotaGL (binv γ) (nrd_binv_pos hγ).ne') • τ₀
  have hτu : Ψ τ u = fieldMap ιC ≫ y := by
    rw [← hτ₀]; exact ((hfib τ₀ g τ u).2 (dcRel_of_decomp hγ τ₀ hg)).symm
  -- (b) the CM data at `τ`
  obtain ⟨q, κ₀, hqO, hcmτ⟩ := hcm τ u hu hτu
  -- (c) the reflex embedding in the convention `δ`
  let κ : k →+* ℂ := if δ then κ₀ else (starRingEnd ℂ).comp κ₀
  have hκκ : (if δ then κ else (starRingEnd ℂ).comp κ) = κ₀ := by
    cases δ <;> ext a <;> simp [κ]
  -- (d) the ray class field `L` and an embedding `j : L → ℚ̄` over `κ`
  let L := rayClassField (ShimuraGlue.Ray.mod3 k)
  letI : Algebra k ℂ := κ.toAlgebra
  let j' : L →ₐ[k] ℂ := IsAlgClosed.lift
  have hj' : (j' : L →+* ℂ).comp (algebraMap k L) = κ := by
    ext a; exact j'.commutes a
  obtain ⟨j, hj⟩ := exists_lift_ringHom (L := L) (j' : L →+* ℂ)
  let jA : L →ₐ[ℚ] Qbar := j.toRatAlgHom
  let F : IntermediateField ℚ Qbar := jA.fieldRange
  -- (e) every `σ ∈ Gal(ℚ̄/F)` fixes `y`
  have hfix : ∀ σ ∈ F.fixingSubgroup,
      Spec.map (CommRingCat.ofHom ((σ : Qbar →ₐ[ℚ] Qbar) : Qbar →+* Qbar)) ≫ y.left = y.left := by
    intro σ hσ
    obtain ⟨σC, hσC⟩ := exists_ringEquiv_extend (ιC : Qbar →+* ℂ) σ.toRingEquiv
    have hσC' : ∀ a, σC (ιC a) = ιC (σ a) := fun a => hσC a
    have hσF : ∀ x : L, σ (j x) = j x := fun x =>
      (IntermediateField.mem_fixingSubgroup_iff F σ).1 hσ (j x) (AlgHom.mem_fieldRange.2 ⟨x, rfl⟩)
    have hσL : ∀ x : L, σC (j' x) = j' x := fun x => by
      rw [show j' x = (j' : L →+* ℂ) x from rfl, ← hj, hσC', hσF]
    have hσκ : ∀ a : k, σC (κ a) = κ a := fun a => by
      have e : (j' : L →+* ℂ) (algebraMap k L a) = κ a := congrArg (fun f => f a) hj'
      have := hσL (algebraMap k L a)
      rw [show j' (algebraMap k L a) = (j' : L →+* ℂ) (algebraMap k L a) from rfl, e] at this
      exact this
    obtain ⟨s, hs⟩ := exists_artinCondC κ σC hσκ
    -- the Artin symbol of `s` is trivial on `L`
    have hart : ideleClassArtinMap k L (QuotientGroup.mk s) = 1 := by
      refine AlgEquiv.ext fun x => ?_
      apply (j' : L →+* ℂ).injective
      rw [AlgEquiv.one_apply, ← hs L (j' : L →+* ℂ) hj' x]
      exact hσL x
    have hray : ((s : IdeleGroup (𝓞 k) k) : IdeleClassGroup (𝓞 k) k) ∈
        raySubgroup (ShimuraGlue.Ray.mod3 k) := by
      have hker : (QuotientGroup.mk s : IdeleClassGroup (𝓞 k) k) ∈ (ideleClassArtinMap k L).ker := hart
      rw [ker_ideleClassArtinMap, range_ideleClassNormMap_rayClassField] at hker
      exact hker
    rw [mk_mem_raySubgroup_iff] at hray
    obtain ⟨s₀, hs₀, z, ⟨c, rfl⟩, hsz⟩ := Subgroup.mem_sup.1 hray
    -- Shimura's reciprocity law at `(τ, u)`
    have h4 := hrec k hk κ q τ (by rw [hκκ]; exact hcmτ) σC s hs u
    let c' : kˣ := c ^ (ε : ℤ)
    have hsε : s ^ (ε : ℤ) = IdeleGroup.unitEmbedding (𝓞 k) k c' * s₀ ^ (ε : ℤ) := by
      rw [← hsz, mul_zpow, map_zpow, mul_comm]
    have hX : qHatU q s ^ (ε : ℤ) * u = qHatU q (IdeleGroup.unitEmbedding (𝓞 k) k c') * u *
        (u⁻¹ * qHatU q (s₀ ^ (ε : ℤ)) * u) := by
      rw [← map_zpow, hsε, map_mul]; group
    have hk3 : u⁻¹ * qHatU q (s₀ ^ (ε : ℤ)) * u ∈ K3Q :=
      conj_mem_K3Q hu (hI q hqO _ (Subgroup.zpow_mem _ hs₀ _))
    have hdc : DCRel τ u τ (qHatU q s ^ (ε : ℤ) * u) := by
      refine dcRel_fix (nrd_pos_of_cm q κ₀ τ hcmτ c') τ (hcmτ c') u _ _ hk3 ?_
      rw [hX, Units.val_mul, Units.val_mul, qHatU_unitEmbedding]
    have hΨ : galPt σC (Ψ τ u) = Ψ τ u := by
      rw [h4]; exact ((hfib τ u τ _).2 hdc).symm
    rw [hτu, galPt_fieldMap y σ σC hσC'] at hΨ
    have h5 := congrArg CommaMorphism.left (fieldMap_ιC_inj hΨ)
    exact h5
  -- (f) `ℚ(y) ⊆ F ≅ L`
  have hle : residueImage (X := Y.left) y.left ≤ F := residueImage_le y.left F hfix
  exact ⟨((AlgEquiv.ofInjectiveField jA).symm.toAlgHom.comp
    (IntermediateField.inclusion hle)).toRingHom⟩

end RayClassCFT


/-! ===== part: scratch/rayclass-cft/RayProof4.lean ===== -/

/-! # rayclass-cft, Part P4: the three fields, the CM data at a representative, `RayClassCM` -/

set_option linter.all false

noncomputable section

namespace RayClassCFT

open CategoryTheory AlgebraicGeometry Limits
open LeafQM LeafQM.AV NumberField IsDedekindDomain
open ShimuraCFT ShimuraGlue.Ray
open TauCeti.ClassFieldTheory TauCeti.GlobalNumberFields
open ZInQ.LeafPush2 (CPts IsUniformization)

/-! ## P4a. Copy (height-glue `part_emb.lean` §Field, Mathlib only): `ℚ`-algebra maps out of a quadratic
field, `r + s y ↦ r + s b` -/

section Field

variable {k : Type} [Field k] [NumberField k]

/-- Every element of a quadratic field is `r + s y` for a non-rational `y`. -/
theorem exists_rat_repr (hk : Module.finrank ℚ k = 2) {y : k} (hy : ∀ r : ℚ, y ≠ r) (x : k) :
    ∃ r s : ℚ, x = r + s * y := by
  have hli : LinearIndependent ℚ ![(1 : k), y] := by
    rw [LinearIndependent.pair_iff]
    intro a t h
    by_cases ht : t = 0
    · subst ht
      simp only [zero_smul, add_zero, smul_eq_zero, one_ne_zero, or_false] at h
      exact ⟨h, rfl⟩
    · exfalso
      apply hy (-a / t)
      rw [Rat.smul_def, Rat.smul_def, mul_one] at h
      push_cast
      field_simp
      linear_combination h
  have hsp := hli.span_eq_top_of_card_eq_finrank' (by simp [hk])
  have hx : x ∈ Submodule.span ℚ (Set.range ![(1 : k), y]) := hsp ▸ Submodule.mem_top
  have hr : Set.range ![(1 : k), y] = {1, y} := by
    ext z; simp only [Set.mem_range, Fin.exists_fin_two, Matrix.cons_val_zero, Matrix.cons_val_one,
      Set.mem_insert_iff, Set.mem_singleton_iff]; tauto
  rw [hr] at hx
  obtain ⟨r, t, hrt⟩ := Submodule.mem_span_pair.mp hx
  exact ⟨r, t, by rw [← hrt, Rat.smul_def, Rat.smul_def, mul_one]⟩

theorem repr_unique {y : k} (hy : ∀ r : ℚ, y ≠ r) {r s r' s' : ℚ}
    (h : (r : k) + s * y = r' + s' * y) : r = r' ∧ s = s' := by
  by_cases hs : s = s'
  · subst hs
    refine ⟨?_, rfl⟩
    exact_mod_cast add_right_cancel h
  · exfalso
    apply hy ((r' - r) / (s - s'))
    have hs' : ((s : k) - s') ≠ 0 := by
      rw [sub_ne_zero]; exact_mod_cast hs
    push_cast
    field_simp
    linear_combination h

/-- The coordinates of `x` in the basis `(1, y)`. -/
noncomputable def coord0 (hk : Module.finrank ℚ k = 2) {y : k} (hy : ∀ r : ℚ, y ≠ r) (x : k) : ℚ :=
  (exists_rat_repr hk hy x).choose

noncomputable def coord1 (hk : Module.finrank ℚ k = 2) {y : k} (hy : ∀ r : ℚ, y ≠ r) (x : k) : ℚ :=
  (exists_rat_repr hk hy x).choose_spec.choose

theorem coord_spec (hk : Module.finrank ℚ k = 2) {y : k} (hy : ∀ r : ℚ, y ≠ r) (x : k) :
    x = (coord0 hk hy x : k) + (coord1 hk hy x : k) * y :=
  (exists_rat_repr hk hy x).choose_spec.choose_spec

theorem coord_eq (hk : Module.finrank ℚ k = 2) {y : k} (hy : ∀ r : ℚ, y ≠ r) (r s : ℚ) :
    coord0 hk hy ((r : k) + s * y) = r ∧ coord1 hk hy ((r : k) + s * y) = s :=
  repr_unique hy (coord_spec hk hy _).symm

variable {A : Type*} [Ring A] [Algebra ℚ A]

/-- **The `ℚ`-algebra map `k → A` sending a non-rational `y` (root of `X² + PX + Q`) to a root `b`
of the same polynomial**, `r + s y ↦ r + s b`. -/
noncomputable def liftQuad (hk : Module.finrank ℚ k = 2) {y : k} (hy : ∀ r : ℚ, y ≠ r)
    {P Q : ℚ} (hyq : y * y + P * y + Q = 0) (b : A)
    (hb : b * b + P • b + algebraMap ℚ A Q = 0) : k →ₐ[ℚ] A :=
  let F : k → A := fun x => algebraMap ℚ A (coord0 hk hy x) + coord1 hk hy x • b
  have hF : ∀ r s : ℚ, F ((r : k) + s * y) = algebraMap ℚ A r + s • b := fun r s => by
    simp only [F, (coord_eq hk hy r s).1, (coord_eq hk hy r s).2]
  have hx := coord_spec hk hy
  { toFun := F
    map_one' := by
      have : (1 : k) = ((1 : ℚ) : k) + ((0 : ℚ) : k) * y := by push_cast; ring
      rw [this, hF]; simp
    map_mul' := fun x x' => by
      rw [hx x, hx x']
      set r := coord0 hk hy x; set s := coord1 hk hy x
      set r' := coord0 hk hy x'; set s' := coord1 hk hy x'
      have e : ((r : k) + s * y) * ((r' : k) + s' * y) =
          ((r * r' - s * s' * Q : ℚ) : k) + ((r * s' + r' * s - s * s' * P : ℚ) : k) * y := by
        push_cast; linear_combination (s * s' : k) * hyq
      rw [e, hF, hF, hF]
      have hb' : b * b = -(P • b) - Q • (1 : A) := by
        rw [Algebra.algebraMap_eq_smul_one] at hb
        rw [← sub_eq_zero, ← hb]; abel
      simp only [Algebra.algebraMap_eq_smul_one, add_mul, mul_add, smul_mul_assoc, mul_smul_comm,
        one_mul, mul_one, smul_smul, hb', smul_sub, smul_neg]
      module
    map_zero' := by
      have : (0 : k) = ((0 : ℚ) : k) + ((0 : ℚ) : k) * y := by push_cast; ring
      rw [this, hF]; simp
    map_add' := fun x x' => by
      rw [hx x, hx x']
      have e : ((coord0 hk hy x : k) + coord1 hk hy x * y) +
          ((coord0 hk hy x' : k) + coord1 hk hy x' * y) =
          ((coord0 hk hy x + coord0 hk hy x' : ℚ) : k) +
            ((coord1 hk hy x + coord1 hk hy x' : ℚ) : k) * y := by push_cast; ring
      rw [e, hF, hF, hF, map_add, add_smul]; abel
    commutes' := fun r => by
      have : (algebraMap ℚ k r) = (r : k) + ((0 : ℚ) : k) * y := by simp
      rw [this, hF]; simp }

theorem liftQuad_apply (hk : Module.finrank ℚ k = 2) {y : k} (hy : ∀ r : ℚ, y ≠ r)
    {P Q : ℚ} (hyq : y * y + P * y + Q = 0) (b : A)
    (hb : b * b + P • b + algebraMap ℚ A Q = 0) (r s : ℚ) :
    liftQuad hk hy hyq b hb ((r : k) + s * y) = algebraMap ℚ A r + s • b := by
  show algebraMap ℚ A (coord0 hk hy _) + coord1 hk hy _ • b = _
  rw [(coord_eq hk hy r s).1, (coord_eq hk hy r s).2]

end Field

/-! ## P4b. `ι` over `ℂ` and eigenvalues -/

/-- `ι : B → M₂(ℂ)` as a `ℚ`-algebra map. -/
def iotaC : LeafQM.B →ₐ[ℚ] Matrix (Fin 2) (Fin 2) ℂ where
  toFun x := (BPAnalytic.QM.iota x).map (algebraMap ℝ ℂ)
  map_one' := by
    have := iota_algebraMap 1
    rw [map_one] at this
    rw [this]; simp
  map_mul' x y := by rw [iota_mul, Matrix.map_mul]
  map_zero' := by
    have := iota_smul 0 0
    rw [zero_smul] at this
    rw [this]; simp
  map_add' x y := by rw [iota_add, Matrix.map_add]; exact fun a b => map_add _ a b
  commutes' r := by
    rw [iota_algebraMap]
    ext i j
    simp [Matrix.algebraMap_matrix_apply, Matrix.one_apply]
    split_ifs <;> simp

theorem iotaC_apply (x : LeafQM.B) : iotaC x = (BPAnalytic.QM.iota x).map (algebraMap ℝ ℂ) := rfl

/-- Eigenvalues of `ι(β)` at `(τ, 1)ᵀ` satisfy the quadratic relations of `β`. -/
theorem eig_rel {β : LeafQM.B} {v : Fin 2 → ℂ} (hv : v 1 = 1) {lam : ℂ}
    (h : Matrix.mulVec (iotaC β) v = lam • v) {P Q : ℚ}
    (hb : β * β + P • β + algebraMap ℚ LeafQM.B Q = 0) : lam * lam + P • lam + algebraMap ℚ ℂ Q = 0 := by
  have h0 := congrArg (fun x => Matrix.mulVec (iotaC x) v) hb
  simp only [map_add, map_mul, map_smul, AlgHom.commutes, map_zero, Matrix.add_mulVec,
    ← Matrix.mulVec_mulVec, h, Matrix.mulVec_smul, Matrix.smul_mulVec, Matrix.zero_mulVec] at h0
  have h1 := congrFun h0 1
  simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul, hv, Pi.zero_apply] at h1
  rw [Matrix.algebraMap_eq_diagonal, Matrix.mulVec_diagonal] at h1
  simp only [Pi.algebraMap_apply, hv, mul_one] at h1
  rw [Rat.smul_def, ← h1]
  simp [Algebra.smul_def]

end RayClassCFT


/-! ===== part: scratch/rayclass-cft/RayProof5.lean ===== -/

/-! # rayclass-cft, Part P5: the CM data at a representative, the three fields, `RayClassCM` -/

set_option linter.all false

noncomputable section

namespace RayClassCFT

open CategoryTheory AlgebraicGeometry Limits
open LeafQM LeafQM.AV NumberField IsDedekindDomain
open ShimuraCFT ShimuraGlue.Ray
open TauCeti.ClassFieldTheory TauCeti.GlobalNumberFields
open ZInQ.LeafPush2 (CPts IsUniformization)

/-! ## P5a. The object at a representative `(τ, u)` of `ιC^* y` -/

/-- At a representative `(τ, u)`, `u ∈ 𝒪̂^×`, of `ιC^* y`, the object is uniformized by `Λ_τ` and
inherits the CM of the object `P` of `y` (`R1fpProps` naturality, `ModuliAtUnits`, `CMBaseChange`). -/
theorem obj_at {Y : Over (Spec (CommRingCat.of ℚ))} {Φ : PtEquiv Y}
    {Ψ : UpperHalfPlane → BAQˣ → (fieldPt ℂ ⟶ Y)} (hR1 : R1fpProps Y Φ) (hU : ModuliAtUnits Y Φ Ψ)
    (hB : CMBaseChange) (y : fieldPt Qbar ⟶ Y) (P : QML3 Qbar) (hP : Φ Qbar y = M3.mk P)
    (τ : UpperHalfPlane) (u : BAQˣ) (hu : u ∈ OhatU) (hτu : Ψ τ u = fieldMap ιC ≫ y) :
    ∃ (P' : QML3 ℂ) (Φu : (Fin 2 → ℂ) → CPts P'.A (RingHom.id ℂ)),
      IsUniformization (RingHom.id ℂ) (BPAnalytic.QM.qmLattice τ.im_pos.ne') Φu ∧
      HDec.HSyn.G0Split.FibreQM.IotaCompatible P' Φu ∧
      (HasCM4 P.q → HasCM4 P'.q) ∧ (HasCM3 P.q → HasCM3 P'.q) ∧ (HasCM24 P.q → HasCM24 P'.q) := by
  obtain ⟨-, -, -, hnat, -, -⟩ := hR1
  obtain ⟨Q, hQ, hbc⟩ := hnat Qbar ℂ ιC y P hP
  obtain ⟨P', hP', Φu, hun, hio⟩ := hU u hu τ
  rw [hτu, hQ] at hP'
  obtain ⟨f⟩ := Quotient.exact hP'
  let g : QMIso Q.q P'.q := ⟨f.φ, f.ψ, f.left, f.right, f.equivariant⟩
  obtain ⟨b4, b3, b24⟩ := hB (ιC : Qbar →+* ℂ) P Q hbc
  exact ⟨P', Φu, hun, hio, fun h => HasCM4.of_iso g (b4 h), fun h => HasCM3.of_iso g (b3 h),
    fun h => HasCM24.of_iso g (b24 h)⟩

/-! ## P5b. From an eigen-element `β ∈ 𝒪` to the CM data `(q, κ₀)` -/

/-- **`𝒪_k = ℤ[y]`** (glue; for `k = ℚ(i), ℚ(ζ₃)` Mathlib's cyclotomic rings of integers, for
`ℚ(√−6)` the elementary computation `−6 ≡ 2 mod 4`). -/
def RingOfIntegersGen (k : Type) [Field k] [NumberField k] (y : k) : Prop :=
  ∀ x : 𝓞 k, ∃ a b : ℤ, (x : k) = a + b * y

theorem inO_int_comb {β : LeafQM.B} (hβ : InO β) (a b : ℤ) : InO ((a : LeafQM.B) + (b : LeafQM.B) * β) :=
  (LeafQM.O.add_mem (intCast_mem LeafQM.O a) (LeafQM.O.mul_mem (intCast_mem LeafQM.O b) hβ) :
    ((a : LeafQM.B) + (b : LeafQM.B) * β) ∈ LeafQM.O)

/-- The CM data from an eigen-element. -/
theorem cm_data (k : Type) [Field k] [NumberField k] (hk : Module.finrank ℚ k = 2) {yk : k}
    (hy : ∀ r : ℚ, yk ≠ r) {P Q : ℚ} (hyq : yk * yk + P * yk + Q = 0) (hO : RingOfIntegersGen k yk)
    (τ : UpperHalfPlane) (β : LeafQM.B) (hβO : InO β)
    (hβ : β * β + P • β + algebraMap ℚ LeafQM.B Q = 0) (lam : ℂ)
    (heig : Matrix.mulVec ((BPAnalytic.QM.iota β).map (algebraMap ℝ ℂ)) ![(τ : ℂ), 1] =
      lam • ![(τ : ℂ), 1]) :
    ∃ (q : k →ₐ[ℚ] LeafQM.B) (κ₀ : k →+* ℂ), (∀ x : 𝓞 k, InO (q x)) ∧ IsCMPoint q κ₀ τ := by
  have heig' : Matrix.mulVec (iotaC β) ![(τ : ℂ), 1] = lam • ![(τ : ℂ), 1] := heig
  have hl := eig_rel (v := ![(τ : ℂ), 1]) (by simp) heig' hβ
  refine ⟨liftQuad hk hy hyq β hβ, (liftQuad hk hy hyq lam hl).toRingHom, fun x => ?_, fun a => ?_⟩
  · obtain ⟨a, b, hab⟩ := hO x
    have e : (x : k) = ((a : ℚ) : k) + ((b : ℚ) : k) * yk := by rw [hab]; push_cast; ring
    rw [e, liftQuad_apply]
    have e2 : algebraMap ℚ LeafQM.B (a : ℚ) + (b : ℚ) • β = (a : LeafQM.B) + (b : LeafQM.B) * β := by
      rw [Algebra.smul_def]; simp
    rw [e2]
    exact inO_int_comb hβO a b
  · obtain ⟨r, s, rfl⟩ := exists_rat_repr hk hy a
    show Matrix.mulVec (iotaC _) _ = _
    rw [AlgHom.toRingHom_eq_coe, RingHom.coe_coe, liftQuad_apply, liftQuad_apply, map_add,
      AlgHom.commutes, map_smul, Matrix.add_mulVec, Matrix.smul_mulVec, heig']
    ext i
    fin_cases i <;>
      simp [Matrix.algebraMap_eq_diagonal, Matrix.mulVec_diagonal, Algebra.smul_def] <;> ring

/-! ## P5c. The three fields -/

theorem not_rat_of_disc {k : Type} [Field k] [CharZero k] {y : k} {P Q : ℚ}
    (hyq : y * y + P * y + Q = 0) (hd : P * P < 4 * Q) : ∀ r : ℚ, y ≠ r := by
  intro r hr
  rw [hr] at hyq
  have : r * r + P * r + Q = 0 := by exact_mod_cast hyq
  nlinarith [sq_nonneg (2 * r + P)]

theorem isTotallyComplex_of_root {k : Type} [Field k] [NumberField k] {y : k} {P Q : ℚ}
    (hyq : y * y + P * y + Q = 0) (hd : P * P < 4 * Q) : IsTotallyComplex k := by
  refine ⟨fun w => ?_⟩
  rw [← InfinitePlace.not_isReal_iff_isComplex, InfinitePlace.isReal_iff]
  intro hr
  set z := w.embedding y
  have hz : z * z + P * z + Q = 0 := by
    have := congrArg w.embedding hyq
    simpa [z] using this
  have hconj : (starRingEnd ℂ) z = z :=
    congrArg (fun f => f y) (NumberField.ComplexEmbedding.isReal_iff.1 hr)
  have him : z.im = 0 := Complex.conj_eq_iff_im.1 hconj
  have hre := congrArg Complex.re hz
  simp [Complex.mul_re, him] at hre
  have hd' : (P : ℝ) * P < 4 * Q := by exact_mod_cast hd
  nlinarith [sq_nonneg (2 * z.re + P)]

/-- `i = ζ₄`. -/
def y4 : K4 := IsCyclotomicExtension.zeta 4 ℚ K4
/-- `−ζ₃` (a root of `X² − X + 1`). -/
def y3 : K3 := -IsCyclotomicExtension.zeta 3 ℚ K3
/-- `√−6` in `K24 = ℚ(s6)`. -/
def y24 : K24 := ⟨s6, IntermediateField.mem_adjoin_simple_self ℚ s6⟩

theorem y4_rel : y4 * y4 + ((0 : ℚ) : K4) * y4 + ((1 : ℚ) : K4) = 0 := by
  have hz := IsCyclotomicExtension.zeta_spec 4 ℚ K4
  have h2 : (y4 ^ 2) ^ 2 = 1 := by rw [← pow_mul]; exact hz.pow_eq_one
  have hne : y4 ^ 2 ≠ 1 := hz.pow_ne_one_of_pos_of_lt (by norm_num) (by norm_num)
  rcases sq_eq_one_iff.1 h2 with h | h
  · exact absurd h hne
  · push_cast; linear_combination h

theorem y3_rel : y3 * y3 + ((-1 : ℚ) : K3) * y3 + ((1 : ℚ) : K3) = 0 := by
  have hz := IsCyclotomicExtension.zeta_spec 3 ℚ K3
  have e3 : (IsCyclotomicExtension.zeta 3 ℚ K3) ^ 2 + IsCyclotomicExtension.zeta 3 ℚ K3 + 1 = 0 := by
    have := hz.isRoot_cyclotomic (by norm_num)
    simpa [Polynomial.cyclotomic_three, Polynomial.eval_add, Polynomial.eval_pow] using this
  simp only [y3]; push_cast; linear_combination e3

theorem y24_rel : y24 * y24 + ((0 : ℚ) : K24) * y24 + ((6 : ℚ) : K24) = 0 := by
  apply Subtype.ext
  have h6 : (((6 : ℚ) : K24) : CyclotomicField 24 ℚ) = 6 := by
    show ((6 : ℚ) : CyclotomicField 24 ℚ) = 6
    norm_num
  have h0 : (((0 : ℚ) : K24) : CyclotomicField 24 ℚ) = 0 := by
    show ((0 : ℚ) : CyclotomicField 24 ℚ) = 0
    norm_num
  simp only [y24, IntermediateField.coe_add, IntermediateField.coe_mul, h6, h0,
    IntermediateField.coe_zero]
  linear_combination s6_sq

theorem finrank_K4 : Module.finrank ℚ K4 = 2 := by
  rw [IsCyclotomicExtension.finrank K4 (n := 4) (Polynomial.cyclotomic.irreducible_rat (n := 4) (by norm_num))]
  decide

theorem finrank_K3 : Module.finrank ℚ K3 = 2 := by
  rw [IsCyclotomicExtension.finrank K3 (n := 3) (Polynomial.cyclotomic.irreducible_rat (n := 3) (by norm_num))]
  decide

theorem finrank_K24 : Module.finrank ℚ K24 = 2 := by
  have hint : IsIntegral ℚ s6 := (Algebra.IsIntegral.isIntegral (R := ℚ) s6)
  rw [IntermediateField.adjoin.finrank hint]
  have hmin : (Polynomial.X ^ 2 + Polynomial.C (6 : ℚ)) = minpoly ℚ s6 := by
    refine minpoly.eq_of_irreducible_of_monic ?_ ?_ ?_
    · refine Polynomial.irreducible_of_degree_le_three_of_not_isRoot ?_ ?_
      · rw [Polynomial.natDegree_X_pow_add_C]; norm_num
      · intro x hx
        simp [Polynomial.IsRoot] at hx
        nlinarith [sq_nonneg x]
    · simp [s6_sq]
    · exact Polynomial.monic_X_pow_add_C _ (by norm_num)
  rw [← hmin, Polynomial.natDegree_X_pow_add_C]

instance : IsTotallyComplex K4 := isTotallyComplex_of_root y4_rel (by norm_num)
instance : IsTotallyComplex K3 := isTotallyComplex_of_root y3_rel (by norm_num)
instance : IsTotallyComplex K24 := isTotallyComplex_of_root y24_rel (by norm_num)

/-! ## P5d. `RayClassCM` -/

theorem com_rel {Q : QML3 ℂ} (ρ : com Q.q →+* LeafQM.B) {φ : PkgI3.AbVar.End Q.A} (hφ : φ ∈ com Q.q)
    {P0 Q0 : ℤ} (h : φ * φ + P0 * φ + Q0 = 0) :
    ρ ⟨φ, hφ⟩ * ρ ⟨φ, hφ⟩ + ((P0 : ℚ)) • ρ ⟨φ, hφ⟩ + algebraMap ℚ LeafQM.B (Q0 : ℚ) = 0 := by
  have e : (⟨φ, hφ⟩ : com Q.q) * ⟨φ, hφ⟩ + (P0 : com Q.q) * ⟨φ, hφ⟩ + (Q0 : com Q.q) = 0 :=
    Subtype.ext (by simpa using h)
  have := congrArg ρ e
  simp only [map_add, map_mul, map_intCast, map_zero] at this
  rw [Algebra.smul_def, map_intCast, map_intCast]
  exact this

/-- **`RayClassCM` from the leaves `ShimuraMainThmIDeligneY3AbU`, `MumfordRigidityCore`,
`ClassNumberOneB` and the glue `QHatIntegral` (three fields), `CMBaseChange`, `CMAnalytic`,
`RingOfIntegersGen` (three fields).** -/
theorem rayClassCM_of (hL : ShimuraMainThmIDeligneY3AbU)
    (hMR : LeafQM.AV.R1UnivRigid.MumfordRigidityCore) (hCN : ClassNumberOneB)
    (hI4 : QHatIntegral K4) (hI3 : QHatIntegral K3) (hI24 : QHatIntegral K24)
    (hB : CMBaseChange) (hA : CMAnalytic)
    (hO4 : RingOfIntegersGen K4 y4) (hO3 : RingOfIntegersGen K3 y3)
    (hO24 : RingOfIntegersGen K24 y24) : RayClassCM := by
  obtain ⟨Y, Φ, hAb, Ψ, hb, hU⟩ := hL
  have hR1 : R1fpProps Y Φ := (LeafQM.AV.R1UnivRigid.r1fpProps_iff_ab_core hMR Y Φ).2 hAb
  refine ⟨Y, Φ, hR1, fun y P hP => ⟨fun h4 => ?_, fun h3 => ?_, fun h24 => ?_⟩⟩
  · refine embed_core hb hCN K4 finrank_K4 hI4 y (fun τ u hu hτu => ?_)
    obtain ⟨P', Φu, hun, hio, c4, -, -⟩ := obj_at hR1 hU hB y P hP τ u hu hτu
    obtain ⟨ρ, hρ⟩ := hA τ P' Φu hun hio
    obtain ⟨φ, hφ, hφ2⟩ := c4 h4
    obtain ⟨hβO, lam, heig⟩ := hρ ⟨φ, hφ⟩
    refine cm_data K4 finrank_K4 (not_rat_of_disc y4_rel (by norm_num)) y4_rel hO4 τ _ hβO ?_ lam heig
    have := com_rel ρ hφ (P0 := 0) (Q0 := 1) (by rw [hφ2]; simp)
    simpa using this
  · refine embed_core hb hCN K3 finrank_K3 hI3 y (fun τ u hu hτu => ?_)
    obtain ⟨P', Φu, hun, hio, -, c3, -⟩ := obj_at hR1 hU hB y P hP τ u hu hτu
    obtain ⟨ρ, hρ⟩ := hA τ P' Φu hun hio
    obtain ⟨φ, hφ, hφ2⟩ := c3 h3
    obtain ⟨hβO, lam, heig⟩ := hρ ⟨φ, hφ⟩
    refine cm_data K3 finrank_K3 (not_rat_of_disc y3_rel (by norm_num)) y3_rel hO3 τ _ hβO ?_ lam heig
    have := com_rel ρ hφ (P0 := -1) (Q0 := 1) (by rw [← hφ2]; simp; abel)
    simpa using this
  · refine embed_core hb hCN K24 finrank_K24 hI24 y (fun τ u hu hτu => ?_)
    obtain ⟨P', Φu, hun, hio, -, -, c24⟩ := obj_at hR1 hU hB y P hP τ u hu hτu
    obtain ⟨ρ, hρ⟩ := hA τ P' Φu hun hio
    obtain ⟨φ, hφ, hφ2⟩ := c24 h24
    obtain ⟨hβO, lam, heig⟩ := hρ ⟨φ, hφ⟩
    refine cm_data K24 finrank_K24 (not_rat_of_disc y24_rel (by norm_num)) y24_rel hO24 τ _ hβO ?_
      lam heig
    have := com_rel ρ hφ (P0 := 0) (Q0 := 6) (by rw [hφ2]; simp)
    simpa using this

end RayClassCFT

#print axioms RayClassCFT.embed_core
#print axioms RayClassCFT.rayClassCM_of


/-! ===== part: scratch/rayclass-cft/RayGlueO.lean ===== -/

/-! # rayclass-cft, Part G1: the glue `RingOfIntegersGen` for `ℚ(i)`, `ℚ(ζ₃)`, `ℚ(√−6)`, proved -/

set_option linter.all false

noncomputable section

namespace RayClassCFT

open NumberField ShimuraGlue.Ray

/-- Elements of `ℤ[ζ]` with `ζ² = pζ + q` are `a + bζ`. -/
theorem adjoin_quad {K : Type*} [CommRing K] (ζ : K) (p q : ℤ) (h : ζ * ζ = p * ζ + q) {x : K}
    (hx : x ∈ Algebra.adjoin ℤ {ζ}) : ∃ a b : ℤ, x = a + b * ζ := by
  induction hx using Algebra.adjoin_induction with
  | mem x hx =>
    rw [Set.mem_singleton_iff] at hx; subst hx
    exact ⟨0, 1, by simp⟩
  | algebraMap n => exact ⟨n, 0, by simp⟩
  | add x y _ _ hx hy =>
    obtain ⟨a, b, rfl⟩ := hx
    obtain ⟨c, d, rfl⟩ := hy
    exact ⟨a + c, b + d, by push_cast; ring⟩
  | mul x y _ _ hx hy =>
    obtain ⟨a, b, rfl⟩ := hx
    obtain ⟨c, d, rfl⟩ := hy
    exact ⟨a * c + b * d * q, a * d + b * c + b * d * p, by
      push_cast; linear_combination (b * d : K) * h⟩

/-- A rational number integral over `ℤ` (in `k`) is an integer (copy of height-glue's
`exists_int_of_isIntegral`). -/
theorem exists_int_of_isIntegral {k : Type} [Field k] [NumberField k] {r : ℚ}
    (h : IsIntegral ℤ (r : k)) : ∃ n : ℤ, r = n := by
  have h' : IsIntegral ℤ r := by
    rw [← isIntegral_algebraMap_iff (A := ℚ) (B := k)]
    simpa using h
  obtain ⟨n, hn⟩ := IsIntegrallyClosed.isIntegral_iff.mp h'
  exact ⟨n, by rw [← hn]; simp⟩

theorem ringOfIntegersGen_K4 : RingOfIntegersGen K4 y4 := by
  intro x
  have hζ := IsCyclotomicExtension.zeta_spec 4 ℚ K4
  obtain ⟨z, hz⟩ := (IsCyclotomicExtension.Rat.isIntegralClosure_adjoin_singleton hζ).isIntegral_iff.1
    (RingOfIntegers.isIntegral_coe x)
  have h2 : y4 * y4 = (0 : ℤ) * y4 + (-1 : ℤ) := by
    have := y4_rel; push_cast at this ⊢; linear_combination this
  obtain ⟨a, b, hab⟩ := adjoin_quad y4 0 (-1) h2 (z.2 : (z : K4) ∈ Algebra.adjoin ℤ {y4})
  exact ⟨a, b, by rw [← hab]; exact hz.symm⟩

theorem ringOfIntegersGen_K3 : RingOfIntegersGen K3 y3 := by
  intro x
  have hζ := IsCyclotomicExtension.zeta_spec 3 ℚ K3
  have h2 : IsCyclotomicExtension.zeta 3 ℚ K3 * IsCyclotomicExtension.zeta 3 ℚ K3 =
      (-1 : ℤ) * IsCyclotomicExtension.zeta 3 ℚ K3 + (-1 : ℤ) := by
    have := y3_rel; simp only [y3] at this; push_cast at this ⊢; linear_combination this
  obtain ⟨z, hz⟩ := (IsCyclotomicExtension.Rat.isIntegralClosure_adjoin_singleton hζ).isIntegral_iff.1
    (RingOfIntegers.isIntegral_coe x)
  obtain ⟨a, b, hab⟩ := adjoin_quad _ (-1) (-1) h2 z.2
  refine ⟨a, -b, ?_⟩
  have hz' : (x : K3) = (z : K3) := hz.symm
  rw [hz', hab]; simp [y3]

/-- Conjugation `√−6 ↦ −√−6` of `K24`. -/
def conj24 : K24 →ₐ[ℚ] K24 :=
  liftQuad finrank_K24 (not_rat_of_disc y24_rel (by norm_num)) y24_rel (-y24) (by
    have h := y24_rel
    rw [Algebra.algebraMap_eq_smul_one]
    simp only [Rat.cast_zero, zero_mul, add_zero] at h
    rw [zero_smul, add_zero, neg_mul_neg]
    have h6 : ((6 : ℚ) : K24) = (6 : ℚ) • (1 : K24) := by rw [Rat.smul_def, mul_one]
    rw [← h6]; exact h)

theorem ringOfIntegersGen_K24 : RingOfIntegersGen K24 y24 := by
  intro x
  have hy := not_rat_of_disc y24_rel (by norm_num)
  obtain ⟨r, s, hrs⟩ := exists_rat_repr finrank_K24 hy (x : K24)
  have hx : IsIntegral ℤ (x : K24) := RingOfIntegers.isIntegral_coe x
  have hcx : IsIntegral ℤ (conj24 x) := hx.map conj24.toRingHom.toIntAlgHom
  have hcv : conj24 (x : K24) = (r : K24) - s * y24 := by
    rw [hrs, conj24, liftQuad_apply]; rw [Rat.smul_def]; simp; ring
  have hyy : y24 * y24 = -6 := by
    have h := y24_rel; push_cast at h; linear_combination h
  -- trace, norm and `(x − x̄)·√−6` are rational and integral
  obtain ⟨m, hm⟩ : ∃ m : ℤ, 2 * r = m := by
    have h := hx.add hcx
    rw [hcv, hrs] at h
    have e : (r : K24) + s * y24 + ((r : K24) - s * y24) = ((2 * r : ℚ) : K24) := by push_cast; ring
    rw [e] at h
    exact exists_int_of_isIntegral h
  obtain ⟨n, hn⟩ : ∃ n : ℤ, r * r + 6 * (s * s) = n := by
    have h := hx.mul hcx
    rw [hcv, hrs] at h
    have e : ((r : K24) + s * y24) * ((r : K24) - s * y24) = ((r * r + 6 * (s * s) : ℚ) : K24) := by
      push_cast; linear_combination (-(s : K24) * s) * hyy
    rw [e] at h
    exact exists_int_of_isIntegral h
  obtain ⟨e, he⟩ : ∃ e : ℤ, -12 * s = e := by
    have hyi : IsIntegral ℤ y24 := ⟨Polynomial.X ^ 2 + Polynomial.C 6,
      Polynomial.monic_X_pow_add_C _ two_ne_zero, by
        simp only [Polynomial.eval₂_add, Polynomial.eval₂_X_pow, Polynomial.eval₂_C]
        rw [sq, hyy]; simp⟩
    have h := (hx.sub hcx).mul hyi
    rw [hcv, hrs] at h
    have e : ((r : K24) + s * y24 - ((r : K24) - s * y24)) * y24 = ((-12 * s : ℚ) : K24) := by
      push_cast; linear_combination (2 * (s : K24)) * hyy
    rw [e] at h
    exact exists_int_of_isIntegral h
  -- arithmetic: `6 ∣ e`, then parity
  have h24 : (e : ℚ) ^ 2 = 6 * (4 * n - m ^ 2) := by
    rw [← he, ← hn]; push_cast; rw [← hm]; ring
  have h24z : e ^ 2 = 6 * (4 * n - m ^ 2) := by exact_mod_cast h24
  have h2 : (2 : ℤ) ∣ e :=
    Int.prime_two.dvd_of_dvd_pow (n := 2) ⟨3 * (4 * n - m ^ 2), by rw [h24z]; ring⟩
  have h3 : (3 : ℤ) ∣ e :=
    Int.prime_three.dvd_of_dvd_pow (n := 2) ⟨2 * (4 * n - m ^ 2), by rw [h24z]; ring⟩
  obtain ⟨f, hf⟩ : (6 : ℤ) ∣ e := by omega
  have hmf : m ^ 2 + 6 * f ^ 2 = 4 * n := by
    rw [hf] at h24z; nlinarith
  rcases Int.even_or_odd m with ⟨a, ha⟩ | ⟨a, ha⟩ <;>
    rcases Int.even_or_odd f with ⟨b, hb⟩ | ⟨b, hb⟩
  · refine ⟨a, -b, ?_⟩
    rw [hrs]
    have hr : r = a := by
      have : (2 : ℚ) * r = a + a := by rw [hm, ha]; push_cast; ring
      linarith
    have hs : s = -b := by
      have : (-12 : ℚ) * s = 6 * (b + b) := by rw [he, hf, hb]; push_cast; ring
      linarith
    rw [hr, hs]; push_cast; ring
  all_goals (exfalso; subst ha hb; ring_nf at hmf; omega)

end RayClassCFT

