    ext k; exact e.commutes k
  obtain ⟨τ, hτ⟩ := exists_tau κ (e : SeparableClosure K →+* ℂ) he σ hσ
  obtain ⟨c, hc⟩ := hA τ
  obtain ⟨s, rfl⟩ := QuotientGroup.mk_surjective c
