theorem exists_artinCondC_of_abs (hA : T5Glue.AbsArtinSurjective K) (κ : K →+* ℂ) (σ : ℂ ≃+* ℂ)
    (hσ : ∀ k : K, σ (κ k) = κ k) : ∃ s : IdeleGroup (𝓞 K) K, ArtinCondC κ σ s := by
  letI : Algebra K ℂ := κ.toAlgebra
