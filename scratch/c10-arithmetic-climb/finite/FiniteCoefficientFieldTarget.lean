import Mathlib.FieldTheory.IsAlgClosed.AlgebraicClosure
import Mathlib.FieldTheory.IntermediateField.Adjoin.Basic
import Mathlib.NumberTheory.NumberField.Basic
import Mathlib.Data.Complex.Basic
import Mathlib.Data.Set.Finite.Range
import Mathlib.Basic.Finite.Sigma
import Mathlib.Basic.Finite.Prod
import Mathlib.Data.Matrix.Basic

noncomputable section

universe u v w

namespace ClimbFiniteCoefficientField

/-- Same carrier as the canonical GlueC10.Qbar, without importing C10. -/
abbrev Qbar : Type := AlgebraicClosure ℚ

/-- The specified coefficients are the generators, not replacement values. -/
abbrev fieldOf (s : Set Qbar) : IntermediateField ℚ Qbar :=
  IntermediateField.adjoin ℚ s

/-- Inclusion is the existing intermediate-field inclusion. -/
def inclusion (s : Set Qbar) : fieldOf s →ₐ[ℚ] Qbar :=
  (fieldOf s).val

/-- A deterministic subtype lift, using existing membership in the adjoin. -/
def coefficientLift (s : Set Qbar) (a : s) : fieldOf s :=
  ⟨a.1, IntermediateField.subset_adjoin ℚ s a.2⟩

/-- Restrict the very AlgHom supplied by the caller. -/
def restrictedPlace (s : Set Qbar) (ρ : Qbar →ₐ[ℚ] ℂ) :
    fieldOf s →ₐ[ℚ] ℂ :=
  ρ.comp (fieldOf s).val

/-- A bare RingHom caller can be restricted without repackaging its map. -/
def restrictedRingPlace (s : Set Qbar) (ρ : Qbar →+* ℂ) :
    fieldOf s →+* ℂ :=
  ρ.comp (fieldOf s).val.toRingHom

/-- Range forgets repetitions, but the separately indexed lifts retain them. -/
abbrev familyField {ι : Sort u} (c : ι → Qbar) :
    IntermediateField ℚ Qbar :=
  fieldOf (Set.range c)

def familyLift {ι : Sort u} (c : ι → Qbar) (i : ι) : familyField c :=
  coefficientLift (Set.range c) ⟨c i, ⟨i, rfl⟩⟩

def familyPlace {ι : Sort u} (c : ι → Qbar) (ρ : Qbar →ₐ[ℚ] ℂ) :
    familyField c →ₐ[ℚ] ℂ :=
  restrictedPlace (Set.range c) ρ

/-- All coordinates of the GIVEN finite ragged family of ordinary matrices. -/
abbrev MatrixCoordinate {κ : Type u} (Row : κ → Type v) (Col : κ → Type w) :
    Type (max u v w) :=
  Σ k : κ, Row k × Col k

def matrixCoefficient {κ : Type u} {Row : κ → Type v} {Col : κ → Type w}
    (M : (k : κ) → Matrix (Row k) (Col k) Qbar) :
    MatrixCoordinate Row Col → Qbar :=
  fun t => M t.1 t.2.1 t.2.2

abbrev matrixSet {κ : Type u} {Row : κ → Type v} {Col : κ → Type w}
    (M : (k : κ) → Matrix (Row k) (Col k) Qbar) : Set Qbar :=
  Set.range (matrixCoefficient M)

/-- ONE generating set covers both given scalars and all given coordinates. -/
abbrev jointSet {κ : Type u} {Row : κ → Type v} {Col : κ → Type w}
    (s : Set Qbar) (M : (k : κ) → Matrix (Row k) (Col k) Qbar) : Set Qbar :=
  s ∪ matrixSet M

abbrev jointField {κ : Type u} {Row : κ → Type v} {Col : κ → Type w}
    (s : Set Qbar) (M : (k : κ) → Matrix (Row k) (Col k) Qbar) :
    IntermediateField ℚ Qbar :=
  fieldOf (jointSet s M)

def jointScalarLift {κ : Type u} {Row : κ → Type v} {Col : κ → Type w}
    (s : Set Qbar) (M : (k : κ) → Matrix (Row k) (Col k) Qbar) (a : s) :
    jointField s M :=
  coefficientLift (jointSet s M) ⟨a.1, Or.inl a.2⟩

def jointMatrixLift {κ : Type u} {Row : κ → Type v} {Col : κ → Type w}
    (s : Set Qbar) (M : (k : κ) → Matrix (Row k) (Col k) Qbar) :
    (k : κ) → Matrix (Row k) (Col k) (jointField s M) :=
  fun k => Matrix.of fun i j =>
    coefficientLift (jointSet s M)
      ⟨M k i j, Or.inr ⟨⟨k, ⟨i, j⟩⟩, rfl⟩⟩

def jointPlace {κ : Type u} {Row : κ → Type v} {Col : κ → Type w}
    (s : Set Qbar) (M : (k : κ) → Matrix (Row k) (Col k) Qbar)
    (ρ : Qbar →ₐ[ℚ] ℂ) : jointField s M →ₐ[ℚ] ℂ :=
  restrictedPlace (jointSet s M) ρ

/- F1 target name: finiteDimensional_fieldOf.
   Reuse IntermediateField.finiteDimensional_adjoin, not a new finiteness proof.
-/
#check (∀ (s : Set Qbar) (_hs : s.Finite), FiniteDimensional ℚ (fieldOf s))

/- F2 target name: numberField_fieldOf.
   Derive NumberField from F1 and NumberField.of_module_finite ℚ (fieldOf s).
-/
#check (∀ (s : Set Qbar) (_hs : s.Finite), NumberField (fieldOf s))

/- F3 target name: finiteSet_numberField_fixedPlace.
   No field, finite-degree certificate, lifts, or restricted place are inputs.
   E and ρE are FIXED by the construction terms above.
-/
#check
  (∀ (s : Set Qbar) (_hs : s.Finite) (ρ : Qbar →ₐ[ℚ] ℂ),
    let E : IntermediateField ℚ Qbar := fieldOf s
    let ρE : E →ₐ[ℚ] ℂ := restrictedPlace s ρ
    FiniteDimensional ℚ E ∧
    NumberField E ∧
    (s ⊆ (E : Set Qbar)) ∧
    (∀ F : IntermediateField ℚ Qbar, s ⊆ (F : Set Qbar) → E ≤ F) ∧
    (∀ a : s,
      E.val (coefficientLift s a) = a.1 ∧
      ρE (coefficientLift s a) = ρ a.1) ∧
    ρE.fieldRange = E.map ρ)

/- F4 target name: finiteFamily_numberField_fixedPlace.
   ι may be in an independent Sort universe. Finite is sufficient; neither
   Fintype nor decidable equality nor Nonempty is part of this target.
-/
#check
  (∀ {ι : Sort u} [Finite ι] (c : ι → Qbar) (ρ : Qbar →ₐ[ℚ] ℂ),
    FiniteDimensional ℚ (familyField c) ∧
    NumberField (familyField c) ∧
    (∀ i : ι,
      (familyField c).val (familyLift c i) = c i ∧
      familyPlace c ρ (familyLift c i) = ρ (c i)) ∧
    Set.range (fun i : ι => familyPlace c ρ (familyLift c i)) =
      Set.range (fun i : ι => ρ (c i)))

/- F5 target name: finiteScalars_and_matrixFamily_oneField.
   κ, Row k and Col k are independently finite. Every coordinate of every
   supplied M k and every scalar in s is covered by ONE E. No identification
   with an actual C10 matrix, representation, basis, T or coefficient field
   is inferred from this generic coordinate statement.
-/
#check
  (∀ {κ : Type u} (Row : κ → Type v) (Col : κ → Type w)
    [Finite κ] [∀ k : κ, Finite (Row k)] [∀ k : κ, Finite (Col k)]
    (s : Set Qbar) (_hs : s.Finite)
    (M : (k : κ) → Matrix (Row k) (Col k) Qbar) (ρ : Qbar →ₐ[ℚ] ℂ),
    let t : Set Qbar := jointSet s M
    let E : IntermediateField ℚ Qbar := jointField s M
    let ρE : E →ₐ[ℚ] ℂ := jointPlace s M ρ
    t.Finite ∧
    FiniteDimensional ℚ E ∧
    NumberField E ∧
    (∀ F : IntermediateField ℚ Qbar, t ⊆ (F : Set Qbar) → E ≤ F) ∧
    (∀ a : s,
      E.val (jointScalarLift s M a) = a.1 ∧
      ρE (jointScalarLift s M a) = ρ a.1) ∧
    (∀ (k : κ) (i : Row k) (j : Col k),
      E.val (jointMatrixLift s M k i j) = M k i j ∧
      ρE (jointMatrixLift s M k i j) = ρ (M k i j)))

/- F6 target name: restrictedRingPlace_compatible.
   The RingHom variant keeps the same caller map and has the full generated-
   field image, NOT just the finite coefficient image.
-/
#check
  (∀ (s : Set Qbar) (ρ : Qbar →+* ℂ),
    (∀ x : fieldOf s, restrictedRingPlace s ρ x = ρ ((fieldOf s).val x)) ∧
    (∀ a : s,
      restrictedRingPlace s ρ (coefficientLift s a) = ρ a.1) ∧
    Set.range (restrictedRingPlace s ρ) = ρ '' (fieldOf s : Set Qbar))

end ClimbFiniteCoefficientField
