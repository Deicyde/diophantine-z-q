/-! # infra-stalks: `KerUnitOpenOfCotangentSurj` from the stalk of a fibre product -/

namespace MulRigidity

open CategoryTheory AlgebraicGeometry Limits MonoidalCategory CartesianMonoidalCategory MonObj

variable {K : Type} [Field K]

theorem eta_left_comp_hom (A : PkgI3.AbVar K) : η[A.X].left ≫ A.X.hom = 𝟙 _ := by
  simpa using Over.w η[A.X]

/-- **Nakayama.** If the cotangent map of `f` at the origin is surjective, the maximal ideal of
`𝒪_{A,0}` is generated by `f^♯(𝔪₀)`. -/
theorem maximalIdeal_eq_map_stalkEndo (A : PkgI3.AbVar K) (f : A.X ⟶ A.X) [IsMonHom f]
    (hs : Function.Surjective (cotangentMap A f)) :
    IsLocalRing.maximalIdeal (O0 A) =
      Ideal.map (stalkEndo A f).hom (IsLocalRing.maximalIdeal (O0 A)) := by
  haveI : IsLocallyNoetherian A.X.left := LocallyOfFiniteType.isLocallyNoetherian A.X.hom
  refine le_antisymm ?_
    (Ideal.map_le_iff_le_comap.mpr fun a ha => map_nonunit (stalkEndo A f).hom a ha)
  refine Submodule.le_of_le_smul_of_le_jacobson_bot (IsNoetherian.noetherian _)
    (I := IsLocalRing.maximalIdeal (O0 A)) ?_ ?_
  · rw [IsLocalRing.jacobson_eq_maximalIdeal ⊥ bot_ne_top]
  · intro x hx
    obtain ⟨v, hv⟩ := hs ((IsLocalRing.maximalIdeal (O0 A)).toCotangent ⟨x, hx⟩)
    obtain ⟨z, rfl⟩ := (IsLocalRing.maximalIdeal (O0 A)).toCotangent_surjective v
    unfold cotangentMap at hv
    rw [Ideal.mapCotangent_toCotangent, Ideal.toCotangent_eq] at hv
    have hv' : (stalkEndo A f).hom z - x ∈ IsLocalRing.maximalIdeal (O0 A) ^ 2 := hv
    have e : x = (stalkEndo A f).hom z - ((stalkEndo A f).hom z - x) := by ring
    rw [e]
    refine Submodule.sub_mem _ (Submodule.mem_sup_left (Ideal.mem_map_of_mem _ z.2))
      (Submodule.mem_sup_right ?_)
    rw [Ideal.smul_eq_mul, ← pow_two]
    exact hv'

/-- **`KerUnitOpenOfCotangentSurj` holds** (glue of mul-rigidity, statement verbatim). -/
theorem kerUnitOpenOfCotangentSurj : KerUnitOpenOfCotangentSurj := by
  intro k _ A f _ hs
  let E := PreservesPullback.iso (Over.forget (Spec (.of k))) f η[A.X]
  let u : Spec (.of k) ⟶ pullback f.left η[A.X].left := (kerUnit A f).left ≫ E.hom
  have hu1 : u ≫ pullback.fst f.left η[A.X].left = η[A.X].left := by
    simp only [u, Category.assoc]
    erw [PreservesPullback.iso_hom_fst]
    show ((kerUnit A f) ≫ pullback.fst f η[A.X]).left = _
    simp [kerUnit]
  have hu2 : u ≫ pullback.snd f.left η[A.X].left = 𝟙 _ := by
    simp only [u, Category.assoc]
    erw [PreservesPullback.iso_hom_snd]
    show ((kerUnit A f) ≫ pullback.snd f η[A.X]).left = _
    simp [kerUnit]
  haveI : LocallyOfFiniteType f.left := by
    have : LocallyOfFiniteType (f.left ≫ A.X.hom) := by rw [Over.w f]; infer_instance
    exact locallyOfFiniteType_of_comp f.left A.X.hom
  let pt : Spec (.of k) := IsLocalRing.closedPoint k
  have hfx : pullback.fst f.left η[A.X].left (u pt) = origin A := by
    rw [← Scheme.Hom.comp_apply, hu1]
    rfl
  have Hn := maximalIdeal_eq_map_stalkEndo A f hs
  have hm : IsLocalRing.maximalIdeal ((pullback f.left η[A.X].left).presheaf.stalk (u pt)) = ⊥ := by
    have hgen := (pullback_stalkGen f.left η[A.X].left (u pt)).symm
    have hrat := rationalOver_of_retraction η[A.X].left A.X.hom (eta_left_comp_hom A)
      (pullback.snd f.left η[A.X].left (u pt))
    have hw : pullback.snd f.left η[A.X].left ≫ η[A.X].left =
        pullback.fst f.left η[A.X].left ≫ f.left := pullback.condition.symm
    rw [maximalIdeal_eq_of_stalkGen hw hgen hrat]
    dsimp only [stalkIdeal]
    have h0 : IsLocalRing.maximalIdeal ((𝟙_ (Over (Spec (.of k)))).left.presheaf.stalk
        (pullback.snd f.left η[A.X].left (u pt))) = ⊥ := maximalIdeal_stalk_spec_field k _
    rw [h0, Ideal.map_bot, bot_sup_eq, Ideal.map_eq_bot_iff_le_ker]
    intro a ha
    rw [RingHom.mem_ker]
    let c := A.X.left.presheaf.stalkCongr (Inseparable.of_eq hfx.symm)
    have hkey : ∀ b ∈ Ideal.map (stalkEndo A f).hom (IsLocalRing.maximalIdeal (O0 A)),
        (pullback.fst f.left η[A.X].left).stalkMap (u pt) (c.hom b) = 0 := by
      intro b hb
      induction hb using Submodule.span_induction with
      | mem z hz =>
        obtain ⟨a', ha', rfl⟩ := hz
        have e1 : c.hom ((stalkEndo A f).hom a') = f.left.stalkMap _
            ((A.X.left.presheaf.stalkCongr (.of_eq (congrArg f.left hfx.symm))).hom
              ((A.X.left.presheaf.stalkCongr (Inseparable.of_eq (map_origin A f).symm)).hom a')) :=
          stalkMap_congr_point_apply f.left hfx.symm _
        rw [e1]
        apply stalkMap_comp_eq_zero_of_maximalIdeal_eq_bot _ _ _ _ pullback.condition _
          (maximalIdeal_stalk_spec_field k _)
        exact mem_maximalIdeal_of_iso _ (mem_maximalIdeal_of_iso _ ha')
      | zero => rw [map_zero, map_zero]
      | add x y _ _ hx hy => rw [map_add, map_add, hx, hy, add_zero]
      | smul r x _ hx => rw [smul_eq_mul, map_mul, map_mul, hx, mul_zero]
    have hca : c.inv a ∈ Ideal.map (stalkEndo A f).hom (IsLocalRing.maximalIdeal (O0 A)) := by
      rw [← Hn]
      exact mem_maximalIdeal_of_iso c.symm ha
    have := hkey (c.inv a) hca
    rwa [Iso.inv_hom_id_apply] at this
  have hopen := isOpenImmersion_of_section_of_maximalIdeal_eq_bot
    (pullback.snd f.left η[A.X].left) u hu2 pt hm
  have he : (kerUnit A f).left = u ≫ E.inv := by simp [u]
  rw [he]
  infer_instance

/-- **`KerUnitOpen` (a leaf candidate) from `CotangentMulN` alone.** -/
theorem kerUnitOpen_of_cotangentMulN (h : CotangentMulN) : KerUnitOpen :=
  kerUnitOpen_of_cotangent kerUnitOpenOfCotangentSurj h

/-- **`MulIsogeny` from `CotangentMulN` alone.** -/
theorem mulIsogeny_of_cotangentMulN (h : CotangentMulN) : G0FibreSimple.MulIsogeny :=
  mulIsogeny_of_cotangent kerUnitOpenOfCotangentSurj h

end MulRigidity

#print axioms MulRigidity.kerUnitOpenOfCotangentSurj
#print axioms MulRigidity.mulIsogeny_of_cotangentMulN



/-! # infra-stalks: `CotangentMulN` from the cotangent space of `A × A` at the origin -/

namespace MulRigidity

open CategoryTheory AlgebraicGeometry Limits MonoidalCategory CartesianMonoidalCategory MonObj

section CotMul

variable {K : Type} [Field K]

theorem left_apply_of_comp_eq {Y Z : Over (Spec (CommRingCat.of K))} (h : 𝟙_ _ ⟶ Y)
    (h' : 𝟙_ _ ⟶ Z) (φ : Y ⟶ Z) (e : h ≫ φ = h') (p : (𝟙_ (Over (Spec (CommRingCat.of K)))).left) :
    φ.left (h.left p) = h'.left p := by
  rw [← Scheme.Hom.comp_apply, ← Over.comp_left, e]

theorem stalkMapAt_comp_apply {X Y Z : Scheme} (f : X ⟶ Y) (g : Y ⟶ Z) {x : X} {y : Y} {z : Z}
    (hf : f x = y) (hg : g y = z) (hfg : (f ≫ g) x = z) (c : Z.presheaf.stalk z) :
    f.stalkMapAt hf (g.stalkMapAt hg c) = (f ≫ g).stalkMapAt hfg c := by
  rw [Scheme.Hom.stalkMapAt_comp f g hf hg hfg]
  rfl

theorem one_eq_eta (A : PkgI3.AbVar K) : (1 : 𝟙_ (Over (Spec (CommRingCat.of K))) ⟶ A.X) = η[A.X] := by
  rw [Hom.one_def, toUnit_unique (toUnit _) (𝟙 _), Category.id_comp]

/-- `lift η η : pt → A × A`, the origin of `A × A`. -/
noncomputable abbrev eps2 (A : PkgI3.AbVar K) : 𝟙_ (Over (Spec (CommRingCat.of K))) ⟶ A.X ⊗ A.X :=
  lift η[A.X] η[A.X]

/-- The origin of `A × A`. -/
noncomputable abbrev origin2 (A : PkgI3.AbVar K) : (A.X ⊗ A.X).left :=
  (eps2 A).left (IsLocalRing.closedPoint K)

theorem fst_origin2 (A : PkgI3.AbVar K) : (fst A.X A.X).left (origin2 A) = origin A :=
  left_apply_of_comp_eq _ _ _ (lift_fst _ _) _

theorem snd_origin2 (A : PkgI3.AbVar K) : (snd A.X A.X).left (origin2 A) = origin A :=
  left_apply_of_comp_eq _ _ _ (lift_snd _ _) _

theorem mu_origin2 (A : PkgI3.AbVar K) : μ[A.X].left (origin2 A) = origin A := by
  refine left_apply_of_comp_eq _ _ _ ?_ _
  change η[A.X] * η[A.X] = η[A.X]
  rw [← one_eq_eta, _root_.one_mul]

theorem eta_comp_one (A : PkgI3.AbVar K) : η[A.X] ≫ (1 : A.X ⟶ A.X) = η[A.X] := by
  rw [Hom.one_def, ← Category.assoc, toUnit_unique (η[A.X] ≫ toUnit A.X) (𝟙 _), Category.id_comp]

theorem i1_origin (A : PkgI3.AbVar K) :
    (lift (𝟙 A.X) (1 : A.X ⟶ A.X)).left (origin A) = origin2 A := by
  refine left_apply_of_comp_eq _ _ _ ?_ _
  rw [comp_lift, Category.comp_id, eta_comp_one]

theorem i2_origin (A : PkgI3.AbVar K) :
    (lift (1 : A.X ⟶ A.X) (𝟙 A.X)).left (origin A) = origin2 A := by
  refine left_apply_of_comp_eq _ _ _ ?_ _
  rw [comp_lift, Category.comp_id, eta_comp_one]

theorem lift_origin (A : PkgI3.AbVar K) (f g : A.X ⟶ A.X) [IsMonHom f] [IsMonHom g] :
    (lift f g).left (origin A) = origin2 A := by
  refine left_apply_of_comp_eq _ _ _ ?_ _
  rw [comp_lift, IsMonHom.one_hom, IsMonHom.one_hom]

theorem hom_origin (A : PkgI3.AbVar K) : A.X.hom (origin A) = IsLocalRing.closedPoint K := by
  refine (Scheme.Hom.comp_apply η[A.X].left A.X.hom (IsLocalRing.closedPoint K)).symm.trans ?_
  rw [eta_left_comp_hom]
  rfl

/-- The constant map `A → 0 → A` kills `𝔪₀` on stalks. -/
theorem stalkMapAt_one_eq_zero (A : PkgI3.AbVar K)
    (h : (A.X.hom ≫ η[A.X].left) (origin A) = origin A) (c : O0 A)
    (hc : c ∈ IsLocalRing.maximalIdeal (O0 A)) :
    Scheme.Hom.stalkMapAt (A.X.hom ≫ η[A.X].left) h c = 0 := by
  have hg : η[A.X].left (A.X.hom (origin A)) = origin A := by rw [hom_origin]; rfl
  refine (stalkMapAt_comp_apply A.X.hom η[A.X].left rfl hg h c).symm.trans ?_
  have hb := maximalIdeal_stalk_spec_field K (A.X.hom (origin A))
  have h0 : η[A.X].left.stalkMapAt hg c ∈
      IsLocalRing.maximalIdeal ((Spec (CommRingCat.of K)).presheaf.stalk (A.X.hom (origin A))) :=
    map_nonunit _ _ hc
  rw [hb, Ideal.mem_bot] at h0
  rw [h0, map_zero]

/-- The four maps between `𝒪_{A,0}` and `𝒪_{A×A,(0,0)}`. -/
noncomputable abbrev phi1 (A : PkgI3.AbVar K) :=
  ((fst A.X A.X).left.stalkMapAt (fst_origin2 A)).hom
noncomputable abbrev phi2 (A : PkgI3.AbVar K) :=
  ((snd A.X A.X).left.stalkMapAt (snd_origin2 A)).hom
noncomputable abbrev psi1 (A : PkgI3.AbVar K) :=
  ((lift (𝟙 A.X) (1 : A.X ⟶ A.X)).left.stalkMapAt (i1_origin A)).hom
noncomputable abbrev psi2 (A : PkgI3.AbVar K) :=
  ((lift (1 : A.X ⟶ A.X) (𝟙 A.X)).left.stalkMapAt (i2_origin A)).hom

theorem rationalOver_hom_origin (A : PkgI3.AbVar K) : RationalOver A.X.hom (origin A) :=
  rationalOver_of_section A.X.hom η[A.X].left (eta_left_comp_hom A) _

/-- **`𝔪/𝔪²` of `A × A` at the origin is `T*₀ ⊕ T*₀`**, in the form needed below: for
`a ∈ 𝔪₀`, `μ^♯ a ≡ p₁^♯ a + p₂^♯ a` modulo `𝔪_{(0,0)}²`. -/
theorem mu_sub_mem_sq (A : PkgI3.AbVar K) (a : O0 A) (ha : a ∈ IsLocalRing.maximalIdeal (O0 A)) :
    (μ[A.X].left.stalkMapAt (mu_origin2 A)).hom a - phi1 A a - phi2 A a ∈
      IsLocalRing.maximalIdeal ((A.X ⊗ A.X).left.presheaf.stalk (origin2 A)) ^ 2 := by
  have hgen : StalkGen (pullback.fst A.X.hom A.X.hom) (pullback.snd A.X.hom A.X.hom)
      (origin2 A) := pullback_stalkGen A.X.hom A.X.hom (origin2 A)
  have hrat1 : RationalOver A.X.hom (pullback.fst A.X.hom A.X.hom (origin2 A)) := by
    have := rationalOver_hom_origin A
    rwa [← fst_origin2 A] at this
  have hrat2 : RationalOver A.X.hom (pullback.snd A.X.hom A.X.hom (origin2 A)) := by
    have := rationalOver_hom_origin A
    rwa [← snd_origin2 A] at this
  have hw : pullback.fst A.X.hom A.X.hom ≫ A.X.hom = pullback.snd A.X.hom A.X.hom ≫ A.X.hom :=
    pullback.condition
  -- the generic fibre-product facts
  have hm : IsLocalRing.maximalIdeal ((A.X ⊗ A.X).left.presheaf.stalk (origin2 A)) =
      (IsLocalRing.maximalIdeal (O0 A)).map (phi1 A) ⊔
        (IsLocalRing.maximalIdeal (O0 A)).map (phi2 A) := by
    refine (maximalIdeal_eq_of_stalkGen hw hgen hrat1).trans ?_
    dsimp only [stalkIdeal]
    rw [Scheme.Hom.map_stalkMapAt_maximalIdeal, Scheme.Hom.map_stalkMapAt_maximalIdeal]
    rfl
  have hr₂ : ∀ r, ∃ c, r - phi2 A c ∈
      IsLocalRing.maximalIdeal ((A.X ⊗ A.X).left.presheaf.stalk (origin2 A)) := by
    intro r
    obtain ⟨b, hb⟩ := exists_sub_mem_maximalIdeal_of_stalkGen hw hgen hrat1 r
    obtain ⟨c, hc⟩ := Scheme.Hom.exists_stalkMapAt_eq (snd A.X A.X).left (snd_origin2 A) b
    exact ⟨c, by rw [phi2, hc]; exact hb⟩
  have hr₁ : ∀ r, ∃ c, r - phi1 A c ∈
      IsLocalRing.maximalIdeal ((A.X ⊗ A.X).left.presheaf.stalk (origin2 A)) := by
    intro r
    obtain ⟨b, hb⟩ := exists_sub_mem_maximalIdeal_of_stalkGen hw.symm hgen.symm hrat2 r
    obtain ⟨c, hc⟩ := Scheme.Hom.exists_stalkMapAt_eq (fst A.X A.X).left (fst_origin2 A) b
    exact ⟨c, by rw [phi1, hc]; exact hb⟩
  -- the retractions
  have e11 : (lift (𝟙 A.X) (1 : A.X ⟶ A.X)).left ≫ (fst A.X A.X).left = 𝟙 _ := by
    rw [← Over.comp_left, lift_fst]; rfl
  have e22 : (lift (1 : A.X ⟶ A.X) (𝟙 A.X)).left ≫ (snd A.X A.X).left = 𝟙 _ := by
    rw [← Over.comp_left, lift_snd]; rfl
  have e12 : (lift (𝟙 A.X) (1 : A.X ⟶ A.X)).left ≫ (snd A.X A.X).left =
      A.X.hom ≫ η[A.X].left := by
    rw [← Over.comp_left, lift_snd, Hom.one_def]; rfl
  have e21 : (lift (1 : A.X ⟶ A.X) (𝟙 A.X)).left ≫ (fst A.X A.X).left =
      A.X.hom ≫ η[A.X].left := by
    rw [← Over.comp_left, lift_fst, Hom.one_def]; rfl
  have e1μ : (lift (𝟙 A.X) (1 : A.X ⟶ A.X)).left ≫ μ[A.X].left = 𝟙 _ := by
    rw [← Over.comp_left]
    change (𝟙 A.X * 1 : A.X ⟶ A.X).left = _
    rw [_root_.mul_one]; rfl
  have e2μ : (lift (1 : A.X ⟶ A.X) (𝟙 A.X)).left ≫ μ[A.X].left = 𝟙 _ := by
    rw [← Over.comp_left]
    change (1 * 𝟙 A.X : A.X ⟶ A.X).left = _
    rw [_root_.one_mul]; rfl
  have hoo : ∀ (φ : A.X.left ⟶ A.X.left) (e : φ = 𝟙 _), φ (origin A) = origin A := by
    rintro φ rfl; rfl
  have hoo' : ∀ (φ : A.X.left ⟶ A.X.left) (e : φ = A.X.hom ≫ η[A.X].left),
      φ (origin A) = origin A := by
    rintro φ rfl
    rw [Scheme.Hom.comp_apply, hom_origin]
    rfl
  have h₁ : ∀ c, psi1 A (phi1 A c) = c := by
    intro c
    change (lift (𝟙 A.X) (1 : A.X ⟶ A.X)).left.stalkMapAt _ ((fst A.X A.X).left.stalkMapAt _ c) = c
    rw [stalkMapAt_comp_apply _ _ _ _ (hoo _ e11),
      Scheme.Hom.stalkMapAt_congr e11 _ (hoo _ rfl), Scheme.Hom.stalkMapAt_id]
    rfl
  have h₂ : ∀ c, psi2 A (phi2 A c) = c := by
    intro c
    change (lift (1 : A.X ⟶ A.X) (𝟙 A.X)).left.stalkMapAt _ ((snd A.X A.X).left.stalkMapAt _ c) = c
    rw [stalkMapAt_comp_apply _ _ _ _ (hoo _ e22),
      Scheme.Hom.stalkMapAt_congr e22 _ (hoo _ rfl), Scheme.Hom.stalkMapAt_id]
    rfl
  have h₁₂ : ∀ c ∈ IsLocalRing.maximalIdeal (O0 A),
      psi1 A (phi2 A c) ∈ IsLocalRing.maximalIdeal (O0 A) ^ 2 := by
    intro c hc
    change (lift (𝟙 A.X) (1 : A.X ⟶ A.X)).left.stalkMapAt _ ((snd A.X A.X).left.stalkMapAt _ c) ∈ _
    rw [stalkMapAt_comp_apply _ _ _ _ (hoo' _ e12),
      Scheme.Hom.stalkMapAt_congr e12 _ (hoo' _ rfl), stalkMapAt_one_eq_zero A _ c hc]
    exact Ideal.zero_mem _
  have h₂₁ : ∀ c ∈ IsLocalRing.maximalIdeal (O0 A),
      psi2 A (phi1 A c) ∈ IsLocalRing.maximalIdeal (O0 A) ^ 2 := by
    intro c hc
    change (lift (1 : A.X ⟶ A.X) (𝟙 A.X)).left.stalkMapAt _ ((fst A.X A.X).left.stalkMapAt _ c) ∈ _
    rw [stalkMapAt_comp_apply _ _ _ _ (hoo' _ e21),
      Scheme.Hom.stalkMapAt_congr e21 _ (hoo' _ rfl), stalkMapAt_one_eq_zero A _ c hc]
    exact Ideal.zero_mem _
  have hx : (μ[A.X].left.stalkMapAt (mu_origin2 A)).hom a ∈
      IsLocalRing.maximalIdeal ((A.X ⊗ A.X).left.presheaf.stalk (origin2 A)) :=
    map_nonunit _ _ ha
  have key := IsLocalRing.sub_mem_maximalIdeal_sq_of_product (phi1 A) (phi2 A) (psi1 A) (psi2 A)
    h₁ h₂ h₁₂ h₂₁ hm hr₁ hr₂ hx
  have hψ1 : psi1 A ((μ[A.X].left.stalkMapAt (mu_origin2 A)).hom a) = a := by
    change (lift (𝟙 A.X) (1 : A.X ⟶ A.X)).left.stalkMapAt _ (μ[A.X].left.stalkMapAt _ a) = a
    rw [stalkMapAt_comp_apply _ _ _ _ (hoo _ e1μ),
      Scheme.Hom.stalkMapAt_congr e1μ _ (hoo _ rfl), Scheme.Hom.stalkMapAt_id]
    rfl
  have hψ2 : psi2 A ((μ[A.X].left.stalkMapAt (mu_origin2 A)).hom a) = a := by
    change (lift (1 : A.X ⟶ A.X) (𝟙 A.X)).left.stalkMapAt _ (μ[A.X].left.stalkMapAt _ a) = a
    rw [stalkMapAt_comp_apply _ _ _ _ (hoo _ e2μ),
      Scheme.Hom.stalkMapAt_congr e2μ _ (hoo _ rfl), Scheme.Hom.stalkMapAt_id]
    rfl
  rwa [hψ1, hψ2] at key

/-- The cotangent map is additive on `End A`. -/
theorem cotangentMap_add (A : PkgI3.AbVar K) (f g : PkgI3.AbVar.End A) :
    cotangentMap A (f + g).hom = cotangentMap A f.hom + cotangentMap A g.hom := by
  apply LinearMap.ext
  intro v
  obtain ⟨a, rfl⟩ := (IsLocalRing.maximalIdeal (O0 A)).toCotangent_surjective v
  simp only [cotangentMap, LinearMap.add_apply, Ideal.mapCotangent_toCotangent]
  rw [← map_add, Ideal.toCotangent_eq]
  let L := (lift f.hom g.hom).left.stalkMapAt (lift_origin A f.hom g.hom)
  have eμ : (f + g).hom.left = (lift f.hom g.hom).left ≫ μ[A.X].left := by
    rw [← Over.comp_left]; rfl
  have ef : (lift f.hom g.hom).left ≫ (fst A.X A.X).left = f.hom.left := by
    rw [← Over.comp_left, lift_fst]
  have eg : (lift f.hom g.hom).left ≫ (snd A.X A.X).left = g.hom.left := by
    rw [← Over.comp_left, lift_snd]
  have h1 : (stalkEndo A (f + g).hom).hom a.1 =
      L.hom ((μ[A.X].left.stalkMapAt (mu_origin2 A)).hom a.1) := by
    change Scheme.Hom.stalkMapAt (f + g).hom.left (map_origin A _) a.1 = _
    rw [Scheme.Hom.stalkMapAt_congr eμ _ (by rw [← eμ]; exact map_origin A _),
      ← stalkMapAt_comp_apply _ _ (lift_origin A f.hom g.hom) (mu_origin2 A)]
  have h2 : (stalkEndo A f.hom).hom a.1 = L.hom (phi1 A a.1) := by
    change Scheme.Hom.stalkMapAt f.hom.left (map_origin A _) a.1 = _
    rw [Scheme.Hom.stalkMapAt_congr ef.symm _ (by rw [ef]; exact map_origin A _),
      ← stalkMapAt_comp_apply _ _ (lift_origin A f.hom g.hom) (fst_origin2 A)]
  have h3 : (stalkEndo A g.hom).hom a.1 = L.hom (phi2 A a.1) := by
    change Scheme.Hom.stalkMapAt g.hom.left (map_origin A _) a.1 = _
    rw [Scheme.Hom.stalkMapAt_congr eg.symm _ (by rw [eg]; exact map_origin A _),
      ← stalkMapAt_comp_apply _ _ (lift_origin A f.hom g.hom) (snd_origin2 A)]
  have hsq := IsLocalRing.map_mem_sq_of_le L.hom (IsLocalRing.map_maximalIdeal_le_of_local L.hom)
    (mu_sub_mem_sq A a.1 a.2)
  change (stalkEndo A (f + g).hom).hom a.1 -
    ((stalkEndo A f.hom).hom a.1 + (stalkEndo A g.hom).hom a.1) ∈ _
  rw [h1, h2, h3]
  rw [map_sub, map_sub] at hsq
  have : L.hom ((μ[A.X].left.stalkMapAt (mu_origin2 A)).hom a.1) -
      (L.hom (phi1 A a.1) + L.hom (phi2 A a.1)) =
      L.hom ((μ[A.X].left.stalkMapAt (mu_origin2 A)).hom a.1) - L.hom (phi1 A a.1) -
        L.hom (phi2 A a.1) := by ring
  rw [this]
  exact hsq

theorem cotangentMap_zero (A : PkgI3.AbVar K) :
    cotangentMap A (0 : PkgI3.AbVar.End A).hom = 0 := by
  apply LinearMap.ext
  intro v
  obtain ⟨a, rfl⟩ := (IsLocalRing.maximalIdeal (O0 A)).toCotangent_surjective v
  simp only [cotangentMap, Ideal.mapCotangent_toCotangent, LinearMap.zero_apply]
  have e : (0 : PkgI3.AbVar.End A).hom.left = A.X.hom ≫ η[A.X].left := by
    rw [PkgI3.AbVar.Hom.hom_zero, Hom.one_def]; rfl
  have h0 : (stalkEndo A (0 : PkgI3.AbVar.End A).hom).hom a.1 = 0 := by
    change Scheme.Hom.stalkMapAt (0 : PkgI3.AbVar.End A).hom.left (map_origin A _) a.1 = 0
    rw [Scheme.Hom.stalkMapAt_congr e _ (by rw [← e]; exact map_origin A _)]
    exact stalkMapAt_one_eq_zero A _ a.1 a.2
  rw [Ideal.toCotangent_eq_zero]
  change (stalkEndo A (0 : PkgI3.AbVar.End A).hom).hom a.1 ∈ _
  rw [h0]
  exact Ideal.zero_mem _

theorem cotangentMap_one (A : PkgI3.AbVar K) :
    cotangentMap A (1 : PkgI3.AbVar.End A).hom = LinearMap.id := by
  apply LinearMap.ext
  intro v
  obtain ⟨a, rfl⟩ := (IsLocalRing.maximalIdeal (O0 A)).toCotangent_surjective v
  simp only [cotangentMap, Ideal.mapCotangent_toCotangent, LinearMap.id_apply]
  congr 1
  apply Subtype.ext
  change Scheme.Hom.stalkMapAt (1 : PkgI3.AbVar.End A).hom.left (map_origin A _) a.1 = a.1
  have e : (1 : PkgI3.AbVar.End A).hom.left = 𝟙 _ := rfl
  rw [Scheme.Hom.stalkMapAt_congr e _ (by rw [← e]; exact map_origin A _),
    Scheme.Hom.stalkMapAt_id]
  rfl

/-- **`CotangentMulN` holds** (glue of mul-rigidity, statement verbatim). -/
theorem cotangentMulN : CotangentMulN := by
  intro k _ A n
  let F : PkgI3.AbVar.End A →+ (IsLocalRing.CotangentSpace (O0 A) →ₗ[ℤ]
      IsLocalRing.CotangentSpace (O0 A)) :=
    { toFun := fun f => cotangentMap A f.hom
      map_zero' := cotangentMap_zero A
      map_add' := cotangentMap_add A }
  have hn : (n : PkgI3.AbVar.End A) = n • (1 : PkgI3.AbVar.End A) := (zsmul_one n).symm
  change F (n : PkgI3.AbVar.End A) = n • LinearMap.id
  rw [hn, map_zsmul]
  congr 1
  exact cotangentMap_one A

/-- **`MulIsogeny` (textbook leaf) is a theorem.** -/
theorem mulIsogeny : G0FibreSimple.MulIsogeny :=
  mulIsogeny_of_cotangentMulN cotangentMulN

/-- **`KerUnitOpen` (leaf candidate) is a theorem.** -/
theorem kerUnitOpen : KerUnitOpen :=
  kerUnitOpen_of_cotangentMulN cotangentMulN

end CotMul

