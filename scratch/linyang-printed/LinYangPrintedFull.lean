theorem PE.eval_v2 {R : Type*} [CommRing R] (s0 s1 s2 s3 : R) : sel s0 s1 s2 s3 2 = s2 := rfl
theorem PE.eval_v3 {R : Type*} [CommRing R] (s0 s1 s2 s3 : R) : sel s0 s1 s2 s3 3 = s3 := rfl

