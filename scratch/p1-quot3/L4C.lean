import ZInQKernel.Contrib.OneProof.QuotientP1.FixedDisjoint
import ZInQKernel.Contrib.CloudW03NeronSurj.Vendor.Theorems.Thm_AlgebraicGeometry_Smooth_isDomain_and_isIntegrallyClosed_stalk_of_isDiscreteValuationRing

/-!
# p1-quot3, L4 part C: the coordinate extends, given three sections with disjoint closures (scratch)
-/

noncomputable section

open CategoryTheory Limits AlgebraicGeometry Polynomial Opposite

namespace HDec.MCRGlue.P1Model

open VertWitness LeafQM.AV ModelGlue

/-! ## Charts: the complement of `U` is one point -/

section Chart

variable (Z : Over (Spec (CommRingCat.of ℚ))) (σ : ToP1 Z.left) (hσ : IsP1CoordinateQ Z σ)

include hσ in
/-- The ideal generated by the chart coordinate `g` is maximal. -/
theorem span_g_isMaximal : (Ideal.span {σ.g}).IsMaximal := by
  let e : ℚ[X] ≃+* Γ(Z.left, σ.V) := RingEquiv.ofBijective _ hσ.2.2.2
  have he : e X = σ.g := by simp [e]
  have hX : (Ideal.span {(X : ℚ[X])}).IsMaximal :=
    PrincipalIdealRing.isMaximal_of_irreducible Polynomial.irreducible_X
  have := Ideal.map_isMaximal_of_equiv e (p := Ideal.span {(X : ℚ[X])})
  rwa [Ideal.map_span, Set.image_singleton, he] at this

/-- In an affine open, a point lies outside the basic open of `a` iff `a` is in its prime. -/
theorem mem_primeIdealOf_iff {X : Scheme.{0}} {V : X.Opens} (hV : IsAffineOpen V) (x : X) (hx : x ∈ V)
    (a : Γ(X, V)) : a ∈ (hV.primeIdealOf ⟨x, hx⟩).asIdeal ↔ x ∉ X.basicOpen a := by
  set 𝔮 := hV.primeIdealOf ⟨x, hx⟩ with h𝔮
  have hfs : hV.fromSpec 𝔮 = x := hV.fromSpec_primeIdealOf ⟨x, hx⟩
  have h1 : 𝔮 ∈ PrimeSpectrum.basicOpen a ↔ x ∈ X.basicOpen a := by
    have : 𝔮 ∈ hV.fromSpec ⁻¹ᵁ X.basicOpen a ↔ x ∈ X.basicOpen a := by
      rw [← hfs]; rfl
    rwa [hV.fromSpec_preimage_basicOpen] at this
  rw [← h1, PrimeSpectrum.mem_basicOpen, not_not]

include hσ in
/-- **Outside the chart `U` there is exactly one point.** -/
theorem eq_of_notMem_U {y y' : Z.left} (hy : y ∉ σ.U) (hy' : y' ∉ σ.U) : y = y' := by
  have hV : IsAffineOpen σ.V := hσ.2.1
  have hmem : ∀ x : Z.left, x ∉ σ.U → x ∈ σ.V := fun x hx => by
    have : x ∈ σ.U ⊔ σ.V := by rw [σ.cover]; trivial
    exact this.resolve_left hx
  have key : ∀ (x : Z.left) (hx : x ∉ σ.U),
      (hV.primeIdealOf ⟨x, hmem x hx⟩).asIdeal = Ideal.span {σ.g} := by
    intro x hx
    have hg : σ.g ∈ (hV.primeIdealOf ⟨x, hmem x hx⟩).asIdeal := by
      rw [mem_primeIdealOf_iff hV x (hmem x hx), σ.basicOpen_g]
      exact fun h => hx h.1
    have hle : Ideal.span {σ.g} ≤ (hV.primeIdealOf ⟨x, hmem x hx⟩).asIdeal :=
      (Ideal.span_singleton_le_iff_mem _).2 hg
    exact ((span_g_isMaximal Z σ hσ).eq_of_le (hV.primeIdealOf ⟨x, hmem x hx⟩).isPrime.ne_top hle).symm
  have h1 := hV.fromSpec_primeIdealOf ⟨y, hmem y hy⟩
  have h2 := hV.fromSpec_primeIdealOf ⟨y', hmem y' hy'⟩
  have h3 : hV.primeIdealOf ⟨y, hmem y hy⟩ = hV.primeIdealOf ⟨y', hmem y' hy'⟩ :=
    PrimeSpectrum.ext ((key y hy).trans (key y' hy').symm)
  calc y = hV.fromSpec (hV.primeIdealOf ⟨y, hmem y hy⟩) := h1.symm
    _ = hV.fromSpec (hV.primeIdealOf ⟨y', hmem y' hy'⟩) := by rw [h3]
    _ = y' := h2

end Chart

end HDec.MCRGlue.P1Model
