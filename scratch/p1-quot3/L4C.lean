import ZInQKernel.Contrib.OneProof.QuotientP1.P1ModelB
import ZInQKernel.Contrib.OneProof.QuotientP1.FixedDisjoint
import ZInQKernel.Contrib.CloudW03NeronSurj.Vendor.Theorems.Thm_AlgebraicGeometry_Smooth_isDomain_and_isIntegrallyClosed_stalk_of_isDiscreteValuationRing

/-!
# p1-quot3, L4 part C: the coordinate extends, given three sections with disjoint closures (scratch)
-/

noncomputable section

open CategoryTheory Limits AlgebraicGeometry Polynomial Opposite

namespace HDec.MCRGlue.P1Model

open VertWitness LeafQM.AV ModelGlue

/-! ## Charts: the complement of `U` is one point -/

section Chart

variable (Z : Over (Spec (CommRingCat.of ℚ))) (σ : ToP1 Z.left) (hσ : IsP1CoordinateQ Z σ)

include hσ in
/-- The ideal generated by the chart coordinate `g` is maximal. -/
theorem span_g_isMaximal : (Ideal.span {σ.g}).IsMaximal := by
  let e : ℚ[X] ≃+* Γ(Z.left, σ.V) := RingEquiv.ofBijective _ hσ.2.2.2
  have he : e X = σ.g := by simp [e]
  have hX : (Ideal.span {(X : ℚ[X])}).IsMaximal :=
    PrincipalIdealRing.isMaximal_of_irreducible Polynomial.irreducible_X
  have := Ideal.map_isMaximal_of_equiv e (p := Ideal.span {(X : ℚ[X])})
  rwa [Ideal.map_span, Set.image_singleton, he] at this

/-- In an affine open, a point lies outside the basic open of `a` iff `a` is in its prime. -/
theorem mem_primeIdealOf_iff {X : Scheme.{0}} {V : X.Opens} (hV : IsAffineOpen V) (x : X) (hx : x ∈ V)
    (a : Γ(X, V)) : a ∈ (hV.primeIdealOf ⟨x, hx⟩).asIdeal ↔ x ∉ X.basicOpen a := by
  set 𝔮 := hV.primeIdealOf ⟨x, hx⟩ with h𝔮
  have hfs : hV.fromSpec 𝔮 = x := hV.fromSpec_primeIdealOf ⟨x, hx⟩
  have h1 : 𝔮 ∈ PrimeSpectrum.basicOpen a ↔ x ∈ X.basicOpen a := by
    have : 𝔮 ∈ hV.fromSpec ⁻¹ᵁ X.basicOpen a ↔ x ∈ X.basicOpen a := by
      rw [← hfs]; rfl
    rwa [hV.fromSpec_preimage_basicOpen] at this
  rw [← h1, PrimeSpectrum.mem_basicOpen, not_not]

include hσ in
/-- **Outside the chart `U` there is exactly one point.** -/
theorem eq_of_notMem_U {y y' : Z.left} (hy : y ∉ σ.U) (hy' : y' ∉ σ.U) : y = y' := by
  have hV : IsAffineOpen σ.V := hσ.2.1
  have hmem : ∀ x : Z.left, x ∉ σ.U → x ∈ σ.V := fun x hx => by
    have : x ∈ σ.U ⊔ σ.V := by rw [σ.cover]; trivial
    exact this.resolve_left hx
  have key : ∀ (x : Z.left) (hx : x ∉ σ.U),
      (hV.primeIdealOf ⟨x, hmem x hx⟩).asIdeal = Ideal.span {σ.g} := by
    intro x hx
    have hg : σ.g ∈ (hV.primeIdealOf ⟨x, hmem x hx⟩).asIdeal := by
      rw [mem_primeIdealOf_iff hV x (hmem x hx), σ.basicOpen_g]
      exact fun h => hx h.1
    have hle : Ideal.span {σ.g} ≤ (hV.primeIdealOf ⟨x, hmem x hx⟩).asIdeal :=
      (Ideal.span_singleton_le_iff_mem _).2 hg
    exact ((span_g_isMaximal Z σ hσ).eq_of_le (hV.primeIdealOf ⟨x, hmem x hx⟩).isPrime.ne_top hle).symm
  have h1 := hV.fromSpec_primeIdealOf ⟨y, hmem y hy⟩
  have h2 := hV.fromSpec_primeIdealOf ⟨y', hmem y' hy'⟩
  have h3 : hV.primeIdealOf ⟨y, hmem y hy⟩ = hV.primeIdealOf ⟨y', hmem y' hy'⟩ :=
    PrimeSpectrum.ext ((key y hy).trans (key y' hy').symm)
  calc y = hV.fromSpec (hV.primeIdealOf ⟨y, hmem y hy⟩) := h1.symm
    _ = hV.fromSpec (hV.primeIdealOf ⟨y', hmem y' hy'⟩) := by rw [h3]
    _ = y' := h2

/-- The chart structure with the two charts exchanged (`t ↦ 1/t`). -/
def swapP1 {X : Scheme.{0}} (σ : ToP1 X) : ToP1 X where
  U := σ.V
  V := σ.U
  cover := by rw [sup_comm]; exact σ.cover
  f := σ.g
  g := σ.f
  inv := QuotientP1Proof.inv' σ
  basicOpen_f := by rw [σ.basicOpen_g, inf_comm]
  basicOpen_g := by rw [σ.basicOpen_f, inf_comm]

include hσ in
theorem isP1CoordinateQ_swap : IsP1CoordinateQ Z (swapP1 σ) :=
  ⟨hσ.2.1, hσ.1, hσ.2.2.2, hσ.2.2.1⟩

end Chart

/-! ## The generic fibre inside the model -/

section Model

variable {p : ℕ} [Fact p.Prime] (𝒵 : Over (Spec (CommRingCat.of (Zloc p))))

/-- The inclusion of the generic fibre. -/
abbrev jj : (genFib 𝒵).left ⟶ 𝒵.left := pullback.fst 𝒵.hom (specRatToZloc p)

instance isOpenImmersion_jj : IsOpenImmersion (jj 𝒵) :=
  MorphismProperty.pullback_fst (P := @IsOpenImmersion) _ _ (isOpenImmersion_specRatToZloc p)

theorem bot_ne_s0 : (⟨⊥, Ideal.isPrime_bot⟩ : Spec (CommRingCat.of (Zloc p))) ≠ s0 p := by
  haveI := zloc_isDVR' (p := p)
  intro h
  have h1 : (⊥ : Ideal (Zloc p)) = IsLocalRing.maximalIdeal (Zloc p) :=
    congrArg PrimeSpectrum.asIdeal h
  have hp : (p : Zloc p) ∈ IsLocalRing.maximalIdeal (Zloc p) := by
    rw [maximalIdeal_Zloc]; exact Ideal.subset_span rfl
  rw [← h1, Ideal.mem_bot] at hp
  have := congrArg (zlocToRat p) hp
  rw [map_natCast, map_zero] at this
  exact (Fact.out : p.Prime).ne_zero (by exact_mod_cast this)

theorem range_specRatToZloc :
    Set.range (specRatToZloc p) = {(⟨⊥, Ideal.isPrime_bot⟩ : Spec (CommRingCat.of (Zloc p)))} := by
  ext s
  constructor
  · rintro ⟨t, rfl⟩
    rw [Subsingleton.elim t (IsLocalRing.closedPoint ℚ), MCRQuot.specRatToZloc_closedPoint]
    rfl
  · intro hs
    exact ⟨IsLocalRing.closedPoint ℚ, by rw [MCRQuot.specRatToZloc_closedPoint]; exact hs.symm⟩

theorem range_jj : Set.range (jj 𝒵) = {x | 𝒵.hom x ≠ s0 p} := by
  haveI := zloc_isDVR' (p := p)
  have hr : Set.range (pullback.fst 𝒵.hom (specRatToZloc p)) =
      𝒵.hom ⁻¹' Set.range (specRatToZloc p) := Scheme.Pullback.range_fst _ _
  refine hr.trans ?_
  rw [range_specRatToZloc]
  ext x
  simp only [Set.mem_preimage, Set.mem_singleton_iff, Set.mem_setOf_eq]
  constructor
  · rintro h; rw [h]; exact bot_ne_s0
  · intro hx
    exact PrimeSpectrum.ext (QuotientP1Proof.asIdeal_eq_bot_of_ne_closedPoint _ _ hx)

theorem hom_jj_ne (y : (genFib 𝒵).left) : 𝒵.hom (jj 𝒵 y) ≠ s0 p := by
  have : jj 𝒵 y ∈ Set.range (jj 𝒵) := ⟨y, rfl⟩
  rw [range_jj] at this
  exact this

theorem mem_range_jj {x : 𝒵.left} (hx : 𝒵.hom x ≠ s0 p) : ∃ y, jj 𝒵 y = x := by
  have : x ∈ Set.range (jj 𝒵) := by rw [range_jj]; exact hx
  exact this

theorem exists_s0_mem_closure [UniversallyClosed 𝒵.hom] (z : 𝒵.left) :
    ∃ x ∈ closure {z}, 𝒵.hom x = s0 p := by
  haveI := zloc_isDVR' (p := p)
  have hcl : IsClosed (𝒵.hom '' closure {z}) := 𝒵.hom.isClosedMap _ isClosed_closure
  have hmem : s0 p ∈ 𝒵.hom '' closure {z} := by
    have h1 : 𝒵.hom z ⤳ s0 p := IsLocalRing.specializes_closedPoint _
    exact h1.mem_closed hcl ⟨z, subset_closure rfl, rfl⟩
  obtain ⟨x, hx, hx'⟩ := hmem
  exact ⟨x, hx, hx'⟩

/-- The complement of the closure of a point, as an open. -/
def Uc (z : 𝒵.left) : 𝒵.left.Opens := ⟨(closure {z})ᶜ, isClosed_closure.isOpen_compl⟩

theorem mem_Uc {z x : 𝒵.left} : x ∈ Uc 𝒵 z ↔ x ∉ closure {z} := Iff.rfl

/-! ## Extending the coordinate across the special fibre -/

/-- The chart coordinate as a section of the model over the image of the chart. -/
def tU (σ : ToP1 (genFib 𝒵).left) : Γ(𝒵.left, jj 𝒵 ''ᵁ σ.U) := ((jj 𝒵).appIso σ.U).inv σ.f

theorem appLE_tU (σ : ToP1 (genFib 𝒵).left) (h : σ.U ≤ jj 𝒵 ⁻¹ᵁ (jj 𝒵 ''ᵁ σ.U)) :
    (jj 𝒵).appLE (jj 𝒵 ''ᵁ σ.U) σ.U h (tU 𝒵 σ) = σ.f := by
  rw [tU, ← ConcreteCategory.comp_apply, Scheme.Hom.appIso_inv_appLE]
  simp

variable [IsIntegral 𝒵.left] [IsProper 𝒵.hom] [SmoothOfRelativeDimension 1 𝒵.hom]
  [GeometricallyConnected 𝒵.hom]

theorem normal_stalks (x : 𝒵.left) :
    IsDomain (𝒵.left.presheaf.stalk x) ∧ IsIntegrallyClosed (𝒵.left.presheaf.stalk x) := by
  haveI := zloc_isDVR' (p := p)
  haveI : Smooth 𝒵.hom := SmoothOfRelativeDimension.smooth 1 _
  exact ZInQ.Contrib.CloudW03NeronSurj.FLT.AlgebraicGeometry.Smooth.isDomain_and_isIntegrallyClosed_stalk_of_isDiscreteValuationRing
    (Zloc p) 𝒵.hom x

instance : IsLocallyNoetherian 𝒵.left := LocallyOfFiniteType.isLocallyNoetherian 𝒵.hom

theorem genericPoint_mem_open (O : 𝒵.left.Opens) (hO : (O : Set 𝒵.left).Nonempty) :
    genericPoint 𝒵.left ∈ O := by
  obtain ⟨x, hx⟩ := hO
  exact ((genericPoint_spec 𝒵.left).mem_open_set_iff O.isOpen).mpr ⟨x, trivial, hx⟩

theorem image_nonempty (σ : ToP1 (genFib 𝒵).left) (hne : (σ.U : Set (genFib 𝒵).left).Nonempty) :
    ((jj 𝒵 ''ᵁ σ.U : 𝒵.left.Opens) : Set 𝒵.left).Nonempty := by
  obtain ⟨y, hy⟩ := hne
  exact ⟨jj 𝒵 y, y, hy, rfl⟩

/-- **The coordinate extends across the special fibre where it is regular at `ξ`.** If the chart coordinate `f`
of `σ`, as an element of the function field, lies in the local ring at `ξ`, it extends to a section over the
complement `U` of the closure of the pole. -/
theorem extend_of_isInteger (σ : ToP1 (genFib 𝒵).left) (hσ : IsP1CoordinateQ (genFib 𝒵) σ)
    (yinf : (genFib 𝒵).left) (hyinf : yinf ∉ σ.U)
    (hclosed : ∀ x ∈ closure {jj 𝒵 yinf}, 𝒵.hom x ≠ s0 p → x = jj 𝒵 yinf)
    (hξ : xi 𝒵 ∉ closure {jj 𝒵 yinf}) (hne : (σ.U : Set (genFib 𝒵).left).Nonempty)
    (a : 𝒵.left.presheaf.stalk (xi 𝒵))
    (ha : algebraMap _ 𝒵.left.functionField a =
      𝒵.left.presheaf.germ (jj 𝒵 ''ᵁ σ.U) (genericPoint 𝒵.left)
        (genericPoint_mem_open 𝒵 _ (image_nonempty 𝒵 σ hne)) (tU 𝒵 σ)) :
    ∃ (f : Γ(𝒵.left, Uc 𝒵 (jj 𝒵 yinf))) (h : σ.U ≤ jj 𝒵 ⁻¹ᵁ Uc 𝒵 (jj 𝒵 yinf)),
      (jj 𝒵).appLE _ σ.U h f = σ.f ∧ 𝒵.left.presheaf.germ _ (xi 𝒵) hξ f = a := by
  set U := Uc 𝒵 (jj 𝒵 yinf) with hUdef
  set O : 𝒵.left.Opens := jj 𝒵 ''ᵁ σ.U with hOdef
  have hOU : O ≤ U := by
    rintro _ ⟨y, hy, rfl⟩ hcl
    have := hclosed _ hcl (hom_jj_ne 𝒵 y)
    have hyy : y = yinf := (jj 𝒵).isOpenEmbedding.injective this
    exact hyinf (hyy ▸ hy)
  have hη := genericPoint_mem_open 𝒵 O (image_nonempty 𝒵 σ hne)
  obtain ⟨N, hξN, k, hk⟩ := 𝒵.left.presheaf.germ_exist (x := xi 𝒵) a
  set NU : 𝒵.left.Opens := N ⊓ U
  have hξNU : xi 𝒵 ∈ NU := ⟨hξN, hξ⟩
  have hηNU : genericPoint 𝒵.left ∈ NU := genericPoint_mem_open 𝒵 NU ⟨_, hξNU⟩
  have hηW : genericPoint 𝒵.left ∈ O ⊓ NU := ⟨hη, hηNU⟩
  -- the two sections agree on the overlap (same germ at the generic point)
  have hagree : 𝒵.left.presheaf.map (homOfLE (inf_le_left : O ⊓ NU ≤ O)).op (tU 𝒵 σ) =
      𝒵.left.presheaf.map (homOfLE (inf_le_right : O ⊓ NU ≤ NU)).op
        (𝒵.left.presheaf.map (homOfLE (inf_le_left : NU ≤ N)).op k) := by
    apply germ_injective_of_isIntegral 𝒵.left (genericPoint 𝒵.left) hηW
    rw [TopCat.Presheaf.germ_res_apply, TopCat.Presheaf.germ_res_apply,
      TopCat.Presheaf.germ_res_apply, ← ha]
    have hsp : genericPoint 𝒵.left ⤳ xi 𝒵 := (genericPoint_spec 𝒵.left).specializes trivial
    rw [← hk]
    change 𝒵.left.presheaf.stalkSpecializes hsp (𝒵.left.presheaf.germ N (xi 𝒵) hξN k) = _
    rw [TopCat.Presheaf.germ_stalkSpecializes_apply]
  set s := (𝒵.left.sheaf.objSupIsoProdEqLocus O NU).inv
    ⟨(tU 𝒵 σ, 𝒵.left.presheaf.map (homOfLE (inf_le_left : NU ≤ N)).op k), hagree⟩
  have hsO : 𝒵.left.presheaf.map (homOfLE le_sup_left : O ⟶ O ⊔ NU).op s = tU 𝒵 σ := by
    have := TopCat.Sheaf.objSupIsoProdEqLocus_inv_fst 𝒵.left.sheaf O NU
      ⟨(tU 𝒵 σ, 𝒵.left.presheaf.map (homOfLE (inf_le_left : NU ≤ N)).op k), hagree⟩
    exact this
  have hsN : 𝒵.left.presheaf.map (homOfLE le_sup_right : NU ⟶ O ⊔ NU).op s =
      𝒵.left.presheaf.map (homOfLE (inf_le_left : NU ≤ N)).op k := by
    have := TopCat.Sheaf.objSupIsoProdEqLocus_inv_snd 𝒵.left.sheaf O NU
      ⟨(tU 𝒵 σ, 𝒵.left.presheaf.map (homOfLE (inf_le_left : NU ≤ N)).op k), hagree⟩
    exact this
  -- extend across the points of codimension `≥ 2`
  have hle : O ⊔ NU ≤ U := sup_le hOU inf_le_right
  have hgen : ∃ y : 𝒵.left, 𝒵.hom y ≠ s0 p := by
    obtain ⟨y, -⟩ := hne; exact ⟨jj 𝒵 y, hom_jj_ne 𝒵 y⟩
  have hcod : ∀ x : 𝒵.left, x ∈ U → ringKrullDim (𝒵.left.presheaf.stalk x) ≤ 1 → x ∈ O ⊔ NU := by
    intro x hxU hd
    by_cases hx : 𝒵.hom x = s0 p
    · have := eq_xi_of_ringKrullDim_le_one 𝒵 hgen x hx hd
      exact Or.inr (this ▸ hξNU)
    · obtain ⟨y, rfl⟩ := mem_range_jj 𝒵 hx
      by_cases hyU : y ∈ σ.U
      · exact Or.inl ⟨y, hyU, rfl⟩
      · have := eq_of_notMem_U _ σ hσ hyU hyinf
        subst this
        exact absurd (subset_closure (Set.mem_singleton _)) hxU
  obtain ⟨f, hf⟩ := extend_open (normal_stalks 𝒵) U (O ⊔ NU) hle hcod s
  have hσU : σ.U ≤ jj 𝒵 ⁻¹ᵁ U := fun y hy => hOU ⟨y, hy, rfl⟩
  refine ⟨f, hσU, ?_, ?_⟩
  · have h1 : 𝒵.left.presheaf.map (homOfLE (le_sup_left.trans hle) : O ⟶ U).op f = tU 𝒵 σ := by
      rw [← hsO, ← hf, Scheme.presheaf_map_map]
    rw [← appLE_tU 𝒵 σ (fun y hy => ⟨y, hy, rfl⟩), ← h1, ← ConcreteCategory.comp_apply]
    erw [Scheme.Hom.map_appLE]
  · have h2 : 𝒵.left.presheaf.map (homOfLE (le_sup_right.trans hle) : NU ⟶ U).op f =
        𝒵.left.presheaf.map (homOfLE (inf_le_left : NU ≤ N)).op k := by
      rw [← hsN, ← hf, Scheme.presheaf_map_map]
    rw [← TopCat.Presheaf.germ_res_apply _ (homOfLE (le_sup_right.trans hle) : NU ⟶ U) _ hξNU, h2,
      TopCat.Presheaf.germ_res_apply, hk]

/-! ## The value at the third section forces a unit at `ξ` -/

theorem basicOpen_sub_le {X : Scheme.{0}} {W : X.Opens} (a b : Γ(X, W)) :
    X.basicOpen (a - b) ≤ X.basicOpen a ⊔ X.basicOpen b := by
  have h := X.basicOpen_add_le a (-b)
  have hneg : X.basicOpen (-b) = X.basicOpen b := by
    rw [show -b = (-1) * b by ring, Scheme.basicOpen_mul,
      Scheme.basicOpen_of_isUnit _ (isUnit_one.neg), inf_eq_right.2 (X.basicOpen_le b)]
  rw [sub_eq_add_neg, ← hneg]
  exact h

/-- A constant of `ℤ_(p)` as a section. -/
abbrev cst (c : Zloc p) (W : 𝒵.left.Opens) : Γ(𝒵.left, W) :=
  baseToSectionsOver (CommRingCat.of (Zloc p)) 𝒵 W c

theorem appLE_comp_apply' {X Y Z : Scheme.{0}} (f : X ⟶ Y) (g : Y ⟶ Z) (U V W e₁ e₂) (x) :
    (f.appLE V W e₂) ((g.appLE U V e₁) x) =
      (f ≫ g).appLE U W (e₂.trans ((TopologicalSpace.Opens.map f.base).map (homOfLE e₁)).le) x := by
  rw [← ConcreteCategory.comp_apply, Scheme.Hom.appLE_comp_appLE]

theorem baseToSectionsOver_eq_appLE (R : CommRingCat.{0}) (𝒴 : Over (Spec R)) (W : 𝒴.left.Opens) (c : R) :
    baseToSectionsOver R 𝒴 W c = 𝒴.hom.appLE ⊤ W le_top ((Scheme.ΓSpecIso R).inv c) := rfl

theorem appLE_cst (c : Zloc p) (W : 𝒵.left.Opens) (V : (genFib 𝒵).left.Opens) (e : V ≤ jj 𝒵 ⁻¹ᵁ W) :
    (jj 𝒵).appLE W V e (cst 𝒵 c W) =
      baseToSectionsOver (CommRingCat.of ℚ) (genFib 𝒵) V (zlocToRat p c) := by
  rw [cst, baseToSectionsOver_eq_appLE, baseToSectionsOver_eq_appLE]
  refine (appLE_comp_apply' (jj 𝒵) 𝒵.hom ⊤ W V _ e _).trans ?_
  have hc : jj 𝒵 ≫ 𝒵.hom = (genFib 𝒵).hom ≫ specRatToZloc p := pullback.condition
  rw [QuotientP1Proof.appLE_eq_of_eq' hc]
  refine (appLE_comp_apply' (genFib 𝒵).hom (specRatToZloc p) ⊤ ⊤ V le_top le_top _).symm.trans ?_
  congr 1
  change (specRatToZloc p).appTop ((Scheme.ΓSpecIso (CommRingCat.of (Zloc p))).inv c) = _
  rw [← ConcreteCategory.comp_apply, ← Scheme.ΓSpecIso_inv_naturality]
  rfl


/-- **The value `c` (a unit) at a third section with closure disjoint from the pole forces the extended coordinate
to be a unit at `ξ`.** -/
theorem isUnit_germ_of_third (σ : ToP1 (genFib 𝒵).left)
    (yinf : (genFib 𝒵).left) (hξ : xi 𝒵 ∉ closure {jj 𝒵 yinf})
    (c : Zloc p) (hc : IsUnit c) (yc : (genFib 𝒵).left) (hycU : yc ∈ σ.U)
    (hycv : yc ∉ (genFib 𝒵).left.basicOpen
      (σ.f - baseToSectionsOver (CommRingCat.of ℚ) (genFib 𝒵) σ.U (zlocToRat p c)))
    (hdisj : Disjoint (closure {jj 𝒵 yc}) (closure {jj 𝒵 yinf}))
    (f : Γ(𝒵.left, Uc 𝒵 (jj 𝒵 yinf))) (h : σ.U ≤ jj 𝒵 ⁻¹ᵁ Uc 𝒵 (jj 𝒵 yinf))
    (hf : (jj 𝒵).appLE _ σ.U h f = σ.f) :
    IsUnit (𝒵.left.presheaf.germ _ (xi 𝒵) hξ f) := by
  by_contra hnu
  obtain ⟨xc, hxc, hxcs⟩ := exists_s0_mem_closure 𝒵 (jj 𝒵 yc)
  have hxcU : xc ∈ Uc 𝒵 (jj 𝒵 yinf) := fun h' => Set.disjoint_left.mp hdisj hxc h'
  have h1 : xc ∉ 𝒵.left.basicOpen f := fun hx =>
    hnu ((Scheme.mem_basicOpen _ _ _ hξ).mp
      ((xi_specializes 𝒵 hxcs).mem_open (𝒵.left.basicOpen f).isOpen hx))
  have hj : jj 𝒵 yc ∉ 𝒵.left.basicOpen (f - cst 𝒵 c (Uc 𝒵 (jj 𝒵 yinf))) := by
    intro hx
    apply hycv
    have := Scheme.basicOpen_appLE (jj 𝒵) σ.U (Uc 𝒵 (jj 𝒵 yinf)) h (f - cst 𝒵 c (Uc 𝒵 (jj 𝒵 yinf)))
    rw [map_sub, hf, appLE_cst] at this
    rw [this]
    exact ⟨hycU, hx⟩
  have h2 : xc ∉ 𝒵.left.basicOpen (f - cst 𝒵 c (Uc 𝒵 (jj 𝒵 yinf))) := fun hx =>
    hj ((specializes_iff_mem_closure.mpr hxc).mem_open (𝒵.left.basicOpen _).isOpen hx)
  have h3 : 𝒵.left.basicOpen (cst 𝒵 c (Uc 𝒵 (jj 𝒵 yinf))) = Uc 𝒵 (jj 𝒵 yinf) :=
    Scheme.basicOpen_of_isUnit _ (hc.map _)
  have h4 := basicOpen_sub_le f (f - cst 𝒵 c (Uc 𝒵 (jj 𝒵 yinf)))
  rw [sub_sub_cancel, h3] at h4
  rcases h4 hxcU with h5 | h5
  · exact h1 h5
  · exact h2 h5

/-- `ξ` has a DVR as local ring. -/
theorem xi_isDVR : ∃ _ : IsDomain (𝒵.left.presheaf.stalk (xi 𝒵)),
    IsDiscreteValuationRing (𝒵.left.presheaf.stalk (xi 𝒵)) := by
  haveI := zloc_isDVR' (p := p)
  haveI : Smooth 𝒵.hom := SmoothOfRelativeDimension.smooth 1 _
  refine ZInQ.Contrib.CloudW03NeronSurj.FLT.AlgebraicGeometry.Smooth.isDiscreteValuationRing_stalk_of_forall_specializes
    (Zloc p) 𝒵.hom (xi 𝒵) (xi_mem 𝒵) ?_
  intro y hy hys
  exact (hy.antisymm (xi_specializes 𝒵 hys)).eq

theorem tU_res (σ : ToP1 (genFib 𝒵).left) (W : (genFib 𝒵).left.Opens) (hW : W ≤ σ.U) :
    𝒵.left.presheaf.map (homOfLE ((jj 𝒵).image_mono hW)).op (tU 𝒵 σ) =
      ((jj 𝒵).appIso W).inv ((genFib 𝒵).left.presheaf.map (homOfLE hW).op σ.f) := by
  rw [tU, ← ConcreteCategory.comp_apply, ← ConcreteCategory.comp_apply,
    Scheme.Hom.appIso_inv_naturality]
  rfl

/-- The germs at the generic point of the two chart coordinates are inverse. -/
theorem germ_mul_swap (σ : ToP1 (genFib 𝒵).left) (hne : ((σ.U ⊓ σ.V : (genFib 𝒵).left.Opens) :
      Set (genFib 𝒵).left).Nonempty)
    (h1 : genericPoint 𝒵.left ∈ jj 𝒵 ''ᵁ σ.U) (h2 : genericPoint 𝒵.left ∈ jj 𝒵 ''ᵁ (swapP1 σ).U) :
    𝒵.left.presheaf.germ _ (genericPoint 𝒵.left) h1 (tU 𝒵 σ) *
      𝒵.left.presheaf.germ _ (genericPoint 𝒵.left) h2 (tU 𝒵 (swapP1 σ)) = 1 := by
  set W := σ.U ⊓ σ.V
  have hW : genericPoint 𝒵.left ∈ jj 𝒵 ''ᵁ W := genericPoint_mem_open 𝒵 _
    (by obtain ⟨y, hy⟩ := hne; exact ⟨jj 𝒵 y, y, hy, rfl⟩)
  have hWU : jj 𝒵 ''ᵁ W ≤ jj 𝒵 ''ᵁ σ.U := (jj 𝒵).image_mono inf_le_left
  have hWV : jj 𝒵 ''ᵁ W ≤ jj 𝒵 ''ᵁ (swapP1 σ).U := (jj 𝒵).image_mono inf_le_right
  have e1 := tU_res 𝒵 σ W inf_le_left
  have e2 := tU_res 𝒵 (swapP1 σ) W inf_le_right
  rw [← TopCat.Presheaf.germ_res_apply _ (homOfLE hWU) _ hW,
    ← TopCat.Presheaf.germ_res_apply _ (homOfLE hWV) _ hW, ← map_mul, e1, e2, ← map_mul]
  have hinv : (genFib 𝒵).left.presheaf.map (homOfLE (inf_le_left : W ≤ σ.U)).op σ.f *
      (genFib 𝒵).left.presheaf.map (homOfLE (inf_le_right : W ≤ (swapP1 σ).U)).op (swapP1 σ).f = 1 :=
    σ.inv
  erw [hinv]
  rw [map_one, map_one]

