noncomputable section

open CategoryTheory Limits AlgebraicGeometry Polynomial Opposite

namespace HDec.MCRGlue.P1Model

open VertWitness LeafQM.AV ModelGlue

/-! ## Charts: the complement of `U` is one point -/

section Chart

variable (Z : Over (Spec (CommRingCat.of ℚ))) (σ : ToP1 Z.left) (hσ : IsP1CoordinateQ Z σ)

include hσ in
/-- The ideal generated by the chart coordinate `g` is maximal. -/
theorem span_g_isMaximal : (Ideal.span {σ.g}).IsMaximal := by
  let e : ℚ[X] ≃+* Γ(Z.left, σ.V) := RingEquiv.ofBijective _ hσ.2.2.2
  have he : e X = σ.g := by simp [e]
  have hX : (Ideal.span {(X : ℚ[X])}).IsMaximal :=
    PrincipalIdealRing.isMaximal_of_irreducible Polynomial.irreducible_X
  have := Ideal.map_isMaximal_of_equiv e (p := Ideal.span {(X : ℚ[X])})
  rwa [Ideal.map_span, Set.image_singleton, he] at this

/-- In an affine open, a point lies outside the basic open of `a` iff `a` is in its prime. -/
theorem mem_primeIdealOf_iff {X : Scheme.{0}} {V : X.Opens} (hV : IsAffineOpen V) (x : X) (hx : x ∈ V)
    (a : Γ(X, V)) : a ∈ (hV.primeIdealOf ⟨x, hx⟩).asIdeal ↔ x ∉ X.basicOpen a := by
  set 𝔮 := hV.primeIdealOf ⟨x, hx⟩ with h𝔮
  have hfs : hV.fromSpec 𝔮 = x := hV.fromSpec_primeIdealOf ⟨x, hx⟩
  have h1 : 𝔮 ∈ PrimeSpectrum.basicOpen a ↔ x ∈ X.basicOpen a := by
    have : 𝔮 ∈ hV.fromSpec ⁻¹ᵁ X.basicOpen a ↔ x ∈ X.basicOpen a := by
      rw [← hfs]; rfl
    rwa [hV.fromSpec_preimage_basicOpen] at this
  rw [← h1, PrimeSpectrum.mem_basicOpen, not_not]

include hσ in
/-- **Outside the chart `U` there is exactly one point.** -/
theorem eq_of_notMem_U {y y' : Z.left} (hy : y ∉ σ.U) (hy' : y' ∉ σ.U) : y = y' := by
  have hV : IsAffineOpen σ.V := hσ.2.1
  have hmem : ∀ x : Z.left, x ∉ σ.U → x ∈ σ.V := fun x hx => by
    have : x ∈ σ.U ⊔ σ.V := by rw [σ.cover]; trivial
    exact this.resolve_left hx
  have key : ∀ (x : Z.left) (hx : x ∉ σ.U),
      (hV.primeIdealOf ⟨x, hmem x hx⟩).asIdeal = Ideal.span {σ.g} := by
    intro x hx
    have hg : σ.g ∈ (hV.primeIdealOf ⟨x, hmem x hx⟩).asIdeal := by
      rw [mem_primeIdealOf_iff hV x (hmem x hx), σ.basicOpen_g]
      exact fun h => hx h.1
    have hle : Ideal.span {σ.g} ≤ (hV.primeIdealOf ⟨x, hmem x hx⟩).asIdeal :=
      (Ideal.span_singleton_le_iff_mem _).2 hg
    exact ((span_g_isMaximal Z σ hσ).eq_of_le (hV.primeIdealOf ⟨x, hmem x hx⟩).isPrime.ne_top hle).symm
  have h1 := hV.fromSpec_primeIdealOf ⟨y, hmem y hy⟩
  have h2 := hV.fromSpec_primeIdealOf ⟨y', hmem y' hy'⟩
  have h3 : hV.primeIdealOf ⟨y, hmem y hy⟩ = hV.primeIdealOf ⟨y', hmem y' hy'⟩ :=
    PrimeSpectrum.ext ((key y hy).trans (key y' hy').symm)
  calc y = hV.fromSpec (hV.primeIdealOf ⟨y, hmem y hy⟩) := h1.symm
    _ = hV.fromSpec (hV.primeIdealOf ⟨y', hmem y' hy'⟩) := by rw [h3]
    _ = y' := h2

end Chart

/-! ## The generic fibre inside the model -/

section Model

variable {p : ℕ} [Fact p.Prime] (𝒵 : Over (Spec (CommRingCat.of (Zloc p))))

/-- The inclusion of the generic fibre. -/
abbrev jj : (genFib 𝒵).left ⟶ 𝒵.left := pullback.fst 𝒵.hom (specRatToZloc p)

instance isOpenImmersion_jj : IsOpenImmersion (jj 𝒵) :=
  MorphismProperty.pullback_fst (P := @IsOpenImmersion) _ _ (isOpenImmersion_specRatToZloc p)

theorem bot_ne_s0 : (⟨⊥, Ideal.isPrime_bot⟩ : Spec (CommRingCat.of (Zloc p))) ≠ s0 p := by
  haveI := zloc_isDVR' (p := p)
  intro h
  have h1 : (⊥ : Ideal (Zloc p)) = IsLocalRing.maximalIdeal (Zloc p) :=
    congrArg PrimeSpectrum.asIdeal h
  have hp : (p : Zloc p) ∈ IsLocalRing.maximalIdeal (Zloc p) := by
    rw [maximalIdeal_Zloc]; exact Ideal.subset_span rfl
  rw [← h1, Ideal.mem_bot] at hp
  have := congrArg (zlocToRat p) hp
  rw [map_natCast, map_zero] at this
  exact (Fact.out : p.Prime).ne_zero (by exact_mod_cast this)

theorem range_specRatToZloc :
    Set.range (specRatToZloc p) = {(⟨⊥, Ideal.isPrime_bot⟩ : Spec (CommRingCat.of (Zloc p)))} := by
  ext s
  constructor
  · rintro ⟨t, rfl⟩
    rw [Subsingleton.elim t (IsLocalRing.closedPoint ℚ), MCRQuot.specRatToZloc_closedPoint]
    rfl
  · intro hs
    exact ⟨IsLocalRing.closedPoint ℚ, by rw [MCRQuot.specRatToZloc_closedPoint]; exact hs.symm⟩

theorem range_jj : Set.range (jj 𝒵) = {x | 𝒵.hom x ≠ s0 p} := by
  haveI := zloc_isDVR' (p := p)
  have hr : Set.range (pullback.fst 𝒵.hom (specRatToZloc p)) =
      𝒵.hom ⁻¹' Set.range (specRatToZloc p) := Scheme.Pullback.range_fst _ _
  refine hr.trans ?_
  rw [range_specRatToZloc]
  ext x
  simp only [Set.mem_preimage, Set.mem_singleton_iff, Set.mem_setOf_eq]
  constructor
  · rintro h; rw [h]; exact bot_ne_s0
  · intro hx
    exact PrimeSpectrum.ext (QuotientP1Proof.asIdeal_eq_bot_of_ne_closedPoint _ _ hx)

theorem hom_jj_ne (y : (genFib 𝒵).left) : 𝒵.hom (jj 𝒵 y) ≠ s0 p := by
  have : jj 𝒵 y ∈ Set.range (jj 𝒵) := ⟨y, rfl⟩
  rw [range_jj] at this
  exact this

theorem mem_range_jj {x : 𝒵.left} (hx : 𝒵.hom x ≠ s0 p) : ∃ y, jj 𝒵 y = x := by
  have : x ∈ Set.range (jj 𝒵) := by rw [range_jj]; exact hx
  exact this

theorem exists_s0_mem_closure [UniversallyClosed 𝒵.hom] (z : 𝒵.left) :
    ∃ x ∈ closure {z}, 𝒵.hom x = s0 p := by
  haveI := zloc_isDVR' (p := p)
  have hcl : IsClosed (𝒵.hom '' closure {z}) := 𝒵.hom.isClosedMap _ isClosed_closure
  have hmem : s0 p ∈ 𝒵.hom '' closure {z} := by
    have h1 : 𝒵.hom z ⤳ s0 p := IsLocalRing.specializes_closedPoint _
    exact h1.mem_closed hcl ⟨z, subset_closure rfl, rfl⟩
  obtain ⟨x, hx, hx'⟩ := hmem
  exact ⟨x, hx, hx'⟩

/-- The complement of the closure of a point, as an open. -/
def Uc (z : 𝒵.left) : 𝒵.left.Opens := ⟨(closure {z})ᶜ, isClosed_closure.isOpen_compl⟩

theorem mem_Uc {z x : 𝒵.left} : x ∈ Uc 𝒵 z ↔ x ∉ closure {z} := Iff.rfl

end Model

