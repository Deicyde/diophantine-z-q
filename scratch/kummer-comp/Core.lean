noncomputable section

namespace KummerComp

/-! ## Verbatim copies (dev only) -/

abbrev Qbar := AlgebraicClosure ℚ

def KummerShape (E E' : Type) [Field E] [Field E'] [Algebra (RatFunc ℚ) E]
    [Algebra (RatFunc ℚ) E'] (ι : E →+* E') (r : RatFunc ℚ) : Prop :=
  ι (algebraMap (RatFunc ℚ) E RatFunc.X) = algebraMap (RatFunc ℚ) E' r ∧
    Subfield.closure (Set.range ι ∪ {algebraMap (RatFunc ℚ) E' RatFunc.X}) = ⊤

def KummerCompositum : Prop :=
  ∀ (E : Type) [Field E] [Algebra (RatFunc ℚ) E] [Algebra ℚ[X] E]
    [IsScalarTower ℚ[X] (RatFunc ℚ) E] [FiniteDimensional (RatFunc ℚ) E]
    (P Q : ℚ[X]) (t s₀ : ℚ), Q.eval s₀ ≠ 0 → P.eval s₀ = t * Q.eval s₀ → (∀ a : ℚ, P ≠ C a * Q) →
    ∀ 𝔓 : Ideal (integralClosure ℚ[X] E), 𝔓.IsPrime → 𝔓.under ℚ[X] = Ideal.span {X - C t} →
    ∀ φ : integralClosure ℚ[X] E ⧸ 𝔓 →+* Qbar,
    ∃ (E' : Type) (_ : Field E') (_ : Algebra (RatFunc ℚ) E') (_ : Algebra ℚ[X] E')
      (_ : IsScalarTower ℚ[X] (RatFunc ℚ) E') (_ : FiniteDimensional (RatFunc ℚ) E')
      (ι : E →+* E'),
      KummerShape E E' ι (algebraMap ℚ[X] (RatFunc ℚ) P / algebraMap ℚ[X] (RatFunc ℚ) Q) ∧
      Module.finrank (RatFunc ℚ) E' ≤ Module.finrank (RatFunc ℚ) E ∧
      ∃ 𝔓' : Ideal (integralClosure ℚ[X] E'), 𝔓'.IsPrime ∧
        𝔓'.under ℚ[X] = Ideal.span {X - C s₀} ∧
        ∃ φ' : integralClosure ℚ[X] E' ⧸ 𝔓' →+* Qbar,
          IntermediateField.adjoin ℚ (Set.range φ) ≤ IntermediateField.adjoin ℚ (Set.range φ')

end KummerComp

/-! ## The proof -/

namespace KummerComp

/-- **Abstract compositum with a prescribed prime.** `B` free, finite-type-integral over the domain
`A`, `f : A → O` an injective map to a domain, `α : O → F`, `β : B → F` compatible maps to a domain
with `β` surjective. Then there is a field `E'` (the fraction field of `(O ⊗_A B)/𝔫` for a minimal
prime `𝔫` inside the kernel `N` of `o ⊗ b ↦ α o · β b`) receiving `O` and `B` injectively,
generated by them, and a prime `𝔐` of the integral closure of `O` in `E'` over `ker α` whose
residue ring receives `F` compatibly with `α`. -/
theorem compositum_core (A B O F : Type) [CommRing A] [IsDomain A] [CommRing B] [IsDomain B]
    [CommRing O] [IsDomain O] [CommRing F] [IsDomain F] [Algebra A B] [Module.Free A B]
    [Algebra.IsIntegral A B]
    (f : A →+* O) (hf : Function.Injective f) (α : O →+* F) (β : B →+* F)
    (hβ : Function.Surjective β) (hαβ : ∀ a, α (f a) = β (algebraMap A B a)) :
    ∃ (E' : Type) (_ : Field E') (_ : Algebra O E') (h : B →+* E'),
      Function.Injective (algebraMap O E') ∧ Function.Injective h ∧
      (∀ a, h (algebraMap A B a) = algebraMap O E' (f a)) ∧
      Subfield.closure (Set.range h ∪ Set.range (algebraMap O E')) = ⊤ ∧
      ∃ 𝔐 : Ideal (integralClosure O E'), 𝔐.IsPrime ∧
        𝔐.comap (algebraMap O (integralClosure O E')) = RingHom.ker α ∧
        ∃ ψ : F →+* integralClosure O E' ⧸ 𝔐, Function.Injective ψ ∧
          ψ.comp α = (Ideal.Quotient.mk 𝔐).comp (algebraMap O (integralClosure O E')) := by
  letI : Algebra A O := f.toAlgebra
  -- nonzero elements of `O` are non-zero-divisors of `T = O ⊗_A B` (`T` is `O`-free)
  have hnzd : ∀ o : O, o ≠ 0 → algebraMap O (O ⊗[A] B) o ∈ nonZeroDivisors (O ⊗[A] B) := by
    intro o ho
    rw [mem_nonZeroDivisors_iff_right]
    intro x hx
    have h1 : o • x = 0 := by rw [Algebra.smul_def, mul_comm]; exact hx
    exact (smul_eq_zero.mp h1).resolve_left ho
  -- the map `χ : T → F`
  letI : Algebra A F := (β.comp (algebraMap A B)).toAlgebra
  let αA : O →ₐ[A] F := { α with commutes' := fun a => hαβ a }
  let βA : B →ₐ[A] F := { β with commutes' := fun _ => rfl }
  let χ : O ⊗[A] B →ₐ[A] F := Algebra.TensorProduct.lift αA βA (fun _ _ => Commute.all _ _)
  have hχ : ∀ o b, χ (o ⊗ₜ b) = α o * β b := fun o b => Algebra.TensorProduct.lift_tmul _ _ _ o b
  have hχs : Function.Surjective χ.toRingHom := by
    intro y
    obtain ⟨b, rfl⟩ := hβ y
    exact ⟨1 ⊗ₜ b, by simp [hχ]⟩
  set N := RingHom.ker χ.toRingHom with hN
  haveI hNp : N.IsPrime := RingHom.ker_isPrime _
  obtain ⟨𝔫, h𝔫, h𝔫N⟩ := Ideal.exists_minimalPrimes_le (I := (⊥ : Ideal (O ⊗[A] B))) (J := N)
    bot_le
  haveI h𝔫p : 𝔫.IsPrime := h𝔫.1.1
  have hO𝔫 : ∀ o : O, algebraMap O (O ⊗[A] B) o ∈ 𝔫 → o = 0 := by
    intro o ho
    by_contra hne
    exact notMem_nonZeroDivisors_of_mem_mem_minimalPrimes ho h𝔫 (hnzd o hne)
  -- `D = T/𝔫`, `E' = Frac D`
  let D := O ⊗[A] B ⧸ 𝔫
  let E' := FractionRing D
  let q : O ⊗[A] B →+* E' := (algebraMap D E').comp (Ideal.Quotient.mk 𝔫)
  have hq0 : ∀ x, q x = 0 ↔ x ∈ 𝔫 := by
    intro x
    change algebraMap D E' (Ideal.Quotient.mk 𝔫 x) = 0 ↔ _
    rw [IsFractionRing.to_map_eq_zero_iff (R := D) (K := E'), Ideal.Quotient.eq_zero_iff_mem]
  let j : O →+* E' := q.comp (algebraMap O (O ⊗[A] B))
  let h : B →+* E' := q.comp (Algebra.TensorProduct.includeRight (R := A) (A := O)).toRingHom
  letI iOE : Algebra O E' := j.toAlgebra
  have hj : ∀ o, algebraMap O E' o = q (o ⊗ₜ 1) := fun _ => rfl
  have hh : ∀ b, h b = q (1 ⊗ₜ b) := fun _ => rfl
  have hjinj : Function.Injective (algebraMap O E') := by
    rw [injective_iff_map_eq_zero]
    intro o ho
    exact hO𝔫 o ((hq0 _).mp ho)
  have hrel : ∀ a, h (algebraMap A B a) = algebraMap O E' (f a) := by
    intro a
    rw [hh, hj]
    congr 1
    rw [Algebra.algebraMap_eq_smul_one, ← TensorProduct.smul_tmul, ← Algebra.algebraMap_eq_smul_one]
    rfl
  have hhinj : Function.Injective h := by
    rw [injective_iff_map_eq_zero]
    intro b hb
    by_contra hb0
    have hne := Ideal.under_ne_bot_of_integral_mem (R := A) hb0 (Ideal.mem_span_singleton_self b)
      (Algebra.IsIntegral.isIntegral b)
    obtain ⟨a, ha, ha0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hne
    rw [Ideal.under, Ideal.mem_comap, Ideal.mem_span_singleton'] at ha
    obtain ⟨c, hc⟩ := ha
    have : algebraMap O E' (f a) = 0 := by rw [← hrel, ← hc, map_mul, hb, mul_zero]
    exact ha0 (hf (by rw [hjinj (this.trans (map_zero _).symm), map_zero]))
  -- generation
  have hqmem : ∀ x : O ⊗[A] B,
      q x ∈ Subfield.closure (Set.range h ∪ Set.range (algebraMap O E')) := by
    intro x
    induction x using TensorProduct.induction_on with
    | zero => rw [map_zero]; exact zero_mem _
    | tmul o b =>
      have : o ⊗ₜ[A] b = (o ⊗ₜ[A] (1 : B)) * ((1 : O) ⊗ₜ[A] b) := by
        rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
      rw [this, map_mul]
      exact mul_mem (Subfield.subset_closure (Or.inr ⟨o, rfl⟩))
        (Subfield.subset_closure (Or.inl ⟨b, rfl⟩))
    | add x y hx hy => rw [map_add]; exact add_mem hx hy
  have hgen : Subfield.closure (Set.range h ∪ Set.range (algebraMap O E')) = ⊤ := by
    rw [eq_top_iff]
    intro x _
    obtain ⟨y, z, _, rfl⟩ := IsFractionRing.div_surjective (A := D) x
    obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective y
    obtain ⟨z, rfl⟩ := Ideal.Quotient.mk_surjective z
    exact div_mem (hqmem y) (hqmem z)
  -- the image of `T` is integral over `O`
  have hBint : ∀ b, IsIntegral O (h b) := by
    intro b
    obtain ⟨p, pm, hp⟩ := Algebra.IsIntegral.isIntegral (R := A) b
    refine ⟨p.map f, pm.map f, ?_⟩
    rw [eval₂_map]
    have : (algebraMap O E').comp f = h.comp (algebraMap A B) := by
      ext a; exact (hrel a).symm
    rw [this, ← hom_eval₂, hp, map_zero]
  have hqint : ∀ x, IsIntegral O (q x) := by
    intro x
    induction x using TensorProduct.induction_on with
    | zero => rw [map_zero]; exact isIntegral_zero
    | tmul o b =>
      have : o ⊗ₜ[A] b = (o ⊗ₜ[A] (1 : B)) * ((1 : O) ⊗ₜ[A] b) := by
        rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
      rw [this, map_mul]
      exact (isIntegral_algebraMap (x := o)).mul (hBint b)
    | add x y hx hy => rw [map_add]; exact hx.add hy
  -- `g : T → C = integralClosure O E'`, lying over
  let C := integralClosure O E'
  let g : O ⊗[A] B →+* C := q.codRestrict C.toSubring (fun x => hqint x)
  have hg : ∀ x, (g x : E') = q x := fun _ => rfl
  letI iTC : Algebra (O ⊗[A] B) C := g.toAlgebra
  have hOTC : algebraMap O C = (algebraMap (O ⊗[A] B) C).comp (algebraMap O (O ⊗[A] B)) := by
    ext o; rfl
  haveI : IsScalarTower O (O ⊗[A] B) C := IsScalarTower.of_algebraMap_eq (fun o => by
    rw [hOTC]; rfl)
  haveI : Algebra.IsIntegral (O ⊗[A] B) C :=
    ⟨fun c => IsIntegral.tower_top (A := O ⊗[A] B) (Algebra.IsIntegral.isIntegral (R := O) c)⟩
  have hker : (⊥ : Ideal C).under (O ⊗[A] B) ≤ N := by
    intro x hx
    rw [Ideal.under, Ideal.mem_comap, Ideal.mem_bot] at hx
    apply h𝔫N
    rw [← hq0, ← hg]
    exact congrArg Subtype.val hx
  obtain ⟨𝔐, -, h𝔐p, h𝔐N⟩ := Ideal.exists_ideal_over_prime_of_isIntegral N ⊥ hker
  refine ⟨E', inferInstance, iOE, h, hjinj, hhinj, hrel, hgen, 𝔐, h𝔐p, ?_, ?_⟩
  · rw [hOTC, ← Ideal.comap_comap]
    change Ideal.comap _ (𝔐.under (O ⊗[A] B)) = _
    rw [h𝔐N, hN, RingHom.comap_ker]
    ext o
    simp only [RingHom.mem_ker, RingHom.comp_apply]
    change χ (o ⊗ₜ 1) = 0 ↔ _
    rw [hχ, map_one, mul_one]
  · have hle : N ≤ 𝔐.comap (algebraMap (O ⊗[A] B) C) := h𝔐N.symm ▸ le_rfl
    let e := RingHom.quotientKerEquivOfSurjective hχs
    refine ⟨(Ideal.quotientMap 𝔐 (algebraMap (O ⊗[A] B) C) hle).comp e.symm.toRingHom,
      (Ideal.quotientMap_injective' (H := hle) (le_of_eq h𝔐N)).comp e.symm.injective, ?_⟩
    ext o
    have he : e.symm (α o) = Ideal.Quotient.mk N (o ⊗ₜ 1) := by
      rw [RingEquiv.symm_apply_eq]
      change α o = χ (o ⊗ₜ 1)
      rw [hχ, map_one, mul_one]
    simp only [RingHom.comp_apply, RingEquiv.toRingHom_eq_coe, RingEquiv.coe_toRingHom]
    rw [he, Ideal.quotientMap_mk]
    rfl

end KummerComp
