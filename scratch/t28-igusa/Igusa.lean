theorem J10R_map {R S : Type*} [CommRing R] [CommRing S] (φ : R →+* S) (t : Fin 7 → R) :
    φ (J10R t) = J10R (fun i => φ (t i)) := by
  simp only [J10R, J10R0, J10R1, J10R2, J10R3, J10R4, J10R5, J10R6, J10R7, J10R8, J10R9, map_add, map_sub, map_neg, map_mul, map_pow, map_ofNat, map_one]

set_option maxHeartbeats 4000000 in
theorem J10R_homog (v : Fin 7 → K) (e : K) : J10R (fun i => e * v i) = e ^ 10 * J10R v := by
  simp only [J10R, J10R0, J10R1, J10R2, J10R3, J10R4, J10R5, J10R6, J10R7, J10R8, J10R9]; ring

set_option maxHeartbeats 4000000 in
theorem J10R_diag (v : Fin 7 → K) (s t : K) : J10R (actC v s 0 0 t 1) = (s * t) ^ (3 * 10) * J10R v := by
  simp only [J10R, J10R0, J10R1, J10R2, J10R3, J10R4, J10R5, J10R6, J10R7, J10R8, J10R9]; simp [actC]; ring

set_option maxHeartbeats 4000000 in
theorem J10R_swap (v : Fin 7 → K) : J10R (actC v 0 1 1 0 1) = J10R v := by
  simp only [J10R, J10R0, J10R1, J10R2, J10R3, J10R4, J10R5, J10R6, J10R7, J10R8, J10R9]; simp [actC]; ring

set_option maxHeartbeats 4000000 in
theorem J10R_deriv (t : Fin 7 → K[X]) (h0 : derivative (t 0) = t 1)
    (h1 : derivative (t 1) = 2 * t 2) (h2 : derivative (t 2) = 3 * t 3)
    (h3 : derivative (t 3) = 4 * t 4) (h4 : derivative (t 4) = 5 * t 5)
    (h5 : derivative (t 5) = 6 * t 6) (h6 : derivative (t 6) = 0) : derivative (J10R t) = 0 := by
  simp only [J10R, J10R0, J10R1, J10R2, J10R3, J10R4, J10R5, J10R6, J10R7, J10R8, J10R9, derivative_add, derivative_sub, derivative_neg, derivative_mul, derivative_pow,
    derivative_ofNat, derivative_one, map_natCast, map_ofNat, Nat.cast_ofNat, h0, h1, h2, h3, h4, h5, h6]
  ring

theorem J10R_trans [CharZero K] (v : Fin 7 → K) (b : K) : J10R (actC v 1 b 0 1 1) = J10R v := by
  have hc := eq_C_of_derivative_eq_zero (J10R_deriv (trP v) (trP_d0 v) (trP_d1 v) (trP_d2 v)
    (trP_d3 v) (trP_d4 v) (trP_d5 v) (trP_d6 v))
  have e1 : (evalRingHom b) (J10R (trP v)) = J10R (actC v 1 b 0 1 1) := by
    rw [J10R_map]; congr 1; funext i; exact trP_eval v b i
  have e0 : (evalRingHom 0) (J10R (trP v)) = J10R v := by
    rw [J10R_map]; congr 1; funext i; exact trP_eval_zero v i
  rw [hc] at e1 e0
  simp only [coe_evalRingHom, eval_C] at e1 e0
  rw [← e1, e0]

theorem J10R_isInv [CharZero K] : IsInv (fun v : Fin 7 → K => J10R v) 10 :=
  ⟨by decide, J10R_homog, J10R_diag, J10R_swap, J10R_trans⟩

end Inv

section Main
variable {K : Type*} [Field K]

/-- `J` transforms correctly under the matrix `[[a, b], [c, d]]` (with `e = 1`). -/
def Good (J : (Fin 7 → K) → K) (n : ℕ) (a b c d : K) : Prop :=
  ∀ v, J (actC v a b c d 1) = (a * d - b * c) ^ (3 * n) * J v

theorem Good.mul {J : (Fin 7 → K) → K} {n : ℕ} {a b c d a' b' c' d' : K}
    (h : Good J n a b c d) (h' : Good J n a' b' c' d') :
    Good J n (a * a' + b * c') (a * b' + b * d') (c * a' + d * c') (c * b' + d * d') := by
  intro v
  have e := actC_actC v a b c d 1 a' b' c' d' 1
  rw [mul_one] at e
  rw [← e, h', h, ← mul_assoc, ← mul_pow]; congr 1; ring

theorem Good.congr {J : (Fin 7 → K) → K} {n : ℕ} {a b c d a' b' c' d' : K}
    (h : Good J n a b c d) (ha : a = a') (hb : b = b') (hc : c = c') (hd : d = d') :
    Good J n a' b' c' d' := by subst ha hb hc hd; exact h

theorem IsInv.good {J : (Fin 7 → K) → K} {n : ℕ} (hJ : IsInv J n) (a b c d : K)
    (hdet : a * d - b * c ≠ 0) : Good J n a b c d := by
  have gD : ∀ s t, Good J n s 0 0 t := fun s t v => by rw [hJ.diag]; ring
  have gU : ∀ u, Good J n 1 u 0 1 := fun u v => by rw [hJ.trans]; ring
  have gS : Good J n 0 1 1 0 := fun v => by
    rw [hJ.swap]; obtain ⟨m, hm⟩ := hJ.even
    rw [hm, show (0 * 0 - 1 * 1 : K) = -1 by ring, show 3 * (m + m) = 2 * (3 * m) by ring,
      pow_mul]; simp
  by_cases hc : c = 0
  · subst hc
    have ha : a ≠ 0 := by rintro rfl; simp at hdet
    exact ((gD a d).mul (gU (b / a))).congr (by ring) (by field_simp <;> ring) (by ring) (by ring)
  · exact ((((gU (a / c)).mul gS).mul (gD c (b - a * d / c))).mul (gU (d / c))).congr
      (by field_simp <;> ring) (by field_simp <;> ring) (by ring) (by field_simp <;> ring)

/-- **Transformation law** (the `⇒` direction of T28, in general form). -/
theorem IsInv.sexticAct {J : (Fin 7 → K) → K} {n : ℕ} (hJ : IsInv J n) (f : Fin 7 → K)
    (M : Matrix (Fin 2) (Fin 2) K) (hM : M.det ≠ 0) (e : K) :
    J (sexticAct f M e) = (e * M.det ^ 3) ^ n * J f := by
  rw [Matrix.det_fin_two] at hM ⊢
  rw [sexticAct_eq, actC_scale, hJ.homog, hJ.good _ _ _ _ hM, mul_pow, ← pow_mul, mul_assoc,
    mul_comm 3 n]

variable [CharZero K]

theorem J2_sexticAct (f : Fin 7 → K) (M : Matrix (Fin 2) (Fin 2) K) (hM : M.det ≠ 0) (e : K) :
    J2 (sexticAct f M e) = (e * M.det ^ 3) ^ 2 * J2 f := J2R_isInv.sexticAct f M hM e
theorem J4_sexticAct (f : Fin 7 → K) (M : Matrix (Fin 2) (Fin 2) K) (hM : M.det ≠ 0) (e : K) :
    J4 (sexticAct f M e) = (e * M.det ^ 3) ^ 4 * J4 f := J4R_isInv.sexticAct f M hM e
theorem J6_sexticAct (f : Fin 7 → K) (M : Matrix (Fin 2) (Fin 2) K) (hM : M.det ≠ 0) (e : K) :
    J6 (sexticAct f M e) = (e * M.det ^ 3) ^ 6 * J6 f := J6R_isInv.sexticAct f M hM e
theorem J10_sexticAct (f : Fin 7 → K) (M : Matrix (Fin 2) (Fin 2) K) (hM : M.det ≠ 0) (e : K) :
    J10 (sexticAct f M e) = (e * M.det ^ 3) ^ 10 * J10 f := by
  rw [J10_eq, J10_eq]; exact J10R_isInv.sexticAct f M hM e

/-- **The `⇒` direction of `IgusaClebschSeparation`, proved** (any field of characteristic 0). -/
theorem igusa_forward (f g : Fin 7 → K)
    (h : ∃ M : Matrix (Fin 2) (Fin 2) K, M.det ≠ 0 ∧ ∃ e : K, e ≠ 0 ∧ g = sexticAct f M e) :
    ∃ r : K, r ≠ 0 ∧ J2 g = r * J2 f ∧ J4 g = r ^ 2 * J4 f ∧ J6 g = r ^ 3 * J6 f ∧
      J10 g = r ^ 5 * J10 f := by
  obtain ⟨M, hM, e, he, rfl⟩ := h
  refine ⟨(e * M.det ^ 3) ^ 2, by positivity, ?_, ?_, ?_, ?_⟩
  · exact J2_sexticAct f M hM e
  · rw [J4_sexticAct f M hM e, ← pow_mul]
  · rw [J6_sexticAct f M hM e, ← pow_mul]
  · rw [J10_sexticAct f M hM e, ← pow_mul]

end Main

/-- The `⇐` content of T28 with the scaling removed: equal Igusa invariants give equivalent
sextics. -/
def IgusaSeparationEq : Prop :=
  ∀ (L : Type) [Field L] [IsAlgClosed L] [CharZero L] (f g : Fin 7 → L),
    J10 f ≠ 0 → J10 g ≠ 0 → J2 g = J2 f → J4 g = J4 f → J6 g = J6 f → J10 g = J10 f →
      ∃ M : Matrix (Fin 2) (Fin 2) L, M.det ≠ 0 ∧ ∃ e : L, e ≠ 0 ∧ g = sexticAct f M e

theorem actC_unit {K : Type*} [Field K] (v : Fin 7 → K) (e : K) :
    actC v 1 0 0 1 e = fun i => e * v i := by
  funext i; fin_cases i <;> simp [actC] <;> ring

/-- **T28 reduces to its exact-equality form** (proved): the `⇒` direction is
`igusa_forward`, and the weighted scaling `r` is absorbed by `e` with `e² = r⁻¹`. -/
theorem igusaClebschSeparation_iff : IgusaClebschSeparation ↔ IgusaSeparationEq := by
  constructor
  · intro h L _ _ _ f g hf hg h2 h4 h6 h10
    exact (h L f g hf hg).2 ⟨1, one_ne_zero, by rw [h2]; ring, by rw [h4]; ring,
      by rw [h6]; ring, by rw [h10]; ring⟩
  · intro h L _ _ _ f g hf hg
    refine ⟨igusa_forward f g, ?_⟩
    rintro ⟨r, hr, h2, h4, h6, h10⟩
    obtain ⟨s, hs⟩ := IsAlgClosed.exists_pow_nat_eq r⁻¹ (by norm_num : 0 < 2)
    have hs0 : s ≠ 0 := by
      rintro rfl
      have h0 : r⁻¹ = 0 := by rw [← hs]; ring
      exact hr (inv_eq_zero.mp h0)
    set g' : Fin 7 → L := fun i => s * g i with hg'
    have hsr : s ^ 2 * r = 1 := by rw [hs]; field_simp
    have k2 : J2 g' = J2 f := by
      rw [J2_eq, J2R_homog, ← J2_eq, h2, ← mul_assoc, hsr, one_mul]
    have k4 : J4 g' = J4 f := by
      rw [J4_eq, J4R_homog, ← J4_eq, h4, ← mul_assoc, show s ^ 4 * r ^ 2 = (s ^ 2 * r) ^ 2 by ring,
        hsr, one_pow, one_mul]
    have k6 : J6 g' = J6 f := by
      rw [J6_eq, J6R_homog, ← J6_eq, h6, ← mul_assoc, show s ^ 6 * r ^ 3 = (s ^ 2 * r) ^ 3 by ring,
        hsr, one_pow, one_mul]
    have k10 : J10 g' = J10 f := by
      rw [J10_eq, J10R_homog, ← J10_eq, h10, ← mul_assoc,
        show s ^ 10 * r ^ 5 = (s ^ 2 * r) ^ 5 by ring, hsr, one_pow, one_mul]
    have hg'0 : J10 g' ≠ 0 := by rw [k10]; exact hf
    obtain ⟨M, hM, e, he, hMe⟩ := h L f g' hf hg'0 k2 k4 k6 k10
    refine ⟨M, hM, e * s⁻¹, mul_ne_zero he (inv_ne_zero hs0), ?_⟩
    have hgg : g = actC g' 1 0 0 1 s⁻¹ := by
      rw [actC_unit]; funext i; simp [hg', hs0]
    rw [hgg, hMe, sexticAct_eq, sexticAct_eq, actC_actC]
    congr 1 <;> ring

end PkgI1

/-!
## The `SO(3) = PGL(2)` lemma for binary quadratics (glue for Mestre's route)

Binary quadratics `q = q₀ + q₁x + q₂x²` as vectors `Fin 3 → K`; `qAct q a b c d` is
`(cx+d)² q((ax+b)/(cx+d))`, and `pair` is the polar form of `−disc` (`pair q q = 4q₀q₂ − q₁²`),
which is `2·(q,p)₂` up to a constant for the second transvectant.

`so3`: over an algebraically closed field of characteristic 0, if two bases `(qᵢ)`, `(pᵢ)` of
binary quadratics have the same Gram matrix for `pair`, then one invertible substitution `M`
carries every `qᵢ` to `pᵢ`. This is the step of Mestre's reconstruction that turns "the quadratic
covariants `y₁, y₂, y₃` of `f` and `g` have the same Gram matrix" into "`f` and `g` are
equivalent".
-/

namespace T28SO3

variable {K : Type*} [Field K]

/-- `(cx+d)² q((ax+b)/(cx+d))`. -/
def qAct (q : Fin 3 → K) (a b c d : K) : Fin 3 → K :=
  ![q 0 * d ^ 2 + q 1 * b * d + q 2 * b ^ 2,
    2 * q 0 * c * d + q 1 * (a * d + b * c) + 2 * q 2 * a * b,
    q 0 * c ^ 2 + q 1 * a * c + q 2 * a ^ 2]

/-- The polar form of `−disc`: `pair q q = 4 q₀ q₂ − q₁²`. -/
def pair (q p : Fin 3 → K) : K := 2 * q 0 * p 2 + 2 * q 2 * p 0 - q 1 * p 1

theorem pair_qAct (q p : Fin 3 → K) (a b c d : K) :
    pair (qAct q a b c d) (qAct p a b c d) = (a * d - b * c) ^ 2 * pair q p := by
  simp [pair, qAct]; ring

/-- The Gram matrix of `pair`. -/
def Pm (K : Type*) [Field K] : Matrix (Fin 3) (Fin 3) K := !![0, 0, 2; 0, -1, 0; 2, 0, 0]

theorem gram_apply (A : Matrix (Fin 3) (Fin 3) K) (i j : Fin 3) :
    (A * Pm K * A.transpose) i j = pair (A i) (A j) := by
  simp [Matrix.mul_apply, Fin.sum_univ_three, Pm, pair]; ring

/-- A null vector of `pair` is a square `(cx + d)²`. -/
theorem null_sq [IsAlgClosed K] [CharZero K] (u : Fin 3 → K) (hu : pair u u = 0) :
    ∃ c d : K, u 0 = d ^ 2 ∧ u 1 = 2 * c * d ∧ u 2 = c ^ 2 := by
  have h : u 1 ^ 2 = 4 * u 0 * u 2 := by simp [pair] at hu; linear_combination -hu
  obtain ⟨d, hd⟩ := IsAlgClosed.exists_pow_nat_eq (u 0) (by norm_num : 0 < 2)
  by_cases hd0 : d = 0
  · subst hd0
    have h0 : u 0 = 0 := by rw [← hd]; ring
    have h1 : u 1 = 0 := by rw [h0] at h; simpa using h
    obtain ⟨c, hc⟩ := IsAlgClosed.exists_pow_nat_eq (u 2) (by norm_num : 0 < 2)
    exact ⟨c, 0, by rw [h0]; ring, by rw [h1]; ring, hc.symm⟩
  · have h2 : (2 : K) * d ≠ 0 := mul_ne_zero two_ne_zero hd0
    refine ⟨u 1 / (2 * d), d, hd.symm, by field_simp, ?_⟩
    rw [div_pow, eq_div_iff (pow_ne_zero 2 h2)]
    rw [← hd] at h; linear_combination -h

/-- The algebraic core: an orthonormal-type frame `u, z, v` (`u, v` null, `pair u v = 2`,
`pair z z = −1`, `z ⊥ u, v`) is the image of the standard frame `1, x, x²` under a substitution. -/
theorem frame [IsAlgClosed K] [CharZero K] (u z v : Fin 3 → K) (huu : pair u u = 0)
    (hvv : pair v v = 0) (huv : pair u v = 2) (hzz : pair z z = -1) (huz : pair u z = 0)
    (hzv : pair z v = 0) :
    ∃ a b c d : K, a * d - b * c ≠ 0 ∧ u = ![d ^ 2, 2 * c * d, c ^ 2] ∧
      z = ![b * d, a * d + b * c, a * c] ∧ v = ![b ^ 2, 2 * a * b, a ^ 2] := by
  obtain ⟨c, d, hu0, hu1, hu2⟩ := null_sq u huu
  obtain ⟨a, b, hv0, hv1, hv2⟩ := null_sq v hvv
  have hH : (a * d - b * c) ^ 2 = 1 := by
    simp only [pair] at huv; rw [hu0, hu1, hu2, hv0, hv1, hv2] at huv
    have : (2 : K) * ((a * d - b * c) ^ 2 - 1) = 0 := by linear_combination huv
    have := (mul_eq_zero.mp this).resolve_left two_ne_zero
    linear_combination this
  have hE1 : c ^ 2 * z 0 - c * d * z 1 + d ^ 2 * z 2 = 0 := by
    simp only [pair] at huz; rw [hu0, hu1, hu2] at huz
    have : (2 : K) * (c ^ 2 * z 0 - c * d * z 1 + d ^ 2 * z 2) = 0 := by linear_combination huz
    exact (mul_eq_zero.mp this).resolve_left two_ne_zero
  have hE2 : a ^ 2 * z 0 - a * b * z 1 + b ^ 2 * z 2 = 0 := by
    simp only [pair] at hzv; rw [hv0, hv1, hv2] at hzv
    have : (2 : K) * (a ^ 2 * z 0 - a * b * z 1 + b ^ 2 * z 2) = 0 := by linear_combination hzv
    exact (mul_eq_zero.mp this).resolve_left two_ne_zero
  set μ := -(2 * z 0 * a * c + 2 * z 2 * b * d - z 1 * (a * d + b * c)) with hμ
  have hz0 : z 0 = μ * (b * d) := by linear_combination b ^ 2 * hE1 + d ^ 2 * hE2 - z 0 * hH
  have hz1 : z 1 = μ * (a * d + b * c) := by
    linear_combination 2 * a * b * hE1 + 2 * c * d * hE2 - z 1 * hH
  have hz2 : z 2 = μ * (a * c) := by linear_combination a ^ 2 * hE1 + c ^ 2 * hE2 - z 2 * hH
  have hμ2 : μ ^ 2 = 1 := by
    simp only [pair] at hzz; rw [hz0, hz1, hz2] at hzz
    linear_combination -hzz - μ ^ 2 * hH
  have hdet : a * d - b * c ≠ 0 := by intro h; rw [h] at hH; simp at hH
  have hvec : v = ![b ^ 2, 2 * a * b, a ^ 2] := by
    funext i; fin_cases i <;> simp [hv0, hv1, hv2]
  have hμ' : (μ - 1) * (μ + 1) = 0 := by linear_combination hμ2
  rcases mul_eq_zero.mp hμ' with h | h
  · have h1 : μ = 1 := by linear_combination h
    refine ⟨a, b, c, d, hdet, ?_, ?_, hvec⟩
    · funext i; fin_cases i <;> simp [hu0, hu1, hu2]
    · funext i; fin_cases i <;> simp [hz0, hz1, hz2, h1]
  · have h1 : μ = -1 := by linear_combination h
    refine ⟨a, b, -c, -d, by intro h'; apply hdet; linear_combination -h', ?_, ?_, hvec⟩
    · funext i; fin_cases i <;> simp [hu0, hu1, hu2]
    · funext i; fin_cases i <;> simp [hz0, hz1, hz2, h1] <;> ring

/-- **`SO(3) = PGL(2)` for binary quadratics.** Two bases of binary quadratics with the same
Gram matrix for the discriminant pairing differ by one invertible substitution. -/
theorem so3 [IsAlgClosed K] [CharZero K] (q p : Fin 3 → Fin 3 → K)
    (hq : (Matrix.of q).det ≠ 0) (hp : ∀ i j, pair (p i) (p j) = pair (q i) (q j)) :
    ∃ a b c d : K, a * d - b * c ≠ 0 ∧ ∀ i, p i = qAct (q i) a b c d := by
  set Q : Matrix (Fin 3) (Fin 3) K := Matrix.of q with hQ
  set P : Matrix (Fin 3) (Fin 3) K := Matrix.of p with hP
  have hG : P * Pm K * P.transpose = Q * Pm K * Q.transpose := by
    ext i j; rw [gram_apply, gram_apply]; exact hp i j
  have hQu : IsUnit Q.det := isUnit_iff_ne_zero.mpr hq
  have hQtu : IsUnit Q.transpose.det := by rw [Matrix.det_transpose]; exact hQu
  set T := Q⁻¹ * P with hTdef
  have hT : T * Pm K * T.transpose = Pm K := by
    rw [hTdef, Matrix.transpose_mul, Matrix.transpose_nonsing_inv]
    calc Q⁻¹ * P * Pm K * (P.transpose * Q.transpose⁻¹)
        = Q⁻¹ * (P * Pm K * P.transpose) * Q.transpose⁻¹ := by simp only [Matrix.mul_assoc]
      _ = Q⁻¹ * Q * Pm K * (Q.transpose * Q.transpose⁻¹) := by rw [hG]; simp only [Matrix.mul_assoc]
      _ = Pm K := by rw [Matrix.nonsing_inv_mul Q hQu, Matrix.mul_nonsing_inv _ hQtu,
                    Matrix.one_mul, Matrix.mul_one]
  have hQT : Q * T = P := by
    rw [hTdef, ← Matrix.mul_assoc, Matrix.mul_nonsing_inv Q hQu, Matrix.one_mul]
  have e : ∀ k l, pair (T k) (T l) = Pm K k l := fun k l =>
    (gram_apply T k l).symm.trans (congrFun (congrFun hT k) l)
  obtain ⟨a, b, c, d, hdet, hu, hz, hv⟩ := frame (T 0) (T 1) (T 2)
    (by simpa [Pm] using e 0 0) (by simpa [Pm] using e 2 2) (by simpa [Pm] using e 0 2)
    (by simpa [Pm] using e 1 1) (by simpa [Pm] using e 0 1) (by simpa [Pm] using e 1 2)
  refine ⟨a, b, c, d, hdet, fun i => ?_⟩
  funext j
  have h := congrFun (congrFun hQT i) j
  simp only [Matrix.mul_apply, Fin.sum_univ_three, hQ, hP, Matrix.of_apply] at h
  rw [← h, hu, hz, hv]
  fin_cases j <;> simp [qAct] <;> ring

end T28SO3


/-! ## Mestre's argument, abstract form (glue for the generic case of `⇐`)

If two sextics `f, g` admit bases `(yᵢ)`, `(y'ᵢ)` of binary quadratics with the same Gram matrix
for `pair` and with `p6 g (y'ᵢy'ⱼy'ₖ) = p6 f (yᵢyⱼyₖ)` for all `i, j, k`, then `g` is equivalent
to `f`. For the Clebsch covariants `yᵢ = yᵢ(f)`, `y'ᵢ = yᵢ(g)` both families of numbers are
invariants of even degree, hence polynomials in `J₂, J₄, J₆, J₁₀` (identities M3 of the report),
so equal Igusa invariants and `det G ≠ 0` give the equivalence. -/

namespace PkgI1
open T28SO3

section Mestre
variable {K : Type*} [Field K]

/-- The invariant pairing of binary sextics (`60·Σ (-1)ⁱ uᵢ v₆₋ᵢ / C(6,i)`). -/
def p6 (u v : Fin 7 → K) : K :=
  60 * u 0 * v 6 - 10 * u 1 * v 5 + 4 * u 2 * v 4 - 3 * u 3 * v 3 + 4 * u 4 * v 2 -
    10 * u 5 * v 1 + 60 * u 6 * v 0

def cub {K : Type*} [Field K] (u v w : Fin 3 → K) : Fin 7 → K :=
  ![u 0 * v 0 * w 0,
    u 0 * v 0 * w 1 + u 0 * v 1 * w 0 + u 1 * v 0 * w 0,
    u 0 * v 0 * w 2 + u 0 * v 1 * w 1 + u 0 * v 2 * w 0 + u 1 * v 0 * w 1 + u 1 * v 1 * w 0 + u 2 * v 0 * w 0,
    u 0 * v 1 * w 2 + u 0 * v 2 * w 1 + u 1 * v 0 * w 2 + u 1 * v 1 * w 1 + u 1 * v 2 * w 0 + u 2 * v 0 * w 1 + u 2 * v 1 * w 0,
    u 0 * v 2 * w 2 + u 1 * v 1 * w 2 + u 1 * v 2 * w 1 + u 2 * v 0 * w 2 + u 2 * v 1 * w 1 + u 2 * v 2 * w 0,
    u 1 * v 2 * w 2 + u 2 * v 1 * w 2 + u 2 * v 2 * w 1,
    u 2 * v 2 * w 2]

theorem p6_actC (u v : Fin 7 → K) (a b c d : K) :
    p6 (actC u a b c d 1) (actC v a b c d 1) = (a * d - b * c) ^ 6 * p6 u v := by
  simp only [p6, actC, Matrix.cons_val]; ring

theorem cub_qAct (u v w : Fin 3 → K) (a b c d : K) :
    cub (qAct u a b c d) (qAct v a b c d) (qAct w a b c d) = actC (cub u v w) a b c d 1 := by
  funext m; fin_cases m <;> simp [cub, qAct, actC] <;> ring

theorem p6_sub (u v w : Fin 7 → K) (s : K) :
    p6 (fun i => u i - s * v i) w = p6 u w - s * p6 v w := by
  simp only [p6]; ring

theorem p6_cub_lin (h : Fin 7 → K) (y : Fin 3 → Fin 3 → K) (α β γ : Fin 3 → K) :
    p6 h (cub (fun l => ∑ i, α i * y i l) (fun l => ∑ j, β j * y j l) (fun l => ∑ k, γ k * y k l)) =
      ∑ i, ∑ j, ∑ k, α i * β j * γ k * p6 h (cub (y i) (y j) (y k)) := by
  simp only [p6, cub, Fin.sum_univ_three, Matrix.cons_val]; ring

/-- Products of three members of a basis of binary quadratics span the binary sextics, and `p6`
is nondegenerate. -/
theorem eq_zero_of_p6_cub (h : Fin 7 → K) [CharZero K] (y : Fin 3 → Fin 3 → K)
    (hy : (Matrix.of y).det ≠ 0) (H : ∀ i j k, p6 h (cub (y i) (y j) (y k)) = 0) : h = 0 := by
  set Y : Matrix (Fin 3) (Fin 3) K := Matrix.of y with hY
  have hYu : IsUnit Y.det := isUnit_iff_ne_zero.mpr hy
  have hCY : Y⁻¹ * Y = 1 := Matrix.nonsing_inv_mul Y hYu
  have hE : ∀ k l, ∑ i, Y⁻¹ k i * y i l = (1 : Matrix (Fin 3) (Fin 3) K) k l := fun k l => by
    rw [← hCY, Matrix.mul_apply]; rfl
  have key : ∀ k₁ k₂ k₃ : Fin 3, p6 h (cub (fun l => (1 : Matrix (Fin 3) (Fin 3) K) k₁ l)
      (fun l => (1 : Matrix (Fin 3) (Fin 3) K) k₂ l) (fun l => (1 : Matrix (Fin 3) (Fin 3) K) k₃ l))
        = 0 := fun k₁ k₂ k₃ => by
    have := p6_cub_lin h y (Y⁻¹ k₁) (Y⁻¹ k₂) (Y⁻¹ k₃)
    simp only [hE] at this
    rw [this]; simp [H]
  have k0 := key 0 0 0
  have k1 := key 0 0 1
  have k2 := key 0 0 2
  have k3 := key 0 1 2
  have k4 := key 0 2 2
  have k5 := key 1 2 2
  have k6 := key 2 2 2
  simp [p6, cub, Matrix.one_apply] at k0 k1 k2 k3 k4 k5 k6
  funext i; fin_cases i <;> simp_all

theorem det_ne_zero_of_gram (y y' : Fin 3 → Fin 3 → K) [CharZero K] (hy : (Matrix.of y).det ≠ 0)
    (hG : ∀ i j, pair (y' i) (y' j) = pair (y i) (y j)) : (Matrix.of y').det ≠ 0 := by
  have hM : Matrix.of y' * Pm K * (Matrix.of y').transpose =
      Matrix.of y * Pm K * (Matrix.of y).transpose := by
    ext i j; rw [T28SO3.gram_apply, T28SO3.gram_apply]; exact hG i j
  have hd := congrArg Matrix.det hM
  simp only [Matrix.det_mul, Matrix.det_transpose] at hd
  have hP : (Pm K).det = 4 := by
    simp [Pm, Matrix.det_fin_three]; norm_num
  rw [hP] at hd
  intro h0; rw [h0] at hd
  apply hy
  have : (Matrix.of y).det ^ 2 * 4 = 0 := by linear_combination -hd
  simpa using this

/-- **Mestre's separation step (abstract form), proved.** -/
theorem mestre_abstract [IsAlgClosed K] [CharZero K] (f g : Fin 7 → K)
    (y y' : Fin 3 → Fin 3 → K) (hy : (Matrix.of y).det ≠ 0)
    (hG : ∀ i j, pair (y' i) (y' j) = pair (y i) (y j))
    (ha : ∀ i j k, p6 g (cub (y' i) (y' j) (y' k)) = p6 f (cub (y i) (y j) (y k))) :
    ∃ M : Matrix (Fin 2) (Fin 2) K, M.det ≠ 0 ∧ ∃ e : K, e ≠ 0 ∧ g = sexticAct f M e := by
  obtain ⟨a, b, c, d, hdet, hy'⟩ := so3 y y' hy hG
  have hy'det := det_ne_zero_of_gram y y' hy hG
  have hδ : (a * d - b * c) ^ 6 ≠ 0 := pow_ne_zero 6 hdet
  have hz := eq_zero_of_p6_cub (fun i => g i - ((a * d - b * c) ^ 6)⁻¹ * actC f a b c d 1 i) y'
    hy'det (fun i j k => by
      rw [p6_sub, ha, hy' i, hy' j, hy' k, cub_qAct, p6_actC]; field_simp; ring)
  refine ⟨!![a, b; c, d], by rw [Matrix.det_fin_two_of]; exact hdet, ((a * d - b * c) ^ 6)⁻¹,
    inv_ne_zero hδ, ?_⟩
  rw [sexticAct_eq]
  funext i
  have := congrFun hz i
  simp only [Pi.zero_apply] at this
  have e := actC_scale f a b c d ((a * d - b * c) ^ 6)⁻¹
  simp only [Matrix.of_apply, Matrix.cons_val', Matrix.cons_val_zero, Matrix.cons_val_one,
    Matrix.empty_val', Matrix.cons_val_fin_one, Matrix.head_cons, Matrix.head_fin_const] at e ⊢
  rw [e]; linear_combination this

end Mestre

