/-- The Gram matrix of `yv` as a function of the Igusa invariants (identities M3). -/
def gramJ {K : Type*} [Field K] (j2 j4 j6 j10 : K) : Fin 3 → Fin 3 → K :=
  ![![m3G11 j2 j4 j6 j10, m3G12 j2 j4 j6 j10, m3G13 j2 j4 j6 j10],
    ![m3G12 j2 j4 j6 j10, m3G22 j2 j4 j6 j10, m3G23 j2 j4 j6 j10],
    ![m3G13 j2 j4 j6 j10, m3G23 j2 j4 j6 j10, m3G33 j2 j4 j6 j10]]

/-- The coefficients `p6 f (yᵢ yⱼ yₖ)` as functions of the Igusa invariants (identities M3). -/
def cubJ {K : Type*} [Field K] (j2 j4 j6 j10 : K) : Fin 3 → Fin 3 → Fin 3 → K :=
  ![![![m3a111 j2 j4 j6 j10, m3a112 j2 j4 j6 j10, m3a113 j2 j4 j6 j10], ![m3a112 j2 j4 j6 j10, m3a122 j2 j4 j6 j10, m3a123 j2 j4 j6 j10], ![m3a113 j2 j4 j6 j10, m3a123 j2 j4 j6 j10, m3a133 j2 j4 j6 j10]],
    ![![m3a112 j2 j4 j6 j10, m3a122 j2 j4 j6 j10, m3a123 j2 j4 j6 j10], ![m3a122 j2 j4 j6 j10, m3a222 j2 j4 j6 j10, m3a223 j2 j4 j6 j10], ![m3a123 j2 j4 j6 j10, m3a223 j2 j4 j6 j10, m3a233 j2 j4 j6 j10]],
    ![![m3a113 j2 j4 j6 j10, m3a123 j2 j4 j6 j10, m3a133 j2 j4 j6 j10], ![m3a123 j2 j4 j6 j10, m3a223 j2 j4 j6 j10, m3a233 j2 j4 j6 j10], ![m3a133 j2 j4 j6 j10, m3a233 j2 j4 j6 j10, m3a333 j2 j4 j6 j10]]]


/-- **Identities M3** (glue; computer-algebra checked, not proved in Lean). -/
def M3Identities : Prop :=
  ∀ (K : Type) [Field K] [CharZero K] (f : Fin 7 → K),
    (∀ i j, pair (yv f i) (yv f j) = gramJ (J2 f) (J4 f) (J6 f) (J10 f) i j) ∧
    (∀ i j k, p6 f (cub (yv f i) (yv f j) (yv f k)) = cubJ (J2 f) (J4 f) (J6 f) (J10 f) i j k)

/-- **Generic case of `⇐`, proved from M3**: if the quadratic covariants of `f` are linearly
independent (Clebsch's `R ≠ 0`), equal Igusa invariants give equivalent sextics. -/
theorem separation_generic (hM3 : M3Identities) (L : Type) [Field L] [IsAlgClosed L]
    [CharZero L] (f g : Fin 7 → L) (hy : (Matrix.of (yv f)).det ≠ 0)
    (h2 : J2 g = J2 f) (h4 : J4 g = J4 f) (h6 : J6 g = J6 f) (h10 : J10 g = J10 f) :
    ∃ M : Matrix (Fin 2) (Fin 2) L, M.det ≠ 0 ∧ ∃ e : L, e ≠ 0 ∧ g = sexticAct f M e := by
  obtain ⟨hGf, haf⟩ := hM3 L f
  obtain ⟨hGg, hag⟩ := hM3 L g
  exact mestre_abstract f g (yv f) (yv g) hy (fun i j => by rw [hGf, hGg, h2, h4, h6, h10])
    (fun i j k => by rw [haf, hag, h2, h4, h6, h10])

/-- The special case (curves with an extra involution, Bolza 1888; Cardona–Quer 2005):
**unproved**. -/
def SeparationSpecial : Prop :=
  ∀ (L : Type) [Field L] [IsAlgClosed L] [CharZero L] (f g : Fin 7 → L),
    J10 f ≠ 0 → J10 g ≠ 0 → (Matrix.of (yv f)).det = 0 →
      J2 g = J2 f → J4 g = J4 f → J6 g = J6 f → J10 g = J10 f →
        ∃ M : Matrix (Fin 2) (Fin 2) L, M.det ≠ 0 ∧ ∃ e : L, e ≠ 0 ∧ g = sexticAct f M e

/-- **T28 from M3 and the special case** (proved). -/
theorem igusaClebschSeparation_of (hM3 : M3Identities) (hS : SeparationSpecial) :
    IgusaClebschSeparation := by
  rw [igusaClebschSeparation_iff]
  intro L _ _ _ f g hf hg h2 h4 h6 h10
  by_cases hy : (Matrix.of (yv f)).det = 0
  · exact hS L f g hf hg hy h2 h4 h6 h10
  · exact separation_generic hM3 L f g hy h2 h4 h6 h10

end PkgI1

