import Lean
/-! contrib-clashes: exact declaration-name clash scan of the import closure of every module of
`ZInQKernel/Contrib/` (list in `scratch/contrib-clashes/contrib-modules.txt`, generated by
`git ls-files 'ZInQKernel/Contrib/*.lean'`, minus `AllContrib`). Reads the `.olean` of every module of the
closure (no environment is built) and prints every constant name stored by two different modules.
Lean 4.35's `importModules` (`Lean/Environment.lean`, `finalizeImport`/`subsumesInfo`) accepts a duplicate
only when both are theorems with the same type, universe parameters and `all` list (or a theorem and an axiom
from it); every other duplicate aborts the import (`environment already contains ...`). The scan reproduces
that test: `FATAL` lines abort an all-Contrib import, `OK-DUP` lines are accepted duplicates (these include
realized `eq_1`/`congr_simp` lemmas and identical theorems). Adapted from eichler-rebase's `ClashScan.lean`.
Run: `lake env lean scratch/contrib-clashes/ClashScan.lean` from the worktree root. -/
open Lean

run_cmd do
  let src ← IO.FS.readFile "scratch/contrib-clashes/contrib-modules.txt"
  let roots := (src.splitOn "\n").filterMap fun l =>
    let l := l.trimAscii.toString
    if l.isEmpty || l == "ZInQKernel.Contrib.AllContrib" then none else some l.toName
  IO.println s!"roots {roots.length}"
  initSearchPath (← findSysroot)
  let mut seen : NameSet := {}
  let mut todo : Array Name := roots.toArray
  let mut owner : Std.HashMap Name (Name × ConstantInfo) := {}
  let mut nFatal := 0
  let mut nOk := 0
  let mut nmods := 0
  let mut missing : Array Name := #[]
  while !todo.isEmpty do
    let m := todo.back!
    todo := todo.pop
    if seen.contains m then continue
    seen := seen.insert m
    let f ← findOLean m
    unless (← f.pathExists) do
      missing := missing.push m
      continue
    let (md, _) ← readModuleData f
    nmods := nmods + 1
    for i in md.imports do todo := todo.push i.module
    for c in md.constNames, ci in md.constants do
      match owner.get? c with
      | some (m', ci') =>
          let ok := ci.type == ci'.type && ci.levelParams == ci'.levelParams &&
            (match ci, ci' with
             | .thmInfo t, .thmInfo t' => t.all == t'.all
             | .thmInfo t, .axiomInfo a => t.all == [a.name]
             | .axiomInfo a, .thmInfo t => t.all == [a.name]
             | _, _ => false)
          if ok then
            nOk := nOk + 1
            IO.println s!"OK-DUP {c} : {m'} / {m}"
          else
            nFatal := nFatal + 1
            IO.println s!"FATAL {c} : {m'} / {m}"
      | none => owner := owner.insert c (m, ci)
  for m in missing do IO.println s!"MISSING-OLEAN {m}"
  IO.println s!"modules read {nmods}; missing oleans {missing.size}; constants {owner.size}"
  IO.println s!"fatal clashes {nFatal}; accepted duplicates {nOk}"
