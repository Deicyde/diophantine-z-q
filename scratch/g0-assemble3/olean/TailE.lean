        m σ = MonoidHom.toAdditive (A.galAct σ')) →
      (∀ σ k : GQ, k ∈ GQL L → m (σ * k) = (m σ).comp (m k) ∧ m (k * σ) = (m k).comp (m σ)) →
      (∀ (σ : GQ) (f : PkgI3.AbVar.End A),
