theorem curveFacts_of_L0_CI_G1'' (hL0 : FiniteGlobalSections) (hI : ComponentIrreducible)
    (hG : ImagePlaneCurveIrr) : CurveRatFactor ∧ CurveSurj :=
  curveFacts_of_glue'' smoothStalkDimOne (globalFunctionsConst_of hL0) hI hG

