/-- Acceptance test: `[SL₂(ℤ) : Γ₁(5)] = 24`, `μ(Γ₁(5)) = 12` (genus 0 with 4 cusps). -/
example : (CongruenceSubgroup.Gamma1 5).index = 24 := by
  rw [BPModCurves.index_Gamma1_eq_card, BPModCurves.PrimVec, Nat.card_eq_fintype_card]
  decide
